module TxseTxseequitiesFramingUdpV10;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type TxseequitiesFramingV10 = unit {
    udp_header: UdpHeader;
    udp_sequenced_message: UdpSequencedMessage[self.udp_header.message_count];
};

type UdpHeader = unit {
    session: uint64;
    sequence: uint64;
    message_count: uint16;
    packet_type: uint8 &convert=PacketType($$);
};

type UdpSequencedMessage = unit {
    message_length: uint16;
    stream_id: uint8;
    message_type: uint8;
    payload: bytes &size=self.message_length - 2;
};

type PacketType = enum {
    SequencedData = 0,
    Heartbeat = 1,
    StartOfSession = 2,
    EndOfSession = 3,
    GapFillRequest = 4,
    GapFillResponse = 5,
};

