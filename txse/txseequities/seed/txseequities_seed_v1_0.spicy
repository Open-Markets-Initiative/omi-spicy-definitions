module TxseTxseequitiesSeedRakeV10;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type TxseequitiesSeedV10 = unit {
    rake_tcp_message: RakeTcpMessage[] &eod;
};

type RakeTcpMessage = unit {
    rake_message_header: RakeMessageHeader;
    switch ( self.rake_message_header.packet_type ) {
        PacketType::LogonRequestPacket -> logon_request_packet: LogonRequestPacket;
        PacketType::TcpUnsequencedMessage -> tcp_unsequenced_message: TcpUnsequencedMessage;
        PacketType::DebugMessage -> debug_message: DebugMessage(self.rake_message_header.message_length);
        PacketType::LogonResponseMessage -> logon_response_message: LogonResponseMessage;
        PacketType::TcpSequencedMessage -> tcp_sequenced_message: TcpSequencedMessage;
        * -> unknown: bytes &eod;
    };
};

type RakeMessageHeader = unit {
    message_length: uint16;
    packet_type: uint8 &convert=PacketType($$);
};

type LogonRequestPacket = unit {
    session: uint64;
    sender_comp: bytes &size=8;
    token: bytes &size=8;
    next_sequence_number: uint64;
};

type TcpUnsequencedMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::LimitOrderMessage -> limit_order_message: LimitOrderMessage;
        MessageType::MarketOrderMessage -> market_order_message: MarketOrderMessage;
        MessageType::CancelOrderMessage -> cancel_order_message: CancelOrderMessage;
        MessageType::ModifyOrderMessage -> modify_order_message: ModifyOrderMessage;
        MessageType::ReplaceOrderMessage -> replace_order_message: ReplaceOrderMessage;
        MessageType::MassCancelMessage -> mass_cancel_message: MassCancelMessage;
        * -> unknown: bytes &eod;
    };
};

type LimitOrderMessage = unit {
    limit_order_presence_bits: bitfield(32) {
        scope: 0;
        has_limit_order_self_match_instruction: 1;
        has_limit_order_price_slide_instruction: 2;
        has_limit_order_min_qty: 3;
        has_limit_order_max_floor_qty: 4;
        has_limit_order_max_replenish_qty_range: 5;
        has_limit_order_max_replenish_time_range: 6;
        has_limit_order_reference_price_target: 7;
        has_limit_order_expire_time: 8;
        has_limit_order_user_data: 9;
        has_limit_order_mpid: 10;
        has_limit_order_member_group: 11;
        has_limit_order_locate_broker: 12;
        reserved_19: 13..31;
    } &byte-order=spicy::ByteOrder::Little;
    cl_ord_id: int64;
    order_qty: int32;
    limit_order_bit_fields: bitfield(32) {
        side: 0..2;
        is_locate_required: 3;
        time_in_force: 4..7;
        order_capacity: 8..10;
        is_iso: 11;
        is_hidden: 12;
        is_post_only: 13;
        cancel_at_entry_if_crossed: 14;
        reserved_17: 15..31;
    } &byte-order=spicy::ByteOrder::Little;
    symbol_id: int16;
    price: int64;
    self_match_scope: int8 &convert=SelfMatchScope($$);
    limit_order_self_match_instruction: int8 &convert=LimitOrderSelfMatchInstruction($$);
    limit_order_price_slide_instruction: int8 &convert=LimitOrderPriceSlideInstruction($$);
    limit_order_min_qty: int32;
    limit_order_max_floor_qty: int32;
    limit_order_max_replenish_qty_range: int32;
    limit_order_max_replenish_time_range: int64;
    limit_order_reference_price_target: int16;
    limit_order_expire_time: int64;
    limit_order_user_data: int64;
    limit_order_mpid: bytes &size=4;
    limit_order_member_group: bytes &size=2;
    limit_order_locate_broker: bytes &size=4;
};

type MarketOrderMessage = unit {
    market_order_presence_bits: bitfield(16) {
        scope: 0;
        has_market_order_self_match_instruction: 1;
        has_market_order_user_data: 2;
        has_market_order_mpid: 3;
        has_market_order_member_group: 4;
        has_market_order_locate_broker: 5;
        reserved_10: 6..15;
    } &byte-order=spicy::ByteOrder::Little;
    cl_ord_id: int64;
    order_qty: int32;
    market_order_bit_fields: bitfield(16) {
        side: 0..2;
        is_locate_required: 3;
        time_in_force: 4..7;
        order_capacity: 8..10;
        reserved_5: 11..15;
    } &byte-order=spicy::ByteOrder::Little;
    symbol_id: int16;
    self_match_scope: int8 &convert=SelfMatchScope($$);
    market_order_self_match_instruction: int8 &convert=MarketOrderSelfMatchInstruction($$);
    market_order_user_data: int64;
    market_order_mpid: bytes &size=4;
    market_order_member_group: bytes &size=2;
    market_order_locate_broker: bytes &size=4;
};

type CancelOrderMessage = unit {
    orig_cl_ord_id: int64;
};

type ModifyOrderMessage = unit {
    modify_order_presence_bits: bitfield(8) {
        has_modify_order_order_qty: 0;
        has_modify_order_bit_fields: 1;
        has_modify_order_locate_broker: 2;
        reserved_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    cl_ord_id: int64;
    orig_cl_ord_id: int64;
    modify_order_order_qty: int32;
    modify_order_bit_fields: bitfield(8) {
        side: 0..2;
        is_locate_required: 3;
        reserved_4: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    modify_order_locate_broker: bytes &size=4;
};

type ReplaceOrderMessage = unit {
    replace_order_presence_bits: bitfield(16) {
        has_replace_order_price: 0;
        has_replace_order_order_qty: 1;
        has_replace_order_max_floor_qty: 2;
        scope: 3;
        has_replace_order_self_match_instruction: 4;
        has_replace_order_price_slide_instruction: 5;
        has_replace_order_reference_price_target: 6;
        has_replace_order_locate_broker: 7;
        reserved_8: 8..15;
    } &byte-order=spicy::ByteOrder::Little;
    cl_ord_id: int64;
    orig_cl_ord_id: int64;
    replace_order_bit_fields: bitfield(16) {
        side: 0..2;
        is_locate_required: 3;
        is_iso: 4;
        is_post_only: 5;
        cancel_at_entry_if_crossed: 6;
        reserved_9: 7..15;
    } &byte-order=spicy::ByteOrder::Little;
    replace_order_price: int64;
    replace_order_order_qty: int32;
    replace_order_max_floor_qty: int32;
    self_match_scope: int8 &convert=SelfMatchScope($$);
    replace_order_self_match_instruction: int8 &convert=ReplaceOrderSelfMatchInstruction($$);
    replace_order_price_slide_instruction: int8 &convert=ReplaceOrderPriceSlideInstruction($$);
    replace_order_reference_price_target: int16;
    replace_order_locate_broker: bytes &size=4;
};

type MassCancelMessage = unit {
    mass_cancel_presence_bits: bitfield(8) {
        has_mass_cancel_mpid: 0;
        has_mass_cancel_sender_comp: 1;
        has_mass_cancel_member_group: 2;
        has_mass_cancel_cl_ord_id: 3;
        reserved_4: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    mass_cancel_request_id: int64;
    mass_cancel_scope: int8 &convert=MassCancelScope($$);
    mass_cancel_bit_fields: bitfield(8) {
        exclude_auction_orders: 0;
        reserved_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
    mass_cancel_mpid: bytes &size=4;
    mass_cancel_sender_comp: bytes &size=8;
    mass_cancel_member_group: bytes &size=2;
    mass_cancel_cl_ord_id: int64;
};

type DebugMessage = unit(message_length: uint16) {
    text: bytes &size=message_length - 1;
};

type LogonResponseMessage = unit {
    session: uint64;
    next_sequence_number: uint64;
    highest_known_sequence_number: uint64;
    logon_response_code: uint8 &convert=LogonResponseCode($$);
    number_stream_ids: uint8;
    instance: uint32;
};

type TcpSequencedMessage = unit {
    stream_id: uint8;
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::TradingSessionStatusMessage -> trading_session_status_message: TradingSessionStatusMessage;
        MessageType::DefineSymbolMessage -> define_symbol_message: DefineSymbolMessage;
        MessageType::SymbolStatusMessage -> symbol_status_message: SymbolStatusMessage;
        MessageType::LimitOrderAcceptedMessage -> limit_order_accepted_message: LimitOrderAcceptedMessage;
        MessageType::LimitOrderRejectedMessage -> limit_order_rejected_message: LimitOrderRejectedMessage;
        MessageType::MarketOrderAcceptedMessage -> market_order_accepted_message: MarketOrderAcceptedMessage;
        MessageType::MarketOrderRejectedMessage -> market_order_rejected_message: MarketOrderRejectedMessage;
        MessageType::OrderCanceledMessage -> order_canceled_message: OrderCanceledMessage;
        MessageType::CancelRejectedMessage -> cancel_rejected_message: CancelRejectedMessage;
        MessageType::OrderModifiedMessage -> order_modified_message: OrderModifiedMessage;
        MessageType::ModifyRejectedMessage -> modify_rejected_message: ModifyRejectedMessage;
        MessageType::OrderReplacedMessage -> order_replaced_message: OrderReplacedMessage;
        MessageType::ReplaceRejectedMessage -> replace_rejected_message: ReplaceRejectedMessage;
        MessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        MessageType::OrderRestatedMessage -> order_restated_message: OrderRestatedMessage;
        MessageType::SelfMatchPreventedMessage -> self_match_prevented_message: SelfMatchPreventedMessage;
        MessageType::MassCancelAcceptedMessage -> mass_cancel_accepted_message: MassCancelAcceptedMessage;
        MessageType::MassCancelRejectedMessage -> mass_cancel_rejected_message: MassCancelRejectedMessage;
        MessageType::MassCancelResultMessage -> mass_cancel_result_message: MassCancelResultMessage;
        * -> unknown: bytes &eod;
    };
};

type TradingSessionStatusMessage = unit {
    trading_session_status_presence_bits: bitfield(8) {
        has_trading_session_status_operational_halt_reason: 0;
        has_trading_session_status_regulatory_halt_reason: 1;
        reserved_6: 2..7;
    } &byte-order=spicy::ByteOrder::Little;
    transact_time: int64;
    market_hours_state: int8 &convert=MarketHoursState($$);
    session_trading_state: int8 &convert=SessionTradingState($$);
    trading_session_status_operational_halt_reason: int8 &convert=TradingSessionStatusOperationalHaltReason($$);
    trading_session_status_regulatory_halt_reason: int8 &convert=TradingSessionStatusRegulatoryHaltReason($$);
};

type DefineSymbolMessage = unit {
    transact_time: int64;
    symbol_id: int16;
    symbol: bytes &size=8;
    suffix: bytes &size=8;
    matching_engine_id: int8;
    define_symbol_bit_fields: bitfield(8) {
        is_test: 0;
        reserved_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
    lot_size: int32;
    listing_market: int8 &convert=ListingMarket($$);
};

type SymbolStatusMessage = unit {
    symbol_status_presence_bits: bitfield(8) {
        has_symbol_status_operational_halt_reason: 0;
        has_symbol_status_regulatory_halt_reason: 1;
        reserved_6: 2..7;
    } &byte-order=spicy::ByteOrder::Little;
    transact_time: int64;
    symbol_id: int16;
    symbol_trading_state: int8 &convert=SymbolTradingState($$);
    short_sale_restriction_state: int8 &convert=ShortSaleRestrictionState($$);
    symbol_status_operational_halt_reason: int8 &convert=SymbolStatusOperationalHaltReason($$);
    symbol_status_regulatory_halt_reason: int8 &convert=SymbolStatusRegulatoryHaltReason($$);
};

