};

type OrderRestatedMessage = unit {
    order_restated_presence_bits: bitfield(8) {
        has_order_restated_rank_price: 0;
        has_order_restated_display_price: 1;
        has_display_qty: 2;
        reserved_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    transact_time: int64;
    order_id: int64;
    cl_ord_id: int64;
    restatement_reason: int8 &convert=RestatementReason($$);
    order_restated_rank_price: int64;
    order_restated_display_price: int64;
    display_qty: int32;
};

type SelfMatchPreventedMessage = unit {
    transact_time: int64;
    order_id: int64;
    cl_ord_id: int64;
    exec_price: int64;
    exec_id: int64;
    exec_qty: int32;
    canceled_qty: int32;
    leaves_qty: int32;
    liquidity_indicator: int8 &convert=LiquidityIndicator($$);
};

type MassCancelAcceptedMessage = unit {
    mass_cancel_accepted_presence_bits: bitfield(8) {
        has_mass_cancel_accepted_mpid: 0;
        has_mass_cancel_accepted_sender_comp: 1;
        has_mass_cancel_accepted_member_group: 2;
        has_mass_cancel_accepted_cl_ord_id: 3;
        reserved_4: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    transact_time: int64;
    mass_cancel_request_id: int64;
    mass_cancel_accepted_scope: int8 &convert=MassCancelAcceptedScope($$);
    mass_cancel_accepted_bit_fields: bitfield(8) {
        exclude_auction_orders: 0;
        reserved_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
    mass_cancel_id: int64;
    mass_cancel_accepted_mpid: bytes &size=4;
    mass_cancel_accepted_sender_comp: bytes &size=8;
    mass_cancel_accepted_member_group: bytes &size=2;
    mass_cancel_accepted_cl_ord_id: int64;
};

type MassCancelRejectedMessage = unit {
    mass_cancel_rejected_presence_bits: bitfield(8) {
        has_mass_cancel_rejected_mpid: 0;
        has_mass_cancel_rejected_sender_comp: 1;
        has_mass_cancel_rejected_member_group: 2;
        has_mass_cancel_rejected_cl_ord_id: 3;
        reserved_4: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    transact_time: int64;
    mass_cancel_request_id: int64;
    mass_cancel_rejected_scope: int8 &convert=MassCancelRejectedScope($$);
    mass_cancel_rejected_bit_fields: bitfield(8) {
        exclude_auction_orders: 0;
        reserved_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
    mass_cancel_rejected_reason: int8 &convert=MassCancelRejectedReason($$);
    mass_cancel_rejected_mpid: bytes &size=4;
    mass_cancel_rejected_sender_comp: bytes &size=8;
    mass_cancel_rejected_member_group: bytes &size=2;
    mass_cancel_rejected_cl_ord_id: int64;
};

