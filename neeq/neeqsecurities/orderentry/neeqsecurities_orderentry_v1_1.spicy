type MessageHeader = unit {
    msg_type: uint32 &convert=MsgType($$);
    body_length: uint32;
};

type LogonMessage = unit {
    sender_comp_id: bytes &size=20;
    target_comp_id: bytes &size=20;
    heart_bt_int: int32;
    password: bytes &size=16;
    default_appl_ver_id: bytes &size=32;
};

type LogoutMessage = unit {
    session_status: int32 &convert=SessionStatus($$);
    text: bytes &size=200;
};

type BusinessRejectMessage = unit {
    appl_id: bytes &size=3;
    transact_time: int64;
    submitting_pbuid: bytes &size=6;
    security_id: bytes &size=8;
    security_id_source: bytes &size=4;
    ref_seq_num: int64;
    ref_msg_type: uint32;
    business_reject_ref_id: bytes &size=10;
    business_reject_reason: uint16 &convert=BusinessRejectReason($$);
    business_reject_text: bytes &size=50;
};

type ReportSynchronizationMessage = unit {
    no_partitions: uint32;
    partition_reports: PartitionReports[self.no_partitions];
};

type PartitionReports = unit {
    partition_no: int32;
    report_index: int64;
};

type PlatformStateInfoMessage = unit {
    platform_id: uint16 &convert=PlatformId($$);
    platform_state: uint16 &convert=PlatformState($$);
};

type ReportFinishedMessage = unit {
    partition_no: int32;
    report_index: int64;
    platform_id: uint16 &convert=PlatformId($$);
};

type PlatformInfoMessage = unit {
    platform_id: uint16 &convert=PlatformId($$);
    no_partitions: uint32;
    partitions: Partitions[self.no_partitions];
};

type Partitions = unit {
    partition_no: int32;
};

type TradingSessionStatusMessage = unit {
    market_id: bytes &size=8;
    market_segment_id: bytes &size=8;
    trading_session_id: bytes &size=4;
    trading_session_sub_id: bytes &size=4;
    trad_ses_status: uint16;
    trad_ses_start_time: int64;
