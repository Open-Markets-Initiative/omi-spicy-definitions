module IceIcefuturesMdfImpactV1134;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type IcefuturesMdfV1134 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.number_of_msgs];
};

type PacketHeader = unit {
    session: uint16;
    sequence: uint32;
    number_of_msgs: uint16;
    sent_date_time: uint64;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::MarketSnapshotMessage -> market_snapshot_message: MarketSnapshotMessage;
        MessageType::TradeMessage -> trade_message: TradeMessage;
        MessageType::SpotMarketTradeMessage -> spot_market_trade_message: SpotMarketTradeMessage;
        MessageType::InvestigatedTradeMessage -> investigated_trade_message: InvestigatedTradeMessage;
        MessageType::CancelledTradeMessage -> cancelled_trade_message: CancelledTradeMessage;
        MessageType::MarketStatisticsMessage -> market_statistics_message: MarketStatisticsMessage;
        MessageType::MarketStateChangeMessage -> market_state_change_message: MarketStateChangeMessage;
        MessageType::SystemTextMessage -> system_text_message: SystemTextMessage;
        MessageType::OpenInterestMessage -> open_interest_message: OpenInterestMessage;
        MessageType::OpenPriceMessage -> open_price_message: OpenPriceMessage;
        MessageType::ClosePriceMessage -> close_price_message: ClosePriceMessage;
        MessageType::SettlementPriceMessage -> settlement_price_message: SettlementPriceMessage;
        MessageType::IndexPricesMessage -> index_prices_message: IndexPricesMessage;
        MessageType::EndOfDayMarketSummaryMessage -> end_of_day_market_summary_message: EndOfDayMarketSummaryMessage;
        MessageType::MarketEventMessage -> market_event_message: MarketEventMessage;
        MessageType::PreOpenPriceIndicatorMessage -> pre_open_price_indicator_message: PreOpenPriceIndicatorMessage;
        MessageType::StripInfoMessage -> strip_info_message: StripInfoMessage;
        MessageType::IntervalPriceLimitNotificationMessage -> interval_price_limit_notification_message: IntervalPriceLimitNotificationMessage;
        MessageType::NewFuturesStrategyDefinitionMessage -> new_futures_strategy_definition_message: NewFuturesStrategyDefinitionMessage;
        MessageType::NewExpiryMessage -> new_expiry_message: NewExpiryMessage;
        MessageType::SpecialFieldMessage -> special_field_message: SpecialFieldMessage;
        MessageType::MarketSnapshotOrderMessage -> market_snapshot_order_message: MarketSnapshotOrderMessage;
        MessageType::AddOrModifyOrderMessage -> add_or_modify_order_message: AddOrModifyOrderMessage;
        MessageType::DeleteOrderMessage -> delete_order_message: DeleteOrderMessage;
        MessageType::MessageBundleMarker -> message_bundle_marker: MessageBundleMarker;
        MessageType::FixingTransitionMessage -> fixing_transition_message: FixingTransitionMessage;
        MessageType::FixingLockdownMessage -> fixing_lockdown_message: FixingLockdownMessage;
        MessageType::FixingIndicativePriceMessageMessage -> fixing_indicative_price_message_message: FixingIndicativePriceMessageMessage;
        MessageType::TransactionEndMarkerForEmptyLastBundleMessage -> transaction_end_marker_for_empty_last_bundle_message: TransactionEndMarkerForEmptyLastBundleMessage;
        MessageType::MarketSnapshotPriceLevelMessage -> market_snapshot_price_level_message: MarketSnapshotPriceLevelMessage;
        MessageType::AddPriceLevelMessage -> add_price_level_message: AddPriceLevelMessage;
        MessageType::ChangePriceLevelMessage -> change_price_level_message: ChangePriceLevelMessage;
        MessageType::DeletePriceLevelMessage -> delete_price_level_message: DeletePriceLevelMessage;
        MessageType::NewOptionsStrategyDefinitionMessage -> new_options_strategy_definition_message: NewOptionsStrategyDefinitionMessage;
        MessageType::NewOptionsMarketDefinitionMessage -> new_options_market_definition_message: NewOptionsMarketDefinitionMessage;
        MessageType::RfqMessage -> rfq_message: RfqMessage;
        MessageType::OptionOpenInterestMessage -> option_open_interest_message: OptionOpenInterestMessage;
        MessageType::OptionSettlementPriceMessage -> option_settlement_price_message: OptionSettlementPriceMessage;
        MessageType::OldStyleOptionsTradeAndMarketStatsMessage -> old_style_options_trade_and_market_stats_message: OldStyleOptionsTradeAndMarketStatsMessage;
        * -> unknown: bytes &eod;
    };
    extra_data: bytes &size=self.message_header.length + 3 - 3944;
};

type MessageHeader = unit {
    message_type: uint8 &convert=MessageType($$);
    length: uint16;
};

type MarketSnapshotMessage = unit {
    market_id: int32;
    market_type: int16;
    trading_status: uint8 &convert=TradingStatus($$);
    volume: int32;
    block_volume: int32;
    efs_volume: int32;
    efp_volume: int32;
    open_interest: int32;
    opening_price: int64;
    settlement_price_with_deal_price_precision: int64;
    high: int64;
    low: int64;
    vwap: int64;
    num_of_book_entries: int32;
    last_trade_price: int64;
    last_trade_quantity: int32;
    last_trade_date_time: int64;
    settle_price_date_time: int64;
    last_message_sequence_id: int32;
    : skip bytes &size=2;   # padding
    open_interest_date: bytes &size=10;
    is_settle_price_official: uint8 &convert=IsSettlePriceOfficial($$);
    settlement_price: int64;
    has_previous_day_settlement_price: uint8 &convert=HasPreviousDaySettlementPrice($$);
    previous_day_settlement_price: int64;
};

type TradeMessage = unit {
    market_id: int32;
    trade_id: int64;
    is_system_priced_leg: uint8 &convert=IsSystemPricedLeg($$);
    price: int64;
    quantity: int32;
    off_market_trade_indicator: uint8 &convert=OffMarketTradeIndicator($$);
    transact_date_time: int64;
    system_priced_leg_type: uint8 &convert=SystemPricedLegType($$);
    is_implied_spread_at_market_open: bytes &size=1;
    is_adjusted_trade: bytes &size=1;
    aggressor_side: uint8 &convert=AggressorSide($$);
    extra_flags: int8;
    off_market_trade_type: bytes &size=3;
    sequence_within_millis: int32;
};

type SpotMarketTradeMessage = unit {
    market_id: int32;
    trade_id: int64;
    price: int64;
    quantity: int32;
    transact_date_time: int64;
    extra_flags: int8;
    delivery_begin_date_time: int64;
    delivery_end_date_time: int64;
    is_system_priced_leg: uint8 &convert=IsSystemPricedLeg($$);
};

type InvestigatedTradeMessage = unit {
    market_id: int32;
