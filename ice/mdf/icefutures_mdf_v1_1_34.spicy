    is_block_only: uint8 &convert=IsBlockOnly($$);
    strategy_symbol: bytes &size=18;
    gt_allowed: uint8 &convert=GtAllowed($$);
    : skip bytes &size=4;   # padding
    mifid_regulated_market: uint8 &convert=MifidRegulatedMarket($$);
    market_desc: bytes &size=120;
    maturity_year: int16;
    maturity_month: int16;
    maturity_day: int16;
    deal_price_denominator: bytes &size=1;
    unit_quantity: int32;
    num_decimals_options_price: bytes &size=1;
