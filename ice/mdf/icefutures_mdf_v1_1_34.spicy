    min_price: int64;
    max_price: int64;
    product_name: bytes &size=62;
    hub_alias: bytes &size=80;
    strip_name: bytes &size=39;
    is_tradable: uint8 &convert=IsTradable($$);
    settle_price_denominator: bytes &size=1;
    mic_code: bytes &size=4;
    unit_qty_denominator: bytes &size=1;
    hedge_only: uint8 &convert=HedgeOnly($$);
    exchange_silo: uint8 &convert=ExchangeSilo($$);
    off_exchange_increment_qty_denominator: bytes &size=1;
    off_exchange_increment_qty: int32;
    off_exchange_increment_price: int32;
    off_exchange_increment_option_price: int32;
    product_id: int32;
    hub_id: int32;
    strip_id: int32;
    underlying_isin: bytes &size=12;
    test_market_indicator: uint8 &convert=TestMarketIndicator($$);
    leg_deal_suppressed: uint8 &convert=LegDealSuppressed($$);
};

