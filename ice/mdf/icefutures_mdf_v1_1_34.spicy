type MessageType = enum {
    MarketSnapshotMessage = 0x43,
    TradeMessage = 0x47,
    SpotMarketTradeMessage = 0x59,
    InvestigatedTradeMessage = 0x48,
    CancelledTradeMessage = 0x49,
    MarketStatisticsMessage = 0x4a,
    MarketStateChangeMessage = 0x4b,
    SystemTextMessage = 0x4c,
    OpenInterestMessage = 0x4d,
    OpenPriceMessage = 0x4e,
    ClosePriceMessage = 0x63,
    SettlementPriceMessage = 0x4f,
    IndexPricesMessage = 0x7a,
    EndOfDayMarketSummaryMessage = 0x75,
    MarketEventMessage = 0x66,
    PreOpenPriceIndicatorMessage = 0x67,
    StripInfoMessage = 0x69,
    IntervalPriceLimitNotificationMessage = 0x56,
    NewFuturesStrategyDefinitionMessage = 0x39,
    NewExpiryMessage = 0x52,
    SpecialFieldMessage = 0x62,
    MarketSnapshotOrderMessage = 0x44,
    AddOrModifyOrderMessage = 0x45,
    DeleteOrderMessage = 0x46,
    MessageBundleMarker = 0x54,
    FixingTransitionMessage = 0x33,
    FixingLockdownMessage = 0x34,
    FixingIndicativePriceMessageMessage = 0x30,
    TransactionEndMarkerForEmptyLastBundleMessage = 0x65,
    MarketSnapshotPriceLevelMessage = 0x6d,
    AddPriceLevelMessage = 0x74,
