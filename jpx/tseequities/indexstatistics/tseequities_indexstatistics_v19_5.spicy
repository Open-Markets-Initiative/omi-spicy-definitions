module JpxTseequitiesIndexstatisticsFlexV195;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type TseequitiesIndexstatisticsV195 = unit {
    start_of_message: uint8;
    service_header: ServiceHeader;
    separation_between_service_header_and_data_section: uint8;
    tag_information: TagInformation[] &eod;
};

type ServiceHeader = unit {
    message_length: bytes &size=6;
    message_serial_no: MessageSerialNo;
    message_type: MessageType;
    exchange_code: uint8 &convert=ExchangeCode($$);
    session_distinction: bytes &size=2;
    issue_classification: IssueClassification;
    switch ( self.issue_classification.issue_classification_large_classification ) {
        IssueClassificationLargeClassification::Stockrelated -> stock_issue_code: StockIssueCode;
        IssueClassificationLargeClassification::Cbrelated -> cb_issue_code: CbIssueCode;
        * -> unknown: bytes &eod;
    };
};

type MessageSerialNo = unit {
    multicast_group_number: bytes &size=3;
    sequence_number: bytes &size=8;
};

type MessageType = unit {
    message_type_large_classification: uint8 &convert=MessageTypeLargeClassification($$);
    message_type_medium_classification: bytes &size=10;
};

type IssueClassification = unit {
    issue_classification_large_classification: bytes &size=2;
    issue_classification_medium_classification: bytes &size=2;
};

type StockIssueCode = unit {
    stock_space: bytes &size=7;
    stock_proper_name_code: bytes &size=4;
    stock_reserved_code: bytes &size=1;
};

type CbIssueCode = unit {
    cb_space: bytes &size=3;
    cb_reserved_code: uint8 &convert=CbReservedCode($$);
    time_symbol: bytes &size=4;
    cb_proper_name_code: bytes &size=4;
};

type TagInformation = unit {
    tag_id: bytes &size=2;
    switch ( self.tag_id ) {
        0 -> market_value_message: MarketValueMessage;
        0 -> simple_yield_message: SimpleYieldMessage;
        0 -> weighted_yield_message: WeightedYieldMessage;
        0 -> simple_stock_price_average_message: SimpleStockPriceAverageMessage;
        0 -> weighted_stock_price_average_message: WeightedStockPriceAverageMessage;
        0 -> simple_stock_price_average_by_industry_message: SimpleStockPriceAverageByIndustryMessage;
        0 -> japanese_yen_cb_indicator_message: JapaneseYenCbIndicatorMessage;
        0 -> number_of_gainers_decliners_message: NumberOfGainersDeclinersMessage;
        0 -> estimated_total_trading_volume_message: EstimatedTotalTradingVolumeMessage;
        0 -> estimated_total_turnover_message: EstimatedTotalTurnoverMessage;
        0 -> vwap_by_market_message: VwapByMarketMessage;
        0 -> ranking_by_trading_volume_message: RankingByTradingVolumeMessage;
        0 -> ranking_by_turnover_message: RankingByTurnoverMessage;
        0 -> ranking_by_net_change_message: RankingByNetChangeMessage;
        0 -> ranking_by_net_change_rate_message: RankingByNetChangeRateMessage;
        0 -> tostnet_statistics_message: TostnetStatisticsMessage;
        0 -> index_open_high_low_and_closing_prices_message: IndexOpenHighLowAndClosingPricesMessage;
        0 -> special_quotation_message: SpecialQuotationMessage;
        0 -> control_message: ControlMessage;
        * -> unknown: bytes &eod;
    };
    separation_of_tag: uint8 &convert=SeparationOfTag($$);
};

type MarketValueMessage = unit {
    reserved_2: bytes &size=2;
    time_c_6_hhmm: bytes &size=6;
    issue_classification_code: bytes &size=4;
    total_market_value: TotalMarketValue;
    market_value_day_on_day_comparison: MarketValueDayOnDayComparison;
};

type TotalMarketValue = unit {
    trading_volume_turnover_unit_flag: uint8 &convert=TradingVolumeTurnoverUnitFlag($$);
    total_market_value_c_14: bytes &size=14;
};

type MarketValueDayOnDayComparison = unit {
    trading_volume_turnover_unit_flag: uint8 &convert=TradingVolumeTurnoverUnitFlag($$);
    day_on_day_comparison_c_14: bytes &size=14;
    sign: uint8 &convert=Sign($$);
};

