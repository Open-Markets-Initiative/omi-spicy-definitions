    reserved_2: bytes &size=2;
    output_time: bytes &size=6;
    industry_code: bytes &size=4;
    simple_stock_price_average: SimpleStockPriceAverage;
    stock_price_average_day_on_day_comparison: StockPriceAverageDayOnDayComparison;
};

