module IexIexoptionsSessionSbeV101Client;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type IexoptionsSessionV101 = unit {
    client_sbe_message: ClientSbeMessage[] &eod;
};

type ClientSbeMessage = unit {
    packet_length: uint16;
    message_header: MessageHeader;
    client_payload: ClientSessionMessage(self.message_header.template_id);
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16 &convert=SchemaId($$);
    version: uint16;
};

type ClientSessionMessage = unit(template_id: TemplateId) {
    switch ( template_id ) {
        TemplateId::LoginRequestMessage -> login_request_message: LoginRequestMessage;
        TemplateId::SequencedMessageHeaderMessage -> sequenced_message_header_message: SequencedMessageHeaderMessage;
        TemplateId::SubsessionJoinMessage -> subsession_join_message: SubsessionJoinMessage;
        TemplateId::SubsessionLeaveMessage -> subsession_leave_message: SubsessionLeaveMessage;
        * -> unknown: bytes &eod;
    };
};

type LoginRequestMessage = unit {
    logon_id: bytes &size=16;
    token: bytes &size=32;
};

type SequencedMessageHeaderMessage = unit {
    subsession_id: uint64;
    sequence: uint32;
    timestamp: uint64;
};

type SubsessionJoinMessage = unit {
    subsession_id: uint64;
    start_sequence: uint32;
    end_sequence: uint32;
};

type SubsessionLeaveMessage = unit {
    subsession_id: uint64;
};

type TemplateId = enum {
    LoginRequestMessage = 1,
    LoginResponseMessage = 2,
    GatewayHeartbeatMessage = 3,
    ClientHeartbeatMessage = 4,
    LogoutRequestMessage = 5,
    TerminateMessage = 6,
    SequencedMessageHeaderMessage = 7,
    SubsessionJoinMessage = 8,
    SubsessionJoinResponseMessage = 9,
    SubsessionLeaveMessage = 10,
    SubsessionLeaveResponseMessage = 11,
};

type SchemaId = enum {
    Session = 20000,
};

