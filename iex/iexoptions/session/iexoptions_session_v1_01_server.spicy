module IexIexoptionsSessionSbeV101Server;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type IexoptionsSessionV101 = unit {
    server_sbe_message: ServerSbeMessage[] &eod;
};

type ServerSbeMessage = unit {
    packet_length: uint16;
    message_header: MessageHeader;
    server_payload: ServerSessionMessage(self.message_header.template_id);
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16 &convert=SchemaId($$);
    version: uint16;
};

type ServerSessionMessage = unit(template_id: TemplateId) {
    switch ( template_id ) {
        TemplateId::LoginResponseMessage -> login_response_message: LoginResponseMessage;
        TemplateId::GatewayHeartbeatMessage -> gateway_heartbeat_message: GatewayHeartbeatMessage;
        TemplateId::TerminateMessage -> terminate_message: TerminateMessage;
        TemplateId::SequencedMessageHeaderMessage -> sequenced_message_header_message: SequencedMessageHeaderMessage;
        TemplateId::SubsessionJoinResponseMessage -> subsession_join_response_message: SubsessionJoinResponseMessage;
        TemplateId::SubsessionLeaveResponseMessage -> subsession_leave_response_message: SubsessionLeaveResponseMessage;
        * -> unknown: bytes &eod;
    };
};

type LoginResponseMessage = unit {
    logon_id: bytes &size=16;
    status: uint8 &convert=Status($$);
};

type GatewayHeartbeatMessage = unit {
    keep_alive: uint8 &convert=KeepAlive($$);
    sub_sessions_groups: SubSessionsGroups;
};

type SubSessionsGroups = unit {
    session_info_group_encoding: SessionInfoGroupEncoding;
    sub_sessions_group: SubSessionsGroup[self.session_info_group_encoding.num_in_group];
};

type SessionInfoGroupEncoding = unit {
    block_length_short: uint8;
    num_in_group: uint8;
};

type SubSessionsGroup = unit {
    subsession_type: int8 &convert=SubsessionType($$);
    subsession_id: uint64;
    joined: uint8 &convert=Joined($$);
    next_seq_no: uint32;
};

type TerminateMessage = unit {
    reason: uint8 &convert=Reason($$);
};

type SequencedMessageHeaderMessage = unit {
    subsession_id: uint64;
    sequence: uint32;
    timestamp: uint64;
};

type SubsessionJoinResponseMessage = unit {
    subsession_id: uint64;
    status: uint8 &convert=Status($$);
};

type SubsessionLeaveResponseMessage = unit {
    subsession_id: uint64;
    reason: uint8 &convert=Reason($$);
};

type TemplateId = enum {
    LoginRequestMessage = 1,
    LoginResponseMessage = 2,
    GatewayHeartbeatMessage = 3,
    ClientHeartbeatMessage = 4,
    LogoutRequestMessage = 5,
    TerminateMessage = 6,
    SequencedMessageHeaderMessage = 7,
    SubsessionJoinMessage = 8,
    SubsessionJoinResponseMessage = 9,
    SubsessionLeaveMessage = 10,
    SubsessionLeaveResponseMessage = 11,
};

type SchemaId = enum {
    Session = 20000,
};

type Status = enum {
    Success = 0,
    SessionLevelReject = 1,
    LogoutRequested = 2,
    Unknown = 3,
    InvalidLogonId = 4,
    InvalidToken = 5,
    AlreadyLoggedIn = 6,
    LoginTimeout = 7,
    InvalidPacketLength = 8,
    InvalidMessage = 9,
    JoinRevoked = 10,
    HeartbeatTimeout = 11,
    MessageOutOfSequence = 12,
    InvalidSubsessionId = 13,
    SubsessionNotJoined = 14,
    DenialOfService = 15,
    InvalidArgument = 16,
    AlreadyJoined = 17,
};

type KeepAlive = enum {
    False_0 = 0,
    True_1 = 1,
};

type SubsessionType = enum {
    ClientToGateway = 0,
    GatewayToClient = 1,
    ReferenceData = 2,
};

type Joined = enum {
    False_0 = 0,
    True_1 = 1,
};

type Reason = enum {
    Success = 0,
    SessionLevelReject = 1,
    LogoutRequested = 2,
    Unknown = 3,
    InvalidLogonId = 4,
    InvalidToken = 5,
    AlreadyLoggedIn = 6,
    LoginTimeout = 7,
    InvalidPacketLength = 8,
    InvalidMessage = 9,
    JoinRevoked = 10,
    HeartbeatTimeout = 11,
    MessageOutOfSequence = 12,
    InvalidSubsessionId = 13,
    SubsessionNotJoined = 14,
    DenialOfService = 15,
    InvalidArgument = 16,
    AlreadyJoined = 17,
};

