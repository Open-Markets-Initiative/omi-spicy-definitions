module IexIexoptionsBinaryorderentrySbeV102;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type IexoptionsBinaryorderentryV102 = unit {
    sbe_message: SbeMessage[] &eod;
};

type SbeMessage = unit {
    packet_length: uint16;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::NewOrderSingleMessage -> new_order_single_message: NewOrderSingleMessage;
        TemplateId::OrderCancelReplaceRequestMessage -> order_cancel_replace_request_message: OrderCancelReplaceRequestMessage;
        TemplateId::OrderCancelRequestMessage -> order_cancel_request_message: OrderCancelRequestMessage;
        TemplateId::NewBulkQuoteMessage -> new_bulk_quote_message: NewBulkQuoteMessage;
        TemplateId::MassCancelRequestMessage -> mass_cancel_request_message: MassCancelRequestMessage;
        TemplateId::PurgeRequestMessage -> purge_request_message: PurgeRequestMessage;
        TemplateId::OrderAckMessage -> order_ack_message: OrderAckMessage;
        TemplateId::UnsolicitedModifyAckMessage -> unsolicited_modify_ack_message: UnsolicitedModifyAckMessage;
        TemplateId::OrderCancelAckMessage -> order_cancel_ack_message: OrderCancelAckMessage;
        TemplateId::MassCancelAckMessage -> mass_cancel_ack_message: MassCancelAckMessage;
        TemplateId::BulkQuoteAckMessage -> bulk_quote_ack_message: BulkQuoteAckMessage;
        TemplateId::NewIocQuoteAckMessage -> new_ioc_quote_ack_message: NewIocQuoteAckMessage;
        TemplateId::QuoteRestatedMessage -> quote_restated_message: QuoteRestatedMessage;
        TemplateId::QuoteCanceledMessage -> quote_canceled_message: QuoteCanceledMessage;
        TemplateId::PurgeAckMessage -> purge_ack_message: PurgeAckMessage;
        TemplateId::ExecutionReportMessage -> execution_report_message: ExecutionReportMessage;
        TemplateId::TradeBustCorrectMessage -> trade_bust_correct_message: TradeBustCorrectMessage;
        TemplateId::ApplicationLayerRejectMessage -> application_layer_reject_message: ApplicationLayerRejectMessage;
        TemplateId::RiskLimitUpdateRequestMessage -> risk_limit_update_request_message: RiskLimitUpdateRequestMessage;
        TemplateId::RiskActionRequestMessage -> risk_action_request_message: RiskActionRequestMessage;
        TemplateId::UnderlyingRefDataMessage -> underlying_ref_data_message: UnderlyingRefDataMessage;
        TemplateId::InstrumentRefDataMessage -> instrument_ref_data_message: InstrumentRefDataMessage;
        TemplateId::MpidConfigurationAcknowledgementMessage -> mpid_configuration_acknowledgement_message: MpidConfigurationAcknowledgementMessage;
        TemplateId::MarketMakerSymbolAppointmentMessage -> market_maker_symbol_appointment_message: MarketMakerSymbolAppointmentMessage;
        TemplateId::SessionConfigurationAcknowledgementMessage -> session_configuration_acknowledgement_message: SessionConfigurationAcknowledgementMessage;
        TemplateId::RiskControlAcknowledgmentMessage -> risk_control_acknowledgment_message: RiskControlAcknowledgmentMessage;
        TemplateId::RiskControlAlertMessage -> risk_control_alert_message: RiskControlAlertMessage;
        TemplateId::SequencedMessageHeaderMessage -> sequenced_message_header_message: SequencedMessageHeaderMessage;
        TemplateId::SubsessionJoinMessage -> subsession_join_message: SubsessionJoinMessage;
        TemplateId::SubsessionJoinResponseMessage -> subsession_join_response_message: SubsessionJoinResponseMessage;
        TemplateId::SubsessionLeaveMessage -> subsession_leave_message: SubsessionLeaveMessage;
        TemplateId::SubsessionLeaveResponseMessage -> subsession_leave_response_message: SubsessionLeaveResponseMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type NewOrderSingleMessage = unit {
    account_account: bytes &size=16;
    instrument_id_instrument_id: uint32;
    market_participant_id: bytes &size=4;
    cl_ord_id: uint64;
    clearing_account: bytes &size=4;
    customer_or_firm: int8 &convert=CustomerOrFirm($$);
    open_close: int8 &convert=OpenClose($$);
    attributed_quote: int8 &convert=AttributedQuote($$);
    time_in_force: int8 &convert=TimeInForce($$);
    cancel_instead_of_slide_cancel_instead_of_slide: int8 &convert=CancelInsteadOfSlideCancelInsteadOfSlide($$);
    display_inst: int8 &convert=DisplayInst($$);
    exec_inst: int8 &convert=ExecInst($$);
    ord_type: int8 &convert=OrdType($$);
    target_party_id: bytes &size=4;
    auction_id: uint32;
    clearing_firm: uint32;
    optional_data: bytes &size=16;
    routing_firm_id: bytes &size=4;
    aiq: bytes &size=3;
    side: int8 &convert=Side($$);
    price_price_8: int64;
    order_qty_quantity_non_zero: uint32;
};

