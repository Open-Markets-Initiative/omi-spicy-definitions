module IexIexoptionsBinaryorderentrySbeV103Client;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type IexoptionsBinaryorderentryV103 = unit {
    client_sbe_message: ClientSbeMessage[] &eod;
};

type ClientSbeMessage = unit {
    packet_length: uint16;
    message_header: MessageHeader;
    switch ( self.message_header.schema_id ) {
        SchemaId::Session -> client_session_message: ClientSessionMessage(self.message_header.template_id);
        SchemaId::Business -> client_business_message: ClientBusinessMessage(self.message_header.template_id);
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16 &convert=SchemaId($$);
    version: uint16;
};

type ClientSessionMessage = unit(template_id: TemplateId) {
    switch ( template_id ) {
        TemplateId::LoginRequestMessage -> login_request_message: LoginRequestMessage;
        TemplateId::SequencedMessageHeaderMessage -> sequenced_message_header_message: SequencedMessageHeaderMessage;
        TemplateId::SubsessionJoinMessage -> subsession_join_message: SubsessionJoinMessage;
        TemplateId::SubsessionLeaveMessage -> subsession_leave_message: SubsessionLeaveMessage;
        * -> unknown: bytes &eod;
    };
};

type LoginRequestMessage = unit {
    logon_id: bytes &size=16;
    token: bytes &size=32;
};

type SequencedMessageHeaderMessage = unit {
    subsession_id: uint64;
    sequence: uint32;
    timestamp: uint64;
};

type SubsessionJoinMessage = unit {
    subsession_id: uint64;
    start_sequence: uint32;
    end_sequence: uint32;
};

type SubsessionLeaveMessage = unit {
    subsession_id: uint64;
};

type ClientBusinessMessage = unit(template_id: TemplateId) {
    switch ( template_id ) {
        TemplateId::LoginRequestMessage -> new_order_single_message: NewOrderSingleMessage;
        TemplateId::LoginResponseMessage -> order_cancel_replace_request_message: OrderCancelReplaceRequestMessage;
        TemplateId::GatewayHeartbeatMessage -> order_cancel_request_message: OrderCancelRequestMessage;
        TemplateId::ClientHeartbeatMessage -> new_bulk_quote_message: NewBulkQuoteMessage;
        TemplateId::LogoutRequestMessage -> mass_cancel_request_message: MassCancelRequestMessage;
        TemplateId::TerminateMessage -> purge_request_message: PurgeRequestMessage;
        TemplateId::RiskLimitUpdateRequestMessage -> risk_limit_update_request_message: RiskLimitUpdateRequestMessage;
        TemplateId::RiskActionRequestMessage -> risk_action_request_message: RiskActionRequestMessage;
        * -> unknown: bytes &eod;
    };
};

type NewOrderSingleMessage = unit {
    account_account_optional: bytes &size=16;
    instrument_id: uint32;
    market_participant_id_optional: bytes &size=4;
    cl_ord_id: uint64;
    clearing_account_optional: bytes &size=4;
    customer_or_firm: int8 &convert=CustomerOrFirm($$);
    open_close: int8 &convert=OpenClose($$);
    attributed_quote_optional: int8 &convert=AttributedQuoteOptional($$);
    time_in_force: int8 &convert=TimeInForce($$);
    cancel_instead_of_slide_optional: int8 &convert=CancelInsteadOfSlideOptional($$);
    display_inst: int8 &convert=DisplayInst($$);
    exec_inst: int8 &convert=ExecInst($$);
    ord_type: int8 &convert=OrdType($$);
    target_party_id: bytes &size=4;
    auction_id: uint32;
    clearing_firm: uint32;
    optional_data: bytes &size=16;
    routing_firm_id: bytes &size=4;
    aiq: bytes &size=3;
    side: int8 &convert=Side($$);
    price_price_8_optional: int64;
    order_qty_quantity_non_zero: uint32;
};

type OrderCancelReplaceRequestMessage = unit {
    account_account_optional: bytes &size=16;
    instrument_id: uint32;
    market_participant_id_optional: bytes &size=4;
    cl_ord_id: uint64;
    clearing_account_optional: bytes &size=4;
    orig_cl_ord_id: uint64;
    customer_or_firm_optional: int8 &convert=CustomerOrFirmOptional($$);
    open_close_optional: int8 &convert=OpenCloseOptional($$);
    attributed_quote_optional: int8 &convert=AttributedQuoteOptional($$);
    time_in_force_optional: int8 &convert=TimeInForceOptional($$);
    cancel_instead_of_slide_optional: int8 &convert=CancelInsteadOfSlideOptional($$);
    display_inst: int8 &convert=DisplayInst($$);
    exec_inst: int8 &convert=ExecInst($$);
    ord_type_optional: int8 &convert=OrdTypeOptional($$);
    target_party_id: bytes &size=4;
    auction_id: uint32;
    clearing_firm: uint32;
    optional_data: bytes &size=16;
    routing_firm_id: bytes &size=4;
    aiq: bytes &size=3;
    side_optional: int8 &convert=SideOptional($$);
    price_price_8_optional: int64;
    order_qty_quantity_non_zero: uint32;
};

type OrderCancelRequestMessage = unit {
    instrument_id: uint32;
    market_participant_id_optional: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
};

type NewBulkQuoteMessage = unit {
    market_participant_id_optional: bytes &size=4;
    custom_group_id_optional: uint16;
    cl_ord_id: uint64;
    clearing_account_optional: bytes &size=4;
    cancel_instead_of_slide_optional: int8 &convert=CancelInsteadOfSlideOptional($$);
    send_time: uint64;
    aiq: bytes &size=3;
    time_in_force: int8 &convert=TimeInForce($$);
    new_bulk_quote_message_quote_updates_groups: NewBulkQuoteMessageQuoteUpdatesGroups;
};

type NewBulkQuoteMessageQuoteUpdatesGroups = unit {
    quote_updates_group_encoding: QuoteUpdatesGroupEncoding;
    new_bulk_quote_message_quote_updates_group: NewBulkQuoteMessageQuoteUpdatesGroup[self.quote_updates_group_encoding.num_in_group];
};

type QuoteUpdatesGroupEncoding = unit {
    block_length_short: uint8;
    num_in_group: uint8;
};

type NewBulkQuoteMessageQuoteUpdatesGroup = unit {
    instrument_id: uint32;
    side: int8 &convert=Side($$);
    price_price_4_optional: int32;
    order_qty_quantity_zero_optional: uint32;
    quote_type: int8 &convert=QuoteType($$);
    reserved: int8;
};

type MassCancelRequestMessage = unit {
    underlying_id_optional: uint32;
    market_participant_id_optional: bytes &size=4;
    cl_ord_id: uint64;
    send_time: uint64;
    ack_style_mass_cancel_ack_style: uint8 &convert=AckStyleMassCancelAckStyle($$);
    mpid_filter: uint8 &convert=MpidFilter($$);
    bulk_action: uint8 &convert=BulkAction($$);
};

type PurgeRequestMessage = unit {
    underlying_id_optional: uint32;
    market_participant_id_optional: bytes &size=4;
    cl_ord_id: uint64;
    send_time: uint64;
    ack_style_purge_request_ack_style: uint8 &convert=AckStylePurgeRequestAckStyle($$);
    bulk_action: uint8 &convert=BulkAction($$);
    purge_request_message_custom_group_ids_groups: PurgeRequestMessageCustomGroupIdsGroups;
};

type PurgeRequestMessageCustomGroupIdsGroups = unit {
    custom_group_ids_group_encoding: CustomGroupIdsGroupEncoding;
    purge_request_message_custom_group_ids_group: PurgeRequestMessageCustomGroupIdsGroup[self.custom_group_ids_group_encoding.num_in_group];
};

type CustomGroupIdsGroupEncoding = unit {
    block_length_short: uint8;
    num_in_group: uint8;
};

type PurgeRequestMessageCustomGroupIdsGroup = unit {
    custom_group_id: uint16;
};

type RiskLimitUpdateRequestMessage = unit {
    underlying_id_optional: uint32;
    market_participant_id_optional: bytes &size=4;
    cl_ord_id: uint64;
    risk_control_optional: int8 &convert=RiskControlOptional($$);
    risk_control_status: int8 &convert=RiskControlStatus($$);
    time_limit: uint64;
    percentage_limit: uint32;
    count_limit: uint32;
    ioc_attribution: int8 &convert=IocAttribution($$);
    cust_capacity_weight: uint8;
};

type RiskActionRequestMessage = unit {
    underlying_id_optional: uint32;
    market_participant_id_optional: bytes &size=4;
    cl_ord_id: uint64;
    risk_control: int8 &convert=RiskControl($$);
    risk_action: int8 &convert=RiskAction($$);
    custom_group_id_optional: uint16;
};

type TemplateId = enum {
    LoginRequestMessage = 1,
    LoginResponseMessage = 2,
    GatewayHeartbeatMessage = 3,
    ClientHeartbeatMessage = 4,
    LogoutRequestMessage = 5,
    TerminateMessage = 6,
    SequencedMessageHeaderMessage = 7,
    SubsessionJoinMessage = 8,
    SubsessionJoinResponseMessage = 9,
    SubsessionLeaveMessage = 10,
    SubsessionLeaveResponseMessage = 11,
    OrderAckMessage = 101,
    UnsolicitedModifyAckMessage = 102,
    OrderCancelAckMessage = 103,
    MassCancelAckMessage = 104,
    BulkQuoteAckMessage = 105,
    NewIocQuoteAckMessage = 106,
    QuoteRestatedMessage = 107,
    QuoteCanceledMessage = 108,
    PurgeAckMessage = 109,
    ExecutionReportMessage = 110,
    TradeBustCorrectMessage = 111,
    ApplicationLayerRejectMessage = 112,
    RiskLimitUpdateRequestMessage = 51,
    RiskActionRequestMessage = 52,
    UnderlyingRefDataMessage = 151,
    InstrumentRefDataMessage = 152,
    MpidConfigurationAcknowledgementMessage = 153,
    MarketMakerSymbolAppointmentMessage = 154,
    SessionConfigurationAcknowledgementMessage = 155,
    RiskControlAcknowledgmentMessage = 156,
    RiskControlAlertMessage = 157,
};

type SchemaId = enum {
    Session = 20000,
    Business = 20001,
};

type CustomerOrFirm = enum {
    Customer = 0,
    Firm = 1,
    BrokerDealer = 2,
    MarketMaker = 3,
    AwayMarketMaker = 4,
    ProfCustomer = 5,
};

type OpenClose = enum {
    Open = 0,
    Close = 1,
    NotApplicable = 2,
};

type AttributedQuoteOptional = enum {
    Sum = 1,
    OrderInfoCapacity = 2,
    OrderInfoMpid = 3,
    OrderInfoCapacityMpid = 4,
    DoNotUseSum = 5,
};

type TimeInForce = enum {
    Day = 0,
    Ioc = 1,
};

type CancelInsteadOfSlideOptional = enum {
    Slide = 0,
    Cancel = 1,
};

type DisplayInst = enum {
    PostOnly = 1,
};

type ExecInst = enum {
    Iso = 1,
    DoNotRoute = 2,
};

type OrdType = enum {
    Market = 1,
    Limit = 2,
};

type Side = enum {
    Buy = 1,
    Sell = 2,
};

type CustomerOrFirmOptional = enum {
    Customer = 0,
    Firm = 1,
    BrokerDealer = 2,
    MarketMaker = 3,
    AwayMarketMaker = 4,
    ProfCustomer = 5,
};

type OpenCloseOptional = enum {
    Open = 0,
    Close = 1,
    NotApplicable = 2,
};

type TimeInForceOptional = enum {
    Day = 0,
    Ioc = 1,
};

type OrdTypeOptional = enum {
    Market = 1,
    Limit = 2,
};

type SideOptional = enum {
    Buy = 1,
    Sell = 2,
};

type QuoteType = enum {
    Standard = 0,
    Reprice = 1,
    Cancel = 2,
};

type AckStyleMassCancelAckStyle = enum {
    SingleAck = 0,
    PerOrderAckAndSingleAck = 1,
};

type MpidFilter = enum {
    ExplicitMpid = 0,
    AcrossMpiDs = 1,
};

type BulkAction = enum {
    Cancel = 0,
    CancelAndBlock = 1,
    Unblock = 2,
};

type AckStylePurgeRequestAckStyle = enum {
    SingleAck = 0,
    SingleAckWithMmqs = 1,
};

type RiskControlOptional = enum {
    TransactionBased = 1,
    VolumeBased = 2,
    PercentageBased = 3,
    Grmp = 4,
    PurgeLockoutReset = 5,
    IntrinsicValueAndArbitrage = 6,
    AllBlocksForUnderlying = 7,
};

type RiskControlStatus = enum {
    Disabled = 0,
    Enabled = 1,
};

type IocAttribution = enum {
    IncludeIoc = 1,
    ExcludeIoc = 2,
};

type RiskControl = enum {
    TransactionBased = 1,
    VolumeBased = 2,
    PercentageBased = 3,
    Grmp = 4,
    PurgeLockoutReset = 5,
    IntrinsicValueAndArbitrage = 6,
    AllBlocksForUnderlying = 7,
};

type RiskAction = enum {
    QueryRiskControl = 1,
    Unblock = 2,
};

