module IexIexequitiesTopsIextpV156;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type IexequitiesTopsV156 = unit {
    iextp_header: IextpHeader;
    messages: Message[self.iextp_header.message_count];
};

type IextpHeader = unit {
    version: uint8;
    : skip bytes &size=1;   # padding
    message_protocol_id: uint16;
    channel_id: uint32;
    session_id: uint32;
    payload_length: uint16;
    message_count: uint16;
    stream_offset: uint64;
    first_message_sequence_number: uint64;
    send_time: uint64;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::QuoteUpdateMessage -> quote_update_message: QuoteUpdateMessage;
        MessageType::TradeReportMessage -> trade_report_message: TradeReportMessage;
        MessageType::TradeBreakMessage -> trade_break_message: TradeBreakMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type QuoteUpdateMessage = unit {
    quote_update_flags: bitfield(8) {
        unused_6: 0..5;
        market_session: 6;
        symbol_availability: 7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: int64;
    symbol: bytes &size=8;
    bid_size: uint32;
    bid_price: int64;
    ask_price: int64;
    ask_size: uint32;
};

type TradeReportMessage = unit {
    sale_condition_flags: bitfield(8) {
        unused_4: 0..3;
        trade_through_exempt: 4;
        odd_lot: 5;
        extended_hours: 6;
        intermarket_sweep: 7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: int64;
    symbol: bytes &size=8;
    size: uint32;
    price: int64;
    trade_id: uint64;
    reserved_4: uint32;
};

type TradeBreakMessage = unit {
    sale_condition_flags: bitfield(8) {
        unused_4: 0..3;
        trade_through_exempt: 4;
        odd_lot: 5;
        extended_hours: 6;
        intermarket_sweep: 7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: int64;
    symbol: bytes &size=8;
    size: uint32;
    price: int64;
    trade_id: uint64;
    reserved_4: uint32;
};

type MessageType = enum {
    QuoteUpdateMessage = 0x51,
    TradeReportMessage = 0x54,
    TradeBreakMessage = 0x42,
};

