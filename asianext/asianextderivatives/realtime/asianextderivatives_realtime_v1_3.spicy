module AsianextAsianextderivativesRealtimeAmdV13;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AsianextderivativesRealtimeV13 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    message_count: uint8;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        MsgType::OrderAddMessage -> order_add_message: OrderAddMessage;
        MsgType::OrderCancelMessage -> order_cancel_message: OrderCancelMessage;
        MsgType::OrderModifyMessage -> order_modify_message: OrderModifyMessage;
        MsgType::TradeMessage -> trade_message: TradeMessage;
        MsgType::TradeBustMessage -> trade_bust_message: TradeBustMessage;
        MsgType::TickTableDataMessage -> tick_table_data_message: TickTableDataMessage;
        MsgType::SecurityDefinitionMessage -> security_definition_message: SecurityDefinitionMessage;
        MsgType::SecurityDefinitionFuturesMessage -> security_definition_futures_message: SecurityDefinitionFuturesMessage;
        MsgType::SecurityDefinitionOptionsMessage -> security_definition_options_message: SecurityDefinitionOptionsMessage;
        MsgType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_type: uint8 &convert=MsgType($$);
    msg_length: uint8;
    seq_no: uint32;
};

type SequenceNumberResetMessage = unit {
    next_seq_no: uint32;
};

type OrderAddMessage = unit {
    security_id: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint64;
    price: uint64;
    order_ref: uint64;
    timestamp: uint64;
};

type OrderCancelMessage = unit {
    security_id: uint32;
    order_ref: uint64;
    timestamp: uint64;
};

type OrderModifyMessage = unit {
    security_id: uint32;
    quantity: uint64;
    price: uint64;
    order_ref: uint64;
    timestamp: uint64;
};

type TradeMessage = unit {
    security_id: uint32;
    trade_type: uint8 &convert=TradeType($$);
    quantity: uint64;
    price: uint64;
    order_ref: uint64;
    trade_ref: uint64;
    timestamp: uint64;
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
};

type TradeBustMessage = unit {
    security_id: uint32;
    quantity: uint64;
    price: uint64;
    trade_ref: uint64;
    timestamp: uint64;
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
};

type TickTableDataMessage = unit {
    tick_table_id: uint8;
    name: bytes &size=10;
    threshold: uint64;
    tick_size: uint64;
};

type SecurityDefinitionMessage = unit {
    security_id: uint32;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic: bytes &size=4;
    tick_table_id: uint8;
    flags: bitfield(16) {
        mac_enabled: 0;
        test_stock: 1;
        illiquid: 2;
        live: 3;
        aod_enabled: 4;
        unused_11: 5..15;
    } &byte-order=spicy::ByteOrder::Little;
    exchange_symbol: bytes &size=20;
    lot_size_composite: LotSizeComposite;
};

type LotSizeComposite = unit {
    lot_size: uint64;
    lot_size_decimal: uint8;
};

type SecurityDefinitionFuturesMessage = unit {
    security_id: uint32;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic: bytes &size=4;
    tick_table_id: uint8;
    futures_flags: bitfield(16) {
        mac_enabled: 0;
        test_stock: 1;
        illiquid: 2;
        live: 3;
        unused_1: 4;
        underlying_flag: 5;
        rfq_only: 6;
        unused_9: 7..15;
    } &byte-order=spicy::ByteOrder::Little;
    exchange_symbol: bytes &size=20;
    lot_size_composite: LotSizeComposite;
    maturity_date: uint64;
    settlement_type: uint8 &convert=SettlementType($$);
    contract_size_composite: ContractSizeComposite;
    underlying: bytes &size=20;
};

type ContractSizeComposite = unit {
    contract_size: uint64;
    contract_size_decimals: uint8;
};

type SecurityDefinitionOptionsMessage = unit {
    security_id: uint32;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic: bytes &size=4;
    tick_table_id: uint8;
    options_flags: bitfield(16) {
        unused_1: 0;
        test_stock: 1;
        illiquid: 2;
        live: 3;
        second_unused_1: 4;
        underlying_flag: 5;
        rfq_only: 6;
        unused_9: 7..15;
    } &byte-order=spicy::ByteOrder::Little;
    exchange_symbol: bytes &size=20;
    lot_size_composite: LotSizeComposite;
    maturity_date: uint64;
    settlement_type: uint8 &convert=SettlementType($$);
    contract_size_composite: ContractSizeComposite;
    underlying: bytes &size=20;
    option_type: uint8 &convert=OptionType($$);
    exercise_style: uint8 &convert=ExerciseStyle($$);
    strike_price: uint64;
};

type SecurityStatusMessage = unit {
    security_id: uint32;
    trading_status: uint8 &convert=TradingStatus($$);
    market_flags: bitfield(8) {
        trading: 0;
        mac_open: 1;
        mac_run: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64;
    trading_phase: uint8 &convert=TradingPhase($$);
};

type MsgType = enum {
    HeartbeatMessage = 1,
    SequenceNumberResetMessage = 29,
    OrderAddMessage = 2,
    OrderCancelMessage = 3,
    OrderModifyMessage = 4,
    TradeMessage = 5,
    TradeBustMessage = 6,
    TickTableDataMessage = 7,
    SecurityDefinitionMessage = 8,
    SecurityDefinitionFuturesMessage = 30,
    SecurityDefinitionOptionsMessage = 32,
    SecurityStatusMessage = 9,
};

type Side = enum {
    BuyOrder = 1,
    SellOrder = 2,
};

type TradeType = enum {
    Visible = 1,
};

type MarketMechanism = enum {
    CentralLimitOrderBook = 1,
    QuoteDrivenMarket = 2,
    DarkOrderBook = 3,
    OffBook = 4,
    PeriodicAuction = 5,
    Rfq = 6,
    Other = 7,
};

type TradingMode = enum {
    UndefinedAuction = 1,
    OpeningAuction = 2,
    ClosingAuction = 3,
    IntradayAuction = 4,
    UnscheduledAuction = 5,
    ContinuousTrading = 6,
    AtMarketClose = 7,
    OutOfMainSession = 8,
    OnExchangeTradeReporting = 9,
    OffExchangeTradeReporting = 10,
    SystematicInternalizerTradeReporting = 11,
};

type TransactionCategory = enum {
    DarkTrade = 1,
    TradeThatHasReceivedPriceImprovement = 2,
    PackageTrade = 3,
    ExchangeForPhysicals = 4,
    NoneApply = 5,
};

type NegotiationIndicatorOrPreTradeTransparencyWaiver = enum {
    NegotiatedTrade = 0,
    NegotiatedTradeInLiquidInstruments = 1,
    NegotiatedTradeInIlliquidInstruments = 2,
    NegotiatedTradeOtherThanCurrentMarketPrice = 3,
    NoNegotiatedTrade = 4,
    SiIlliquidInstruments = 5,
    SiAboveStandardMarketSize = 6,
    IlqdAndSize = 7,
};

type CrossingTrade = enum {
    No = 0,
    Yes = 1,
};

type ModificationIndicator = enum {
    TradeCancellation = 1,
    TradeAmendment = 2,
    NewTrade = 3,
};

type BenchmarkReferencePriceIndicator = enum {
    BenchmarkTrade = 1,
    ReferencePriceTrade = 2,
    NoBenchmarkOrRefPrice = 3,
};

type Dividend = enum {
    No = 0,
    Yes = 1,
};

type OffBookAutomation = enum {
    Unspecified = 1,
    OffBookNonAutomated = 2,
    OffBookAutomated = 3,
};

type PriceFormationDiscoveryProcess = enum {
    PlainVanilla = 1,
    NonPriceForming = 2,
    TradeNotContributingToPriceDiscovery = 3,
    PriceNotCurrentlyAvailableButPending = 4,
};

type AlgorithmicIndicator = enum {
    No = 0,
    Yes = 1,
};

type PublicationModePostTradeDeferral = enum {
    ImmediatePublication = 1,
    NonImmediatePublication = 2,
    Lrgs = 3,
    Ilqd = 4,
    Size = 5,
    IlqdAndSize = 6,
    IlqdAndLrgs = 7,
};

type DeferralType = enum {
    NoneApply = 0,
};

type DuplicativeIndicator = enum {
    Unique = 0,
    Duplicative = 1,
};

type SettlementType = enum {
    Cash = 1,
    Physical = 2,
};

type OptionType = enum {
    Call = 1,
    Put = 2,
};

type ExerciseStyle = enum {
    American = 1,
    European = 2,
    Asian = 3,
    Bermudan = 4,
};

type TradingStatus = enum {
    Active = 1,
    Halted = 2,
    Suspended = 3,
};

type Trading = enum {
    ContinuousTradingClosed = 0,
    ContinuousTradingOpen = 1,
};

type TradingPhase = enum {
    ContinuousTrading = 1,
};

