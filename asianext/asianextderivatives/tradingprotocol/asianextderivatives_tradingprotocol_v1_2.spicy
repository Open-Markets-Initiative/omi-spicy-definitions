module AsianextAsianextderivativesTradingprotocolAtpV12;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AsianextderivativesTradingprotocolV12 = unit {
    message: Message[] &eod;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::LoginMessage -> login_message: LoginMessage;
        MsgType::LoginResponseMessage -> login_response_message: LoginResponseMessage;
        MsgType::LogoutMessage -> logout_message: LogoutMessage;
        MsgType::OrderAddMessage -> order_add_message: OrderAddMessage;
        MsgType::OrderAddExtendedMessage -> order_add_extended_message: OrderAddExtendedMessage;
        MsgType::OrderCancelMessage -> order_cancel_message: OrderCancelMessage;
        MsgType::OrderModifyMessage -> order_modify_message: OrderModifyMessage;
        MsgType::OrderModifyExtendedMessage -> order_modify_extended_message: OrderModifyExtendedMessage;
        MsgType::OrderAddResponseMessage -> order_add_response_message: OrderAddResponseMessage;
        MsgType::OrderCancelResponseMessage -> order_cancel_response_message: OrderCancelResponseMessage;
        MsgType::OrderModifyResponseMessage -> order_modify_response_message: OrderModifyResponseMessage;
        MsgType::QuoteRequestMessage -> quote_request_message: QuoteRequestMessage;
        MsgType::QuoteRequestNotificationMessage -> quote_request_notification_message: QuoteRequestNotificationMessage;
        MsgType::QuoteAddMessage -> quote_add_message: QuoteAddMessage;
        MsgType::QuoteModifyMessage -> quote_modify_message: QuoteModifyMessage;
        MsgType::QuoteCancelMessage -> quote_cancel_message: QuoteCancelMessage;
        MsgType::TradeMessage -> trade_message: TradeMessage;
        MsgType::TradeBustMessage -> trade_bust_message: TradeBustMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_length: uint16;
    msg_type: uint8 &convert=MsgType($$);
    msg_seq_no: uint64;
};

type LoginMessage = unit {
    protocol_version: uint16;
    sender_id: bytes &size=16;
    password: bytes &size=16;
    inactivity_timeout: uint16;
    atp_seq_no: uint64;
};

type LoginResponseMessage = unit {
    result_code: uint8 &convert=ResultCode($$);
    client_seq_no: uint64;
};

type LogoutMessage = unit {
    logout_reason_code: uint8 &convert=LogoutReasonCode($$);
    reason_text: bytes &size=32;
};

type OrderAddMessage = unit {
    security_id_long: uint32;
    order_type: uint8 &convert=OrderType($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    side: uint8 &convert=Side($$);
    quantity: uint32;
    price: uint64;
    order_capacity: uint8 &convert=OrderCapacity($$);
    account: uint16;
    user_tag: uint64;
    flags: bitfield(8) {
        liq_prov: 0;
        algo_trade_flag: 1;
        dea_flag: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    table_select_1: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_1: uint32 &convert=ShortCode1($$);
    table_select_2: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_2: uint32 &convert=ShortCode2($$);
    table_select_3: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_3: uint32 &convert=ShortCode3($$);
};

type OrderAddExtendedMessage = unit {
    security_id_long: uint32;
    order_type: uint8 &convert=OrderType($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    side: uint8 &convert=Side($$);
    quantity: uint32;
    price: uint64;
    order_capacity: uint8 &convert=OrderCapacity($$);
    account: uint16;
    user_tag: uint64;
    flags: bitfield(8) {
        liq_prov: 0;
        algo_trade_flag: 1;
        dea_flag: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    table_select_1: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_1: uint32 &convert=ShortCode1($$);
    table_select_2: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_2: uint32 &convert=ShortCode2($$);
    table_select_3: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_3: uint32 &convert=ShortCode3($$);
    display_quantity: uint32;
    min_qty: uint32;
    extended_order_flags: bitfield(8) {
        unused_8: 0..7;
    } &byte-order=spicy::ByteOrder::Little;
    expire_time: uint64;
    rfq_session_id: uint64;
};

type OrderCancelMessage = unit {
    order_ref: uint64;
    user_tag: uint64;
    flags: bitfield(8) {
        liq_prov: 0;
        algo_trade_flag: 1;
        dea_flag: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    table_select_1: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_1: uint32 &convert=ShortCode1($$);
    table_select_2: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_2: uint32 &convert=ShortCode2($$);
    table_select_3: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_3: uint32 &convert=ShortCode3($$);
};

type OrderModifyMessage = unit {
    order_ref: uint64;
    price: uint64;
    quantity: uint32;
    user_tag: uint64;
    flags: bitfield(8) {
        liq_prov: 0;
        algo_trade_flag: 1;
        dea_flag: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    table_select_1: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_1: uint32 &convert=ShortCode1($$);
    table_select_2: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_2: uint32 &convert=ShortCode2($$);
    table_select_3: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_3: uint32 &convert=ShortCode3($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
};

type OrderModifyExtendedMessage = unit {
    order_ref: uint64;
    price: uint64;
    quantity: uint32;
    user_tag: uint64;
    flags: bitfield(8) {
        liq_prov: 0;
        algo_trade_flag: 1;
        dea_flag: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    table_select_1: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_1: uint32 &convert=ShortCode1($$);
    table_select_2: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_2: uint32 &convert=ShortCode2($$);
    table_select_3: bitfield(8) {
        party_role: 0..3;
        party_role_qualifier: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    short_code_3: uint32 &convert=ShortCode3($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    display_quantity: uint32;
    min_qty: uint32;
    expire_time: uint64;
};

type OrderAddResponseMessage = unit {
    order_ref: uint64;
    market_data_id: uint64;
    # Order Add Response Status is 1 byte whichever arm the model names: the arms are bit field sets of that width differing only in what the bits beside Order Status are called — a value of Order Status of 3 names Status Cancel Reason; 4 names Status Reject Reason; any other value names Status. Which naming applies is left to what is built on the definition, as a set's members always are.
    order_add_response_status: bitfield(8) {
        cancel_reason: 0..4;
        order_status: 5..7;
    } &byte-order=spicy::ByteOrder::Little;
    traded_quantity: uint32;
    timestamp: uint64 &convert=time_ns($$);
    user_tag: uint64;
    order_add_response_flags: bitfield(8) {
        unused_8: 0..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type OrderCancelResponseMessage = unit {
    order_ref: uint64;
    request_ref: uint64;
    # Order Cancel Response Status is 1 byte whichever arm the model names: the arms are bit field sets of that width differing only in what the bits beside Order Status are called — a value of Order Status of 3 names Status Cancel Reason; 4 names Status Reject Reason; any other value names Status. Which naming applies is left to what is built on the definition, as a set's members always are.
    order_cancel_response_status: bitfield(8) {
        cancel_reason: 0..4;
        order_status: 5..7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &convert=time_ns($$);
    user_tag: uint64;
};

type OrderModifyResponseMessage = unit {
    order_ref: uint64;
    request_ref: uint64;
    # Order Modify Response Status is 1 byte whichever arm the model names: the arms are bit field sets of that width differing only in what the bits beside Order Status are called — a value of Order Status of 4 names Status Reject Reason; any other value names Status Modification Reason. Which naming applies is left to what is built on the definition, as a set's members always are.
    order_modify_response_status: bitfield(8) {
        reject_reason: 0..4;
        order_status: 5..7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &convert=time_ns($$);
    user_tag: uint64;
    order_modify_response_flags: bitfield(8) {
        unused_8: 0..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type QuoteRequestMessage = unit {
    security_id_long: uint32;
    quantity: uint32;
    side: uint8 &convert=Side($$);
    user_tag: uint64;
    market_maker_code_1: bytes &size=4;
    market_maker_code_2: bytes &size=4;
    market_maker_code_3: bytes &size=4;
    market_maker_code_4: bytes &size=4;
    market_maker_code_5: bytes &size=4;
};

type QuoteRequestNotificationMessage = unit {
    rfq_session_id: uint64;
    security_id_long: uint32;
    quantity: uint32;
    side: uint8 &convert=Side($$);
    quote_request_status: uint8 &convert=QuoteRequestStatus($$);
    status_details: uint8 &convert=StatusDetails($$);
    msg_ref: uint64;
    user_tag: uint64;
};

type QuoteAddMessage = unit {
    aqx_order_id: uint64;
    security_id_short: uint16;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    price: uint64;
    rfq_session_id: uint64;
};

type QuoteModifyMessage = unit {
    aqx_order_id: uint64;
    security_id_short: uint16;
    quantity: uint32;
    price: uint64;
};

type QuoteCancelMessage = unit {
    aqx_order_id: uint64;
    security_id_short: uint16;
};

type TradeMessage = unit {
    order_ref: uint64;
    quantity: uint32;
    price: uint64;
    side: uint8 &convert=Side($$);
    trade_ref: uint64;
    ccp_code: uint8;
    liq_indicator: uint8 &convert=LiqIndicator($$);
    security_id_long: uint32;
    timestamp: uint64 &convert=time_ns($$);
    user_tag: uint64;
    trade_flags: bitfield(8) {
        unused_8: 0..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type TradeBustMessage = unit {
    order_ref: uint64;
    quantity: uint32;
    price: uint64;
    side: uint8 &convert=Side($$);
    trade_ref: uint64;
    timestamp: uint64 &convert=time_ns($$);
};

type MsgType = enum {
    LoginMessage = 1,
    LoginResponseMessage = 2,
    HeartbeatMessage = 0,
    LogoutRequestMessage = 3,
    LogoutMessage = 4,
    OrderAddMessage = 5,
    OrderAddExtendedMessage = 21,
    OrderCancelMessage = 7,
    OrderModifyMessage = 9,
    OrderModifyExtendedMessage = 22,
    OrderAddResponseMessage = 6,
    OrderCancelResponseMessage = 8,
    OrderModifyResponseMessage = 10,
    QuoteRequestMessage = 30,
    QuoteRequestNotificationMessage = 31,
    QuoteAddMessage = 13,
    QuoteModifyMessage = 14,
    QuoteCancelMessage = 15,
    TradeMessage = 11,
    TradeBustMessage = 12,
};

type ResultCode = enum {
    SuccessfulLogin = 0,
    AlreadyLoggedIn = 1,
    SequenceNumberError = 2,
    UnsupportedProtocol = 3,
    FailedAuthentication = 4,
    UnknownSourceNetwork = 5,
};

type LogoutReasonCode = enum {
    UserRequested = 0,
    Admin = 1,
    Disconnect = 2,
    EndOfDay = 3,
    InactivityTimeout = 4,
    ProtocolError = 5,
    SequenceNumberError = 6,
    Maintenance = 8,
};

type OrderType = enum {
    LimitOrder = 1,
    PostOnlyCancelReplace = 8,
    PostOnly = 9,
    RfqLimit = 15,
    RfqQuote = 16,
};

type TimeInForce = enum {
    Day = 1,
    FillOrKill = 2,
    ImmediateOrCancel = 3,
    GoodTillDate = 4,
};

type Side = enum {
    NoSideSpecified = 0,
    BuyOrder = 1,
    SellOrder = 2,
};

type OrderCapacity = enum {
    Aotc = 1,
    Deal = 2,
    Mtch = 3,
};

type PartyRole = enum {
    None_0 = 0,
    ClientId = 1,
    ExecutingDecisionId = 2,
    InvestingDecisionId = 3,
};

type PartyRoleQualifier = enum {
    None_0 = 0,
    Algo = 1,
    Firm = 2,
    Person = 3,
};

type ShortCode1 = enum {
    None_0 = 0,
    Aggr = 1,
    Pnal = 2,
    Client = 3,
};

type ShortCode2 = enum {
    None_0 = 0,
    Aggr = 1,
    Pnal = 2,
    Client = 3,
};

type ShortCode3 = enum {
    None_0 = 0,
    Aggr = 1,
    Pnal = 2,
    Client = 3,
};

type CancelReason = enum {
    IocOrFokNotFilled = 0,
    MemberRequest = 1,
    AsiaNextForcedCancel = 2,
    MarketClose = 3,
    Expired = 4,
    Reserved = 5,
    Aborted = 6,
    SelfTradePrevention = 7,
    CancelOnDisconnect = 8,
    PostOnlyCancel = 9,
    CancelResidualQuantity = 10,
    PostOnlyCancelResting = 11,
    MinimumRestingValue = 12,
};

type OrderStatus = enum {
    PendingNew = 1,
    Acknowledged = 2,
    Cancelled = 3,
    Rejected = 4,
    Filled = 5,
    Modified = 6,
};

type RejectReason = enum {
    NotAuthorisedToTrade = 1,
    InvalidQuantity = 2,
    InvalidPrice = 3,
    UnknownSecurity = 4,
    PriceDoesNotConformToTick = 5,
    InvalidOrderType = 6,
    InvalidSide = 7,
    InvalidOrderCapacity = 8,
    MarketIsClosed = 9,
    Halted = 10,
    Suspended = 11,
    InvalidTimeInForce = 12,
    OrderNotFoundOrNotOpen = 13,
    FailedPriceRangeCheck = 15,
    InvalidClearingAccount = 16,
    NotSupported = 17,
    MaxValueExceeded = 18,
    AuctionEnded = 19,
    DropFeedDown = 20,
    TechnicalReject = 21,
    StockRestricted = 23,
    MinimumConsideration = 24,
    Invalid = 27,
    BadDate = 29,
    Duplicate = 30,
    RejectInternal = 31,
};

type ModificationReason = enum {
    ModificationAccepted = 1,
    CancelledByModificationToZero = 2,
};

type QuoteRequestStatus = enum {
    Acknowledgement = 1,
    Expired = 2,
    Rejected = 3,
};

type StatusDetails = enum {
    Acknowledgement = 0,
    SecuritySuspended = 1,
    SecurityHalted = 2,
    UnsupportedSecurity = 3,
    InvalidMarketMaker = 4,
    InvalidSide = 5,
    InvalidQuantity = 6,
    NotSupported = 8,
    InvalidOrderType = 9,
    InternalError = 10,
    NotAuthorised = 11,
    MarketClosed = 12,
    SessionClosed = 13,
};

type LiqIndicator = enum {
    AddedLiquidity = 1,
    RemovedLiquidity = 2,
};

