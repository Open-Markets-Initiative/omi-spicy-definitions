module AsianextAsianextderivativesSnapshotAmdV13;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AsianextderivativesSnapshotV13 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    message_count: uint8;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::SnapshotStartMessage -> snapshot_start_message: SnapshotStartMessage;
        MsgType::BookStatusMessage -> book_status_message: BookStatusMessage;
        MsgType::BookEntryMessage -> book_entry_message: BookEntryMessage;
        MsgType::TickTableDataMessage -> tick_table_data_message: TickTableDataMessage;
        MsgType::SecurityDefinitionMessage -> security_definition_message: SecurityDefinitionMessage;
        MsgType::SecurityDefinitionFuturesMessage -> security_definition_futures_message: SecurityDefinitionFuturesMessage;
        MsgType::SecurityDefinitionOptionsMessage -> security_definition_options_message: SecurityDefinitionOptionsMessage;
        MsgType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MsgType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_type: uint8 &convert=MsgType($$);
    msg_length: uint8;
    seq_no: uint32;
};

type SnapshotStartMessage = unit {
    stream_seq_no: uint32;
    security_count: uint32;
    timestamp: uint64;
};

type BookStatusMessage = unit {
    security_id: uint32;
    trading_status: uint8 &convert=TradingStatus($$);
    market_flags: bitfield(8) {
        trading: 0;
        mac_open: 1;
        mac_run: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    entries: uint16;
    closing_buy_qty: uint64;
    closing_sell_qty: uint64;
    indicative_price: uint64;
};

type BookEntryMessage = unit {
    security_id: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint64;
    price: uint64;
    order_ref: uint64;
};

type TickTableDataMessage = unit {
    tick_table_id: uint8;
    name: bytes &size=10;
    threshold: uint64;
    tick_size: uint64;
};

type SecurityDefinitionMessage = unit {
    security_id: uint32;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic: bytes &size=4;
    tick_table_id: uint8;
    flags: bitfield(16) {
        mac_enabled: 0;
        test_stock: 1;
        illiquid: 2;
        live: 3;
        aod_enabled: 4;
        unused_11: 5..15;
    } &byte-order=spicy::ByteOrder::Little;
    exchange_symbol: bytes &size=20;
    lot_size_composite: LotSizeComposite;
};

type LotSizeComposite = unit {
    lot_size: uint64;
    lot_size_decimal: uint8;
};

type SecurityDefinitionFuturesMessage = unit {
    security_id: uint32;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic: bytes &size=4;
    tick_table_id: uint8;
    futures_flags: bitfield(16) {
        mac_enabled: 0;
        test_stock: 1;
        illiquid: 2;
        live: 3;
        unused_1: 4;
        underlying_flag: 5;
        rfq_only: 6;
        unused_9: 7..15;
    } &byte-order=spicy::ByteOrder::Little;
    exchange_symbol: bytes &size=20;
    lot_size_composite: LotSizeComposite;
    maturity_date: uint64;
    settlement_type: uint8 &convert=SettlementType($$);
    contract_size_composite: ContractSizeComposite;
    underlying: bytes &size=20;
};

type ContractSizeComposite = unit {
    contract_size: uint64;
    contract_size_decimals: uint8;
};

type SecurityDefinitionOptionsMessage = unit {
    security_id: uint32;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic: bytes &size=4;
    tick_table_id: uint8;
    options_flags: bitfield(16) {
        unused_1: 0;
        test_stock: 1;
        illiquid: 2;
        live: 3;
        second_unused_1: 4;
        underlying_flag: 5;
        rfq_only: 6;
        unused_9: 7..15;
    } &byte-order=spicy::ByteOrder::Little;
    exchange_symbol: bytes &size=20;
    lot_size_composite: LotSizeComposite;
    maturity_date: uint64;
    settlement_type: uint8 &convert=SettlementType($$);
    contract_size_composite: ContractSizeComposite;
    underlying: bytes &size=20;
    option_type: uint8 &convert=OptionType($$);
    exercise_style: uint8 &convert=ExerciseStyle($$);
    strike_price: uint64;
};

type SecurityStatusMessage = unit {
    security_id: uint32;
    trading_status: uint8 &convert=TradingStatus($$);
    market_flags: bitfield(8) {
        trading: 0;
        mac_open: 1;
        mac_run: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64;
    trading_phase: uint8 &convert=TradingPhase($$);
};

type SequenceNumberResetMessage = unit {
    next_seq_no: uint32;
};

type MsgType = enum {
    SnapshotStartMessage = 10,
    BookStatusMessage = 11,
    BookEntryMessage = 12,
    TickTableDataMessage = 7,
    SecurityDefinitionMessage = 8,
    SecurityDefinitionFuturesMessage = 30,
    SecurityDefinitionOptionsMessage = 32,
    SecurityStatusMessage = 9,
    SequenceNumberResetMessage = 29,
};

type TradingStatus = enum {
    Active = 1,
    Halted = 2,
    Suspended = 3,
};

type Trading = enum {
    ContinuousTradingClosed = 0,
    ContinuousTradingOpen = 1,
};

type Side = enum {
    BuyOrder = 1,
    SellOrder = 2,
};

type SettlementType = enum {
    Cash = 1,
    Physical = 2,
};

type OptionType = enum {
    Call = 1,
    Put = 2,
};

type ExerciseStyle = enum {
    American = 1,
    European = 2,
    Asian = 3,
    Bermudan = 4,
};

type TradingPhase = enum {
    ContinuousTrading = 1,
};

