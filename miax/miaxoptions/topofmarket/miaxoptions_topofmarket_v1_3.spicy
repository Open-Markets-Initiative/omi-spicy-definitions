module MiaxMiaxoptionsTopofmarketMachV13;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type MiaxoptionsTopofmarketV13 = unit {
    mach_message: MachMessage[] &eod;
};

type MachMessage = unit {
    mach_packet_header: MachPacketHeader;
    payload: ApplicationMessage;
};

type MachPacketHeader = unit {
    sequence_number: uint64;
    packet_length: uint16;
    packet_type: uint8 &convert=PacketType($$);
    session_number: uint8;
};

type ApplicationMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SystemTimeMessage -> system_time_message: SystemTimeMessage;
        MessageType::SeriesUpdateMessage -> series_update_message: SeriesUpdateMessage;
        MessageType::SystemStateMessage -> system_state_message: SystemStateMessage;
        MessageType::TopOfMarketBidCompactMessage -> top_of_market_bid_compact_message: TopOfMarketBidCompactMessage;
        MessageType::TopOfMarketOfferCompactMessage -> top_of_market_offer_compact_message: TopOfMarketOfferCompactMessage;
        MessageType::TopOfMarketBidWideMessage -> top_of_market_bid_wide_message: TopOfMarketBidWideMessage;
        MessageType::TopOfMarketOfferWideMessage -> top_of_market_offer_wide_message: TopOfMarketOfferWideMessage;
        MessageType::LastSaleMessage -> last_sale_message: LastSaleMessage;
        MessageType::TradeCancelMessage -> trade_cancel_message: TradeCancelMessage;
        MessageType::LiquiditySeekingEventNotificationMessage -> liquidity_seeking_event_notification_message: LiquiditySeekingEventNotificationMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemTimeMessage = unit {
    seconds: uint32 &convert=time($$);
};

type SeriesUpdateMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    product_id: uint32;
    underlying_symbol: bytes &size=11;
    security_symbol: bytes &size=6;
    expiration_date: bytes &size=8;
    strike_price: uint32;
    call_or_put: uint8 &convert=CallOrPut($$);
    opening_time: bytes &size=8;
    closing_time: bytes &size=8;
    restricted_option: uint8 &convert=RestrictedOption($$);
    long_term_option: uint8 &convert=LongTermOption($$);
    active_on_miax: uint8 &convert=ActiveOnMiax($$);
    miax_bbo_posting_increment_indicator: uint8 &convert=MiaxBboPostingIncrementIndicator($$);
    liquidity_acceptance_increment_indicator: uint8 &convert=LiquidityAcceptanceIncrementIndicator($$);
    opening_underlying_market_code: uint8 &convert=OpeningUnderlyingMarketCode($$);
    priority_quote_width: uint32;
    : skip bytes &size=8;   # padding
};

type SystemStateMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    to_m_version: bytes &size=8;
    session_id: uint32;
    system_status: uint8 &convert=SystemStatus($$);
};

type TopOfMarketBidCompactMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    product_id: uint32;
    mbbo_price_2: uint16;
    mbbo_size_2: uint16;
    : skip bytes &size=2;   # padding
    mbbo_condition: uint8 &convert=MbboCondition($$);
};

type TopOfMarketOfferCompactMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    product_id: uint32;
    mbbo_price_2: uint16;
    mbbo_size_2: uint16;
    : skip bytes &size=2;   # padding
    mbbo_condition: uint8 &convert=MbboCondition($$);
};

type TopOfMarketBidWideMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    product_id: uint32;
    mbbo_price_4: uint32;
    mbbo_size_4: uint32;
    : skip bytes &size=4;   # padding
    mbbo_condition: uint8 &convert=MbboCondition($$);
};

type TopOfMarketOfferWideMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    product_id: uint32;
    mbbo_price_4: uint32;
    mbbo_size_4: uint32;
    : skip bytes &size=4;   # padding
    mbbo_condition: uint8 &convert=MbboCondition($$);
};

type LastSaleMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    product_id: uint32;
    trade_id: uint32;
    correction_number: uint8;
    reference_trade_id: uint32;
    reference_correction_number: uint8;
    trade_price: uint32;
    trade_size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
};

type TradeCancelMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    product_id: uint32;
    trade_id: uint32;
    correction_number: uint8;
    trade_price: uint32;
    trade_size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
};

type LiquiditySeekingEventNotificationMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    product_id: uint32;
    event_type: uint8 &convert=EventType($$);
    event_id: uint32;
    price: uint32;
    imbalance_side: uint8 &convert=ImbalanceSide($$);
    quantity_1: uint32;
    quantity_2: uint32;
    quantity_3: uint32;
    quantity_4: uint32;
    : skip bytes &size=12;   # padding
};

type PacketType = enum {
    Heartbeat = 0,
    StartOfSession = 1,
    EndOfSession = 2,
    ApplicationMessage = 3,
};

type MessageType = enum {
    SystemTimeMessage = 0x31,
    SeriesUpdateMessage = 0x50,
    SystemStateMessage = 0x53,
    TopOfMarketBidCompactMessage = 0x42,
    TopOfMarketOfferCompactMessage = 0x4f,
    TopOfMarketBidWideMessage = 0x57,
    TopOfMarketOfferWideMessage = 0x41,
    LastSaleMessage = 0x54,
    TradeCancelMessage = 0x58,
    LiquiditySeekingEventNotificationMessage = 0x4c,
};

type CallOrPut = enum {
    Call = 0x43,
    Put = 0x50,
};

type RestrictedOption = enum {
    AcceptPositionClosing = 0x59,
    AcceptOpenAndClose = 0x4e,
};

type LongTermOption = enum {
    FarMonthExpiration = 0x59,
    NearMonthExpiration = 0x4e,
};

type ActiveOnMiax = enum {
    Active = 0x41,
    Inactive = 0x49,
};

type MiaxBboPostingIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type LiquidityAcceptanceIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type OpeningUnderlyingMarketCode = enum {
    NyseAmex = 0x41,
    NasdaqOmxBx = 0x42,
    Nse = 0x43,
    FinraAdf = 0x44,
    MarketIndependent = 0x45,
    Ise = 0x49,
    Edga = 0x4a,
    Edgx = 0x4b,
    Cse = 0x4d,
    NyseEuronext = 0x4e,
    NyseArca = 0x50,
    NasdaqOmxUtp = 0x51,
    NasdaqOmxCta = 0x54,
    NasdaqOmxPhlx = 0x58,
    BatsY = 0x59,
    Bats = 0x5a,
};

type SystemStatus = enum {
    StartOfSystemHours = 0x53,
    EndOfSystemHours = 0x43,
    StartTestSession = 0x31,
    EndOfTestSession = 0x32,
};

type MbboCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    Reserved = 0x52,
    TradingHalt = 0x54,
};

type TradeCondition = enum {
    Regular = 0x20,
    CancelOfTradePreviouslyReportedOtherThanAsTheLastOrOpening = 0x41,
    LateAndIsOutOfSequence = 0x42,
    CancelOfTheLastReportedTrade = 0x43,
    LateAndIsInCorrectSequence = 0x44,
    CancelOfTheFirstReportedTrade = 0x45,
    LateReportOfTheOpeningTradeAndIsOutOfSequence = 0x46,
    CancelOfTheOnlyReportedTrade = 0x47,
    LateReportOfTheOpeningTradeAndIsInCorrectSequence = 0x48,
    ReservedI = 0x49,
    ReopeningOfAnOption = 0x4a,
    ReservedK = 0x4b,
    ReservedL = 0x4c,
    ReservedM = 0x4d,
    ReservedN = 0x4e,
    ReservedO = 0x4f,
    ReservedP = 0x50,
    ReservedQ = 0x51,
    ExecutionOfAnOrderWhichWasStoppedAtAPriceThatDidNotConstituteATradeThroughOnAnotherMarketAtTheTimeOfTheStop = 0x52,
    ExecutionOfAnIsoOrder = 0x53,
    ReservedT = 0x54,
    TradeThroughExempt = 0x58,
};

type EventType = enum {
    LiquidityRefreshMechanism = 0x4c,
    OpeningReopeningImbalanceMechanism = 0x4f,
    RouteMechanism = 0x52,
};

type ImbalanceSide = enum {
    Bid = 0x42,
    Ask = 0x41,
};

