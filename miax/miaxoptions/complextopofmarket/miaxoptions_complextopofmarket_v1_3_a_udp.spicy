module MiaxMiaxoptionsComplextopofmarketMachV13AUdp;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type MiaxoptionsComplextopofmarketV13A = unit {
    mach_message: MachMessage[] &eod;
};

type MachMessage = unit {
    sequence_number: uint64;
    packet_length: uint16;
    packet_type: uint8 &convert=PacketType($$);
    session_number: uint8;
    payload: ApplicationMessage;
};

type ApplicationMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SystemTimeMessage -> system_time_message: SystemTimeMessage;
        MessageType::SimpleSeriesUpdateMessage -> simple_series_update_message: SimpleSeriesUpdateMessage;
        MessageType::ComplexStrategyDefinitionMessage -> complex_strategy_definition_message: ComplexStrategyDefinitionMessage;
        MessageType::SystemStateMessage -> system_state_message: SystemStateMessage;
        MessageType::ComplexTopOfMarketBestBidOrOfferCompactFormatBidMessage -> complex_top_of_market_best_bid_or_offer_compact_format_bid_message: ComplexTopOfMarketBestBidOrOfferCompactFormatBidMessage;
        MessageType::ComplexTopOfMarketBestBidOrOfferCompactFormatOfferMessage -> complex_top_of_market_best_bid_or_offer_compact_format_offer_message: ComplexTopOfMarketBestBidOrOfferCompactFormatOfferMessage;
        MessageType::ComplexTopOfMarketBestBidOrOfferWideFormatBidMessage -> complex_top_of_market_best_bid_or_offer_wide_format_bid_message: ComplexTopOfMarketBestBidOrOfferWideFormatBidMessage;
        MessageType::ComplexTopOfMarketBestBidOrOfferWideFormatOfferMessage -> complex_top_of_market_best_bid_or_offer_wide_format_offer_message: ComplexTopOfMarketBestBidOrOfferWideFormatOfferMessage;
        MessageType::ComplexDoubleSidedTopOfMarketBestBidAndOfferCompactFormatMessage -> complex_double_sided_top_of_market_best_bid_and_offer_compact_format_message: ComplexDoubleSidedTopOfMarketBestBidAndOfferCompactFormatMessage;
        MessageType::ComplexDoubleSidedTopOfMarketBestBidAndOfferWideFormatMessage -> complex_double_sided_top_of_market_best_bid_and_offer_wide_format_message: ComplexDoubleSidedTopOfMarketBestBidAndOfferWideFormatMessage;
        MessageType::StrategyLastSaleMessage -> strategy_last_sale_message: StrategyLastSaleMessage;
        MessageType::UnderlyingTradingStatusNotificationMessage -> underlying_trading_status_notification_message: UnderlyingTradingStatusNotificationMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemTimeMessage = unit {
    seconds: uint32;
};

type SimpleSeriesUpdateMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    underlying_symbol: bytes &size=11;
    security_symbol: bytes &size=6;
    expiration_date: bytes &size=8;
    strike_price: uint32;
    call_or_put: uint8 &convert=CallOrPut($$);
    opening_time: bytes &size=8;
    closing_time: bytes &size=8;
    restricted_option: uint8 &convert=RestrictedOption($$);
    long_term_option: uint8 &convert=LongTermOption($$);
    active_on_miax: uint8 &convert=ActiveOnMiax($$);
    miax_bbo_posting_increment_indicator: uint8 &convert=MiaxBboPostingIncrementIndicator($$);
    liquidity_acceptance_increment_indicator: uint8 &convert=LiquidityAcceptanceIncrementIndicator($$);
    opening_underlying_market_code: uint8 &convert=OpeningUnderlyingMarketCode($$);
    priority_quote_width: uint32;
    : skip bytes &size=8;   # padding
};

type ComplexStrategyDefinitionMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    underlying_symbol: bytes &size=11;
    active_on_miax: uint8 &convert=ActiveOnMiax($$);
    : skip bytes &size=1;   # padding
    update_reason: uint8 &convert=UpdateReason($$);
    : skip bytes &size=10;   # padding
    number_of_legs: uint8;
    leg_definition: LegDefinition[self.number_of_legs];
};

type LegDefinition = unit {
    product_id: uint32;
    leg_ratio_qty: uint16;
    leg_side: uint8 &convert=LegSide($$);
    : skip bytes &size=8;   # padding
};

type SystemStateMessage = unit {
    nanoseconds: uint32;
    c_to_m_version: bytes &size=8;
    session_id: uint32;
    system_status: uint8 &convert=SystemStatus($$);
};

type ComplexTopOfMarketBestBidOrOfferCompactFormatBidMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    price_short: int16;
    size_short: uint16;
    priority_customer_size_short: uint16;
    condition: uint8 &convert=Condition($$);
};

type ComplexTopOfMarketBestBidOrOfferCompactFormatOfferMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    price_short: int16;
    size_short: uint16;
    priority_customer_size_short: uint16;
    condition: uint8 &convert=Condition($$);
};

type ComplexTopOfMarketBestBidOrOfferWideFormatBidMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    price_long: int64;
    size_long: uint32;
    priority_customer_size_long: uint32;
    condition: uint8 &convert=Condition($$);
};

type ComplexTopOfMarketBestBidOrOfferWideFormatOfferMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    price_long: int64;
    size_long: uint32;
    priority_customer_size_long: uint32;
    condition: uint8 &convert=Condition($$);
};

type ComplexDoubleSidedTopOfMarketBestBidAndOfferCompactFormatMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    bid_price_short: int16;
    bid_size_short: uint16;
    bid_priority_customer_size_short: uint16;
    bid_condition: uint8 &convert=BidCondition($$);
    offer_price_short: int16;
    offer_size_short: uint16;
    offer_priority_customer_size_short: uint16;
    offer_condition: uint8 &convert=OfferCondition($$);
};

type ComplexDoubleSidedTopOfMarketBestBidAndOfferWideFormatMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    bid_price_long: int64;
    bid_size_long: uint32;
    bid_priority_customer_size_long: uint32;
    bid_condition: uint8 &convert=BidCondition($$);
    offer_price_long: int64;
    offer_size_long: uint32;
    offer_priority_customer_size_long: uint32;
    offer_condition: uint8 &convert=OfferCondition($$);
};

type StrategyLastSaleMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    trade_id: uint32;
    net_price: int64;
    size_long: uint32;
    condition: uint8 &convert=Condition($$);
    : skip bytes &size=16;   # padding
};

type UnderlyingTradingStatusNotificationMessage = unit {
    nanoseconds: uint32;
    underlying_symbol: bytes &size=11;
    trading_status: uint8 &convert=TradingStatus($$);
    event_reason: uint8 &convert=EventReason($$);
    expected_event_time_seconds_part: uint32;
    expected_event_time_nano_seconds_part: uint32;
};

type PacketType = enum {
    Heartbeat = 0,
    StartOfSession = 1,
    EndOfSession = 2,
    ApplicationMessage = 3,
};

type MessageType = enum {
    SystemTimeMessage = 0x31,
    SimpleSeriesUpdateMessage = 0x50,
    ComplexStrategyDefinitionMessage = 0x43,
    SystemStateMessage = 0x53,
    ComplexTopOfMarketBestBidOrOfferCompactFormatBidMessage = 0x62,
    ComplexTopOfMarketBestBidOrOfferCompactFormatOfferMessage = 0x6f,
    ComplexTopOfMarketBestBidOrOfferWideFormatBidMessage = 0x65,
    ComplexTopOfMarketBestBidOrOfferWideFormatOfferMessage = 0x66,
    ComplexDoubleSidedTopOfMarketBestBidAndOfferCompactFormatMessage = 0x6d,
    ComplexDoubleSidedTopOfMarketBestBidAndOfferWideFormatMessage = 0x77,
    StrategyLastSaleMessage = 0x74,
    UnderlyingTradingStatusNotificationMessage = 0x48,
};

type CallOrPut = enum {
    Call = 0x43,
    Put = 0x50,
};

type RestrictedOption = enum {
    Yes = 0x59,
    No = 0x4e,
};

type LongTermOption = enum {
    Yes = 0x59,
    No = 0x4e,
};

type ActiveOnMiax = enum {
    Active = 0x41,
    Inactive = 0x49,
};

type MiaxBboPostingIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type LiquidityAcceptanceIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type OpeningUnderlyingMarketCode = enum {
    NyseAmex = 0x41,
    NasdaqOmxBx = 0x42,
    NationalStockExchange = 0x43,
    FinraAdf = 0x44,
    MarketIndependent = 0x45,
    MiaxPearlEquities = 0x48,
    InternationalSecuritiesExchange = 0x49,
    EdgaExchangeInc = 0x4a,
    EdgxExchangeInc = 0x4b,
    Ltse = 0x4c,
    ChicagoStockExchange = 0x4d,
    NyseEuronext = 0x4e,
    NyseArcaExchange = 0x50,
    NasdaqOmxViaUtpFeed = 0x51,
    NasdaqOmxViaCtaFeed = 0x54,
    Memx = 0x55,
    Iex = 0x56,
    CboeStockExchangeCbsx = 0x57,
    NasdaqOmxPhlx = 0x58,
    BatsYExchangeInc = 0x59,
    BatsExchangeInc = 0x5a,
};

type UpdateReason = enum {
    NewStrategyCreated = 0x4e,
    Updated = 0x55,
};

type LegSide = enum {
    Bid = 0x42,
    Ask = 0x41,
};

type SystemStatus = enum {
    StartOfSystemHours = 0x53,
    EndOfSystemHours = 0x43,
    StartTestSession = 0x31,
    EndOfTestSession = 0x32,
};

type Condition = enum {
    Regular = 0x41,
    TradingHalt = 0x54,
    Wide = 0x57,
    SimpleAuction = 0x53,
    ComplexAuction = 0x43,
    SimpleMarketProtection = 0x4d,
    LegMarketProtection = 0x4c,
};

type BidCondition = enum {
    Regular = 0x41,
    TradingHalt = 0x54,
    Wide = 0x57,
    SimpleAuction = 0x53,
    ComplexAuction = 0x43,
    SimpleMarketProtection = 0x4d,
    LegMarketProtection = 0x4c,
};

type OfferCondition = enum {
    Regular = 0x41,
    TradingHalt = 0x54,
    Wide = 0x57,
    SimpleAuction = 0x53,
    ComplexAuction = 0x43,
    SimpleMarketProtection = 0x4d,
    LegMarketProtection = 0x4c,
};

type TradingStatus = enum {
    Halted = 0x48,
    Resumed = 0x52,
    Opened = 0x4f,
};

type EventReason = enum {
    Automatic = 0x41,
    Manual = 0x4d,
};

