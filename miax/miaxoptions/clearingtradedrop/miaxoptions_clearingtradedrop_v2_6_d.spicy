module MiaxMiaxoptionsClearingtradedropCtdV26D;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type MiaxoptionsClearingtradedropV26D = unit {
    sesm_tcp_packet: SesmTcpPacket[] &eod;
};

type SesmTcpPacket = unit {
    sesm_packet_header: SesmPacketHeader;
    switch ( self.sesm_packet_header.sesm_packet_type ) {
        SesmPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        SesmPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        SesmPacketType::LoginRequest -> login_request: LoginRequest;
        SesmPacketType::LoginResponse -> login_response: LoginResponse;
        SesmPacketType::RetransmissionRequest -> retransmission_request: RetransmissionRequest;
        SesmPacketType::LogoutRequest -> logout_request: LogoutRequest(self.sesm_packet_header.sesm_packet_length);
        SesmPacketType::GoodbyePacket -> goodbye_packet: GoodbyePacket(self.sesm_packet_header.sesm_packet_length);
        SesmPacketType::TestPacket -> test_packet: TestPacket(self.sesm_packet_header.sesm_packet_length);
        * -> unknown: bytes &eod;
    };
};

type SesmPacketHeader = unit {
    sesm_packet_length: uint16;
    sesm_packet_type: uint8 &convert=SesmPacketType($$);
};

type SequencedDataPacket = unit {
    sequence_number: uint64;
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::SystemState -> system_state: SystemState;
        SequencedMessageType::TradeMessage -> trade_message: TradeMessage;
        SequencedMessageType::RiskNotificationMessage -> risk_notification_message: RiskNotificationMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemState = unit {
    notification_time: uint64 &convert=interval_ns($$);
    ctd_version: bytes &size=8;
    session_id: uint32;
    system_status: uint8 &convert=SystemStatus($$);
};

type TradeMessage = unit {
    processing_time: uint64 &convert=interval_ns($$);
    trade_time: uint64 &convert=interval_ns($$);
    trade_as_of_date: uint32;
    trade_action: uint8 &convert=TradeAction($$);
    trade_type: uint8 &convert=TradeType($$);
    trade_id: uint32;
    execution_id: uint64;
    correction_number: uint8;
    transaction_id: uint32;
    reference_trade_time: uint64 &convert=interval_ns($$);
    reference_trade_id: uint32;
    reference_correction_number: uint8;
    correction_type: uint8 &convert=CorrectionType($$);
    event_id_binary_u_4: uint32;
    strategy_id: uint32;
    : skip bytes &size=12;   # padding
    product_id: uint32;
    underlying_symbol: bytes &size=11;
    underlying_type: uint8 &convert=UnderlyingType($$);
    security_symbol: bytes &size=6;
    expiration_date: uint32;
    strike_price: uint32;
    call_or_put: uint8 &convert=CallOrPut($$);
    : skip bytes &size=8;   # padding
    side: uint8 &convert=Side($$);
    price: uint32;
    size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
    : skip bytes &size=8;   # padding
    class_fee_type: uint8 &convert=ClassFeeType($$);
    miax_bbo_posting_increment_indicator: uint8 &convert=MiaxBboPostingIncrementIndicator($$);
    execution_exchange: uint8 &convert=ExecutionExchange($$);
    routed_order_quantity: uint32;
    market_maker_role: uint8 &convert=MarketMakerRole($$);
    traded_with_directed_mm: uint8 &convert=TradedWithDirectedMm($$);
    market_state: uint8 &convert=MarketState($$);
    auction_type: uint8 &convert=AuctionType($$);
    directed_status: uint8 &convert=DirectedStatus($$);
    strategy_state: uint8 &convert=StrategyState($$);
    strategy_auction_type: uint8 &convert=StrategyAuctionType($$);
    stock_execution_destination: uint8 &convert=StockExecutionDestination($$);
    contra_liquidity_type: uint8 &convert=ContraLiquidityType($$);
    : skip bytes &size=12;   # padding
    executing_mpid: bytes &size=4;
    order_date: uint32;
    fix_order_id: bytes &size=30;
    client_message_id: uint32;
    bulk_quote_index: uint8;
    open_close_indicator: uint8 &convert=OpenCloseIndicator($$);
    liquidity_type: uint8 &convert=LiquidityType($$);
    mm_priority_indicator: uint8 &convert=MmPriorityIndicator($$);
    liquidity_indicator: uint8 &convert=LiquidityIndicator($$);
    liquidity_timer_role: uint8 &convert=LiquidityTimerRole($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    billing_mpid: bytes &size=4;
    leg_reference_id: bytes &size=5;
    strategy_timer_role: uint8 &convert=StrategyTimerRole($$);
    stock_short_sell_indicator: uint8 &convert=StockShortSellIndicator($$);
    : skip bytes &size=4;   # padding
    clearing_mpid: bytes &size=4;
    member_type: uint8 &convert=MemberType($$);
    origin: uint8 &convert=Origin($$);
    clearing_number: uint32;
    cmta: uint32;
    multi_account: bytes &size=5;
    account_id: bytes &size=10;
    supplementary_id: bytes &size=13;
    allocation_id: bytes &size=4;
    billing_clearing_number: uint32;
    order_capacity: uint8 &convert=OrderCapacity($$);
    : skip bytes &size=7;   # padding
    mpid: bytes &size=4;
    contra_member_type: uint8 &convert=ContraMemberType($$);
    contra_origin: uint8 &convert=ContraOrigin($$);
    contra_clearing_number: uint32;
    contra_cmta: uint32;
    contra_time_in_force: uint8 &convert=ContraTimeInForce($$);
    contra_liquidity_timer_role: uint8 &convert=ContraLiquidityTimerRole($$);
    contra_strategy_timer_role: uint8 &convert=ContraStrategyTimerRole($$);
    contra_order_capacity: uint8 &convert=ContraOrderCapacity($$);
    : skip bytes &size=12;   # padding
};

type RiskNotificationMessage = unit {
    processing_time: uint64 &convert=interval_ns($$);
    mpid_group_id: bytes &size=32;
    metric_id: bytes &size=32;
    route_id: bytes &size=32;
    metric_type: uint8 &convert=MetricType($$);
    protection_type: uint8 &convert=ProtectionType($$);
    event_type: uint8 &convert=EventType($$);
    event_id_binary_4u_4: uint32;
    configured_counting_time_period: uint32;
    configured_max_quantity: uint32;
    current_quantity: uint32;
    max_peak_quantity: uint32;
    percentage_level: uint8;
    : skip bytes &size=32;   # padding
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: uint8 &convert=UnsequencedMessageType($$);
    unsequenced_message: RiskNotificationMessage;
};

type LoginRequest = unit {
    sesm_version: bytes &size=5;
    username: bytes &size=5;
    computer_id: bytes &size=8;
    application_protocol: bytes &size=8;
    requested_session: uint8;
    requested_sequence_number: uint64;
};

type LoginResponse = unit {
    login_status: uint8 &convert=LoginStatus($$);
    session_id: uint8;
    highest_sequence_number: uint64;
};

type RetransmissionRequest = unit {
    start_sequence_number: uint64;
    end_sequence_number: uint64;
};

type LogoutRequest = unit(sesm_packet_length: uint16) {
    logout_reason: uint8 &convert=LogoutReason($$);
    logout_text: bytes &size=sesm_packet_length - 2;
};

type GoodbyePacket = unit(sesm_packet_length: uint16) {
    goodbye_reason: uint8 &convert=GoodbyeReason($$);
    logout_text: bytes &size=sesm_packet_length - 2;
};

type TestPacket = unit(sesm_packet_length: uint16) {
    test_text: bytes &size=sesm_packet_length - 1;
};

type SesmPacketType = enum {
    SequencedDataPacket = 0x53,
    UnsequencedDataPacket = 0x55,
    LoginRequest = 0x4c,
    LoginResponse = 0x52,
    SynchronizationComplete = 0x43,
    RetransmissionRequest = 0x41,
    LogoutRequest = 0x58,
    GoodbyePacket = 0x47,
    EndOfSession = 0x45,
    ServerHeartbeat = 0x30,
    ClientHeartbeat = 0x31,
    TestPacket = 0x54,
};

