    Auto = 0x49,
    ReopeningOfAnOption = 0x4a,
    Reserved = 0x4b,
    Reserved_x4c = 0x4c,
    Reserved_x4d = 0x4d,
    Reserved_x4e = 0x4e,
    Reserved_x4f = 0x4f,
    Reserved_x50 = 0x50,
    Reserved_x51 = 0x51,
    ExecutionOfAStoppedOrder = 0x52,
    ExecutionOfAnIsoOrder = 0x53,
