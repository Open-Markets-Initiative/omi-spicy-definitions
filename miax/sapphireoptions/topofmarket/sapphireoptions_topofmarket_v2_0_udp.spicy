module MiaxSapphireoptionsTopofmarketMachV20Udp;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type SapphireoptionsTopofmarketV20 = unit {
    mach_message: MachMessage[] &eod;
};

type MachMessage = unit {
    sequence_number: uint64;
    packet_length: uint16;
    packet_type: uint8 &convert=PacketType($$);
    session_number: uint8;
    payload: ApplicationMessage;
};

type ApplicationMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SystemTimeMessage -> system_time_message: SystemTimeMessage;
        MessageType::SeriesUpdateMessage -> series_update_message: SeriesUpdateMessage;
        MessageType::SystemStateMessage -> system_state_message: SystemStateMessage;
        MessageType::SimpleTopOfMarketBestBidOrOfferCompactFormatBidMessage -> simple_top_of_market_best_bid_or_offer_compact_format_bid_message: SimpleTopOfMarketBestBidOrOfferCompactFormatBidMessage;
        MessageType::SimpleTopOfMarketBestBidOrOfferCompactFormatBidPriorityCustomerMessage -> simple_top_of_market_best_bid_or_offer_compact_format_bid_priority_customer_message: SimpleTopOfMarketBestBidOrOfferCompactFormatBidPriorityCustomerMessage;
        MessageType::SimpleTopOfMarketBestBidOrOfferCompactFormatOfferMessage -> simple_top_of_market_best_bid_or_offer_compact_format_offer_message: SimpleTopOfMarketBestBidOrOfferCompactFormatOfferMessage;
        MessageType::SimpleTopOfMarketBestBidOrOfferCompactFormatOfferPriorityCustomerMessage -> simple_top_of_market_best_bid_or_offer_compact_format_offer_priority_customer_message: SimpleTopOfMarketBestBidOrOfferCompactFormatOfferPriorityCustomerMessage;
        MessageType::SimpleTopOfMarketBestBidOrOfferWideFormatBidMessage -> simple_top_of_market_best_bid_or_offer_wide_format_bid_message: SimpleTopOfMarketBestBidOrOfferWideFormatBidMessage;
        MessageType::SimpleTopOfMarketBestBidOrOfferWideFormatBidPriorityCustomerMessage -> simple_top_of_market_best_bid_or_offer_wide_format_bid_priority_customer_message: SimpleTopOfMarketBestBidOrOfferWideFormatBidPriorityCustomerMessage;
        MessageType::SimpleTopOfMarketBestBidOrOfferWideFormatOfferMessage -> simple_top_of_market_best_bid_or_offer_wide_format_offer_message: SimpleTopOfMarketBestBidOrOfferWideFormatOfferMessage;
        MessageType::SimpleTopOfMarketBestBidOrOfferWideFormatOfferPriorityCustomerMessage -> simple_top_of_market_best_bid_or_offer_wide_format_offer_priority_customer_message: SimpleTopOfMarketBestBidOrOfferWideFormatOfferPriorityCustomerMessage;
        MessageType::SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage -> simple_double_sided_top_of_market_best_bid_or_offer_compact_format_message: SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage;
        MessageType::SimpleDoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage -> simple_double_sided_top_of_market_best_bid_or_offer_wide_format_message: SimpleDoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage;
        MessageType::LastSaleMessage -> last_sale_message: LastSaleMessage;
        MessageType::TradeCancelMessage -> trade_cancel_message: TradeCancelMessage;
        MessageType::UnderlyingTradingStatusNotificationMessage -> underlying_trading_status_notification_message: UnderlyingTradingStatusNotificationMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemTimeMessage = unit {
    seconds: uint32;
};

type SeriesUpdateMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    underlying_symbol: bytes &size=11;
    security_symbol: bytes &size=6;
    expiration_date: bytes &size=8;
    strike_price: uint32;
    call_or_put: uint8 &convert=CallOrPut($$);
    opening_time: bytes &size=8;
    closing_time: bytes &size=8;
    restricted_option: uint8 &convert=RestrictedOption($$);
    long_term_option: uint8 &convert=LongTermOption($$);
    active_on_sapphire: uint8 &convert=ActiveOnSapphire($$);
    sapphire_bbo_posting_increment_indicator: uint8 &convert=SapphireBboPostingIncrementIndicator($$);
    liquidity_acceptance_increment_indicator: uint8 &convert=LiquidityAcceptanceIncrementIndicator($$);
    opening_underlying_market_code: uint8 &convert=OpeningUnderlyingMarketCode($$);
    : skip bytes &size=12;   # padding
};

type SystemStateMessage = unit {
    nanoseconds: uint32;
    to_m_version: bytes &size=8;
    session_id: uint32;
    system_status: uint8 &convert=SystemStatus($$);
};

type SimpleTopOfMarketBestBidOrOfferCompactFormatBidMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    sbbo_price_short: uint16;
    sbbo_size_short: uint16;
    sbbo_priority_customer_size_short: uint16;
    sbbo_condition: uint8 &convert=SbboCondition($$);
};

type SimpleTopOfMarketBestBidOrOfferCompactFormatBidPriorityCustomerMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    sbbo_price_short: uint16;
    sbbo_size_short: uint16;
    sbbo_priority_customer_size_short: uint16;
    sbbo_condition: uint8 &convert=SbboCondition($$);
};

type SimpleTopOfMarketBestBidOrOfferCompactFormatOfferMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    sbbo_price_short: uint16;
    sbbo_size_short: uint16;
    sbbo_priority_customer_size_short: uint16;
    sbbo_condition: uint8 &convert=SbboCondition($$);
};

type SimpleTopOfMarketBestBidOrOfferCompactFormatOfferPriorityCustomerMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    sbbo_price_short: uint16;
    sbbo_size_short: uint16;
    sbbo_priority_customer_size_short: uint16;
    sbbo_condition: uint8 &convert=SbboCondition($$);
};

type SimpleTopOfMarketBestBidOrOfferWideFormatBidMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    sbbo_price_long: uint32;
    sbbo_size_long: uint32;
    sbbo_priority_customer_size_long: uint32;
    sbbo_condition: uint8 &convert=SbboCondition($$);
};

type SimpleTopOfMarketBestBidOrOfferWideFormatBidPriorityCustomerMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    sbbo_price_long: uint32;
    sbbo_size_long: uint32;
    sbbo_priority_customer_size_long: uint32;
    sbbo_condition: uint8 &convert=SbboCondition($$);
};

type SimpleTopOfMarketBestBidOrOfferWideFormatOfferMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    sbbo_price_long: uint32;
    sbbo_size_long: uint32;
    sbbo_priority_customer_size_long: uint32;
    sbbo_condition: uint8 &convert=SbboCondition($$);
};

type SimpleTopOfMarketBestBidOrOfferWideFormatOfferPriorityCustomerMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    sbbo_price_long: uint32;
    sbbo_size_long: uint32;
    sbbo_priority_customer_size_long: uint32;
    sbbo_condition: uint8 &convert=SbboCondition($$);
};

type SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    bid_price_short: uint16;
    bid_size_short: uint16;
    bid_priority_customer_size_short: uint16;
    bid_condition: uint8 &convert=BidCondition($$);
    offer_price_short: uint16;
    offer_size_short: uint16;
    offer_priority_customer_size_short: uint16;
    offer_condition: uint8 &convert=OfferCondition($$);
};

type SimpleDoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    bid_price_long: uint32;
    bid_size_long: uint32;
    bid_priority_customer_size_long: uint32;
    bid_condition: uint8 &convert=BidCondition($$);
    offer_price_long: uint32;
    offer_size_long: uint32;
    offer_priority_customer_size_long: uint32;
    offer_condition: uint8 &convert=OfferCondition($$);
};

type LastSaleMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    trade_id: uint32;
    correction_number: uint8;
    reference_trade_id: uint32;
    reference_correction_number: uint8;
    trade_price: uint32;
    trade_size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
};

type TradeCancelMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    trade_id: uint32;
    correction_number: uint8;
    trade_price: uint32;
    trade_size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
};

type UnderlyingTradingStatusNotificationMessage = unit {
    nanoseconds: uint32;
    underlying_symbol: bytes &size=11;
    trading_status: uint8 &convert=TradingStatus($$);
    event_reason: uint8 &convert=EventReason($$);
    expected_event_time_seconds_part: uint32;
    expected_event_time_nano_seconds_part: uint32;
};

type PacketType = enum {
    Heartbeat = 0,
    StartOfSession = 1,
    EndOfSession = 2,
    ApplicationMessage = 3,
};

type MessageType = enum {
    SystemTimeMessage = 0x31,
    SeriesUpdateMessage = 0x50,
    SystemStateMessage = 0x53,
    SimpleTopOfMarketBestBidOrOfferCompactFormatBidMessage = 0x42,
    SimpleTopOfMarketBestBidOrOfferCompactFormatBidPriorityCustomerMessage = 0x68,
    SimpleTopOfMarketBestBidOrOfferCompactFormatOfferMessage = 0x4f,
    SimpleTopOfMarketBestBidOrOfferCompactFormatOfferPriorityCustomerMessage = 0x69,
    SimpleTopOfMarketBestBidOrOfferWideFormatBidMessage = 0x57,
    SimpleTopOfMarketBestBidOrOfferWideFormatBidPriorityCustomerMessage = 0x6a,
    SimpleTopOfMarketBestBidOrOfferWideFormatOfferMessage = 0x41,
    SimpleTopOfMarketBestBidOrOfferWideFormatOfferPriorityCustomerMessage = 0x6b,
    SimpleDoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage = 0x64,
    SimpleDoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage = 0x44,
    LastSaleMessage = 0x54,
    TradeCancelMessage = 0x58,
    UnderlyingTradingStatusNotificationMessage = 0x48,
};

type CallOrPut = enum {
    Call = 0x43,
    Put = 0x50,
};

type RestrictedOption = enum {
    AcceptPositionClosing = 0x59,
    AcceptOpenAndClose = 0x4e,
};

type LongTermOption = enum {
    FarMonthExpiration = 0x59,
    NearMonthExpiration = 0x4e,
};

type ActiveOnSapphire = enum {
    Active = 0x41,
    Inactive = 0x49,
};

type SapphireBboPostingIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type LiquidityAcceptanceIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type OpeningUnderlyingMarketCode = enum {
    NyseAmex = 0x41,
    NasdaqOmxBx = 0x42,
    NationalStockExchange = 0x43,
    FinraAdf = 0x44,
    MarketIndependent = 0x45,
    MiaxPearlEquities = 0x48,
    InternationalSecuritiesExchange = 0x49,
    EdgaExchangeInc = 0x4a,
    EdgxExchangeInc = 0x4b,
    Ltse = 0x4c,
    ChicagoStockExchange = 0x4d,
    NyseEuronext = 0x4e,
    NyseArcaExchange = 0x50,
    NasdaqOmxUtp = 0x51,
    NasdaqOmxCta = 0x54,
    Memx = 0x55,
    Iex = 0x56,
    CboeStockExchange = 0x57,
    NasdaqOmxPhlx = 0x58,
    BatsY = 0x59,
    Bats = 0x5a,
};

type SystemStatus = enum {
    StartOfSystemHours = 0x53,
    EndOfSystemHours = 0x43,
    StartOfTestSession = 0x31,
    EndOfTestSession = 0x32,
};

type SbboCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    Reserved = 0x52,
    TradingHalt = 0x54,
};

type BidCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    Reserved = 0x52,
    TradingHalt = 0x54,
};

type OfferCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    Reserved = 0x52,
    TradingHalt = 0x54,
};

type TradeCondition = enum {
    Regular = 0x20,
    CancelOfTradePreviouslyReportedOtherThanAsTheLastOrOpening = 0x41,
    LateAndIsOutOfSequence = 0x42,
    CancelOfTheLastReportedTrade = 0x43,
    LateAndIsInCorrectSequence = 0x44,
    CancelOfTheFirstReportedTrade = 0x45,
    LateReportOfTheOpeningTradeAndIsOutOfSequence = 0x46,
    CancelOfTheOnlyReportedTrade = 0x47,
    LateReportOfTheOpeningTradeAndIsInCorrectSequence = 0x48,
    Auto = 0x49,
    ReopeningOfAnOption = 0x4a,
    Reserved = 0x4b,
    Reserved_x4c = 0x4c,
    Reserved_x4d = 0x4d,
    Reserved_x4e = 0x4e,
    Reserved_x4f = 0x4f,
    Reserved_x50 = 0x50,
    Reserved_x51 = 0x51,
    ExecutionOfAnOrderWhichWasStoppedAtAPriceThatDidNotConstituteATradeThroughOnAnotherMarketAtTheTimeOfTheStop = 0x52,
    ExecutionOfAnIsoOrder = 0x53,
    Reserved_x54 = 0x54,
    TradeThroughExempt = 0x58,
    Reserved_x61 = 0x61,
    Reserved_x62 = 0x62,
    CustomerToCustomerCrossOrQcc = 0x63,
    Reserved_x64 = 0x64,
    CrossTransactionOnTheExchangeFloor = 0x65,
    ComplexTransactionThatIsNotComplexStockTiedAndDoesNotInvolveLegging = 0x66,
    Reserved_x67 = 0x67,
    ComplexCustomerToCustomerCrossOrComplexQccTransactionThatIsNotComplexStockTied = 0x68,
    ComplexCrossTransactionOnTheExchangeFloorThatIsNotComplexStockTied = 0x69,
    ComplexCrossTransactionOnTheExchangeFloorThatHasLeggingOccurredOnTheFloorAndNotComplexStockTied = 0x6a,
    Reserved_x6b = 0x6b,
    Reserved_x6c = 0x6c,
    ComplexCrossTransactionOnTheExchangeFloorThatHasLeggingOccurredOnTheFloorAndNotComplexStockTied_x6d = 0x6d,
    ComplexStockTiedTransactionThatDoesNotInvolveLegging = 0x6e,
    ComplexCustomerToCustomerCrossStockTiedOrComplexQccStockTiedTransaction = 0x6f,
    ComplexCrossStockTiedTransactionOnTheExchangeFloorThatDoesNotInvolveLegging = 0x70,
    ComplexCrossStockTiedTransactionOnTheExchangeFloorThatHasLeggingOccurredOnTheFloor = 0x71,
    Reserved_x72 = 0x72,
    ComplexCrossStockTiedTransactionOnTheExchangeFloorThatHasLeggingOccurredOnTheFloor_x73 = 0x73,
    Reserved_x74 = 0x74,
};

type TradingStatus = enum {
    Halted = 0x48,
    Resumed = 0x52,
    Opened = 0x4f,
};

type EventReason = enum {
    Automatic = 0x41,
    Manual = 0x4d,
};

