module MiaxSapphireoptionsLiquidityfeedMachV10AUdp;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type SapphireoptionsLiquidityfeedV10A = unit {
    mach_message: MachMessage[] &eod;
};

type MachMessage = unit {
    sequence_number: uint64;
    packet_length: uint16;
    packet_type: uint8 &convert=PacketType($$);
    session_number: uint8;
    payload: ApplicationMessage;
};

type ApplicationMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SystemTimeMessage -> system_time_message: SystemTimeMessage;
        MessageType::SeriesUpdateMessage -> series_update_message: SeriesUpdateMessage;
        MessageType::SystemStateMessage -> system_state_message: SystemStateMessage;
        MessageType::UnderlyingTradingStatusNotificationMessage -> underlying_trading_status_notification_message: UnderlyingTradingStatusNotificationMessage;
        MessageType::SimpleOrderMessage -> simple_order_message: SimpleOrderMessage;
        MessageType::ComplexStrategyDefinitionUpdateMessage -> complex_strategy_definition_update_message: ComplexStrategyDefinitionUpdateMessage;
        MessageType::ComplexOrderMessage -> complex_order_message: ComplexOrderMessage;
        MessageType::OrderCloseMessage -> order_close_message: OrderCloseMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemTimeMessage = unit {
    seconds: uint32;
};

type SeriesUpdateMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    underlying_symbol: bytes &size=11;
    security_symbol: bytes &size=6;
    expiration_date: bytes &size=8;
    strike_price: uint32;
    call_or_put: uint8 &convert=CallOrPut($$);
    opening_time: bytes &size=8;
    closing_time: bytes &size=8;
    restricted_option: uint8 &convert=RestrictedOption($$);
    long_term_option: uint8 &convert=LongTermOption($$);
    active_on_sapphire: uint8 &convert=ActiveOnSapphire($$);
    sapphire_bbo_posting_increment_indicator: uint8 &convert=SapphireBboPostingIncrementIndicator($$);
    liquidity_acceptance_increment_indicator: uint8 &convert=LiquidityAcceptanceIncrementIndicator($$);
    opening_underlying_market_code: uint8 &convert=OpeningUnderlyingMarketCode($$);
    : skip bytes &size=12;   # padding
};

type SystemStateMessage = unit {
    nanoseconds: uint32;
    slf_version: bytes &size=8;
    session_id: uint32;
    system_status: uint8 &convert=SystemStatus($$);
};

type UnderlyingTradingStatusNotificationMessage = unit {
    nanoseconds: uint32;
    underlying_symbol: bytes &size=11;
    trading_status: uint8 &convert=TradingStatus($$);
    event_reason: uint8 &convert=EventReason($$);
    expected_event_time_seconds_part: uint32;
    expected_event_time_nano_seconds_part: uint32;
};

type SimpleOrderMessage = unit {
    nanoseconds: uint32;
    action: uint8 &convert=Action($$);
    product_id: uint32;
    order_id: uint64;
    order_side: uint8 &convert=OrderSide($$);
    order_type: uint8 &convert=OrderType($$);
    order_price_short: uint32;
    order_original_volume: uint32;
    remaining_volume_open: uint32;
    time_in_force_tif: uint8 &convert=TimeInForceTif($$);
    origin: uint8 &convert=Origin($$);
    openclose_indicator: uint8 &convert=OpencloseIndicator($$);
    order_instruction: uint8 &convert=OrderInstruction($$);
    : skip bytes &size=8;   # padding
};

type ComplexStrategyDefinitionUpdateMessage = unit {
    nanoseconds: uint32;
    strategy_id: uint32;
    underlying_symbol: bytes &size=11;
    active_on_sapphire: uint8 &convert=ActiveOnSapphire($$);
    : skip bytes &size=1;   # padding
    update_reason: uint8 &convert=UpdateReason($$);
    : skip bytes &size=10;   # padding
    number_of_legs: uint8;
    leg_definition: LegDefinition[self.number_of_legs];
};

type LegDefinition = unit {
    product_id: uint32;
    leg_ratio_qty: uint32;
    leg_side: uint8 &convert=LegSide($$);
    : skip bytes &size=8;   # padding
};

type ComplexOrderMessage = unit {
    nanoseconds: uint32;
    action: uint8 &convert=Action($$);
    strategy_id: uint32;
    order_id: uint64;
    order_side: uint8 &convert=OrderSide($$);
    order_type: uint8 &convert=OrderType($$);
    order_price_long: int64;
    order_original_volume: uint32;
    remaining_volume_open: uint32;
    time_in_force_tif: uint8 &convert=TimeInForceTif($$);
    origin: uint8 &convert=Origin($$);
    : skip bytes &size=28;   # padding
};

type OrderCloseMessage = unit {
    nanoseconds: uint32;
    simple_or_complex_order: uint8 &convert=SimpleOrComplexOrder($$);
    order_id: uint64;
};

type PacketType = enum {
    Heartbeat = 0,
    StartOfSession = 1,
    EndOfSession = 2,
    ApplicationMessage = 3,
};

type MessageType = enum {
    SystemTimeMessage = 0x31,
    SeriesUpdateMessage = 0x50,
    SystemStateMessage = 0x53,
    UnderlyingTradingStatusNotificationMessage = 0x48,
    SimpleOrderMessage = 0x46,
    ComplexStrategyDefinitionUpdateMessage = 0x43,
    ComplexOrderMessage = 0x52,
    OrderCloseMessage = 0x78,
};

type CallOrPut = enum {
    Call = 0x43,
    Put = 0x50,
};

type RestrictedOption = enum {
    Yes = 0x59,
    No = 0x4e,
};

type LongTermOption = enum {
    Yes = 0x59,
    No = 0x4e,
};

type ActiveOnSapphire = enum {
    Active = 0x41,
    Inactive = 0x49,
};

type SapphireBboPostingIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type LiquidityAcceptanceIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type OpeningUnderlyingMarketCode = enum {
    NyseAmex = 0x41,
    NasdaqOmxBx = 0x42,
    NationalStockExchange = 0x43,
    FinraAdf = 0x44,
    MarketIndependent = 0x45,
    MiaxPearlEquities = 0x48,
    InternationalSecuritiesExchange = 0x49,
    EdgaExchangeInc = 0x4a,
    EdgxExchangeInc = 0x4b,
    Ltse = 0x4c,
    ChicagoStockExchange = 0x4d,
    NyseEuronext = 0x4e,
    NyseArcaExchange = 0x50,
    NasdaqOmxUtp = 0x51,
    NasdaqOmxCta = 0x54,
    Memx = 0x55,
    Iex = 0x56,
    CboeStockExchange = 0x57,
    NasdaqOmxPhlx = 0x58,
    BatsYExchangeInc = 0x59,
    BatsExchangeInc = 0x5a,
};

type SystemStatus = enum {
    StartOfSystemHours = 0x53,
    EndOfSystemHours = 0x43,
    StartOfTestSession = 0x31,
    EndOfTestSession = 0x32,
};

type TradingStatus = enum {
    Halted = 0x48,
    Resumed = 0x52,
    Opened = 0x4f,
};

type EventReason = enum {
    Automatic = 0x41,
    Manual = 0x4d,
};

type Action = enum {
    Open = 0x4f,
};

type OrderSide = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type OrderType = enum {
    Market = 0x4d,
    Limit = 0x4c,
};

type TimeInForceTif = enum {
    Day = 0x44,
};

type Origin = enum {
    PriorityCustomer = 0x30,
    Firm = 0x31,
    BrokerDealer = 0x32,
    MarketMaker = 0x34,
    NonMemberMarketMaker = 0x35,
    NonPriorityCustomer = 0x38,
};

type OpencloseIndicator = enum {
    Open = 0x4f,
    Close = 0x43,
    NotApplicable = 0x20,
};

type OrderInstruction = enum {
    Routable = 0x52,
    DoNotRoute = 0x44,
};

type UpdateReason = enum {
    NewStrategyCreated = 0x4e,
    Updated = 0x55,
};

type LegSide = enum {
    Bid = 0x42,
    Ask = 0x41,
};

type SimpleOrComplexOrder = enum {
    SimpleOrder = 0x46,
    ComplexOrder = 0x52,
};

