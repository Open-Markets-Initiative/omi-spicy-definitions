module MiaxPearlequitiesDepthofmarketMachV13DUdp;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type PearlequitiesDepthofmarketV13D = unit {
    mach_message: MachMessage[] &eod;
};

type MachMessage = unit {
    sequence_number: uint64;
    mach_packet_length: uint16;
    mach_packet_type: uint8 &convert=MachPacketType($$);
    session_number: uint8;
    payload: ApplicationMessage;
};

type ApplicationMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SystemTimeMessage -> system_time_message: SystemTimeMessage;
        MessageType::SymbolUpdateMessage -> symbol_update_message: SymbolUpdateMessage;
        MessageType::SystemStateMessage -> system_state_message: SystemStateMessage;
        MessageType::SecurityTradingStatusNotificationMessage -> security_trading_status_notification_message: SecurityTradingStatusNotificationMessage;
        MessageType::SymbolClearMessage -> symbol_clear_message: SymbolClearMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::ModifyOrderMessage -> modify_order_message: ModifyOrderMessage;
        MessageType::DeleteOrderMessage -> delete_order_message: DeleteOrderMessage;
        MessageType::OrderExecutionMessage -> order_execution_message: OrderExecutionMessage;
        MessageType::TradeMessage -> trade_message: TradeMessage;
        MessageType::TradeCancelMessage -> trade_cancel_message: TradeCancelMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemTimeMessage = unit {
    seconds: uint32;
};

type SymbolUpdateMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
    ticker_symbol: bytes &size=11;
    : skip bytes &size=1;   # padding
    test_security_indicator: uint8 &convert=TestSecurityIndicator($$);
    : skip bytes &size=1;   # padding
    lot_size: uint16;
    opening_time: bytes &size=8;
    closing_time: bytes &size=8;
    primary_market_code: uint8 &convert=PrimaryMarketCode($$);
};

type SystemStateMessage = unit {
    nanoseconds: uint32;
    do_m_version: bytes &size=8;
    session_id: uint8;
    system_status: uint8 &convert=SystemStatus($$);
};

type SecurityTradingStatusNotificationMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
    trading_status: uint8 &convert=TradingStatus($$);
    market_state: uint8 &convert=MarketState($$);
    short_sale_restriction: uint8 &convert=ShortSaleRestriction($$);
};

type SymbolClearMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
};

type AddOrderMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
    order_id: uint64;
    order_side: uint8 &convert=OrderSide($$);
    price: uint64;
    size: uint32;
    attributable_id: bytes &size=4;
};

type ModifyOrderMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
    order_id: uint64;
    price: uint64;
    size: uint32;
    modify_order_flags: bitfield(8) {
        order_position: 0;
        reserved_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type DeleteOrderMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
    order_id: uint64;
};

type OrderExecutionMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
    order_id: uint64;
    trade_id: uint64;
    price: uint64;
    size: uint32;
    order_execution_flags: bitfield(8) {
        sip_reporting: 0;
        traded_against_retail: 1;
        reserved_6: 2..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type TradeMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
    trade_id: uint64;
    correction_number: uint8;
    price: uint64;
    size: uint32;
    trade_flags: bitfield(8) {
        sip_reporting: 0;
        retail_trade_indicator: 1;
        reserved_6: 2..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type TradeCancelMessage = unit {
    nanoseconds: uint32;
    symbol_id: uint32;
    trade_id: uint64;
    correction_number: uint8;
    price: uint64;
    size: uint32;
};

type MachPacketType = enum {
    Heartbeat = 0,
    StartOfSession = 1,
    EndOfSession = 2,
    ApplicationMessage = 3,
};

type MessageType = enum {
    SystemTimeMessage = 49,
    SymbolUpdateMessage = 1,
    SystemStateMessage = 83,
    SecurityTradingStatusNotificationMessage = 4,
    SymbolClearMessage = 5,
    AddOrderMessage = 20,
    ModifyOrderMessage = 21,
    DeleteOrderMessage = 23,
    OrderExecutionMessage = 24,
    TradeMessage = 10,
    TradeCancelMessage = 11,
};

type TestSecurityIndicator = enum {
    Yes = 0x59,
    No = 0x4e,
};

type PrimaryMarketCode = enum {
    NyseAmerican = 0x41,
    NasdaqTexas = 0x42,
    NyseNational = 0x43,
    TexasStockExchange = 0x46,
    N24XExchange = 0x47,
    MiaxPearlEquities = 0x48,
    NasdaqIse = 0x49,
    CboeEdgaExchange = 0x4a,
    CboeEdgxExchange = 0x4b,
    LongTermStockExchange = 0x4c,
    NyseTexas = 0x4d,
    NewYorkStockExchange = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    MembersExchange = 0x55,
    InvestorsExchange = 0x56,
    CboeStockExchange = 0x57,
    NasdaqPhlx = 0x58,
    CboeByxExchange = 0x59,
    CboeBzxExchange = 0x5a,
};

type SystemStatus = enum {
    StartOfSystemHours = 0x53,
    EndOfSystemHours = 0x43,
    StartOfTestSession = 0x31,
    EndOfTestSession = 0x32,
};

type TradingStatus = enum {
    PreOpen = 1,
    Trading = 2,
    Halt = 3,
    OperationalHalt = 4,
    Closed = 5,
};

type MarketState = enum {
    PreOpening = 1,
    EarlyTradingSession = 2,
    RegularTradingSession = 3,
    LateTradingSession = 4,
};

type ShortSaleRestriction = enum {
    ShortSaleRestrictionIsInEffect = 0x59,
    ShortSaleRestrictionIsNotInEffect = 0x4e,
};

type OrderSide = enum {
    Buy = 0x42,
    Sell = 0x53,
};

