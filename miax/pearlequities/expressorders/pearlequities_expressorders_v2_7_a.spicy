    InvalidForCurrentSymbolTradingStatusOrMarketState = 0x70,
    PrimaryExchangeIpoNotCompleteIpoInProgress = 0x71,
    InvalidUseOfMinQtySizeOrMinQtyExecTypeInstruction = 0x72,
    InvalidUseOfOrderType = 0x73,
