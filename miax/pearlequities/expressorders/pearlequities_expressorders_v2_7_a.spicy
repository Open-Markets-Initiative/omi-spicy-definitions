module MiaxPearlequitiesExpressordersMeoV27A;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type PearlequitiesExpressordersV27A = unit {
    esesm_tcp_packet: EsesmTcpPacket[] &eod;
};

type EsesmTcpPacket = unit {
    esesm_packet_header: EsesmPacketHeader;
    switch ( self.esesm_packet_header.esesm_packet_type ) {
        EsesmPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        EsesmPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        EsesmPacketType::LoginRequest -> login_request: LoginRequest;
        EsesmPacketType::LoginResponse -> login_response: LoginResponse;
        EsesmPacketType::SynchronizationComplete -> synchronization_complete: SynchronizationComplete;
        EsesmPacketType::RetransmissionRequest -> retransmission_request: RetransmissionRequest;
        EsesmPacketType::LogoutRequest -> logout_request: LogoutRequest(self.esesm_packet_header.esesm_packet_length);
        EsesmPacketType::GoodbyePacket -> goodbye_packet: GoodbyePacket(self.esesm_packet_header.esesm_packet_length);
        EsesmPacketType::TestPacket -> test_packet: TestPacket(self.esesm_packet_header.esesm_packet_length);
        * -> unknown: bytes &eod;
    };
};

type EsesmPacketHeader = unit {
    esesm_packet_length: uint16;
    esesm_packet_type: uint8 &convert=EsesmPacketType($$);
};

type SequencedDataPacket = unit {
    sequence_number: uint64;
    matching_engine_id: uint8;
    sequenced_message_type: bytes &size=2;
    switch ( self.sequenced_message_type ) {
        0 -> symbol_update: SymbolUpdate;
        0 -> new_order_response_message: NewOrderResponseMessage;
        0 -> modify_order_response: ModifyOrderResponse;
        0 -> cancel_order_response: CancelOrderResponse;
        0 -> cancel_order_by_exchange_order_id_response_message: CancelOrderByExchangeOrderIdResponseMessage;
        0 -> system_state_notification: SystemStateNotification;
        0 -> new_order_notification: NewOrderNotification;
        0 -> modify_order_notification: ModifyOrderNotification;
        0 -> cancel_reduce_size_order_notification: CancelReduceSizeOrderNotification;
        0 -> order_price_update_notification: OrderPriceUpdateNotification;
        0 -> reserve_order_replenishment_notification: ReserveOrderReplenishmentNotification;
        0 -> execution_notification: ExecutionNotification;
        * -> unknown: bytes &eod;
    };
};

type SymbolUpdate = unit {
    matching_engine_time: uint64;
    symbol_id: uint32;
    ticker_symbol: bytes &size=11;
    : skip bytes &size=1;   # padding
    test_security_indicator: uint8 &convert=TestSecurityIndicator($$);
    future: uint8;
    lot_size: uint32;
    opening_time: bytes &size=8;
    closing_time: bytes &size=8;
    primary_market_code: uint8 &convert=PrimaryMarketCode($$);
    : skip bytes &size=12;   # padding
};

type NewOrderResponseMessage = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    symbol_id: uint32;
    order_id: uint64;
    price: uint64;
    size: uint32;
    order_status: uint8 &convert=OrderStatus($$);
    : skip bytes &size=19;   # padding
};

type ModifyOrderResponse = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    original_client_order_id: bytes &size=20;
    symbol_id: uint32;
    order_id: uint64;
    leaves_qty: uint32;
    price: uint64;
    modify_status: uint8 &convert=ModifyStatus($$);
    : skip bytes &size=10;   # padding
};

type CancelOrderResponse = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    original_client_order_id: bytes &size=20;
    symbol_id: uint32;
    order_id: uint64;
    leaves_qty: uint32;
    cancel_status: uint8 &convert=CancelStatus($$);
    : skip bytes &size=10;   # padding
};

type CancelOrderByExchangeOrderIdResponseMessage = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    symbol_id: uint32;
    order_id: uint64;
    leaves_qty: uint32;
    cancel_status: uint8 &convert=CancelStatus($$);
    : skip bytes &size=10;   # padding
};

type SystemStateNotification = unit {
    matching_engine_time: uint64;
    meo_version: bytes &size=8;
    session_id: uint8;
    system_status: uint8 &convert=SystemStatus($$);
    : skip bytes &size=8;   # padding
};

type NewOrderNotification = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    order_id: uint64;
    client_order_id: bytes &size=20;
    symbol_id: uint32;
    price: uint64;
    size: uint32;
    new_order_instructions: bitfield(16) {
        side: 0;
        short_sale_indicator: 1..2;
        displayed: 3;
        post_only: 4;
        locate_required: 5;
        iso: 6;
        retail_order: 7;
        attributable_order: 8..9;
        min_qty_exec_type: 10..11;
        cancel_order_if_not_a_nbbo_setter: 12;
        cancel_order_if_not_a_nbbo_setter_with_size: 13;
        unused_2: 14..15;
    } &byte-order=spicy::ByteOrder::Little;
    time_in_force: uint8 &convert=TimeInForce($$);
    order_type: uint8 &convert=OrderType($$);
    price_sliding_and_reprice_frequency: uint8 &convert=PriceSlidingAndRepriceFrequency($$);
    self_trade_protection: bitfield(8) {
        self_trade_protection_level: 0..2;
        self_trade_protection_instruction: 3..5;
        unused_2: 6..7;
    } &byte-order=spicy::ByteOrder::Little;
    self_trade_protection_group: bytes &size=1;
    routing: bitfield(8) {
        routing_instruction: 0..2;
        routing_strategy: 3..5;
        unused_2: 6..7;
    } &byte-order=spicy::ByteOrder::Little;
    trading_collar_dollar_value: int64;
    capacity: uint8 &convert=Capacity($$);
    account: bytes &size=16;
    clearing_account: bytes &size=4;
    min_qty: uint32;
    max_floor_qty: uint32;
    display_range_qty: uint32;
    peg_offset: int64;
    locate_account: bytes &size=4;
    purge_group: bytes &size=1;
    original_order_capacity: uint8 &convert=OriginalOrderCapacity($$);
    order_expiry_time: uint64;
    : skip bytes &size=10;   # padding
};

type ModifyOrderNotification = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    original_client_order_id: bytes &size=20;
    symbol_id: uint32;
    order_id: uint64;
    price: uint64;
    size: uint32;
    leaves_qty: uint32;
    modify_order_instructions: bitfield(8) {
        short_sale_indicator: 0..1;
        locate_required: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    min_qty: uint32;
    max_floor_qty: uint32;
    pending_modify_status: uint8 &convert=PendingModifyStatus($$);
    pending_reject_reason: uint8 &convert=PendingRejectReason($$);
    locate_account: bytes &size=4;
    time_in_force: uint8 &convert=TimeInForce($$);
    order_expiry_time: uint64;
    : skip bytes &size=17;   # padding
};

type CancelReduceSizeOrderNotification = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    symbol_id: uint32;
    order_id: uint64;
    leaves_qty: uint32;
    cancel_reason: uint8 &convert=CancelReason($$);
    last_price: uint64;
    last_size: uint32;
    pending_cancel_status: uint8 &convert=PendingCancelStatus($$);
    pending_reject_reason: uint8 &convert=PendingRejectReason($$);
    : skip bytes &size=8;   # padding
};

type OrderPriceUpdateNotification = unit {
    matching_engine_time: uint64;
    symbol_id: uint32;
    order_id: uint64;
    client_order_id: bytes &size=20;
    working_price: uint64;
    nbbo_indicator: uint8 &convert=NbboIndicator($$);
    : skip bytes &size=9;   # padding
};

type ReserveOrderReplenishmentNotification = unit {
    matching_engine_time: uint64;
    symbol_id: uint32;
    order_id: uint64;
    secondary_order_id: uint64;
    display_qty: uint32;
    : skip bytes &size=10;   # padding
};

type ExecutionNotification = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    symbol_id: uint32;
    client_order_id: bytes &size=20;
    trade_id: uint64;
    execution_id: uint64;
    correction_number: uint8;
    trade_status: uint8 &convert=TradeStatus($$);
    last_price: uint64;
    last_size: uint32;
    order_execution_instructions: bitfield(16) {
        side: 0;
        unused_15: 1..15;
    } &byte-order=spicy::ByteOrder::Little;
    executing_trading_center: uint8 &convert=ExecutingTradingCenter($$);
    secondary_order_id: uint64;
    liquidity_indicator: bytes &size=3;
    locate_account: bytes &size=4;
    original_order_capacity: uint8 &convert=OriginalOrderCapacity($$);
    additional_liquidity_indicator: bitfield(8) {
        nbbo_setter_joiner: 0..2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    executing_trading_center_mpid: bytes &size=4;
    : skip bytes &size=12;   # padding
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: bytes &size=2;
    switch ( self.unsequenced_message_type ) {
        0 -> new_order_request_message: NewOrderRequestMessage;
        0 -> new_order_response_message: NewOrderResponseMessage;
        0 -> modify_order_request_message: ModifyOrderRequestMessage;
        0 -> modify_order_response: ModifyOrderResponse;
        0 -> cancel_order_request: CancelOrderRequest;
        0 -> cancel_order_response: CancelOrderResponse;
        0 -> cancel_order_by_exchange_order_id_request: CancelOrderByExchangeOrderIdRequest;
        0 -> cancel_order_by_exchange_order_id_response_message: CancelOrderByExchangeOrderIdResponseMessage;
        0 -> mass_cancel_request: MassCancelRequest;
        0 -> mass_cancel_response: MassCancelResponse;
        0 -> aggressive_side_purge_request: AggressiveSidePurgeRequest;
        0 -> aggressive_side_purge_response: AggressiveSidePurgeResponse;
        0 -> reserve_order_replenishment_notification: ReserveOrderReplenishmentNotification;
        0 -> execution_notification: ExecutionNotification;
        * -> unknown: bytes &eod;
    };
};

type NewOrderRequestMessage = unit {
    : skip bytes &size=8;   # padding
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    symbol_id: uint32;
    price: uint64;
    size: uint32;
    new_order_instructions: bitfield(16) {
        side: 0;
        short_sale_indicator: 1..2;
        displayed: 3;
        post_only: 4;
        locate_required: 5;
        iso: 6;
        retail_order: 7;
        attributable_order: 8..9;
        min_qty_exec_type: 10..11;
        cancel_order_if_not_a_nbbo_setter: 12;
        cancel_order_if_not_a_nbbo_setter_with_size: 13;
        unused_2: 14..15;
    } &byte-order=spicy::ByteOrder::Little;
    time_in_force: uint8 &convert=TimeInForce($$);
    order_type: uint8 &convert=OrderType($$);
    price_sliding_and_reprice_frequency: uint8 &convert=PriceSlidingAndRepriceFrequency($$);
    self_trade_protection: bitfield(8) {
        self_trade_protection_level: 0..2;
        self_trade_protection_instruction: 3..5;
        unused_2: 6..7;
    } &byte-order=spicy::ByteOrder::Little;
    self_trade_protection_group: bytes &size=1;
    routing: bitfield(8) {
        routing_instruction: 0..2;
        routing_strategy: 3..5;
        unused_2: 6..7;
    } &byte-order=spicy::ByteOrder::Little;
    trading_collar_dollar_value: int64;
    capacity: uint8 &convert=Capacity($$);
    account: bytes &size=16;
    clearing_account: bytes &size=4;
    min_qty: uint32;
    max_floor_qty: uint32;
    display_range_qty: uint32;
    peg_offset: int64;
    locate_account: bytes &size=4;
    purge_group: bytes &size=1;
    order_expiry_time: uint64;
    : skip bytes &size=11;   # padding
};

type ModifyOrderRequestMessage = unit {
    : skip bytes &size=8;   # padding
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    original_client_order_id: bytes &size=20;
    symbol_id: uint32;
    price: uint64;
    size: uint32;
    modify_order_instructions: bitfield(8) {
        short_sale_indicator: 0..1;
        locate_required: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    min_qty: uint32;
    max_floor_qty: uint32;
    locate_account: bytes &size=4;
    time_in_force: uint8 &convert=TimeInForce($$);
    order_expiry_time: uint64;
    : skip bytes &size=19;   # padding
};

type CancelOrderRequest = unit {
    : skip bytes &size=8;   # padding
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    original_client_order_id: bytes &size=20;
    symbol_id: uint32;
    : skip bytes &size=10;   # padding
};

type CancelOrderByExchangeOrderIdRequest = unit {
    : skip bytes &size=8;   # padding
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    order_id: uint64;
    symbol_id: uint32;
    : skip bytes &size=10;   # padding
};

type MassCancelRequest = unit {
    : skip bytes &size=8;   # padding
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    scope: uint8 &convert=Scope($$);
    action: uint8 &convert=Action($$);
    purge_group: bytes &size=1;
    : skip bytes &size=9;   # padding
};

type MassCancelResponse = unit {
    notification_time: uint64;
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    number_of_matching_engines: uint8;
    matching_engine_status: bytes &size=24;
    : skip bytes &size=10;   # padding
};

type AggressiveSidePurgeRequest = unit {
    : skip bytes &size=8;   # padding
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    symbol_id: uint32;
    purge_instructions: bitfield(16) {
        side: 0;
        unused_15: 1..15;
    } &byte-order=spicy::ByteOrder::Little;
    price: uint64;
    : skip bytes &size=10;   # padding
};

type AggressiveSidePurgeResponse = unit {
    matching_engine_time: uint64;
    mpid: bytes &size=4;
    client_order_id: bytes &size=20;
    symbold_id: uint32;
    purge_status: uint8 &convert=PurgeStatus($$);
    number_of_orders_cancelled: uint8;
    asp_eligible_orders_cancelled: bytes &size=1;
    : skip bytes &size=10;   # padding
};

type LoginRequest = unit {
    esesm_version: bytes &size=5;
    username: bytes &size=5;
    computer_id: bytes &size=8;
    application_protocol: bytes &size=8;
    requested_trading_session_id: uint8;
    requested_sequence_number: uint64;
};

type LoginResponse = unit {
    number_of_matching_engines: uint8;
    login_status: uint8 &convert=LoginStatus($$);
    trading_session_id: uint8;
    highest_sequence_number: uint64;
};

type SynchronizationComplete = unit {
    number_of_matching_engines: uint8;
};

type RetransmissionRequest = unit {
    start_sequence_number: uint64;
    end_sequence_number: uint64;
};

type LogoutRequest = unit(esesm_packet_length: uint16) {
    logout_reason: uint8 &convert=LogoutReason($$);
    logout_text: bytes &size=esesm_packet_length - 2;
};

type GoodbyePacket = unit(esesm_packet_length: uint16) {
    logout_reason: uint8 &convert=LogoutReason($$);
    logout_text: bytes &size=esesm_packet_length - 2;
};

type TestPacket = unit(esesm_packet_length: uint16) {
    test_text: bytes &size=esesm_packet_length - 1;
};

type EsesmPacketType = enum {
    SequencedDataPacket = 0x73,
    UnsequencedDataPacket = 0x55,
    LoginRequest = 0x6c,
    LoginResponse = 0x72,
    SynchronizationComplete = 0x63,
    RetransmissionRequest = 0x61,
    LogoutRequest = 0x58,
    GoodbyePacket = 0x47,
    TradingSessionUpdate = 0x75,
    ServerHeartbeat = 0x30,
    ClientHeartbeat = 0x31,
    TestPacket = 0x54,
};

type TestSecurityIndicator = enum {
    Yes = 0x59,
    No = 0x4e,
};

type PrimaryMarketCode = enum {
    NyseAmerican = 0x41,
    NasdaqBx = 0x42,
    NyseNational = 0x43,
    N24XExchange = 0x47,
    MiaxPearlEquities = 0x48,
    NasdaqIse = 0x49,
    CboeEdgaExchange = 0x4a,
    CboeEdgxExchange = 0x4b,
    LongTermStockExchange = 0x4c,
    NyseTexas = 0x4d,
    NewYorkStockExchange = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    MembersExchange = 0x55,
    InvestorsExchange = 0x56,
    NasdaqPhlx = 0x58,
    CboeByxExchange = 0x59,
    CboeBzxExchange = 0x5a,
};

