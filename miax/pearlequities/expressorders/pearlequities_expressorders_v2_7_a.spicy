    No = 0,
    Yes = 1,
};

type PostOnly = enum {
    No = 0,
    Yes = 1,
};

type LocateRequired = enum {
    NotApplicable = 0,
    Yes = 1,
};

type Iso = enum {
    No = 0,
    Yes = 1,
};

type RetailOrder = enum {
    No = 0,
