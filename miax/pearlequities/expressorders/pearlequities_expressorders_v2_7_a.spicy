};

type CancelStatus = enum {
    Successful = 0x20,
    DuplicateClientOrderId = 0x41,
    NotInLiveOrderWindow = 0x42,
    MatchingEngineIsNotAvailable = 0x43,
    CannotFindOrderWithTargetClientOrderId = 0x44,
    ExceededTestSymbolThrottle = 0x45,
    OrderIsRouted = 0x46,
