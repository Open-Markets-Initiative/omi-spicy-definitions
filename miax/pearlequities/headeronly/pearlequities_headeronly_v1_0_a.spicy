module MiaxPearlequitiesHeaderonlyEsesmV10A;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type PearlequitiesHeaderonlyV10A = unit {
    esesm_tcp_packet: EsesmTcpPacket[] &eod;
};

type EsesmTcpPacket = unit {
    esesm_packet_header: EsesmPacketHeader;
    switch ( self.esesm_packet_header.esesm_packet_type ) {
        EsesmPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        EsesmPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        EsesmPacketType::LoginRequest -> login_request: LoginRequest;
        EsesmPacketType::LoginResponse -> login_response: LoginResponse;
        EsesmPacketType::SynchronizationComplete -> synchronization_complete: SynchronizationComplete;
        EsesmPacketType::RetransmissionRequest -> retransmission_request: RetransmissionRequest;
        EsesmPacketType::LogoutRequest -> logout_request: LogoutRequest(self.esesm_packet_header.esesm_packet_length);
        EsesmPacketType::GoodbyePacket -> goodbye_packet: GoodbyePacket(self.esesm_packet_header.esesm_packet_length);
        EsesmPacketType::TestPacket -> test_packet: TestPacket(self.esesm_packet_header.esesm_packet_length);
        * -> unknown: bytes &eod;
    };
};

type EsesmPacketHeader = unit {
    esesm_packet_length: uint16;
    esesm_packet_type: uint8 &convert=EsesmPacketType($$);
};

type SequencedDataPacket = unit {
    sequence_number: uint64;
    matching_engine_id: uint8;
    sequenced_message_type: bytes &size=2;
    sequenced_message: bytes &eod;
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: bytes &size=2;
    unsequenced_message: bytes &eod;
};

type LoginRequest = unit {
    esesm_version: bytes &size=5;
    username: bytes &size=5;
    computer_id: bytes &size=8;
    application_protocol: bytes &size=8;
    requested_trading_session_id: uint8;
    requested_sequence_number: uint64;
};

type LoginResponse = unit {
    number_of_matching_engines: uint8;
    login_status: uint8 &convert=LoginStatus($$);
    trading_session_id: uint8;
    highest_sequence_number: uint64;
};

type SynchronizationComplete = unit {
    number_of_matching_engines: uint8;
};

type RetransmissionRequest = unit {
    start_sequence_number: uint64;
    end_sequence_number: uint64;
};

type LogoutRequest = unit(esesm_packet_length: uint16) {
    logout_reason: uint8 &convert=LogoutReason($$);
    logout_text: bytes &size=esesm_packet_length - 2;
};

type GoodbyePacket = unit(esesm_packet_length: uint16) {
    logout_reason: uint8 &convert=LogoutReason($$);
    logout_text: bytes &size=esesm_packet_length - 2;
};

type TestPacket = unit(esesm_packet_length: uint16) {
    test_text: bytes &size=esesm_packet_length - 1;
};

type EsesmPacketType = enum {
    SequencedDataPacket = 0x73,
    UnsequencedDataPacket = 0x55,
    LoginRequest = 0x6c,
    LoginResponse = 0x72,
    SynchronizationComplete = 0x63,
    RetransmissionRequest = 0x61,
    LogoutRequest = 0x58,
    GoodbyePacket = 0x47,
    TradingSessionUpdate = 0x75,
    ServerHeartbeat = 0x30,
    ClientHeartbeat = 0x31,
    TestPacket = 0x54,
};

type LoginStatus = enum {
    Successful = 0x20,
    InvalidTradingSessionRequested = 0x53,
    NoActiveTradingSessionExists = 0x55,
    Rejected = 0x58,
    InvalidStartSequenceNumberRequested = 0x4e,
    IncompatibleSessionProtocolVersion = 0x49,
    IncompatibleApplicationProtocolVersion = 0x41,
    RequestRejectedBecauseClientAlreadyLoggedIn = 0x4c,
};

type LogoutReason = enum {
    GracefulLogout = 0x20,
    BadPacket = 0x42,
    TimedOut = 0x4c,
    ApplicationTerminatingConnection = 0x41,
};

