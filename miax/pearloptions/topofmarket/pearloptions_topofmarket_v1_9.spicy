module MiaxPearloptionsTopofmarketMachV19;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type PearloptionsTopofmarketV19 = unit {
    mach_message: MachMessage[] &eod;
};

type MachMessage = unit {
    sequence_number: uint64;
    packet_length: uint16;
    packet_type: uint8 &convert=PacketType($$);
    session_number: uint8;
    payload: ApplicationMessage;
};

type ApplicationMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SystemTimeMessage -> system_time_message: SystemTimeMessage;
        MessageType::SeriesUpdate -> series_update: SeriesUpdate;
        MessageType::SystemStateMessage -> system_state_message: SystemStateMessage;
        MessageType::TopOfMarketBidCompactMessage -> top_of_market_bid_compact_message: TopOfMarketBidCompactMessage;
        MessageType::TopOfMarketOfferCompactMessage -> top_of_market_offer_compact_message: TopOfMarketOfferCompactMessage;
        MessageType::WideTopOfMarketBidMessage -> wide_top_of_market_bid_message: WideTopOfMarketBidMessage;
        MessageType::WideTopOfMarketOfferMessage -> wide_top_of_market_offer_message: WideTopOfMarketOfferMessage;
        MessageType::DoubleSidedTopOfMarketCompactMessage -> double_sided_top_of_market_compact_message: DoubleSidedTopOfMarketCompactMessage;
        MessageType::WideDoubleSidedTopOfMarketMessage -> wide_double_sided_top_of_market_message: WideDoubleSidedTopOfMarketMessage;
        MessageType::TradeMessage -> trade_message: TradeMessage;
        MessageType::TradeCancelMessage -> trade_cancel_message: TradeCancelMessage;
        MessageType::UnderlyingTradingStatusMessage -> underlying_trading_status_message: UnderlyingTradingStatusMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemTimeMessage = unit {
    seconds: uint32;
};

type SeriesUpdate = unit {
    nanoseconds: uint32;
    product_id: uint32;
    underlying_symbol: bytes &size=11;
    security_symbol: bytes &size=6;
    expiration_date: bytes &size=8;
    strike_price: uint32;
    call_or_put: bytes &size=1;
    opening_time: bytes &size=8;
    closing_time: bytes &size=8;
    restricted_option: bytes &size=1;
    long_term_option: bytes &size=1;
    active_on_miax: bytes &size=1;
    miax_bbo_posting_increment_indicator: uint8 &convert=MiaxBboPostingIncrementIndicator($$);
    liquidity_acceptance_increment_indicator: uint8 &convert=LiquidityAcceptanceIncrementIndicator($$);
    opening_underlying_market_code: uint8 &convert=OpeningUnderlyingMarketCode($$);
    priority_quote_width: uint32;
    : skip bytes &size=8;   # padding
};

type SystemStateMessage = unit {
    nanoseconds: uint32;
    to_m_version: bytes &size=8;
    session_id: uint32;
    system_status: uint8 &convert=SystemStatus($$);
};

type TopOfMarketBidCompactMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    mbbo_price_2: uint16;
    mbbo_size_2: uint16;
    mbbo_priority_customer_size_2: uint16;
    mbbo_condition: uint8 &convert=MbboCondition($$);
};

type TopOfMarketOfferCompactMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    mbbo_price_2: uint16;
    mbbo_size_2: uint16;
    mbbo_priority_customer_size_2: uint16;
    mbbo_condition: uint8 &convert=MbboCondition($$);
};

type WideTopOfMarketBidMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    mbbo_price_4: uint32;
    mbbo_size_4: uint32;
    mbbo_priority_customer_size_4: uint32;
    mbbo_condition: uint8 &convert=MbboCondition($$);
};

type WideTopOfMarketOfferMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    mbbo_price_4: uint32;
    mbbo_size_4: uint32;
    mbbo_priority_customer_size_4: uint32;
    mbbo_condition: uint8 &convert=MbboCondition($$);
};

type DoubleSidedTopOfMarketCompactMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    bid_price_2: uint16;
    bid_size_2: uint16;
    bid_priority_customer_size_2: uint16;
    bid_condition: uint8 &convert=BidCondition($$);
    offer_price_2: uint16;
    offer_size_2: uint16;
    offer_priority_customer_size_2: uint16;
    offer_condition: uint8 &convert=OfferCondition($$);
};

type WideDoubleSidedTopOfMarketMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    bid_price_4: uint32;
    bid_size_4: uint32;
    bid_priority_customer_size_4: uint32;
    bid_condition: uint8 &convert=BidCondition($$);
    offer_price_4: uint32;
    offer_size_4: uint32;
    offer_priority_customer_size_4: uint32;
    offer_condition: uint8 &convert=OfferCondition($$);
};

type TradeMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    trade_id: uint32;
    correction_number: uint8;
    reference_trade_id: uint32;
    reference_correction_number: uint8;
    trade_price: uint32;
    trade_size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
};

type TradeCancelMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    trade_id: uint32;
    correction_number: uint8;
    trade_price: uint32;
    trade_size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
};

type UnderlyingTradingStatusMessage = unit {
    nanoseconds: uint32;
    underlying_symbol: bytes &size=11;
    trading_status: uint8 &convert=TradingStatus($$);
    event_reason: uint8 &convert=EventReason($$);
    seconds_part: uint32;
    expected_event_time_nano_seconds_part: uint32;
};

type PacketType = enum {
    Heartbeat = 0,
    StartOfSession = 1,
    EndOfSession = 2,
    ApplicationMessage = 3,
};

type MessageType = enum {
    SystemTimeMessage = 0x31,
    SeriesUpdate = 0x50,
    SystemStateMessage = 0x53,
    TopOfMarketBidCompactMessage = 0x42,
    TopOfMarketOfferCompactMessage = 0x4f,
    WideTopOfMarketBidMessage = 0x57,
    WideTopOfMarketOfferMessage = 0x41,
    DoubleSidedTopOfMarketCompactMessage = 0x64,
    WideDoubleSidedTopOfMarketMessage = 0x44,
    TradeMessage = 0x54,
    TradeCancelMessage = 0x58,
    UnderlyingTradingStatusMessage = 0x48,
};

type MiaxBboPostingIncrementIndicator = enum {
    Penny = 0x50,
    Nickel = 0x4e,
    Dime = 0x44,
};

type LiquidityAcceptanceIncrementIndicator = enum {
    Penny = 0x50,
    Nickel = 0x4e,
    Dime = 0x44,
};

type OpeningUnderlyingMarketCode = enum {
    NyseAmex = 0x41,
    NasdaqOmxBx = 0x42,
    Nse = 0x43,
    FinraAdf = 0x44,
    MarketIndependent = 0x45,
    Ise = 0x49,
    Edga = 0x4a,
    Edgx = 0x4b,
    Cse = 0x4d,
    NyseEuronext = 0x4e,
    NyseArca = 0x50,
    NasdaqOmxUtp = 0x51,
    NasdaqOmxCta = 0x54,
    Iex = 0x56,
    NasdaqOmxPhlx = 0x58,
    BatsY = 0x59,
    Bats = 0x5a,
};

type SystemStatus = enum {
    StartOfSystemHours = 0x53,
    EndOfSystemHours = 0x43,
    StartTestSession = 0x31,
    EndOfTestSession = 0x32,
    TopBid = 0x42,
    TopOffer = 0x4f,
};

type MbboCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    TradingHalt = 0x54,
};

type BidCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    TradingHalt = 0x54,
};

type OfferCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    TradingHalt = 0x54,
};

type TradeCondition = enum {
    CancelOfTrade = 0x41,
};

type TradingStatus = enum {
    Halted = 0x48,
    Resumed = 0x52,
    Opened = 0x4f,
};

type EventReason = enum {
    Automatic = 0x41,
    Manual = 0x4d,
};

