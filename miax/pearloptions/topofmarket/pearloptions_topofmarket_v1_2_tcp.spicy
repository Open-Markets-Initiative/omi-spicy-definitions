module MiaxPearloptionsTopofmarketMachV12Tcp;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type PearloptionsTopofmarketV12 = unit {
    sesm_tcp_packet: SesmTcpPacket[] &eod;
};

type SesmTcpPacket = unit {
    sesm_packet_header: SesmPacketHeader;
    switch ( self.sesm_packet_header.sesm_packet_type ) {
        SesmPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        SesmPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        SesmPacketType::LoginRequest -> login_request: LoginRequest;
        SesmPacketType::LoginResponse -> login_response: LoginResponse;
        SesmPacketType::SynchronizationComplete -> synchronization_complete: SynchronizationComplete;
        SesmPacketType::RetransmissionRequest -> retransmission_request: RetransmissionRequest;
        SesmPacketType::LogoutRequest -> logout_request: LogoutRequest(self.sesm_packet_header.sesm_packet_length);
        SesmPacketType::GoodbyePacket -> goodbye_packet: GoodbyePacket(self.sesm_packet_header.sesm_packet_length);
        SesmPacketType::TestPacket -> test_packet: TestPacket(self.sesm_packet_header.sesm_packet_length);
        * -> unknown: bytes &eod;
    };
};

type SesmPacketHeader = unit {
    sesm_packet_length: uint16;
    sesm_packet_type: uint8 &convert=SesmPacketType($$);
};

type SequencedDataPacket = unit {
    sequence_number: uint64;
    matching_engine_id: uint8;
    sequenced_message_type: bytes &size=1;
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: uint8 &convert=UnsequencedMessageType($$);
    switch ( self.unsequenced_message_type ) {
        UnsequencedMessageType::RefreshRequestMessage -> refresh_request_message: RefreshRequestMessage;
        UnsequencedMessageType::RefreshResponseMessage -> refresh_response_message: RefreshResponseMessage;
        UnsequencedMessageType::EndOfRefreshNotificationMessage -> end_of_refresh_notification_message: EndOfRefreshNotificationMessage;
        * -> unknown: bytes &eod;
    };
};

type RefreshRequestMessage = unit {
    refresh_message_type: uint8 &convert=RefreshMessageType($$);
};

type RefreshResponseMessage = unit {
    sequence_number: uint64;
    application_message: ApplicationMessage;
};

type ApplicationMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SystemTimeMessage -> system_time_message: SystemTimeMessage;
        MessageType::SeriesUpdateMessage -> series_update_message: SeriesUpdateMessage;
        MessageType::SystemStateMessage -> system_state_message: SystemStateMessage;
        MessageType::TopOfMarketBestBidOrOfferCompactFormatBidMessage -> top_of_market_best_bid_or_offer_compact_format_bid_message: TopOfMarketBestBidOrOfferCompactFormatBidMessage;
        MessageType::TopOfMarketBestBidOrOfferCompactFormatBidPriorityCustomerMessage -> top_of_market_best_bid_or_offer_compact_format_bid_priority_customer_message: TopOfMarketBestBidOrOfferCompactFormatBidPriorityCustomerMessage;
        MessageType::TopOfMarketBestBidOrOfferCompactFormatOfferMessage -> top_of_market_best_bid_or_offer_compact_format_offer_message: TopOfMarketBestBidOrOfferCompactFormatOfferMessage;
        MessageType::TopOfMarketBestBidOrOfferCompactFormatOfferPriorityCustomerMessage -> top_of_market_best_bid_or_offer_compact_format_offer_priority_customer_message: TopOfMarketBestBidOrOfferCompactFormatOfferPriorityCustomerMessage;
        MessageType::TopOfMarketBestBidOrOfferWideFormatBidMessage -> top_of_market_best_bid_or_offer_wide_format_bid_message: TopOfMarketBestBidOrOfferWideFormatBidMessage;
        MessageType::TopOfMarketBestBidOrOfferWideFormatBidPriorityCustomerMessage -> top_of_market_best_bid_or_offer_wide_format_bid_priority_customer_message: TopOfMarketBestBidOrOfferWideFormatBidPriorityCustomerMessage;
        MessageType::TopOfMarketBestBidOrOfferWideFormatOfferMessage -> top_of_market_best_bid_or_offer_wide_format_offer_message: TopOfMarketBestBidOrOfferWideFormatOfferMessage;
        MessageType::TopOfMarketBestBidOrOfferWideFormatOfferPriorityCustomerMessage -> top_of_market_best_bid_or_offer_wide_format_offer_priority_customer_message: TopOfMarketBestBidOrOfferWideFormatOfferPriorityCustomerMessage;
        MessageType::DoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage -> double_sided_top_of_market_best_bid_or_offer_compact_format_message: DoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage;
        MessageType::DoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage -> double_sided_top_of_market_best_bid_or_offer_wide_format_message: DoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage;
        MessageType::LastSaleMessage -> last_sale_message: LastSaleMessage;
        MessageType::TradeCancelMessage -> trade_cancel_message: TradeCancelMessage;
        MessageType::UnderlyingTradingStatusNotificationMessage -> underlying_trading_status_notification_message: UnderlyingTradingStatusNotificationMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemTimeMessage = unit {
    seconds: uint32;
};

type SeriesUpdateMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    underlying_symbol: bytes &size=11;
    security_symbol: bytes &size=6;
    expiration_date: bytes &size=8;
    strike_price: uint32;
    call_or_put: uint8 &convert=CallOrPut($$);
    opening_time: bytes &size=8;
    closing_time: bytes &size=8;
    restricted_option: uint8 &convert=RestrictedOption($$);
    long_term_option: uint8 &convert=LongTermOption($$);
    active_on_pearl: uint8 &convert=ActiveOnPearl($$);
    pearl_bbo_posting_increment_indicator: uint8 &convert=PearlBboPostingIncrementIndicator($$);
    liquidity_acceptance_increment_indicator: uint8 &convert=LiquidityAcceptanceIncrementIndicator($$);
    opening_underlying_market_code: uint8 &convert=OpeningUnderlyingMarketCode($$);
    : skip bytes &size=12;   # padding
};

type SystemStateMessage = unit {
    nanoseconds: uint32;
    to_m_version: bytes &size=8;
    session_id: uint32;
    system_status: uint8 &convert=SystemStatus($$);
};

type TopOfMarketBestBidOrOfferCompactFormatBidMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    pbbo_price_short: uint16;
    pbbo_size_short: uint16;
    pbbo_priority_customer_size_short: uint16;
    pbbo_condition: uint8 &convert=PbboCondition($$);
};

type TopOfMarketBestBidOrOfferCompactFormatBidPriorityCustomerMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    pbbo_price_short: uint16;
    pbbo_size_short: uint16;
    pbbo_priority_customer_size_short: uint16;
    pbbo_condition: uint8 &convert=PbboCondition($$);
};

type TopOfMarketBestBidOrOfferCompactFormatOfferMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    pbbo_price_short: uint16;
    pbbo_size_short: uint16;
    pbbo_priority_customer_size_short: uint16;
    pbbo_condition: uint8 &convert=PbboCondition($$);
};

type TopOfMarketBestBidOrOfferCompactFormatOfferPriorityCustomerMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    pbbo_price_short: uint16;
    pbbo_size_short: uint16;
    pbbo_priority_customer_size_short: uint16;
    pbbo_condition: uint8 &convert=PbboCondition($$);
};

type TopOfMarketBestBidOrOfferWideFormatBidMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    pbbo_price_long: uint32;
    pbbo_size_long: uint32;
    pbbo_priority_customer_size_long: uint32;
    pbbo_condition: uint8 &convert=PbboCondition($$);
};

type TopOfMarketBestBidOrOfferWideFormatBidPriorityCustomerMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    pbbo_price_long: uint32;
    pbbo_size_long: uint32;
    pbbo_priority_customer_size_long: uint32;
    pbbo_condition: uint8 &convert=PbboCondition($$);
};

type TopOfMarketBestBidOrOfferWideFormatOfferMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    pbbo_price_long: uint32;
    pbbo_size_long: uint32;
    pbbo_priority_customer_size_long: uint32;
    pbbo_condition: uint8 &convert=PbboCondition($$);
};

type TopOfMarketBestBidOrOfferWideFormatOfferPriorityCustomerMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    pbbo_price_long: uint32;
    pbbo_size_long: uint32;
    pbbo_priority_customer_size_long: uint32;
    pbbo_condition: uint8 &convert=PbboCondition($$);
};

type DoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    bid_price_short: uint16;
    bid_size_short: uint16;
    bid_priority_customer_size_short: uint16;
    bid_condition: uint8 &convert=BidCondition($$);
    offer_price_short: uint16;
    offer_size_short: uint16;
    offer_priority_customer_size_short: uint16;
    offer_condition: uint8 &convert=OfferCondition($$);
};

type DoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    bid_price_long: uint32;
    bid_size_long: uint32;
    bid_priority_customer_size_long: uint32;
    bid_condition: uint8 &convert=BidCondition($$);
    offer_price_long: uint32;
    offer_size_long: uint32;
    offer_priority_customer_size_long: uint32;
    offer_condition: uint8 &convert=OfferCondition($$);
};

type LastSaleMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    trade_id: uint32;
    correction_number: uint8;
    reference_trade_id: uint32;
    reference_correction_number: uint8;
    trade_price: uint32;
    trade_size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
};

type TradeCancelMessage = unit {
    nanoseconds: uint32;
    product_id: uint32;
    trade_id: uint32;
    correction_number: uint8;
    trade_price: uint32;
    trade_size: uint32;
    trade_condition: uint8 &convert=TradeCondition($$);
};

type UnderlyingTradingStatusNotificationMessage = unit {
    nanoseconds: uint32;
    underlying_symbol: bytes &size=11;
    trading_status: uint8 &convert=TradingStatus($$);
    event_reason: uint8 &convert=EventReason($$);
    expected_event_time_seconds_part: uint32;
    expected_event_time_nano_seconds_part: uint32;
};

type EndOfRefreshNotificationMessage = unit {
    refresh_message_type: uint8 &convert=RefreshMessageType($$);
};

type LoginRequest = unit {
    sesm_version: bytes &size=5;
    username: bytes &size=5;
    computer_id: bytes &size=8;
    application_protocol: bytes &size=8;
    requested_trading_session_id: uint8;
    requested_sequence_number: uint64;
};

type LoginResponse = unit {
    number_of_matching_engines: uint8;
    login_status: uint8 &convert=LoginStatus($$);
    trading_session_id: uint8;
    highest_sequence_number: uint64;
};

type SynchronizationComplete = unit {
    number_of_matching_engines: uint8;
};

type RetransmissionRequest = unit {
    start_sequence_number: uint64;
    end_sequence_number: uint64;
};

type LogoutRequest = unit(sesm_packet_length: uint16) {
    logout_reason: uint8 &convert=LogoutReason($$);
    logout_text: bytes &size=sesm_packet_length - 2;
};

type GoodbyePacket = unit(sesm_packet_length: uint16) {
    logout_reason: uint8 &convert=LogoutReason($$);
    logout_text: bytes &size=sesm_packet_length - 2;
};

type TestPacket = unit(sesm_packet_length: uint16) {
    test_text: bytes &size=sesm_packet_length - 1;
};

type SesmPacketType = enum {
    SequencedDataPacket = 0x73,
    UnsequencedDataPacket = 0x55,
    LoginRequest = 0x6c,
    LoginResponse = 0x72,
    SynchronizationComplete = 0x63,
    RetransmissionRequest = 0x61,
    LogoutRequest = 0x58,
    GoodbyePacket = 0x47,
    TradingSessionUpdate = 0x75,
    ServerHeartbeat = 0x30,
    ClientHeartbeat = 0x31,
    TestPacket = 0x54,
};

type UnsequencedMessageType = enum {
    RefreshRequestMessage = 0x52,
    RefreshResponseMessage = 0x72,
    EndOfRefreshNotificationMessage = 0x45,
};

type RefreshMessageType = enum {
    SeriesUpdateRefresh = 0x50,
    TopOfMarketRefresh = 0x51,
    UnderlyingTradingStatusRefresh = 0x55,
    SystemStateRefresh = 0x53,
};

type MessageType = enum {
    SystemTimeMessage = 0x31,
    SeriesUpdateMessage = 0x50,
    SystemStateMessage = 0x53,
    TopOfMarketBestBidOrOfferCompactFormatBidMessage = 0x42,
    TopOfMarketBestBidOrOfferCompactFormatBidPriorityCustomerMessage = 0x68,
    TopOfMarketBestBidOrOfferCompactFormatOfferMessage = 0x4f,
    TopOfMarketBestBidOrOfferCompactFormatOfferPriorityCustomerMessage = 0x69,
    TopOfMarketBestBidOrOfferWideFormatBidMessage = 0x57,
    TopOfMarketBestBidOrOfferWideFormatBidPriorityCustomerMessage = 0x6a,
    TopOfMarketBestBidOrOfferWideFormatOfferMessage = 0x41,
    TopOfMarketBestBidOrOfferWideFormatOfferPriorityCustomerMessage = 0x6b,
    DoubleSidedTopOfMarketBestBidOrOfferCompactFormatMessage = 0x64,
    DoubleSidedTopOfMarketBestBidOrOfferWideFormatMessage = 0x44,
    LastSaleMessage = 0x54,
    TradeCancelMessage = 0x58,
    UnderlyingTradingStatusNotificationMessage = 0x48,
};

type CallOrPut = enum {
    Call = 0x43,
    Put = 0x50,
};

type RestrictedOption = enum {
    AcceptPositionClosing = 0x59,
    AcceptOpenAndClose = 0x4e,
};

type LongTermOption = enum {
    FarMonthExpiration = 0x59,
    NearMonthExpiration = 0x4e,
};

type ActiveOnPearl = enum {
    Active = 0x41,
    Inactive = 0x49,
};

type PearlBboPostingIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type LiquidityAcceptanceIncrementIndicator = enum {
    Penny = 0x50,
    PennyOrNickel = 0x4e,
    NickelOrDime = 0x44,
};

type OpeningUnderlyingMarketCode = enum {
    NyseAmex = 0x41,
    NasdaqOmxBx = 0x42,
    Nse = 0x43,
    FinraAdf = 0x44,
    MarketIndependent = 0x45,
    MiaxPearlEquities = 0x48,
    Ise = 0x49,
    Edga = 0x4a,
    Edgx = 0x4b,
    Ltse = 0x4c,
    Cse = 0x4d,
    NyseEuronext = 0x4e,
    NyseArca = 0x50,
    NasdaqOmxUtp = 0x51,
    NasdaqOmxCta = 0x54,
    Memx = 0x55,
    Iex = 0x56,
    Cbsx = 0x57,
    NasdaqOmxPhlx = 0x58,
    BatsY = 0x59,
    Bats = 0x5a,
};

type SystemStatus = enum {
    StartOfSystemHours = 0x53,
    EndOfSystemHours = 0x43,
    StartTestSession = 0x31,
    EndOfTestSession = 0x32,
};

type PbboCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    Reserved = 0x52,
    TradingHalt = 0x54,
};

type BidCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    Reserved = 0x52,
    TradingHalt = 0x54,
};

type OfferCondition = enum {
    Regular = 0x41,
    PublicCustomerInterest = 0x42,
    NotFirm = 0x43,
    Reserved = 0x52,
    TradingHalt = 0x54,
};

type TradeCondition = enum {
    Regular = 0x20,
    CancelOfTradePreviouslyReportedOtherThanAsTheLastOrOpening = 0x41,
    LateAndIsOutOfSequence = 0x42,
    CancelOfTheLastReportedTrade = 0x43,
    LateAndIsInCorrectSequence = 0x44,
    CancelOfTheFirstReportedTrade = 0x45,
    LateReportOfTheOpeningTradeAndIsOutOfSequence = 0x46,
    CancelOfTheOnlyReportedTrade = 0x47,
    LateReportOfTheOpeningTradeAndIsInCorrectSequence = 0x48,
    Auto = 0x49,
    ReopeningOfAnOption = 0x4a,
    Reserved = 0x4b,
    Reserved_x4c = 0x4c,
    Reserved_x4d = 0x4d,
    Reserved_x4e = 0x4e,
    Reserved_x4f = 0x4f,
    Reserved_x50 = 0x50,
    Reserved_x51 = 0x51,
    ExecutionOfAnOrderWhichWasStoppedAtAPriceThatDidNotConstituteATradeThroughOnAnotherMarketAtTheTimeOfTheStop = 0x52,
    ExecutionOfAnIsoOrder = 0x53,
    Reserved_x54 = 0x54,
    TradeThroughExempt = 0x58,
    PairedPrime = 0x61,
    Reserved_x62 = 0x62,
    PrimeCustomerToCustomerCrossOrPrimeQcc = 0x63,
    Reserved_x64 = 0x64,
    Reserved_x65 = 0x65,
    ComplexTransactionThatIsNotComplexStocktiedAndDoesNotInvolveLegging = 0x66,
    ComplexPrimeTransactionThatIsNotComplexStocktiedAndDoesNotInvolveLegging = 0x67,
    ComplexPrimeCustomerToCustomerCrossOrComplexPrimeQccTransactionThatIsNotComplexStocktied = 0x68,
    Reserved_x69 = 0x69,
    ComplexLeggingTransactionThatIsNotComplexStocktied = 0x6a,
    ComplexPrimeStocktiedTransactionThatDoesNotInvolveLegging = 0x6b,
    ComplexPrimeLeggingTransactionThatIsNotComplexStocktied = 0x6c,
    Reserved_x6d = 0x6d,
    ComplexStocktiedTransactionThatDoesNotInvolveLegging = 0x6e,
    ComplexCustomerToCustomerCrossStocktiedOrComplexQccStocktiedTransaction = 0x6f,
    Reserved_x70 = 0x70,
    Reserved_x71 = 0x71,
    Reserved_x72 = 0x72,
    Reserved_x73 = 0x73,
    Reserved_x74 = 0x74,
};

type TradingStatus = enum {
    Halted = 0x48,
    Resumed = 0x52,
    Opened = 0x4f,
};

type EventReason = enum {
    Automatic = 0x41,
    Manual = 0x4d,
};

type LoginStatus = enum {
    Successful = 0x20,
    InvalidTradingSessionRequested = 0x53,
    NoActiveTradingSessionExists = 0x55,
    Rejected = 0x58,
    InvalidStartSequenceNumberRequested = 0x4e,
    IncompatibleSessionProtocolVersion = 0x49,
    IncompatibleApplicationProtocolVersion = 0x41,
    RequestRejectedBecauseClientAlreadyLoggedIn = 0x4c,
};

type LogoutReason = enum {
    GracefulLogout = 0x20,
    BadPacket = 0x42,
    TimedOut = 0x4c,
    ApplicationTerminatingConnection = 0x41,
};

