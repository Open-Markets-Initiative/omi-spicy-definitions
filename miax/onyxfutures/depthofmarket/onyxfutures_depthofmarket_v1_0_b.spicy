module MiaxOnyxfuturesDepthofmarketMachV10B;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type OnyxfuturesDepthofmarketV10B = unit {
    mach_message: MachMessage[] &eod;
};

type MachMessage = unit {
    sequence_number: uint64;
    packet_length: uint16;
    packet_type: uint8 &convert=PacketType($$);
    session_number: uint8;
    payload: ApplicationMessage;
};

type ApplicationMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SimpleInstrumentDefinitionMessage -> simple_instrument_definition_message: SimpleInstrumentDefinitionMessage;
        MessageType::ComplexInstrumentDefinitionMessage -> complex_instrument_definition_message: ComplexInstrumentDefinitionMessage;
        MessageType::SystemStateMessage -> system_state_message: SystemStateMessage;
        MessageType::InstrumentTradingStatusNotificationMessage -> instrument_trading_status_notification_message: InstrumentTradingStatusNotificationMessage;
        MessageType::AnticipatedOpeningPriceMessage -> anticipated_opening_price_message: AnticipatedOpeningPriceMessage;
        MessageType::SettlementPriceUpdateMessage -> settlement_price_update_message: SettlementPriceUpdateMessage;
        MessageType::OpenInterestUpdateMessage -> open_interest_update_message: OpenInterestUpdateMessage;
        MessageType::TotalVolumeUpdateMessage -> total_volume_update_message: TotalVolumeUpdateMessage;
        MessageType::InstrumentClearMessage -> instrument_clear_message: InstrumentClearMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::ModifyOrderMessage -> modify_order_message: ModifyOrderMessage;
        MessageType::DeleteOrderMessage -> delete_order_message: DeleteOrderMessage;
        MessageType::OrderExecutionMessage -> order_execution_message: OrderExecutionMessage;
        MessageType::TradeCancelMessage -> trade_cancel_message: TradeCancelMessage;
        * -> unknown: bytes &eod;
    };
};

type SimpleInstrumentDefinitionMessage = unit {
    timestamp: uint64;
    instrument_id: uint32;
    underlying_asset_type: uint8 &convert=UnderlyingAssetType($$);
    underlying_asset: bytes &size=4;
    product_group_code: bytes &size=6;
    exchange: bytes &size=4;
    instrument_id_source: uint8 &convert=InstrumentIdSource($$);
    instrument_type: uint8 &convert=InstrumentType($$);
    maturity_month_year: uint32;
    currency: uint8 &convert=Currency($$);
    settlement_currency: uint8 &convert=SettlementCurrency($$);
    match_algorithm: uint8 &convert=MatchAlgorithm($$);
    minimum_size: uint32;
    maximum_size: uint32;
    tick: int64;
    unit_of_measure: bytes &size=5;
    unit_of_measure_quantity: uint32;
    settlement_price: int64;
    settlement_price_type_calc_method: uint8 &convert=SettlementPriceTypeCalcMethod($$);
    total_volume: uint32;
    open_interest_quantity: uint32;
    high_limit_price: int64;
    low_limit_price: int64;
    trading_collar_variation_type: uint8 &convert=TradingCollarVariationType($$);
    trading_collar_variation: int64;
    : skip bytes &size=16;   # padding
};

type ComplexInstrumentDefinitionMessage = unit {
    timestamp: uint64;
    instrument_id: uint32;
    underlying_asset_type: uint8 &convert=UnderlyingAssetType($$);
    underlying_asset: bytes &size=4;
    product_group_code: bytes &size=6;
    spread_type: bytes &size=1;
    exchange: bytes &size=4;
    instrument_id_source: uint8 &convert=InstrumentIdSource($$);
    instrument_type: uint8 &convert=InstrumentType($$);
    currency: uint8 &convert=Currency($$);
    settlement_currency: uint8 &convert=SettlementCurrency($$);
    match_algorithm: uint8 &convert=MatchAlgorithm($$);
    minimum_size: uint32;
    maximum_size: uint32;
    tick: int64;
    unit_of_measure: bytes &size=5;
    unit_of_measure_quantity: uint32;
    trading_collar_variation_type: uint8 &convert=TradingCollarVariationType($$);
    trading_collar_variation: int64;
    : skip bytes &size=16;   # padding
    number_of_legs: uint8;
    instrument_leg: InstrumentLeg[self.number_of_legs];
};

type InstrumentLeg = unit {
    instrument_id: uint32;
    leg_ratio: int32;
    maturity_month_year: uint32;
    : skip bytes &size=8;   # padding
};

type SystemStateMessage = unit {
    timestamp: uint64;
    dom_version: bytes &size=8;
    session_id: uint8;
    system_status: uint8 &convert=SystemStatus($$);
};

type InstrumentTradingStatusNotificationMessage = unit {
    timestamp: uint64;
    instrument_id: uint32;
    trading_status: uint8 &convert=TradingStatus($$);
    market_state: uint8 &convert=MarketState($$);
};

type AnticipatedOpeningPriceMessage = unit {
    timestamp: uint64;
    instrument_id: uint32;
    anticipated_opening_price: int64;
    opening_match_quantity: uint32;
};

type SettlementPriceUpdateMessage = unit {
    timestamp: uint64;
    trade_date: uint16;
    instrument_id: uint32;
    settlement_price: int64;
    settlement_price_type: uint8 &convert=SettlementPriceType($$);
    settlement_price_type_calc_method: uint8 &convert=SettlementPriceTypeCalcMethod($$);
};

type OpenInterestUpdateMessage = unit {
    timestamp: uint64;
    trade_date: uint16;
    instrument_id: uint32;
    open_interest_quantity: uint32;
};

type TotalVolumeUpdateMessage = unit {
    timestamp: uint64;
    trade_date: uint16;
    instrument_id: uint32;
    total_volume: uint32;
};

type InstrumentClearMessage = unit {
    timestamp: uint64;
    instrument_id: uint32;
};

type AddOrderMessage = unit {
    timestamp: uint64;
    instrument_id: uint32;
    order_type: uint8 &convert=OrderType($$);
    order_id: uint64;
    order_side: uint8 &convert=OrderSide($$);
    price: int64;
    size: uint32;
};

type ModifyOrderMessage = unit {
    timestamp: uint64;
    instrument_id: uint32;
    order_id: uint64;
    price: int64;
    size: uint32;
    modify_flags: bitfield(8) {
        order_position: 0;
        unused: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type DeleteOrderMessage = unit {
    timestamp: uint64;
    instrument_id: uint32;
    order_id: uint64;
};

type OrderExecutionMessage = unit {
    timestamp: uint64;
    trade_date: uint16;
    instrument_id: uint32;
    buy_order_id: uint64;
    sell_order_id: uint64;
    aggressor_side: uint8 &convert=AggressorSide($$);
    trade_id: uint64;
    correction_number: uint8;
    price: int64;
    size: uint32;
};

type TradeCancelMessage = unit {
    timestamp: uint64;
    trade_date: uint16;
    instrument_id: uint32;
    trade_id: uint64;
    correction_number: uint8;
    price: int64;
    size: uint32;
};

type PacketType = enum {
    Heartbeat = 0,
    StartOfSession = 1,
    EndOfSession = 2,
    ApplicationMessage = 3,
};

type MessageType = enum {
    SimpleInstrumentDefinitionMessage = 1,
    ComplexInstrumentDefinitionMessage = 2,
    SystemStateMessage = 3,
    InstrumentTradingStatusNotificationMessage = 4,
    AnticipatedOpeningPriceMessage = 5,
    SettlementPriceUpdateMessage = 6,
    OpenInterestUpdateMessage = 7,
    TotalVolumeUpdateMessage = 8,
    InstrumentClearMessage = 9,
    AddOrderMessage = 10,
    ModifyOrderMessage = 11,
    DeleteOrderMessage = 12,
    OrderExecutionMessage = 13,
    TradeCancelMessage = 14,
};

type UnderlyingAssetType = enum {
    EquityIndex = 0x45,
    CommodityAgriculture = 0x41,
};

type InstrumentIdSource = enum {
    Exchange = 0x45,
};

type InstrumentType = enum {
    Futures = 0x46,
};

type Currency = enum {
    Usd = 0x55,
};

type SettlementCurrency = enum {
    Usd = 0x55,
};

type MatchAlgorithm = enum {
    PriceThenTime = 0x50,
};

type SettlementPriceTypeCalcMethod = enum {
    Actual = 0x41,
    Theoretical = 0x54,
};

type TradingCollarVariationType = enum {
    ProductDollarCollarValue = 0x44,
    ProductCollarPercentageValue = 0x50,
    StandardCalendarSpread = 0x53,
    EquityCalendarSpread = 0x45,
    ButterflySpread = 0x42,
};

type SystemStatus = enum {
    StartOfSystemHours = 0x53,
    EndOfSystemHours = 0x43,
    StartOfTestSession = 0x31,
    EndOfTestSession = 0x32,
};

type TradingStatus = enum {
    PreOpen = 1,
    OpeningFreeze = 2,
    Trading = 3,
    Halt = 4,
    OperationalHalt = 5,
    Closed = 6,
};

type MarketState = enum {
    PreOpening = 1,
    Extended1TradingSession = 2,
    RegularTradingSession = 3,
    Extended2TradingSession = 4,
};

type SettlementPriceType = enum {
    Daily = 0x44,
    Final = 0x46,
};

type OrderType = enum {
    SimpleOrder = 0x53,
    ComplexOrder = 0x43,
    DerivedOrder = 0x44,
};

type OrderSide = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type AggressorSide = enum {
    Buy = 0x42,
    Sell = 0x53,
    NotApplicable = 0x4e,
};

