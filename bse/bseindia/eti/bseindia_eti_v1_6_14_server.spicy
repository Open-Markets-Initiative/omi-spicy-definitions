type OrderExecNotification = unit {
    : skip bytes &size=2;   # padding
    rbc_header_me_comp: RbcHeaderMeComp;
    order_id: uint64;
    sender_location_id: uint64;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
