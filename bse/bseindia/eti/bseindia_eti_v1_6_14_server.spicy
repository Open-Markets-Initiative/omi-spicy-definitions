    mass_action_reason: uint8 &convert=MassActionReason($$);
    party_id_entering_firm: uint8 &convert=PartyIdEnteringFirm($$);
    target_party_id_desk_id: bytes &size=3;
    : skip bytes &size=1;   # padding
    not_affected_securities_grp_comp: NotAffectedSecuritiesGrpComp[self.no_not_affected_securities];
};

