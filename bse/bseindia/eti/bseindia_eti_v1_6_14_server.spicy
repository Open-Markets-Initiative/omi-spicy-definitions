    mass_action_reason: uint8 &convert=MassActionReason($$);
    exec_inst: uint8 &convert=ExecInst($$);
    : skip bytes &size=2;   # padding
};

type DeleteAllOrderResponse = unit {
    : skip bytes &size=2;   # padding
    response_header_me_comp: ResponseHeaderMeComp;
    mass_action_report_id: uint64;
    no_not_affected_orders: uint16;
    : skip bytes &size=6;   # padding
    not_affected_orders_grp_comp: NotAffectedOrdersGrpComp[self.no_not_affected_orders];
};

type ResponseHeaderMeComp = unit {
    request_time: uint64;
    request_out: uint64;
    trd_reg_ts_time_in: uint64;
    trd_reg_ts_time_out: uint64;
    response_in: uint64;
    sending_time: uint64;
    msg_seq_num: uint32;
    partition_id: uint16;
    appl_id: uint8 &convert=ApplId($$);
    appl_msg_id: bytes &size=16;
    last_fragment: uint8 &convert=LastFragment($$);
};

type DeleteAllQuoteBroadcast = unit {
    : skip bytes &size=2;   # padding
    rbc_header_me_comp: RbcHeaderMeComp;
    mass_action_report_id: uint64;
