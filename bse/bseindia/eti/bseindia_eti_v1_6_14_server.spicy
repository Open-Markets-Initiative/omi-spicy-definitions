    : skip bytes &size=3;   # padding
    multi_leg_grp_comp: MultiLegGrpComp[self.no_of_multi_leg];
    multi_leg_fill_grp_comp: MultiLegFillGrpComp[self.no_of_multi_leg_execs];
    instrmnt_leg_exec_grp_comp: InstrmntLegExecGrpComp[self.no_leg_execs];
};

type MultiLegGrpComp = unit {
