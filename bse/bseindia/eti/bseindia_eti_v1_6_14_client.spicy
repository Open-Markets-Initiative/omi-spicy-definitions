};

type LogonRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    heart_bt_int: uint32;
    party_id_session_id: uint32;
    default_cstm_appl_ver_id: bytes &size=30;
    password: bytes &size=32;
    appl_usage_orders: uint8 &convert=ApplUsageOrders($$);
    appl_usage_quotes: uint8 &convert=ApplUsageQuotes($$);
    order_routing_indicator: uint8 &convert=OrderRoutingIndicator($$);
    fix_engine_name: bytes &size=30;
    fix_engine_version: bytes &size=30;
    fix_engine_vendor: bytes &size=30;
    application_system_name: bytes &size=30;
    application_system_version: bytes &size=30;
    application_system_vendor: bytes &size=30;
    : skip bytes &size=3;   # padding
};

type LogoutRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
};

type MassQuoteRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    sender_location_id: uint64;
    quote_id: uint64;
    market_segment_id: int32;
    regulatory_id: uint32;
    enrichment_rule_id: uint16;
    account_type: uint8 &convert=AccountType($$);
    price_validity_check_type: uint8 &convert=PriceValidityCheckType($$);
    quote_size_type: uint8 &convert=QuoteSizeType($$);
    stpc_flag: uint8 &convert=StpcFlag($$);
    no_quote_entries: uint8;
    algo_id: bytes &size=16;
    client_code: bytes &size=12;
    cp_code: bytes &size=12;
    : skip bytes &size=1;   # padding
    quote_entry_grp_comp: QuoteEntryGrpComp[self.no_quote_entries];
};

type QuoteEntryGrpComp = unit {
    security_id: int64;
    bid_px: uint64;
    offer_px: uint64;
    bid_size: int32;
    offer_size: int32;
    message_tag: int32;
    : skip bytes &size=4;   # padding
};

type ModifyOrderComplexRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    order_id: uint64;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    security_id: int64;
    price: uint64;
    max_price_percentage: uint64;
    sender_location_id: uint64;
    activity_time: uint64;
    : skip bytes &size=8;   # padding
    : skip bytes &size=4;   # padding
    market_segment_id: int32;
    message_tag: int32;
    order_qty: int32;
    max_show: int32;
    expire_date: uint32;
    target_party_id_session_id: uint32;
    regulatory_id: uint32;
    : skip bytes &size=2;   # padding
    party_id_take_up_trading_firm: bytes &size=5;
    party_id_order_origination_firm: bytes &size=7;
    party_id_beneficiary: bytes &size=9;
    account_type: uint8 &convert=AccountType($$);
    appl_seq_indicator: uint8 &convert=ApplSeqIndicator($$);
    product_complex: uint8 &convert=ProductComplex($$);
    side: uint8 &convert=Side($$);
    ord_type: uint8 &convert=OrdType($$);
    price_validity_check_type: uint8 &convert=PriceValidityCheckType($$);
    exec_inst: uint8 &convert=ExecInst($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    rollover_flag: uint8;
    trading_capacity: uint8;
    delta_qty_flag: bytes &size=1;
    party_id_location_id: bytes &size=2;
    cust_order_handling_inst: bytes &size=1;
    regulatory_text: bytes &size=20;
    algo_id: bytes &size=16;
    client_code: bytes &size=12;
    cp_code: bytes &size=12;
    free_text_3: bytes &size=12;
    no_legs: uint8;
    : skip bytes &size=2;   # padding
    leg_ord_grp_comp: LegOrdGrpComp[self.no_legs];
};

type LegOrdGrpComp = unit {
    leg_account: bytes &size=2;
    leg_position_effect: bytes &size=1;
    : skip bytes &size=5;   # padding
};

