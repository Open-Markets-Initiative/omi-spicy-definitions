type ApplUsageOrders = enum {
    Automated = 0x41,
    Manual = 0x4d,
    AutoSelect = 0x42,
    None_x4e = 0x4e,
};

type ApplUsageQuotes = enum {
    Automated = 0x41,
    Manual = 0x4d,
    AutoSelect = 0x42,
    None_x4e = 0x4e,
};

