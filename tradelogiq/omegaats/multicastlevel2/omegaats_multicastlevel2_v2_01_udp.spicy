module TradelogiqOmegaatsMulticastlevel2ItchV201Udp;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type OmegaatsMulticastlevel2V201 = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::StockDirectoryMessage -> stock_directory_message: StockDirectoryMessage;
        MessageType::ExtendedStockDirectoryMessage -> extended_stock_directory_message: ExtendedStockDirectoryMessage;
        MessageType::StockTradingActionMessage -> stock_trading_action_message: StockTradingActionMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        MessageType::OrderExecutedWithPriceMessage -> order_executed_with_price_message: OrderExecutedWithPriceMessage;
        MessageType::OrderDeleteMessage -> order_delete_message: OrderDeleteMessage;
        MessageType::OrderReplaceMessage -> order_replace_message: OrderReplaceMessage;
        MessageType::OrderCancelMessage -> order_cancel_message: OrderCancelMessage;
        MessageType::TradeMessage -> trade_message: TradeMessage;
        MessageType::CrossTradeMessage -> cross_trade_message: CrossTradeMessage;
        MessageType::TradeBustMessage -> trade_bust_message: TradeBustMessage;
        MessageType::TradeAmendMessage -> trade_amend_message: TradeAmendMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type SystemEventMessage = unit {
    event_code: uint8 &convert=EventCode($$);
    : skip bytes &size=2;   # padding
    timestamp: uint64;
};

type StockDirectoryMessage = unit {
    market: uint8 &convert=Market($$);
    stock: bytes &size=10;
    timestamp: uint64;
    board_lot_size: uint32;
    instrument_id: uint16;
    shortable: uint8 &convert=Shortable($$);
    dividend_indicator: uint8 &convert=DividendIndicator($$);
    : skip bytes &size=9;   # padding
    currency: bytes &size=3;
};

type ExtendedStockDirectoryMessage = unit {
    market: uint8 &convert=Market($$);
    stock: bytes &size=10;
    timestamp: uint64;
    board_lot_size: uint32;
    instrument_id: uint16;
    shortable: uint8 &convert=Shortable($$);
    frequency: uint8 &convert=Frequency($$);
    : skip bytes &size=9;   # padding
    currency: bytes &size=3;
    security_type: uint8 &convert=SecurityType($$);
    expiry_date: bytes &size=8;
    description: bytes &size=20;
    : skip bytes &size=3;   # padding
};

type StockTradingActionMessage = unit {
    trading_state: uint8 &convert=TradingState($$);
    instrument_id: uint16;
    timestamp: uint64;
    reason: bytes &size=4;
};

type AddOrderMessage = unit {
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    instrument_id: uint16;
    timestamp: uint64;
    order_reference_number: uint32;
    shares: uint32;
    price: uint32;
    exec_broker_id: uint16;
    : skip bytes &size=2;   # padding
};

type OrderExecutedMessage = unit {
    marker: bytes &size=1;
    instrument_id: uint16;
    timestamp: uint64;
    order_reference_number: uint32;
    executed_shares: uint32;
    match_number: uint32;
    contra_broker_id: uint16;
    : skip bytes &size=2;   # padding
};

type OrderExecutedWithPriceMessage = unit {
    marker: bytes &size=1;
    instrument_id: uint16;
    timestamp: uint64;
    order_reference_number: uint32;
    executed_shares: uint32;
    execution_price: uint32;
    match_number: uint32;
    contra_broker_id: uint16;
    : skip bytes &size=2;   # padding
};

type OrderDeleteMessage = unit {
    : skip bytes &size=1;   # padding
    instrument_id: uint16;
    timestamp: uint64;
    order_reference_number: uint32;
};

type OrderReplaceMessage = unit {
    : skip bytes &size=1;   # padding
    instrument_id: uint16;
    timestamp: uint64;
    original_order_reference_number: uint32;
    new_order_reference_number: uint32;
    shares: uint32;
    price: uint32;
};

type OrderCancelMessage = unit {
    : skip bytes &size=1;   # padding
    instrument_id: uint16;
    timestamp: uint64;
    order_reference_number: uint32;
    cancelled_shares: uint32;
};

type TradeMessage = unit {
    side: uint8 &convert=Side($$);
    instrument_id: uint16;
    timestamp: uint64;
    midpoint_book_trade: uint32 &convert=MidpointBookTrade($$);
    shares: uint32;
    price: uint32;
    match_number: uint32;
    buy_broker_id: uint16;
    sell_broker_id: uint16;
};

type CrossTradeMessage = unit {
    cross_type: uint8 &convert=CrossType($$);
    instrument_id: uint16;
    timestamp: uint64;
    shares: uint32;
    price: uint32;
    match_number: uint32;
    buy_broker_id: uint16;
    sell_broker_id: uint16;
    bypass: uint8 &convert=Bypass($$);
    settlement_type: uint8 &convert=SettlementType($$);
    : skip bytes &size=2;   # padding
};

type TradeBustMessage = unit {
    : skip bytes &size=1;   # padding
    instrument_id: uint16;
    timestamp: uint64;
    match_number: uint32;
};

type TradeAmendMessage = unit {
    : skip bytes &size=1;   # padding
    instrument_id: uint16;
    timestamp: uint64;
    original_trade_id: uint32;
    original_trade_price: uint64;
    original_trade_size: uint32;
    corrected_trade_price: uint64;
    corrected_trade_size: uint32;
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    StockDirectoryMessage = 0x52,
    ExtendedStockDirectoryMessage = 0x72,
    StockTradingActionMessage = 0x48,
    AddOrderMessage = 0x41,
    OrderExecutedMessage = 0x45,
    OrderExecutedWithPriceMessage = 0x43,
    OrderDeleteMessage = 0x44,
    OrderReplaceMessage = 0x55,
    OrderCancelMessage = 0x58,
    TradeMessage = 0x50,
    CrossTradeMessage = 0x51,
    TradeBustMessage = 0x42,
    TradeAmendMessage = 0x4d,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfMarketHours = 0x51,
    EndOfMarketHours = 0x4d,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
    TradingHalted = 0x42,
    TradingResumed = 0x52,
};

type Market = enum {
    Tsx = 0x74,
    TsxVenture = 0x76,
    Cse = 0x63,
    NasdaqCanada = 0x71,
    OmegaAts = 0x6f,
    CboeCanada = 0x7a,
};

type Shortable = enum {
    ShortExempt = 0x45,
    Shortable_x53 = 0x53,
    NotShortable = 0x4e,
};

type DividendIndicator = enum {
    Annual = 0x41,
    SemiAnnual = 0x53,
    Quarterly = 0x51,
    Monthly = 0x4d,
};

type Frequency = enum {
    Annual = 0x41,
    SemiAnnual = 0x53,
    Quarterly = 0x51,
    Monthly = 0x4d,
};

type SecurityType = enum {
    Bonds = 0x62,
    Debentures = 0x64,
    Rights = 0x72,
    Notes = 0x6e,
    Warrants = 0x77,
};

type TradingState = enum {
    Halted = 0x48,
    Trading = 0x54,
};

type Reason = enum {
    RegulatoryHalt = 0x52,
    BusinessHalt = 0x42,
};

type BuySellIndicator = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type MidpointBookTrade = enum {
    No = 0,
    Yes = 1,
};

type CrossType = enum {
    DerivativesCross = 0x44,
    InternalCross = 0x49,
    IntentionalCross = 0x4d,
    NetAssetValueCross = 0x4e,
};

type Bypass = enum {
    Bypass_x59 = 0x59,
    NonBypass = 0x4e,
};

type SettlementType = enum {
    RegularSettlement = 0x30,
    Cash = 0x31,
    NextDay = 0x32,
    DelayedDelivery = 0x33,
};

