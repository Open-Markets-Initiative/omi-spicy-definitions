module TradelogiqOmegaatsSnapshotrecoveryItchV109Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type OmegaatsSnapshotrecoveryV109 = unit {
    server_soup_tcp_packet: ServerSoupTcpPacket[] &eod;
};

type ServerSoupTcpPacket = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: uint8 &convert=RejectReasonCode($$);
};

type SequencedDataPacket = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::StockDirectoryMessage -> stock_directory_message: StockDirectoryMessage;
        MessageType::ExtendedStockDirectoryMessage -> extended_stock_directory_message: ExtendedStockDirectoryMessage;
        MessageType::StockTradingActionMessage -> stock_trading_action_message: StockTradingActionMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemEventMessage = unit {
    event_code: uint8 &convert=EventCode($$);
    : skip bytes &size=2;   # padding
    timestamp: uint64;
};

type StockDirectoryMessage = unit {
    market: uint8 &convert=Market($$);
    stock: bytes &size=10;
    timestamp: uint64;
    board_lot_size: uint32;
    instrument_id: uint16;
    shortable: uint8 &convert=Shortable($$);
    dividend_indicator: uint8 &convert=DividendIndicator($$);
    : skip bytes &size=9;   # padding
    currency: bytes &size=3;
};

type ExtendedStockDirectoryMessage = unit {
    market: uint8 &convert=Market($$);
    stock: bytes &size=10;
    timestamp: uint64;
    board_lot_size: uint32;
    instrument_id: uint16;
    shortable: uint8 &convert=Shortable($$);
    frequency: uint8 &convert=Frequency($$);
    : skip bytes &size=9;   # padding
    currency: bytes &size=3;
    security_type: uint8 &convert=SecurityType($$);
    expiry_date: bytes &size=8;
    description: bytes &size=20;
    : skip bytes &size=3;   # padding
};

type StockTradingActionMessage = unit {
    trading_state: uint8 &convert=TradingState($$);
    instrument_id: uint16;
    timestamp: uint64;
    reason: bytes &size=4;
};

type AddOrderMessage = unit {
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    instrument_id: uint16;
    timestamp: uint64;
    order_reference_number: uint32;
    shares: uint32;
    price: uint32;
    exec_broker_id: uint16;
    : skip bytes &size=2;   # padding
};

type ServerPacketType = enum {
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
};

type RejectReasonCode = enum {
    NotAuthorized = 0x41,
    SessionNotAvailable = 0x53,
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    StockDirectoryMessage = 0x52,
    ExtendedStockDirectoryMessage = 0x72,
    StockTradingActionMessage = 0x48,
    AddOrderMessage = 0x41,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfMarketHours = 0x51,
    EndOfMarketHours = 0x4d,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
    TradingHalted = 0x42,
    TradingResumed = 0x52,
};

type Market = enum {
    Tsx = 0x74,
    TsxVenture = 0x76,
    Cse = 0x63,
    NasdaqCanada = 0x71,
    OmegaAts = 0x6f,
    CboeCanada = 0x7a,
};

type Shortable = enum {
    ShortExempt = 0x45,
    Shortable_x53 = 0x53,
    NotShortable = 0x4e,
};

type DividendIndicator = enum {
    Annual = 0x41,
    SemiAnnual = 0x53,
    Quarterly = 0x51,
    Monthly = 0x4d,
};

type Frequency = enum {
    Annual = 0x41,
    SemiAnnual = 0x53,
    Quarterly = 0x51,
    Monthly = 0x4d,
};

type SecurityType = enum {
    Bonds = 0x62,
    Debentures = 0x64,
    Rights = 0x72,
    Notes = 0x6e,
    Warrants = 0x77,
};

type TradingState = enum {
    Halted = 0x48,
    Trading = 0x54,
};

type Reason = enum {
    RegulatoryHalt = 0x52,
    BusinessHalt = 0x42,
};

type BuySellIndicator = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

