module NyseArcaoptionsBinarygatewayPillarstreamV325ClientPillarMessage;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type ArcaoptionsBinarygatewayV325 = unit {
    switch ( self.client_message.login_message.msg_header.msg_type ) {
        MsgType::Login -> login_message: LoginMessage;
        MsgType::Heartbeat -> heartbeat: Heartbeat;
        MsgType::Open -> open: Open;
        MsgType::Close -> close: Close;
        MsgType::SeqMsg -> client_seq_msg: ClientSeqMsg;
        * -> unknown: bytes &eod;
    };
};

type LoginMessage = unit {
    msg_header: MsgHeader;
    username: bytes &size=16;
    password: bytes &size=32;
    mic: bytes &size=4;
    version: bytes &size=20;
};

type MsgHeader = unit {
    msg_type: uint16 &convert=MsgType($$);
    msg_length: uint16;
};

type Heartbeat = unit {
    msg_header: MsgHeader;
};

type Open = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    start_seq: uint64;
    end_seq: uint64;
    access: uint8;
    mode: uint8;
};

type StreamId = unit {
    sess: uint32;
    user: uint32;
};

type Close = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
};

type ClientSeqMsg = unit {
    msg_header: MsgHeader;
    seq_msg_id: SeqMsgId;
    : skip bytes &size=4;   # padding
    timestamp: uint64;
    seq_msg_header: SeqMsgHeader;
    switch ( self.seq_msg_header.seq_msg_type ) {
        SeqMsgType::SessionConfigurationRequestMessage -> session_configuration_request_message: SessionConfigurationRequestMessage;
        SeqMsgType::NewOrderMessage -> new_order_message: NewOrderMessage;
        SeqMsgType::OrderCancelRequestMessage -> order_cancel_request_message: OrderCancelRequestMessage;
        SeqMsgType::OrderModifyRequestMessage -> order_modify_request_message: OrderModifyRequestMessage;
        SeqMsgType::NewBulkQuoteMessage -> new_bulk_quote_message: NewBulkQuoteMessage;
        SeqMsgType::NewBulkQuoteWithOrderIdMessage -> new_bulk_quote_with_order_id_message: NewBulkQuoteWithOrderIdMessage;
        SeqMsgType::NewOrderCrossMessage -> new_order_cross_message: NewOrderCrossMessage;
        SeqMsgType::BulkCancelRequestMessage -> bulk_cancel_request_message: BulkCancelRequestMessage;
        SeqMsgType::BulkCancelRequestWithMpSubIdMessage -> bulk_cancel_request_with_mp_sub_id_message: BulkCancelRequestWithMpSubIdMessage;
        SeqMsgType::RiskLimitUpdateRequestMessage -> risk_limit_update_request_message: RiskLimitUpdateRequestMessage;
        SeqMsgType::RiskActionRequestMessage -> risk_action_request_message: RiskActionRequestMessage;
        SeqMsgType::NewComplexSeriesRequestMessage -> new_complex_series_request_message: NewComplexSeriesRequestMessage;
        * -> unknown: bytes &eod;
    };
};

type SeqMsgId = unit {
    stream_id: StreamId;
    seq: uint64;
};

type SeqMsgHeader = unit {
    seq_msg_type: uint16 &convert=SeqMsgType($$);
    seq_msg_length: uint16;
};

type SessionConfigurationRequestMessage = unit {
    username: bytes &size=16;
    cancel_on_disconnect: uint8 &convert=CancelOnDisconnect($$);
    throttle_preference: uint8 &convert=ThrottlePreference($$);
    self_trade_prevention: uint8 &convert=SelfTradePrevention($$);
    order_priority_update_ack_subscription: uint8 &convert=OrderPriorityUpdateAckSubscription($$);
    bold_designation: uint8 &convert=BoldDesignation($$);
    : skip bytes &size=49;   # padding
};

type NewOrderMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    mp_sub_id: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    bitfield_order_instructions: bitfield(128) {
        unused_34: 0..33;
        security_type: 34..38;
        customer_or_firm: 39..43;
        open_close_bits: 44..45;
        sub_id_indicator: 46..50;
        special_ord_type: 51..55;
        locate_reqd_bits: 56..57;
        retail_indicator: 58..62;
        attributed_quote: 63..67;
        order_capacity: 68..72;
        interest_type: 73..77;
        trading_session_id: 78..82;
        time_in_force: 83..87;
        proactive_if_locked: 88..92;
        self_trade_type_bits: 93..97;
        cancel_instead_of_reprice: 98..102;
        routing_inst: 103..107;
        extended_exec_inst: 108..112;
        exec_inst: 113..117;
        ord_type: 118..122;
        side_bits: 123..127;
    } &byte-order=spicy::ByteOrder::Little;
    price: int64;
    order_qty: uint32;
    min_qty: uint32;
    user_data: bytes &size=10;
    leg_open_close: uint64 &convert=LegOpenClose($$);
    auction_id: uint64;
    optional_order_add_on: OptionalOrderAddOn;
};

type OptionalOrderAddOn = unit {
    sub_msg_header: SubMsgHeader;
    stop_px: int64;
    max_floor: uint32;
    deliver_to_comp_id: bytes &size=5;
    clearing_firm: bytes &size=5;
    optional_data: bytes &size=16;
    clearing_account: bytes &size=5;
};

type SubMsgHeader = unit {
    sub_msg_type: uint16;
    sub_msg_length: uint16;
};

type OrderCancelRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
};

type OrderModifyRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    order_qty: uint32;
    side: uint8 &convert=Side($$);
    locate_reqd: uint8 &convert=LocateReqd($$);
};

type NewBulkQuoteMessage = unit {
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    sub_id: bytes &size=4;
    cl_ord_id: uint64;
    self_trade_type: uint8 &convert=SelfTradeType($$);
    group_id: uint32;
    mm_sent_time: uint64;
    quote_request_group: QuoteRequestGroup[] &eod;
};

type QuoteRequestGroup = unit {
    series_index: uint32;
    bitfield_quote_inst: bitfield(8) {
        quote_side: 0..1;
        mm_quote_type: 2..4;
        unused_3: 5..7;
    } &byte-order=spicy::ByteOrder::Little;
    price: int64;
    order_qty: uint32;
};

type NewBulkQuoteWithOrderIdMessage = unit {
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    sub_id: bytes &size=4;
    cl_ord_id: uint64;
    self_trade_type: uint8 &convert=SelfTradeType($$);
    group_id: uint32;
    mm_sent_time: uint64;
    quote_request_group: QuoteRequestGroup[] &eod;
};

type NewOrderCrossMessage = unit {
    cross_id: uint64;
    allocation_pct: uint8;
    clearing_firm_exposed: bytes &size=5;
    clearing_account_exposed: bytes &size=5;
    optional_data_exposed: bytes &size=16;
    clearing_firm_covered: bytes &size=5;
    clearing_account_covered: bytes &size=5;
    optional_data_covered: bytes &size=16;
    : skip bytes &size=16;   # padding
    exposed: Exposed;
    covered: Covered;
};

