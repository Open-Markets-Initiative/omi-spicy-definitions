    : skip bytes &size=199;   # padding
};

type NewComplexSeriesRequestMessage = unit {
    cl_ord_id: uint64;
    mpid: bytes &size=4;
    complex_series_leg_group: ComplexSeriesLegGroup[] &eod;
};

type ComplexSeriesLegGroup = unit {
    leg_symbol_id: uint32;
    leg_ratio_qty: uint16;
    leg_side: uint8 &convert=LegSide($$);
};

type MsgType = enum {
    Login = 0x0201,
    LoginResponse = 0x0202,
    StreamAvail = 0x0203,
    Heartbeat = 0x0204,
    Open = 0x0205,
    OpenResponse = 0x0206,
    Close = 0x0207,
    CloseResponse = 0x0208,
    SeqMsg = 0x0905,
};

type SeqMsgType = enum {
    SessionConfigurationRequestMessage = 0x0220,
    SequencedFillerMessage = 0x0282,
    NewOrderMessage = 0x0248,
    OrderCancelRequestMessage = 0x0250,
    OrderModifyRequestMessage = 0x0251,
    NewBulkQuoteMessage = 0x0243,
    NewBulkQuoteWithOrderIdMessage = 0x0259,
    NewOrderCrossMessage = 0x0222,
    BulkCancelRequestMessage = 0x0223,
    BulkCancelRequestWithMpSubIdMessage = 0x0224,
    RiskLimitUpdateRequestMessage = 0x0330,
    RiskActionRequestMessage = 0x0331,
    NewComplexSeriesRequestMessage = 0x0357,
    UnderlyingSymbolReferenceDataMessage = 0x0233,
    SeriesReferenceDataMessage = 0x0234,
    MinimumPriceVariantClassReferenceDataMessage = 0x0230,
    MinimumPriceVariantLevelReferenceDataMessage = 0x0231,
    MpidConfigurationMessage = 0x0272,
    OptionsMarketMakerSymbolAppointmentReferenceDataMessage = 0x0833,
    SessionConfigurationAcknowledgementMessage = 0x0221,
    OrderAndCancelReplaceAcknowledgementMessage = 0x0269,
    BulkQuoteAcknowledgmentMessage = 0x0294,
    BulkQuoteAcknowledgmentWithDetailsMessage = 0x0308,
    OrderSingleComplexModifyCancelRequestAcknowledgmentAndUroutMessage = 0x0278,
    OrderPriorityUpdateAcknowledgmentMessage = 0x0268,
    ExecutionReportMessage = 0x0295,
    TradeBustCorrectMessage = 0x0293,
    ApplicationLayerRejectMessage = 0x0267,
    RiskControlAcknowledgementMessage = 0x0332,
    RiskControlAlertMessage = 0x0333,
    ComplexSeriesRequestAcknowledgementMessage = 0x0358,
};

