module NyseArcaoptionsBinarygatewayPillarstreamV315;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type ArcaoptionsBinarygatewayV315 = unit {
    login_message: LoginMessage;
    login_response: LoginResponse;
    stream_avail: StreamAvail;
    heartbeat: Heartbeat;
    open: Open;
    open_response: OpenResponse;
    close: Close;
    close_response: CloseResponse;
    seq_msg: SeqMsg;
};

type LoginMessage = unit {
    msg_header: MsgHeader;
    username: bytes &size=16;
    password: bytes &size=32;
    mic: bytes &size=4;
    version: bytes &size=20;
};

type MsgHeader = unit {
    msg_type: uint16 &convert=MsgType($$);
    msg_length: uint16;
};

type LoginResponse = unit {
    msg_header: MsgHeader;
    username: bytes &size=16;
    status: uint8 &convert=Status($$);
};

type StreamAvail = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    next_seq: uint64;
    access: uint8;
};

type StreamId = unit {
    sess: uint32;
    user: uint32;
};

type Heartbeat = unit {
    msg_header: MsgHeader;
};

type Open = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    start_seq: uint64;
    end_seq: uint64;
    access: uint8;
    mode: uint8;
};

type OpenResponse = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    status: uint8 &convert=Status($$);
    access: uint8;
};

type Close = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
};

type CloseResponse = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    status: uint8 &convert=Status($$);
};

type SeqMsg = unit {
    msg_header: MsgHeader;
    seq_msg_id: SeqMsgId;
    : skip bytes &size=4;   # padding
    timestamp: uint64;
    seq_msg_header: SeqMsgHeader;
    switch ( self.seq_msg_header.seq_msg_type ) {
        SeqMsgType::SessionConfigurationRequestMessage -> session_configuration_request_message: SessionConfigurationRequestMessage;
        SeqMsgType::SequencedFiller -> sequenced_filler: SequencedFiller;
        SeqMsgType::OrderRequest -> order_request: OrderRequest;
        SeqMsgType::OrderCancelRequest -> order_cancel_request: OrderCancelRequest;
        SeqMsgType::OrderModifyRequest -> order_modify_request: OrderModifyRequest;
        SeqMsgType::NewBulkQuote -> new_bulk_quote: NewBulkQuote;
        SeqMsgType::NewOrderCross -> new_order_cross: NewOrderCross;
        SeqMsgType::BulkCancelRequest -> bulk_cancel_request: BulkCancelRequest;
        SeqMsgType::RiskLimitUpdateRequest -> risk_limit_update_request: RiskLimitUpdateRequest;
        SeqMsgType::RiskActionRequest -> risk_action_request: RiskActionRequest;
        SeqMsgType::NewComplexSeriesRequest -> new_complex_series_request: NewComplexSeriesRequest;
        SeqMsgType::UnderlyingSymbolReferenceData -> underlying_symbol_reference_data: UnderlyingSymbolReferenceData;
        SeqMsgType::SeriesReferenceData -> series_reference_data: SeriesReferenceData;
        SeqMsgType::MinimumPriceVariantClassReferenceData -> minimum_price_variant_class_reference_data: MinimumPriceVariantClassReferenceData;
        SeqMsgType::MinimumPriceVariantLevelReferenceData -> minimum_price_variant_level_reference_data: MinimumPriceVariantLevelReferenceData;
        SeqMsgType::MpidConfiguration -> mpid_configuration: MpidConfiguration;
        SeqMsgType::OptionsMarketMakerSymbolAppointmentReferenceData -> options_market_maker_symbol_appointment_reference_data: OptionsMarketMakerSymbolAppointmentReferenceData;
        SeqMsgType::SessionConfigurationAcknowledgement -> session_configuration_acknowledgement: SessionConfigurationAcknowledgement;
        SeqMsgType::OrderAcknowledgement -> order_acknowledgement: OrderAcknowledgement;
        SeqMsgType::BulkQuoteAcknowledgment -> bulk_quote_acknowledgment: BulkQuoteAcknowledgment;
        SeqMsgType::OrderRequestAcknowledgment -> order_request_acknowledgment: OrderRequestAcknowledgment;
        SeqMsgType::OrderPriorityUpdateAcknowledgment -> order_priority_update_acknowledgment: OrderPriorityUpdateAcknowledgment;
        SeqMsgType::ExecutionReport -> execution_report: ExecutionReport;
        SeqMsgType::TradeBustOrCorrect -> trade_bust_or_correct: TradeBustOrCorrect;
        SeqMsgType::ApplicationLayerReject -> application_layer_reject: ApplicationLayerReject;
        SeqMsgType::RiskControlAcknowledgement -> risk_control_acknowledgement: RiskControlAcknowledgement;
        SeqMsgType::RiskControlAlert -> risk_control_alert: RiskControlAlert;
        SeqMsgType::ComplexSeriesRequestAcknowledgement -> complex_series_request_acknowledgement: ComplexSeriesRequestAcknowledgement;
        * -> unknown: bytes &eod;
    };
};

type SeqMsgId = unit {
    stream_id: StreamId;
    seq: uint64;
};

type SeqMsgHeader = unit {
    seq_msg_type: uint16 &convert=SeqMsgType($$);
    seq_msg_length: uint16;
};

type SessionConfigurationRequestMessage = unit {
    seq_msg_header: SeqMsgHeader;
    username: bytes &size=16;
    cancel_on_disconnect: uint8 &convert=CancelOnDisconnect($$);
    throttle_preference: uint8 &convert=ThrottlePreference($$);
    self_trade_prevention: uint8 &convert=SelfTradePrevention($$);
    order_priority_update_ack_subscription: uint8 &convert=OrderPriorityUpdateAckSubscription($$);
    bold_designation: bytes &size=1;
    : skip bytes &size=49;   # padding
};

type SequencedFiller = unit {
    seq_msg_header: SeqMsgHeader;
};

type OrderRequest = unit {
    seq_msg_header: SeqMsgHeader;
    symbol_id: uint32;
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    mp_sub_id: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    order_instructions: OrderInstructions;
    price_price_8: int64;
    order_qty: uint32;
    min_qty: uint32;
    user_data: bytes &size=10;
    leg_open_close: uint64 &convert=LegOpenClose($$);
    auction_id: uint64;
    optional_order_add_on: OptionalOrderAddOn;
};

type OrderInstructions = unit {
    reserved_bits_34: bytes &size=5;
    security_type: uint8 &convert=SecurityType($$);
    capacity: bytes &size=1;
    open_close: uint8 &convert=OpenClose($$);
    sub_id_indicator: bytes &size=1;
    special_ord_type: uint8 &convert=SpecialOrdType($$);
    locate_reqd: uint8 &convert=LocateReqd($$);
    retail_indicator: uint8 &convert=RetailIndicator($$);
    attributed_quote: uint8 &convert=AttributedQuote($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    interest_type: uint8 &convert=InterestType($$);
    trading_session_id: uint8 &convert=TradingSessionId($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    proactive_if_locked: uint8 &convert=ProactiveIfLocked($$);
    self_trade_type: uint8 &convert=SelfTradeType($$);
    cancel_instead_of_reprice: uint8 &convert=CancelInsteadOfReprice($$);
    routing_inst: uint8 &convert=RoutingInst($$);
    extended_exec_inst: uint8 &convert=ExtendedExecInst($$);
    exec_inst: uint8 &convert=ExecInst($$);
    ord_type: uint8 &convert=OrdType($$);
    side_bit_5: bytes &size=1;
};

type OptionalOrderAddOn = unit {
    sub_msg_header: SubMsgHeader;
    stop_px: int64;
    max_floor: uint32;
    deliver_to_comp_id: bytes &size=5;
    clearing_firm: bytes &size=5;
    optional_data: bytes &size=16;
    clearing_account: bytes &size=5;
};

type SubMsgHeader = unit {
    sub_msg_type: uint16;
    sub_msg_length: uint16;
};

type OrderCancelRequest = unit {
    seq_msg_header: SeqMsgHeader;
    symbol_id: uint32;
    mpid: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
};

type OrderModifyRequest = unit {
    seq_msg_header: SeqMsgHeader;
    symbol_id: uint32;
    mpid: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    order_qty: uint32;
    side_u_81: uint8;
    locate_reqd: uint8 &convert=LocateReqd($$);
};

type NewBulkQuote = unit {
    seq_msg_header: SeqMsgHeader;
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    sub_id: bytes &size=4;
    cl_ord_id: uint64;
    self_trade_type: uint8 &convert=SelfTradeType($$);
    group_id: uint32;
    mm_sent_time: uint64;
    bulk_quote: BulkQuote[] &eod;
};

type BulkQuote = unit {
    series_index: uint32;
    bit_field_quote_inst: uint8;
    price_price_8: int64;
    order_qty: uint32;
};

type NewOrderCross = unit {
    seq_msg_header: SeqMsgHeader;
    cross_id: uint64;
    allocation_pct: uint8;
    clearing_firm_exposed: bytes &size=5;
    clearing_account_exposed: bytes &size=5;
    clearing_firm_covered: bytes &size=5;
    clearing_account_covered: bytes &size=5;
    : skip bytes &size=16;   # padding
    exposed: Exposed;
    covered: Covered;
};

type Exposed = unit {
    sub_msg_header: SubMsgHeader;
    symbol_id: uint32;
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    mp_sub_id: bytes &size=4;
    cl_ord_id: uint64;
