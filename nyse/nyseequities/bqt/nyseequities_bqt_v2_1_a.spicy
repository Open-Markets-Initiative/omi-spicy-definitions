module NyseNyseequitiesBqtXdpV21A;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type NyseequitiesBqtV21A = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    packet_size: uint16;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    message_count: uint8;
    sequence_number: uint32;
    timestamp: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        MessageType::SymbolIndexMappingMessage -> symbol_index_mapping_message: SymbolIndexMappingMessage;
        MessageType::RetransmissionRequestMessage -> retransmission_request_message: RetransmissionRequestMessage;
        MessageType::RequestResponseMessage -> request_response_message: RequestResponseMessage;
        MessageType::HeartbeatResponseMessage -> heartbeat_response_message: HeartbeatResponseMessage;
        MessageType::SymbolIndexMappingRequestMessage -> symbol_index_mapping_request_message: SymbolIndexMappingRequestMessage;
        MessageType::RefreshRequestMessage -> refresh_request_message: RefreshRequestMessage;
        MessageType::MessageUnavailableMessage -> message_unavailable_message: MessageUnavailableMessage;
        MessageType::ConsolidatedSymbolClearMessage -> consolidated_symbol_clear_message: ConsolidatedSymbolClearMessage;
        MessageType::ConsolidatedTradingSessionChangeMessage -> consolidated_trading_session_change_message: ConsolidatedTradingSessionChangeMessage;
        MessageType::ConsolidatedSecurityStatusMessage -> consolidated_security_status_message: ConsolidatedSecurityStatusMessage;
        MessageType::RefreshHeaderMessage -> refresh_header_message: RefreshHeaderMessage;
        MessageType::BqtMessage -> bqt_message: BqtMessage;
        MessageType::ConsolidatedSingleSidedQuoteMessage -> consolidated_single_sided_quote_message: ConsolidatedSingleSidedQuoteMessage;
        MessageType::ConsolidatedTradeMessage -> consolidated_trade_message: ConsolidatedTradeMessage;
        MessageType::ConsolidatedTradeCancelMessage -> consolidated_trade_cancel_message: ConsolidatedTradeCancelMessage;
        MessageType::ConsolidatedTradeCorrectionMessage -> consolidated_trade_correction_message: ConsolidatedTradeCorrectionMessage;
        MessageType::ConsolidatedStockSummaryMessage -> consolidated_stock_summary_message: ConsolidatedStockSummaryMessage;
        MessageType::ConsolidatedVolumeMessage -> consolidated_volume_message: ConsolidatedVolumeMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint16 &convert=MessageType($$);
};

type SequenceNumberResetMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type SymbolIndexMappingMessage = unit {
    symbol_index: uint32;
    symbol: bytes &size=11;
    reserved_binary_1: uint8;
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    exchange_code: uint8 &convert=ExchangeCode($$);
    price_scale_code: uint8;
    security_type: uint8 &convert=SecurityType($$);
    lot_size: uint16;
    prev_close_price: uint32;
    prev_close_volume: uint32;
    price_resolution: uint8 &convert=PriceResolution($$);
    round_lot: uint8 &convert=RoundLot($$);
    mpv: uint16;
    unit_of_trade: uint16;
    reserved_binary_2: uint16;
};

type RetransmissionRequestMessage = unit {
    begin_seq_num: uint32;
    end_seq_num: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
};

type RequestResponseMessage = unit {
    request_seq_num: uint32;
    begin_seq_num: uint32;
    end_seq_num: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
    status: uint8 &convert=Status($$);
};

type HeartbeatResponseMessage = unit {
    source_id: bytes &size=10;
};

type SymbolIndexMappingRequestMessage = unit {
    symbol_index: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
    retransmit_method: uint8 &convert=RetransmitMethod($$);
};

type RefreshRequestMessage = unit {
    symbol_index: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
};

type MessageUnavailableMessage = unit {
    begin_seq_num: uint32;
    end_seq_num: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type ConsolidatedSymbolClearMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    next_source_seq_num: uint32;
    market_id: uint16 &convert=MarketId($$);
};

type ConsolidatedTradingSessionChangeMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    trade_session: TradeSession;
    market_id: uint16 &convert=MarketId($$);
};

type TradeSession = unit {
    ok_for_morning_hours: bytes &size=1;
    ok_for_national_hours_core: bytes &size=1;
    ok_for_late_hours: bytes &size=1;
    reserved_5: bytes &size=1;
};

type ConsolidatedSecurityStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: uint8 &convert=HaltCondition($$);
    market_id: uint16 &convert=MarketId($$);
    reserved_binary_2: uint16;
    price_1: uint32;
    price_2: uint32;
    ssr_triggering_exchange_id: uint8 &convert=SsrTriggeringExchangeId($$);
    ssr_triggering_volume: uint32;
    time_field: uint32;
    ssr_state: uint8 &convert=SsrState($$);
    market_state: uint8 &convert=MarketState($$);
    session_state: uint8 &convert=SessionState($$);
};

type RefreshHeaderMessage = unit {
    current_refresh_pkt: uint16;
    total_refresh_pkts: uint16;
    last_seq_num: uint32;
    last_symbol_seq_num: uint32;
};

type BqtMessage = unit {
    symbol_index: uint32;
    symbol_seq_number: uint32;
    ask_price: uint32;
    ask_volume: uint32;
    bid_price: uint32;
    bid_volume: uint32;
    ask_quote_condition: uint8 &convert=AskQuoteCondition($$);
    bid_quote_condition: uint8 &convert=BidQuoteCondition($$);
    retail_pricing_indicator: uint8 &convert=RetailPricingIndicator($$);
    market_id_of_best_ask: uint16 &convert=MarketIdOfBestAsk($$);
    market_id_of_best_bid: uint16 &convert=MarketIdOfBestBid($$);
};

type ConsolidatedSingleSidedQuoteMessage = unit {
    symbol_index: uint32;
    symbol_seq_number: uint32;
    side: uint8 &convert=Side($$);
    price: uint32;
    volume: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    rpi_indicator: uint8 &convert=RpiIndicator($$);
    market_id: uint16 &convert=MarketId($$);
};

type ConsolidatedTradeMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    trade_id: uint32;
    price: uint32;
    volume: uint32;
    trade_condition_1: uint8 &convert=TradeCondition1($$);
    trade_condition_2: uint8 &convert=TradeCondition2($$);
    trade_condition_3: uint8 &convert=TradeCondition3($$);
    trade_condition_4: uint8 &convert=TradeCondition4($$);
    market_id: uint16 &convert=MarketId($$);
};

type ConsolidatedTradeCancelMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_number: uint32;
    trade_id: uint32;
    market_id: uint16 &convert=MarketId($$);
};

type ConsolidatedTradeCorrectionMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_number: uint32;
    original_trade_id: uint32;
    trade_id: uint32;
    price: uint32;
    volume: uint32;
    trade_condition_1: uint8 &convert=TradeCondition1($$);
    trade_condition_2: uint8 &convert=TradeCondition2($$);
    trade_condition_3: uint8 &convert=TradeCondition3($$);
    trade_condition_4: uint8 &convert=TradeCondition4($$);
    market_id: uint16 &convert=MarketId($$);
};

type ConsolidatedStockSummaryMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    high_price: uint32;
    low_price: uint32;
    open: uint32;
    total_volume: uint32;
    market_id_of_high_price: uint16 &convert=MarketIdOfHighPrice($$);
    market_id_of_low_price: uint16 &convert=MarketIdOfLowPrice($$);
    market_id_of_open_price: uint16 &convert=MarketIdOfOpenPrice($$);
    number_of_close_prices: uint8;
    close_price: ClosePrice;
};

type ClosePrice = unit {
    market_id_of_the_close: uint16 &convert=MarketIdOfTheClose($$);
    close: uint32;
};

type ConsolidatedVolumeMessage = unit {
    symbol_index: uint32;
    symbol_seq_number: uint32;
    total_volume: uint32;
    reason: uint8 &convert=Reason($$);
    complete: uint8 &convert=Complete($$);
};

type DeliveryFlag = enum {
    Heartbeat = 1,
    XdpFailover = 10,
    OriginalMessage = 11,
    SequenceNumberResetMessage = 12,
    OneRetransmissionPacket = 13,
    RetransmissionSequenceMessage = 15,
    OneRefreshPacket = 17,
    RefreshSequenceStart = 18,
    RefreshSequenceMessage = 19,
    RefreshSequenceEnd = 20,
    MessageUnavailable = 21,
};

type MessageType = enum {
    SequenceNumberResetMessage = 1,
    SymbolIndexMappingMessage = 3,
    RetransmissionRequestMessage = 10,
    RequestResponseMessage = 11,
    HeartbeatResponseMessage = 12,
    SymbolIndexMappingRequestMessage = 13,
    RefreshRequestMessage = 15,
    MessageUnavailableMessage = 31,
    ConsolidatedSymbolClearMessage = 32,
    ConsolidatedTradingSessionChangeMessage = 33,
    ConsolidatedSecurityStatusMessage = 34,
    RefreshHeaderMessage = 35,
    BqtMessage = 142,
    ConsolidatedSingleSidedQuoteMessage = 143,
    ConsolidatedTradeMessage = 220,
    ConsolidatedTradeCancelMessage = 221,
    ConsolidatedTradeCorrectionMessage = 222,
    ConsolidatedStockSummaryMessage = 229,
    ConsolidatedVolumeMessage = 240,
};

