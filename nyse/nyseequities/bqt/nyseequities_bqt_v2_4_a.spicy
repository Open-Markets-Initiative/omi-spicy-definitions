type ConsolidatedTradeCorrectionMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_number: uint32;
    original_trade_id: uint32;
    trade_id: uint32;
    price: int32;
    volume: uint32;
    trade_condition_1: uint8 &convert=TradeCondition1($$);
    trade_condition_2: uint8 &convert=TradeCondition2($$);
    trade_condition_3: uint8 &convert=TradeCondition3($$);
