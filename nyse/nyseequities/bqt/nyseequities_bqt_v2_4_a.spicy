type TrfFractionalTradeCorrectionMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    original_trade_id: uint32;
    trade_id: uint32;
    price: int32;
