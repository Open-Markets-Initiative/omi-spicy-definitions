    NyseArcaOptions = 4,
    NyseBonds = 5,
    NyseAmericanOptions = 8,
    NyseAmerican = 9,
    NyseNational = 10,
    NyseTexas = 11,
    NyseGroupBqt = 0,
    NyseTrf = 255,
};

type ExchangeCode = enum {
    NyseAmerican = 0x41,
    Ltse = 0x4c,
    NyseTexas = 0x4d,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    Iex = 0x56,
    Cboe = 0x5a,
};

type SecurityType = enum {
    Adr = 0x41,
    CommonStock = 0x43,
