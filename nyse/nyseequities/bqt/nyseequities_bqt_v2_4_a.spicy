module NyseNyseequitiesBqtXdpV24A;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type NyseequitiesBqtV24A = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    packet_size: uint16;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    message_count: uint8;
    sequence_number: uint32;
    timestamp: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        MessageType::SourceTimeReferenceMessage -> source_time_reference_message: SourceTimeReferenceMessage;
        MessageType::SymbolIndexMappingMessage -> symbol_index_mapping_message: SymbolIndexMappingMessage;
        MessageType::SymbolClearMessage -> symbol_clear_message: SymbolClearMessage;
        MessageType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MessageType::RetransmissionRequestMessage -> retransmission_request_message: RetransmissionRequestMessage;
        MessageType::SymbolIndexMappingRequestMessage -> symbol_index_mapping_request_message: SymbolIndexMappingRequestMessage;
        MessageType::RefreshRequestMessage -> refresh_request_message: RefreshRequestMessage;
        MessageType::MessageUnavailableMessage -> message_unavailable_message: MessageUnavailableMessage;
        MessageType::RefreshHeaderMessage -> refresh_header_message: RefreshHeaderMessage;
        MessageType::RequestResponseMessage -> request_response_message: RequestResponseMessage;
        MessageType::HeartbeatResponseMessage -> heartbeat_response_message: HeartbeatResponseMessage;
        MessageType::BestQuotesMessage -> best_quotes_message: BestQuotesMessage;
        MessageType::ConsolidatedSingleSidedQuoteMessage -> consolidated_single_sided_quote_message: ConsolidatedSingleSidedQuoteMessage;
        MessageType::TrfFractionalTradeMessage -> trf_fractional_trade_message: TrfFractionalTradeMessage;
        MessageType::ConsolidatedTradeMessage -> consolidated_trade_message: ConsolidatedTradeMessage;
        MessageType::ConsolidatedTradeCancelMessage -> consolidated_trade_cancel_message: ConsolidatedTradeCancelMessage;
        MessageType::TrfFractionalTradeCorrectionMessage -> trf_fractional_trade_correction_message: TrfFractionalTradeCorrectionMessage;
        MessageType::ConsolidatedTradeCorrectionMessage -> consolidated_trade_correction_message: ConsolidatedTradeCorrectionMessage;
        MessageType::TrfFractionalPriorDayTradeMessage -> trf_fractional_prior_day_trade_message: TrfFractionalPriorDayTradeMessage;
        MessageType::TrfFractionalPriorDayTradeCancelMessage -> trf_fractional_prior_day_trade_cancel_message: TrfFractionalPriorDayTradeCancelMessage;
        MessageType::ConsolidatedFractionalStockSummaryMessage -> consolidated_fractional_stock_summary_message: ConsolidatedFractionalStockSummaryMessage;
        MessageType::ConsolidatedFractionalVolumeMessage -> consolidated_fractional_volume_message: ConsolidatedFractionalVolumeMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint16 &convert=MessageType($$);
};

type SequenceNumberResetMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type SourceTimeReferenceMessage = unit {
    id: uint32;
    symbol_seq_num: uint32;
    source_time: uint32;
};

type SymbolIndexMappingMessage = unit {
    symbol_index: uint32;
    symbol: bytes &size=11;
    reserved_1: uint8;
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    exchange_code: uint8 &convert=ExchangeCode($$);
    price_scale_code: uint8;
    security_type: uint8 &convert=SecurityType($$);
    lot_size: uint16;
    prev_close_price: uint32;
    prev_close_volume: uint32;
    price_resolution: uint8 &convert=PriceResolution($$);
    round_lot: uint8 &convert=RoundLot($$);
    mpv: uint16;
    unit_of_trade: uint16;
    reserved_2: uint16;
};

type SymbolClearMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    next_source_seq_num: uint32;
    market_id: uint16 &convert=MarketId($$);
};

type SecurityStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: uint8 &convert=HaltCondition($$);
    market_id: uint16 &convert=MarketId($$);
    reserved_2: uint16;
    price_1: uint32;
    price_2: uint32;
    ssr_triggering_exchange_id: uint8 &convert=SsrTriggeringExchangeId($$);
    ssr_triggering_volume: uint32;
    time_field: uint32;
    ssr_state: uint8 &convert=SsrState($$);
    market_state: uint8 &convert=MarketState($$);
    session_state: bytes &size=1;
};

type RetransmissionRequestMessage = unit {
    begin_seq_num: uint32;
    end_seq_num: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
};

type SymbolIndexMappingRequestMessage = unit {
    symbol_index: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
    retransmit_method: uint8;
};

type RefreshRequestMessage = unit {
    symbol_index: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
};

type MessageUnavailableMessage = unit {
    begin_seq_num: uint32;
    end_seq_num: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type RefreshHeaderMessage = unit {
    current_refresh_pkt: uint16;
    total_refresh_pkts: uint16;
    last_seq_num: uint32;
    last_symbol_seq_num: uint32;
};

type RequestResponseMessage = unit {
    request_seq_num: uint32;
    begin_seq_num: uint32;
    end_seq_num: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
    status: uint8 &convert=Status($$);
};

type HeartbeatResponseMessage = unit {
    source_id: bytes &size=10;
};

type BestQuotesMessage = unit {
    symbol_index: uint32;
    symbol_seq_number: uint32;
    ask_price: int32;
    ask_volume: uint32;
    bid_price: int32;
    bid_volume: uint32;
    ask_quote_condition: uint8 &convert=AskQuoteCondition($$);
    bid_quote_condition: uint8 &convert=BidQuoteCondition($$);
    retail_pricing_indicator: RetailPricingIndicator;
    market_id_of_best_ask: uint16;
    market_id_of_best_bid: uint16;
};

type RetailPricingIndicator = unit {
    retail_interest_on_the_bid_side: bytes &size=1;
    retail_interest_on_the_ask_side: bytes &size=1;
    reserved: bytes &size=1;
};

type ConsolidatedSingleSidedQuoteMessage = unit {
    symbol_index: uint32;
    symbol_seq_number: uint32;
    side: uint8 &convert=Side($$);
    price: int32;
    volume: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    retail_pricing_indicator: RetailPricingIndicator;
    market_id: uint16 &convert=MarketId($$);
};

type TrfFractionalTradeMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    trade_id: uint32;
    price: int32;
    fractional_volume: uint64;
    trade_cond_1: uint8 &convert=TradeCond1($$);
    trade_cond_2: uint8 &convert=TradeCond2($$);
    trade_cond_3: uint8 &convert=TradeCond3($$);
    trade_cond_4: uint8 &convert=TradeCond4($$);
    exec_day_time: uint32;
    exec_day_time_ns: uint32;
    market_id: uint16 &convert=MarketId($$);
};

type ConsolidatedTradeMessage = unit {
    source_time: uint32;
