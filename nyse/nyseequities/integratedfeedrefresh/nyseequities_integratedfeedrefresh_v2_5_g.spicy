module NyseNyseequitiesIntegratedfeedrefreshPillarV25G;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type NyseequitiesIntegratedfeedrefreshV25G = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.number_msgs];
};

type PacketHeader = unit {
    pkt_size: uint16;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    number_msgs: uint8;
    seq_num: uint32;
    send_time: SendTime;
};

type SendTime = unit {
    seconds: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        MessageType::SourceTimeReferenceMessage -> source_time_reference_message: SourceTimeReferenceMessage;
        MessageType::SymbolIndexMappingMessage -> symbol_index_mapping_message: SymbolIndexMappingMessage;
        MessageType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MessageType::RefreshHeaderMessage -> refresh_header_message: RefreshHeaderMessage;
        MessageType::ImbalanceMessage -> imbalance_message: ImbalanceMessage;
        MessageType::AddOrderRefreshMessage -> add_order_refresh_message: AddOrderRefreshMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint16 &convert=MessageType($$);
};

type SequenceNumberResetMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type SourceTimeReferenceMessage = unit {
    id: uint32;
    symbol_seq_num: uint32;
    source_time: uint32;
};

type SymbolIndexMappingMessage = unit {
    symbol_index: uint32;
    symbol: bytes &size=11;
    : skip bytes &size=1;   # padding
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    exchange_code: uint8 &convert=ExchangeCode($$);
    price_scale_code: uint8;
    security_type: uint8 &convert=SecurityType($$);
    lot_size: uint16;
    prev_close_price: uint32;
    prev_close_volume: uint32;
    price_resolution: uint8;
    round_lot: uint8 &convert=RoundLot($$);
    mpv: uint16;
    unit_of_trade: uint16;
    late_close_eligible: uint8 &convert=LateCloseEligible($$);
    eth_eligible: uint8 &convert=EthEligible($$);
};

type SecurityStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: uint8 &convert=HaltCondition($$);
    : skip bytes &size=4;   # padding
    price_1: uint32;
    price_2: uint32;
    ssr_triggering_exchange_id: uint8 &convert=SsrTriggeringExchangeId($$);
    ssr_triggering_volume: uint32;
    time_field: uint32;
    ssr_state: uint8 &convert=SsrState($$);
    market_state: uint8 &convert=MarketState($$);
    session_state: bytes &size=1;
};

type RefreshHeaderMessage = unit {
    current_refresh_pkt: uint16;
    total_refresh_pkts: uint16;
    last_seq_num: uint32;
    last_symbol_seq_num: uint32;
};

type ImbalanceMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    reference_price: int32;
    paired_qty: uint32;
    total_imbalance_qty: uint32;
    market_imbalance_qty: uint32;
    auction_time: uint16;
    auction_type: uint8 &convert=AuctionType($$);
    imbalance_side: uint8 &convert=ImbalanceSide($$);
    continuous_book_clearing_price: int32;
    auction_interest_clearing_price: int32;
    ssr_filing_price: int32;
    indicative_match_price: int32;
    upper_collar: int32;
    lower_collar: int32;
    auction_status: uint8 &convert=AuctionStatus($$);
    freeze_status: uint8 &convert=FreezeStatus($$);
    num_extensions: uint8;
    unpaired_qty: uint32;
    unpaired_side: uint8 &convert=UnpairedSide($$);
    : skip bytes &size=1;   # padding
};

type AddOrderRefreshMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    order_id: uint64;
    price: int32;
    volume: uint32;
    side: uint8 &convert=Side($$);
    firm_id: bytes &size=5;
    : skip bytes &size=1;   # padding
};

type DeliveryFlag = enum {
    Heartbeat = 1,
    PillarFailover = 10,
    OriginalMessage = 11,
    SequenceNumberResetMessage = 12,
    OneRetransmissionPacket = 13,
    RetransmissionSequenceMessage = 15,
    OneRefreshPacket = 17,
    RefreshSequenceStart = 18,
    RefreshSequenceMessage = 19,
    RefreshSequenceEnd = 20,
    MessageUnavailable = 21,
};

type MessageType = enum {
    SequenceNumberResetMessage = 1,
    SourceTimeReferenceMessage = 2,
    SymbolIndexMappingMessage = 3,
    SecurityStatusMessage = 34,
    RefreshHeaderMessage = 35,
    ImbalanceMessage = 105,
    AddOrderRefreshMessage = 106,
};

type MarketId = enum {
    NyseEquities = 1,
    NyseArcaEquities = 3,
    NyseAmericanEquities = 9,
    NyseNationalEquities = 10,
    NyseTexasEquities = 11,
};

type ExchangeCode = enum {
    Txse = 0x46,
    NyseAmerican = 0x41,
    Ltse = 0x4c,
    NyseTexas = 0x4d,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    Iex = 0x56,
    Cboe = 0x5a,
};

type SecurityType = enum {
    Adr = 0x41,
    CommonStock = 0x43,
    Debentures = 0x44,
    Etf = 0x45,
    Foreign = 0x46,
    UsDepositaryShares = 0x48,
    Units = 0x49,
    IndexLinkedNotes = 0x4c,
    MiscliquidTrust = 0x4d,
    OrdinaryShares = 0x4f,
    PreferredStock = 0x50,
    Rights = 0x52,
    SharesOfBeneficiaryInterest = 0x53,
    Test = 0x54,
    ClosedEndFund = 0x55,
    Warrant = 0x57,
};

type RoundLot = enum {
    Yes = 0x59,
    No = 0x4e,
};

type LateCloseEligible = enum {
    NotEligible = 0,
    Eligible = 1,
};

type EthEligible = enum {
    NotEligible = 0,
    Eligible = 1,
};

type SecurityStatus = enum {
    TradingHalt = 0x34,
    Resume = 0x35,
    SuspendOperationalHalt = 0x36,
    ShortSaleRestrictionActivatedDay1 = 0x41,
    ShortSaleRestrictionContinuedDay2 = 0x43,
    ShortSaleRestrictionDeactivated = 0x44,
    Preopening = 0x50,
    BeginAcceptingOrders = 0x42,
    EarlySession = 0x45,
    CoreSession = 0x4f,
    LateSessionNonNyseOnly = 0x4c,
    Closed = 0x58,
    HaltResumePriceIndication = 0x49,
    PreOpeningPriceIndication = 0x47,
};

type HaltCondition = enum {
    SecurityNotDelayedhalted = 0x7e,
    NewsReleasedNewsDissemination = 0x44,
    OrderImbalance = 0x49,
    NewsPending = 0x50,
    LuldPause = 0x4d,
    EquipmentChangeover = 0x58,
    SipOutageMaterialSipLatencyOrExtraordinaryMarketActivity = 0x41,
    RegulatoryConcern = 0x43,
    MergerEffective = 0x45,
    EtfIivEtfComponentPricesNotAvailable = 0x46,
    CorporateAction = 0x4e,
    NewSecurityOffering = 0x4f,
    PrimaryListingExchangeDiscretionaryHalt = 0x56,
    SuspendOperationalHalt = 0x36,
    MarketWideCircuitBreakerHaltLevel1 = 0x31,
    MarketWideCircuitBreakerHaltLevel2 = 0x32,
    MarketWideCircuitBreakerHaltLevel3 = 0x33,
};

type SsrTriggeringExchangeId = enum {
    NyseAmerican = 0x41,
    NasdaqOmsTx = 0x42,
    NyseNational = 0x43,
    Finra = 0x44,
    N24X = 0x47,
    MiamiPeral = 0x48,
    NasdaqIse = 0x49,
    CboeEdga = 0x4a,
    CboeEdgx = 0x4b,
    Ltse = 0x4c,
    NyseTexas = 0x4d,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    NasdaqOmx = 0x54,
    Memx = 0x55,
    Iex = 0x56,
    Cbsx = 0x57,
    NasdaqOmxPsx = 0x58,
    CboeByx = 0x59,
    CboeBzx = 0x5a,
};

type SsrState = enum {
    NoShortSaleRestrictionInEffect = 0x7e,
    ShortSaleRestrictionInEffect = 0x45,
};

type MarketState = enum {
    Preopening = 0x50,
    EarlySession = 0x45,
    CoreSession = 0x4f,
    LateSessionNonNyseOnly = 0x4c,
    Closed = 0x58,
};

type AuctionType = enum {
    EarlyOpeningAuction = 0x4f,
    CoreOpeningAuction = 0x4d,
    ReopeningAuctionHaltResume = 0x48,
    ClosingAuction = 0x43,
    ExtremeClosingImbalance = 0x50,
    SignificantClosingImbalance = 0x52,
};

type ImbalanceSide = enum {
    BuySide = 0x42,
    SellSide = 0x53,
    NoImbalance = 0x20,
};

type AuctionStatus = enum {
    WillRunAsAlwaysForOpenAndClose = 0,
    WillRunInterestExistsInsideOrAtTheCollarsOrIsFullyPairedOff = 1,
    WillNotRunBecauseThereIsAnImbalanceThroughTheCollars = 2,
    WillNotRunWillTransitionToTheClosingAuctionInstead = 3,
};

type FreezeStatus = enum {
    ImbalanceFreezeNotInEffect = 0,
    ImbalanceFreezeIsInEffect = 1,
};

type UnpairedSide = enum {
    BuySide = 0x42,
    SellSide = 0x53,
    NotApplicable = 0x20,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

