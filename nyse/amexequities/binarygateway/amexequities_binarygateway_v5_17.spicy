module NyseAmexequitiesBinarygatewayPillarstreamV517;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AmexequitiesBinarygatewayV517 = unit {
    login_message: LoginMessage;
    login_response: LoginResponse;
    stream_avail: StreamAvail;
    heartbeat: Heartbeat;
    open: Open;
    open_response: OpenResponse;
    close: Close;
    close_response: CloseResponse;
    seq_msg: SeqMsg;
};

type LoginMessage = unit {
    msg_header: MsgHeader;
    username: bytes &size=16;
    password: bytes &size=32;
    mic: bytes &size=4;
    version: bytes &size=20;
};

type MsgHeader = unit {
    msg_type: uint16 &convert=MsgType($$);
    msg_length: uint16;
};

type LoginResponse = unit {
    msg_header: MsgHeader;
    username: bytes &size=16;
    status: uint8 &convert=Status($$);
};

type StreamAvail = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    next_seq: uint64;
    access: uint8;
};

type StreamId = unit {
    sess: uint32;
    value: uint32;
};

type Heartbeat = unit {
    msg_header: MsgHeader;
};

type Open = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    start_seq: uint64;
    end_seq: uint64;
    access: uint8;
    mode: uint8;
};

type OpenResponse = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    status: uint8 &convert=Status($$);
    access: uint8;
};

type Close = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
};

type CloseResponse = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    status: uint8 &convert=Status($$);
};

type SeqMsg = unit {
    msg_header: MsgHeader;
    seq_msg_id: SeqMsgId;
    : skip bytes &size=4;   # padding
    timestamp: uint64;
    seq_msg_header: SeqMsgHeader;
    switch ( self.seq_msg_header.seq_msg_type ) {
        SeqMsgType::SessionConfigurationRequestMessage -> session_configuration_request_message: SessionConfigurationRequestMessage;
        SeqMsgType::NewOrderSingleAndCancelReplaceRequestMessage -> new_order_single_and_cancel_replace_request_message: NewOrderSingleAndCancelReplaceRequestMessage;
        SeqMsgType::OrderCancelRequestMessage -> order_cancel_request_message: OrderCancelRequestMessage;
        SeqMsgType::OrderModifyRequestMessage -> order_modify_request_message: OrderModifyRequestMessage;
        SeqMsgType::BulkCancelRequestMessage -> bulk_cancel_request_message: BulkCancelRequestMessage;
        SeqMsgType::SymbolSubscriptionRequestMessage -> symbol_subscription_request_message: SymbolSubscriptionRequestMessage;
        SeqMsgType::ManualActionResponseMessage -> manual_action_response_message: ManualActionResponseMessage;
        SeqMsgType::RiskLimitUpdateRequestMessage -> risk_limit_update_request_message: RiskLimitUpdateRequestMessage;
        SeqMsgType::RiskActionRequestMessage -> risk_action_request_message: RiskActionRequestMessage;
        SeqMsgType::EquitiesSymbolReferenceDataMessage -> equities_symbol_reference_data_message: EquitiesSymbolReferenceDataMessage;
        SeqMsgType::DmmSymbolReferenceDataMessage -> dmm_symbol_reference_data_message: DmmSymbolReferenceDataMessage;
        SeqMsgType::MinimumPriceVariantClassReferenceDataMessage -> minimum_price_variant_class_reference_data_message: MinimumPriceVariantClassReferenceDataMessage;
        SeqMsgType::MinimumPriceVariantLevelReferenceDataMessage -> minimum_price_variant_level_reference_data_message: MinimumPriceVariantLevelReferenceDataMessage;
        SeqMsgType::MpidConfigurationMessage -> mpid_configuration_message: MpidConfigurationMessage;
        SeqMsgType::MmidConfigurationMessage -> mmid_configuration_message: MmidConfigurationMessage;
        SeqMsgType::SessionConfigurationAcknowledgementMessage -> session_configuration_acknowledgement_message: SessionConfigurationAcknowledgementMessage;
        SeqMsgType::OrderAndCancelReplaceAcknowledgementMessage -> order_and_cancel_replace_acknowledgement_message: OrderAndCancelReplaceAcknowledgementMessage;
        SeqMsgType::OrderModifyCancelRequestAcknowledgmentAndUroutMessage -> order_modify_cancel_request_acknowledgment_and_urout_message: OrderModifyCancelRequestAcknowledgmentAndUroutMessage;
        SeqMsgType::OrderPriorityUpdateAcknowledgmentMessage -> order_priority_update_acknowledgment_message: OrderPriorityUpdateAcknowledgmentMessage;
        SeqMsgType::ExecutionReportMessage -> execution_report_message: ExecutionReportMessage;
        SeqMsgType::TradeBustCorrectMessage -> trade_bust_correct_message: TradeBustCorrectMessage;
        SeqMsgType::ApplicationLayerRejectMessage -> application_layer_reject_message: ApplicationLayerRejectMessage;
        SeqMsgType::SymbolSubscriptionAcknowledgementMessage -> symbol_subscription_acknowledgement_message: SymbolSubscriptionAcknowledgementMessage;
        SeqMsgType::GtBeginMessage -> gt_begin_message: GtBeginMessage;
        SeqMsgType::GtEndMessage -> gt_end_message: GtEndMessage;
        SeqMsgType::AuctionPriceDataMessage -> auction_price_data_message: AuctionPriceDataMessage;
        SeqMsgType::AuctionRequestMessage -> auction_request_message: AuctionRequestMessage;
        SeqMsgType::ManualActionRequestMessage -> manual_action_request_message: ManualActionRequestMessage;
        SeqMsgType::RiskControlAcknowledgementMessage -> risk_control_acknowledgement_message: RiskControlAcknowledgementMessage;
        SeqMsgType::RiskControlAlertMessage -> risk_control_alert_message: RiskControlAlertMessage;
        * -> unknown: bytes &eod;
    };
};

type SeqMsgId = unit {
    stream_id: StreamId;
    seq: uint64;
};

type SeqMsgHeader = unit {
    seq_msg_type: uint16 &convert=SeqMsgType($$);
    seq_msg_length: uint16;
};

type SessionConfigurationRequestMessage = unit {
    username: bytes &size=16;
    cancel_on_disconnect: uint8 &convert=CancelOnDisconnect($$);
    throttle_preference: uint8 &convert=ThrottlePreference($$);
    self_trade_prevention: uint8 &convert=SelfTradePrevention($$);
    order_priority_update_ack_subscription: uint8 &convert=OrderPriorityUpdateAckSubscription($$);
    bold_designation: uint8;
    : skip bytes &size=49;   # padding
};

type NewOrderSingleAndCancelReplaceRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    mmid: uint32;
    mpsubid_1: bytes &size=1;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    bitfield_order_instructions: BitfieldOrderInstructions;
    price: int64;
    order_qty: uint32;
    min_qty: uint32;
    user_data: bytes &size=8;
    optional_order_add_on: OptionalOrderAddOn;
    optional_routing_strategy_add_on: OptionalRoutingStrategyAddOn;
};

type BitfieldOrderInstructions = unit {
    : skip bytes &size=2;   # padding
    sub_id_indicator: uint8 &convert=SubIdIndicator($$);
    special_ord_type: uint8 &convert=SpecialOrdType($$);
    locate_reqd: uint8 &convert=LocateReqd($$);
    retail_indicator: uint8 &convert=RetailIndicator($$);
    attributed_quote: uint8 &convert=AttributedQuote($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    interest_type: uint8 &convert=InterestType($$);
    trading_session_id: uint8 &convert=TradingSessionId($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    proactive_if_locked: uint8 &convert=ProactiveIfLocked($$);
    self_trade_type: uint8 &convert=SelfTradeType($$);
    cancel_instead_of_reprice: uint8 &convert=CancelInsteadOfReprice($$);
    routing_inst: uint8 &convert=RoutingInst($$);
    extended_exec_inst: uint8 &convert=ExtendedExecInst($$);
    exec_inst: uint8 &convert=ExecInst($$);
    ord_type: uint8 &convert=OrdType($$);
    side_bits: uint8;
};

type OptionalOrderAddOn = unit {
    sub_msg_header: SubMsgHeader;
    stop_px: int64;
    deliver_to_comp_id: bytes &size=5;
    max_floor: uint32;
    locate_broker: bytes &size=4;
    : skip bytes &size=8;   # padding
    offset_price: int64;
    effective_time: uint64;
};

type SubMsgHeader = unit {
    sub_msg_type: uint16;
    sub_msg_length: uint16;
};

type OptionalRoutingStrategyAddOn = unit {
    sub_msg_header: SubMsgHeader;
    routing_strategy: uint8 &convert=RoutingStrategy($$);
    : skip bytes &size=27;   # padding
};

type OrderCancelRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
};

type OrderModifyRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    order_qty: uint32;
    side: uint8 &convert=Side($$);
    locate_reqd_u_81: uint8;
};

type BulkCancelRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    mmid: uint32;
    cl_ord_id: uint64;
    deliver_to_comp_id: bytes &size=5;
    bulk_cancel_type: uint8 &convert=BulkCancelType($$);
    side: uint8 &convert=Side($$);
};

type SymbolSubscriptionRequestMessage = unit {
    symbol_id: uint32;
    username: bytes &size=16;
};

type ManualActionResponseMessage = unit {
    symbol_id: uint32;
    cl_ord_id: uint64;
    manual_action_id: ManualActionId;
    sell_indicator: uint8;
    intraday_sell_short_qty: uint32;
    mpsubid_1: bytes &size=1;
    locate_reqd_u_81: uint8;
    self_trade_type_bits: uint8;
    user_data: bytes &size=8;
    manual_response_type: uint8 &convert=ManualResponseType($$);
    dmm_reject_reason: bytes &size=20;
};

type ManualActionId = unit {
    stream_id: StreamId;
    seq: uint64;
};

type RiskLimitUpdateRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    market_maker_nul: bytes &size=10;
    mpsubid_4: bytes &size=4;
    : skip bytes &size=4;   # padding
    clearing_number: bytes &size=5;
    cl_ord_id: uint64;
    risk_user_crd: uint32;
    risk_user_type: uint8 &convert=RiskUserType($$);
    risk_control_type: uint8 &convert=RiskControlType($$);
    risk_control_activation: uint8 &convert=RiskControlActivation($$);
    usd_limit: int64;
    time_limit: int32;
    percentage_limit: int32;
    count_limit: int32;
    breach_action_request: uint8 &convert=BreachActionRequest($$);
    ioc_attribution: uint8 &convert=IocAttribution($$);
    risk_range_id: uint8;
    risk_minimum_value: int64;
    price_scale: uint8 &convert=PriceScale($$);
    : skip bytes &size=190;   # padding
};

type RiskActionRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    market_maker_nul: bytes &size=10;
    mpsubid_4: bytes &size=4;
    : skip bytes &size=4;   # padding
    clearing_number: bytes &size=5;
    cl_ord_id: uint64;
    risk_user_crd: uint32;
    risk_user_type: uint8 &convert=RiskUserType($$);
    risk_control_type: uint8 &convert=RiskControlType($$);
    risk_action_type: uint8 &convert=RiskActionType($$);
    risk_range_id: uint8;
    : skip bytes &size=199;   # padding
};

type EquitiesSymbolReferenceDataMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    nyse_symbol: bytes &size=24;
    listed_mic: bytes &size=4;
    round_lot_size: uint8;
    adv_risk_range_id: uint8;
    : skip bytes &size=7;   # padding
    mpv_class_id: uint16;
    test_symbol_indicator: uint8 &convert=TestSymbolIndicator($$);
};

type DmmSymbolReferenceDataMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    nyse_symbol: bytes &size=24;
    book: bytes &size=8;
    mpid: bytes &size=4;
    dmm_unit_num: bytes &size=3;
    post: bytes &size=2;
    median_volume: uint64;
    rd_seq: uint64;
    ridge_price: int64;
    ppp_1: int64;
    ppp_2: int64;
    ppp_3: int64;
    open_on_trade_max_qty: uint64;
    close_on_trade_max_qty: uint64;
    lmocp: int64;
};

type MinimumPriceVariantClassReferenceDataMessage = unit {
    transact_time: uint64;
    mpv_class_name: bytes &size=20;
    mpv_class_id: uint16;
    rpimpv: int64;
    luldmpv: int64;
};

type MinimumPriceVariantLevelReferenceDataMessage = unit {
    transact_time: uint64;
    mpv_level_definition: MpvLevelDefinition[] &eod;
};

type MpvLevelDefinition = unit {
    mpv_level_name: bytes &size=24;
    price: int64;
    quoting_mpv: int64;
    trading_mpv: int64;
    mpv_class_id: uint16;
};

type MpidConfigurationMessage = unit {
    transact_time: uint64;
    mpid_status: uint8 &convert=MpidStatus($$);
    mpid: bytes &size=4;
    username: bytes &size=16;
    : skip bytes &size=50;   # padding
};

type MmidConfigurationMessage = unit {
    transact_time: uint64;
    market_maker: bytes &size=10;
    mmid: uint32;
    username: bytes &size=16;
    : skip bytes &size=100;   # padding
};

type SessionConfigurationAcknowledgementMessage = unit {
    transact_time: uint64;
    user_session_type: uint8 &convert=UserSessionType($$);
    user_session_status: uint8 &convert=UserSessionStatus($$);
    username: bytes &size=16;
    mic: bytes &size=4;
    cancel_on_disconnect: uint8 &convert=CancelOnDisconnect($$);
    throttle_preference: uint8 &convert=ThrottlePreference($$);
    throttle_window: uint16;
    throttle_threshold: uint16;
    symbol_eligibility: uint8 &convert=SymbolEligibility($$);
    max_order_quantity: uint32;
    self_trade_prevention: uint8 &convert=SelfTradePrevention($$);
    order_priority_update_ack_subscription: uint8 &convert=OrderPriorityUpdateAckSubscription($$);
    ack_status: uint8 &convert=AckStatus($$);
    bold_designation: uint8;
    : skip bytes &size=49;   # padding
};

type OrderAndCancelReplaceAcknowledgementMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    mpid: bytes &size=4;
    mmid: uint32;
    mpsubid_1: bytes &size=1;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    bitfield_order_instructions: BitfieldOrderInstructions;
    price: int64;
    order_qty: uint32;
    min_qty: uint32;
    order_id: uint64;
    leaves_qty: uint32;
    working_price: int64;
    working_away_from_display: uint8 &convert=WorkingAwayFromDisplay($$);
    pre_liquidity_indicator: bytes &size=4;
    reason_code: uint16 &convert=ReasonCode($$);
    ack_type: uint8 &convert=AckType($$);
    bitfield_flow_indicator: BitfieldFlowIndicator;
    user_data: bytes &size=8;
    optional_order_add_on: OptionalOrderAddOn;
};

type BitfieldFlowIndicator = unit {
    throttled: uint8 &convert=Throttled($$);
    : skip bytes &size=1;   # padding
};

type OrderModifyCancelRequestAcknowledgmentAndUroutMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    mpid: bytes &size=4;
    order_id: uint64;
    ref_cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    price: int64;
    order_qty: uint32;
    leaves_qty: uint32;
    side: uint8 &convert=Side($$);
    locate_reqd_u_81: uint8;
    reason_code: uint16 &convert=ReasonCode($$);
    ack_type: uint8 &convert=AckType($$);
    bitfield_flow_indicator: BitfieldFlowIndicator;
    user_data: bytes &size=8;
};

type OrderPriorityUpdateAcknowledgmentMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    mpid: bytes &size=4;
    order_id: uint64;
    cl_ord_id: uint64;
    working_price: int64;
    order_qty: uint32;
    working_away_from_display: uint8 &convert=WorkingAwayFromDisplay($$);
    pre_liquidity_indicator: bytes &size=4;
    ack_type: uint8 &convert=AckType($$);
    user_data: bytes &size=8;
};

type ExecutionReportMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    mpid: bytes &size=4;
    order_id: uint64;
    cl_ord_id: uint64;
    deal_id: uint64;
    last_px: int64;
    leaves_qty: uint32;
    cum_qty: uint32;
    last_qty: uint32;
    liquidity_indicator: bytes &size=4;
    displayed_liquidity_indicator: bytes &size=4;
    locate_reqd_u_81: uint8;
    participant_type: uint8 &convert=ParticipantType($$);
    reason_code: uint16 &convert=ReasonCode($$);
    user_data: bytes &size=8;
    optional_order_add_on: OptionalOrderAddOn;
    optional_routing_strategy_add_on: OptionalRoutingStrategyAddOn;
};

type TradeBustCorrectMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    mpid: bytes &size=4;
    order_id: uint64;
    cl_ord_id: uint64;
    ref_seq_msg_id: RefSeqMsgId;
    deal_id: uint64;
    last_px: int64;
    last_qty: uint32;
    reason_code: uint16 &convert=ReasonCode($$);
    user_data: bytes &size=8;
};

type RefSeqMsgId = unit {
    stream_id: StreamId;
    seq: uint64;
};

type ApplicationLayerRejectMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    mpid: bytes &size=4;
    cl_ord_id: uint64;
    reason_code: uint16 &convert=ReasonCode($$);
    reject_type: uint8 &convert=RejectType($$);
    user_data: bytes &size=8;
    : skip bytes &size=4;   # padding
};

type SymbolSubscriptionAcknowledgementMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    username: bytes &size=16;
    subscription_status: uint8 &convert=SubscriptionStatus($$);
};

type GtBeginMessage = unit {
    transact_time: uint64;
};

type GtEndMessage = unit {
    transact_time: uint64;
};

type AuctionPriceDataMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    imbalance_side: uint8 &convert=ImbalanceSide($$);
    side_of_unpaired_qty: uint8 &convert=SideOfUnpairedQty($$);
    imbalance_volume: uint32;
    price: int64;
    paired_qty: uint32;
    unpaired_qty: uint32;
    buy_dmm_available_qty: uint32;
    sell_dmm_available_qty: uint32;
};

type AuctionRequestMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    auction_type: uint8 &convert=AuctionType($$);
    ssr_filing_price: int64;
};

type ManualActionRequestMessage = unit {
    transact_time: uint64;
    symbol_id: uint32;
    introducing_badge_id: bytes &size=4;
    mpid: bytes &size=4;
    mmid: uint32;
    manual_action_id: ManualActionId;
    side: uint8 &convert=Side($$);
    price: int64;
    dmm_requested_qty: uint32;
    dmm_available_qty: uint32;
    dmm_allocated_qty: uint32;
    ssr_filing_price: int64;
    manual_override: uint8 &convert=ManualOverride($$);
    manual_override_reason: bytes &size=20;
    manual_action_type: uint8 &convert=ManualActionType($$);
};

type RiskControlAcknowledgementMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    market_maker_nul: bytes &size=10;
    mpsubid_4: bytes &size=4;
    : skip bytes &size=4;   # padding
    clearing_number: bytes &size=5;
    cl_ord_id: uint64;
    risk_ack_type: uint8 &convert=RiskAckType($$);
    risk_user_crd: uint32;
    risk_user_type: uint8 &convert=RiskUserType($$);
    risk_control_type: uint8 &convert=RiskControlType($$);
    risk_control_activation: uint8 &convert=RiskControlActivation($$);
    risk_action_type: uint8 &convert=RiskActionType($$);
    usd_limit: int64;
    time_limit: int32;
    percentage_limit: int32;
    count_limit: int32;
    breach_action_response: uint8 &convert=BreachActionResponse($$);
    ioc_attribution: uint8 &convert=IocAttribution($$);
    usd_calculation_1: int64;
    usd_calculation_2: int64;
    usd_calculation_3: int64;
    usd_calculation_4: int64;
    count_calculation: uint32;
    blocked_by_breach_indicator: uint8 &convert=BlockedByBreachIndicator($$);
    blocked_by_kill_switch_indicator: uint8 &convert=BlockedByKillSwitchIndicator($$);
    reinstatement_required_by_self: uint8 &convert=ReinstatementRequiredBySelf($$);
    reinstatement_required_by_other: uint8 &convert=ReinstatementRequiredByOther($$);
    risk_range_id: uint8;
    risk_minimum_value: int64;
    price_scale: uint8 &convert=PriceScale($$);
    : skip bytes &size=190;   # padding
};

type RiskControlAlertMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    market_maker_nul: bytes &size=10;
    mpsubid_4: bytes &size=4;
    clearing_number: bytes &size=5;
    risk_user_crd: uint32;
    risk_user_type: uint8 &convert=RiskUserType($$);
    risk_control_type: uint8 &convert=RiskControlType($$);
    usd_limit: int64;
    time_limit: int32;
    percentage_limit: int32;
    count_limit: int32;
    breach_action_response: uint8 &convert=BreachActionResponse($$);
    ioc_attribution: uint8 &convert=IocAttribution($$);
    usd_calculation_1: int64;
    usd_calculation_2: int64;
    usd_calculation_3: int64;
    usd_calculation_4: int64;
    count_calculation: uint32;
    risk_action_type: uint8 &convert=RiskActionType($$);
    threshold_breach_level: uint8 &convert=ThresholdBreachLevel($$);
    blocked_by_breach_indicator: uint8 &convert=BlockedByBreachIndicator($$);
    blocked_by_kill_switch_indicator: uint8 &convert=BlockedByKillSwitchIndicator($$);
    reinstatement_required_by_self: uint8 &convert=ReinstatementRequiredBySelf($$);
    reinstatement_required_by_other: uint8 &convert=ReinstatementRequiredByOther($$);
    : skip bytes &size=200;   # padding
};

type MsgType = enum {
    Login = 0x0201,
    LoginResponse = 0x0202,
    StreamAvail = 0x0203,
    Heartbeat = 0x0204,
    Open = 0x0205,
    OpenResponse = 0x0206,
    Close = 0x0207,
    CloseResponse = 0x0208,
    SeqMsg = 0x0905,
};

type Status = enum {
    RequestProcessedSuccessfully = 0,
    NotLoggedIn = 18,
    InvalidLoginDetails = 24,
    AlreadyLoggedIn = 27,
    HeartbeatTimeout = 28,
    LoginTimedOut = 29,
    InvalidMessage = 33,
    NoStreamPermission = 54,
    InvalidProtocolVersion = 81,
    MessageOutOfSequence = 82,
    InvalidStream = 84,
    StreamNotOpen = 85,
    InvalidTimestamp = 86,
    DenialOfService = 89,
    WritePermissionRevoked = 90,
    InvalidMultimessage = 93,
};

type SeqMsgType = enum {
    SessionConfigurationRequestMessage = 0x0220,
    SequencedFillerMessage = 0x0282,
    NewOrderSingleAndCancelReplaceRequestMessage = 0x0240,
    OrderCancelRequestMessage = 0x0280,
    OrderModifyRequestMessage = 0x0270,
    BulkCancelRequestMessage = 0x0281,
    SymbolSubscriptionRequestMessage = 0x0346,
    TgBeginMessage = 0x0343,
    TgEndMessage = 0x0344,
    ManualActionResponseMessage = 0x0354,
    RiskLimitUpdateRequestMessage = 0x0330,
    RiskActionRequestMessage = 0x0331,
    EquitiesSymbolReferenceDataMessage = 0x0232,
    DmmSymbolReferenceDataMessage = 0x0832,
    MinimumPriceVariantClassReferenceDataMessage = 0x0230,
    MinimumPriceVariantLevelReferenceDataMessage = 0x0231,
    MpidConfigurationMessage = 0x0272,
    MmidConfigurationMessage = 0x0273,
    SessionConfigurationAcknowledgementMessage = 0x0221,
    OrderAndCancelReplaceAcknowledgementMessage = 0x0260,
    OrderModifyCancelRequestAcknowledgmentAndUroutMessage = 0x0271,
    OrderPriorityUpdateAcknowledgmentMessage = 0x0262,
    ExecutionReportMessage = 0x0290,
    TradeBustCorrectMessage = 0x0292,
    ApplicationLayerRejectMessage = 0x0263,
    SymbolSubscriptionAcknowledgementMessage = 0x0347,
    GtBeginMessage = 0x0349,
    GtEndMessage = 0x0350,
    AuctionPriceDataMessage = 0x0352,
    AuctionRequestMessage = 0x0348,
    ManualActionRequestMessage = 0x0353,
    RiskControlAcknowledgementMessage = 0x0332,
    RiskControlAlertMessage = 0x0333,
};

type CancelOnDisconnect = enum {
