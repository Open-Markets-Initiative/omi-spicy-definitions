module NyseAmexequitiesOpenbookUltraV21K;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type AmexequitiesOpenbookV21K = unit {
    packet_header: PacketHeader;
    switch ( self.packet_header.message_type ) {
        MessageType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        MessageType::UnavailableMessage -> unavailable_message: UnavailableMessage;
        MessageType::RequestResponseMessage -> request_response_message: RequestResponseMessage;
        MessageType::RetransmissionRequestMessage -> retransmission_request_message: RetransmissionRequestMessage;
        MessageType::BookRefreshRequestMessage -> book_refresh_request_message: BookRefreshRequestMessage;
        MessageType::HeartbeatResponseMessage -> heartbeat_response_message: HeartbeatResponseMessage;
        MessageType::ExtendedBookRefreshRequestMessage -> extended_book_refresh_request_message: ExtendedBookRefreshRequestMessage;
        MessageType::SymbolIndexMappingRequestMessage -> symbol_index_mapping_request_message: SymbolIndexMappingRequestMessage;
        MessageType::SymbolIndexMappingResponseMessage -> symbol_index_mapping_response_message: SymbolIndexMappingResponseMessage;
        MessageType::FullUpdateMessage -> full_update_messages: FullUpdateMessages;
        MessageType::DeltaUpdateMessage -> delta_update_messages: DeltaUpdateMessages;
        * -> unknown: bytes &eod;
    };
};

type PacketHeader = unit {
    packet_size: uint16;
    message_type: uint16 &convert=MessageType($$);
    sequence_number: uint32;
    timestamp: uint32;
    product_id: uint8 &convert=ProductId($$);
    retransmission_flag: uint8 &convert=RetransmissionFlag($$);
    message_count: uint8;
    link_flag: uint8;
};

type SequenceNumberResetMessage = unit {
    next_seq_number: int32;
};

type UnavailableMessage = unit {
    begin_seq_num: int32;
    end_seq_num: int32;
};

type RequestResponseMessage = unit {
    source_seq_num: int32;
    source_id: bytes &size=20;
    status: uint8 &convert=Status($$);
    reject_reason: uint8 &convert=RejectReason($$);
    : skip bytes &size=2;   # padding
};

type RetransmissionRequestMessage = unit {
    begin_seq_num: int32;
    end_seq_num: int32;
    source_id: bytes &size=20;
};

type BookRefreshRequestMessage = unit {
    symbol_16: bytes &size=16;
    source_id: bytes &size=20;
};

type HeartbeatResponseMessage = unit {
    source_id: bytes &size=20;
};

type ExtendedBookRefreshRequestMessage = unit {
    source_id: bytes &size=20;
    symbol_index: int32;
    msg_type: int16;
};

type SymbolIndexMappingRequestMessage = unit {
    source_id: bytes &size=20;
    symbol_index: int32;
};

type SymbolIndexMappingResponseMessage = unit {
    symbol_11: bytes &size=11;
    : skip bytes &size=1;   # padding
    symbol_index: int32;
};

type FullUpdateMessages = unit {
    full_update_message: FullUpdateMessage[] &eod;
};

type FullUpdateMessage = unit {
    update_size: int16;
    full_update_message_body: FullUpdateMessageBody;
};

type FullUpdateMessageBody = unit {
    symbol_index: int32;
    source_time: int32;
    source_time_micro_secs: int16;
    symbol_seq_num: int32;
    source_session_id: int8;
    symbol_11: bytes &size=11;
    price_scale_code: int8;
    quote_condition: uint8 &convert=QuoteCondition($$);
    trading_status: uint8 &convert=TradingStatus($$);
    : skip bytes &size=1;   # padding
    mpv: int16;
    full_price_point: FullPricePoint[] &eod;
};

type FullPricePoint = unit {
    price_numerator: int32;
    volume: int32;
    num_orders: int16;
    side: uint8 &convert=Side($$);
    : skip bytes &size=1;   # padding
};

type DeltaUpdateMessages = unit {
    delta_update_message: DeltaUpdateMessage[] &eod;
};

type DeltaUpdateMessage = unit {
    delta_size: int16;
    delta_update_message_body: DeltaUpdateMessageBody;
};

type DeltaUpdateMessageBody = unit {
    symbol_index: int32;
    source_time: int32;
    source_time_micro_secs: int16;
    source_seq_num: int32;
    source_session_id: int8;
    quote_condition: uint8 &convert=QuoteCondition($$);
    trading_status: uint8 &convert=TradingStatus($$);
    price_scale_code: int8;
    delta_price_point: DeltaPricePoint[] &eod;
};

type DeltaPricePoint = unit {
    price_numerator: int32;
    volume: int32;
    chg_qty: int32;
    num_orders: int16;
    side: uint8 &convert=Side($$);
    reason_code: uint8 &convert=ReasonCode($$);
    link_id_1: int32;
    link_id_2: int32;
    link_id_3: int32;
};

type MessageType = enum {
    SequenceNumberResetMessage = 1,
    HeartbeatMessage = 2,
    UnavailableMessage = 5,
    RequestResponseMessage = 10,
    HeartbeatSubscriptionMessage = 19,
    RetransmissionRequestMessage = 20,
    BookRefreshRequestMessage = 22,
    HeartbeatResponseMessage = 24,
    ExtendedBookRefreshRequestMessage = 27,
    SymbolIndexMappingRequestMessage = 34,
    SymbolIndexMappingResponseMessage = 35,
    FullUpdateMessage = 230,
    DeltaUpdateMessage = 231,
};

type ProductId = enum {
    NyseOpenbookUltra = 12,
    NyseAmericanOpenbookUltra = 62,
};

type RetransmissionFlag = enum {
    OriginalPacket = 1,
    RetransmittedPacket = 2,
    RefreshPacket = 5,
    LastRefreshPacket = 6,
};

type Status = enum {
    Accepted = 0x41,
    Rejected = 0x52,
};

type RejectReason = enum {
    RequestAccepted = 0x30,
    RejectedDueToPermissions = 0x31,
    InvalidSequenceRangeEgLowHigh = 0x32,
    ExceededMaxSequenceRange1000 = 0x33,
    ExceededMaxRetransRequestsInADay = 0x34,
    ExceededMaxRefreshRequestsInADay = 0x35,
    RejectedRequestedSeqnum1000000PacketsInThePastUseRefreshToRecoverCurrentStateIfNecessary = 0x36,
};

type QuoteCondition = enum {
    NoSpecialQuoteCondition = 0x20,
    SlowQuote = 0x57,
};

type TradingStatus = enum {
    PreOpening = 0x50,
    BeginAcceptingOrders = 0x42,
    EarlySession = 0x45,
    CoreSession = 0x4f,
    LateSession = 0x4c,
    Closed = 0x58,
    Halted = 0x48,
    Suspended = 0x36,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type ReasonCode = enum {
    NewOrderadditionalInterestAdded = 0x4f,
    Cancel = 0x43,
    Execution = 0x45,
    MultipleEvents = 0x58,
};

