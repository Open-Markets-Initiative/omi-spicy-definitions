module NyseAmexequitiesIntegratedfeedXdpV21G;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AmexequitiesIntegratedfeedV21G = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    packet_size: uint16;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    message_count: uint8;
    sequence_number: uint32;
    timestamp: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        MessageType::SourceTimeReferenceMessage -> source_time_reference_message: SourceTimeReferenceMessage;
        MessageType::SymbolIndexMappingMessage -> symbol_index_mapping_message: SymbolIndexMappingMessage;
        MessageType::RetransmissionRequestMessage -> retransmission_request_message: RetransmissionRequestMessage;
        MessageType::RequestResponseMessage -> request_response_message: RequestResponseMessage;
        MessageType::HeartbeatResponseMessage -> heartbeat_response_message: HeartbeatResponseMessage;
        MessageType::SymbolIndexMappingRequestMessage -> symbol_index_mapping_request_message: SymbolIndexMappingRequestMessage;
        MessageType::RefreshRequestMessage -> refresh_request_message: RefreshRequestMessage;
        MessageType::MessageUnavailableMessage -> message_unavailable_message: MessageUnavailableMessage;
        MessageType::SymbolClearMessage -> symbol_clear_message: SymbolClearMessage;
        MessageType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MessageType::RefreshHeaderMessage -> refresh_header_message: RefreshHeaderMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::ModifyOrderMessage -> modify_order_message: ModifyOrderMessage;
        MessageType::ReplaceOrderMessage -> replace_order_message: ReplaceOrderMessage;
        MessageType::DeleteOrderMessage -> delete_order_message: DeleteOrderMessage;
        MessageType::TradeCancelMessage -> trade_cancel_message: TradeCancelMessage;
        MessageType::CrossTradeMessage -> cross_trade_message: CrossTradeMessage;
        MessageType::CrossCorrectionMessage -> cross_correction_message: CrossCorrectionMessage;
        MessageType::RetailPriceImprovementMessage -> retail_price_improvement_message: RetailPriceImprovementMessage;
        MessageType::AddOrderRefreshMessage -> add_order_refresh_message: AddOrderRefreshMessage;
        MessageType::ImbalanceMessage -> imbalance_message: ImbalanceMessage;
        MessageType::OrderExecutionMessage -> order_execution_message: OrderExecutionMessage;
        MessageType::NonDisplayedTradeMessage -> non_displayed_trade_message: NonDisplayedTradeMessage;
        MessageType::StockSummaryMessage -> stock_summary_message: StockSummaryMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint16 &convert=MessageType($$);
};

type SequenceNumberResetMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type SourceTimeReferenceMessage = unit {
    id: uint32;
    symbol_seq_num: uint32;
    source_time: uint32;
};

type SymbolIndexMappingMessage = unit {
    symbol_index: uint32;
    symbol: bytes &size=11;
    : skip bytes &size=1;   # padding
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    exchange_code: uint8 &convert=ExchangeCode($$);
    price_scale_code: uint8;
    security_type: uint8 &convert=SecurityType($$);
    lot_size: uint16;
    prev_close_price: uint32;
    prev_close_volume: uint32;
    price_resolution: uint8 &convert=PriceResolution($$);
    round_lot: uint8 &convert=RoundLot($$);
    mpv: uint16;
    unit_of_trade: uint16;
    : skip bytes &size=2;   # padding
};

type RetransmissionRequestMessage = unit {
    begin_seq_num: uint32;
    end_seq_num: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
};

type RequestResponseMessage = unit {
    request_seq_num: uint32;
    begin_seq_num: uint32;
    end_seq_num: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
    status: uint8 &convert=Status($$);
};

type HeartbeatResponseMessage = unit {
    source_id: bytes &size=10;
};

type SymbolIndexMappingRequestMessage = unit {
    symbol_index: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
    retransmit_method: uint8 &convert=RetransmitMethod($$);
};

type RefreshRequestMessage = unit {
    symbol_index: uint32;
    source_id: bytes &size=10;
    product_id: uint8;
    channel_id: uint8;
};

type MessageUnavailableMessage = unit {
    begin_seq_num: uint32;
    end_seq_num: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type SymbolClearMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    next_source_seq_num: uint32;
};

type SecurityStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: uint8 &convert=HaltCondition($$);
    : skip bytes &size=4;   # padding
    price_1: uint32;
    price_2: uint32;
    ssr_triggering_exchange_id: uint8 &convert=SsrTriggeringExchangeId($$);
    ssr_triggering_volume: uint32;
    time_field: uint32;
    ssr_state: uint8 &convert=SsrState($$);
    market_state: uint8 &convert=MarketState($$);
    session_state: bytes &size=1;
};

type RefreshHeaderMessage = unit {
    current_refresh_pkt: uint16;
    total_refresh_pkts: uint16;
    last_seq_num: uint32;
    last_symbol_seq_num: uint32;
};

type AddOrderMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    order_id: uint64;
    price: uint32;
    volume: uint32;
    side: uint8 &convert=Side($$);
    firm_id: bytes &size=5;
    num_parity_splits: uint8;
};

type ModifyOrderMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    order_id: uint64;
    price: uint32;
    volume: uint32;
    position_change: uint8 &convert=PositionChange($$);
    prev_price_parity_splits: uint8;
    new_price_parity_splits: uint8;
};

type ReplaceOrderMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    order_id: uint64;
    new_order_id: uint64;
    price: uint32;
    volume: uint32;
    prev_price_parity_splits: uint8;
    new_price_parity_splits: uint8;
};

type DeleteOrderMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    order_id: uint64;
    num_parity_splits: uint8;
};

type TradeCancelMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    trade_id: uint32;
};

type CrossTradeMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    cross_id: uint32;
    price: uint32;
    volume: uint32;
    cross_type: uint8 &convert=CrossType($$);
};

type CrossCorrectionMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    cross_id: uint32;
    volume: uint32;
};

type RetailPriceImprovementMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    rpi_indicator: uint8 &convert=RpiIndicator($$);
};

type AddOrderRefreshMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    order_id: uint64;
    price: uint32;
    volume: uint32;
    side: uint8 &convert=Side($$);
    firm_id: bytes &size=5;
    num_parity_splits: uint8;
};

type ImbalanceMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    reference_price: uint32;
    paired_qty: uint32;
    total_imbalance_qty: uint32;
    market_imbalance_qty: uint32;
    auction_time: uint16;
    auction_type: uint8 &convert=AuctionType($$);
    imbalance_side: uint8 &convert=ImbalanceSide($$);
    continuous_book_clearing_price: uint32;
    closing_only_clearing_price: uint32;
    ssr_filing_price: uint32;
    indicative_match_price: uint32;
    upper_collar: uint32;
    lower_collar: uint32;
    auction_status: uint8 &convert=AuctionStatus($$);
    freeze_status: uint8 &convert=FreezeStatus($$);
    num_extensions: uint8;
};

type OrderExecutionMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    order_id: uint64;
    trade_id: uint32;
    price: uint32;
    volume: uint32;
    printable_flag: uint8 &convert=PrintableFlag($$);
    num_parity_splits: uint8;
    db_exec_id: uint32;
};

type NonDisplayedTradeMessage = unit {
    source_time_ns: uint32;
    symbol_index: uint32;
    symbol_seq_num: uint32;
    trade_id: uint32;
    price: uint32;
    volume: uint32;
    printable_flag: uint8 &convert=PrintableFlag($$);
    db_exec_id: uint32;
};

type StockSummaryMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    symbol_index: uint32;
    high_price: uint32;
    low_price: uint32;
    open: uint32;
    close: uint32;
    total_volume: uint32;
};

type DeliveryFlag = enum {
    Heartbeat = 1,
    XdpFailover = 10,
    OriginalMessage = 11,
    SequenceNumberResetMessage = 12,
    OneRetransmissionPacket = 13,
    RetransmissionSequenceMessage = 15,
    OneRefreshPacket = 17,
    RefreshSequenceStart = 18,
    RefreshSequenceMessage = 19,
    RefreshSequenceEnd = 20,
    MessageUnavailable = 21,
};

type MessageType = enum {
    SequenceNumberResetMessage = 1,
    SourceTimeReferenceMessage = 2,
    SymbolIndexMappingMessage = 3,
    RetransmissionRequestMessage = 10,
    RequestResponseMessage = 11,
    HeartbeatResponseMessage = 12,
    SymbolIndexMappingRequestMessage = 13,
    RefreshRequestMessage = 15,
    MessageUnavailableMessage = 31,
    SymbolClearMessage = 32,
    SecurityStatusMessage = 34,
    RefreshHeaderMessage = 35,
    AddOrderMessage = 100,
    ModifyOrderMessage = 101,
    ReplaceOrderMessage = 104,
    DeleteOrderMessage = 102,
    TradeCancelMessage = 112,
    CrossTradeMessage = 111,
    CrossCorrectionMessage = 113,
    RetailPriceImprovementMessage = 114,
    AddOrderRefreshMessage = 106,
    ImbalanceMessage = 105,
    OrderExecutionMessage = 103,
    NonDisplayedTradeMessage = 110,
    StockSummaryMessage = 223,
};

type MarketId = enum {
    NyseEquities = 1,
    NyseArcaEquities = 3,
    NyseArcaOptions = 4,
    NyseBonds = 5,
    GlobalOtc = 6,
    NyseAmexOptions = 8,
    NyseAmericanEquities = 9,
    NyseNationalEquities = 10,
};

type ExchangeCode = enum {
    NyseAmerican = 0x41,
    NyseNational = 0x43,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    Iex = 0x56,
    Bats = 0x5a,
    GlobalOtc = 0x42,
    Otcbb = 0x55,
};

type SecurityType = enum {
    Adr = 0x41,
    CommonStock = 0x43,
    Debentures = 0x44,
    Etf = 0x45,
    Foreign = 0x46,
    UsDepositaryShares = 0x48,
    Units = 0x49,
    IndexLinkedNotes = 0x4c,
    MiscliquidTrust = 0x4d,
    OrdinaryShares = 0x4f,
    PreferredStock = 0x50,
    Rights = 0x52,
    SharesOfBeneficiaryInterest = 0x53,
    Test = 0x54,
    Units_x55 = 0x55,
    Warrant = 0x57,
};

type PriceResolution = enum {
    AllPenny = 0,
    PennyNickel = 1,
    NickelDime = 5,
};

type RoundLot = enum {
    Yes = 0x59,
    No = 0x4e,
};

type Status = enum {
    MessageWasAccepted = 0x30,
    RejectedDueToAnInvalidSourceId = 0x31,
    InvalidSequenceRange = 0x32,
    MaximumSequenceRange = 0x33,
    MaximumRequestInADay = 0x34,
    MaximumRefreshRequestsInADay = 0x35,
    OldSeqNumTtl = 0x36,
    InvalidChannelId = 0x37,
    InvalidProductId = 0x38,
    InvalidMsgTypeOrMsgSizeMismatch = 0x39,
};

type RetransmitMethod = enum {
    Udp = 0,
};

type SecurityStatus = enum {
    OpeningDelay = 0x33,
    TradingHalt = 0x34,
    Resume = 0x35,
    NoOpennoResume = 0x36,
    ShortSaleRestrictionActivatedDay1 = 0x41,
    ShortSaleRestrictionContinuedDay2 = 0x43,
    ShortSaleRestrictionDeactivated = 0x44,
    Preopening = 0x50,
    EarlySession = 0x45,
    CoreSession = 0x4f,
    LateSessionNonNyseOnly = 0x4c,
    Closed = 0x58,
    Time = 0x54,
    PriceIndication = 0x49,
    PreOpeningPriceIndication = 0x47,
    Rule15Indication = 0x52,
};

type HaltCondition = enum {
    SecurityNotDelayedhalted = 0x7e,
    NotDelayedhaltedNyseTapeAOnly = 0x20,
    NewsDissemination = 0x44,
    OrderImbalance = 0x49,
    NewsPending = 0x50,
    LuldPause = 0x4d,
    RelatedSecurityNotUsed = 0x53,
    EquipmentChangeover = 0x58,
    NoOpenNoResume = 0x5a,
    MarketWideCircuitBreakerHaltLevel1 = 0x31,
    MarketWideCircuitBreakerHaltLevel2 = 0x32,
    MarketWideCircuitBreakerHaltLevel3 = 0x33,
};

type SsrTriggeringExchangeId = enum {
    NyseAmerican = 0x41,
    NasdaqOmxBx = 0x42,
    NyseNational = 0x43,
    Finra = 0x44,
    Ise = 0x49,
    Edga = 0x4a,
    Edgx = 0x4b,
    Chx = 0x4d,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    Cts = 0x53,
    NasdaqOmx = 0x54,
    Iex = 0x56,
    Cbsx = 0x57,
    NasdaqOmxPsx = 0x58,
    BatsY = 0x59,
    Bats = 0x5a,
};

type SsrState = enum {
    NoShortSaleRestrictionInEffect = 0x7e,
    ShortSaleRestrictionInEffect = 0x45,
};

type MarketState = enum {
    Preopening = 0x50,
    EarlySession = 0x45,
    CoreSession = 0x4f,
    LateSession = 0x4c,
    Closed = 0x58,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type PositionChange = enum {
    Kept = 0,
    Lost = 1,
};

type CrossType = enum {
    EarlyOpening = 0x45,
    Opening = 0x4f,
    Reopening = 0x35,
    Closing = 0x36,
};

type RpiIndicator = enum {
    NoRetailInterest = 0x20,
    InterestOnBid = 0x41,
    InterestOnOffer = 0x42,
    InterestOnBidAndOffer = 0x43,
};

type AuctionType = enum {
    EarlyOpening = 0x4f,
    CoreOpening = 0x4d,
    Reopening = 0x48,
    Closing = 0x43,
    RegulatoryImbalance = 0x52,
};

type ImbalanceSide = enum {
    NoImbalance = 0x20,
    BuySide = 0x42,
    SellSide = 0x53,
};

type AuctionStatus = enum {
    WillRunOpenClose = 0,
    WillRunInterest = 1,
    WillNotRunImbalance = 2,
    WillNotRunTransitionToClosing = 3,
};

type FreezeStatus = enum {
    NoImbalanceFreeze = 0,
    ImbalanceFreeze = 1,
};

type PrintableFlag = enum {
    NotPrinted = 0,
    Printed = 1,
};

