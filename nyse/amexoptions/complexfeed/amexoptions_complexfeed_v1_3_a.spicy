module NyseAmexoptionsComplexfeedXdpV13A;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AmexoptionsComplexfeedV13A = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    packet_size: uint16;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    message_count: uint8;
    sequence_number: uint32;
    timestamp: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::ComplexQuoteMessage -> complex_quote_message: ComplexQuoteMessage;
        MessageType::ComplexTradeMessage -> complex_trade_message: ComplexTradeMessage;
        MessageType::ComplexCrossingRfqMessage -> complex_crossing_rfq_message: ComplexCrossingRfqMessage;
        MessageType::ComplexCubeRfqMessage -> complex_cube_rfq_message: ComplexCubeRfqMessage;
        MessageType::ComplexStatusMessage -> complex_status_message: ComplexStatusMessage;
        MessageType::RefreshComplexQuoteMessage -> refresh_complex_quote_message: RefreshComplexQuoteMessage;
        MessageType::RefreshComplexTradeMessage -> refresh_complex_trade_message: RefreshComplexTradeMessage;
        MessageType::ComplexSymbolDefinitionMessage -> complex_symbol_definition_message: ComplexSymbolDefinitionMessage;
        MessageType::StreamIdMessage -> stream_id_message: StreamIdMessage;
        MessageType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint16 &convert=MessageType($$);
};

type ComplexQuoteMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    complex_index: uint32;
    symbol_seq_num: uint32;
    ask_price: int32;
    bid_price: int32;
    ask_volume: uint16;
    bid_volume: uint16;
    ask_customer_volume: uint16;
    bid_customer_volume: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    : skip bytes &size=1;   # padding
    : skip bytes &size=2;   # padding
};

type ComplexTradeMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    complex_index: uint32;
    symbol_seq_num: uint32;
    trade_id: uint32;
    price: int32;
    volume_4: uint32;
    trade_cond_1: uint8 &convert=TradeCond1($$);
    trade_cond_2: uint8 &convert=TradeCond2($$);
    : skip bytes &size=2;   # padding
};

type ComplexCrossingRfqMessage = unit {
    source_time: uint32;
    source_ns: uint32;
    complex_index: uint32;
    symbol_seq_num: uint32;
    side: uint8 &convert=Side($$);
    : skip bytes &size=1;   # padding
    volume_2: uint16;
    price: int32;
};

type ComplexCubeRfqMessage = unit {
    source_time: uint32;
    source_ns: uint32;
    complex_index: uint32;
    symbol_seq_num: uint32;
    side: uint8 &convert=Side($$);
    : skip bytes &size=1;   # padding
    volume_2: uint16;
    price: int32;
};

type ComplexStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    complex_index: uint32;
    symbol_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: bytes &size=1;
    : skip bytes &size=2;   # padding
};

type RefreshComplexQuoteMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    complex_index: uint32;
    symbol_seq_num: uint32;
    ask_price: int32;
    bid_price: int32;
    ask_volume: uint16;
    bid_volume: uint16;
    ask_customer_volume: uint16;
    bid_customer_volume: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    : skip bytes &size=1;   # padding
    : skip bytes &size=2;   # padding
};

type RefreshComplexTradeMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    complex_index: uint32;
    symbol_seq_num: uint32;
    trade_id: uint32;
    price: int32;
    volume_4: uint32;
    trade_cond_1: uint8 &convert=TradeCond1($$);
    trade_cond_2: uint8 &convert=TradeCond2($$);
    : skip bytes &size=2;   # padding
};

type ComplexSymbolDefinitionMessage = unit {
    complex_index: uint32;
    complex_symbol: bytes &size=21;
    channel_id: uint8;
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    : skip bytes &size=1;   # padding
    stream_id: uint16;
    no_of_legs: uint16;
    : skip bytes &size=2;   # padding
    leg_definition: LegDefinition[self.no_of_legs];
};

type LegDefinition = unit {
    symbol_index: uint32;
    leg_ratio_qty: uint16;
    side: uint8 &convert=Side($$);
    leg_security_type: uint8 &convert=LegSecurityType($$);
};

type StreamIdMessage = unit {
    stream_id: uint16;
    : skip bytes &size=2;   # padding
};

type SequenceNumberResetMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type DeliveryFlag = enum {
    Heartbeat = 1,
    XdpFailover = 10,
    OriginalMessage = 11,
    SequenceNumberResetMessage = 12,
    OneRetransmissionPacket = 13,
    RetransmissionSequenceMessage = 15,
    OneRefreshPacket = 17,
    RefreshSequenceStart = 18,
    RefreshSequenceMessage = 19,
    RefreshSequenceEnd = 20,
    MessageUnavailable = 21,
};

type MessageType = enum {
    ComplexQuoteMessage = 423,
    ComplexTradeMessage = 425,
    ComplexCrossingRfqMessage = 429,
    ComplexCubeRfqMessage = 472,
    ComplexStatusMessage = 433,
    RefreshComplexQuoteMessage = 511,
    RefreshComplexTradeMessage = 513,
    ComplexSymbolDefinitionMessage = 439,
    StreamIdMessage = 455,
    SequenceNumberResetMessage = 1,
};

type QuoteCondition = enum {
    RegularTrading = 0x31,
    Rotation = 0x32,
    TradingHalted = 0x33,
    Preopen = 0x34,
    RotationLegalWidthQuotePending = 0x35,
};

type TradeCond1 = enum {
    RegularTrade = 0x20,
    LateReport = 0x49,
    FloorTrade = 0x52,
    SoSweepTrade = 0x53,
};

type TradeCond2 = enum {
    ComplexTradeWithEquity = 0x50,
    ComplexTrade = 0x4c,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type SecurityStatus = enum {
    LightUpADarkSeries = 0x4c,
    OpenADarkSeries = 0x4e,
    Open = 0x4f,
    Close = 0x58,
    Halt = 0x53,
    Unhalt = 0x55,
    UnhaltADarkSeries = 0x54,
    EndOfRfqAuction = 0x51,
};

type MarketId = enum {
    NyseCash = 1,
    EuropeCash = 2,
    NyseArcaCash = 3,
    NyseArcaOptions = 4,
    NyseArcaBonds = 5,
    ArcaEdge = 6,
    Liffe = 7,
    NyseAmericanOptions = 8,
    NyseMktCash = 9,
};

type LegSecurityType = enum {
    OptionsSeriesLeg = 0x4f,
    EquityStockLeg = 0x45,
};

