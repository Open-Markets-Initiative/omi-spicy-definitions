    orig_cl_ord_id: uint64;
    order_qty: uint32;
    side_u_81: uint8 &convert=SideU81($$);
    locate_reqd_u_81: uint8 &convert=LocateReqdU81($$);
};

type NewBulkQuoteType243Message = unit {
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    sub_id: bytes &size=4;
    cl_ord_id: uint64;
    self_trade_type_u_81: uint8 &convert=SelfTradeTypeU81($$);
    group_id: uint32;
    mm_sent_time: uint64;
    quote_request_group: QuoteRequestGroup[] &eod;
};

type QuoteRequestGroup = unit {
    series_index: uint32;
    bitfield_quote_inst: bitfield(8) {
        side_2: 0..1;
        mm_quote_type: 2..4;
        unused_3: 5..7;
    } &byte-order=spicy::ByteOrder::Little;
    price: int64;
    order_qty: uint32;
};

type NewBulkQuoteType259Message = unit {
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    sub_id: bytes &size=4;
    cl_ord_id: uint64;
    self_trade_type_u_81: uint8 &convert=SelfTradeTypeU81($$);
