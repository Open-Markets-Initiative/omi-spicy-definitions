module NyseAmexoptionsBinarygatewayPillarstreamV327ClientPillarMessage;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AmexoptionsBinarygatewayV327 = unit {
    switch ( self.client_message.login_message.msg_header.msg_type ) {
        MsgType::Login -> login_message: LoginMessage;
        MsgType::Heartbeat -> heartbeat: Heartbeat;
        MsgType::Open -> open: Open;
        MsgType::Close -> close: Close;
        MsgType::SeqMsg -> client_seq_msg: ClientSeqMsg;
        * -> unknown: bytes &eod;
    };
};

type LoginMessage = unit {
    msg_header: MsgHeader;
    username: bytes &size=16;
    password: bytes &size=32;
    mic: bytes &size=4;
    version: bytes &size=20;
};

type MsgHeader = unit {
    msg_type: uint16 &convert=MsgType($$);
    msg_length: uint16;
};

type Heartbeat = unit {
    msg_header: MsgHeader;
};

type Open = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
    start_seq: uint64;
    end_seq: uint64;
    access: uint8;
    mode: uint8;
};

type StreamId = unit {
    sess: uint32;
    user: uint32;
};

type Close = unit {
    msg_header: MsgHeader;
    stream_id: StreamId;
};

type ClientSeqMsg = unit {
    msg_header: MsgHeader;
    seq_msg_id: SeqMsgId;
    : skip bytes &size=4;   # padding
    timestamp: uint64;
    seq_msg_header: SeqMsgHeader;
    switch ( self.seq_msg_header.seq_msg_type ) {
        SeqMsgType::SessionConfigurationRequestMessage -> session_configuration_request_message: SessionConfigurationRequestMessage;
        SeqMsgType::NewOrderMessage -> new_order_message: NewOrderMessage;
        SeqMsgType::OrderCancelRequestMessage -> order_cancel_request_message: OrderCancelRequestMessage;
        SeqMsgType::OrderModifyRequestMessage -> order_modify_request_message: OrderModifyRequestMessage;
        SeqMsgType::NewBulkQuoteType243Message -> new_bulk_quote_type_243_message: NewBulkQuoteType243Message;
        SeqMsgType::NewBulkQuoteType259Message -> new_bulk_quote_type_259_message: NewBulkQuoteType259Message;
        SeqMsgType::NewOrderCrossMessage -> new_order_cross_message: NewOrderCrossMessage;
        SeqMsgType::BulkCancelRequestType223Message -> bulk_cancel_request_type_223_message: BulkCancelRequestType223Message;
        SeqMsgType::BulkCancelRequestType224Message -> bulk_cancel_request_type_224_message: BulkCancelRequestType224Message;
        SeqMsgType::RiskLimitUpdateRequestMessage -> risk_limit_update_request_message: RiskLimitUpdateRequestMessage;
        SeqMsgType::RiskActionRequestMessage -> risk_action_request_message: RiskActionRequestMessage;
        SeqMsgType::NewComplexSeriesRequestMessage -> new_complex_series_request_message: NewComplexSeriesRequestMessage;
        * -> unknown: bytes &eod;
    };
};

type SeqMsgId = unit {
    stream_id: StreamId;
    seq: uint64;
};

type SeqMsgHeader = unit {
    seq_msg_type: uint16 &convert=SeqMsgType($$);
    seq_msg_length: uint16;
};

type SessionConfigurationRequestMessage = unit {
    username: bytes &size=16;
    cancel_on_disconnect: uint8 &convert=CancelOnDisconnect($$);
    throttle_preference: uint8 &convert=ThrottlePreference($$);
    self_trade_prevention: uint8 &convert=SelfTradePrevention($$);
    order_priority_update_ack_subscription: uint8 &convert=OrderPriorityUpdateAckSubscription($$);
    bold_designation: uint8 &convert=BoldDesignation($$);
    : skip bytes &size=49;   # padding
};

type NewOrderMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    market_maker: bytes &size=10;
    mp_sub_id: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
    bitfield_order_instructions: bytes &size=16;
    price: int64;
    order_qty: uint32;
    min_qty: uint32;
    user_data: bytes &size=10;
    leg_open_close: uint64 &convert=LegOpenClose($$);
    auction_id: uint64;
    optional_order_add_on: OptionalOrderAddOn;
};

type OptionalOrderAddOn = unit {
    sub_msg_header: SubMsgHeader;
    stop_px: int64;
    max_floor: uint32;
    deliver_to_comp_id: bytes &size=5;
    clearing_firm: bytes &size=5;
    optional_data: bytes &size=16;
    clearing_account: bytes &size=5;
};

type SubMsgHeader = unit {
    sub_msg_type: uint16;
    sub_msg_length: uint16;
};

type OrderCancelRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
    cl_ord_id: uint64;
    orig_cl_ord_id: uint64;
};

type OrderModifyRequestMessage = unit {
    symbol_id: uint32;
    mpid: bytes &size=4;
