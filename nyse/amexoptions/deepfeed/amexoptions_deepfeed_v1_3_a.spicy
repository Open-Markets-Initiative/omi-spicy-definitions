module NyseAmexoptionsDeepfeedXdpV13A;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AmexoptionsDeepfeedV13A = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    packet_size: uint16;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    message_count: uint8;
    sequence_number: uint32;
    timestamp: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::OutrightMarketDepthBuyMessage -> outright_market_depth_buy_message: OutrightMarketDepthBuyMessage;
        MessageType::OutrightMarketDepthSellMessage -> outright_market_depth_sell_message: OutrightMarketDepthSellMessage;
        MessageType::UnderlyingStatusMessage -> underlying_status_message: UnderlyingStatusMessage;
        MessageType::OutrightSeriesStatusMessage -> outright_series_status_message: OutrightSeriesStatusMessage;
        MessageType::RefreshOutrightMarketDepthBuyMessage -> refresh_outright_market_depth_buy_message: RefreshOutrightMarketDepthBuyMessage;
        MessageType::RefreshOutrightMarketDepthSellMessage -> refresh_outright_market_depth_sell_message: RefreshOutrightMarketDepthSellMessage;
        MessageType::UnderlyingIndexMappingMessage -> underlying_index_mapping_message: UnderlyingIndexMappingMessage;
        MessageType::SeriesIndexMappingMessage -> series_index_mapping_message: SeriesIndexMappingMessage;
        MessageType::StreamIdMessage -> stream_id_message: StreamIdMessage;
        MessageType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint16 &convert=MessageType($$);
};

type OutrightMarketDepthBuyMessage = unit {
    source_time: uint32;
    source_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    first_level_price: int32;
    second_level_price: int32;
    third_level_price: int32;
    first_level_volume: uint16;
    second_level_volume: uint16;
    third_level_volume: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    : skip bytes &size=1;   # padding
    first_level_customer_volume: uint16;
    second_level_customer_volume: uint16;
    third_level_customer_volume: uint16;
    : skip bytes &size=2;   # padding
};

type OutrightMarketDepthSellMessage = unit {
    source_time: uint32;
    source_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    first_level_price: int32;
    second_level_price: int32;
    third_level_price: int32;
    first_volume: uint16;
    second_volume: uint16;
    third_volume: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    : skip bytes &size=1;   # padding
    first_level_customer_volume: uint16;
    second_level_customer_volume: uint16;
    third_level_customer_volume: uint16;
    : skip bytes &size=2;   # padding
};

type UnderlyingStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    underlying_index: uint32;
    underlying_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: bytes &size=1;
    : skip bytes &size=2;   # padding
};

type OutrightSeriesStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: bytes &size=1;
    : skip bytes &size=2;   # padding
};

type RefreshOutrightMarketDepthBuyMessage = unit {
    source_time: uint32;
    source_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    first_level_price: int32;
    second_level_price: int32;
    third_level_price: int32;
    first_volume: uint16;
    second_volume: uint16;
    third_volume: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    : skip bytes &size=1;   # padding
    first_level_customer_volume: uint16;
    second_level_customer_volume: uint16;
    third_level_customer_volume: uint16;
    : skip bytes &size=2;   # padding
};

type RefreshOutrightMarketDepthSellMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    first_level_price: int32;
    second_level_price: int32;
    third_level_price: int32;
    first_volume: uint16;
    second_volume: uint16;
    third_volume: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    : skip bytes &size=1;   # padding
    first_level_customer_volume: uint16;
    second_level_customer_volume: uint16;
    third_level_customer_volume: uint16;
    : skip bytes &size=2;   # padding
};

type UnderlyingIndexMappingMessage = unit {
    underlying_index: uint32;
    underlying_symbol: bytes &size=11;
    channel_id: uint8;
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    exchange_code: uint8 &convert=ExchangeCode($$);
    price_scale_code: uint8;
    security_type: uint8 &convert=SecurityType($$);
    price_resolution: uint8 &convert=PriceResolution($$);
    : skip bytes &size=1;   # padding
};

type SeriesIndexMappingMessage = unit {
    series_index: uint32;
    channel_id: uint8;
    : skip bytes &size=1;   # padding
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    : skip bytes &size=1;   # padding
    stream_id: uint16;
    underlying_index: uint32;
    contract_multiplier: uint16;
    maturity_date: bytes &size=6;
    put_or_call: uint8 &convert=PutOrCall($$);
    strike_price: bytes &size=10;
    price_scale_code: uint8;
    underlying_symbol: bytes &size=11;
    option_symbol_root: bytes &size=5;
    group_id: uint32;
};

type StreamIdMessage = unit {
    stream_id: uint16;
    : skip bytes &size=2;   # padding
};

type SequenceNumberResetMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type DeliveryFlag = enum {
    Heartbeat = 1,
    XdpFailover = 10,
    OriginalMessage = 11,
    SequenceNumberResetMessage = 12,
    OneRetransmissionPacket = 13,
    RetransmissionSequenceMessage = 15,
    OneRefreshPacket = 17,
    RefreshSequenceStart = 18,
    RefreshSequenceMessage = 19,
    RefreshSequenceEnd = 20,
    MessageUnavailable = 21,
};

type MessageType = enum {
    OutrightMarketDepthBuyMessage = 403,
    OutrightMarketDepthSellMessage = 405,
    UnderlyingStatusMessage = 419,
    OutrightSeriesStatusMessage = 421,
    RefreshOutrightMarketDepthBuyMessage = 503,
    RefreshOutrightMarketDepthSellMessage = 505,
    UnderlyingIndexMappingMessage = 435,
    SeriesIndexMappingMessage = 437,
    StreamIdMessage = 455,
    SequenceNumberResetMessage = 1,
};

type QuoteCondition = enum {
    RegularTrading = 0x31,
    Rotation = 0x32,
    TradingHalted = 0x33,
    Preopen = 0x34,
    RotationLegalWidthQuotePending = 0x35,
};

type SecurityStatus = enum {
    LightUpADarkSeries = 0x4c,
    OpenADarkSeries = 0x4e,
    Open = 0x4f,
    Close = 0x58,
    Halt = 0x53,
    Unhalt = 0x55,
    UnhaltADarkSeries = 0x54,
    EndOfRfqAuction = 0x51,
};

type MarketId = enum {
    NyseCash = 1,
    EuropeCash = 2,
    NyseArcaCash = 3,
    NyseArcaOptions = 4,
    NyseArcaBonds = 5,
    ArcaEdge = 6,
    Liffe = 7,
    NyseAmericanOptions = 8,
    NyseMktCash = 9,
};

type ExchangeCode = enum {
    Nyse = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    NyseMkt = 0x41,
    GlobalOtc = 0x31,
    ArcaLocalNontapebIndex = 0x32,
};

type SecurityType = enum {
    Adr = 0x41,
    CommonStock = 0x43,
    Debentures = 0x44,
    Etf = 0x45,
    Foreign = 0x46,
    AmericanDepositoryShares = 0x48,
    Units = 0x49,
    MiscliquidTrust = 0x4d,
    OrdinaryShares = 0x4f,
    PreferredStock = 0x50,
    Rights = 0x52,
    SharesOfBeneficiaryInterest = 0x53,
    Test = 0x54,
    Units_x55 = 0x55,
    Warrant = 0x57,
    Index = 0x58,
};

type PriceResolution = enum {
    AllPenny = 0,
    PennyNickel = 1,
    NickelDime = 5,
};

type PutOrCall = enum {
    Put = 0,
    Call = 1,
};

