module NyseAmexoptionsTopfeedXdpV13A;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AmexoptionsTopfeedV13A = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    packet_size: uint16;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    message_count: uint8;
    sequence_number: uint32;
    timestamp: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::OutrightQuoteMessage -> outright_quote_message: OutrightQuoteMessage;
        MessageType::OutrightTradeMessage -> outright_trade_message: OutrightTradeMessage;
        MessageType::OutrightTradeCancelMessage -> outright_trade_cancel_message: OutrightTradeCancelMessage;
        MessageType::OutrightTradeCorrectionMessage -> outright_trade_correction_message: OutrightTradeCorrectionMessage;
        MessageType::OutrightImbalanceMessage -> outright_imbalance_message: OutrightImbalanceMessage;
        MessageType::OutrightCrossingRfqMessage -> outright_crossing_rfq_message: OutrightCrossingRfqMessage;
        MessageType::OutrightBoldRfqMessage -> outright_bold_rfq_message: OutrightBoldRfqMessage;
        MessageType::OutrightSummaryMessage -> outright_summary_message: OutrightSummaryMessage;
        MessageType::UnderlyingStatusMessage -> underlying_status_message: UnderlyingStatusMessage;
        MessageType::OutrightSeriesStatusMessage -> outright_series_status_message: OutrightSeriesStatusMessage;
        MessageType::RefreshOutrightQuoteMessage -> refresh_outright_quote_message: RefreshOutrightQuoteMessage;
        MessageType::RefreshOutrightTradeMessage -> refresh_outright_trade_message: RefreshOutrightTradeMessage;
        MessageType::RefreshOutrightImbalanceMessage -> refresh_outright_imbalance_message: RefreshOutrightImbalanceMessage;
        MessageType::UnderlyingIndexMappingMessage -> underlying_index_mapping_message: UnderlyingIndexMappingMessage;
        MessageType::SeriesIndexMappingMessage -> series_index_mapping_message: SeriesIndexMappingMessage;
        MessageType::StreamIdMessage -> stream_id_message: StreamIdMessage;
        MessageType::SequenceNumberResetMessage -> sequence_number_reset_message: SequenceNumberResetMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint16 &convert=MessageType($$);
};

type OutrightQuoteMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    ask_price: int32;
    bid_price: int32;
    ask_volume: uint16;
    bid_volume: uint16;
    ask_customer_volume: uint16;
    bid_customer_volume: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    : skip bytes &size=1;   # padding
    : skip bytes &size=2;   # padding
};

type OutrightTradeMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    trade_id: uint32;
    price: int32;
    volume_4: uint32;
    trade_cond_1: uint8 &convert=TradeCond1($$);
    trade_cond_2: uint8 &convert=TradeCond2($$);
    : skip bytes &size=2;   # padding
};

type OutrightTradeCancelMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    original_trade_id: uint32;
};

type OutrightTradeCorrectionMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    original_trade_id: uint32;
    trade_id: uint32;
    price: int32;
    volume_4: uint32;
    trade_cond_1: uint8 &convert=TradeCond1($$);
    trade_cond_2: uint8 &convert=TradeCond2($$);
    : skip bytes &size=2;   # padding
};

type OutrightImbalanceMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    reference_price: int32;
    paired_qty: uint16;
    total_imbalance_qty: uint16;
    market_imbalance_qty: uint16;
    auction_type: uint8 &convert=AuctionType($$);
    imbalance_side: uint8 &convert=ImbalanceSide($$);
    market_imbalance_side: uint8 &convert=MarketImbalanceSide($$);
    : skip bytes &size=3;   # padding
};

type OutrightCrossingRfqMessage = unit {
    source_time: uint32;
    source_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    side: uint8 &convert=Side($$);
    : skip bytes &size=1;   # padding
    volume_2: uint16;
    price: int32;
};

type OutrightBoldRfqMessage = unit {
    source_time: uint32;
    source_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    side: uint8 &convert=Side($$);
    capacity: uint8 &convert=Capacity($$);
    contracts: uint16;
    price: int32;
    participant: bytes &size=4;
};

type OutrightSummaryMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    high_price: int32;
    low_price: int32;
    open: int32;
    close: int32;
    total_volume: uint32;
};

type UnderlyingStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    underlying_index: uint32;
    underlying_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: bytes &size=1;
    : skip bytes &size=2;   # padding
};

type OutrightSeriesStatusMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    security_status: uint8 &convert=SecurityStatus($$);
    halt_condition: bytes &size=1;
    : skip bytes &size=2;   # padding
};

type RefreshOutrightQuoteMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    ask_price: int32;
    bid_price: int32;
    ask_volume: uint16;
    bid_volume: uint16;
    ask_customer_volume: uint16;
    bid_customer_volume: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    : skip bytes &size=1;   # padding
    : skip bytes &size=2;   # padding
};

type RefreshOutrightTradeMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    trade_id: uint32;
    price: int32;
    volume_4: uint32;
    trade_cond_1: uint8 &convert=TradeCond1($$);
    trade_cond_2: uint8 &convert=TradeCond2($$);
    : skip bytes &size=2;   # padding
};

type RefreshOutrightImbalanceMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    series_index: uint32;
    symbol_seq_num: uint32;
    reference_price: int32;
    paired_qty: uint16;
    total_imbalance_qty: uint16;
    market_imbalance_qty: uint16;
    auction_type: uint8 &convert=AuctionType($$);
    imbalance_side: uint8 &convert=ImbalanceSide($$);
    market_imbalance_side: uint8 &convert=MarketImbalanceSide($$);
    : skip bytes &size=3;   # padding
};

type UnderlyingIndexMappingMessage = unit {
    underlying_index: uint32;
    underlying_symbol: bytes &size=11;
    channel_id: uint8;
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    exchange_code: uint8 &convert=ExchangeCode($$);
    price_scale_code: uint8;
    security_type: uint8 &convert=SecurityType($$);
    price_resolution: uint8 &convert=PriceResolution($$);
    : skip bytes &size=1;   # padding
};

type SeriesIndexMappingMessage = unit {
    series_index: uint32;
    channel_id: uint8;
    : skip bytes &size=1;   # padding
    market_id: uint16 &convert=MarketId($$);
    system_id: uint8;
    : skip bytes &size=1;   # padding
    stream_id: uint16;
    underlying_index: uint32;
    contract_multiplier: uint16;
    maturity_date: bytes &size=6;
    put_or_call: uint8 &convert=PutOrCall($$);
    strike_price: bytes &size=10;
    price_scale_code: uint8;
    underlying_symbol: bytes &size=11;
    option_symbol_root: bytes &size=5;
    group_id: uint32;
};

type StreamIdMessage = unit {
    stream_id: uint16;
    : skip bytes &size=2;   # padding
};

type SequenceNumberResetMessage = unit {
    source_time: uint32;
    source_time_ns: uint32;
    product_id: uint8;
    channel_id: uint8;
};

type DeliveryFlag = enum {
    Heartbeat = 1,
    XdpFailover = 10,
    OriginalMessage = 11,
    SequenceNumberResetMessage = 12,
    OneRetransmissionPacket = 13,
    RetransmissionSequenceMessage = 15,
    OneRefreshPacket = 17,
    RefreshSequenceStart = 18,
    RefreshSequenceMessage = 19,
    RefreshSequenceEnd = 20,
    MessageUnavailable = 21,
};

type MessageType = enum {
    OutrightQuoteMessage = 401,
    OutrightTradeMessage = 407,
    OutrightTradeCancelMessage = 409,
    OutrightTradeCorrectionMessage = 411,
    OutrightImbalanceMessage = 413,
    OutrightCrossingRfqMessage = 415,
    OutrightBoldRfqMessage = 471,
    OutrightSummaryMessage = 417,
    UnderlyingStatusMessage = 419,
    OutrightSeriesStatusMessage = 421,
    RefreshOutrightQuoteMessage = 501,
    RefreshOutrightTradeMessage = 507,
    RefreshOutrightImbalanceMessage = 509,
    UnderlyingIndexMappingMessage = 435,
    SeriesIndexMappingMessage = 437,
    StreamIdMessage = 455,
    SequenceNumberResetMessage = 1,
};

type QuoteCondition = enum {
    RegularTrading = 0x31,
    Rotation = 0x32,
    TradingHalted = 0x33,
    Preopen = 0x34,
    RotationLegalWidthQuotePending = 0x35,
};

type TradeCond1 = enum {
    RegularTrade = 0x20,
    LateReport = 0x49,
    FloorTrade = 0x52,
    SoSweepTrade = 0x53,
};

type TradeCond2 = enum {
    ComplexTradeWithEquity = 0x50,
    ComplexTrade = 0x4c,
};

type AuctionType = enum {
    Opening = 0x4f,
    Halt = 0x48,
};

type ImbalanceSide = enum {
    Buy = 0x42,
    Sell = 0x53,
    NoImbalance = 0x20,
};

type MarketImbalanceSide = enum {
    Buy = 0x42,
    Sell = 0x53,
    NoImbalance = 0x20,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type Capacity = enum {
    NotSpecified = 0x20,
    Customer = 0x30,
    Firm = 0x31,
    BrokerDealer = 0x32,
    MarketMaker = 0x33,
    ProfessionalCustomer = 0x38,
};

type SecurityStatus = enum {
    LightUpADarkSeries = 0x4c,
    OpenADarkSeries = 0x4e,
    Open = 0x4f,
    Close = 0x58,
    Halt = 0x53,
    Unhalt = 0x55,
    UnhaltADarkSeries = 0x54,
    EndOfRfqAuction = 0x51,
};

type MarketId = enum {
    NyseCash = 1,
    EuropeCash = 2,
    NyseArcaCash = 3,
    NyseArcaOptions = 4,
    NyseArcaBonds = 5,
    ArcaEdge = 6,
    Liffe = 7,
    NyseAmericanOptions = 8,
    NyseMktCash = 9,
};

type ExchangeCode = enum {
    Nyse = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x51,
    NyseMkt = 0x41,
    GlobalOtc = 0x31,
    ArcaLocalNontapebIndex = 0x32,
};

type SecurityType = enum {
    Adr = 0x41,
    CommonStock = 0x43,
    Debentures = 0x44,
    Etf = 0x45,
    Foreign = 0x46,
    AmericanDepositoryShares = 0x48,
    Units = 0x49,
    MiscliquidTrust = 0x4d,
    OrdinaryShares = 0x4f,
    PreferredStock = 0x50,
    Rights = 0x52,
    SharesOfBeneficiaryInterest = 0x53,
    Test = 0x54,
    Units_x55 = 0x55,
    Warrant = 0x57,
    Index = 0x58,
};

type PriceResolution = enum {
    AllPenny = 0,
    PennyNickel = 1,
    NickelDime = 5,
};

type PutOrCall = enum {
    Put = 0,
    Call = 1,
};

