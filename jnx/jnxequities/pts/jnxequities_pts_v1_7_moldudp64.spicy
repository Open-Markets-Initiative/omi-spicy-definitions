module JnxJnxequitiesPtsItchV17MoldUdp64;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type JnxequitiesPtsV17 = unit {
    udp_packet_header: UdpPacketHeader;
    messages: Message[self.udp_packet_header.message_count];
};

type UdpPacketHeader = unit {
    udp_session: bytes &size=10;
    udp_sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SecondsMessage -> seconds_message: SecondsMessage;
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::PriceTickSizeMessage -> price_tick_size_message: PriceTickSizeMessage;
        MessageType::OrderbookDirectoryMessage -> orderbook_directory_message: OrderbookDirectoryMessage;
        MessageType::TradingStateMessage -> trading_state_message: TradingStateMessage;
        MessageType::ShortSellingPriceRestrictionStateMessage -> short_selling_price_restriction_state_message: ShortSellingPriceRestrictionStateMessage;
        MessageType::OrderAddedWithoutAttributesMessage -> order_added_without_attributes_message: OrderAddedWithoutAttributesMessage;
        MessageType::OrderAddedWithAttributesMessage -> order_added_with_attributes_message: OrderAddedWithAttributesMessage;
        MessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        MessageType::OrderDeletedMessage -> order_deleted_message: OrderDeletedMessage;
        MessageType::OrderReplacedMessage -> order_replaced_message: OrderReplacedMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type SecondsMessage = unit {
    seconds: uint32;
};

type SystemEventMessage = unit {
    nanoseconds: uint32;
    group: bytes &size=4;
    system_event: bytes &size=1;
};

type PriceTickSizeMessage = unit {
    nanoseconds: uint32;
    price_tick_size_table_id: uint32;
    price_tick_size: uint32;
    price_start: uint32;
};

type OrderbookDirectoryMessage = unit {
    nanoseconds: uint32;
    orderbook_id: bytes &size=4;
    orderbook_code: bytes &size=12;
    group: bytes &size=4;
    round_lot_size: uint32;
    price_tick_size_table_id: uint32;
    price_decimals: uint32;
    upper_price_limit: uint32;
    lower_price_limit: uint32;
};

type TradingStateMessage = unit {
    nanoseconds: uint32;
    orderbook_id: bytes &size=4;
    group: bytes &size=4;
    trading_state: uint8 &convert=TradingState($$);
};

type ShortSellingPriceRestrictionStateMessage = unit {
    nanoseconds: uint32;
    orderbook_id: bytes &size=4;
    group: bytes &size=4;
    short_selling_state: uint8 &convert=ShortSellingState($$);
};

type OrderAddedWithoutAttributesMessage = unit {
    nanoseconds: uint32;
    order_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    quantity: uint32;
    orderbook_id: bytes &size=4;
    group: bytes &size=4;
    price: uint32;
};

type OrderAddedWithAttributesMessage = unit {
    nanoseconds: uint32;
    order_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    quantity: uint32;
    orderbook_id: bytes &size=4;
    group: bytes &size=4;
    price: uint32;
    attribution: bytes &size=4;
    order_type: uint8 &convert=OrderType($$);
};

type OrderExecutedMessage = unit {
    nanoseconds: uint32;
    order_number: uint64;
    executed_quantity: uint32;
    match_number: uint64;
};

type OrderDeletedMessage = unit {
    nanoseconds: uint32;
    order_number: uint64;
};

type OrderReplacedMessage = unit {
    nanoseconds: uint32;
    original_order_number: uint64;
    new_order_number: uint64;
    quantity: uint32;
    price: uint32;
};

type MessageType = enum {
    SecondsMessage = 0x54,
    SystemEventMessage = 0x53,
    PriceTickSizeMessage = 0x4c,
    OrderbookDirectoryMessage = 0x52,
    TradingStateMessage = 0x48,
    ShortSellingPriceRestrictionStateMessage = 0x59,
    OrderAddedWithoutAttributesMessage = 0x41,
    OrderAddedWithAttributesMessage = 0x46,
    OrderExecutedMessage = 0x45,
    OrderDeletedMessage = 0x44,
    OrderReplacedMessage = 0x55,
};

type TradingState = enum {
    Trading = 0x54,
    Suspended = 0x56,
};

type ShortSellingState = enum {
    NoPriceRestriction = 0x30,
    PriceRestrictionInEffect = 0x31,
};

type BuySellIndicator = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type OrderType = enum {
    DlpOrder = 0x51,
};

