module BlueoceanatsBlueequitiesMemoirlastsaleSbeV13;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type BlueequitiesMemoirlastsaleV13 = unit {
    common_header: CommonHeader;
    sequenced_messages: SequencedMessage;
};

type CommonHeader = unit {
    message_type: uint8 &convert=MessageType($$);
    header_length: uint8;
    session_id: uint64;
    sequence_number: uint64;
};

type SequencedMessage = unit {
    message_count: uint16;
    message: Message[self.message_count];
};

type Message = unit {
    message_length: uint16;
    sbe_message: SbeMessage;
};

type SbeMessage = unit {
    sbe_header: SbeHeader;
    switch ( self.sbe_header.template_id ) {
        TemplateId::InstrumentDirectoryMessage -> instrument_directory_message: InstrumentDirectoryMessage;
        TemplateId::RegShoRestrictionMessage -> reg_sho_restriction_message: RegShoRestrictionMessage;
        TemplateId::SecurityTradingStatusMessage -> security_trading_status_message: SecurityTradingStatusMessage;
        TemplateId::TradingSessionStatusMessage -> trading_session_status_message: TradingSessionStatusMessage;
        TemplateId::TradeReportMessage -> trade_report_message: TradeReportMessage;
        TemplateId::TradeCancelMessage -> trade_cancel_message: TradeCancelMessage;
        TemplateId::TradeCorrectMessage -> trade_correct_message: TradeCorrectMessage;
        * -> unknown: bytes &eod;
    };
};

type SbeHeader = unit {
    block_length: uint16;
    template_id: uint8 &convert=TemplateId($$);
    schema_id: uint8;
    version: uint16;
};

type InstrumentDirectoryMessage = unit {
    timestamp: uint64;
    security_id: uint16;
    symbol: bytes &size=6;
    symbol_sfx: bytes &size=6;
    round_lot: uint32;
    is_test_symbol: uint8 &convert=IsTestSymbol($$);
    mpv: int64;
};

type RegShoRestrictionMessage = unit {
    timestamp: uint64;
    security_id: uint16;
    short_sale_restriction: uint8 &convert=ShortSaleRestriction($$);
};

type SecurityTradingStatusMessage = unit {
    timestamp: uint64;
    security_id: uint16;
    security_trading_status: uint8 &convert=SecurityTradingStatus($$);
    security_trading_status_reason: uint8 &convert=SecurityTradingStatusReason($$);
};

type TradingSessionStatusMessage = unit {
    timestamp: uint64;
    trading_session: uint8 &convert=TradingSession($$);
};

type TradeReportMessage = unit {
    timestamp: uint64;
    security_id: uint16;
    trade_id: uint64;
    trade_qty: uint32;
    trade_price: int64;
    sale_condition_1: uint8 &convert=SaleCondition1($$);
    sale_condition_2: uint8 &convert=SaleCondition2($$);
    sale_condition_3: uint8 &convert=SaleCondition3($$);
    sale_condition_4: uint8 &convert=SaleCondition4($$);
};

type TradeCancelMessage = unit {
    timestamp: uint64;
    security_id: uint16;
    trade_id: uint64;
    trade_qty: uint32;
    last_price: int64;
    sale_condition_1: uint8 &convert=SaleCondition1($$);
    sale_condition_2: uint8 &convert=SaleCondition2($$);
    sale_condition_3: uint8 &convert=SaleCondition3($$);
    sale_condition_4: uint8 &convert=SaleCondition4($$);
};

type TradeCorrectMessage = unit {
    timestamp: uint64;
    security_id: uint16;
    trade_id: uint64;
    original_trade_qty: uint32;
    original_trade_price: int64;
    original_sale_condition_1: uint8 &convert=OriginalSaleCondition1($$);
    original_sale_condition_2: uint8 &convert=OriginalSaleCondition2($$);
    original_sale_condition_3: uint8 &convert=OriginalSaleCondition3($$);
    original_sale_condition_4: uint8 &convert=OriginalSaleCondition4($$);
    corrected_trade_qty: uint32;
    corrected_trade_price: int64;
    corrected_sale_condition_1: uint8 &convert=CorrectedSaleCondition1($$);
    corrected_sale_condition_2: uint8 &convert=CorrectedSaleCondition2($$);
    corrected_sale_condition_3: uint8 &convert=CorrectedSaleCondition3($$);
    corrected_sale_condition_4: uint8 &convert=CorrectedSaleCondition4($$);
};

type MessageType = enum {
    HeartbeatMessage = 0,
    SessionShutdownMessage = 1,
    SequencedMessage = 2,
};

type TemplateId = enum {
    InstrumentDirectoryMessage = 1,
    RegShoRestrictionMessage = 2,
    SecurityTradingStatusMessage = 3,
    TradingSessionStatusMessage = 5,
    TradeReportMessage = 10,
    TradeCancelMessage = 11,
    TradeCorrectMessage = 12,
};

type IsTestSymbol = enum {
    False = 0,
    True = 1,
};

type ShortSaleRestriction = enum {
    False = 0,
    True = 1,
};

type SecurityTradingStatus = enum {
    Halted = 0x48,
    Paused = 0x50,
    Quoting = 0x51,
    Trading = 0x54,
};

type SecurityTradingStatusReason = enum {
    None = 0x58,
    Regulatory = 0x52,
    Administrative = 0x41,
};

type TradingSession = enum {
    Opening = 0x31,
    Trading = 0x32,
    PostTrading = 0x33,
    Closed = 0x34,
};

type SaleCondition1 = enum {
    Regular = 0x40,
};

type SaleCondition2 = enum {
    IntermarketSweep = 0x46,
    NotApplicable = 0x20,
};

type SaleCondition3 = enum {
    FormT = 0x54,
    NotApplicable = 0x20,
};

type SaleCondition4 = enum {
    PriceVariation = 0x48,
    OddLot = 0x49,
    Cross = 0x58,
    NotApplicable = 0x20,
};

type OriginalSaleCondition1 = enum {
    Regular = 0x40,
};

type OriginalSaleCondition2 = enum {
    IntermarketSweep = 0x46,
    NotApplicable = 0x20,
};

type OriginalSaleCondition3 = enum {
    FormT = 0x54,
    NotApplicable = 0x20,
};

type OriginalSaleCondition4 = enum {
    PriceVariation = 0x48,
    OddLot = 0x49,
    Cross = 0x58,
    NotApplicable = 0x20,
};

type CorrectedSaleCondition1 = enum {
    Regular = 0x40,
};

type CorrectedSaleCondition2 = enum {
    IntermarketSweep = 0x46,
    NotApplicable = 0x20,
};

type CorrectedSaleCondition3 = enum {
    FormT = 0x54,
    NotApplicable = 0x20,
};

type CorrectedSaleCondition4 = enum {
    PriceVariation = 0x48,
    OddLot = 0x49,
    Cross = 0x58,
    NotApplicable = 0x20,
};

