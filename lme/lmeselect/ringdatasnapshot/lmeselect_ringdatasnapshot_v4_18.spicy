module LmeLmeselectRingdatasnapshotLmesourceV418;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type LmeselectRingdatasnapshotV418 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.msg_count];
};

type PacketHeader = unit {
    pkt_size: uint16;
    msg_count: uint8;
    filler: bytes &size=1;
    seq_num: uint32;
    send_time: uint64;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::SequenceResetMessage -> sequence_reset_message: SequenceResetMessage;
        MsgType::MarketStateProductMessage -> market_state_product_message: MarketStateProductMessage;
        MsgType::MarketDataOrderMessage -> market_data_order_message: MarketDataOrderMessage;
        MsgType::IndicativeTradePriceMessage -> indicative_trade_price_message: IndicativeTradePriceMessage;
        MsgType::MarketDataTradeMessage -> market_data_trade_message: MarketDataTradeMessage;
        MsgType::RefreshCompleteMessage -> refresh_complete_message: RefreshCompleteMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_size: uint16;
    msg_type: uint16 &convert=MsgType($$);
};

type SequenceResetMessage = unit {
    new_seq_no: uint32;
};

type MarketStateProductMessage = unit {
    trading_venue: bytes &size=2;
    timeof_event: uint64;
    product_code: bytes &size=2;
    trading_state: uint8 &convert=TradingState($$);
    ring_session: bytes &size=2;
};

type MarketDataOrderMessage = unit {
    timeof_event: uint64;
    tradable_instrument_id: uint64;
    trading_venue: bytes &size=2;
    ring_session: bytes &size=2;
    cancellation_reason: bytes &size=2;
    product_code: bytes &size=2;
    buy_sell: uint8 &convert=BuySell($$);
    price: int64;
    volume: uint32;
    remaining_records: uint16;
    record_count: uint16;
    strategy_leg_count: uint32;
    order_legs: OrderLegs[self.record_count];
};

type OrderLegs = unit {
    leg_buy_sell: uint8 &convert=LegBuySell($$);
    leg_price: int64;
    leg_volume: uint32;
};

type IndicativeTradePriceMessage = unit {
    timeof_event: uint64;
    tradable_instrument_id: uint64;
    trading_venue: bytes &size=2;
    ring_session: bytes &size=2;
    indicative_price_type: uint8 &convert=IndicativePriceType($$);
    indicative_trade_price: int64;
};

type MarketDataTradeMessage = unit {
    timeof_event: uint64;
    tradable_instrument_id: uint64;
    trading_venue: bytes &size=2;
    matched_time: uint64;
    ring_session: bytes &size=2;
    trade_cancel_flag: uint8 &convert=TradeCancelFlag($$);
    price: int64;
    volume: uint32;
    match_id: uint64;
    trade_at_reference_price_type: uint8 &convert=TradeAtReferencePriceType($$);
    sub_type_of_trade: uint8 &convert=SubTypeOfTrade($$);
    remaining_records: uint16;
    record_count: uint16;
    strategy_leg_count: uint32;
    trade_legs: TradeLegs[self.record_count];
};

type TradeLegs = unit {
    leg_price: int64;
    leg_volume: uint32;
    leg_match_id: uint64;
    leg_trade_at_reference_price: uint8 &convert=LegTradeAtReferencePrice($$);
};

type RefreshCompleteMessage = unit {
    last_seq_num: uint32;
};

type MsgType = enum {
    SequenceResetMessage = 100,
    MarketStateProductMessage = 310,
    MarketDataOrderMessage = 328,
    IndicativeTradePriceMessage = 340,
    MarketDataTradeMessage = 341,
    RefreshCompleteMessage = 203,
};

type TradingState = enum {
    PreOpen = 1,
    Open = 2,
    PostTrade = 3,
    Close = 4,
    TechnicalHalt = 6,
};

type BuySell = enum {
    Buy = 0x42,
    Sell = 0x53,
    TwoSidedQuote = 0x20,
};

type LegBuySell = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type IndicativePriceType = enum {
    IndicativeTradePrice = 0,
    IndicativeTradePriceDeleted = 1,
};

type TradeCancelFlag = enum {
    False_0 = 0,
    True_1 = 1,
};

type TradeAtReferencePriceType = enum {
    Differential = 0x44,
    Substituted = 0x53,
    NotApplicable = 0x20,
};

type SubTypeOfTrade = enum {
    TheTradeResultedFromAnExplicitOrder = 1,
    TheTradeResultedFromUncrossing = 2,
    TheTradeResultedFromAnImpliedOrder = 7,
    TheTradeResultedFromTwoImpliedOrdersMatching = 8,
    TheTradeResultedFromAnOffBookCrossTrade = 9,
};

type LegTradeAtReferencePrice = enum {
    Differential = 0x44,
    Substituted = 0x53,
    NotApplicable = 0x20,
};

