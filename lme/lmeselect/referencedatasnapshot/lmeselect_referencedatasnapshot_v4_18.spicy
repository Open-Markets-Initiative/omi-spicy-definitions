    settlement_type: uint8 &convert=SettlementType($$);
    settlement_pricing_method: uint8 &convert=SettlementPricingMethod($$);
    underlying_type: uint8 &convert=UnderlyingType($$);
    strategy_leg_count: uint32;
    strategy_legs: StrategyLegs[self.strategy_leg_count];
