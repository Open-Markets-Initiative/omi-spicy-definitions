type MsgType = enum {
    SequenceResetMessage = 100,
    ContractDefinitionMessage = 300,
    OutrightDefinitionMessage = 301,
    StrategyDefinitionMessage = 302,
    PriceLimitsMessage = 305,
    TradeStatisticsEndOfDayMessage = 351,
    RefreshCompleteMessage = 203,
};

