    linked_tradable_instrument_id: uint64;
    product_code: bytes &size=2;
    contract_type: uint8 &convert=ContractType($$);
    trading_currency: bytes &size=3;
    contract_code: bytes &size=12;
    expiry_date: uint32;
    prompt_type: uint8 &convert=PromptType($$);
    strike_price: int64;
    option_type: uint8 &convert=OptionType($$);
    exercise_style: int8 &convert=ExerciseStyle($$);
    prompt_date_label: bytes &size=6;
    price_code: bytes &size=2;
    isin: bytes &size=12;
    cfi_code: bytes &size=6;
    market_code: bytes &size=4;
    market_segment_code: bytes &size=12;
    tick_size_id: uint32;
    lot_size: uint64;
    lot_size_type: uint8 &convert=LotSizeType($$);
    last_trading_date: uint32;
    settlement_type: uint8 &convert=SettlementType($$);
    settlement_pricing_method: uint8 &convert=SettlementPricingMethod($$);
    underlying_type: uint8 &convert=UnderlyingType($$);
};

type StrategyDefinitionMessage = unit {
    trading_venue: bytes &size=2;
    tradable_instrument_id: uint64;
    merged_tradable_instrument_id: uint64;
    product_code: bytes &size=2;
    contract_type: uint8 &convert=ContractType($$);
    trading_currency: bytes &size=3;
    strategy_type_code: uint32;
    contract_code: bytes &size=12;
    exercise_style: int8 &convert=ExerciseStyle($$);
    price_code: bytes &size=2;
    market_code: bytes &size=4;
    market_segment_code: bytes &size=12;
    tick_size_id: uint32;
    lot_size: uint64;
    lot_size_type: uint8 &convert=LotSizeType($$);
