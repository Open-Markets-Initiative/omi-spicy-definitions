module LmeLmeselectReferencedatasnapshotLmesourceV418;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type LmeselectReferencedatasnapshotV418 = unit {
    packet_header: PacketHeader;
    messages: Messages[self.packet_header.msg_count];
};

type PacketHeader = unit {
    pkt_size: uint16;
    msg_count: uint8;
    filler: bytes &size=1;
    seq_num: uint32;
    send_time: uint64;
};

type Messages = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::SequenceResetMessage -> sequence_reset_message: SequenceResetMessage;
        MsgType::ContractDefinitionMessage -> contract_definition_message: ContractDefinitionMessage;
        MsgType::OutrightDefinitionMessage -> outright_definition_message: OutrightDefinitionMessage;
        MsgType::StrategyDefinitionMessage -> strategy_definition_message: StrategyDefinitionMessage;
        MsgType::PriceLimitsMessage -> price_limits_message: PriceLimitsMessage;
        MsgType::TradeStatisticsEndOfDayMessage -> trade_statistics_end_of_day_message: TradeStatisticsEndOfDayMessage;
        MsgType::RefreshCompleteMessage -> refresh_complete_message: RefreshCompleteMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_size: uint16;
    msg_type: uint16 &convert=MsgType($$);
};

type SequenceResetMessage = unit {
    new_seq_no: uint32;
};

type ContractDefinitionMessage = unit {
    trading_venue: bytes &size=2;
    contract_code: bytes &size=12;
    name: bytes &size=64;
    contract_type: uint8 &convert=ContractType($$);
    product_code: bytes &size=2;
    underlying_type: uint8 &convert=UnderlyingType($$);
    underlying_contract_code: bytes &size=12;
    trading_currency: bytes &size=3;
    settlement_type: uint8 &convert=SettlementType($$);
    settlement_pricing_method: uint8 &convert=SettlementPricingMethod($$);
    exercise_style: int8 &convert=ExerciseStyle($$);
    lot_unit: bytes &size=20;
    lot_size: uint64;
    lot_size_type: uint8 &convert=LotSizeType($$);
    contract_price_type: uint8 &convert=ContractPriceType($$);
    first_trading_date: uint32;
};

