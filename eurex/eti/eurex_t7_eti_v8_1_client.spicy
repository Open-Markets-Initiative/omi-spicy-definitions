module EurexT7EtiFbeV81Client;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type EurexT7EtiV81 = unit {
    client_message: ClientMessage[] &eod;
};

type ClientMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::AddComplexInstrumentRequest -> add_complex_instrument_request: AddComplexInstrumentRequest;
        TemplateId::AddFlexibleInstrumentRequest -> add_flexible_instrument_request: AddFlexibleInstrumentRequest;
        TemplateId::AmendBasketTradeRequest -> amend_basket_trade_request: AmendBasketTradeRequest;
        TemplateId::ApproveBasketTradeRequest -> approve_basket_trade_request: ApproveBasketTradeRequest;
        TemplateId::ApproveTesTradeRequest -> approve_tes_trade_request: ApproveTesTradeRequest;
        TemplateId::CrossRequest -> cross_request: CrossRequest;
        TemplateId::DeleteAllOrderRequest -> delete_all_order_request: DeleteAllOrderRequest;
        TemplateId::DeleteAllQuoteRequest -> delete_all_quote_request: DeleteAllQuoteRequest;
        TemplateId::DeleteBasketTradeRequest -> delete_basket_trade_request: DeleteBasketTradeRequest;
        TemplateId::DeleteClipRequest -> delete_clip_request: DeleteClipRequest;
        TemplateId::DeleteOrderComplexRequest -> delete_order_complex_request: DeleteOrderComplexRequest;
        TemplateId::DeleteOrderSingleRequest -> delete_order_single_request: DeleteOrderSingleRequest;
        TemplateId::DeleteTesTradeRequest -> delete_tes_trade_request: DeleteTesTradeRequest;
        TemplateId::EnterBasketTradeRequest -> enter_basket_trade_request: EnterBasketTradeRequest;
        TemplateId::EnterClipRequest -> enter_clip_request: EnterClipRequest;
        TemplateId::EnterTesTradeRequest -> enter_tes_trade_request: EnterTesTradeRequest;
        TemplateId::Heartbeat -> heartbeat: Heartbeat;
        TemplateId::InquireEnrichmentRuleIdListRequest -> inquire_enrichment_rule_id_list_request: InquireEnrichmentRuleIdListRequest;
        TemplateId::InquireMmParameterRequest -> inquire_mm_parameter_request: InquireMmParameterRequest;
        TemplateId::InquirePreTradeRiskLimitsRequest -> inquire_pre_trade_risk_limits_request: InquirePreTradeRiskLimitsRequest;
        TemplateId::InquireSessionListRequest -> inquire_session_list_request: InquireSessionListRequest;
        TemplateId::InquireUserRequest -> inquire_user_request: InquireUserRequest;
        TemplateId::LogonRequest -> logon_request: LogonRequest;
        TemplateId::LogoutRequest -> logout_request: LogoutRequest;
        TemplateId::MmParameterDefinitionRequest -> mm_parameter_definition_request: MmParameterDefinitionRequest;
        TemplateId::MassQuoteRequest -> mass_quote_request: MassQuoteRequest;
        TemplateId::ModifyBasketTradeRequest -> modify_basket_trade_request: ModifyBasketTradeRequest;
        TemplateId::ModifyOrderComplexRequest -> modify_order_complex_request: ModifyOrderComplexRequest;
        TemplateId::ModifyOrderComplexShortRequest -> modify_order_complex_short_request: ModifyOrderComplexShortRequest;
        TemplateId::ModifyOrderSingleRequest -> modify_order_single_request: ModifyOrderSingleRequest;
        TemplateId::ModifyOrderSingleShortRequest -> modify_order_single_short_request: ModifyOrderSingleShortRequest;
        TemplateId::ModifyTesTradeRequest -> modify_tes_trade_request: ModifyTesTradeRequest;
        TemplateId::NewOrderComplexRequest -> new_order_complex_request: NewOrderComplexRequest;
        TemplateId::NewOrderComplexShortRequest -> new_order_complex_short_request: NewOrderComplexShortRequest;
        TemplateId::NewOrderSingleRequest -> new_order_single_request: NewOrderSingleRequest;
        TemplateId::NewOrderSingleShortRequest -> new_order_single_short_request: NewOrderSingleShortRequest;
        TemplateId::PreTradeRiskLimitsDefinitionRequest -> pre_trade_risk_limits_definition_request: PreTradeRiskLimitsDefinitionRequest;
        TemplateId::QuoteActivationRequest -> quote_activation_request: QuoteActivationRequest;
        TemplateId::RfqRequest -> rfq_request: RfqRequest;
        TemplateId::RetransmitMeMessageRequest -> retransmit_me_message_request: RetransmitMeMessageRequest;
        TemplateId::RetransmitRequest -> retransmit_request: RetransmitRequest;
        TemplateId::SrqsEnterQuoteRequest -> srqs_enter_quote_request: SrqsEnterQuoteRequest;
        TemplateId::SrqsHitQuoteRequest -> srqs_hit_quote_request: SrqsHitQuoteRequest;
        TemplateId::SrqsInquireSmartRespondentRequest -> srqs_inquire_smart_respondent_request: SrqsInquireSmartRespondentRequest;
        TemplateId::SrqsOpenNegotiationRequest -> srqs_open_negotiation_request: SrqsOpenNegotiationRequest;
        TemplateId::SrqsQuotingStatusRequest -> srqs_quoting_status_request: SrqsQuotingStatusRequest;
        TemplateId::SrqsUpdateDealStatusRequest -> srqs_update_deal_status_request: SrqsUpdateDealStatusRequest;
        TemplateId::SrqsUpdateNegotiationRequest -> srqs_update_negotiation_request: SrqsUpdateNegotiationRequest;
        TemplateId::SubscribeRequest -> subscribe_request: SubscribeRequest;
        TemplateId::UnsubscribeRequest -> unsubscribe_request: UnsubscribeRequest;
        TemplateId::UploadTesTradeRequest -> upload_tes_trade_request: UploadTesTradeRequest;
        TemplateId::UserLoginRequest -> user_login_request: UserLoginRequest;
        TemplateId::UserLogoutRequest -> user_logout_request: UserLogoutRequest;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    body_len: uint32;
    template_id: uint16 &convert=TemplateId($$);
};

type AddComplexInstrumentRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    market_segment_id: int32;
    security_sub_type: int32;
    product_complex: uint8 &convert=ProductComplex($$);
    no_legs: uint8;
    compliance_text: bytes &size=20;
    : skip bytes &size=2;   # padding
    instrmt_leg_grp_comp: InstrmtLegGrpComp[self.no_legs];
};

type RequestHeaderComp = unit {
    msg_seq_num: uint32;
    sender_sub_id: uint32;
};

type InstrmtLegGrpComp = unit {
