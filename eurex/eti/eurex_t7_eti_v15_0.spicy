type MessageHeader = unit {
    body_len: uint32;
    template_id: uint16 &convert=TemplateId($$);
};

type AddComplexInstrumentRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    related_px: uint64;
    market_segment_id: int32;
    security_sub_type: int32;
    quantity_scaling_factor: uint16;
    product_complex: uint8 &convert=ProductComplex($$);
    no_leg_onbooks: uint8;
    multileg_model: uint8 &convert=MultilegModel($$);
    enable_custom_commodity_strip: uint8 &convert=EnableCustomCommodityStrip($$);
    compliance_text: bytes &size=20;
    display_name_alias: bytes &size=190;
    period_alias: bytes &size=45;
    : skip bytes &size=3;   # padding
    instrmt_leg_grp_comp: InstrmtLegGrpComp[self.no_leg_onbooks];
};

type RequestHeaderComp = unit {
    msg_seq_num: uint32;
    sender_sub_id: uint32;
};

type InstrmtLegGrpComp = unit {
    leg_security_id: int64;
    leg_price: uint64;
    leg_symbol: int32;
    leg_ratio_qty: uint32;
    leg_side: uint8 &convert=LegSide($$);
    leg_security_type: uint8 &convert=LegSecurityType($$);
    : skip bytes &size=6;   # padding
};

type AddComplexInstrumentResponse = unit {
    : skip bytes &size=2;   # padding
    nr_response_header_me_comp: NrResponseHeaderMeComp;
    low_limit_price: uint64;
    high_limit_price: uint64;
    related_px: uint64;
    security_id: int64;
    last_update_time: uint64;
    security_response_id: uint64;
    market_segment_id: int32;
    number_of_securities: int32;
    security_sub_type: int32;
    quantity_scaling_factor: uint16;
    multileg_model: uint8 &convert=MultilegModel($$);
    implied_market_indicator: uint8 &convert=ImpliedMarketIndicator($$);
    product_complex: uint8 &convert=ProductComplex($$);
    no_leg_onbooks: uint8;
    : skip bytes &size=6;   # padding
    instrmt_leg_grp_comp: InstrmtLegGrpComp[self.no_leg_onbooks];
};

type NrResponseHeaderMeComp = unit {
    request_time: uint64;
