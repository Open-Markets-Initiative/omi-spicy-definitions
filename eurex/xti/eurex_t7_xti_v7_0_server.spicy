    quote_id: uint64;
    quote_response_id: uint64;
    security_id: int64;
    bid_cxl_size: uint64;
    offer_cxl_size: uint64;
    market_segment_id: int32;
    : skip bytes &size=4;   # padding
};

type NrResponseHeaderMeComp = unit {
    request_time: uint64;
    trd_reg_ts_time_in: uint64;
    trd_reg_ts_time_out: uint64;
    response_in: uint64;
    sending_time: uint64;
    msg_seq_num: uint32;
    last_fragment: uint8 &convert=LastFragment($$);
    : skip bytes &size=3;   # padding
};

type BroadcastErrorNotification = unit {
    : skip bytes &size=2;   # padding
    notif_header_comp: NotifHeaderComp;
    appl_id_status: uint32 &convert=ApplIdStatus($$);
    ref_appl_sub_id: uint32;
    var_text_len: uint16;
    ref_appl_id: uint8 &convert=RefApplId($$);
    session_status: uint8 &convert=SessionStatus($$);
    : skip bytes &size=4;   # padding
    var_text: bytes &size=self.var_text_len;
    : skip bytes &size=0;   # padding
};

type NotifHeaderComp = unit {
