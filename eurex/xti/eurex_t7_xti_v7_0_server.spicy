module EurexT7XtiFbeV70Server;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type EurexT7XtiV70 = unit {
    server_message: ServerMessage[] &eod;
};

type ServerMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::BestQuoteExecutionReport -> best_quote_execution_report: BestQuoteExecutionReport;
        TemplateId::BestQuoteResponse -> best_quote_response: BestQuoteResponse;
        TemplateId::BroadcastErrorNotification -> broadcast_error_notification: BroadcastErrorNotification;
        TemplateId::CrossRequestResponse -> cross_request_response: CrossRequestResponse;
        TemplateId::DeleteAllOrderBroadcast -> delete_all_order_broadcast: DeleteAllOrderBroadcast;
        TemplateId::DeleteAllOrderNrResponse -> delete_all_order_nr_response: DeleteAllOrderNrResponse;
        TemplateId::DeleteAllOrderQuoteEventBroadcast -> delete_all_order_quote_event_broadcast: DeleteAllOrderQuoteEventBroadcast;
        TemplateId::DeleteAllOrderResponse -> delete_all_order_response: DeleteAllOrderResponse;
        TemplateId::DeleteAllQuoteBroadcast -> delete_all_quote_broadcast: DeleteAllQuoteBroadcast;
        TemplateId::DeleteAllQuoteResponse -> delete_all_quote_response: DeleteAllQuoteResponse;
        TemplateId::DeleteOrderBroadcast -> delete_order_broadcast: DeleteOrderBroadcast;
        TemplateId::DeleteOrderNrResponse -> delete_order_nr_response: DeleteOrderNrResponse;
        TemplateId::DeleteOrderResponse -> delete_order_response: DeleteOrderResponse;
        TemplateId::ExtendedDeletionReport -> extended_deletion_report: ExtendedDeletionReport;
        TemplateId::ForcedLogoutNotification -> forced_logout_notification: ForcedLogoutNotification;
        TemplateId::ForcedUserLogoutNotification -> forced_user_logout_notification: ForcedUserLogoutNotification;
        TemplateId::HeartbeatNotification -> heartbeat_notification: HeartbeatNotification;
        TemplateId::InquireEnrichmentRuleIdListResponse -> inquire_enrichment_rule_id_list_response: InquireEnrichmentRuleIdListResponse;
        TemplateId::InquireSessionListResponse -> inquire_session_list_response: InquireSessionListResponse;
        TemplateId::InquireUserResponse -> inquire_user_response: InquireUserResponse;
        TemplateId::IssuerNotification -> issuer_notification: IssuerNotification;
        TemplateId::IssuerSecurityStateChangeResponse -> issuer_security_state_change_response: IssuerSecurityStateChangeResponse;
        TemplateId::LegalNotificationBroadcast -> legal_notification_broadcast: LegalNotificationBroadcast;
        TemplateId::LogonResponse -> logon_response: LogonResponse;
        TemplateId::LogoutResponse -> logout_response: LogoutResponse;
        TemplateId::MassQuoteResponse -> mass_quote_response: MassQuoteResponse;
        TemplateId::ModifyOrderNrResponse -> modify_order_nr_response: ModifyOrderNrResponse;
        TemplateId::ModifyOrderResponse -> modify_order_response: ModifyOrderResponse;
        TemplateId::NewOrderNrResponse -> new_order_nr_response: NewOrderNrResponse;
        TemplateId::NewOrderResponse -> new_order_response: NewOrderResponse;
        TemplateId::NewsBroadcast -> news_broadcast: NewsBroadcast;
        TemplateId::OrderExecNotification -> order_exec_notification: OrderExecNotification;
        TemplateId::OrderExecReportBroadcast -> order_exec_report_broadcast: OrderExecReportBroadcast;
        TemplateId::OrderExecResponse -> order_exec_response: OrderExecResponse;
        TemplateId::PartyActionReport -> party_action_report: PartyActionReport;
        TemplateId::PartyEntitlementsUpdateReport -> party_entitlements_update_report: PartyEntitlementsUpdateReport;
        TemplateId::QuoteActivationNotification -> quote_activation_notification: QuoteActivationNotification;
        TemplateId::QuoteActivationResponse -> quote_activation_response: QuoteActivationResponse;
        TemplateId::QuoteExecutionReport -> quote_execution_report: QuoteExecutionReport;
        TemplateId::RfqBroadcast -> rfq_broadcast: RfqBroadcast;
        TemplateId::RfqResponse -> rfq_response: RfqResponse;
        TemplateId::Reject -> reject: Reject;
        TemplateId::RetransmitMeMessageResponse -> retransmit_me_message_response: RetransmitMeMessageResponse;
        TemplateId::RetransmitResponse -> retransmit_response: RetransmitResponse;
        TemplateId::ServiceAvailabilityBroadcast -> service_availability_broadcast: ServiceAvailabilityBroadcast;
        TemplateId::SubscribeResponse -> subscribe_response: SubscribeResponse;
        TemplateId::TesApproveBroadcast -> tes_approve_broadcast: TesApproveBroadcast;
        TemplateId::TesBroadcast -> tes_broadcast: TesBroadcast;
        TemplateId::TesDeleteBroadcast -> tes_delete_broadcast: TesDeleteBroadcast;
        TemplateId::TesExecutionBroadcast -> tes_execution_broadcast: TesExecutionBroadcast;
        TemplateId::TesResponse -> tes_response: TesResponse;
        TemplateId::TesTradeBroadcast -> tes_trade_broadcast: TesTradeBroadcast;
        TemplateId::TesTradingSessionStatusBroadcast -> tes_trading_session_status_broadcast: TesTradingSessionStatusBroadcast;
        TemplateId::TmTradingSessionStatusBroadcast -> tm_trading_session_status_broadcast: TmTradingSessionStatusBroadcast;
        TemplateId::ThrottleUpdateNotification -> throttle_update_notification: ThrottleUpdateNotification;
        TemplateId::TradeBroadcast -> trade_broadcast: TradeBroadcast;
        TemplateId::TradingSessionStatusBroadcast -> trading_session_status_broadcast: TradingSessionStatusBroadcast;
        TemplateId::TrailingStopUpdateNotification -> trailing_stop_update_notification: TrailingStopUpdateNotification;
        TemplateId::UnsubscribeResponse -> unsubscribe_response: UnsubscribeResponse;
        TemplateId::UserLoginResponse -> user_login_response: UserLoginResponse;
        TemplateId::UserLogoutResponse -> user_logout_response: UserLogoutResponse;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    body_len: uint32;
    template_id: uint16 &convert=TemplateId($$);
};

type BestQuoteExecutionReport = unit {
    : skip bytes &size=2;   # padding
    rbc_header_me_comp: RbcHeaderMeComp;
    exec_id: uint64;
    quote_msg_id: uint64;
    security_id: int64;
    quote_event_px: uint64;
    quote_event_qty: uint64;
    reserved_size: uint64;
    market_segment_id: int32;
    quote_event_match_id: uint32;
    quote_event_exec_id: int32;
    quote_event_type: uint8 &convert=QuoteEventType($$);
    quote_event_side: uint8 &convert=QuoteEventSide($$);
    : skip bytes &size=2;   # padding
};

type RbcHeaderMeComp = unit {
    trd_reg_ts_time_out: uint64;
    notification_in: uint64;
    sending_time: uint64;
    appl_sub_id: uint32;
    partition_id: uint16;
    appl_msg_id: bytes &size=16;
    appl_id: uint8 &convert=ApplId($$);
    appl_resend_flag: uint8 &convert=ApplResendFlag($$);
    last_fragment: uint8 &convert=LastFragment($$);
    : skip bytes &size=7;   # padding
};

type BestQuoteResponse = unit {
    : skip bytes &size=2;   # padding
