    party_id_order_origination_firm: bytes &size=7;
    party_id_beneficiary: bytes &size=9;
    party_id_location_id: bytes &size=2;
    cust_order_handling_inst: bytes &size=1;
    compliance_text: bytes &size=20;
    : skip bytes &size=1;   # padding
};

