    request_header_comp: RequestHeaderComp;
    security_id: int64;
    compliance_id: uint64;
    market_segment_id: int32;
    order_qty: int32;
    side: uint8 &convert=Side($$);
    compliance_text: bytes &size=20;
    : skip bytes &size=3;   # padding
};

type RetransmitMeMessageRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    subscription_scope: uint32;
    partition_id: uint16;
    ref_appl_id: uint8 &convert=RefApplId($$);
    appl_beg_msg_id: bytes &size=16;
    appl_end_msg_id: bytes &size=16;
    : skip bytes &size=1;   # padding
};

type RetransmitRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    appl_beg_seq_num: uint64;
    appl_end_seq_num: uint64;
    partition_id: uint16;
    ref_appl_id: uint8 &convert=RefApplId($$);
    : skip bytes &size=5;   # padding
};

type SubscribeRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    subscription_scope: uint32;
    ref_appl_id: uint8 &convert=RefApplId($$);
    : skip bytes &size=3;   # padding
};

type UnsubscribeRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    ref_appl_sub_id: uint32;
    : skip bytes &size=4;   # padding
};

type UploadTesTradeRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    security_id: int64;
    last_px: uint64;
    trans_bkd_time: uint64;
    underlying_px: uint64;
    underlying_qty: uint64;
    related_close_price: uint64;
    market_segment_id: int32;
    underlying_settlement_date: uint32;
    underlying_maturity_date: uint32;
    related_trade_id: uint32;
    related_market_segment_id: int32;
    related_trade_quantity: int32;
    trd_type: uint16 &convert=TrdType($$);
    product_complex: uint8 &convert=ProductComplex($$);
    trade_report_type: uint8 &convert=TradeReportType($$);
    trade_publish_indicator: uint8 &convert=TradePublishIndicator($$);
    no_side_allocs: uint8;
    no_events: uint8;
    no_instr_attrib: uint8;
    no_underlying_stips: uint8;
    skip_validations: uint8 &convert=SkipValidations($$);
    hedge_type: uint8 &convert=HedgeType($$);
    party_id_settlement_location: uint8 &convert=PartyIdSettlementLocation($$);
    trade_report_id: bytes &size=20;
    trade_report_text: bytes &size=20;
    underlying_security_id: bytes &size=12;
    underlying_security_desc: bytes &size=30;
    underlying_currency: bytes &size=3;
    underlying_issuer: bytes &size=30;
    : skip bytes &size=1;   # padding
    side_alloc_ext_grp_comp: SideAllocExtGrpComp[self.no_side_allocs];
    instrument_event_grp_comp: InstrumentEventGrpComp[self.no_events];
    instrument_attribute_grp_comp: InstrumentAttributeGrpComp[self.no_instr_attrib];
    underlying_stip_grp_comp: UnderlyingStipGrpComp[self.no_underlying_stips];
};

type SideAllocExtGrpComp = unit {
    compliance_id: uint64;
    individual_alloc_id: uint32;
    alloc_qty: int32;
    party_executing_firm: bytes &size=5;
    party_executing_trader: bytes &size=6;
    side: uint8 &convert=Side($$);
    trade_alloc_status: uint8 &convert=TradeAllocStatus($$);
    trading_capacity: uint8 &convert=TradingCapacity($$);
    position_effect: uint8 &convert=PositionEffect($$);
    account: bytes &size=2;
    party_id_position_account: bytes &size=32;
    party_id_take_up_trading_firm: bytes &size=5;
    free_text_1: bytes &size=12;
    free_text_2: bytes &size=12;
    free_text_3: bytes &size=12;
    party_id_order_origination_firm: bytes &size=7;
    party_id_beneficiary: bytes &size=9;
    party_id_location_id: bytes &size=2;
    cust_order_handling_inst: bytes &size=1;
    compliance_text: bytes &size=20;
    : skip bytes &size=7;   # padding
};

type UserLoginRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    username: uint32;
    password: bytes &size=32;
    : skip bytes &size=4;   # padding
};

type UserLogoutRequest = unit {
    network_msg_id: bytes &size=8;
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    username: uint32;
    : skip bytes &size=4;   # padding
};

