    side: uint8 &convert=Side($$);
    trade_report_id: bytes &size=20;
    position_effect: uint8 &convert=PositionEffect($$);
    party_executing_firm: bytes &size=5;
    party_executing_trader: bytes &size=6;
    account: bytes &size=2;
    free_text_1: bytes &size=12;
    free_text_2: bytes &size=12;
    free_text_3: bytes &size=12;
    party_id_take_up_trading_firm: bytes &size=5;
