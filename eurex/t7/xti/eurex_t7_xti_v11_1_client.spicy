module EurexT7XtiFbeV111Client;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type EurexT7XtiV111 = unit {
    client_message: ClientMessage[] &eod;
};

type ClientMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::ApproveTesTradeRequest -> approve_tes_trade_request: ApproveTesTradeRequest;
        TemplateId::CrossRequest -> cross_request: CrossRequest;
        TemplateId::DeleteAllOrderRequest -> delete_all_order_request: DeleteAllOrderRequest;
        TemplateId::DeleteAllQuoteRequest -> delete_all_quote_request: DeleteAllQuoteRequest;
        TemplateId::DeleteOrderSingleRequest -> delete_order_single_request: DeleteOrderSingleRequest;
        TemplateId::DeleteTesTradeRequest -> delete_tes_trade_request: DeleteTesTradeRequest;
        TemplateId::EnterTesTradeRequest -> enter_tes_trade_request: EnterTesTradeRequest;
        TemplateId::Heartbeat -> heartbeat: Heartbeat;
        TemplateId::InquireEnrichmentRuleIdListRequest -> inquire_enrichment_rule_id_list_request: InquireEnrichmentRuleIdListRequest;
        TemplateId::InquirePreTradeRiskLimitsRequest -> inquire_pre_trade_risk_limits_request: InquirePreTradeRiskLimitsRequest;
        TemplateId::InquireSessionListRequest -> inquire_session_list_request: InquireSessionListRequest;
        TemplateId::InquireUserRequest -> inquire_user_request: InquireUserRequest;
        TemplateId::IssuerSecurityStateChangeRequest -> issuer_security_state_change_request: IssuerSecurityStateChangeRequest;
        TemplateId::LogonRequest -> logon_request: LogonRequest;
        TemplateId::LogonRequestEncrypted -> logon_request_encrypted: LogonRequestEncrypted;
        TemplateId::LogoutRequest -> logout_request: LogoutRequest;
        TemplateId::MassQuoteRequest -> mass_quote_request: MassQuoteRequest;
        TemplateId::ModifyOrderSingleRequest -> modify_order_single_request: ModifyOrderSingleRequest;
        TemplateId::ModifyOrderSingleShortRequest -> modify_order_single_short_request: ModifyOrderSingleShortRequest;
        TemplateId::ModifyTesTradeRequest -> modify_tes_trade_request: ModifyTesTradeRequest;
        TemplateId::NewOrderSingleRequest -> new_order_single_request: NewOrderSingleRequest;
        TemplateId::NewOrderSingleShortRequest -> new_order_single_short_request: NewOrderSingleShortRequest;
        TemplateId::PingRequest -> ping_request: PingRequest;
        TemplateId::PreTradeRiskLimitsDefinitionRequest -> pre_trade_risk_limits_definition_request: PreTradeRiskLimitsDefinitionRequest;
        TemplateId::QuoteActivationRequest -> quote_activation_request: QuoteActivationRequest;
        TemplateId::RfqRequest -> rfq_request: RfqRequest;
        TemplateId::RetransmitMeMessageRequest -> retransmit_me_message_request: RetransmitMeMessageRequest;
        TemplateId::RetransmitRequest -> retransmit_request: RetransmitRequest;
        TemplateId::SingleQuoteRequest -> single_quote_request: SingleQuoteRequest;
        TemplateId::SpecialistRfqRejectRequest -> specialist_rfq_reject_request: SpecialistRfqRejectRequest;
        TemplateId::SpecialistRfqReplyRequest -> specialist_rfq_reply_request: SpecialistRfqReplyRequest;
        TemplateId::SpecialistSecurityStateChangeRequest -> specialist_security_state_change_request: SpecialistSecurityStateChangeRequest;
        TemplateId::SubscribeRequest -> subscribe_request: SubscribeRequest;
        TemplateId::UnsubscribeRequest -> unsubscribe_request: UnsubscribeRequest;
        TemplateId::UserLoginRequest -> user_login_request: UserLoginRequest;
        TemplateId::UserLoginRequestEncrypted -> user_login_request_encrypted: UserLoginRequestEncrypted;
        TemplateId::UserLogoutRequest -> user_logout_request: UserLogoutRequest;
        TemplateId::XetraEnLightApproveDealRequest -> xetra_en_light_approve_deal_request: XetraEnLightApproveDealRequest;
        TemplateId::XetraEnLightDeleteAllQuoteRequest -> xetra_en_light_delete_all_quote_request: XetraEnLightDeleteAllQuoteRequest;
        TemplateId::XetraEnLightEnterQuoteRequest -> xetra_en_light_enter_quote_request: XetraEnLightEnterQuoteRequest;
        TemplateId::XetraEnLightHitQuoteRequest -> xetra_en_light_hit_quote_request: XetraEnLightHitQuoteRequest;
        TemplateId::XetraEnLightOpenNegotiationRequest -> xetra_en_light_open_negotiation_request: XetraEnLightOpenNegotiationRequest;
        TemplateId::XetraEnLightQuoteSnapshotRequest -> xetra_en_light_quote_snapshot_request: XetraEnLightQuoteSnapshotRequest;
        TemplateId::XetraEnLightQuotingStatusRequest -> xetra_en_light_quoting_status_request: XetraEnLightQuotingStatusRequest;
        TemplateId::XetraEnLightUpdateNegotiationRequest -> xetra_en_light_update_negotiation_request: XetraEnLightUpdateNegotiationRequest;
        * -> unknown: bytes &eod;
