module EurexT7EdciFbeV130Client;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type EurexT7EdciV130 = unit {
    client_message: ClientMessage[] &eod;
};

type ClientMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::Heartbeat -> heartbeat: Heartbeat;
        TemplateId::LogonRequest -> logon_request: LogonRequest;
        TemplateId::LogoutRequest -> logout_request: LogoutRequest;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    body_len: uint32;
    template_id: uint16 &convert=TemplateId($$);
};

type Heartbeat = unit {
    : skip bytes &size=2;   # padding
};

type LogonRequest = unit {
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
    heart_bt_int: uint32;
    party_id_session_id: uint32;
    default_cstm_appl_ver_id: bytes &size=30;
    password: bytes &size=32;
    : skip bytes &size=2;   # padding
};

type RequestHeaderComp = unit {
    msg_seq_num: uint32;
    : skip bytes &size=4;   # padding
};

type LogoutRequest = unit {
    : skip bytes &size=2;   # padding
    request_header_comp: RequestHeaderComp;
};

type TemplateId = enum {
    DeleteOrderBroadcast = 10902,
    ForcedLogoutNotification = 10012,
    Heartbeat = 10011,
    HeartbeatNotification = 10023,
    LogonRequest = 10000,
    LogonResponse = 10001,
    LogoutRequest = 10002,
    LogoutResponse = 10003,
    OrderExecReportBroadcast = 10901,
    PartitionListNotification = 10037,
    Reject = 10010,
    SessionListNotification = 10036,
    SessionStatusBroadcast = 10903,
};

