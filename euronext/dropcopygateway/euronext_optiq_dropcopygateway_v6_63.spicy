        TemplateId::DcShortDeclarationRejectMessage -> dc_short_declaration_reject_message: DcShortDeclarationRejectMessage;
        TemplateId::DcShortDeclarationCancelMessage -> dc_short_declaration_cancel_message: DcShortDeclarationCancelMessage;
