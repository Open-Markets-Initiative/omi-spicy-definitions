    execution_algo_indicator: bytes &size=1;
    commodity_derivative_indicator: bytes &size=1;
    deferral_indicator: bytes &size=1;
    reserved_3: bytes &size=1;
};

type FreeTextGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    new_order_message_free_text_section_group: NewOrderMessageFreeTextSectionGroup[self.group_size_encoding.num_in_group];
};

type GroupSizeEncoding = unit {
    block_length_short: uint8;
    num_in_group: uint8;
};

type NewOrderMessageFreeTextSectionGroup = unit {
    free_text: bytes &size=18;
};

type MifidShortCodesGroups = unit {
