module EuronextOptiqOrderentrygatewaySbeV13;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type EuronextOptiqOrderentrygatewayV13 = unit {
    message: Message[] &eod;
};

type Message = unit {
    frame: uint16;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::NewOrderMessage -> new_order_message: NewOrderMessage;
        TemplateId::AckMessage -> ack_message: AckMessage;
        TemplateId::FillMessage -> fill_message: FillMessage;
        TemplateId::KillMessage -> kill_message: KillMessage;
        TemplateId::CancelReplaceMessage -> cancel_replace_message: CancelReplaceMessage;
        TemplateId::RejectMessage -> reject_message: RejectMessage;
        TemplateId::QuotesMessage -> quotes_message: QuotesMessage;
        TemplateId::QuoteAckMessage -> quote_ack_message: QuoteAckMessage;
        TemplateId::QuoteRequestMessage -> quote_request_message: QuoteRequestMessage;
        TemplateId::CancelRequestMessage -> cancel_request_message: CancelRequestMessage;
        TemplateId::MassCancelMessage -> mass_cancel_message: MassCancelMessage;
        TemplateId::MassCancelAckMessage -> mass_cancel_ack_message: MassCancelAckMessage;
        TemplateId::OpenOrderRequestMessage -> open_order_request_message: OpenOrderRequestMessage;
        TemplateId::OwnershipRequestAckMessage -> ownership_request_ack_message: OwnershipRequestAckMessage;
        TemplateId::OwnershipRequestMessage -> ownership_request_message: OwnershipRequestMessage;
        TemplateId::TradeBustNotificationMessage -> trade_bust_notification_message: TradeBustNotificationMessage;
        TemplateId::CollarBreachConfirmationMessage -> collar_breach_confirmation_message: CollarBreachConfirmationMessage;
        TemplateId::PriceInputMessage -> price_input_message: PriceInputMessage;
        TemplateId::LiquidityProviderCommandMessage -> liquidity_provider_command_message: LiquidityProviderCommandMessage;
        TemplateId::AskForQuoteMessage -> ask_for_quote_message: AskForQuoteMessage;
        TemplateId::RequestForExecutionMessage -> request_for_execution_message: RequestForExecutionMessage;
        TemplateId::RfqNotificationMessage -> rfq_notification_message: RfqNotificationMessage;
        TemplateId::RfqMatchingStatusMessage -> rfq_matching_status_message: RfqMatchingStatusMessage;
        TemplateId::UserNotificationMessage -> user_notification_message: UserNotificationMessage;
        TemplateId::DeclarationEntryMessage -> declaration_entry_message: DeclarationEntryMessage;
        TemplateId::DeclarationEntryAckMessage -> declaration_entry_ack_message: DeclarationEntryAckMessage;
        TemplateId::DeclarationNoticeMessage -> declaration_notice_message: DeclarationNoticeMessage;
        TemplateId::DeclarationCancelAndRefusalMessage -> declaration_cancel_and_refusal_message: DeclarationCancelAndRefusalMessage;
        TemplateId::FundPriceInputMessage -> fund_price_input_message: FundPriceInputMessage;
        TemplateId::FundPriceInputAckMessage -> fund_price_input_ack_message: FundPriceInputAckMessage;
        TemplateId::DeclarationEntryRejectMessage -> declaration_entry_reject_message: DeclarationEntryRejectMessage;
        TemplateId::InstrumentSynchronizationListMessage -> instrument_synchronization_list_message: InstrumentSynchronizationListMessage;
        TemplateId::SynchronizationTimeMessage -> synchronization_time_message: SynchronizationTimeMessage;
        TemplateId::LogonMessage -> logon_message: LogonMessage;
        TemplateId::LogonAckMessage -> logon_ack_message: LogonAckMessage;
        TemplateId::LogonRejectMessage -> logon_reject_message: LogonRejectMessage;
        TemplateId::LogoutMessage -> logout_message: LogoutMessage;
        TemplateId::TechnicalRejectMessage -> technical_reject_message: TechnicalRejectMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type NewOrderMessage = unit {
    cl_msg_seq_num: uint32;
    firm_id: bytes &size=8;
    sending_time: uint64;
    client_order_id: int64;
    symbol_index: uint32;
    emm: uint8 &convert=Emm($$);
    side: uint8 &convert=Side($$);
    order_type: uint8 &convert=OrderType($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    order_px: int64;
    order_qty: uint64;
    execution_within_firm_short_code: int32;
    trading_capacity: uint8 &convert=TradingCapacity($$);
    account_type: uint8 &convert=AccountType($$);
    lp_role_optional: uint8 &convert=LpRoleOptional($$);
    execution_instruction: ExecutionInstruction;
    dark_execution_instruction: DarkExecutionInstruction;
    mi_fid_indicators: MiFidIndicators;
    stpid: uint16;
    free_text_groups: FreeTextGroups;
    mifid_short_codes_groups: MifidShortCodesGroups;
    order_optional_fields_groups: OrderOptionalFieldsGroups;
    order_clearing_fields_groups: OrderClearingFieldsGroups;
};

type ExecutionInstruction = unit {
    stp_resting_order: bytes &size=1;
    stp_incoming_order: bytes &size=1;
    disclosed_quantity_randomization: bytes &size=1;
    disabled_cancel_on_disconnect_indicator: bytes &size=1;
    rfq_answer: bytes &size=1;
    rfq_confirmation: bytes &size=1;
    reserved_2: bytes &size=1;
};

type DarkExecutionInstruction = unit {
    dark_indicator: bytes &size=1;
    deferred_trade_indicator: bytes &size=1;
    displayed_order_interaction: bytes &size=1;
    sweep_order_indicator: bytes &size=1;
    minimum_quantity_type: bytes &size=1;
    reserved_3: bytes &size=1;
};

type MiFidIndicators = unit {
    dea_indicator: bytes &size=1;
