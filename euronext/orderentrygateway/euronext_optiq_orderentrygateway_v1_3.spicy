    non_executing_broker_short_code: int32;
    client_identification_shortcode: int32;
};

type OrderOptionalFieldsGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    order_optional_fields_group: OrderOptionalFieldsGroup[self.group_size_encoding.num_in_group];
};

type OrderOptionalFieldsGroup = unit {
    stop_px: int64;
