    peg_offset: int8;
    trading_session: TradingSession;
    undisclosed_iceberg_type: uint8 &convert=UndisclosedIcebergType($$);
    stop_triggered_time_in_force: uint8 &convert=StopTriggeredTimeInForce($$);
};

type TradingSession = unit {
