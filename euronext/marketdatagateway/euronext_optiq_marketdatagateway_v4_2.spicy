module EuronextOptiqMarketdatagatewaySbeV42;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type EuronextOptiqMarketdatagatewayV42 = unit {
    market_data_packet_header: MarketDataPacketHeader;
    optiq_message: OptiqMessage[] &eod;
};

type MarketDataPacketHeader = unit {
    packet_time: uint64;
    packet_sequence_number: uint32;
    packet_flags: PacketFlags;
    channel_id: uint16;
};

type PacketFlags = unit {
    compression: bytes &size=1;
    mdg_restart_count: uint8;
    psn_high_weight: uint8;
    has_start_of_day_snapshot: bytes &size=1;
    has_end_of_day_snapshot: bytes &size=1;
    has_status_message: bytes &size=1;
    : skip bytes &size=1;   # padding
};

type OptiqMessage = unit {
    frame: uint16;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::StartOfDayMessage -> start_of_day_message: StartOfDayMessage;
        TemplateId::EndOfDayMessage -> end_of_day_message: EndOfDayMessage;
        TemplateId::HealthStatusMessage -> health_status_message: HealthStatusMessage;
        TemplateId::TechnicalNotificationMessage -> technical_notification_message: TechnicalNotificationMessage;
        TemplateId::MarketUpdateMessage -> market_update_message: MarketUpdateMessage;
        TemplateId::OrderUpdateMessage -> order_update_message: OrderUpdateMessage;
        TemplateId::PriceUpdateMessage -> price_update_message: PriceUpdateMessage;
        TemplateId::FullTradeInformationMessage -> full_trade_information_message: FullTradeInformationMessage;
        TemplateId::MarketStatusChangeMessage -> market_status_change_message: MarketStatusChangeMessage;
        TemplateId::TimetableMessage -> timetable_message: TimetableMessage;
        TemplateId::StandingDataMessage -> standing_data_message: StandingDataMessage;
        TemplateId::RealTimeIndexMessage -> real_time_index_message: RealTimeIndexMessage;
        TemplateId::StatisticsMessage -> statistics_message: StatisticsMessage;
        TemplateId::IndexSummaryMessage -> index_summary_message: IndexSummaryMessage;
        TemplateId::StrategyStandingDataMessage -> strategy_standing_data_message: StrategyStandingDataMessage;
        TemplateId::ContractStandingDataMessage -> contract_standing_data_message: ContractStandingDataMessage;
        TemplateId::OutrightStandingDataMessage -> outright_standing_data_message: OutrightStandingDataMessage;
        TemplateId::LongOrderUpdateMessage -> long_order_update_message: LongOrderUpdateMessage;
        TemplateId::LisPackageStructureMessage -> lis_package_structure_message: LisPackageStructureMessage;
        TemplateId::ApaQuotesMessage -> apa_quotes_message: ApaQuotesMessage;
        TemplateId::ApaStandingDataMessage -> apa_standing_data_message: ApaStandingDataMessage;
        TemplateId::ApaFullTradeInformationMessage -> apa_full_trade_information_message: ApaFullTradeInformationMessage;
        TemplateId::BfInstrumentReferenceMessage -> bf_instrument_reference_message: BfInstrumentReferenceMessage;
        TemplateId::BfTradeMessage -> bf_trade_message: BfTradeMessage;
        TemplateId::BfnavMessage -> bfnav_message: BfnavMessage;
        TemplateId::BfInstrumentSuspensionMessage -> bf_instrument_suspension_message: BfInstrumentSuspensionMessage;
        TemplateId::StartOfSnapshotMessage -> start_of_snapshot_message: StartOfSnapshotMessage;
        TemplateId::EndOfSnapshotMessage -> end_of_snapshot_message: EndOfSnapshotMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type StartOfDayMessage = unit {
    md_seq_num: uint64;
    session_trading_day: uint16;
};

type EndOfDayMessage = unit {
    md_seq_num: uint64;
    session_trading_day: uint16;
};

type HealthStatusMessage = unit {
    md_seq_num: uint64;
    event_time: uint64;
};

type TechnicalNotificationMessage = unit {
    md_seq_num_optional: uint64;
    technical_notification_type: uint8 &convert=TechnicalNotificationType($$);
    rebroadcast_indicator: uint8;
    retransmission_start_time: uint64;
    retransmission_end_time: uint64;
    symbol_index_optional: uint32;
};

type MarketUpdateMessage = unit {
    md_seq_num: uint64;
    rebroadcast_indicator: uint8;
    emm: uint8 &convert=Emm($$);
    event_time: uint64;
    market_updates_groups: MarketUpdatesGroups;
};

type MarketUpdatesGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    market_updates_group: MarketUpdatesGroup[self.group_size_encoding.num_in_group];
};

type GroupSizeEncoding = unit {
    block_length_short: uint8;
    num_in_group: uint8;
};

type MarketUpdatesGroup = unit {
    update_type: uint8 &convert=UpdateType($$);
    symbol_index: uint32;
    number_of_orders: uint16;
    price: int64;
    quantity_optional: uint64;
};

