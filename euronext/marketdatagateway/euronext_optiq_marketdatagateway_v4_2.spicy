    order_updates_group: OrderUpdatesGroup[self.group_size_encoding.num_in_group];
};

type OrderUpdatesGroup = unit {
    symbol_index: uint32;
    action_type: uint8 &convert=ActionType($$);
    order_priority: uint64;
    previous_priority: uint64;
    order_type: uint8 &convert=OrderType($$);
    order_px: int64;
    order_side: uint8 &convert=OrderSide($$);
    order_quantity: uint64;
    peg_offset: int8;
