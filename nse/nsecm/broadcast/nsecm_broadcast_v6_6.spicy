    bb_total_sell_flag: int16 &convert=BbTotalSellFlag($$);
    total_buy_quantity: int64;
    total_sell_quantity: int64;
    mbo_mbp_indicator: bitfield(16) {
        reserved_112: 0..11;
        sell: 12;
