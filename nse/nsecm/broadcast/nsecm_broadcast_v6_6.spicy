module NseNsecmBroadcastNnfbcastV66;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsecmBroadcastV66 = unit {
    bcast_pack_data: BcastPackData;
};

type BcastPackData = unit {
    net_id: bytes &size=2;
    number_of_packets: int16;
    packed_packet: PackedPacket[self.number_of_packets];
};

type PackedPacket = unit {
    compression_length: int16;
    broadcast_data: BroadcastData;
};

type BroadcastData = unit {
    bcast_market_type: bytes &size=1;
    : skip bytes &size=7;   # padding
    bcast_header: BcastHeader;
    switch ( self.bcast_header.transaction_code ) {
        TransactionCode::BroadcastJournalVctMessage -> broadcast_journal_vct_message: BroadcastJournalVctMessage;
        TransactionCode::SecurityMasterChangeMessage -> security_master_change_message: SecurityMasterChangeMessage;
        TransactionCode::ParticipantMasterChangeMessage -> participant_master_change_message: ParticipantMasterChangeMessage;
        TransactionCode::SecurityStatusChangeMessage -> security_status_change_message: SecurityStatusChangeMessage;
        TransactionCode::SecurityStatusChangePreopenMessage -> security_status_change_preopen_message: SecurityStatusChangePreopenMessage;
        TransactionCode::TurnoverExceededMessage -> turnover_exceeded_message: TurnoverExceededMessage;
        TransactionCode::BrokerReactivatedMessage -> broker_reactivated_message: BrokerReactivatedMessage;
        TransactionCode::AuctionInquiryMessage -> auction_inquiry_message: AuctionInquiryMessage;
        TransactionCode::AuctionStatusChangeMessage -> auction_status_change_message: AuctionStatusChangeMessage;
        TransactionCode::PreopenShutdownMessage -> preopen_shutdown_message: PreopenShutdownMessage;
        TransactionCode::PreopenMarketOrderRestrictedMessage -> preopen_market_order_restricted_message: PreopenMarketOrderRestrictedMessage;
        TransactionCode::NormalMarketPreopenEndedMessage -> normal_market_preopen_ended_message: NormalMarketPreopenEndedMessage;
        TransactionCode::MarketOpenMessage -> market_open_message: MarketOpenMessage;
        TransactionCode::CtsCloseForCasMessage -> cts_close_for_cas_message: CtsCloseForCasMessage;
        TransactionCode::RevisedPriceBandCompletedMessage -> revised_price_band_completed_message: RevisedPriceBandCompletedMessage;
        TransactionCode::CasStartMessage -> cas_start_message: CasStartMessage;
        TransactionCode::MarketOrderRestrictedMessage -> market_order_restricted_message: MarketOrderRestrictedMessage;
        TransactionCode::CasEndMessage -> cas_end_message: CasEndMessage;
        TransactionCode::MarketCloseMessage -> market_close_message: MarketCloseMessage;
        TransactionCode::ClosingStartMessage -> closing_start_message: ClosingStartMessage;
        TransactionCode::ClosingEndMessage -> closing_end_message: ClosingEndMessage;
        TransactionCode::SymbolStatusChangeActionMessage -> symbol_status_change_action_message: SymbolStatusChangeActionMessage;
        TransactionCode::TickerAndMarketIndexMessage -> ticker_and_market_index_message: TickerAndMarketIndexMessage;
        TransactionCode::MarketByOrderAndMarketByPriceMessage -> market_by_order_and_market_by_price_message: MarketByOrderAndMarketByPriceMessage;
        TransactionCode::OnlyMarketByPriceMessage -> only_market_by_price_message: OnlyMarketByPriceMessage;
        TransactionCode::MarketWatchRoundRobinMessage -> market_watch_round_robin_message: MarketWatchRoundRobinMessage;
        TransactionCode::CallAuctionMarketByPriceMessage -> call_auction_market_by_price_message: CallAuctionMarketByPriceMessage;
        TransactionCode::CallAuctionMarketWatchMessage -> call_auction_market_watch_message: CallAuctionMarketWatchMessage;
        TransactionCode::SecurityOpenPriceMessage -> security_open_price_message: SecurityOpenPriceMessage;
        TransactionCode::IndicesMessage -> indices_message: IndicesMessage;
        TransactionCode::IndicativeIndicesMessage -> indicative_indices_message: IndicativeIndicesMessage;
        TransactionCode::IndicesVixMessage -> indices_vix_message: IndicesVixMessage;
        TransactionCode::IndustryIndicesMessage -> industry_indices_message: IndustryIndicesMessage;
        TransactionCode::BuyBackMessage -> buy_back_message: BuyBackMessage;
        TransactionCode::CallAuctionOrderCancelUpdateMessage -> call_auction_order_cancel_update_message: CallAuctionOrderCancelUpdateMessage;
        TransactionCode::CasReferencePriceMessage -> cas_reference_price_message: CasReferencePriceMessage;
        * -> unknown: bytes &eod;
    };
};

type BcastHeader = unit {
    : skip bytes &size=2;   # padding
    : skip bytes &size=2;   # padding
    log_time: int32;
    alpha_char: bytes &size=2;
    transaction_code: int16 &convert=TransactionCode($$);
    error_code: int16;
    bc_seq_no: int32;
    : skip bytes &size=1;   # padding
    : skip bytes &size=3;   # padding
    time_stamp_2: bytes &size=8;
    : skip bytes &size=8;   # padding
    message_length: int16;
};

type BroadcastJournalVctMessage = unit {
    branch_number: int16;
    broker_number: bytes &size=5;
    action_code_char_3: bytes &size=3;
    : skip bytes &size=4;   # padding
    broadcast_destination: bitfield(16) {
        reserved_115: 0..14;
        trader_ws: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broadcast_message_length: int16;
    broadcast_message: bytes &size=240;
};

type SecurityMasterChangeMessage = unit {
    token_long_4: int32;
    sec_info: SecInfo;
    instrument_type: int16 &convert=InstrumentType($$);
    permitted_to_trade: int16 &convert=PermittedToTrade($$);
    issued_capital: bytes &size=8;
    settlement_type: int16 &convert=SettlementType($$);
    freeze_percent: int16;
    credit_rating: bytes &size=19;
    : skip bytes &size=1;   # padding
    security_eligibility_per_market: SecurityEligibilityPerMarket[6];
    surv_ind: int16;
    issue_start_date: int32;
    interest_payment_date: int32;
    issue_maturity_date: int32;
    board_lot_quantity: int32;
    tick_size: int32;
    name: bytes &size=25;
    : skip bytes &size=1;   # padding
    listing_date: int32;
    expulsion_date: int32;
    re_admission_date: int32;
    record_date: int32;
    expiry_date: int32;
    no_delivery_start_date: int32;
    no_delivery_end_date: int32;
    eligiblity_indicators: bitfield(16) {
        reserved_113: 0..12;
        minimum_fill: 13;
        aon: 14;
        participate_in_market_index: 15;
    } &byte-order=spicy::ByteOrder::Big;
    book_closure_start_date: int32;
    book_closure_end_date: int32;
    purpose: bitfield(16) {
        reserved_110: 0..9;
        egm: 10;
        agm: 11;
        interest: 12;
        bonus: 13;
        rights: 14;
        dividend: 15;
    } &byte-order=spicy::ByteOrder::Big;
    local_update_date_time: int32;
    delete_flag: bytes &size=1;
    remark: bytes &size=25;
    face_value: int32;
    isin_number: bytes &size=12;
    mkt_maker_spread: int32;
    mkt_maker_min_qty: int32;
    call_auction_1_flag: int16;
};

type SecInfo = unit {
    symbol: bytes &size=10;
    series: bytes &size=2;
};

type SecurityEligibilityPerMarket = unit {
    security_eligibility_flags: bitfield(8) {
        reserved_17: 0..6;
        eligibility: 7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
    status: int16 &convert=Status($$);
};

type ParticipantMasterChangeMessage = unit {
    participant_id: bytes &size=12;
    participant_name: bytes &size=25;
    participant_status: uint8 &convert=ParticipantStatus($$);
    participant_update_date_time: int32;
    delete_flag: bytes &size=1;
    : skip bytes &size=1;   # padding
};

type SecurityStatusChangeMessage = unit {
    number_of_records: int16;
    token_and_eligibility: TokenAndEligibility[25];
};

type TokenAndEligibility = unit {
    token_long_4: int32;
    security_status_per_market: SecurityStatusPerMarket[6];
};

type SecurityStatusPerMarket = unit {
    status: int16 &convert=Status($$);
};

type SecurityStatusChangePreopenMessage = unit {
