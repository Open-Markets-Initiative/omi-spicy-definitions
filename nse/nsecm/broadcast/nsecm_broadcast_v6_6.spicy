type TransactionCode = enum {
    BroadcastJournalVctMessage = 6501,
    SecurityMasterChangeMessage = 18720,
    ParticipantMasterChangeMessage = 7306,
    SecurityStatusChangeMessage = 18130,
    SecurityStatusChangePreopenMessage = 18707,
    TurnoverExceededMessage = 9010,
    BrokerReactivatedMessage = 9011,
    AuctionInquiryMessage = 18700,
    AuctionStatusChangeMessage = 6581,
    PreopenShutdownMessage = 6531,
    PreopenMarketOrderRestrictedMessage = 6664,
    NormalMarketPreopenEndedMessage = 6571,
    MarketOpenMessage = 6511,
    CtsCloseForCasMessage = 6651,
    RevisedPriceBandCompletedMessage = 6652,
    CasStartMessage = 6653,
    MarketOrderRestrictedMessage = 6654,
    CasEndMessage = 6655,
