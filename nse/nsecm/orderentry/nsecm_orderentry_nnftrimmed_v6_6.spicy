type TradeConfirmationTrimmedMessage = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    log_time: int32;
    user_id: int32;
    timestamp: int64;
    time_stamp_1_char_8: bytes &size=8;
    response_order_number: bytes &size=8;
    time_stamp_2: bytes &size=1;
    broker_id: bytes &size=5;
    trader_num: int32;
    buy_sell: int16;
    account_num: bytes &size=10;
    original_vol: int32;
    disclosed_vol: int32;
    remaining_vol: int32;
    disclosed_vol_remaining: int32;
    price: int32;
    st_order_flags: bitfield(16) {
        reserved_1: 0;
        stpc: 1;
        reserved_3: 2;
        preopen: 3;
        frozen: 4;
        modified: 5;
        traded: 6;
        matched_ind: 7;
        mf: 8;
        aon: 9;
        ioc: 10;
        gtc: 11;
        day: 12;
        on_stop: 13;
        mkt: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    fill_number: int32;
    fill_qty: int32;
    fill_price: int32;
    vol_filled_today: int32;
    activity_type: bytes &size=2;
    activity_time: int32;
    sec_info: SecInfo;
    book_type: int16;
    pro_client: int16;
    pan: bytes &size=10;
    algo_id: int32;
    : skip bytes &size=2;   # padding
    last_activity_reference: int64;
    : skip bytes &size=52;   # padding
};

type QuickAcknowledgementMessage = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    trader_id: int32;
    timestamp: int64;
    reference: int32;
    error_code: int16;
    message_length: int16;
};

type TransactionCode = enum {
    OrderEntryRequestTrimmedMessage = 20000,
    OrderEntryRequestTrimmedMessage_20400 = 20400,
    OrderModifyCancelRequestTrimmedMessage = 20040,
    OrderModifyCancelRequestTrimmedMessage_20070 = 20070,
    OrderModifyCancelRequestTrimmedMessage_20402 = 20402,
    OrderModifyCancelRequestTrimmedMessage_20404 = 20404,
    OrderModifyCancelResponseTrimmedMessage = 20012,
    OrderModifyCancelResponseTrimmedMessage_20042 = 20042,
    OrderModifyCancelResponseTrimmedMessage_20072 = 20072,
    OrderModifyCancelResponseTrimmedMessage_20073 = 20073,
    OrderModifyCancelResponseTrimmedMessage_20074 = 20074,
    OrderModifyCancelResponseTrimmedMessage_20075 = 20075,
    OrderModifyCancelResponseTrimmedMessage_20231 = 20231,
    TradeConfirmationTrimmedMessage = 20222,
    QuickAcknowledgementMessage = 20401,
    QuickAcknowledgementMessage_20403 = 20403,
    QuickAcknowledgementMessage_20405 = 20405,
};

