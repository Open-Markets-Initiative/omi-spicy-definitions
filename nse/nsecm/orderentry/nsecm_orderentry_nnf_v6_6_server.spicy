    call_auction_1_flag: int16;
};

type SecuirityEligibilityPerMarket = unit {
    security_eligibility_indicator: bitfield(8) {
        security_eligibility_reserved: 0..6;
        eligibility: 7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
    status: int16 &convert=Status($$);
};

type EligiblityIndicators = unit {
    eligiblity_indicator: bitfield(8) {
        eligibility_reserved: 0..4;
        minimum_fill: 5;
        aon: 6;
        participate_in_market_index: 7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
};

type Purpose = unit {
    purpose_indicator: bitfield(8) {
        purpose_reserved: 0..1;
        egm: 2;
        agm: 3;
        interest: 4;
        bonus: 5;
        rights: 6;
        dividend: 7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
};

type SignOnRequestOutMessage = unit {
