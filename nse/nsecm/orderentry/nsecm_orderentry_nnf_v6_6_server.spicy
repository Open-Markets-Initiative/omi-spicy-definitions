module NseNsecmOrderentryNnfV66Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsecmOrderentryV66 = unit {
    server_message: ServerMessage[] &eod;
};

type ServerMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.transaction_code ) {
        TransactionCode::AuctionInquiryResponseMessage -> auction_inquiry_response_message: AuctionInquiryResponseMessage;
        TransactionCode::BranchOrderValueLimitUpdateOutMessage -> branch_order_value_limit_update_out_message: BranchOrderValueLimitUpdateOutMessage;
        TransactionCode::CancelOnLogoutStatusResponseMessage -> cancel_on_logout_status_response_message: CancelOnLogoutStatusResponseMessage;
        TransactionCode::ErrorResponseMessage -> error_response_message: ErrorResponseMessage;
        TransactionCode::SecureBoxRegistrationRequestMessage -> secure_box_registration_request_message: SecureBoxRegistrationRequestMessage;
        TransactionCode::BoxSignOnResponseMessage -> box_sign_on_response_message: BoxSignOnResponseMessage;
        TransactionCode::GatewayRouterResponseMessage -> gateway_router_response_message: GatewayRouterResponseMessage(self.message_header.message_length);
        TransactionCode::ControlMessageToTraderMessage -> control_message_to_trader_message: ControlMessageToTraderMessage;
        TransactionCode::TradeConfirmationMessage -> trade_confirmation_message: TradeConfirmationMessage;
        TransactionCode::TradeConfirmationMessage_2222 -> trade_confirmation_message: TradeConfirmationMessage;
        TransactionCode::TradeConfirmationMessage_2282 -> trade_confirmation_message: TradeConfirmationMessage;
        TransactionCode::TradeConfirmationMessage_2286 -> trade_confirmation_message: TradeConfirmationMessage;
        TransactionCode::TradeConfirmationMessage_2287 -> trade_confirmation_message: TradeConfirmationMessage;
        TransactionCode::OrderEntryOutMessage -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_2042 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_2061 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_2072 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_2073 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_2074 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_2075 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_2170 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_2231 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryOutMessage_9002 -> order_entry_out_message: OrderEntryOutMessage;
        TransactionCode::OrderEntryShortMessage -> order_entry_short_message: OrderEntryShortMessage;
        TransactionCode::OrderEntryShortMessage_2071 -> order_entry_short_message: OrderEntryShortMessage;
        TransactionCode::OrderLimitUpdateOutMessage -> order_limit_update_out_message: OrderLimitUpdateOutMessage;
        TransactionCode::PasswordResetOutMessage -> password_reset_out_message: PasswordResetOutMessage;
        TransactionCode::SecurityStatusChangeMessage -> security_status_change_message: SecurityStatusChangeMessage;
        TransactionCode::SecurityStatusChangeMessage_18707 -> security_status_change_message: SecurityStatusChangeMessage;
        TransactionCode::SecurityMasterChangeMessage -> security_master_change_message: SecurityMasterChangeMessage;
        TransactionCode::SignOnRequestOutMessage -> sign_on_request_out_message: SignOnRequestOutMessage;
        TransactionCode::SignOnResponseMessage -> sign_on_response_message: SignOnResponseMessage;
        TransactionCode::SystemInformationMessage -> system_information_message: SystemInformationMessage;
        TransactionCode::SystemInformationMessage_7321 -> system_information_message: SystemInformationMessage;
        TransactionCode::TradeInquiryOutMessage -> trade_inquiry_out_message: TradeInquiryOutMessage;
        TransactionCode::TradeInquiryOutMessage_5441 -> trade_inquiry_out_message: TradeInquiryOutMessage;
        TransactionCode::UpdateLocalDatabaseHeaderMessage -> update_local_database_header_message: UpdateLocalDatabaseHeaderMessage;
        TransactionCode::UpdateLocalDatabaseTrailerMessage -> update_local_database_trailer_message: UpdateLocalDatabaseTrailerMessage;
        TransactionCode::UserUnlockApprovalRejectionMessage -> user_unlock_approval_rejection_message: UserUnlockApprovalRejectionMessage;
        TransactionCode::UserUnlockApprovalRejectionMessage_5579 -> user_unlock_approval_rejection_message: UserUnlockApprovalRejectionMessage;
        TransactionCode::UserUnlockRequestedResponseMessage -> user_unlock_requested_response_message: UserUnlockRequestedResponseMessage;
        TransactionCode::UserOrderValueLimitUpdateOutMessage -> user_order_value_limit_update_out_message: UserOrderValueLimitUpdateOutMessage;
        TransactionCode::TradeModificationCancellationStatusResponseMessage -> trade_modification_cancellation_status_response_message: TradeModificationCancellationStatusResponseMessage;
        TransactionCode::UpdateLocalDatabaseDataMessage -> update_local_database_data_message: UpdateLocalDatabaseDataMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    log_time: int32;
    alpha_char: bytes &size=2;
    trader_id: int32;
    error_code: int16;
    header_timestamp: int64;
    time_stamp_1: bytes &size=8;
    time_stamp_2: bytes &size=8;
    message_length: int16;
};

type AuctionInquiryResponseMessage = unit {
    number_of_records: int16;
    inquirydata: Inquirydata[5];
};

type Inquirydata = unit {
    token: int32;
    auction_number: int16;
    auction_status: int16 &convert=AuctionStatus($$);
    initiator_type: int16;
    total_buy: int32;
    best_buy_price: int32;
    total_sell: int32;
    best_sell_price: int32;
    auctioin_price: int32;
    auction_quantity: int32;
    settlement_period: int16;
};

type BranchOrderValueLimitUpdateOutMessage = unit {
    broker_id: bytes &size=5;
    : skip bytes &size=25;   # padding
    branch: int16;
    branch_limit: BranchLimit;
};

type BranchLimit = unit {
    branch_buy_value_limit: bytes &size=8;
    : skip bytes &size=8;   # padding
    branch_sell_value_limit: bytes &size=8;
    : skip bytes &size=8;   # padding
};

type CancelOnLogoutStatusResponseMessage = unit {
    user_id: int32;
    colo_user_bit: bytes &size=1;
    : skip bytes &size=1;   # padding
};

type ErrorResponseMessage = unit {
    sec_info: SecInfo;
    error_message: bytes &size=128;
};

type SecInfo = unit {
    symbol: bytes &size=10;
    series: bytes &size=2;
};

type SecureBoxRegistrationRequestMessage = unit {
    box_id: int16;
};

type BoxSignOnResponseMessage = unit {
    box_id: int16;
    : skip bytes &size=10;   # padding
};

type GatewayRouterResponseMessage = unit(message_length: int16) {
    box_id: int16;
    broker_id: bytes &size=5;
    filler: bytes &size=1;
    ip_address: bytes &size=16;
    port_field: int32;
    session_key: bytes &size=8;
    cryptographic_key: bytes &size=32;
    cryptographic_tail: CryptographicTail(message_length);
};

type CryptographicTail = unit(message_length: int16) {
    switch ( message_length ) {
        124 -> existing_encryption_tail: ExistingEncryptionTail;
        136 -> new_encryption_tail: NewEncryptionTail;
        * -> unknown: bytes &eod;
    };
};

type ExistingEncryptionTail = unit {
    cryptographic_iv: bytes &size=16;
};

type NewEncryptionTail = unit {
    static_cryptographic_iv: bytes &size=8;
    dynamic_cryptographic_iv: int64;
    cryptographic_additional_key: bytes &size=12;
};

type ControlMessageToTraderMessage = unit {
    trader_id: int32;
    action_code: bytes &size=3;
    : skip bytes &size=1;   # padding
    msg_length: int16;
    msg: bytes &size=240;
};

type TradeConfirmationMessage = unit {
    response_order_number: bytes &size=8;
    broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    trader_num: int32;
    account_num: bytes &size=10;
    buy_sell: int16;
    original_vol: int32;
    disclosed_vol: int32;
    remaining_vol: int32;
    disclosed_vol_remaining: int32;
    price: int32;
    st_order_flags: bitfield(16) {
        order_flags_reserved_one: 0;
        stpc: 1;
        order_flags_reserved_three: 2;
        preopen: 3;
        frozen: 4;
        modified: 5;
        traded: 6;
        matched_ind: 7;
        mf: 8;
        aon: 9;
        ioc: 10;
        gtc: 11;
        day: 12;
        on_stop: 13;
        mkt: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    gtd: int32;
    fill_number: int32;
    fill_qty: int32;
    fill_price: int32;
    vol_filled_today: int32;
    activity_type: bytes &size=2;
    activity_time: int32;
    op_order_number: bytes &size=8;
    op_broker_id: bytes &size=5;
    sec_info: SecInfo;
    : skip bytes &size=1;   # padding
    book_type: int16 &convert=BookType($$);
    new_volume: int32;
    pro_client: int16;
    pan: bytes &size=10;
    algo_id: int32;
    : skip bytes &size=2;   # padding
    last_activity_reference: int64;
    : skip bytes &size=52;   # padding
};

