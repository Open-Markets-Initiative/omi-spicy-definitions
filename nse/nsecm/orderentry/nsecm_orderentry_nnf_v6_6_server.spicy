    version_number: int32;
    : skip bytes &size=56;   # padding
    user_type: int16;
    sequence_number: bytes &size=8;
    workstation_number: bytes &size=14;
    broker_status: bytes &size=1;
    show_index: bytes &size=1;
    broker_eligibility_per_market: bitfield(16) {
        preopen: 0;
        broker_eligibility_reserved_upper: 1..7;
        broker_eligibility_reserved_lower: 8..9;
        call_auction_21: 10;
        call_auction_11: 11;
        auction_market: 12;
        spot_market: 13;
        oddlot_market: 14;
        normal_market: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broker_name: bytes &size=26;
    : skip bytes &size=16;   # padding
    : skip bytes &size=16;   # padding
    : skip bytes &size=16;   # padding
};

