    surv_ind: int16;
    issue_start_date: int32;
    interest_payment_date: int32;
    issue_maturity_date: int32;
    board_lot_quantity: int32;
    tick_size: int32;
    name: bytes &size=25;
    : skip bytes &size=1;   # padding
