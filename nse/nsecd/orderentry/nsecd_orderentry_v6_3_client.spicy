module NseNsecdOrderentryNnfV63Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsecdOrderentryV63 = unit {
    client_message: ClientMessage[] &eod;
};

type ClientMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.transaction_code ) {
        TransactionCode::SystemInformationInMessage -> system_information_in_message: SystemInformationInMessage;
        TransactionCode::BoardLotInMessage -> board_lot_in_message: BoardLotInMessage;
        TransactionCode::OrderModInMessage -> order_mod_in_message: OrderModInMessage;
        TransactionCode::OrderCancelInMessage -> order_cancel_in_message: OrderCancelInMessage;
        TransactionCode::PriceModInMessage -> price_mod_in_message: PriceModInMessage;
        TransactionCode::SpBoardLotInMessage -> sp_board_lot_in_message: SpBoardLotInMessage;
        TransactionCode::TwolBoardLotInMessage -> twol_board_lot_in_message: TwolBoardLotInMessage;
        TransactionCode::ThrlBoardLotInMessage -> thrl_board_lot_in_message: ThrlBoardLotInMessage;
        TransactionCode::SpOrderCancelInMessage -> sp_order_cancel_in_message: SpOrderCancelInMessage;
        TransactionCode::SpOrderModInMessage -> sp_order_mod_in_message: SpOrderModInMessage;
        TransactionCode::TradeCancelInMessage -> trade_cancel_in_message: TradeCancelInMessage;
        TransactionCode::TradeModInMessage -> trade_mod_in_message: TradeModInMessage;
        TransactionCode::SignOnRequestInMessage -> sign_on_request_in_message: SignOnRequestInMessage;
        TransactionCode::SignOffTraderInMessage -> sign_off_trader_in_message: SignOffTraderInMessage;
        TransactionCode::GrRequestMessage -> gr_request_message: GrRequestMessage;
        TransactionCode::UserAddrUnlockInMessage -> user_addr_unlock_in_message: UserAddrUnlockInMessage;
        TransactionCode::BranchOrdValLimitUpdateInMessage -> branch_ord_val_limit_update_in_message: BranchOrdValLimitUpdateInMessage;
        TransactionCode::UserOrdValLimitUpdateInMessage -> user_ord_val_limit_update_in_message: UserOrdValLimitUpdateInMessage;
        TransactionCode::NormalOrdLimitUpdateInMessage -> normal_ord_limit_update_in_message: NormalOrdLimitUpdateInMessage;
        TransactionCode::SpreadOrdLimitUpdateInMessage -> spread_ord_limit_update_in_message: SpreadOrdLimitUpdateInMessage;
        TransactionCode::ResetUserPasswordInMessage -> reset_user_password_in_message: ResetUserPasswordInMessage;
        TransactionCode::ColUserStatusChangeInMessage -> col_user_status_change_in_message: ColUserStatusChangeInMessage;
        TransactionCode::DownloadRequestMessage -> download_request_message: DownloadRequestMessage;
        TransactionCode::UpdateLocaldbInMessage -> update_localdb_in_message: UpdateLocaldbInMessage;
        TransactionCode::BoxSignOnRequestInMessage -> box_sign_on_request_in_message: BoxSignOnRequestInMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    log_time: int32;
    alpha_char: bytes &size=2;
    trader_id: int32;
    error_code: int16;
    header_timestamp: int64;
    time_stamp_1: bytes &size=8;
    time_stamp_2: bytes &size=8;
    message_length: int16;
};

type SystemInformationInMessage = unit {
    last_update_portfolio_t_ime: int32;
};

type BoardLotInMessage = unit {
    participant_type: bytes &size=1;
    : skip bytes &size=1;   # padding
    competitor_period: int16;
    solicitor_period: int16;
    modified_cancelled_by: bytes &size=1;
    : skip bytes &size=1;   # padding
    reason_code: int16;
    : skip bytes &size=4;   # padding
    token_no: int32;
    contract_desc: ContractDesc;
    counter_party_broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    : skip bytes &size=2;   # padding
    closeout_flag: bytes &size=1;
    : skip bytes &size=1;   # padding
    order_type: int16;
    order_number: bytes &size=8;
    account_number: bytes &size=10;
    book_type_short_2: int16;
    buy_sell_indicator: int16;
    disclosed_volume: int32;
    disclosed_volume_remaining: int32;
    total_volume_remaining: int32;
    volume: int32;
    volume_filled_today: int32;
    price: int32;
    trigger_price: int32;
    good_till_date: int32;
    entry_date_time: int32;
    minimum_fill_aon_volume: int32;
    last_modified: int32;
    st_order_flags: bitfield(16) {
        reserved_13: 0..2;
        frozen: 3;
        modified: 4;
        traded: 5;
        matched_ind: 6;
        mf: 7;
        aon: 8;
        ioc: 9;
        gtc: 10;
        day: 11;
        mit: 12;
        sl: 13;
        market: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    branch_id: int16;
    trader_id: int32;
    broker_id: bytes &size=5;
    c_ord_filler: bytes &size=24;
    open_close: bytes &size=1;
    settlor: bytes &size=12;
    pro_client_indicator: int16;
    settlement_period: int16;
    additional_order_flags: bitfield(8) {
        additional_order_flags_reserved_1: 0;
        col: 1;
        additional_order_flags_reserved_3: 2;
        additional_order_flags_reserved_4: 3;
        stpc: 4;
        additional_order_flags_reserved_68: 5..7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
    reference: bytes &size=4;
    nnf_field: bytes &size=8;
    mkt_replay: int64;
    pan: bytes &size=10;
    algo_id: int32;
    : skip bytes &size=2;   # padding
    last_activity_reference: int64;
    : skip bytes &size=52;   # padding
};

type ContractDesc = unit {
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    expiry_date: int32;
    strike_price: int32;
    option_type: bytes &size=2;
    ca_level: int16;
};

