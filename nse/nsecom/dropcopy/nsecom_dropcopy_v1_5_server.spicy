    last_modified_date_time: int32;
    initiated_by_control: bytes &size=1;
    open_close: uint8 &convert=OpenClose($$);
    : skip bytes &size=1;   # padding
    participant: bytes &size=12;
    giveup_flag: bytes &size=1;
    deleted: bytes &size=1;
    : skip bytes &size=1;   # padding
};

type TransactionCode = enum {
    SignonInMessage = 2300,
    SignOnOutMessage = 2301,
    HeartbeatMessage = 23506,
    DcDownloadRequestMessage = 8000,
    TradeConfirmationMessage = 2222,
    TradeCancelConfirmMessage = 2282,
    TradeCancelRejectMessage = 2286,
    TradeModifyConfirmMessage = 2287,
    TradeModifyRejectMessage = 2288,
    GiveupAppConfirmTmMessage = 4506,
    GiveupRejConfirmTmMessage = 4507,
};

type BuySell = enum {
    BuyOrder = 1,
    SellOrder = 2,
};

type ActivityType = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type OpenClose = enum {
    Open = 0x4f,
    Close = 0x43,
};

type BookTypeShort2 = enum {
    RegularLotOrder = 1,
    SpecialTermsOrder = 2,
    StopLossMitOrder = 3,
    NegotiatedOrderNotUsed = 4,
    OddLotOrderNotUsed = 5,
    SpotOrderNotUsed = 6,
    AuctionOrderNotUsed = 7,
};

