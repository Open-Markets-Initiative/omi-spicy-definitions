type GiveupAppConfirmTmMessage = unit {
    reason_code: int16;
    order_number: bytes &size=8;
    fill_number: int32;
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    expiry_date: int32;
    strike_price: int32;
    option_type: bytes &size=2;
    ca_level: int16;
    fill_volume: int32;
    fill_price: int32;
    broker_id: bytes &size=5;
    filler: bytes &size=1;
    buy_sell: int16 &convert=BuySell($$);
    book_type_short_2: int16 &convert=BookTypeShort2($$);
    last_modified_date_time: int32;
    initiated_by_control: bytes &size=1;
    open_close: uint8 &convert=OpenClose($$);
    : skip bytes &size=1;   # padding
    participant: bytes &size=12;
    giveup_flag: bytes &size=1;
    deleted: bytes &size=1;
    : skip bytes &size=1;   # padding
};

type GiveupRejConfirmTmMessage = unit {
    reason_code: int16;
    order_number: bytes &size=8;
