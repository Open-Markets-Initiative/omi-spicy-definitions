module NseNsecomOrderentryNnfV35Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsecomOrderentryV35 = unit {
    server_message: ServerMessage[] &eod;
};

type ServerMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.transaction_code ) {
        TransactionCode::SystemInformationOutMessage -> system_information_out_message: SystemInformationOutMessage;
        TransactionCode::PartialSystemInformationMessage -> partial_system_information_message: PartialSystemInformationMessage;
        TransactionCode::OpenOrderReportMessage -> open_order_report_message: OpenOrderReportMessage;
        TransactionCode::SpreadOrderLogReportMessage -> spread_order_log_report_message: SpreadOrderLogReportMessage;
        TransactionCode::SpreadTradeReportMessage -> spread_trade_report_message: SpreadTradeReportMessage;
        TransactionCode::BoardLotOutMessage -> board_lot_out_message: BoardLotOutMessage;
        TransactionCode::NegOrderToBlMessage -> neg_order_to_bl_message: NegOrderToBlMessage;
        TransactionCode::OrderModOutMessage -> order_mod_out_message: OrderModOutMessage;
        TransactionCode::OrderModRejectMessage -> order_mod_reject_message: OrderModRejectMessage;
        TransactionCode::OrderCancelOutMessage -> order_cancel_out_message: OrderCancelOutMessage;
        TransactionCode::OrderCancelRejectMessage -> order_cancel_reject_message: OrderCancelRejectMessage;
        TransactionCode::OrderConfirmationMessage -> order_confirmation_message: OrderConfirmationMessage;
        TransactionCode::OrderModConfirmationMessage -> order_mod_confirmation_message: OrderModConfirmationMessage;
        TransactionCode::OrderCancelConfirmationMessage -> order_cancel_confirmation_message: OrderCancelConfirmationMessage;
        TransactionCode::CancelNegOrderMessage -> cancel_neg_order_message: CancelNegOrderMessage;
        TransactionCode::FreezeToControlMessage -> freeze_to_control_message: FreezeToControlMessage;
        TransactionCode::OrderErrorMessage -> order_error_message: OrderErrorMessage;
        TransactionCode::BatchOrderCancelMessage -> batch_order_cancel_message: BatchOrderCancelMessage;
        TransactionCode::SpBoardLotOutMessage -> sp_board_lot_out_message: SpBoardLotOutMessage;
        TransactionCode::TwolBoardLotOutMessage -> twol_board_lot_out_message: TwolBoardLotOutMessage;
        TransactionCode::ThrlBoardLotOutMessage -> thrl_board_lot_out_message: ThrlBoardLotOutMessage;
        TransactionCode::SpOrderCancelOutMessage -> sp_order_cancel_out_message: SpOrderCancelOutMessage;
        TransactionCode::SpOrderModOutMessage -> sp_order_mod_out_message: SpOrderModOutMessage;
        TransactionCode::SpOrderConfirmationMessage -> sp_order_confirmation_message: SpOrderConfirmationMessage;
        TransactionCode::TwolOrderConfirmationMessage -> twol_order_confirmation_message: TwolOrderConfirmationMessage;
        TransactionCode::ThrlOrderConfirmationMessage -> thrl_order_confirmation_message: ThrlOrderConfirmationMessage;
        TransactionCode::SpOrderCxlRejOutMessage -> sp_order_cxl_rej_out_message: SpOrderCxlRejOutMessage;
        TransactionCode::SpOrderCxlConfirmationMessage -> sp_order_cxl_confirmation_message: SpOrderCxlConfirmationMessage;
        TransactionCode::TwolOrderCxlConfirmationMessage -> twol_order_cxl_confirmation_message: TwolOrderCxlConfirmationMessage;
        TransactionCode::ThrlOrderCxlConfirmationMessage -> thrl_order_cxl_confirmation_message: ThrlOrderCxlConfirmationMessage;
        TransactionCode::SpOrderModRejOutMessage -> sp_order_mod_rej_out_message: SpOrderModRejOutMessage;
        TransactionCode::SpOrderModConOutMessage -> sp_order_mod_con_out_message: SpOrderModConOutMessage;
        TransactionCode::TwolOrderErrorMessage -> twol_order_error_message: TwolOrderErrorMessage;
        TransactionCode::ThrlOrderErrorMessage -> thrl_order_error_message: ThrlOrderErrorMessage;
        TransactionCode::OnStopNotificationMessage -> on_stop_notification_message: OnStopNotificationMessage;
        TransactionCode::TradeConfirmationMessage -> trade_confirmation_message: TradeConfirmationMessage;
        TransactionCode::TradeCancelConfirmMessage -> trade_cancel_confirm_message: TradeCancelConfirmMessage;
        TransactionCode::TradeCancelRejectMessage -> trade_cancel_reject_message: TradeCancelRejectMessage;
        TransactionCode::TradeModifyRejectMessage -> trade_modify_reject_message: TradeModifyRejectMessage;
        TransactionCode::TradeErrorMessage -> trade_error_message: TradeErrorMessage;
        TransactionCode::TradeCancelOutMessage -> trade_cancel_out_message: TradeCancelOutMessage;
        TransactionCode::TradeModifyConfirmMessage -> trade_modify_confirm_message: TradeModifyConfirmMessage;
        TransactionCode::SignOnRequestOutMessage -> sign_on_request_out_message: SignOnRequestOutMessage;
        TransactionCode::SignOffTraderOutMessage -> sign_off_trader_out_message: SignOffTraderOutMessage;
        TransactionCode::ErrorResponseOutMessage -> error_response_out_message: ErrorResponseOutMessage;
        TransactionCode::GrResponseMessage -> gr_response_message: GrResponseMessage;
        TransactionCode::UserAddrUnlockConfirmOutMessage -> user_addr_unlock_confirm_out_message: UserAddrUnlockConfirmOutMessage;
        TransactionCode::UserAddrUnlockApproveOutMessage -> user_addr_unlock_approve_out_message: UserAddrUnlockApproveOutMessage;
        TransactionCode::UserAddrUnlockRejectOutMessage -> user_addr_unlock_reject_out_message: UserAddrUnlockRejectOutMessage;
        TransactionCode::BranchOrdValLimitUpdateOuMessage -> branch_ord_val_limit_update_ou_message: BranchOrdValLimitUpdateOuMessage;
        TransactionCode::UserOrderLimitUpdateOutMessage -> user_order_limit_update_out_message: UserOrderLimitUpdateOutMessage;
        TransactionCode::DealerLimitUpdateOutMessage -> dealer_limit_update_out_message: DealerLimitUpdateOutMessage;
        TransactionCode::ResetUserPasswordOutMessage -> reset_user_password_out_message: ResetUserPasswordOutMessage;
        TransactionCode::ColUserStatusChangeOutMessage -> col_user_status_change_out_message: ColUserStatusChangeOutMessage;
        TransactionCode::SpdOrdLimitUpdateOutMessage -> spd_ord_limit_update_out_message: SpdOrdLimitUpdateOutMessage;
        TransactionCode::UpdateLocaldbHeaderMessage -> update_localdb_header_message: UpdateLocaldbHeaderMessage;
        TransactionCode::UpdateLocaldbTrailerMessage -> update_localdb_trailer_message: UpdateLocaldbTrailerMessage;
        TransactionCode::BcastAssetMstrChgMessage -> bcast_asset_mstr_chg_message: BcastAssetMstrChgMessage;
        TransactionCode::BoxSignOnRequestOutMessage -> box_sign_on_request_out_message: BoxSignOnRequestOutMessage;
        TransactionCode::BoxSignOffMessage -> box_sign_off_message: BoxSignOffMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    log_time: int32;
    alpha_char: bytes &size=2;
    trader_id: int32;
    error_code: int16;
    header_timestamp: int64;
    time_stamp_1: bytes &size=8;
    time_stamp_2: bytes &size=8;
    message_length: int16;
};

type SystemInformationOutMessage = unit {
    st_market_status: StMarketStatus;
    st_ex_market_status: StExMarketStatus;
    st_pl_market_status: StPlMarketStatus;
    update_portfolio: bytes &size=1;
    c_filler: bytes &size=1;
    market_index: int32;
    default_settlement_period_normal: int16;
    default_settlement_period_spot: int16;
    default_settlement_period_auction: int16;
    competitor_period: int16;
    solicitor_period: int16;
    warning_percent: int16;
    volume_freeze_percent: int16;
    snap_quote_time: int16;
    : skip bytes &size=2;   # padding
    board_lot_quantity: int32;
    tick_size: int32;
    maximum_gtc_days: int16;
    st_stock_eligible_indicators: bitfield(16) {
        reserved_113: 0..12;
        books_merged: 13;
        minimum_fill: 14;
        aon: 15;
    } &byte-order=spicy::ByteOrder::Big;
    disclosed_quantity_percent_allowed: int16;
    risk_free_interest_rate: int32;
};

type StMarketStatus = unit {
    normal: int16;
    oddlot: int16;
    spot: int16;
    auction: int16;
};

type StExMarketStatus = unit {
    normal: int16;
    oddlot: int16;
    spot: int16;
    auction: int16;
};

type StPlMarketStatus = unit {
    normal: int16;
    oddlot: int16;
    spot: int16;
    auction: int16;
};

type PartialSystemInformationMessage = unit {
    st_market_status: StMarketStatus;
    st_ex_market_status: StExMarketStatus;
    st_pl_market_status: StPlMarketStatus;
    update_portfolio: bytes &size=1;
    c_filler: bytes &size=1;
    market_index: int32;
    default_settlement_period_normal: int16;
    default_settlement_period_spot: int16;
    default_settlement_period_auction: int16;
    competitor_period: int16;
    solicitor_period: int16;
    warning_percent: int16;
    volume_freeze_percent: int16;
    snap_quote_time: int16;
    : skip bytes &size=2;   # padding
    board_lot_quantity: int32;
    tick_size: int32;
    maximum_gtc_days: int16;
    st_stock_eligible_indicators: bitfield(16) {
        reserved_113: 0..12;
        books_merged: 13;
        minimum_fill: 14;
        aon: 15;
    } &byte-order=spicy::ByteOrder::Big;
    disclosed_quantity_percent_allowed: int16;
    risk_free_interest_rate: int32;
};

type OpenOrderReportMessage = unit {
    message_type: bytes &size=1;
    report_date: int32;
    user_type: int16;
    broker_id: bytes &size=5;
    firm_name: bytes &size=25;
    trader_number: int32;
    trader_name: bytes &size=26;
    : skip bytes &size=1;   # padding
};

type SpreadOrderLogReportMessage = unit {
    message_type: bytes &size=1;
    report_date: int32;
    user_type: int16;
    broker_id: bytes &size=5;
    firm_name: bytes &size=25;
    trader_number: int32;
    trader_name: bytes &size=26;
    : skip bytes &size=1;   # padding
};

type SpreadTradeReportMessage = unit {
    message_type: bytes &size=1;
    report_date: int32;
    user_type: int16;
    broker_id: bytes &size=5;
    firm_name: bytes &size=25;
    trader_number: int32;
    trader_name: bytes &size=26;
    : skip bytes &size=1;   # padding
};

type BoardLotOutMessage = unit {
    participant_type: bytes &size=1;
    : skip bytes &size=1;   # padding
    competitor_period: int16;
    solicitor_period: int16;
    modified_cancelled_by: bytes &size=1;
    : skip bytes &size=1;   # padding
    reason_code: int16;
    : skip bytes &size=4;   # padding
    token_no: int32;
    contract_desc: ContractDesc;
    counter_party_broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    : skip bytes &size=2;   # padding
    closeout_flag: bytes &size=1;
    : skip bytes &size=1;   # padding
    order_type: int16;
    order_number: bytes &size=8;
    account_number: bytes &size=10;
    book_type_short_2: int16;
    buy_sell_indicator: int16;
    disclosed_volume: int32;
    disclosed_volume_remaining: int32;
    total_volume_remaining: int32;
    volume: int32;
    volume_filled_today: int32;
    price: int32;
    trigger_price: int32;
    good_till_date: int32;
    entry_date_time: int32;
    minimum_fill_aon_volume: int32;
    last_modified: int32;
    st_order_flags: bitfield(16) {
        reserved_13: 0..2;
        frozen: 3;
        modified: 4;
        traded: 5;
        matched_ind: 6;
        mf: 7;
        aon: 8;
        ioc: 9;
        gtc: 10;
        day: 11;
        mit: 12;
        sl: 13;
        market: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    branch_id: int16;
    trader_id: int32;
    broker_id: bytes &size=5;
    c_ord_filler: bytes &size=24;
    open_close: bytes &size=1;
    settlor: bytes &size=12;
    pro_client_indicator: int16;
    settlement_period: int16;
    additional_order_flags: bitfield(8) {
        boc: 0;
        col: 1;
        additional_order_flags_reserved_3: 2;
        additional_order_flags_reserved_4: 3;
        stpc: 4;
        additional_order_flags_reserved_68: 5..7;
    } &byte-order=spicy::ByteOrder::Little;
    giveup_flag: bytes &size=1;
    reference: bytes &size=4;
    nnf_field: bytes &size=8;
    mkt_replay: bytes &size=8;
    pan: bytes &size=10;
    algo_id: int32;
    : skip bytes &size=2;   # padding
    last_activity_reference: int64;
    : skip bytes &size=52;   # padding
};

type ContractDesc = unit {
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    expiry_date: int32;
    strike_price: int32;
    option_type: bytes &size=2;
    ca_level: int16;
};

