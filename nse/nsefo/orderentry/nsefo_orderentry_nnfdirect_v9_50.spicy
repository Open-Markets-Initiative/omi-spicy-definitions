type MarketStatisticsReportMessage = unit {
    message_type: uint8;
    switch ( self.message_type ) {
        0x48 -> report_header_body: ReportHeaderBody;
        0x58 -> report_header_body: ReportHeaderBody;
        0x4c -> report_header_body: ReportHeaderBody;
        0x52 -> report_statistics_body: ReportStatisticsBody;
        0x59 -> report_statistics_body: ReportStatisticsBody;
        0x4d -> report_statistics_body: ReportStatisticsBody;
        0x54 -> report_trailer_body: ReportTrailerBody;
        0x5a -> report_trailer_body: ReportTrailerBody;
        0x4e -> report_trailer_body: ReportTrailerBody;
        * -> unknown: bytes &eod;
    };
};

type ReportHeaderBody = unit {
    org_scope: bytes &size=1;
    report_date: int32;
    user_type: int16;
    broker_id: bytes &size=5;
    firm_name: bytes &size=25;
    trader_number: int32;
    trader_name: bytes &size=26;
};

type ReportStatisticsBody = unit {
    : skip bytes &size=1;   # padding
    number_of_records: int16;
    mkt_stats_data: MktStatsData[4];
};

type MktStatsData = unit {
    contract_desc: ContractDesc;
    market_type: int16;
    open_price: int32;
    high_price: int32;
    low_price: int32;
    closing_price: int32;
    total_quantity_traded_long: int64;
    total_value_traded: bytes &size=8;
    previous_close_price: int32;
    open_interest_long: int64;
    chg_open_interest: int64;
    indicator: bytes &size=4;
};

type ReportTrailerBody = unit {
    number_of_packets: int32;
    : skip bytes &size=1;   # padding
};

type EnhancedMarketStatisticsReportMessage = unit {
    message_type: bytes &size=1;
    : skip bytes &size=1;   # padding
    number_of_records: int16;
    enhncd_mkt_stats_data: EnhncdMktStatsData[4];
};

type EnhncdMktStatsData = unit {
    contract_desc: ContractDesc;
    market_type: int16;
    open_price: int32;
    high_price: int32;
    low_price: int32;
    closing_price: int32;
    total_quantity_traded_short: uint32;
    total_value_traded: bytes &size=8;
    previous_close_price: int32;
    open_interest_long: int64;
    chg_open_interest: int64;
    indicator: bytes &size=4;
};

type MarketIndexReportMessage = unit {
    message_type: bytes &size=1;
    index_name: bytes &size=15;
    mkt_index: MktIndex;
};

type MktIndex = unit {
    market_opening_index: int16;
