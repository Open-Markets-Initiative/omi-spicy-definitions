    market_low_index: int16;
    market_closing_index: int16;
    market_start_index: int16;
};

type IndustryIndexReportMessage = unit {
    message_type: bytes &size=1;
    : skip bytes &size=1;   # padding
    number_of_industry_records: int16;
    industry_index: IndustryIndex[10];
};

type IndustryIndex = unit {
    industry_name: bytes &size=15;
