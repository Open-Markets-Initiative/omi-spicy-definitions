module NseNsefoOrderentryNnfdirectV950;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsefoOrderentryV950 = unit {
    direct_packet: DirectPacket[] &eod;
};

type DirectPacket = unit {
    packet_header: PacketHeader;
    message_header: MessageHeader;
    switch ( self.message_header.transaction_code ) {
        TransactionCode::SignOnRequestInMessage -> sign_on_request_in_message: SignOnRequestInMessage;
        TransactionCode::SignOnRequestOutMessage -> sign_on_request_out_message: SignOnRequestOutMessage;
        TransactionCode::SignOffRequestOutMessage -> sign_off_request_out_message: SignOffRequestOutMessage;
        TransactionCode::SystemInformationInMessage -> system_information_in_message: SystemInformationInMessage;
        TransactionCode::SystemInformationOutMessage -> system_information_out_message: SystemInformationOutMessage;
        TransactionCode::GatewayRouterRequestMessage -> gateway_router_request_message: GatewayRouterRequestMessage;
        TransactionCode::GatewayRouterResponseMessage -> gateway_router_response_message: GatewayRouterResponseMessage(self.message_header.message_length);
