module NseNsefoOrderentryNnfdirectV950;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsefoOrderentryV950 = unit {
    direct_packet: DirectPacket[] &eod;
};

type DirectPacket = unit {
    packet_header: PacketHeader;
    message_header: MessageHeader;
};

type PacketHeader = unit {
    packet_length: uint16;
    packet_sequence_number: uint32;
    checksum: bytes &size=16;
};

type MessageHeader = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    log_time: int32;
    alpha_char: bytes &size=2;
    trader_id: int32;
    error_code: int16 &convert=ErrorCode($$);
    header_timestamp: int64;
    time_stamp_1: bytes &size=8;
    time_stamp_2: bytes &size=8;
    message_length: int16;
};

