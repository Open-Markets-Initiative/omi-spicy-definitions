type StMarketStatus = unit {
    market_status_normal: int16 &convert=MarketStatusNormal($$);
    market_status_oddlot: int16 &convert=MarketStatusOddlot($$);
    market_status_spot: int16 &convert=MarketStatusSpot($$);
    market_status_auction: int16 &convert=MarketStatusAuction($$);
