type SectorIndexReportMessage = unit {
    message_type: bytes &size=1;
    industry_name: bytes &size=15;
    number_of_industry_records: int16;
    index_data: IndexData[10];
};

type IndexData = unit {
    sector_name: bytes &size=15;
    index_value: int32;
};

type SpreadBhavcopyMessage = unit {
    message_type: uint8;
    switch ( self.message_type ) {
        0x48 -> spread_report_header_body: SpreadReportHeaderBody;
        0x58 -> spread_report_header_body: SpreadReportHeaderBody;
        0x4c -> spread_report_header_body: SpreadReportHeaderBody;
        0x52 -> spread_report_statistics_body: SpreadReportStatisticsBody;
        0x59 -> spread_report_statistics_body: SpreadReportStatisticsBody;
        0x4d -> spread_report_statistics_body: SpreadReportStatisticsBody;
        0x54 -> report_trailer_body: ReportTrailerBody;
        0x5a -> report_trailer_body: ReportTrailerBody;
        0x4e -> report_trailer_body: ReportTrailerBody;
        * -> unknown: bytes &eod;
    };
};

