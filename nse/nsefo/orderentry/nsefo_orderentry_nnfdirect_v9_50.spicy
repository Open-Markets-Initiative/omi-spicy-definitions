    response_order_number: bytes &size=8;
    broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    trader_number: int32;
    account_number: bytes &size=10;
    buy_sell_indicator: int16 &convert=BuySellIndicator($$);
    original_volume: int32;
    disclosed_volume: int32;
    remaining_volume: int32;
    disclosed_volume_remaining: int32;
    price: int32;
    st_order_flags: bitfield(16) {
        reserved_12: 0..1;
        order_pre_open: 2;
        frozen: 3;
        modified: 4;
        traded: 5;
        matched_ind: 6;
        mf: 7;
        aon: 8;
        ioc: 9;
        gtc: 10;
        day: 11;
        mit: 12;
        sl: 13;
        market: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    good_till_date: int32;
    fill_number: int32;
    fill_quantity: int32;
    fill_price: int32;
    volume_filled_today: int32;
    activity_type: bytes &size=2;
    activity_time: int32;
    counter_trader_order_number: bytes &size=8;
    counter_broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    token: int32;
    contract_desc: ContractDesc;
    open_close: bytes &size=1;
    old_open_close: bytes &size=1;
    trade_book_type: bytes &size=1;
    : skip bytes &size=1;   # padding
    : skip bytes &size=4;   # padding
    old_account_number: bytes &size=10;
    participant: bytes &size=12;
    old_participant: bytes &size=12;
    additional_order_flags: bitfield(8) {
        boc: 0;
        col: 1;
        reserved_34: 2..3;
        stpc: 4;
        reserved_68: 5..7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
    : skip bytes &size=1;   # padding
    : skip bytes &size=1;   # padding
    pan: bytes &size=10;
    old_pan: bytes &size=10;
    algo_id: int32;
    : skip bytes &size=2;   # padding
    last_activity_reference: int64;
    : skip bytes &size=52;   # padding
};

