type PacketHeader = unit {
    packet_length: uint16;
    packet_sequence_number: uint32;
    checksum: bytes &size=16;
};

type MessageHeader = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    log_time: int32;
    alpha_char: bytes &size=2;
    trader_id: int32;
    error_code: int16 &convert=ErrorCode($$);
    header_timestamp: int64;
    time_stamp_1: bytes &size=8;
    time_stamp_2: bytes &size=8;
    message_length: int16;
};

type SignOnRequestInMessage = unit {
    user_id: int32;
    : skip bytes &size=8;   # padding
    password: bytes &size=8;
    : skip bytes &size=8;   # padding
    new_password: bytes &size=8;
    trader_name: bytes &size=26;
    last_password_change_date: int32;
    broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    branch_id: int16;
    version_number: int32;
    batch_2_start_time: int32;
    host_switch_context: bytes &size=1;
    colour: bytes &size=50;
    : skip bytes &size=1;   # padding
    user_type: int16;
    sequence_number: bytes &size=8;
    ws_class_name: bytes &size=14;
    broker_status: bytes &size=1;
    show_index: bytes &size=1;
    st_broker_eligibility_per_mkt: bitfield(16) {
        pre_open: 0;
        reserved_212: 1..11;
        auction_market: 12;
        spot_market: 13;
        oddlot_market: 14;
        normal_market: 15;
    } &byte-order=spicy::ByteOrder::Big;
    member_type: int16;
    clearing_status: bytes &size=1;
    broker_name: bytes &size=25;
    : skip bytes &size=16;   # padding
    : skip bytes &size=16;   # padding
    : skip bytes &size=16;   # padding
};

