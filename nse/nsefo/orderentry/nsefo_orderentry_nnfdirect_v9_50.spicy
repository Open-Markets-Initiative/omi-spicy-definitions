        reserved_12: 0..1;
        order_pre_open: 2;
        frozen: 3;
        modified: 4;
        traded: 5;
        matched_ind: 6;
        mf: 7;
        aon: 8;
        ioc: 9;
        gtc: 10;
        day: 11;
        mit: 12;
        sl: 13;
        market: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
