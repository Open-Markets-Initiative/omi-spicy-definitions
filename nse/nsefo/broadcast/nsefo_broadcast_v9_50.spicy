module NseNsefoBroadcastNnfbcastV950;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsefoBroadcastV950 = unit {
    bcast_pack_data: BcastPackData;
};

type BcastPackData = unit {
    net_id: bytes &size=2;
    number_of_packets: int16;
    packed_packet: PackedPacket[self.number_of_packets];
};

type PackedPacket = unit {
    compression_length: int16;
    broadcast_data: BroadcastData;
};

type BroadcastData = unit {
    bcast_market_type: bytes &size=1;
    bcast_reserved: bytes &size=7;
    bcast_header: BcastHeader;
    switch ( self.bcast_header.transaction_code ) {
        TransactionCode::BroadcastJournalVctMessage -> broadcast_journal_vct_message: BroadcastJournalVctMessage;
        TransactionCode::SecurityOpenPriceMessage -> security_open_price_message: SecurityOpenPriceMessage;
        TransactionCode::SecurityMasterChangeMessage -> security_master_change_message: SecurityMasterChangeMessage;
        TransactionCode::InstrumentMasterChangeMessage -> instrument_master_change_message: InstrumentMasterChangeMessage;
        TransactionCode::ParticipantMasterChangeMessage -> participant_master_change_message: ParticipantMasterChangeMessage;
        TransactionCode::SecurityStatusChangeMessage -> security_status_change_message: SecurityStatusChangeMessage;
        TransactionCode::MarketByOrderAndMarketByPriceMessage -> market_by_order_and_market_by_price_message: MarketByOrderAndMarketByPriceMessage;
        TransactionCode::OnlyMarketByPriceMessage -> only_market_by_price_message: OnlyMarketByPriceMessage;
        TransactionCode::EnhancedOnlyMarketByPriceMessage -> enhanced_only_market_by_price_message: EnhancedOnlyMarketByPriceMessage;
        TransactionCode::TickerAndMarketIndexMessage -> ticker_and_market_index_message: TickerAndMarketIndexMessage;
        TransactionCode::EnhancedTickerAndMarketIndexMessage -> enhanced_ticker_and_market_index_message: EnhancedTickerAndMarketIndexMessage;
        TransactionCode::MarketWatchRoundRobinMessage -> market_watch_round_robin_message: MarketWatchRoundRobinMessage;
        TransactionCode::EnhancedMarketWatchRoundRobinMessage -> enhanced_market_watch_round_robin_message: EnhancedMarketWatchRoundRobinMessage;
        TransactionCode::IndicesMessage -> indices_message: IndicesMessage;
        TransactionCode::IndustryIndexUpdateMessage -> industry_index_update_message: IndustryIndexUpdateMessage;
        TransactionCode::SpreadMarketByPriceDeltaMessage -> spread_market_by_price_delta_message: SpreadMarketByPriceDeltaMessage;
        TransactionCode::EnhancedSpreadMarketByPriceDeltaMessage -> enhanced_spread_market_by_price_delta_message: EnhancedSpreadMarketByPriceDeltaMessage;
        TransactionCode::AssetOpenInterestMessage -> asset_open_interest_message: AssetOpenInterestMessage;
        TransactionCode::EnhancedAssetOpenInterestMessage -> enhanced_asset_open_interest_message: EnhancedAssetOpenInterestMessage;
        TransactionCode::LimitPriceProtectionRangeMessage -> limit_price_protection_range_message: LimitPriceProtectionRangeMessage;
        TransactionCode::CasReferencePriceMessage -> cas_reference_price_message: CasReferencePriceMessage;
        TransactionCode::TurnoverExceededMessage -> turnover_exceeded_message: TurnoverExceededMessage(self.bcast_header.message_length);
        TransactionCode::TurnoverExceededMessage_9011 -> turnover_exceeded_message: TurnoverExceededMessage(self.bcast_header.message_length);
        * -> unknown: bytes &eod;
    };
};

type BcastHeader = unit {
    reserved_0: bytes &size=2;
    reserved_2: bytes &size=2;
    log_time: int32;
    alpha_char: bytes &size=2;
    transaction_code: int16 &convert=TransactionCode($$);
    error_code: int16;
    bc_seq_no: int32;
    reserved_18: bytes &size=1;
    reserved_19: bytes &size=3;
    time_stamp_2: bytes &size=8;
    filler_2: bytes &size=8;
    message_length: int16;
};

type BroadcastJournalVctMessage = unit {
    branch_number: int16;
    broker_number: bytes &size=5;
    action_code: bytes &size=3;
    st_bcast_destination: bitfield(16) {
        reserved_112: 0..11;
        journalling_required: 12;
        tandem: 13;
        control_work_station: 14;
        trader_work_station: 15;
    } &byte-order=spicy::ByteOrder::Big;
    : skip bytes &size=26;   # padding
    broadcast_message_length: int16;
    broadcast_message: bytes &size=239;
};

type SecurityOpenPriceMessage = unit {
    symbol: bytes &size=10;
    series: bytes &size=2;
    token: int32;
    opening_price: int32;
};

type SecurityMasterChangeMessage = unit {
    token: int32;
    sec_info: SecInfo;
    permitted_to_trade: int16 &convert=PermittedToTrade($$);
    issued_capital: bytes &size=8;
    warning_quantity: int32;
    freeze_quantity: int32;
    credit_rating: bytes &size=12;
    st_sec_eligibility_per_mkt: StSecEligibilityPerMkt[4];
    issue_rate: int16;
    issue_start_date: int32;
    interest_payment_date: int32;
    issue_maturity_date: int32;
    margin_percentage: int32;
    minimum_lot_quantity: int32;
    board_lot_quantity: int32;
    tick_size: int32;
    name: bytes &size=25;
    : skip bytes &size=1;   # padding
    listing_date: int32;
    expulsion_date: int32;
    re_admission_date: int32;
    record_date: int32;
    low_price_range: int32;
    high_price_range: int32;
    expiry_date: int32;
    no_delivery_start_date: int32;
    no_delivery_end_date: int32;
    st_eligibility_indicators: bitfield(16) {
        reserved_113: 0..12;
        minimum_fill: 13;
        aon: 14;
        participate_in_market_index: 15;
    } &byte-order=spicy::ByteOrder::Big;
    book_closure_start_date: int32;
    book_closure_end_date: int32;
    exercise_start_date: int32;
    exercise_end_date: int32;
    old_token: int32;
    asset_instrument: bytes &size=6;
    asset_name: bytes &size=10;
    asset_token: int32;
    intrinsic_value: int32;
    extrinsic_value: int32;
    st_purpose: bitfield(16) {
        reserved_13: 0..2;
        is_corporate_adjusted: 3;
        is_this_asset: 4;
        pl_allowed: 5;
        ex_rejection_allowed: 6;
        ex_allowed: 7;
        exercise_style: 8;
        reserved_10: 9;
        egm: 10;
        agm: 11;
        interest: 12;
        bonus: 13;
        rights: 14;
        dividend: 15;
    } &byte-order=spicy::ByteOrder::Big;
    local_update_date_time: int32;
    delete_flag: uint8 &convert=DeleteFlag($$);
    remark: bytes &size=25;
    base_price: int32;
};

type SecInfo = unit {
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    series: bytes &size=2;
    expiry_date: int32;
    strike_price: int32;
    option_type: bytes &size=2;
    ca_level: int16;
};

type StSecEligibilityPerMkt = unit {
    security_eligibility_flags: bitfield(8) {
        reserved_17: 0..6;
        eligibility: 7;
    } &byte-order=spicy::ByteOrder::Little;
    filler: bytes &size=1;
    status: int16 &convert=Status($$);
};

type InstrumentMasterChangeMessage = unit {
    instrument_id: int16;
    instrument_name: bytes &size=6;
    instrument_description: bytes &size=25;
    instrument_update_time: int32;
    delete_flag: uint8 &convert=DeleteFlag($$);
};

type ParticipantMasterChangeMessage = unit {
    participant_id: bytes &size=12;
    participant_name: bytes &size=25;
    participant_status: uint8 &convert=ParticipantStatus($$);
    participant_update_date_time: int32;
    delete_flag: uint8 &convert=DeleteFlag($$);
};

type SecurityStatusChangeMessage = unit {
    number_of_records: int16;
    token_and_eligibility: TokenAndEligibility[35];
};

type TokenAndEligibility = unit {
    token: int32;
    st_sec_status_per_market: StSecStatusPerMarket[4];
};

type StSecStatusPerMarket = unit {
    status: int16 &convert=Status($$);
};

type MarketByOrderAndMarketByPriceMessage = unit {
    st_interactive_mbo_data: StInteractiveMboData;
    st_mbp_info: StMbpInfo[10];
    total_buy_quantity_double: bytes &size=8;
    total_sell_quantity_double: bytes &size=8;
    st_indicator: bitfield(16) {
        reserved_112: 0..11;
        sell: 12;
        buy: 13;
        last_trade_less: 14;
        last_trade_more: 15;
    } &byte-order=spicy::ByteOrder::Big;
    closing_price: int32;
    open_price: int32;
    high_price: int32;
    low_price: int32;
};

type StInteractiveMboData = unit {
    token: int32;
    book_type: int16 &convert=BookType($$);
    trading_status: int16 &convert=TradingStatus($$);
    volume_traded_today_short: uint32;
    last_traded_price: int32;
    net_change_indicator: uint8 &convert=NetChangeIndicator($$);
    net_price_change_from_closing_price: int32;
    last_trade_quantity: int32;
    last_trade_time: int32;
    average_trade_price: int32;
    auction_number: int16;
    auction_status: int16 &convert=AuctionStatus($$);
    initiator_type: int16;
    initiator_price: int32;
    initiator_quantity: int32;
    auction_price: int32;
    auction_quantity: int32;
    st_mbo_info: StMboInfo[10];
};

type StMboInfo = unit {
    trader_id: int32;
    qty: int32;
    price: int32;
    st_mbo_mbp_terms: bitfield(16) {
        reserved_114: 0..13;
        terms_aon: 14;
        mf: 15;
    } &byte-order=spicy::ByteOrder::Big;
    min_fill_qty: int32;
};

type StMbpInfo = unit {
    qty: int32;
    price: int32;
    no_of_orders: int16;
};

type OnlyMarketByPriceMessage = unit {
    no_of_records: int16;
    interactive_only_mbp_data: InteractiveOnlyMbpData[2];
};

type InteractiveOnlyMbpData = unit {
    token: int32;
    book_type: int16 &convert=BookType($$);
    trading_status: int16 &convert=TradingStatus($$);
    volume_traded_today_short: uint32;
    last_traded_price: int32;
    net_change_indicator: uint8 &convert=NetChangeIndicator($$);
    vol_trd_today_excd_indc: bytes &size=1;
    net_price_change_from_closing_price: int32;
    last_trade_quantity: int32;
    last_trade_time: int32;
    average_trade_price: int32;
    auction_number: int16;
    auction_status: int16 &convert=AuctionStatus($$);
    initiator_type: int16;
    initiator_price: int32;
    initiator_quantity: int32;
    auction_price: int32;
    auction_quantity: int32;
    mbp_information: MbpInformation[10];
    bb_total_buy_flag: int16;
    bb_total_sell_flag: int16;
    total_buy_quantity_double: bytes &size=8;
    total_sell_quantity_double: bytes &size=8;
    st_indicator: bitfield(16) {
        reserved_112: 0..11;
        sell: 12;
        buy: 13;
        last_trade_less: 14;
        last_trade_more: 15;
    } &byte-order=spicy::ByteOrder::Big;
    closing_price: int32;
    open_price: int32;
    high_price: int32;
    low_price: int32;
};

type MbpInformation = unit {
    quantity_short: int32;
    price: int32;
    number_of_orders: int16;
    bb_buy_sell_flag: int16;
};

type EnhancedOnlyMarketByPriceMessage = unit {
    no_of_records: int16;
    enhncd_interactive_only_mbp_data: EnhncdInteractiveOnlyMbpData[2];
};

type EnhncdInteractiveOnlyMbpData = unit {
    token: int32;
    book_type: int16 &convert=BookType($$);
    trading_status: int16 &convert=TradingStatus($$);
    volume_traded_today_long: int64;
    last_traded_price: int32;
    net_change_indicator: uint8 &convert=NetChangeIndicator($$);
    : skip bytes &size=1;   # padding
    net_price_change_from_closing_price: int32;
    last_trade_quantity: int32;
    last_trade_time: int32;
    average_trade_price: int32;
    : skip bytes &size=14;   # padding
    imbalance_qty_at_iop: int64;
    enhncd_mbp_information: EnhncdMbpInformation[10];
    bb_total_buy_flag: int16;
    bb_total_sell_flag: int16;
    total_buy_quantity_long: int64;
    total_sell_quantity_long: int64;
    st_indicator: bitfield(16) {
        reserved_112: 0..11;
        sell: 12;
        buy: 13;
        last_trade_less: 14;
        last_trade_more: 15;
    } &byte-order=spicy::ByteOrder::Big;
    closing_price: int32;
    open_price: int32;
    high_price: int32;
    low_price: int32;
};

type EnhncdMbpInformation = unit {
    quantity_long: int64;
    price: int32;
    number_of_orders: int16;
    bb_buy_sell_flag: int16;
};

