    index_name: bytes &size=21;
    index_value: int32;
    high_index_value: int32;
    low_index_value: int32;
    opening_index: int32;
    closing_index: int32;
    percent_change: int32;
    yearly_high: int32;
    yearly_low: int32;
    no_of_upmoves: int32;
    no_of_downmoves: int32;
    market_capitalisation: bytes &size=8;
    net_change_indicator: uint8 &convert=NetChangeIndicator($$);
    : skip bytes &size=1;   # padding
};

type IndustryIndexUpdateMessage = unit {
    no_of_recs: int16;
    industry_indices: IndustryIndices[20];
};

