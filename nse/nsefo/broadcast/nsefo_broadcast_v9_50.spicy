    mbp_buy: int16;
    mbp_sell: int16;
    last_active_time: int32;
    traded_volume_long: int64;
    total_traded_value: bytes &size=8;
    enhncd_mbp_buys: EnhncdMbpBuys[5];
    enhncd_mbp_sells: EnhncdMbpSells[5];
    total_order_volume: TotalOrderVolume;
    open_price_difference: int32;
    day_high_price_difference: int32;
    day_low_price_difference: int32;
    last_traded_price_difference: int32;
    last_update_time: int32;
};

