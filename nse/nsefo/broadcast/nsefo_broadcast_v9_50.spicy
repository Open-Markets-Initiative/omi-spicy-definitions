    no_orders: int16;
    volume_long: int64;
    price: int32;
};

type AssetOpenInterestMessage = unit {
    asset_open_interest: AssetOpenInterest[58];
};

type AssetOpenInterest = unit {
    token_no: int32;
    current_oi_short: uint32;
};

type EnhancedAssetOpenInterestMessage = unit {
    enhncd_open_interest: EnhncdOpenInterest[39];
};

type EnhncdOpenInterest = unit {
    token_no: int32;
    current_oi_long: int64;
};

type LimitPriceProtectionRangeMessage = unit {
    limit_price_protection_range_data: LimitPriceProtectionRangeData;
};

type LimitPriceProtectionRangeData = unit {
    msg_count: int32;
    limit_price_protection_range_detail: LimitPriceProtectionRangeDetail[25];
};

type LimitPriceProtectionRangeDetail = unit {
    token_number: int32;
    high_exec_band: int32;
    low_exec_band: int32;
};

type CasReferencePriceMessage = unit {
    number_of_records: int16;
    token_and_ref_price: TokenAndRefPrice[10];
};

type TokenAndRefPrice = unit {
    sec_info: SecInfo;
    token: int32;
    reference_price: int32;
};

type TurnoverExceededMessage = unit(message_length: int16) {
    turnover_body: TurnoverBody(message_length);
};

type TurnoverBody = unit(message_length: int16) {
    switch ( message_length ) {
        98 -> turnover_limit_exceeded_body: TurnoverLimitExceededBody;
        320 -> turnover_vct_messages_body: TurnoverVctMessagesBody;
        * -> unknown: bytes &eod;
    };
};

type TurnoverLimitExceededBody = unit {
    broker_code: bytes &size=5;
    counter_broker_code: bytes &size=5;
    warning_type: int16 &convert=WarningType($$);
    token: int32;
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    expiry_date: int32;
    strike_price: int32;
    option_type: bytes &size=2;
    ca_level: int16;
    trade_number: int32;
    trade_price: int32;
    trade_volume: int32;
    final: bytes &size=1;
    filler: bytes &size=1;
};

type TurnoverVctMessagesBody = unit {
    token: int32;
    sec_info: SecInfo;
    market_type: int16 &convert=MarketType($$);
    st_bcast_destination: bitfield(16) {
        reserved_112: 0..11;
        journalling_required: 12;
        tandem: 13;
        control_work_station: 14;
        trader_work_station: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broadcast_message_length: int16;
    broadcast_message: bytes &size=239;
};

type TransactionCode = enum {
    BroadcastJournalVctMessage = 6501,
    SecurityOpenPriceMessage = 6013,
    SecurityMasterChangeMessage = 7305,
    InstrumentMasterChangeMessage = 7324,
    ParticipantMasterChangeMessage = 7306,
    SecurityStatusChangeMessage = 7320,
    MarketByOrderAndMarketByPriceMessage = 7200,
    OnlyMarketByPriceMessage = 7208,
    EnhancedOnlyMarketByPriceMessage = 17208,
    TickerAndMarketIndexMessage = 7202,
    EnhancedTickerAndMarketIndexMessage = 17202,
    MarketWatchRoundRobinMessage = 7201,
    EnhancedMarketWatchRoundRobinMessage = 17201,
    IndicesMessage = 7207,
    IndustryIndexUpdateMessage = 7203,
    SpreadMarketByPriceDeltaMessage = 7211,
    EnhancedSpreadMarketByPriceDeltaMessage = 17211,
    AssetOpenInterestMessage = 7130,
    EnhancedAssetOpenInterestMessage = 17130,
    LimitPriceProtectionRangeMessage = 7220,
    CasReferencePriceMessage = 7338,
    TurnoverExceededMessage = 9010,
    TurnoverExceededMessage_9011 = 9011,
};

type PermittedToTrade = enum {
    ListedButNotPermittedToTrade = 0,
    PermittedToTrade_1 = 1,
    BseListed = 2,
};

type Status = enum {
    PreOpen = 1,
    Open = 2,
    Suspended = 3,
    PreOpenExtended = 4,
    StockOpenWithMarket = 5,
    PriceDiscovery = 6,
};

type DeleteFlag = enum {
    Deleted = 0x59,
    NotDeleted = 0x4e,
};

type ParticipantStatus = enum {
    Suspended = 0x53,
    Active = 0x41,
};

type BookType = enum {
    RegularLotOrder = 1,
    SpecialTermsOrder = 2,
    StopLossMitOrder = 3,
    NegotiatedOrder = 4,
    OddLotOrder = 5,
    SpotOrder = 6,
    AuctionOrder = 7,
};

type TradingStatus = enum {
    Preopen = 1,
    Open = 2,
    Suspended = 3,
    PreopenExtended = 4,
    PriceDiscovery = 6,
};

type NetChangeIndicator = enum {
    Increase = 0x2b,
    Decrease = 0x2d,
    NoChange = 0x20,
};

type AuctionStatus = enum {
    PreOpen = 0,
    Open = 1,
    Closed = 2,
    PreOpenEnded = 3,
    Postclose = 4,
};

type MarketType = enum {
    NormalMarket = 1,
    OddLotMarket = 2,
    SpotMarket = 3,
    AuctionMarket = 4,
};

type WarningType = enum {
    TurnoverLimitAboutToExceed = 1,
    TurnoverLimitExceeded = 2,
};

