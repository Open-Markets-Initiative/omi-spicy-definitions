type PriceConfirmationMessage = unit {
    reason_code: int16;
    token: int32;
    order_number: bytes &size=8;
    book_type: int16 &convert=BookType($$);
    buy_sell: int16 &convert=BuySell($$);
    disclosed_volume: int32;
    disclosed_vol_remaining: int32;
    total_vol_remaining: int32;
    volume: int32;
    price: int32;
    trigger_price: int32;
    st_order_flags: bitfield(16) {
        matched_ind: 0;
        traded: 1;
        modified: 2;
        frozen: 3;
        preopen: 4;
        boc: 5;
        stpc: 6;
        order_flags_reserved_7: 7;
        ato: 8;
        mkt: 9;
        on_stop: 10;
        day: 11;
        gtc: 12;
        ioc: 13;
        aon: 14;
        mf: 15;
    } &byte-order=spicy::ByteOrder::Big;
    trader_id: int32;
    nnf_field: bytes &size=8;
    algo_id: int32;
    activity_time_in_nanos: int64;
    : skip bytes &size=2;   # padding
    : skip bytes &size=2;   # padding
    : skip bytes &size=2;   # padding
    suspended: bytes &size=1;
    open_close: uint8 &convert=OpenClose($$);
    pan: bytes &size=10;
    segment_char_1: bytes &size=1;
    participant_type: uint8 &convert=ParticipantType($$);
    account_number: bytes &size=10;
    pro_client_char_1: bytes &size=1;
    : skip bytes &size=1;   # padding
    settlor: bytes &size=12;
    reference_id: int32;
};

