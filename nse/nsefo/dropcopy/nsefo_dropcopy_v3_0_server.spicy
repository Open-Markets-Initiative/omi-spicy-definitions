module NseNsefoDropcopyNnfdcV30Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsefoDropcopyV30 = unit {
    server_drop_copy_packet: ServerDropCopyPacket[] &eod;
};

type ServerDropCopyPacket = unit {
    packet_header: PacketHeader;
    response_message_header: ResponseMessageHeader;
    message_buffer: MessageBuffer;
};

type PacketHeader = unit {
    packet_length: uint16;
    packet_sequence_number: uint32;
    checksum: bytes &size=16;
};

type ResponseMessageHeader = unit {
    environment_type: uint8 &convert=EnvironmentType($$);
    compression_indicator: uint8 &convert=CompressionIndicator($$);
};

type MessageBuffer = unit {
    server_message: ServerMessage[] &eod;
};

type ServerMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.transaction_code ) {
        TransactionCode::GrResponseMessage -> gr_response_message: GrResponseMessage;
        TransactionCode::DcSignonOutMessage -> dc_signon_out_message: DcSignonOutMessage;
        TransactionCode::DcSignOffMessage -> dc_sign_off_message: DcSignOffMessage;
        TransactionCode::DcErrorResponseTradeMessage -> dc_error_response_trade_message: DcErrorResponseTradeMessage;
        TransactionCode::DcErrorResponseOrderMessage -> dc_error_response_order_message: DcErrorResponseOrderMessage;
        TransactionCode::TradeConfirmationMessage -> trade_confirmation_message: TradeConfirmationMessage;
        TransactionCode::TradeCancelConfirmMessage -> trade_cancel_confirm_message: TradeCancelConfirmMessage;
        TransactionCode::TradeCancelRejectMessage -> trade_cancel_reject_message: TradeCancelRejectMessage;
        TransactionCode::TradeModifyConfirmMessage -> trade_modify_confirm_message: TradeModifyConfirmMessage;
        TransactionCode::TradeModifyRejectedMessage -> trade_modify_rejected_message: TradeModifyRejectedMessage;
        TransactionCode::GiveupAppConfirmMessage -> giveup_app_confirm_message: GiveupAppConfirmMessage;
        TransactionCode::GiveupRejConfirmMessage -> giveup_rej_confirm_message: GiveupRejConfirmMessage;
        TransactionCode::PriceConfirmationMessage -> price_confirmation_message: PriceConfirmationMessage;
        TransactionCode::OrderModRejectMessage -> order_mod_reject_message: OrderModRejectMessage;
        TransactionCode::OrderCancelRejectMessage -> order_cancel_reject_message: OrderCancelRejectMessage;
        TransactionCode::OrderConfirmationMessage -> order_confirmation_message: OrderConfirmationMessage;
        TransactionCode::OrderModConfirmationMessage -> order_mod_confirmation_message: OrderModConfirmationMessage;
        TransactionCode::OrderCancelConfirmationMessage -> order_cancel_confirmation_message: OrderCancelConfirmationMessage;
        TransactionCode::FreezeToControlMessage -> freeze_to_control_message: FreezeToControlMessage;
        TransactionCode::OnStopNotificationMessage -> on_stop_notification_message: OnStopNotificationMessage;
        TransactionCode::OrderErrorMessage -> order_error_message: OrderErrorMessage;
        TransactionCode::BatchOrderCancelMessage -> batch_order_cancel_message: BatchOrderCancelMessage;
        TransactionCode::SpOrderConfirmationMessage -> sp_order_confirmation_message: SpOrderConfirmationMessage;
        TransactionCode::TwolOrderConfirmationMessage -> twol_order_confirmation_message: TwolOrderConfirmationMessage;
        TransactionCode::ThrlOrderConfirmationMessage -> thrl_order_confirmation_message: ThrlOrderConfirmationMessage;
        TransactionCode::SpOrderCxlRejectedMessage -> sp_order_cxl_rejected_message: SpOrderCxlRejectedMessage;
        TransactionCode::SpOrderCxlConfirmationMessage -> sp_order_cxl_confirmation_message: SpOrderCxlConfirmationMessage;
        TransactionCode::TwolOrderCxlConfirmationMessage -> twol_order_cxl_confirmation_message: TwolOrderCxlConfirmationMessage;
        TransactionCode::ThrlOrderCxlConfirmationMessage -> thrl_order_cxl_confirmation_message: ThrlOrderCxlConfirmationMessage;
        TransactionCode::SpOrderModRejectMessage -> sp_order_mod_reject_message: SpOrderModRejectMessage;
        TransactionCode::SpOrderModConfirmationMessage -> sp_order_mod_confirmation_message: SpOrderModConfirmationMessage;
        TransactionCode::SpOrderRejectedMessage -> sp_order_rejected_message: SpOrderRejectedMessage;
        TransactionCode::TwolOrderErrorMessage -> twol_order_error_message: TwolOrderErrorMessage;
        TransactionCode::ThrlOrderErrorMessage -> thrl_order_error_message: ThrlOrderErrorMessage;
        TransactionCode::BatchSpreadCxlOutMessage -> batch_spread_cxl_out_message: BatchSpreadCxlOutMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    error_code: int16;
    sequence_number: int64;
    message_length: int16;
};

type GrResponseMessage = unit {
    message_indicator: int16 &convert=MessageIndicator($$);
    partition_count: int16;
    ip_details_partition_wise: IpDetailsPartitionWise;
    session_key: bytes &size=8;
    cryptographic_key: bytes &size=32;
    static_cryptographic_iv: bytes &size=8;
    dynamic_cryptographic_iv: int64;
    cryptographic_additional_key: bytes &size=12;
};

type IpDetailsPartitionWise = unit {
    ip_address: bytes &size=16;
    port_field: int32;
    partition_id: bytes &size=6;
};

type DcSignonOutMessage = unit {
    user_id: int32;
    partition_id: bytes &size=6;
    concurrent_login_id: int16;
};

type DcSignOffMessage = unit {
    user_id: int32;
    partition_id: bytes &size=6;
    concurrent_login_id: int16;
};

type DcErrorResponseTradeMessage = unit {
    error_message: bytes &size=128;
};

type DcErrorResponseOrderMessage = unit {
    error_message: bytes &size=128;
};

type TradeConfirmationMessage = unit {
    order_number: bytes &size=8;
    trader_number: int32;
    buy_sell: int16 &convert=BuySell($$);
    original_volume: int32;
    disclosed_volume: int32;
    remaining_volume: int32;
    disclosed_vol_remaining: int32;
    price: int32;
    st_order_flags: bitfield(16) {
        matched_ind: 0;
        traded: 1;
        modified: 2;
        frozen: 3;
        preopen: 4;
        boc: 5;
        stpc: 6;
        order_flags_reserved_7: 7;
        ato: 8;
        mkt: 9;
        on_stop: 10;
        day: 11;
        gtc: 12;
        ioc: 13;
        aon: 14;
        mf: 15;
    } &byte-order=spicy::ByteOrder::Big;
    fill_number: int32;
    fill_qty: int32;
    fill_price: int32;
    token: int32;
    book_type: int16 &convert=BookType($$);
    pro_client_short_2: int16 &convert=ProClientShort2($$);
    algo_id: int32;
    activity_time_in_nanos: int64;
    nnf_field: bytes &size=8;
    segment_short_2: int16 &convert=SegmentShort2($$);
    broker_id: bytes &size=5;
    filler: bytes &size=1;
    pan: bytes &size=10;
    account_number: bytes &size=10;
    settlor: bytes &size=12;
    giveup_flag: uint8 &convert=GiveupFlag($$);
    open_close: uint8 &convert=OpenClose($$);
    participant: bytes &size=12;
    reason_code: int16;
};

