module NseNseixDropcopyNnfdirectV16Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NseixDropcopyV16 = unit {
    client_direct_packet: ClientDirectPacket[] &eod;
};

type ClientDirectPacket = unit {
    packet_header: PacketHeader;
    # read ahead from inside the arm that follows; it consumes nothing
    next_transaction_code: int16 &parse-at=(self.input() + self.offset() + 16);
    switch ( self.next_transaction_code ) {
        23008 -> client_registration_packet: ClientRegistrationPacket;
        * -> client_session_packet: ClientSessionPacket;
    };
};

type PacketHeader = unit {
    packet_length: uint16;
    packet_sequence_number: uint32;
};

type ClientRegistrationPacket = unit {
    registration_checksum: bytes &size=16;
    message_header: MessageHeader;
    switch ( self.message_header.transaction_code ) {
        TransactionCode::SignonInMessage -> signon_in_message: SignonInMessage;
        TransactionCode::DcDownloadRequestMessage -> dc_download_request_message: DcDownloadRequestMessage;
        TransactionCode::DcOrderRequestMessage -> dc_order_request_message: DcOrderRequestMessage;
        TransactionCode::DcOrdTrdRequestMessage -> dc_ord_trd_request_message: DcOrdTrdRequestMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    log_time: int32 &convert=time($$ + 315532800);
    alpha_char: bytes &size=2;
    trader_id: int32;
    error_code: int16 &convert=ErrorCode($$);
    header_timestamp: int64;
    time_stamp_1: bytes &size=8;
    time_stamp_2: bytes &size=8;
    message_length: int16;
};

type SignonInMessage = unit {
    user_id: int32;
    password: bytes &size=8;
    : skip bytes &size=8;   # padding
    : skip bytes &size=30;   # padding
    broker_id: bytes &size=5;
    : skip bytes &size=119;   # padding
};

type DcDownloadRequestMessage = unit {
    sequence_number: real &type=spicy::RealType::IEEE754_Double;
};

type DcOrderRequestMessage = unit {
    order_sequence_number: real &type=spicy::RealType::IEEE754_Double;
};

type DcOrdTrdRequestMessage = unit {
    order_trade_sequence_number: real &type=spicy::RealType::IEEE754_Double;
};

type ClientSessionPacket = unit {
    checksum: bytes &size=16;
    client_message_data: ClientMessageData;
};

type ClientMessageData = unit {
    message_header: MessageHeader;
    switch ( self.message_header.transaction_code ) {
        TransactionCode::SignonInMessage -> signon_in_message: SignonInMessage;
        TransactionCode::DcDownloadRequestMessage -> dc_download_request_message: DcDownloadRequestMessage;
        TransactionCode::DcOrderRequestMessage -> dc_order_request_message: DcOrderRequestMessage;
        TransactionCode::DcOrdTrdRequestMessage -> dc_ord_trd_request_message: DcOrdTrdRequestMessage;
        * -> unknown: bytes &eod;
    };
};

