module NseNseixOrderentryNnftrimmedV112;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NseixOrderentryV112 = unit {
    message: Message[] &eod;
};

type Message = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    switch ( self.transaction_code ) {
        TransactionCode::BoardLotInTrimmedMessage -> board_lot_in_trimmed_message: BoardLotInTrimmedMessage;
        TransactionCode::OrderModifyCancelTrimmedMessage -> order_modify_cancel_trimmed_message: OrderModifyCancelTrimmedMessage;
        TransactionCode::OrderModifyCancelTrimmedMessage_20060 -> order_modify_cancel_trimmed_message: OrderModifyCancelTrimmedMessage;
        TransactionCode::OrderModifyCancelTrimmedMessage_20070 -> order_modify_cancel_trimmed_message: OrderModifyCancelTrimmedMessage;
        TransactionCode::OrderResponseTrimmedMessage -> order_response_trimmed_message: OrderResponseTrimmedMessage;
        TransactionCode::OrderResponseTrimmedMessage_20042 -> order_response_trimmed_message: OrderResponseTrimmedMessage;
        TransactionCode::OrderResponseTrimmedMessage_20072 -> order_response_trimmed_message: OrderResponseTrimmedMessage;
        TransactionCode::OrderResponseTrimmedMessage_20073 -> order_response_trimmed_message: OrderResponseTrimmedMessage;
        TransactionCode::OrderResponseTrimmedMessage_20074 -> order_response_trimmed_message: OrderResponseTrimmedMessage;
        TransactionCode::OrderResponseTrimmedMessage_20075 -> order_response_trimmed_message: OrderResponseTrimmedMessage;
        TransactionCode::OrderResponseTrimmedMessage_20231 -> order_response_trimmed_message: OrderResponseTrimmedMessage;
        TransactionCode::TradeConfirmationTrimmedMessage -> trade_confirmation_trimmed_message: TradeConfirmationTrimmedMessage;
        * -> unknown: bytes &eod;
    };
};

type BoardLotInTrimmedMessage = unit {
    user_id: int32;
    reason_code: int16 &convert=ReasonCode($$);
    token_no: int32;
    contract_desc_tr: ContractDescTr;
    account_number: bytes &size=10;
    book_type: int16 &convert=BookType($$);
    buy_sell_indicator: int16 &convert=BuySellIndicator($$);
    disclosed_volume: int32;
    volume: int32;
    price: int32;
    good_till_date: int32;
    st_order_flags: bitfield(16) {
        nlt_indc: 0;
        preclose: 1;
        preopen: 2;
        frozen: 3;
        modified: 4;
        traded: 5;
        matched_ind: 6;
        mf: 7;
        aon: 8;
        ioc: 9;
        gtc: 10;
        day: 11;
        mit: 12;
        sl: 13;
        market: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    branch_id: int16;
    trader_id: int32;
    broker_id: bytes &size=5;
    open_close: uint8 &convert=OpenClose($$);
    settlor: bytes &size=12;
    pro_client_indicator: int16 &convert=ProClientIndicator($$);
    additional_order_flags: bitfield(8) {
        reserved_bit_1: 0;
        col: 1;
        reserved_34: 2..3;
        stpc: 4;
        session_ind: 5;
        reserved_78: 6..7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
    : skip bytes &size=4;   # padding
    nnf_field: real &type=spicy::RealType::IEEE754_Double;
    echo_back: bytes &size=16;
    last_activity_reference: int64;
    : skip bytes &size=24;   # padding
};

type ContractDescTr = unit {
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    expiry_date: int32 &convert=time($$ + 315532800);
    strike_price: int32;
    option_type: bytes &size=2;
};

type OrderModifyCancelTrimmedMessage = unit {
    user_id: int32;
    modified_cancelled_by: uint8 &convert=ModifiedCancelledBy($$);
    : skip bytes &size=1;   # padding
    token_no: int32;
    contract_desc_tr: ContractDescTr;
    order_number: real &type=spicy::RealType::IEEE754_Double;
    account_number: bytes &size=10;
