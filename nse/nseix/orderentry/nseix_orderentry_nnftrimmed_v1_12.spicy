    last_modified: int32 &convert=time($$ + 315532800);
    st_order_flags: bitfield(16) {
        nlt_indc: 0;
        preclose: 1;
        preopen: 2;
        frozen: 3;
        modified: 4;
        traded: 5;
        matched_ind: 6;
        mf: 7;
        aon: 8;
        ioc: 9;
        gtc: 10;
        day: 11;
        mit: 12;
        sl: 13;
        market: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    branch_id: int16;
    trader_id: int32;
    broker_id: bytes &size=5;
    open_close: uint8 &convert=OpenClose($$);
    settlor: bytes &size=12;
    pro_client_indicator: int16 &convert=ProClientIndicator($$);
    additional_order_flags: bitfield(8) {
        reserved_bit_1: 0;
        col: 1;
        reserved_34: 2..3;
        stpc: 4;
        session_ind: 5;
        reserved_78: 6..7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
    : skip bytes &size=4;   # padding
    nnf_field: real &type=spicy::RealType::IEEE754_Double;
    : skip bytes &size=8;   # padding
    echo_back: bytes &size=16;
    last_activity_reference: int64;
    : skip bytes &size=52;   # padding
};

type TradeConfirmationTrimmedMessage = unit {
    log_time: int32 &convert=time($$ + 315532800);
    trader_id: int32;
    time_stamp: real &type=spicy::RealType::IEEE754_Double;
    time_stamp_1: real &type=spicy::RealType::IEEE754_Double;
    timestamp_2_double: real &type=spicy::RealType::IEEE754_Double;
    response_order_number: real &type=spicy::RealType::IEEE754_Double;
    broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    account_number: bytes &size=10;
    buy_sell_indicator: int16 &convert=BuySellIndicator($$);
    original_volume: int32;
    disclosed_volume: int32;
    remaining_volume: int32;
    disclosed_volume_remaining: int32;
    price: int32;
    st_order_flags: bitfield(16) {
        nlt_indc: 0;
        preclose: 1;
        preopen: 2;
        frozen: 3;
        modified: 4;
        traded: 5;
        matched_ind: 6;
        mf: 7;
        aon: 8;
        ioc: 9;
        gtc: 10;
        day: 11;
        mit: 12;
        sl: 13;
        market: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    good_till_date: int32;
    fill_number: int32;
    fill_quantity: int32;
    fill_price: int32;
    volume_filled_today: int32;
    activity_type: bytes &size=2;
    activity_time: int32 &convert=time($$ + 315532800);
    token: int32;
    contract_desc_tr: ContractDescTr;
    open_close: uint8 &convert=OpenClose($$);
    trade_book_type: bytes &size=1;
    participant: bytes &size=12;
    additional_order_flags: bitfield(8) {
        reserved_bit_1: 0;
        col: 1;
        reserved_34: 2..3;
        stpc: 4;
        session_ind: 5;
        reserved_78: 6..7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
    echo_back: bytes &size=16;
    last_activity_reference: int64;
    : skip bytes &size=52;   # padding
};

type TransactionCode = enum {
    BoardLotInTrimmedMessage = 20000,
    OrderModifyCancelTrimmedMessage = 20040,
    OrderModifyCancelTrimmedMessage_20060 = 20060,
    OrderModifyCancelTrimmedMessage_20070 = 20070,
    OrderResponseTrimmedMessage = 20012,
    OrderResponseTrimmedMessage_20042 = 20042,
    OrderResponseTrimmedMessage_20072 = 20072,
    OrderResponseTrimmedMessage_20073 = 20073,
    OrderResponseTrimmedMessage_20074 = 20074,
    OrderResponseTrimmedMessage_20075 = 20075,
    OrderResponseTrimmedMessage_20231 = 20231,
    TradeConfirmationTrimmedMessage = 20222,
};

type ReasonCode = enum {
    Exercise = 2,
    PositionLiquidation = 3,
    Security = 5,
    Broker = 6,
    Branch = 7,
    User = 8,
    Participant = 9,
    CounterParty = 10,
    OrderNumber = 11,
    AuctionNumber = 15,
    PriceFreeze = 17,
    QuantityFreeze = 18,
    InvalidExpl = 29,
    ExerciseModeMismatch = 30,
    ExPlNumber = 31,
};

type BookType = enum {
    RegularLotOrder = 1,
    SpecialTermsOrder = 2,
    StopLossOrMitOrder = 3,
    NegotiatedOrderOrNlt = 4,
    OddLotOrder = 5,
    SpotOrder = 6,
    AuctionOrder = 7,
};

type BuySellIndicator = enum {
    BuyOrder = 1,
    SellOrder = 2,
};

type OpenClose = enum {
    Open = 0x4f,
    Close = 0x43,
};

type ProClientIndicator = enum {
    ClientOrder = 1,
    BrokerOrder = 2,
};

type Stpc = enum {
    CancelOrderResultingInSelfTradeAsPerDefault = 0,
    CancelActiveOrderResultingInSelfTrade = 1,
};

type SessionInd = enum {
    Session1 = 0,
    Session2 = 1,
};

type ModifiedCancelledBy = enum {
    Trader = 0x54,
    BranchManager = 0x42,
    CorporateManager = 0x4d,
    Exchange = 0x43,
};

