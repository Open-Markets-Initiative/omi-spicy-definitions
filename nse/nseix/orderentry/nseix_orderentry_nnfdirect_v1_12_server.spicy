module NseNseixOrderentryNnfdirectV112Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NseixOrderentryV112 = unit {
    server_direct_packet: ServerDirectPacket[] &eod;
};

type ServerDirectPacket = unit {
    packet_header: PacketHeader;
    # read ahead from inside the arm that follows; it consumes nothing
    next_transaction_code: int16 &parse-at=(self.input() + self.offset() + 16) &convert=TransactionCode($$);
    switch ( self.next_transaction_code ) {
        TransactionCode::SecureBoxRegistrationResponseOutMessage -> server_registration_packet: ServerRegistrationPacket;
        * -> server_session_packet: ServerSessionPacket;
    };
};

type PacketHeader = unit {
    packet_length: uint16;
    packet_sequence_number: uint32;
};

type ServerRegistrationPacket = unit {
    registration_checksum: bytes &size=16;
    message_header: MessageHeader;
    switch ( self.message_header.transaction_code ) {
        TransactionCode::SignOnRequestOutMessage -> sign_on_request_out_message: SignOnRequestOutMessage(self.message_header.message_length);
        TransactionCode::SignOnRequestOutMessage_5585 -> sign_on_request_out_message: SignOnRequestOutMessage(self.message_header.message_length);
