type UpdateLocalDatabaseHeaderMessage = unit {
    : skip bytes &size=2;   # padding
};

type UpdateLocalDatabaseTrailerMessage = unit {
    : skip bytes &size=2;   # padding
};

type UpdateLocalDatabaseDataMessage = unit {
    inner_header: InnerHeader;
    local_database_data: LocalDatabaseData;
};

type InnerHeader = unit {
    inner_trader_id: int32;
    inner_log_time: int32 &convert=time($$ + 315532800);
    inner_alpha_char: bytes &size=2;
    inner_transaction_code: int16;
    inner_error_code: int16;
    inner_timestamp: bytes &size=8;
    inner_time_stamp_1: bytes &size=8;
    inner_time_stamp_2: bytes &size=8;
    inner_message_length: int16;
};

type LocalDatabaseData = unit {
    data_payload: bytes &eod;
};

type MessageRecordMessage = unit {
    inner_header: InnerHeader;
    message_download_data: MessageDownloadData;
};

type MessageDownloadData = unit {
    download_payload: bytes &eod;
};

type OrderConfirmationMessage = unit {
    order_entry_body: OrderEntryBody;
};

type OrderEntryBody = unit {
    participant_type: bytes &size=1;
    : skip bytes &size=1;   # padding
    competitor_period: int16;
    solicitor_period: int16;
    modified_cancelled_by: uint8 &convert=ModifiedCancelledBy($$);
    : skip bytes &size=1;   # padding
    reason_code: int16 &convert=ReasonCode($$);
    : skip bytes &size=4;   # padding
    token_no: int32;
    contract_desc: ContractDesc;
    counter_party_broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    : skip bytes &size=2;   # padding
    closeout_flag: bytes &size=1;
    : skip bytes &size=1;   # padding
    order_type: int16;
    order_number: real &type=spicy::RealType::IEEE754_Double;
    account_number: bytes &size=10;
    book_type: int16 &convert=BookType($$);
    buy_sell_indicator: int16 &convert=BuySellIndicator($$);
    disclosed_volume: int32;
    disclosed_volume_remaining: int32;
    total_volume_remaining: int32;
    volume: int32;
    volume_filled_today: int32;
    price: int32;
    trigger_price: int32;
    good_till_date: int32;
    entry_date_time: int32 &convert=time($$ + 315532800);
    minimum_fill_aon_volume: int32;
    last_modified: int32 &convert=time($$ + 315532800);
    st_order_flags: bitfield(16) {
        nlt_indc: 0;
        pre_close: 1;
        preopen: 2;
        frozen: 3;
        modified: 4;
        traded: 5;
        matched_ind: 6;
        mf: 7;
        aon: 8;
        ioc: 9;
        gtc: 10;
        day: 11;
        mit: 12;
        sl: 13;
        market: 14;
        ato: 15;
    } &byte-order=spicy::ByteOrder::Big;
    branch_id: int16;
    trader_id: int32;
    broker_id: bytes &size=5;
    c_ord_filler: bytes &size=24;
    open_close: uint8 &convert=OpenClose($$);
    settlor: bytes &size=12;
    pro_client_indicator: int16 &convert=ProClientIndicator($$);
    settlement_period: int16;
    additional_order_flags: bitfield(8) {
        reserved_bit_1: 0;
        col: 1;
        reserved_34: 2..3;
        stpc: 4;
        session_ind: 5;
        reserved_78: 6..7;
    } &byte-order=spicy::ByteOrder::Little;
    giveup_flag: bytes &size=1;
    reference: bytes &size=4;
    nnf_field: real &type=spicy::RealType::IEEE754_Double;
    mkt_replay: real &type=spicy::RealType::IEEE754_Double;
    echo_back: bytes &size=16;
    last_activity_reference: int64;
    : skip bytes &size=52;   # padding
};

type ContractDesc = unit {
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    expiry_date: int32 &convert=time($$ + 315532800);
    strike_price: int32;
    option_type: bytes &size=2;
    ca_level: int16;
};

