        TransactionCode::OrderResponseMessage_2089 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_2170 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_2231 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_9002 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_27100 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderCancellationConfirmationMessage -> order_cancellation_confirmation_message: OrderCancellationConfirmationMessage(self.message_header.message_length);
        TransactionCode::TradeInquiryResponseMessage -> trade_inquiry_response_message: TradeInquiryResponseMessage;
        TransactionCode::TradeInquiryResponseMessage_2288 -> trade_inquiry_response_message: TradeInquiryResponseMessage;
