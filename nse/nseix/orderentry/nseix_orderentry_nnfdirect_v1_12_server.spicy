        TransactionCode::OrderResponseMessage -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_2012 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_2041 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_2042 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_2071 -> order_response_message: OrderResponseMessage;
        TransactionCode::OrderResponseMessage_2072 -> order_response_message: OrderResponseMessage;
