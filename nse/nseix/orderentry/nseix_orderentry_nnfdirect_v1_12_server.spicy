type MessageHeader = unit {
    transaction_code: int16 &convert=TransactionCode($$);
    log_time: int32 &convert=time($$ + 315532800);
    alpha_char: bytes &size=2;
    trader_id: int32;
    error_code: int16 &convert=ErrorCode($$);
    header_timestamp: bytes &size=8;
    time_stamp_1: bytes &size=8;
    time_stamp_2: bytes &size=8;
    message_length: int16;
};

type SignOnRequestOutMessage = unit(message_length: int16) {
    switch ( message_length ) {
        214 -> sign_on_out_body: SignOnOutBody;
        182 -> error_response_body: ErrorResponseBody;
        * -> unknown: bytes &eod;
    };
};

type SignOnOutBody = unit {
    user_id: int32;
    password: bytes &size=8;
    new_password: bytes &size=8;
    trader_name: bytes &size=26;
    last_password_change_date: int32 &convert=time($$ + 315532800);
    broker_id: bytes &size=5;
    : skip bytes &size=1;   # padding
    branch_id: int16;
    version_number: int32;
    end_time: int32 &convert=time($$ + 315532800);
    : skip bytes &size=1;   # padding
    colour: bytes &size=50;
    : skip bytes &size=1;   # padding
    user_type: int16 &convert=UserType($$);
    sequence_number: real &type=spicy::RealType::IEEE754_Double;
    ws_class_name: bytes &size=14;
    broker_status: uint8 &convert=BrokerStatus($$);
    : skip bytes &size=1;   # padding
    st_broker_eligibility_per_mkt: bitfield(16) {
        reserved_19: 0..8;
        nlt: 9;
        pre_close: 10;
        preopen: 11;
        auction_market: 12;
        spot_market: 13;
        oddlot_market: 14;
        normal_market: 15;
    } &byte-order=spicy::ByteOrder::Big;
    member_type: int16 &convert=MemberType($$);
    clearing_status: uint8 &convert=ClearingStatus($$);
    broker_name: bytes &size=25;
};

type ErrorResponseBody = unit {
    key: bytes &size=14;
    error_message: bytes &size=128;
};

type SignOffRequestOutMessage = unit {
    user_id: int32;
    : skip bytes &size=145;   # padding
    : skip bytes &size=1;   # padding
};

type SystemInformationOutMessage = unit {
    st_market_status: StMarketStatus;
    st_ex_market_status: StExMarketStatus;
    st_pl_market_status: StPlMarketStatus;
    update_portfolio: bytes &size=1;
    c_filler: bytes &size=1;
    market_index: int32;
    default_settlement_period_normal: int16;
    default_settlement_period_spot: int16;
    default_settlement_period_auction: int16;
    competitor_period: int16;
    solicitor_period: int16;
    warning_percent: int16;
    volume_freeze_percent: int16;
    snap_quote_time: int16;
    : skip bytes &size=2;   # padding
    board_lot_quantity: int32;
    tick_size: int32;
    maximum_gtc_days: int16;
    st_stock_eligible_indicators: bitfield(16) {
        reserved_113: 0..12;
        books_merged: 13;
        minimum_fill: 14;
        aon: 15;
    } &byte-order=spicy::ByteOrder::Big;
    disclosed_quantity_percent_allowed: int16;
    risk_free_interest_rate: int32;
};

type StMarketStatus = unit {
    normal: int16 &convert=Normal($$);
    oddlot: int16 &convert=Oddlot($$);
    spot: int16 &convert=Spot($$);
    auction: int16 &convert=Auction($$);
};

