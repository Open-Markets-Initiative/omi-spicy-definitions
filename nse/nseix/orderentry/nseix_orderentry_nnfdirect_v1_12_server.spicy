type OrderCancellationConfirmationMessage = unit(message_length: int16) {
    switch ( message_length ) {
        316 -> order_entry_body: OrderEntryBody;
        480 -> spread_order_body: SpreadOrderBody;
        * -> unknown: bytes &eod;
    };
};

