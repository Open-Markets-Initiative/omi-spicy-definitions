    day_high_price_diff_range: int32;
    op_low_price_diff_range: int32;
    op_high_price_diff_range: int32;
    st_spd_eligibility: bitfield(8) {
        reserved_17: 0..6;
        eligibility: 7;
    } &byte-order=spicy::ByteOrder::Little;
    : skip bytes &size=1;   # padding
    delete_flag: uint8 &convert=DeleteFlag($$);
    : skip bytes &size=1;   # padding
};

type SecInfo1 = unit {
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    series: bytes &size=2;
    expiry_date: int32 &convert=time($$ + 315532800);
    strike_price: int32;
    option_type: bytes &size=2;
