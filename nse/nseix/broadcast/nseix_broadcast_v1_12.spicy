};

type SecInfo2 = unit {
    instrument_name: bytes &size=6;
    symbol: bytes &size=10;
    series: bytes &size=2;
    expiry_date: int32 &convert=time($$ + 315532800);
    strike_price: int32;
    option_type: bytes &size=2;
    ca_level: int16;
};

type TransactionCode = enum {
    BroadcastJournalVctMessage = 6501,
    SecurityMasterChangeMessage = 7305,
    SecurityMasterChangeMessage_7340 = 7340,
    InstrumentMasterChangeMessage = 7324,
    ParticipantMasterChangeMessage = 7306,
    SecurityStatusChangeMessage = 7320,
    SecurityStatusChangeMessage_7210 = 7210,
    TurnoverExceededMessage = 9010,
    TurnoverExceededMessage_9011 = 9011,
    MarketStatusMessage = 6511,
    MarketStatusMessage_6521 = 6521,
    MarketStatusMessage_6522 = 6522,
    MarketStatusMessage_6531 = 6531,
    MarketStatusMessage_6551 = 6551,
    MarketStatusMessage_6571 = 6571,
    TickerAndMarketIndexMessage = 7202,
    MarketByOrderAndMarketByPriceMessage = 7200,
    OnlyMarketByPriceMessage = 7208,
    OnlyMarketByPriceMessage_7343 = 7343,
    MarketWatchRoundRobinMessage = 7201,
    CurrencyAssetsMessage = 7213,
    InterestRateAssetsMessage = 7214,
    CircuitCheckMessage = 6541,
    SpreadMarketByPriceDeltaMessage = 7211,
    AssetOpenInterestMessage = 7130,
    AssetInterestRateChangeMessage = 6503,
    TradeExecutionRangeMessage = 7220,
    TradeExecutionRangeMessage_7221 = 7221,
    TradeExecutionRangeMessage_7342 = 7342,
    MarketByAggregateDeltaMessage = 7215,
    MarketByAggregateDeltaMessage_7216 = 7216,
    SpreadCombinationMasterChangeMessage = 7309,
    SpreadCombinationMasterChangeMessage_7341 = 7341,
};

type PermittedToTrade = enum {
    ListedButNotPermittedToTrade = 0,
    PermittedToTrade_1 = 1,
};

type Status = enum {
    Preopen = 1,
    Open = 2,
    Suspended = 3,
    PriceDiscovery = 4,
    Preclose = 5,
};

type TradedInCents = enum {
    TradedInCents_x43 = 0x43,
};

type DeleteFlag = enum {
    Deleted = 0x59,
    Active = 0x4e,
};

type ParticipantStatus = enum {
    Suspended = 0x53,
    Active = 0x41,
};

type WarningType = enum {
    TurnoverLimitAboutToExceed = 1,
    TurnoverLimitExceeded = 2,
};

type MarketType = enum {
    NormalMarket = 1,
    OddLotMarket = 2,
    SpotMarket = 3,
    AuctionMarket = 4,
};

type BookType = enum {
    RegularLotOrder = 1,
    SpecialTermsOrder = 2,
    StopLossOrMitOrder = 3,
    NegotiatedOrderOrNlt = 4,
    OddLotOrder = 5,
    SpotOrder = 6,
    AuctionOrder = 7,
};

type TradingStatus = enum {
    Preopen = 1,
    Open = 2,
    Suspended = 3,
    PriceDiscovery = 4,
    Preclose = 5,
};

type NetChangeIndicator = enum {
    Increase = 0x2b,
    Decrease = 0x2d,
};

type AuctionStatus = enum {
    PreOpen = 0,
    Open = 1,
    Closed = 2,
    PreOpenEnded = 3,
    Postclose = 4,
};

