    token_1: int32;
    token_2: int32;
    mbp_buy: int16;
    mbp_sell: int16;
    last_active_time: int32 &convert=time($$ + 315532800);
    traded_volume: int32;
    total_traded_value: real &type=spicy::RealType::IEEE754_Double;
    mbp_buys: MbpBuys[5];
    mbp_sells: MbpSells[5];
    total_order_volume: TotalOrderVolume;
    open_price_difference: int32;
    day_high_price_difference: int32;
    day_low_price_difference: int32;
    last_traded_price_difference: int32;
