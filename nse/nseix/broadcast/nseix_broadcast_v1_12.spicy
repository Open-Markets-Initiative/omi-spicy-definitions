    impact_cost: int32;
    order_price: int32;
};

type SellSide = unit {
    cumulative_quantity_of_orders: int32;
    wap: int32;
    total_value: real &type=spicy::RealType::IEEE754_Double;
    impact_cost: int32;
    order_price: int32;
};

type SpreadCombinationMasterChangeMessage = unit {
    token_1: int32;
    token_2: int32;
    sec_info_1: SecInfo1;
    sec_info_2: SecInfo2;
