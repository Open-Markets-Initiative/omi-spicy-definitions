# License: MIT No Attribution

module NseNseslbmBroadcastNnfbcastV27;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NseslbmBroadcastV27 = unit {
    bcast_pack_data: BcastPackData;
};

type BcastPackData = unit {
    net_id: bytes &size=2;
    number_of_packets: int16;
    packed_packet: PackedPacket[cast<uint64>(self.number_of_packets)];
};

type PackedPacket = unit {
    compression_length: int16;
    broadcast_data: BroadcastData;
};

type BroadcastData = unit {
    bcast_market_type: bytes &size=1;
    : skip bytes &size=7;   # padding
    bcast_header: BcastHeader;
    switch ( self.bcast_header.transaction_code ) {
        TransactionCode::GeneralMessageBroadcastMessage -> general_message_broadcast_message: GeneralMessageBroadcastMessage;
        TransactionCode::ChangeInSystemStatusParametersMessage -> change_in_system_status_parameters_message: ChangeInSystemStatusParametersMessage;
        TransactionCode::ChangeInSecurityMasterMessage -> change_in_security_master_message: ChangeInSecurityMasterMessage;
        TransactionCode::ChangeParticipantStatusMessage -> change_participant_status_message: ChangeParticipantStatusMessage;
        TransactionCode::ChangeOfSecurityStatusMessage -> change_of_security_status_message: ChangeOfSecurityStatusMessage;
        TransactionCode::ChangeOfSecurityStatusPreopenMessage -> change_of_security_status_preopen_message: ChangeOfSecurityStatusPreopenMessage;
        TransactionCode::TurnoverLimitExceededMessage -> turnover_limit_exceeded_message: TurnoverLimitExceededMessage;
        TransactionCode::BrokerReactivatedMessage -> broker_reactivated_message: BrokerReactivatedMessage;
        TransactionCode::AuctionActivityMessage -> auction_activity_message: AuctionActivityMessage;
        TransactionCode::ChangeOfAuctionStatusMessage -> change_of_auction_status_message: ChangeOfAuctionStatusMessage;
        TransactionCode::MarketOpenMessage -> market_open_message: MarketOpenMessage;
        TransactionCode::MarketCloseMessage -> market_close_message: MarketCloseMessage;
        TransactionCode::PreopenShutdownMessage -> preopen_shutdown_message: PreopenShutdownMessage;
        TransactionCode::NormalMarketPreopenEndedMessage -> normal_market_preopen_ended_message: NormalMarketPreopenEndedMessage;
        TransactionCode::TickerAndMarketIndexMessage -> ticker_and_market_index_message: TickerAndMarketIndexMessage;
        TransactionCode::MarketByOrderMarketByPriceUpdateMessage -> market_by_order_market_by_price_update_message: MarketByOrderMarketByPriceUpdateMessage;
        TransactionCode::OnlyMarketByPriceUpdateMessage -> only_market_by_price_update_message: OnlyMarketByPriceUpdateMessage;
        TransactionCode::MarketWatchUpdateMessage -> market_watch_update_message: MarketWatchUpdateMessage;
        TransactionCode::SecurityOpenMessage -> security_open_message: SecurityOpenMessage;
        TransactionCode::MultipleIndexBroadcastMessage -> multiple_index_broadcast_message: MultipleIndexBroadcastMessage;
        TransactionCode::BroadcastIndustryIndexMessage -> broadcast_industry_index_message: BroadcastIndustryIndexMessage;
        TransactionCode::BroadcastBuyBackInformationMessage -> broadcast_buy_back_information_message: BroadcastBuyBackInformationMessage;
        TransactionCode::MarketStatisticsReportMessage -> market_statistics_report_message: MarketStatisticsReportMessage;
        TransactionCode::ContingencyBroadcastMessage -> contingency_broadcast_message: ContingencyBroadcastMessage;
        * -> unknown: bytes &eod;
    };
};

type BcastHeader = unit {
    : skip bytes &size=2;   # padding
    : skip bytes &size=2;   # padding
    log_time: int32 &convert=time($$ + 315532800);
    alpha_char: bytes &size=2;
    transaction_code: int16 &convert=TransactionCode($$);
    error_code: int16;
    bc_seq_no: int32;
    : skip bytes &size=1;   # padding
    : skip bytes &size=3;   # padding
    time_stamp_2: bytes &size=8;
    : skip bytes &size=8;   # padding
    message_length: int16;
};

type GeneralMessageBroadcastMessage = unit {
    branch_number: int16;
    broker_number: bytes &size=5;
    action_code: bytes &size=3;
    : skip bytes &size=4;   # padding
    broadcast_destination: bitfield(16) {
        reserved_115: 0..14;
        trader_ws: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broadcast_message_length: int16;
    broadcast_message: bytes &size=239;
};

type ChangeInSystemStatusParametersMessage = unit {
    normal: int16 &convert=Normal($$);
    oddlot: int16 &convert=Oddlot($$);
    spot: int16 &convert=Spot($$);
    auction: int16 &convert=Auction($$);
    market_index: int32;
    default_settlement_period_normal: int16;
    default_settlement_period_spot: int16;
    default_settlement_period_auction: int16;
    competitor_period: int16;
    solicitor_period: int16;
    warning_percent: int16;
    volume_freeze_percent: int16;
    : skip bytes &size=2;   # padding
    terminal_idle_time: int16;
    board_lot_quantity: int32;
    tick_size: int32;
    maximum_gtc_days: int16;
    security_eligible_indicators: bitfield(16) {
        reserved_113: 0..12;
        books_merged: 13;
        minimum_fill: 14;
        aon: 15;
    } &byte-order=spicy::ByteOrder::Big;
    disclosed_quantity_percent_allowed: int16;
    : skip bytes &size=4;   # padding
};

type ChangeInSecurityMasterMessage = unit {
    token: int32;
    sec_info: SecInfo;
    instrument_type: int16 &convert=InstrumentType($$);
    permitted_to_trade: int16 &convert=PermittedToTrade($$);
    issued_capital: real &type=spicy::RealType::IEEE754_Double;
    warning_percent: int16;
    freeze_percent: int16;
    credit_rating: bytes &size=17;
    security_eligibility_per_market: SecurityEligibilityPerMarket[4];
    issue_rate: int16;
    issue_start_date: int32 &convert=time($$ + 315532800);
    interest_payment_date: int32 &convert=time($$ + 315532800);
    issue_maturity_date: int32 &convert=time($$ + 315532800);
    board_lot_quantity: int32;
    tick_size: int32;
    name: bytes &size=25;
    : skip bytes &size=1;   # padding
    listing_date: int32 &convert=time($$ + 315532800);
    expulsion_date: int32 &convert=time($$ + 315532800);
    re_admission_date: int32 &convert=time($$ + 315532800);
    record_date: int32 &convert=time($$ + 315532800);
    expiry_date: int32 &convert=time($$ + 315532800);
    no_delivery_start_date: int32 &convert=time($$ + 315532800);
    no_delivery_end_date: int32 &convert=time($$ + 315532800);
    eligiblity_indicators: bitfield(16) {
        indicators_reserved_18: 0..7;
        allow_repay: 8;
        allow_recall: 9;
        indicators_reserved_1113: 10..12;
        minimum_fill: 13;
        aon: 14;
        participate_in_market_index: 15;
    } &byte-order=spicy::ByteOrder::Big;
    book_closure_start_date: int32 &convert=time($$ + 315532800);
    book_closure_end_date: int32 &convert=time($$ + 315532800);
    purpose: bitfield(16) {
        reserved_110: 0..9;
        egm: 10;
        agm: 11;
        interest: 12;
        bonus: 13;
        rights: 14;
        dividend: 15;
    } &byte-order=spicy::ByteOrder::Big;
    local_update_date_time: int32 &convert=time($$ + 315532800);
    delete_flag: uint8 &convert=DeleteFlag($$);
    remark: bytes &size=25;
    face_value: int32;
    isin_number: bytes &size=12;
};

type SecInfo = unit {
    symbol: bytes &size=10;
    series: bytes &size=2;
};

type SecurityEligibilityPerMarket = unit {
    security_eligibility_flags: bitfield(8) {
        reserved_17: 0..6;
        eligibility: 7;
    } &byte-order=spicy::ByteOrder::Little;
    status: int16 &convert=Status($$);
};

type ChangeParticipantStatusMessage = unit {
    participant_id: bytes &size=12;
    participant_name: bytes &size=25;
    participant_status: uint8 &convert=ParticipantStatus($$);
    participant_update_date_time: int32 &convert=time($$ + 315532800);
    delete_flag: uint8 &convert=DeleteFlag($$);
};

type ChangeOfSecurityStatusMessage = unit {
    number_of_records: int16;
    token_and_eligibility: TokenAndEligibility[35];
};

type TokenAndEligibility = unit {
    token: int32;
    security_status_per_market: SecurityStatusPerMarket[4];
};

type SecurityStatusPerMarket = unit {
    status: int16 &convert=Status($$);
};

type ChangeOfSecurityStatusPreopenMessage = unit {
    number_of_records: int16;
    token_and_eligibility: TokenAndEligibility[35];
};

type TurnoverLimitExceededMessage = unit {
    broker_code: bytes &size=5;
    counter_broker_code: bytes &size=5;
    warning_type: int16 &convert=WarningType($$);
    sec_info: SecInfo;
    trade_number: int32;
    trade_price: int32;
    trade_volume: int32;
    final: bytes &size=1;
};

type BrokerReactivatedMessage = unit {
    broker_code: bytes &size=5;
    counter_broker_code: bytes &size=5;
    warning_type: int16 &convert=WarningType($$);
    sec_info: SecInfo;
    trade_number: int32;
    trade_price: int32;
    trade_volume: int32;
    final: bytes &size=1;
};

type AuctionActivityMessage = unit {
    st_auction_inq_info: StAuctionInqInfo;
};

type StAuctionInqInfo = unit {
    token: int32;
    auction_number: int16;
    auction_status: int16 &convert=AuctionStatus($$);
    initiator_type: int16;
    total_buy_qty: int32;
    best_buy_price: int32;
    total_sell_qty: int32;
    best_sell_price: int32;
    auction_price: int32;
    auction_qty: int32;
    settlement_period: int16;
};

type ChangeOfAuctionStatusMessage = unit {
    sec_info: SecInfo;
    auction_number: int16;
    auction_status_char: bytes &size=1;
    action_code: bytes &size=3;
    broadcast_destination: bitfield(16) {
        reserved_115: 0..14;
        trader_ws: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broadcast_message_length: int16;
    broadcast_message: bytes &size=239;
};

type MarketOpenMessage = unit {
    sec_info: SecInfo;
    market_type: int16 &convert=MarketType($$);
    broadcast_destination: bitfield(16) {
        reserved_115: 0..14;
        trader_ws: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broadcast_message_length: int16;
    broadcast_message: bytes &size=239;
};

type MarketCloseMessage = unit {
    sec_info: SecInfo;
    market_type: int16 &convert=MarketType($$);
    broadcast_destination: bitfield(16) {
        reserved_115: 0..14;
        trader_ws: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broadcast_message_length: int16;
    broadcast_message: bytes &size=239;
};

type PreopenShutdownMessage = unit {
    sec_info: SecInfo;
    market_type: int16 &convert=MarketType($$);
    broadcast_destination: bitfield(16) {
        reserved_115: 0..14;
        trader_ws: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broadcast_message_length: int16;
    broadcast_message: bytes &size=239;
};

type NormalMarketPreopenEndedMessage = unit {
    sec_info: SecInfo;
    market_type: int16 &convert=MarketType($$);
    broadcast_destination: bitfield(16) {
        reserved_115: 0..14;
        trader_ws: 15;
    } &byte-order=spicy::ByteOrder::Big;
    broadcast_message_length: int16;
    broadcast_message: bytes &size=239;
};

type TickerAndMarketIndexMessage = unit {
    number_of_records: int16;
    ticker_index_information: TickerIndexInformation[25];
};

type TickerIndexInformation = unit {
    token: int32;
    market_type: int16 &convert=MarketType($$);
    fill_price: int32;
    fill_volume: int32;
    market_index_value: int32;
};

type MarketByOrderMarketByPriceUpdateMessage = unit {
    interactive_mbo_data: InteractiveMboData;
    mbp_information: MbpInformation[10];
    bb_total_buy_flag: int16 &convert=BbTotalBuyFlag($$);
    bb_total_sell_flag: int16;
    total_buy_quantity: real &type=spicy::RealType::IEEE754_Double;
    total_sell_quantity: real &type=spicy::RealType::IEEE754_Double;
    mbo_mbp_indicator: bitfield(16) {
        reserved_112: 0..11;
        sell: 12;
        buy: 13;
        last_trade_less: 14;
        last_trade_more: 15;
    } &byte-order=spicy::ByteOrder::Big;
    closing_price: int32;
    open_price: int32;
    high_price: int32;
    low_price: int32;
};

type InteractiveMboData = unit {
    token: int32;
    book_type: int16 &convert=BookType($$);
    trading_status: int16 &convert=TradingStatus($$);
    volume_traded_today: int32;
    last_traded_price: int32;
    net_change_indicator: uint8 &convert=NetChangeIndicator($$);
    : skip bytes &size=1;   # padding
    net_price_change_from_closing_price: int32;
    last_trade_quantity: int32;
    last_trade_time: int32 &convert=time($$ + 315532800);
    average_trade_price: int32;
    auction_number: int16;
    auction_status: int16 &convert=AuctionStatus($$);
    initiator_type: int16;
    initiator_price: int32;
    initiator_quantity: int32;
    auction_price: int32;
    auction_quantity: int32;
    mbo_information: MboInformation[10];
};

type MboInformation = unit {
    trader_id: int32;
    qty: int32;
    price: int32;
    st_mbo_mbp_terms: bitfield(16) {
        reserved_114: 0..13;
        aon: 14;
        mf: 15;
    } &byte-order=spicy::ByteOrder::Big;
    min_fill_qty: int32;
};

type MbpInformation = unit {
    quantity: int32;
    price: int32;
    number_of_orders: int16;
    bb_buy_sell_flag: int16;
};

type OnlyMarketByPriceUpdateMessage = unit {
    no_of_records: int16;
    interactive_only_mbp_data: InteractiveOnlyMbpData[2];
};

type InteractiveOnlyMbpData = unit {
    token: int32;
    book_type: int16 &convert=BookType($$);
    trading_status: int16 &convert=TradingStatus($$);
    volume_traded_today: int32;
    last_traded_price: int32;
    net_change_indicator: uint8 &convert=NetChangeIndicator($$);
    net_price_change_from_closing_price: int32;
    last_trade_quantity: int32;
    last_trade_time: int32 &convert=time($$ + 315532800);
    average_trade_price: int32;
    auction_number: int16;
    auction_status: int16 &convert=AuctionStatus($$);
    initiator_type: int16;
    initiator_price: int32;
    initiator_quantity: int32;
    auction_price: int32;
    auction_quantity: int32;
    mbp_information: MbpInformation[10];
    bb_total_buy_flag: int16 &convert=BbTotalBuyFlag($$);
    bb_total_sell_flag: int16;
    total_buy_quantity: real &type=spicy::RealType::IEEE754_Double;
    total_sell_quantity: real &type=spicy::RealType::IEEE754_Double;
    mbp_indicator: bitfield(16) {
        reserved_112: 0..11;
        sell: 12;
        buy: 13;
        last_trade_less: 14;
        last_trade_more: 15;
    } &byte-order=spicy::ByteOrder::Big;
    closing_price: int32;
    open_price: int32;
    high_price: int32;
    low_price: int32;
};

type MarketWatchUpdateMessage = unit {
    no_of_records: int16;
    marketwatchbroadcast: Marketwatchbroadcast[5];
};

type Marketwatchbroadcast = unit {
    token: int32;
    market_wise_information: MarketWiseInformation[3];
};

type MarketWiseInformation = unit {
    mbo_mbp_indicator: bitfield(16) {
        reserved_112: 0..11;
        sell: 12;
        buy: 13;
        last_trade_less: 14;
        last_trade_more: 15;
    } &byte-order=spicy::ByteOrder::Big;
    buy_volume: int32;
    buy_price: int32;
    sell_volume: int32;
    sell_price: int32;
    last_trade_price: int32;
    last_trade_time: int32 &convert=time($$ + 315532800);
};

type SecurityOpenMessage = unit {
    sec_info: SecInfo;
    token: int32;
    opening_price: int32;
};

type MultipleIndexBroadcastMessage = unit {
    number_of_records: int16;
    indices: Indices[6];
};

type Indices = unit {
    index_name: bytes &size=21;
    index_value: int32;
    high_index_value: int32;
    low_index_value: int32;
    opening_index: int32;
    closing_index: int32;
    percent_change: int32;
    yearly_high: int32;
    yearly_low: int32;
    no_of_upmoves: int32;
    no_of_downmoves: int32;
    market_capitalisation: real &type=spicy::RealType::IEEE754_Double;
    net_change_indicator: uint8 &convert=NetChangeIndicator($$);
    : skip bytes &size=1;   # padding
};

type BroadcastIndustryIndexMessage = unit {
    number_of_records: int16;
    industry_indices: IndustryIndices[17];
};

type IndustryIndices = unit {
    index_name: bytes &size=21;
    index_value: int32;
};

type BroadcastBuyBackInformationMessage = unit {
    number_of_records: int16;
    buybackdata: Buybackdata[6];
};

type Buybackdata = unit {
    token: int32;
    symbol: bytes &size=10;
    series: bytes &size=2;
    pday_cum_vol: real &type=spicy::RealType::IEEE754_Double;
    pday_high_price: int32;
    pday_low_price: int32;
    pday_wt_avg: int32;
    cday_cum_vol: real &type=spicy::RealType::IEEE754_Double;
    cday_high_price: int32;
    cday_low_price: int32;
    cday_wt_avg: int32;
    start_date: int32 &convert=time($$ + 315532800);
    end_date: int32 &convert=time($$ + 315532800);
};

type MarketStatisticsReportMessage = unit {
    message_type: uint8 &convert=MessageType($$);
    switch ( self.message_type ) {
        MessageType::Header -> report_header_body: ReportHeaderBody;
        MessageType::ReportData -> report_statistics_body: ReportStatisticsBody;
        MessageType::DepositoryData -> report_statistics_body: ReportStatisticsBody;
        MessageType::Trailer -> report_trailer_body: ReportTrailerBody;
        * -> unknown: bytes &eod;
    };
};

type ReportHeaderBody = unit {
    : skip bytes &size=1;   # padding
    report_date: int32 &convert=time($$ + 315532800);
    user_type: int16;
    broker_id: bytes &size=5;
    broker_name: bytes &size=25;
    trader_number: int32;
    trader_name: bytes &size=26;
};

type ReportStatisticsBody = unit {
    : skip bytes &size=1;   # padding
    number_of_records: int16;
    market_statistics_data: MarketStatisticsData[7];
};

type MarketStatisticsData = unit {
    sec_info: SecInfo;
    reverse_leg_settl_date: int32 &convert=time($$ + 315532800);
    market_type: int16 &convert=MarketType($$);
    open_price: int32;
    high_price: int32;
    low_price: int32;
    closing_price: int32;
    total_quantity_traded: int32;
    total_value_traded: real &type=spicy::RealType::IEEE754_Double;
    previous_close_price: int32;
    life_time_high: int32;
    l_ife_time_low: int32;
    corporate_action_indicator: bytes &size=4;
};

type ReportTrailerBody = unit {
    number_of_records_long: int32;
    : skip bytes &size=1;   # padding
};

type ContingencyBroadcastMessage = unit {
    stream_number: int16;
    outage_status: int16 &convert=OutageStatus($$);
    : skip bytes &size=200;   # padding
};

type TransactionCode = enum {
    GeneralMessageBroadcastMessage = 6501,
    ChangeInSystemStatusParametersMessage = 7206,
    ChangeInSecurityMasterMessage = 7305,
    ChangeParticipantStatusMessage = 7306,
    ChangeOfSecurityStatusMessage = 7320,
    ChangeOfSecurityStatusPreopenMessage = 7210,
    TurnoverLimitExceededMessage = 9010,
    BrokerReactivatedMessage = 9011,
    AuctionActivityMessage = 6582,
    ChangeOfAuctionStatusMessage = 6581,
    MarketOpenMessage = 6511,
    MarketCloseMessage = 6521,
    PreopenShutdownMessage = 6531,
    NormalMarketPreopenEndedMessage = 6571,
    TickerAndMarketIndexMessage = 7202,
    MarketByOrderMarketByPriceUpdateMessage = 7200,
    OnlyMarketByPriceUpdateMessage = 7208,
    MarketWatchUpdateMessage = 7201,
    SecurityOpenMessage = 6013,
    BroadcastCircuitCheckMessage = 6541,
    MultipleIndexBroadcastMessage = 7207,
    BroadcastIndustryIndexMessage = 7203,
    BroadcastBuyBackInformationMessage = 7211,
    MarketStatisticsReportMessage = 1833,
    ContingencyBroadcastMessage = 5294,
};

type Normal = enum {
    Preopen = 0,
    Open = 1,
    Closed = 2,
    PreopenEnded = 3,
};

type Oddlot = enum {
    Preopen = 0,
    Open = 1,
    Closed = 2,
    PreopenEnded = 3,
};

type Spot = enum {
    Preopen = 0,
    Open = 1,
    Closed = 2,
    PreopenEnded = 3,
};

type Auction = enum {
    Preopen = 0,
    Open = 1,
    Closed = 2,
    PreopenEnded = 3,
};

type InstrumentType = enum {
    Equities = 0,
    PreferenceShares = 1,
    Debentures = 2,
    Warrants = 3,
    Miscellaneous = 4,
};

type PermittedToTrade = enum {
    ListedNotPermitted = 0,
    Permitted = 1,
};

type Status = enum {
    Preopen = 1,
    Open = 2,
    Suspended = 3,
    PreopenExtended = 4,
};

type DeleteFlag = enum {
    Deleted = 0x59,
    NotDeleted = 0x4e,
};

type ParticipantStatus = enum {
    Suspended = 0x53,
    Active = 0x41,
};

type WarningType = enum {
    LimitAboutToExceed = 1,
    LimitExceeded = 2,
};

type AuctionStatus = enum {
    AuctionPendingApproval = 1,
    AuctionPending = 2,
    OpenCompetitorPeriod = 3,
    OpenSolicitorPeriod = 4,
    AuctionMatching = 5,
    AuctionFinished = 6,
    AuctionCancelled = 7,
};

type MarketType = enum {
    Normal = 1,
    OddLot = 2,
    Spot = 3,
    Auction = 4,
};

type BookType = enum {
    RegularLotOrder = 1,
    SpecialTermsOrder = 2,
    StopLossOrder = 3,
    NegotiatedOrder = 4,
    OddLotOrder = 5,
    SpotOrder = 6,
    AuctionOrder = 7,
};

type TradingStatus = enum {
    Preopen = 1,
    Open = 2,
    Suspended = 3,
    PreopenExtended = 4,
};

type NetChangeIndicator = enum {
    Increase = 0x2b,
    Decrease = 0x2d,
    NoChange = 0x20,
};

type BbTotalBuyFlag = enum {
    NoBuyBackOrder = 0,
    BuyBackOrder = 1,
};

type MessageType = enum {
    Header = 0x48,
    ReportData = 0x52,
    DepositoryData = 0x44,
    Trailer = 0x54,
};

type OutageStatus = enum {
    EndOfOutage = 0,
    StartOfOutage = 1,
};

