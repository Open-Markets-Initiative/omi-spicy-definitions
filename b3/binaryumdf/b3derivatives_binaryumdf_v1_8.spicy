type DeprecatedInstrAttribsGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    deprecated_instr_attribs_group: DeprecatedInstrAttribsGroup[self.group_size_encoding.num_in_group];
};

type DeprecatedInstrAttribsGroup = unit {
    instr_attrib_type: uint8 &convert=InstrAttribType($$);
    instr_attrib_value: uint8 &convert=InstrAttribValue($$);
};

type SecurityDesc = unit {
    security_desc_length: uint8;
    security_desc_data: bytes &size=self.security_desc_length;
};

