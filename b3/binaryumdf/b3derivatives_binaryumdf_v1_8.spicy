    clearing_house_id: uint64;
    min_order_qty: int64;
    max_order_qty: int64;
    min_lot_size: int64;
    min_trade_vol: int64;
    corporate_action_event_id: uint32;
    issue_date: int32;
    maturity_date: int32;
    country_of_issue: bytes &size=2;
    start_date: int32;
    end_date: int32;
    settl_type: uint16;
    settl_date: int32;
    dated_date: int32;
    isin_number: bytes &size=12;
    asset: bytes &size=6;
    cfi_code: bytes &size=6;
    maturity_month_year: MaturityMonthYear;
    contract_settl_month: ContractSettlMonth;
    currency: bytes &size=3;
    strike_currency: bytes &size=3;
    settl_currency: bytes &size=3;
    security_strategy_type: bytes &size=3;
    lot_type: uint8 &convert=LotType($$);
    tick_size_denominator: uint8;
    product: uint8 &convert=Product($$);
    exercise_style: uint8 &convert=ExerciseStyle($$);
    put_or_call: uint8 &convert=PutOrCall($$);
    price_type_price_type_optional: uint8 &convert=PriceTypePriceTypeOptional($$);
    market_segment_id: uint8;
    governance_indicator: uint8 &convert=GovernanceIndicator($$);
    security_match_type: uint8 &convert=SecurityMatchType($$);
    last_fragment: uint8 &convert=LastFragment($$);
    multi_leg_model: uint8 &convert=MultiLegModel($$);
    multi_leg_price_method: uint8 &convert=MultiLegPriceMethod($$);
    min_cross_qty: int64;
    deprecated_underlyings_groups: DeprecatedUnderlyingsGroups;
    deprecated_legs_groups: DeprecatedLegsGroups;
    deprecated_instr_attribs_groups: DeprecatedInstrAttribsGroups;
    security_desc: SecurityDesc;
};

type MaturityMonthYear = unit {
    year: uint16;
    month: uint8;
    day: uint8;
    week: uint8;
};

type ContractSettlMonth = unit {
    year: uint16;
    month: uint8;
    day: uint8;
    week: uint8;
};

type DeprecatedUnderlyingsGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    deprecated_underlyings_group: DeprecatedUnderlyingsGroup[self.group_size_encoding.num_in_group];
};

type GroupSizeEncoding = unit {
    block_length: uint16;
    num_in_group: uint8;
};

type DeprecatedUnderlyingsGroup = unit {
    underlying_security_id: uint64;
    index_pct: int64;
    index_theoretical_qty: int64;
    underlying_symbol: bytes &size=20;
};

type DeprecatedLegsGroups = unit {
