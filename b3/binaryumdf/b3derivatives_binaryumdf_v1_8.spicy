module B3B3derivativesBinaryumdfSbeV18;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type B3derivativesBinaryumdfV18 = unit {
    packet_header: PacketHeader;
    message: Message[] &eod;
};

type PacketHeader = unit {
    channel_id: uint8;
    reserved: uint8;
    sequence_version: uint16;
    sequence_number: uint32;
    sending_time: uint64;
};

type Message = unit {
    framing_header: FramingHeader;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::Sequence2Message -> sequence_message: SequenceMessage;
        TemplateId::EmptyBook9Message -> empty_book_message: EmptyBookMessage;
        TemplateId::ChannelReset11Message -> channel_reset_11_message: ChannelReset11Message;
        TemplateId::SecurityStatus3Message -> security_status_3_message: SecurityStatus3Message;
        TemplateId::SecurityGroupPhase10Message -> security_group_phase_10_message: SecurityGroupPhase10Message;
        TemplateId::DeprecatedsecurityDefinitionMessage -> deprecated_security_definition_message: DeprecatedSecurityDefinitionMessage;
        TemplateId::SecurityDefinitionMessage -> security_definition_message: SecurityDefinitionMessage;
        TemplateId::News5Message -> news_5_message: News5Message;
        TemplateId::OpeningPrice15Message -> opening_price_15_message: OpeningPrice15Message;
        TemplateId::TheoreticalOpeningPrice16Message -> theoretical_opening_price_16_message: TheoreticalOpeningPrice16Message;
        TemplateId::ClosingPrice17Message -> closing_price_17_message: ClosingPrice17Message;
        TemplateId::AuctionImbalance19Message -> auction_imbalance_19_message: AuctionImbalance19Message;
        TemplateId::PriceBand20Message -> price_band_20_message: PriceBand20Message;
        TemplateId::QuantityBand21Message -> quantity_band_21_message: QuantityBand21Message;
        TemplateId::PriceBand22Message -> price_band_22_message: PriceBand22Message;
        TemplateId::HighPrice24Message -> high_price_24_message: HighPrice24Message;
        TemplateId::LowPrice25Message -> low_price_25_message: LowPrice25Message;
        TemplateId::LastTradePrice27Message -> last_trade_price_27_message: LastTradePrice27Message;
        TemplateId::SettlementPrice28Message -> settlement_price_28_message: SettlementPrice28Message;
        TemplateId::OpenInterest29Message -> open_interest_29_message: OpenInterest29Message;
        TemplateId::SnapshotFullRefreshHeader30Message -> snapshot_full_refresh_header_30_message: SnapshotFullRefreshHeader30Message;
        TemplateId::OrderMbO50Message -> order_mb_o_50_message: OrderMbO50Message;
        TemplateId::DeleteOrderMbO51Message -> delete_order_mb_o_51_message: DeleteOrderMbO51Message;
        TemplateId::MassDeleteOrdersMbO52Message -> mass_delete_orders_mb_o_52_message: MassDeleteOrdersMbO52Message;
        TemplateId::Trade53Message -> trade_53_message: Trade53Message;
        TemplateId::ForwardTrade54Message -> forward_trade_54_message: ForwardTrade54Message;
        TemplateId::ExecutionSummary55Message -> execution_summary_55_message: ExecutionSummary55Message;
        TemplateId::ExecutionStatistics56Message -> execution_statistics_56_message: ExecutionStatistics56Message;
        TemplateId::TradeBust57Message -> trade_bust_57_message: TradeBust57Message;
        TemplateId::SnapshotFullRefreshOrdersMbO71Message -> snapshot_full_refresh_orders_mb_o_71_message: SnapshotFullRefreshOrdersMbO71Message;
        * -> unknown: bytes &eod;
    };
};

type FramingHeader = unit {
    message_length: uint16;
    encoding_type: uint16;
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type SequenceMessage = unit {
    next_seq_no: uint32;
};

type EmptyBookMessage = unit {
    security_id: uint64;
    match_event_indicator: MatchEventIndicator;
    : skip bytes &size=3;   # padding
    md_entry_timestamp: uint64;
};

type MatchEventIndicator = unit {
    last_trade_msg: bytes &size=1;
    last_volume_msg: bytes &size=1;
    last_quote_msg: bytes &size=1;
    last_stats_msg: bytes &size=1;
    last_implied_msg: bytes &size=1;
    recovery_msg: bytes &size=1;
    reserved_1: bytes &size=1;
    end_of_event: bytes &size=1;
};

type ChannelReset11Message = unit {
    match_event_indicator: MatchEventIndicator;
    : skip bytes &size=3;   # padding
    md_entry_timestamp: uint64;
};

type SecurityStatus3Message = unit {
    security_id: uint64;
    match_event_indicator: MatchEventIndicator;
    trading_session_id: uint8 &convert=TradingSessionId($$);
    security_trading_status: uint8 &convert=SecurityTradingStatus($$);
    security_trading_event: uint8 &convert=SecurityTradingEvent($$);
    trade_date: uint16;
    : skip bytes &size=2;   # padding
    trad_ses_open_time: uint64;
    transact_time: uint64;
    rpt_seq: uint32;
};

type SecurityGroupPhase10Message = unit {
    security_group: bytes &size=3;
    : skip bytes &size=5;   # padding
    match_event_indicator: MatchEventIndicator;
    trading_session_id: uint8 &convert=TradingSessionId($$);
    trading_session_sub_id: uint8 &convert=TradingSessionSubId($$);
    security_trading_event: uint8 &convert=SecurityTradingEvent($$);
    trade_date: uint16;
    : skip bytes &size=2;   # padding
    trad_ses_open_time: uint64;
    transact_time: uint64;
};

