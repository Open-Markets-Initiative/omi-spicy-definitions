type BusinessMessageRejectMessage = unit {
    outbound_business_header: OutboundBusinessHeader;
    ref_msg_type: uint8 &convert=RefMsgType($$);
    : skip bytes &size=1;   # padding
    ref_seq_num: uint32;
    business_reject_ref_id: uint64;
    business_reject_reason: uint32;
    memo: Memo;
    text: Text;
};

type SecurityDefinitionRequestMessage = unit {
    inbound_business_header: InboundBusinessHeader;
    security_req_id: uint64;
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
    legs_groups: LegsGroups;
};

type LegsGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    legs_group: LegsGroup[self.group_size_encoding.num_in_group];
};

type LegsGroup = unit {
    leg_symbol: bytes &size=20;
    leg_ratio_qty: int64;
    leg_side: uint8 &convert=LegSide($$);
    : skip bytes &size=1;   # padding
};

type SecurityDefinitionResponseMessage = unit {
    outbound_business_header: OutboundBusinessHeader;
    : skip bytes &size=2;   # padding
    security_req_id: uint64;
    security_id_optional: uint64;
    security_response_type: uint8 &convert=SecurityResponseType($$);
    security_strategy_type: bytes &size=3;
    symbol: bytes &size=20;
    security_response_id: uint64;
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
};

type QuoteRequestMessage = unit {
    bidirectional_business_header: BidirectionalBusinessHeader;
    security_id: uint64;
    quote_req_id: uint64;
    quote_id_optional: uint64;
    trade_id_optional: uint32;
    contra_broker: uint32;
    transact_time: uint64;
    price_8: int64;
    settltype: uint8 &convert=Settltype($$);
    execute_underlying_trade: uint8 &convert=ExecuteUnderlyingTrade($$);
    order_qty: uint64;
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
