    trade_id: uint32;
    contra_broker: uint32;
    order_id: uint64;
    trade_date: uint16;
    tot_no_related_sym: uint8;
    : skip bytes &size=1;   # padding
    secondary_exec_id: uint64;
    exec_ref_id: uint64;
    crossid_optional: uint64;
    crossed_indicator: uint16 &convert=CrossedIndicator($$);
    order_qty: uint64;
    trading_session_id: uint8 &convert=TradingSessionId($$);
    trading_session_sub_id: uint8 &convert=TradingSessionSubId($$);
    security_trading_status: uint8 &convert=SecurityTradingStatus($$);
    cross_type: uint8 &convert=CrossType($$);
    cross_prioritization: uint8 &convert=CrossPrioritization($$);
    : skip bytes &size=1;   # padding
    strategy_id: int32;
    implied_event_id: ImpliedEventId;
    trading_sub_account: uint32;
    desk_id: DeskId;
    memo: Memo;
};

type ImpliedEventId = unit {
    event_id: uint32;
    no_related_trades: uint16;
};

