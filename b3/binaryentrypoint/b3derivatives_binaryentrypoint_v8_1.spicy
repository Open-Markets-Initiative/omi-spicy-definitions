module B3B3derivativesBinaryentrypointSbeV81;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type B3derivativesBinaryentrypointV81 = unit {
    simple_open_frame: SimpleOpenFrame[] &eod;
};

type SimpleOpenFrame = unit {
    simple_open_framing_header: SimpleOpenFramingHeader;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::NegotiateMessage -> negotiate_message: NegotiateMessage;
        TemplateId::NegotiateResponseMessage -> negotiate_response_message: NegotiateResponseMessage;
        TemplateId::NegotiateRejectMessage -> negotiate_reject_message: NegotiateRejectMessage;
        TemplateId::EstablishMessage -> establish_message: EstablishMessage;
        TemplateId::EstablishAckMessage -> establish_ack_message: EstablishAckMessage;
        TemplateId::EstablishRejectMessage -> establish_reject_message: EstablishRejectMessage;
        TemplateId::TerminateMessage -> terminate_message: TerminateMessage;
        TemplateId::NotAppliedMessage -> not_applied_message: NotAppliedMessage;
        TemplateId::SequenceMessage -> sequence_message: SequenceMessage;
        TemplateId::RetransmitRequestMessage -> retransmit_request_message: RetransmitRequestMessage;
        TemplateId::RetransmissionMessage -> retransmission_message: RetransmissionMessage;
        TemplateId::RetransmitRejectMessage -> retransmit_reject_message: RetransmitRejectMessage;
        TemplateId::SimpleNewOrderMessage -> simple_new_order_message: SimpleNewOrderMessage;
        TemplateId::SimpleModifyOrderMessage -> simple_modify_order_message: SimpleModifyOrderMessage;
        TemplateId::NewOrderSingleMessage -> new_order_single_message: NewOrderSingleMessage;
        TemplateId::OrderCancelReplaceRequestMessage -> order_cancel_replace_request_message: OrderCancelReplaceRequestMessage;
        TemplateId::OrderCancelRequestMessage -> order_cancel_request_message: OrderCancelRequestMessage;
        TemplateId::NewOrderCrossMessage -> new_order_cross_message: NewOrderCrossMessage;
        TemplateId::ExecutionReportNewMessage -> execution_report_new_message: ExecutionReportNewMessage;
        TemplateId::ExecutionReportModifyMessage -> execution_report_modify_message: ExecutionReportModifyMessage;
        TemplateId::ExecutionReportCancelMessage -> execution_report_cancel_message: ExecutionReportCancelMessage;
        TemplateId::ExecutionReportTradeMessage -> execution_report_trade_message: ExecutionReportTradeMessage;
        TemplateId::ExecutionReportRejectMessage -> execution_report_reject_message: ExecutionReportRejectMessage;
        TemplateId::ExecutionReportForwardMessage -> execution_report_forward_message: ExecutionReportForwardMessage;
        TemplateId::BusinessMessageRejectMessage -> business_message_reject_message: BusinessMessageRejectMessage;
        TemplateId::SecurityDefinitionRequestMessage -> security_definition_request_message: SecurityDefinitionRequestMessage;
        TemplateId::SecurityDefinitionResponseMessage -> security_definition_response_message: SecurityDefinitionResponseMessage;
        TemplateId::QuoteRequestMessage -> quote_request_message: QuoteRequestMessage;
        TemplateId::QuoteStatusReportMessage -> quote_status_report_message: QuoteStatusReportMessage;
        TemplateId::QuoteMessage -> quote_message: QuoteMessage;
        TemplateId::QuoteCancelMessage -> quote_cancel_message: QuoteCancelMessage;
        TemplateId::QuoteRequestRejectMessage -> quote_request_reject_message: QuoteRequestRejectMessage;
        TemplateId::PositionMaintenanceCancelRequestMessage -> position_maintenance_cancel_request_message: PositionMaintenanceCancelRequestMessage;
        TemplateId::PositionMaintenanceRequestMessage -> position_maintenance_request_message: PositionMaintenanceRequestMessage;
        TemplateId::PositionMaintenanceReportMessage -> position_maintenance_report_message: PositionMaintenanceReportMessage;
        TemplateId::AllocationInstructionMessage -> allocation_instruction_message: AllocationInstructionMessage;
        TemplateId::AllocationReportMessage -> allocation_report_message: AllocationReportMessage;
        TemplateId::OrderMassActionRequestMessage -> order_mass_action_request_message: OrderMassActionRequestMessage;
        TemplateId::OrderMassActionReportMessage -> order_mass_action_report_message: OrderMassActionReportMessage;
        * -> unknown: bytes &eod;
    };
};

type SimpleOpenFramingHeader = unit {
    message_length: uint16;
    encoding_type: uint16;
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type NegotiateMessage = unit {
    session_id: uint32;
    session_ver_id: uint64;
    timestamp: uint64;
    entering_firm: uint32;
    onbehalf_firm: uint32;
    credentials: Credentials;
    client_ip: ClientIp;
    client_app_name: ClientAppName;
    client_app_version: ClientAppVersion;
};

type Credentials = unit {
    credentials_length: uint8;
    credentials_data: bytes &size=self.credentials_length;
};

type ClientIp = unit {
    client_ip_length: uint8;
    client_ip_data: bytes &size=self.client_ip_length;
};

type ClientAppName = unit {
    client_app_name_length: uint8;
    client_app_name_data: bytes &size=self.client_app_name_length;
};

type ClientAppVersion = unit {
    client_app_version_length: uint8;
    client_app_version_data: bytes &size=self.client_app_version_length;
};

type NegotiateResponseMessage = unit {
    session_id: uint32;
    session_ver_id: uint64;
    request_timestamp: uint64;
    entering_firm: uint32;
};

type NegotiateRejectMessage = unit {
    session_id: uint32;
    session_ver_id: uint64;
    request_timestamp: uint64;
    entering_firm_optional: uint32;
    negotiation_reject_code: uint8 &convert=NegotiationRejectCode($$);
    : skip bytes &size=3;   # padding
    current_session_ver_id: uint64;
};

type EstablishMessage = unit {
    session_id: uint32;
    session_ver_id: uint64;
    timestamp: uint64;
    keep_alive_interval: uint64;
    next_seq_no: uint32;
    cancel_on_disconnect_type: uint8 &convert=CancelOnDisconnectType($$);
    : skip bytes &size=1;   # padding
    cod_timeout_window: uint64;
    credentials: Credentials;
};

type EstablishAckMessage = unit {
    session_id: uint32;
    session_ver_id: uint64;
    request_timestamp: uint64;
    keep_alive_interval: uint64;
    next_seq_no: uint32;
    last_incoming_seq_no: uint32;
};

type EstablishRejectMessage = unit {
    session_id: uint32;
    session_ver_id: uint64;
    request_timestamp: uint64;
    establishment_reject_code: uint8 &convert=EstablishmentRejectCode($$);
    : skip bytes &size=1;   # padding
    last_incoming_seq_no_optional: uint32;
};

type TerminateMessage = unit {
    session_id: uint32;
    session_ver_id: uint64;
    termination_code: uint8 &convert=TerminationCode($$);
};

type NotAppliedMessage = unit {
    from_seq_no: uint32;
    count: uint32;
};

type SequenceMessage = unit {
    next_seq_no: uint32;
};

type RetransmitRequestMessage = unit {
    session_id: uint32;
    timestamp: uint64;
    from_seq_no: uint32;
    count: uint32;
};

type RetransmissionMessage = unit {
    session_id: uint32;
    request_timestamp: uint64;
    next_seq_no: uint32;
    count: uint32;
};

type RetransmitRejectMessage = unit {
    session_id: uint32;
    request_timestamp: uint64;
    retransmit_reject_code: uint8 &convert=RetransmitRejectCode($$);
};

type SimpleNewOrderMessage = unit {
    inbound_business_header: InboundBusinessHeader;
    ordtagid: uint8;
    mm_protection_reset_boolean: uint8 &convert=MmProtectionResetBoolean($$);
    clordid: uint64;
    account: uint32;
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
    self_trade_prevention_instruction: uint8 &convert=SelfTradePreventionInstruction($$);
    security_id: uint64;
    side: uint8 &convert=Side($$);
    simple_ordtype: uint8 &convert=SimpleOrdtype($$);
    time_in_force_simple: uint8 &convert=TimeInForceSimple($$);
    routing_instruction: uint8 &convert=RoutingInstruction($$);
    order_qty: uint64;
    price_optional: int64;
    investor_id: InvestorId;
    memo: Memo;
};

type InboundBusinessHeader = unit {
    session_id: uint32;
    msg_seq_num: uint32;
    sending_time: uint64;
    market_segment_id: uint8;
    padding: bytes &size=1;
};

type InvestorId = unit {
    prefix: uint16;
    document: uint32;
};

type Memo = unit {
    memo_length: uint8;
    memo_data: bytes &size=self.memo_length;
};

type SimpleModifyOrderMessage = unit {
    inbound_business_header: InboundBusinessHeader;
    ordtagid: uint8;
    mm_protection_reset_boolean: uint8 &convert=MmProtectionResetBoolean($$);
    clordid: uint64;
    account: uint32;
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
    self_trade_prevention_instruction: uint8 &convert=SelfTradePreventionInstruction($$);
    security_id: uint64;
    side: uint8 &convert=Side($$);
    simple_ordtype: uint8 &convert=SimpleOrdtype($$);
    time_in_force_simple: uint8 &convert=TimeInForceSimple($$);
    routing_instruction: uint8 &convert=RoutingInstruction($$);
    order_qty: uint64;
    price_optional: int64;
    order_id_optional: uint64;
    origclordid: uint64;
    investor_id: InvestorId;
    memo: Memo;
};

type NewOrderSingleMessage = unit {
    inbound_business_header: InboundBusinessHeader;
    ordtagid: uint8;
    mm_protection_reset_boolean: uint8 &convert=MmProtectionResetBoolean($$);
    clordid: uint64;
    account: uint32;
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
    self_trade_prevention_instruction: uint8 &convert=SelfTradePreventionInstruction($$);
    security_id: uint64;
    side: uint8 &convert=Side($$);
    ordtype: uint8 &convert=Ordtype($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    routing_instruction: uint8 &convert=RoutingInstruction($$);
    order_qty: uint64;
    price_optional: int64;
    stop_px: int64;
    min_qty: uint64;
    max_floor: uint64;
    executing_trader_optional: bytes &size=5;
    expire_date: uint16;
    custodian_info: CustodianInfo;
    investor_id: InvestorId;
    strategy_id: int32;
    desk_id: DeskId;
    memo: Memo;
};

type CustodianInfo = unit {
    custodian: uint32;
    custody_account: uint32;
    custody_allocation_type: uint32;
};

type DeskId = unit {
    desk_id_length: uint8;
    desk_id_data: bytes &size=self.desk_id_length;
};

type OrderCancelReplaceRequestMessage = unit {
    inbound_business_header: InboundBusinessHeader;
    ordtagid: uint8;
    mm_protection_reset_boolean: uint8 &convert=MmProtectionResetBoolean($$);
    clordid: uint64;
    account: uint32;
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
    self_trade_prevention_instruction: uint8 &convert=SelfTradePreventionInstruction($$);
    security_id: uint64;
    side: uint8 &convert=Side($$);
    ordtype: uint8 &convert=Ordtype($$);
    time_in_force_optional: uint8 &convert=TimeInForceOptional($$);
    routing_instruction: uint8 &convert=RoutingInstruction($$);
    order_qty: uint64;
    price_optional: int64;
    order_id_optional: uint64;
    origclordid: uint64;
    stop_px: int64;
    min_qty: uint64;
    max_floor: uint64;
    executing_trader_optional: bytes &size=5;
    account_type: uint8 &convert=AccountType($$);
    expire_date: uint16;
    custodian_info: CustodianInfo;
    investor_id: InvestorId;
    strategy_id: int32;
    : skip bytes &size=2;   # padding
    desk_id: DeskId;
    memo: Memo;
};

type OrderCancelRequestMessage = unit {
    inbound_business_header: InboundBusinessHeader;
    : skip bytes &size=2;   # padding
    clordid: uint64;
    security_id: uint64;
    order_id_optional: uint64;
    origclordid: uint64;
    side: uint8 &convert=Side($$);
    single_cancel_restatement_reason: uint8 &convert=SingleCancelRestatementReason($$);
    : skip bytes &size=2;   # padding
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
    executing_trader_optional: bytes &size=5;
    desk_id: DeskId;
    memo: Memo;
};

type NewOrderCrossMessage = unit {
    inbound_business_header: InboundBusinessHeader;
    : skip bytes &size=2;   # padding
    crossid: uint64;
    sender_location: bytes &size=10;
    entering_trader: bytes &size=5;
    executing_trader_optional: bytes &size=5;
    security_id: uint64;
    order_qty: uint64;
    price: int64;
    crossed_indicator: uint16 &convert=CrossedIndicator($$);
    cross_type: uint8 &convert=CrossType($$);
    cross_prioritization: uint8 &convert=CrossPrioritization($$);
    max_sweep_qty: uint64;
    cross_sides_groups: CrossSidesGroups;
    desk_id: DeskId;
    memo: Memo;
};

type CrossSidesGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    cross_sides_group: CrossSidesGroup[self.group_size_encoding.num_in_group];
};

type GroupSizeEncoding = unit {
    block_length: uint16;
    num_in_group: uint8;
};

type CrossSidesGroup = unit {
    side: uint8 &convert=Side($$);
    : skip bytes &size=1;   # padding
    account: uint32;
    entering_firm_optional: uint32;
    clordid: uint64;
};

type ExecutionReportNewMessage = unit {
    outbound_business_header: OutboundBusinessHeader;
    side: uint8 &convert=Side($$);
    ord_status: uint8 &convert=OrdStatus($$);
    clordid: uint64;
    secondary_order_id: uint64;
    security_id: uint64;
    order_id: uint64;
    account: uint32;
    exec_id: uint64;
    transact_time: uint64;
    market_segment_received_time: uint64;
    protection_price: int64;
    trade_date: uint16;
    working_indicator: uint8 &convert=WorkingIndicator($$);
    multi_leg_reporting_type: uint8 &convert=MultiLegReportingType($$);
    ordtype: uint8 &convert=Ordtype($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    expire_date: uint16;
    order_qty: uint64;
    price_optional: int64;
    stop_px: int64;
    min_qty: uint64;
    max_floor: uint64;
    crossid_optional: uint64;
    received_time: uint64;
    : skip bytes &size=3;   # padding
    ordtagid_optional: uint8;
    investor_id: InvestorId;
    cross_type: uint8 &convert=CrossType($$);
    cross_prioritization: uint8 &convert=CrossPrioritization($$);
    mm_protection_reset_boolean_optional: uint8 &convert=MmProtectionResetBooleanOptional($$);
    : skip bytes &size=3;   # padding
    strategy_id: int32;
    desk_id: DeskId;
    memo: Memo;
};

type OutboundBusinessHeader = unit {
    session_id: uint32;
    msg_seq_num: uint32;
    sending_time: uint64;
    poss_resend: uint8;
    padding: bytes &size=1;
};

