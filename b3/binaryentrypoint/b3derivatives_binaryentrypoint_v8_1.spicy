    side_optional: uint8 &convert=SideOptional($$);
    : skip bytes &size=1;   # padding
    asset: bytes &size=6;
    security_id_optional: uint64;
    investor_id: InvestorId;
};

type OrderMassActionReportMessage = unit {
    outbound_business_header: OutboundBusinessHeader;
    mass_action_type: uint8 &convert=MassActionType($$);
    mass_action_scope: uint8 &convert=MassActionScope($$);
