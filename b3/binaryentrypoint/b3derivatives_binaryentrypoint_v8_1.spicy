type OrderMassActionRequestMessage = unit {
    inbound_business_header: InboundBusinessHeader;
    mass_action_type: uint8 &convert=MassActionType($$);
    mass_action_scope: uint8 &convert=MassActionScope($$);
    clordid: uint64;
    mass_cancel_restatement_reason: uint8 &convert=MassCancelRestatementReason($$);
