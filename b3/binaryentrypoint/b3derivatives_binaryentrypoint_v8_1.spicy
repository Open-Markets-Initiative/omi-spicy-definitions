    mass_action_reject_reason: uint8 &convert=MassActionRejectReason($$);
    mass_cancel_restatement_reason: uint8 &convert=MassCancelRestatementReason($$);
    ordtagid: uint8;
    side_optional: uint8 &convert=SideOptional($$);
    : skip bytes &size=1;   # padding
    asset: bytes &size=6;
    security_id_optional: uint64;
    investor_id: InvestorId;
    text: Text;
};

