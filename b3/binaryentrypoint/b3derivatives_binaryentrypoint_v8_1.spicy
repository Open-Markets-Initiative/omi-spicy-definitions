    : skip bytes &size=3;   # padding
    ordtagid_optional: uint8;
    investor_id: InvestorId;
    mm_protection_reset_boolean_optional: uint8 &convert=MmProtectionResetBooleanOptional($$);
    : skip bytes &size=3;   # padding
    strategy_id: int32;
    desk_id: DeskId;
    memo: Memo;
};

type ExecutionReportCancelMessage = unit {
    outbound_business_header: OutboundBusinessHeader;
