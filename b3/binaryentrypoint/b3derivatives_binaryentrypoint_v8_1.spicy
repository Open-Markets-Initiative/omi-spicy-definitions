type Text = unit {
    text_length: uint8;
    text_data: bytes &size=self.text_length;
};

type ExecutionReportForwardMessage = unit {
    outbound_business_header: OutboundBusinessHeader;
    side: uint8 &convert=Side($$);
    ord_status: uint8 &convert=OrdStatus($$);
    clordid_optional: uint64;
