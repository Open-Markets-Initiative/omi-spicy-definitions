module A2xA2xequitiesSnapshotAmdV132;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type A2xequitiesSnapshotV132 = unit {
    message_count: uint8;
    message: Message[self.message_count];
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::SnapshotStartMessage -> snapshot_start_message: SnapshotStartMessage;
        MsgType::BookStatusMessage -> book_status_message: BookStatusMessage;
        MsgType::BookEntryMessage -> book_entry_message: BookEntryMessage;
        MsgType::MacBookEntryMessage -> mac_book_entry_message: MacBookEntryMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_type: uint8 &convert=MsgType($$);
    msg_length: uint8;
    seq_no: uint32;
};

type SnapshotStartMessage = unit {
    stream_seq_no: uint32;
    security_count: uint16;
    timestamp: uint64;
};

type BookStatusMessage = unit {
    security_id: uint16;
    trading_status: uint8 &convert=TradingStatus($$);
    market_flags: bitfield(8) {
        trading: 0;
        mac_open: 1;
        mac_run: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    entries: uint16;
    closing_buy_qty: uint32;
    closing_sell_qty: uint32;
    indicative_price: uint64;
};

type BookEntryMessage = unit {
    security_id: uint16;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    price: uint64;
    order_ref: uint32;
};

type MacBookEntryMessage = unit {
    security_id: uint16;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    price: uint64;
    order_ref: uint32;
};

type MsgType = enum {
    HeartbeatMessage = 1,
    SnapshotStartMessage = 10,
    BookStatusMessage = 11,
    BookEntryMessage = 12,
    MacBookEntryMessage = 18,
};

type TradingStatus = enum {
    Active = 1,
    Halted = 2,
    Suspended = 3,
    AodStart = 8,
    AodEnd = 24,
};

type Trading = enum {
    ContinuousTradingClosed = 0,
    ContinuousTradingOpen = 1,
};

type MacOpen = enum {
    MacIsClosed = 0,
    MacIsOpen = 1,
};

type MacRun = enum {
    MacIsNotLockedDown = 0,
    MacIsLockedDown = 1,
};

type Side = enum {
    BuyOrder = 1,
    SellOrder = 2,
};

