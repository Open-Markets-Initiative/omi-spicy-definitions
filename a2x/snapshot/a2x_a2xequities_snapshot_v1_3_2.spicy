module A2xA2xequitiesSnapshotAmdV132;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type A2xA2xequitiesSnapshotV132 = unit {
    message_count: uint8;
    message: Message[self.message_count];
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::SnapshotStartMessage -> snapshot_start_message: SnapshotStartMessage;
        MsgType::BookStatusMessage -> book_status_message: BookStatusMessage;
        MsgType::BookEntryMessage -> book_entry_message: BookEntryMessage;
        MsgType::MarketAtCloseBookEntryMessage -> market_at_close_book_entry_message: MarketAtCloseBookEntryMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_type: uint8 &convert=MsgType($$);
    msg_length: uint8;
    seq_no: uint32;
};

type SnapshotStartMessage = unit {
    stream_seq_no: uint32 &byte-order=spicy::ByteOrder::Little;
    security_count: uint16 &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
};

type BookStatusMessage = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    trading_status: uint8;
    market_flags: MarketFlags;
    entries: uint16 &byte-order=spicy::ByteOrder::Little;
    closing_buy_qty: uint32 &byte-order=spicy::ByteOrder::Little;
    closing_sell_qty: uint32 &byte-order=spicy::ByteOrder::Little;
    indicative_price: uint64 &byte-order=spicy::ByteOrder::Little;
};

type MarketFlags = unit {
    unused: bytes &size=1;
    mac_run: bytes &size=1;
    mac_open: bytes &size=1;
    trading: bytes &size=1;
};

type BookEntryMessage = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    quantity: uint32 &byte-order=spicy::ByteOrder::Little;
    price: uint64 &byte-order=spicy::ByteOrder::Little;
    order_ref: uint32 &byte-order=spicy::ByteOrder::Little;
};

type MarketAtCloseBookEntryMessage = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    quantity: uint32 &byte-order=spicy::ByteOrder::Little;
    price: uint64 &byte-order=spicy::ByteOrder::Little;
    order_ref: uint32 &byte-order=spicy::ByteOrder::Little;
};

type MsgType = enum {
    HeartbeatMessage = 1,
    SnapshotStartMessage = 10,
    BookStatusMessage = 11,
    BookEntryMessage = 12,
    MarketAtCloseBookEntryMessage = 18,
};

