module A2xA2xequitiesUdpheaderAmdV1;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type A2xA2xequitiesUdpheaderV1 = unit {
    message_count: uint8;
    message: Message[self.message_count];
};

type Message = unit {
    message_header: MessageHeader;
    payload: bytes &eod;
};

type MessageHeader = unit {
    msg_type: uint8;
    msg_length: uint8;
    seq_no: uint32;
};

