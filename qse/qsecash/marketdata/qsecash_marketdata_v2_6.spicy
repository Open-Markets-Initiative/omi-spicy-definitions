    Early = 0x45,
    CoreSession = 0x43,
    Late = 0x4c,
};

type PriorityIndicator = enum {
    UrgentMessage = 0x4f,
    NonUrgentMessage = 0x4e,
};

type TypeOfMessage = enum {
    MarketInformationContents = 0x42,
    TechnicalInformation = 0x54,
    MarketAndTechnicalInformation = 0x52,
};

