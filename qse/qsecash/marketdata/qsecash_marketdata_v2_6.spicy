    level_scale_code: uint8;
};

type StartRefreshMessage = unit {
    last_seq_num: uint32;
};

type EndRefreshMessage = unit {
    last_seq_num: uint32;
};

type PacketType = enum {
    GenericQuotes = 994,
    GenericMarketInformation = 995,
    GenericIndices = 996,
    GenericTrades = 998,
    GenericOrderbook = 230,
    RefreshCombinedPacketType = 999,
};

type DeliveryFlag = enum {
    RealTimeMessageUncompressed = 0,
    RetransmissionMessageUncompressed = 2,
    RefreshMessageZlibCompressed = 17,
};

type MessageType = enum {
    StockStateChangeMessage = 505,
    ClassStateChangeMessage = 516,
    MailMessage = 523,
    IndicativeMatchingPriceMessage = 530,
    CollarsMessage = 537,
    SessionTimetableMessage = 539,
    GlobalMarketActivitySummaryMessage = 545,
    StartReferentialMessage = 550,
    EndReferentialMessage = 551,
    ReferentialMessage = 555,
    TradeCreationMessage = 220,
    TradeCancellationMessage = 221,
    TradeFullInformationMessage = 240,
    PriceUpdateMessage = 241,
    AuctionSummaryMessage = 245,
    VwapClosingPriceMessage = 247,
    QuotesMessage = 140,
    OrderUpdateMarketSheetMessage = 230,
    OrderbookRetransmissionDelimiterMessage = 231,
    RealTimeIndexMessage = 542,
    IndexSummaryMessage = 543,
    IndexCompositionMessage = 544,
    StartRefreshMessage = 580,
    EndRefreshMessage = 581,
};

type OrderEntryRejection = enum {
    NotApplicable = 0x30,
    OrderEntryAllowed = 0x4e,
    OrderEntryForbidden = 0x59,
};

type InstrumentState = enum {
    NotApplicable = 0x30,
    Auction = 0x41,
    Halted = 0x48,
    Closed = 0x43,
};

type InstrumentTradingStatus = enum {
    Suspended = 0x53,
};

type HaltReason = enum {
    NotApplicable = 0x30,
    HaltedNoLiquidityProvider = 0x52,
    OpeningPriceOutsideCollars = 0x43,
    ManuelHaltingByMarketOperations = 0x4d,
};

type ActionAffectingState = enum {
    NotApplicable = 0x30,
    TradingOnTheInstrumentAtTheOpeningSentBeforeO = 0x43,
    CancelledProgrammedOpening = 0x44,
    InstrumentManuallyHaltedByMarketOperations = 0x4d,
    InstrumentIsBeingInitializedBeginningOfTheTradingDay = 0x4e,
    InstrumentOpened = 0x4f,
    DeferredProgrammedOpening = 0x50,
    AutomaticHaltingAtTheClassAuction = 0x52,
};

type InstrumentStateTcs = enum {
    NotApplicable = 0x30,
    InstrumentIsForbidden = 0x53,
    InstrumentIsAuthorized = 0x41,
};

type PeriodSide = enum {
    NotApplicable = 0x30,
    BidOnlyPeriod = 0x41,
    OfferOnlyPeriod = 0x56,
};

type InstrumentGroupState = enum {
    PreOpening = 0x50,
    BeginningOfDayConsultation = 0x43,
    Opening = 0x4f,
    MarketSession = 0x53,
    TradingAtLast = 0x52,
    SurveillanceIntervention = 0x4e,
    EndOfDayInquiry = 0x46,
    Interrupted = 0x5a,
    Forbidden = 0x49,
};

