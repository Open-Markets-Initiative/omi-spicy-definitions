    price_scale_code: uint8;
    : skip bytes &size=3;   # padding
};

type QuotesMessage = unit {
    symbol_index: uint32;
    source_seq_num: uint32;
    source_time: uint32;
    quote_link_id: uint32;
    ask_price: uint32;
    ask_size: uint32;
    bid_price: uint32;
    bid_size: uint32;
    system_id: uint32;
    number_ask_orders: uint16;
    number_bid_orders: uint16;
    source_time_micro_secs: uint16;
    type_of_ask_price: uint8 &convert=TypeOfAskPrice($$);
    type_of_bid_price: uint8 &convert=TypeOfBidPrice($$);
    quote_condition: uint8 &convert=QuoteCondition($$);
    quote_number: uint8;
    price_scale_code: uint8;
    : skip bytes &size=1;   # padding
};

type OrderUpdateMarketSheetMessage = unit {
    symbol_index: uint32;
    source_time: uint32;
    source_seq_num: uint32;
    price: uint32;
    aggregated_volume: uint32;
    volume: uint32;
    link_id: uint32;
    order_id: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    number_orders: uint16;
    side: bytes &size=1;
    order_type: uint8 &convert=OrderType($$);
    action_type: uint8 &convert=ActionType($$);
    price_scale_code: uint8;
    order_date: uint32;
    order_priority_date: uint32;
    order_priority_time: uint32;
    order_priority_micro_secs: uint16;
    order_origin: bytes &size=1;
    : skip bytes &size=1;   # padding
};

type OrderbookRetransmissionDelimiterMessage = unit {
    source_time: uint32;
    source_seq_num: uint32;
    trading_engine_id: bytes &size=2;
    instance_id: uint8;
    retransmission_indicator: bytes &size=1;
};

type RealTimeIndexMessage = unit {
    symbol_index: uint32;
    source_time: uint32;
    index_level: uint32;
    forerunner_level: uint32;
    session_high: uint32;
    session_low: uint32;
    percentage_of_capitalization: uint32;
    variation_from_previous_days_price: int32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    num_of_securities_quoted: uint16;
    index_level_code: bytes &size=1;
    type_of_level: bytes &size=1;
    level_scale_code: uint8;
    percentage_scale_code: uint8;
    variation_scale_code: uint8;
    rebroadcast_indicator: uint8 &convert=RebroadcastIndicator($$);
    : skip bytes &size=2;   # padding
};

type IndexSummaryMessage = unit {
    symbol_index: uint32;
    source_time: uint32;
    preliminary_opening_level: uint32;
    preliminary_opening_time: uint32;
    first_level: uint32;
    first_time: uint32;
    opening_reference_level: uint32;
    opening_reference_time: uint32;
    closing_reference_level: uint32;
    closing_reference_time: uint32;
    percent_variation_prev_clos: uint32;
