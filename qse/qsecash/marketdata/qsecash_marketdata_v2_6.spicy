module QseQsecashMarketdataXdpV26;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type QsecashMarketdataV26 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.number_msg_entries];
};

type PacketHeader = unit {
    packet_length: uint16;
    packet_type: uint16 &convert=PacketType($$);
    packet_sequence_number: uint32;
    send_time: uint32;
    service_id: uint16;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    number_msg_entries: uint8;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::StockStateChangeMessage -> stock_state_change_message: StockStateChangeMessage;
        MessageType::ClassStateChangeMessage -> class_state_change_message: ClassStateChangeMessage;
        MessageType::MailMessage -> mail_message: MailMessage;
        MessageType::IndicativeMatchingPriceMessage -> indicative_matching_price_message: IndicativeMatchingPriceMessage;
        MessageType::CollarsMessage -> collars_message: CollarsMessage;
        MessageType::SessionTimetableMessage -> session_timetable_message: SessionTimetableMessage;
        MessageType::GlobalMarketActivitySummaryMessage -> global_market_activity_summary_message: GlobalMarketActivitySummaryMessage;
        MessageType::StartReferentialMessage -> start_referential_message: StartReferentialMessage;
        MessageType::EndReferentialMessage -> end_referential_message: EndReferentialMessage;
        MessageType::ReferentialMessage -> referential_message: ReferentialMessage;
        MessageType::TradeCreationMessage -> trade_creation_message: TradeCreationMessage;
        MessageType::TradeCancellationMessage -> trade_cancellation_message: TradeCancellationMessage;
        MessageType::TradeFullInformationMessage -> trade_full_information_message: TradeFullInformationMessage;
        MessageType::PriceUpdateMessage -> price_update_message: PriceUpdateMessage;
        MessageType::AuctionSummaryMessage -> auction_summary_message: AuctionSummaryMessage;
        MessageType::VwapClosingPriceMessage -> vwap_closing_price_message: VwapClosingPriceMessage;
        MessageType::QuotesMessage -> quotes_message: QuotesMessage;
        MessageType::OrderUpdateMarketSheetMessage -> order_update_market_sheet_message: OrderUpdateMarketSheetMessage;
        MessageType::OrderbookRetransmissionDelimiterMessage -> orderbook_retransmission_delimiter_message: OrderbookRetransmissionDelimiterMessage;
        MessageType::RealTimeIndexMessage -> real_time_index_message: RealTimeIndexMessage;
        MessageType::IndexSummaryMessage -> index_summary_message: IndexSummaryMessage;
        MessageType::IndexCompositionMessage -> index_composition_message: IndexCompositionMessage;
        MessageType::StartRefreshMessage -> start_refresh_message: StartRefreshMessage;
        MessageType::EndRefreshMessage -> end_refresh_message: EndRefreshMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint16 &convert=MessageType($$);
};

type StockStateChangeMessage = unit {
    symbol_index: uint32;
    source_seq_num: uint32;
    source_time: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    : skip bytes &size=2;   # padding
    start_date_halting: bytes &size=8;
    start_time_halting: bytes &size=6;
    prog_opening_time: bytes &size=6;
    order_entry_rejection: uint8 &convert=OrderEntryRejection($$);
    instrument_state: uint8 &convert=InstrumentState($$);
    instrument_trading_status: uint8 &convert=InstrumentTradingStatus($$);
    halt_reason: uint8 &convert=HaltReason($$);
    action_affecting_state: uint8 &convert=ActionAffectingState($$);
    instrument_state_tcs: uint8 &convert=InstrumentStateTcs($$);
    period_side: uint8 &convert=PeriodSide($$);
    : skip bytes &size=1;   # padding
};

type ClassStateChangeMessage = unit {
    source_seq_num: uint32;
    source_time: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    instrument_group_code: bytes &size=3;
    instrument_group_state: uint8 &convert=InstrumentGroupState($$);
    session_type: uint8 &convert=SessionType($$);
    : skip bytes &size=1;   # padding
    class_state: bytes &size=4;
};

type MailMessage = unit {
    source_seq_num: uint32;
    source_time: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    e_mail_msg_number: uint16;
    number_of_message: uint16;
    sequence_number: uint16;
    instrument_group_code: bytes &size=3;
    : skip bytes &size=1;   # padding
    priority_indicator: uint8 &convert=PriorityIndicator($$);
    type_of_message: uint8 &convert=TypeOfMessage($$);
    address_type: bytes &size=2;
    title: bytes &size=80;
    text: bytes &size=854;
    : skip bytes &size=2;   # padding
};

type IndicativeMatchingPriceMessage = unit {
    symbol_index: uint32;
    source_seq_num: uint32;
    source_time: uint32;
    im_price: uint32;
    variation: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    price_scale_code: uint8;
    variation_scale_code: uint8;
    im_volume: uint32;
};

type CollarsMessage = unit {
    symbol_index: uint32;
    source_seq_num: uint32;
    source_time: uint32;
    high_collar: uint32;
    low_collar: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    high_scale_code: uint8;
    low_scale_code: uint8;
    collar_type: uint8 &convert=CollarType($$);
    : skip bytes &size=3;   # padding
};

type SessionTimetableMessage = unit {
    source_seq_num: uint32;
    source_time: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    instrument_group_code: bytes &size=3;
    session_type: uint8 &convert=SessionType($$);
    time_pre_opening_1: bytes &size=6;
    time_opening_1: bytes &size=6;
    time_closing_1: bytes &size=6;
    time_pre_opening_2: bytes &size=6;
    time_opening_2: bytes &size=6;
    time_closing_2: bytes &size=6;
    time_pre_opening_3: bytes &size=6;
    time_opening_3: bytes &size=6;
    time_closing_3: bytes &size=6;
    eod_time: bytes &size=6;
    : skip bytes &size=2;   # padding
};

type GlobalMarketActivitySummaryMessage = unit {
    source_seq_num: uint32;
    source_time: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    nb_trades: uint32;
    qty_shares: uint32;
    amount_traded: uint32;
    price_scale_code: uint8;
    : skip bytes &size=3;   # padding
};

type StartReferentialMessage = unit {
    indicator: bytes &size=1;
    : skip bytes &size=3;   # padding
};

type EndReferentialMessage = unit {
    indicator: bytes &size=1;
    : skip bytes &size=3;   # padding
};

type ReferentialMessage = unit {
    symbol_index: uint32;
    source_seq_num: uint32;
    source_time: uint32;
    last_adj_price: uint32;
    system_id: uint32;
    prev_volume_traded: uint32;
    fix_price_tick: uint32;
    source_time_micro_secs: uint16;
    stock_exchange_code: uint16;
    type_of_instrument: uint16;
    event_date: bytes &size=8;
    instrument_name: bytes &size=18;
    period_indicator: uint8 &convert=PeriodIndicator($$);
    type_of_market_admission: bytes &size=1;
    issuing_country_code: bytes &size=3;
    trading_currency: bytes &size=3;
    instrument_group_code: bytes &size=3;
    instrument_category: uint8 &convert=InstrumentCategory($$);
    instrument_code: bytes &size=12;
    date_of_last_trade: bytes &size=8;
    underlying_repo_isin_code: bytes &size=12;
    repo_expiry_date: bytes &size=8;
    first_settlement_date: bytes &size=8;
    type_of_derivatives: uint8 &convert=TypeOfDerivatives($$);
    bic_depositary: bytes &size=11;
    icb: bytes &size=4;
    mic: bytes &size=4;
    underlying_wisin_code: bytes &size=12;
    depositary_list: bytes &size=25;
    main_depositary: bytes &size=5;
    type_of_corporate_event: bytes &size=2;
    time_lag_euronext_utc: bytes &size=5;
    time_lag_mi_fid_reg_utc: bytes &size=5;
    cfi: bytes &size=6;
    quantity_notation: bytes &size=4;
    index_set_of_var_price_tick: bytes &size=2;
    market_feed_code: bytes &size=2;
    mic_list: bytes &size=24;
    industry_code: bytes &size=4;
    industry_text: bytes &size=100;
    financial_market_code: bytes &size=3;
    us_indicators: bytes &size=7;
    : skip bytes &size=2;   # padding
    prev_day_capital_traded: uint64;
    nom_mkt_price: uint64;
    lot_size: uint64;
    number_instrument_circ: uint64;
    shares_out: uint64;
    auth_shares: uint64;
    heading_number: uint16;
    section_number: uint8;
    repo_indicator: uint8 &convert=RepoIndicator($$);
    last_adj_price_scale_code: uint8;
    type_of_unit_exp: uint8 &convert=TypeOfUnitExp($$);
    market_indicator: uint8 &convert=MarketIndicator($$);
    prev_day_capital_traded_scale_code: uint8;
    tax_code: uint8 &convert=TaxCode($$);
    nom_mkdt_price_scale_code: uint8;
    lot_size_scale_code: uint8;
    fix_price_tick_scale_code: uint8;
    mnemo: bytes &size=5;
    trading_code: bytes &size=12;
    : skip bytes &size=3;   # padding
    strike_price: uint32;
    strike_currency: bytes &size=3;
    strike_scale_code: uint8;
    currency_coef: uint32;
    currency_coef_scale_code: uint8;
    trading_currency_indicator: uint8;
    strike_currency_indicator: uint8;
    market_segment: bytes &size=2;
    algo: uint8 &convert=Algo($$);
    local_name: bytes &size=30;
    small_trade: uint32;
    : skip bytes &size=12;   # padding
};

type TradeCreationMessage = unit {
    symbol_index: uint32;
    source_time: uint32;
    trade_id_number: uint32;
    quote_link_id: uint32;
    source_seq_num: uint32;
    price: uint32;
    volume: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    small_trade_indicator: uint8 &convert=SmallTradeIndicator($$);
    trad_cond_2: uint8 &convert=TradCond2($$);
    trad_cond_3: uint8 &convert=TradCond3($$);
    trade_origin: uint8 &convert=TradeOrigin($$);
    opening_trade_indicator: uint8 &convert=OpeningTradeIndicator($$);
    price_scale_code: uint8;
};

type TradeCancellationMessage = unit {
    symbol_index: uint32;
    source_time: uint32;
    source_seq_num: uint32;
    original_trade_id_number: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    : skip bytes &size=2;   # padding
};

type TradeFullInformationMessage = unit {
    symbol_index: uint32;
    source_time: uint32;
    trade_id_number: uint32;
    quote_link_id: uint32;
    source_seq_num: uint32;
    price: uint32;
    volume: uint32;
    cumulative_quantity: uint32;
    highest_price: uint32;
    lowest_price: uint32;
    variation_last_price: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    : skip bytes &size=2;   # padding
    small_trade_indicator: uint8 &convert=SmallTradeIndicator($$);
    trad_cond_2: uint8 &convert=TradCond2($$);
    trad_cond_3: uint8 &convert=TradCond3($$);
    trade_origin: uint8 &convert=TradeOrigin($$);
    tick_direction: uint8 &convert=TickDirection($$);
    opening_trade_indicator: uint8 &convert=OpeningTradeIndicator($$);
    variation_scale_code: uint8;
    price_scale_code: uint8;
};

type PriceUpdateMessage = unit {
    symbol_index: uint32;
    source_time: uint32;
    source_seq_num: uint32;
    price: uint32;
    highest_price: uint32;
    lowest_price: uint32;
    variation_last_price: uint32;
    system_id: uint32;
    source_time_micro_secs: uint16;
    type_of_price: uint16 &convert=TypeOfPrice($$);
    : skip bytes &size=2;   # padding
    price_scale_code: uint8;
    variation_scale_code: uint8;
};

type AuctionSummaryMessage = unit {
    symbol_index: uint32;
    source_time: uint32;
    source_seq_num: uint32;
    first_price: uint32;
