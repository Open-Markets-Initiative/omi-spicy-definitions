    MarketImbalanceAskPrice = 5,
    MarketImbalanceBidPrice = 6,
    ChangeOfFirstPrice = 30,
    NewHighPrice = 31,
    NewLowPrice = 32,
    NewLastPrice = 33,
    NewPreviousDaysClosingPrice = 34,
    WarrantOpeningIndicativeValue = 41,
    WarrantClosingIndicativeValue = 42,
