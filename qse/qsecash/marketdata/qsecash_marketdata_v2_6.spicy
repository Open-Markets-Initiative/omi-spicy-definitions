type TypeOfLastPrice = enum {
    FirstTradedPrice = 4,
    NTradedPriceResumeAfterReservation = 7,
};

type InstrumentValuationPrice = enum {
    NotAValuationPrice = 0x30,
    ValuationPrice = 0x31,
};

type TypeOfAskPrice = enum {
    LimitOrder = 0,
    MarketOrder = 1,
    AtOpeningOrderNscOnly = 2,
};

type TypeOfBidPrice = enum {
    LimitOrder = 0,
    MarketOrder = 1,
    AtOpeningOrderNscOnly = 2,
};

type QuoteCondition = enum {
    NoLiquidityProviderLp = 0x30,
    LpOnlyOnAskSide = 0x31,
    LpOnlyOnBidSide = 0x32,
    LpOnAskAndBidSides = 0x33,
};

type OrderType = enum {
    MarketOrder = 0x31,
    LimitOrder = 0x32,
    MarketToLimitOrder = 0x4b,
    PegOrder = 0x50,
};

type ActionType = enum {
    NewOrder = 0x41,
    DeletionOfOrderIdentifiedByOrderId = 0x44,
    DeletionOfOrderIdentifiedByOrderIdAndAllPrecedingOrders = 0x50,
    DeletionOfAllOrdersForTheGivenInstrumentDependingOnThe = 0x46,
    RetransmissionOfAllOrdersForTheGivenInstrument = 0x59,
};

type RebroadcastIndicator = enum {
    CurrentDay = 0x30,
    PreviousDay = 0x31,
};

