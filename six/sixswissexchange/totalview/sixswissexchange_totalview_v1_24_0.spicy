module SixSixswissexchangeTotalviewItchV1240;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type SixswissexchangeTotalviewV1240 = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::TimeStampSecondsMessage -> time_stamp_seconds_message: TimeStampSecondsMessage;
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::QuantityTickSizeMessage -> quantity_tick_size_message: QuantityTickSizeMessage;
        MessageType::PriceTickSizeMessage -> price_tick_size_message: PriceTickSizeMessage;
        MessageType::OrderbookDirectoryMessage -> orderbook_directory_message: OrderbookDirectoryMessage;
        MessageType::OrderbookTradingActionMessage -> orderbook_trading_action_message: OrderbookTradingActionMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        MessageType::OrderExecutedWithPriceMessage -> order_executed_with_price_message: OrderExecutedWithPriceMessage;
        MessageType::ExecutionSummaryMessage -> execution_summary_message: ExecutionSummaryMessage;
        MessageType::TradeMessage -> trade_message: TradeMessage;
        MessageType::BrokenTradeMessage -> broken_trade_message: BrokenTradeMessage;
        MessageType::OrderDeleteMessage -> order_delete_message: OrderDeleteMessage;
        MessageType::OrderReplaceMessage -> order_replace_message: OrderReplaceMessage;
        MessageType::IndicativePriceQuantityMessage -> indicative_price_quantity_message: IndicativePriceQuantityMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type TimeStampSecondsMessage = unit {
    second: uint32 &convert=interval($$);
};

type SystemEventMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    group: bytes &size=8;
    event_code: uint8 &convert=EventCode($$);
    orderbook: uint32;
};

type QuantityTickSizeMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    quantity_tick_table_id: uint32;
    quantity_tick_size: uint32;
    quantity_start: uint32;
};

type PriceTickSizeMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    price_tick_table_id: uint32;
    price_tick_size: uint32;
    price_start: uint32;
};

type OrderbookDirectoryMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    orderbook: uint32;
    price_type: uint8 &convert=PriceType($$);
    isin: bytes &size=12;
    currency: bytes &size=3;
    group: bytes &size=8;
    minimum_quantity: uint32;
    quantity_tick_table_id: uint32;
    price_tick_table_id: uint32;
    price_decimals: uint32;
    delisting_date: uint32;
    delisting_time: uint32;
    qod_price_decimals: uint32;
    security_exchange: bytes &size=4;
    reference_exchange: bytes &size=4;
};

type OrderbookTradingActionMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    orderbook: uint32;
    trading_state: uint8 &convert=TradingState($$);
    book_condition: uint8 &convert=BookCondition($$);
};

type AddOrderMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    order_number: uint64;
    order_verb: uint8 &convert=OrderVerb($$);
    order_quantity: uint32;
    orderbook: uint32;
    order_price: uint32;
};

type OrderExecutedMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    order_number: uint64;
    executed_quantity: uint32;
    match_number: uint64;
};

type OrderExecutedWithPriceMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    order_number: uint64;
    executed_quantity: uint32;
    match_number: uint64;
    printable: uint8 &convert=Printable($$);
    execution_price: uint32;
};

type ExecutionSummaryMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    orderbook: uint32;
    aggressor_side: uint8 &convert=AggressorSide($$);
    total_mpob_quantity: uint32;
    total_ebbo_book_quantity: uint32;
    total_clobqdm_quantity: uint32;
    resting_hidden_quantity: uint32;
    resting_cancelled_quantity: uint32;
    far_side: uint8 &convert=FarSide($$);
    far_price: uint32;
    far_quantity_remaining: uint32;
    number_of_executions: uint16;
};

type TradeMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    execution_time: uint64 &convert=time_ns($$);
    orderbook: uint32;
    executed_quantity: uint32;
    execution_price: uint32;
    match_number: uint64;
    book_type: uint8 &convert=BookType($$);
    trading_session_id: uint8 &convert=TradingSessionId($$);
};

type BrokenTradeMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    match_number: uint64;
    reason: uint8 &convert=Reason($$);
};

type OrderDeleteMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    order_number: uint64;
};

type OrderReplaceMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    original_order_number: uint64;
    new_order_number: uint64;
    order_quantity: uint32;
    order_price: uint32;
};

type IndicativePriceQuantityMessage = unit {
    timestamp: uint32 &convert=interval_ns($$);
    theoretical_opening_quantity: uint64;
    orderbook: uint32;
    best_bid: uint32;
    best_offer: uint32;
    theoretical_opening_price: uint32;
    cross_type: uint8 &convert=CrossType($$);
};

type MessageType = enum {
    TimeStampSecondsMessage = 0x54,
    SystemEventMessage = 0x53,
    QuantityTickSizeMessage = 0x4d,
    PriceTickSizeMessage = 0x4c,
    OrderbookDirectoryMessage = 0x52,
    OrderbookTradingActionMessage = 0x48,
    AddOrderMessage = 0x41,
    OrderExecutedMessage = 0x45,
    OrderExecutedWithPriceMessage = 0x43,
    ExecutionSummaryMessage = 0x59,
    TradeMessage = 0x50,
    BrokenTradeMessage = 0x42,
    OrderDeleteMessage = 0x44,
    OrderReplaceMessage = 0x55,
    IndicativePriceQuantityMessage = 0x49,
};

type EventCode = enum {
    Break = 0x41,
    ResumptionAfterBreak = 0x42,
    EndOfMessages = 0x43,
    EndOfSystemHours = 0x45,
    StartOfAccepting = 0x49,
    EndOfMarketHours = 0x4d,
    StartOfMessages = 0x4f,
    StartOfMarketHours = 0x51,
    StartOfSystemHours = 0x53,
    AuctionCloses = 0x55,
    AuctionStarts = 0x56,
    StartOfTradingAtLast = 0x54,
    EndOfTradingAtLast = 0x4c,
    SynchronizedWithGroup = 0x20,
};

type PriceType = enum {
    PerUnit = 0x55,
    Percentage = 0x50,
};

type TradingState = enum {
    Trading = 0x54,
    Suspended = 0x56,
    SwissAtMidOrderBookSuspended = 0x4d,
    SwissEbboOrderBookSuspended = 0x45,
    SwissEbboAndSwissAtMidOrderBooksSuspended = 0x4f,
    UnderlyingCondition = 0x55,
    QuoteOnDemandOrderBookSuspended = 0x51,
    ClobSuspendedAndQodOrderBookInTrading = 0x43,
    LpBidOnlyActive = 0x4c,
    LpBidOnlyActiveAndQodOrderBookSuspended = 0x50,
};

type BookCondition = enum {
    DelayAuction = 0x44,
    StopTrading = 0x48,
    StopTradingWithNonOpening = 0x4a,
    DelayAuctionWithNonOpening = 0x4c,
    NormalTrading = 0x4e,
    NonOpening = 0x50,
    LpBidOnlyReasonUsWithholdingTax = 0x31,
    LpBidOnlyReasonIssuerSoldOut = 0x32,
    LpBidOnlyReasonIssuerBusinessPolicy = 0x33,
    LpBidOnlyReasonSuccessorProduct = 0x34,
    LpBidOnlyReasonProductWorthless = 0x35,
};

type OrderVerb = enum {
    Buy = 0x42,
    Sell = 0x53,
    ReferencePriceUpdate = 0x20,
};

type Printable = enum {
    NonPrintable = 0x4e,
    Printable_x59 = 0x59,
};

type AggressorSide = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type FarSide = enum {
    Buy = 0x42,
    Sell = 0x53,
    NoFarQuantityRemaining = 0x20,
};

type BookType = enum {
    SwissEbbo = 0x45,
    QuoteDrivenMarket = 0x4c,
    SwissAtMid = 0x4d,
    CentralLimitOrderBookNonDisplayed = 0x4e,
    QuoteOnDemand = 0x51,
};

type TradingSessionId = enum {
    OpeningAuction = 0x30,
    IntradayAuction = 0x31,
    ContinuousTrading = 0x32,
    ClosingAuction = 0x33,
    AtMarketClose = 0x34,
};

type Reason = enum {
    Consent = 0x43,
    Supervisory = 0x53,
};

type CrossType = enum {
    ClosingAuction = 0x43,
    IntradayAuction = 0x49,
    PreOpeningAuction = 0x4f,
};

