module OtcmarketsLinkatsHeadersLinkV1;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type LinkatsHeadersV1 = unit {
    packet_header: PacketHeader;
    message_block: Message[self.packet_header.messages];
};

type PacketHeader = unit {
    packet_size: uint16;
    seq_num: uint32;
    packet_flag: bitfield(8) {
        heartbeat: 0;
        seq_num_reset: 1;
        reserved_4: 2..5;
        replay: 6;
        test: 7;
    } &byte-order=spicy::ByteOrder::Little;
    messages: uint8;
    packet_milli: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    payload: bytes &eod;
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint8;
};

