    OtcqxInternational = 6,
    Otcqb = 10,
    OtcbbOnly = 11,
    PinkCurrent = 20,
    PinkLimited = 21,
    PinkNoInformation = 22,
    GreyMarket = 30,
    ExpertMarket = 40,
    OtcBonds = 50,
};

type ReportingStatus = enum {
