    cust_order_handling_inst: uint8 &convert=CustOrderHandlingInst($$);
    executor: uint64;
    idm_short_code: uint64;
    : skip bytes &size=272;   # padding
    party_details_groups: PartyDetailsGroups;
    trd_reg_publications_groups: TrdRegPublicationsGroups;
};

type PartyDetailsGroups = unit {
