module CmeGlobexIlink3SbeV82;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type CmeGlobexIlink3V82 = unit {
    simple_open_frame: SimpleOpenFrame[] &eod;
};

type SimpleOpenFrame = unit {
    simple_open_framing_header: SimpleOpenFramingHeader;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::Negotiate -> negotiate: Negotiate;
        TemplateId::NegotiationResponse -> negotiation_response: NegotiationResponse;
        TemplateId::NegotiationReject -> negotiation_reject: NegotiationReject;
        TemplateId::Establish -> establish: Establish;
        TemplateId::EstablishmentAck -> establishment_ack: EstablishmentAck;
        TemplateId::EstablishmentReject -> establishment_reject: EstablishmentReject;
        TemplateId::Sequence -> sequence: Sequence;
        TemplateId::Terminate -> terminate: Terminate;
        TemplateId::RetransmitRequest -> retransmit_request: RetransmitRequest;
        TemplateId::Retransmission -> retransmission: Retransmission;
        TemplateId::RetransmitReject -> retransmit_reject: RetransmitReject;
        TemplateId::NotApplied -> not_applied: NotApplied;
        TemplateId::NewOrderSingle -> new_order_single: NewOrderSingle;
        TemplateId::OrderCancelReplaceRequest -> order_cancel_replace_request: OrderCancelReplaceRequest;
        TemplateId::OrderCancelRequest -> order_cancel_request: OrderCancelRequest;
        TemplateId::MassQuote -> mass_quote: MassQuote;
        TemplateId::PartyDetailsDefinitionRequest -> party_details_definition_request: PartyDetailsDefinitionRequest;
        TemplateId::PartyDetailsDefinitionRequestAck -> party_details_definition_request_ack: PartyDetailsDefinitionRequestAck;
        TemplateId::BusinessReject -> business_reject: BusinessReject;
        TemplateId::ExecutionReportNew -> execution_report_new: ExecutionReportNew;
        TemplateId::ExecutionReportReject -> execution_report_reject: ExecutionReportReject;
        TemplateId::ExecutionReportElimination -> execution_report_elimination: ExecutionReportElimination;
        TemplateId::ExecutionReportTradeOutright -> execution_report_trade_outright: ExecutionReportTradeOutright;
        TemplateId::ExecutionReportTradeSpread -> execution_report_trade_spread: ExecutionReportTradeSpread;
        TemplateId::ExecutionReportTradeSpreadLeg -> execution_report_trade_spread_leg: ExecutionReportTradeSpreadLeg;
        TemplateId::QuoteCancel -> quote_cancel: QuoteCancel;
        TemplateId::OrderMassActionRequest -> order_mass_action_request: OrderMassActionRequest;
        TemplateId::OrderMassStatusRequest -> order_mass_status_request: OrderMassStatusRequest;
        TemplateId::ExecutionReportModify -> execution_report_modify: ExecutionReportModify;
        TemplateId::ExecutionReportStatus -> execution_report_status: ExecutionReportStatus;
        TemplateId::OrderStatusRequest -> order_status_request: OrderStatusRequest;
        TemplateId::ExecutionReportCancel -> execution_report_cancel: ExecutionReportCancel;
        TemplateId::OrderCancelReject -> order_cancel_reject: OrderCancelReject;
        TemplateId::OrderCancelReplaceReject -> order_cancel_replace_reject: OrderCancelReplaceReject;
        TemplateId::PartyDetailsListRequest -> party_details_list_request: PartyDetailsListRequest;
        TemplateId::PartyDetailsListReport -> party_details_list_report: PartyDetailsListReport;
        TemplateId::ExecutionAck -> execution_ack: ExecutionAck;
        TemplateId::RequestForQuote -> request_for_quote: RequestForQuote;
        TemplateId::NewOrderCross -> new_order_cross: NewOrderCross;
        TemplateId::MassQuoteAck -> mass_quote_ack: MassQuoteAck;
        TemplateId::RequestForQuoteAck -> request_for_quote_ack: RequestForQuoteAck;
        TemplateId::QuoteCancelAck -> quote_cancel_ack: QuoteCancelAck;
        TemplateId::ExecutionReportTradeAddendumOutright -> execution_report_trade_addendum_outright: ExecutionReportTradeAddendumOutright;
        TemplateId::ExecutionReportTradeAddendumSpread -> execution_report_trade_addendum_spread: ExecutionReportTradeAddendumSpread;
        TemplateId::ExecutionReportTradeAddendumSpreadLeg -> execution_report_trade_addendum_spread_leg: ExecutionReportTradeAddendumSpreadLeg;
        TemplateId::OrderMassActionReport -> order_mass_action_report: OrderMassActionReport;
        TemplateId::SecurityDefinitionRequest -> security_definition_request: SecurityDefinitionRequest;
        TemplateId::SecurityDefinitionResponse -> security_definition_response: SecurityDefinitionResponse;
        * -> unknown: bytes &eod;
    };
};

type SimpleOpenFramingHeader = unit {
    message_length: uint16;
    encoding_type: uint16;
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type Negotiate = unit {
    hmac_signature: bytes &size=32;
    access_key_id: bytes &size=20;
    uuid: uint64;
    request_timestamp: uint64;
    session: bytes &size=3;
    firm: bytes &size=5;
    credentials: Credentials;
};

type Credentials = unit {
    credentials_length: uint16;
    credentials_data: bytes &size=self.credentials_length;
};

type NegotiationResponse = unit {
    uuid: uint64;
    request_timestamp: uint64;
    secret_key_secure_id_expiration: uint16;
    fault_tolerance_indicator: uint8 &convert=FaultToleranceIndicator($$);
    split_msg: uint8 &convert=SplitMsg($$);
    previous_seq_no: uint32;
    previous_uuid: uint64;
    credentials: Credentials;
};

type NegotiationReject = unit {
    reason: bytes &size=48;
    uuid: uint64;
    request_timestamp: uint64;
    error_codes: uint16;
    fault_tolerance_indicator: uint8 &convert=FaultToleranceIndicator($$);
    split_msg: uint8 &convert=SplitMsg($$);
};

type Establish = unit {
    hmac_signature: bytes &size=32;
    access_key_id: bytes &size=20;
    trading_system_name: bytes &size=30;
    trading_system_version: bytes &size=10;
    trading_system_vendor: bytes &size=10;
    uuid: uint64;
    request_timestamp: uint64;
    next_seq_no: uint32;
    session: bytes &size=3;
    firm: bytes &size=5;
    keep_alive_interval: uint16;
    credentials: Credentials;
};

type EstablishmentAck = unit {
    uuid: uint64;
    request_timestamp: uint64;
    next_seq_no: uint32;
    previous_seq_no: uint32;
    previous_uuid: uint64;
    keep_alive_interval: uint16;
    secret_key_secure_id_expiration: uint16;
    fault_tolerance_indicator: uint8 &convert=FaultToleranceIndicator($$);
    split_msg: uint8 &convert=SplitMsg($$);
};

type EstablishmentReject = unit {
    reason: bytes &size=48;
    uuid: uint64;
    request_timestamp: uint64;
    next_seq_no: uint32;
    error_codes: uint16;
    fault_tolerance_indicator: uint8 &convert=FaultToleranceIndicator($$);
    split_msg: uint8 &convert=SplitMsg($$);
};

type Sequence = unit {
    uuid: uint64;
    next_seq_no: uint32;
    fault_tolerance_indicator: uint8 &convert=FaultToleranceIndicator($$);
    keep_alive_interval_lapsed: uint8 &convert=KeepAliveIntervalLapsed($$);
};

type Terminate = unit {
    reason: bytes &size=48;
    uuid: uint64;
    request_timestamp: uint64;
    error_codes: uint16;
    split_msg: uint8 &convert=SplitMsg($$);
};

type RetransmitRequest = unit {
    uuid: uint64;
    last_uuid: uint64;
    request_timestamp: uint64;
    from_seq_no: uint32;
    msg_count_16: uint16;
};

type Retransmission = unit {
    uuid: uint64;
    last_uuid: uint64;
    request_timestamp: uint64;
    from_seq_no: uint32;
    msg_count_16: uint16;
    split_msg: uint8 &convert=SplitMsg($$);
};

type RetransmitReject = unit {
    reason: bytes &size=48;
    uuid: uint64;
    last_uuid: uint64;
    request_timestamp: uint64;
    error_codes: uint16;
    split_msg: uint8 &convert=SplitMsg($$);
};

type NotApplied = unit {
    uuid: uint64;
    from_seq_no: uint32;
    msg_count: uint32;
    split_msg: uint8 &convert=SplitMsg($$);
};

type NewOrderSingle = unit {
    price_optional: int64;
    order_qty: uint32;
    security_id: int32;
    side: uint8 &convert=Side($$);
    seq_num: uint32;
    sender_id: bytes &size=20;
    clordid: bytes &size=20;
    party_details_list_req_id: uint64;
    order_request_id: uint64;
    sending_time_epoch: uint64;
    stop_px: int64;
    location: bytes &size=5;
    min_qty: uint32;
    display_qty: uint32;
    expire_date: uint16;
    ord_type: uint8 &convert=OrdType($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    manual_order_indicator: uint8 &convert=ManualOrderIndicator($$);
    exec_inst: ExecInst;
    execution_mode: uint8 &convert=ExecutionMode($$);
    liquidity_flag: uint8 &convert=LiquidityFlag($$);
    managed_order: uint8 &convert=ManagedOrder($$);
    short_sale_type: uint8 &convert=ShortSaleType($$);
};

type ExecInst = unit {
    aon: bytes &size=1;
    ob: bytes &size=1;
    nh: bytes &size=1;
    reserved_1: bytes &size=1;
    reserved_2: bytes &size=1;
    reserved_3: bytes &size=1;
    reserved_4: bytes &size=1;
    reserved_5: bytes &size=1;
};

