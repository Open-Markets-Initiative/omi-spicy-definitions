    Backup = 0,
    Primary = 1,
};

type KeepAliveIntervalLapsed = enum {
    NotLapsed = 0,
    Lapsed = 1,
};

type SplitMsg = enum {
    SplitMessageDelayed = 0,
    OutofOrderMessageDelayed = 1,
    CompleteMessageDelayed = 2,
};

type Side = enum {
    Buy = 1,
    Sell = 2,
    Undisclosed = 7,
};

type OrdType = enum {
    MarketwithProtection = 0x31,
    Limit = 0x32,
    StopwithProtection = 0x33,
    StopLimit = 0x34,
