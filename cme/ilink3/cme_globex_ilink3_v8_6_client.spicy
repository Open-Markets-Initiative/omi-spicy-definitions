    quote_entries_groups: QuoteEntriesGroups;
};

type QuoteEntriesGroups = unit {
    group_size: GroupSize;
    quote_entries_group: QuoteEntriesGroup[self.group_size.num_in_group];
};

type GroupSize = unit {
    block_length: uint16;
    num_in_group: uint8;
};

type QuoteEntriesGroup = unit {
    bid_px: int64;
    offer_px: int64;
    quote_entry_id: uint32;
    security_id: int32;
