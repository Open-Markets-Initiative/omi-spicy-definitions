module CmeGlobexStreamlinedSbeV59Tcp;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type CmeGlobexStreamlinedV59 = unit {
    technical_header: TechnicalHeader;
    tcp_message: TcpMessage[] &eod;
};

type TechnicalHeader = unit {
    encoding_type: uint16;
    message_sequence_number: uint32;
    tcp_sending_time: uint64;
};

type TcpMessage = unit {
    tcp_message_size: uint16;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::AdminLogin -> admin_login: AdminLogin;
        TemplateId::AdminLogout -> admin_logout: AdminLogout;
        TemplateId::MdIncrementalRefreshErisReferenceDataAndDailyStatistics -> md_incremental_refresh_eris_reference_data_and_daily_statistics: MdIncrementalRefreshErisReferenceDataAndDailyStatistics;
        TemplateId::MdNewsIndices -> md_news_indices: MdNewsIndices;
        TemplateId::MdIncrementalRefreshTradeBlocks340 -> md_incremental_refresh_trade_blocks_340: MdIncrementalRefreshTradeBlocks340;
        TemplateId::QuoteRequest -> quote_request: QuoteRequest;
        TemplateId::MdInstrumentDefinitionIndices -> md_instrument_definition_indices: MdInstrumentDefinitionIndices;
        TemplateId::MdIncrementalRefreshIndices -> md_incremental_refresh_indices: MdIncrementalRefreshIndices;
        TemplateId::MdIncrementalRefreshTradeBlocks349 -> md_incremental_refresh_trade_blocks_349: MdIncrementalRefreshTradeBlocks349;
        TemplateId::MdIncrementalRefreshEris351 -> md_incremental_refresh_eris_351: MdIncrementalRefreshEris351;
        TemplateId::MdIncrementalRefreshEris353 -> md_incremental_refresh_eris_353: MdIncrementalRefreshEris353;
        TemplateId::MdIncrementalRefreshOtC356 -> md_incremental_refresh_ot_c_356: MdIncrementalRefreshOtC356;
        TemplateId::MdInstrumentDefinitionEris -> md_instrument_definition_eris: MdInstrumentDefinitionEris;
        TemplateId::MdIncrementalRefreshTradeBlocks365 -> md_incremental_refresh_trade_blocks_365: MdIncrementalRefreshTradeBlocks365;
        TemplateId::MdIncrementalRefreshOtC366 -> md_incremental_refresh_ot_c_366: MdIncrementalRefreshOtC366;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type AdminLogin = unit {
    heart_bt_int: int8;
};

type AdminLogout = unit {
    text: bytes &size=180;
};

