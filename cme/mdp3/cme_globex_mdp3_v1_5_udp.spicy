    decaying_product_eligibility: bytes &size=1;
    variable_product_eligibility: bytes &size=1;
    daily_product_eligibility: bytes &size=1;
    gt_orders_eligibility: bytes &size=1;
    implied_matching_eligibility: bytes &size=1;
    reserved_12: bytes &size=2;
};

type LotTypeRulesGroups = unit {
    group_size: GroupSize;
    lot_type_rules_group: LotTypeRulesGroup[self.group_size.num_in_group];
};

type LotTypeRulesGroup = unit {
    lot_type: int8;
    min_lot_size: int32;
};

