module CmeGlobexMdp3SbeV15Udp;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type CmeGlobexMdp3V15 = unit {
    binary_packet_header: BinaryPacketHeader;
    message: Message[] &eod;
};

type BinaryPacketHeader = unit {
    packet_sequence_number: uint32;
    sending_time: uint64;
};

type Message = unit {
    message_size: uint16;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::ChannelReset -> channel_reset: ChannelReset;
        TemplateId::AdminLogin -> admin_login: AdminLogin;
        TemplateId::AdminLogout -> admin_logout: AdminLogout;
        TemplateId::MdInstrumentDefinitionFuture -> md_instrument_definition_future: MdInstrumentDefinitionFuture;
        TemplateId::MdInstrumentDefinitionSpread -> md_instrument_definition_spread: MdInstrumentDefinitionSpread;
        TemplateId::SecurityStatus -> security_status: SecurityStatus;
        TemplateId::MdIncrementalRefreshBook -> md_incremental_refresh_book: MdIncrementalRefreshBook;
        TemplateId::MdIncrementalRefreshDailyStatistics -> md_incremental_refresh_daily_statistics: MdIncrementalRefreshDailyStatistics;
        TemplateId::MdIncrementalRefreshLimitsBanding -> md_incremental_refresh_limits_banding: MdIncrementalRefreshLimitsBanding;
        TemplateId::MdIncrementalRefreshSessionStatistics -> md_incremental_refresh_session_statistics: MdIncrementalRefreshSessionStatistics;
        TemplateId::MdIncrementalRefreshTrade -> md_incremental_refresh_trade: MdIncrementalRefreshTrade;
        TemplateId::MdIncrementalRefreshVolume -> md_incremental_refresh_volume: MdIncrementalRefreshVolume;
        TemplateId::SnapshotFullRefresh -> snapshot_full_refresh: SnapshotFullRefresh;
        TemplateId::QuoteRequest -> quote_request: QuoteRequest;
        TemplateId::MdInstrumentDefinitionOption -> md_instrument_definition_option: MdInstrumentDefinitionOption;
        TemplateId::MdIncrementalRefreshTradeSummary -> md_incremental_refresh_trade_summary: MdIncrementalRefreshTradeSummary;
        TemplateId::Negotiate -> negotiate: Negotiate;
        TemplateId::NegotiationReject -> negotiation_reject: NegotiationReject;
        TemplateId::NegotiationResponse -> negotiation_response: NegotiationResponse;
        TemplateId::Terminate -> terminate: Terminate;
        TemplateId::MarketDataRequest -> market_data_request: MarketDataRequest;
        TemplateId::RequestAck -> request_ack: RequestAck;
        TemplateId::RequestReject -> request_reject: RequestReject;
        TemplateId::SecurityListRequest -> security_list_request: SecurityListRequest;
        TemplateId::SecurityStatusRequest -> security_status_request: SecurityStatusRequest;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type ChannelReset = unit {
    transact_time: uint64;
    match_event_indicator: MatchEventIndicator;
    channel_reset_groups: ChannelResetGroups;
};

type MatchEventIndicator = unit {
    last_trade_msg: bytes &size=1;
    last_volume_msg: bytes &size=1;
    last_quote_msg: bytes &size=1;
    last_stats_msg: bytes &size=1;
    last_implied_msg: bytes &size=1;
    recovery_msg: bytes &size=1;
    reserved: bytes &size=1;
    end_of_event: bytes &size=1;
};

type ChannelResetGroups = unit {
    group_size: GroupSize;
    channel_reset_group: ChannelResetGroup[self.group_size.num_in_group];
};

type GroupSize = unit {
    block_length: uint16;
    num_in_group: uint8;
};

type ChannelResetGroup = unit {
    appl_id: int16;
};

type AdminLogin = unit {
    heart_bt_int: int8;
};

type AdminLogout = unit {
    text: bytes &size=100;
};

type MdInstrumentDefinitionFuture = unit {
    match_event_indicator: MatchEventIndicator;
    tot_num_reports_optional: uint32;
    security_update_action: uint8 &convert=SecurityUpdateAction($$);
    last_update_time: uint64;
    md_security_trading_status: uint8 &convert=MdSecurityTradingStatus($$);
    appl_id: int16;
    market_segment_id: uint8;
    underlying_product: uint8;
    security_exchange: bytes &size=4;
    security_group: bytes &size=6;
    asset: bytes &size=6;
    symbol: bytes &size=20;
    security_id: int32;
    security_type: bytes &size=6;
    cfi_code: bytes &size=6;
    maturity_month_year: MaturityMonthYear;
    currency: bytes &size=3;
    settl_currency: bytes &size=3;
    match_algorithm: bytes &size=1;
    min_trade_vol: uint32;
    max_trade_vol: uint32;
    min_price_increment: int64;
    display_factor: int64;
    main_fraction: uint8;
    sub_fraction: uint8;
    price_display_format: uint8;
    unit_of_measure: bytes &size=30;
    unit_of_measure_qty: int64;
    trading_reference_price: int64;
    settl_price_type: SettlPriceType;
    open_interest_qty: int32;
    cleared_volume: int32;
    high_limit_price: int64;
    low_limit_price: int64;
    max_price_variation: int64;
    decay_quantity: int32;
    decay_start_date: uint16;
    original_contract_size: int32;
    contract_multiplier: int32;
    contract_multiplier_unit: int8;
    flow_schedule_type: int8;
    min_price_increment_amount: int64;
    user_defined_instrument: bytes &size=1;
    events_groups: EventsGroups;
    feed_types_groups: FeedTypesGroups;
    inst_attrib_groups: InstAttribGroups;
    lot_type_rules_groups: LotTypeRulesGroups;
};

type MaturityMonthYear = unit {
    year: uint16;
    month: uint8;
    day: uint8;
    week: uint8;
};

type SettlPriceType = unit {
    final: bytes &size=1;
    actual: bytes &size=1;
    rounded: bytes &size=1;
    intraday: bytes &size=1;
    reserved_bits: bytes &size=1;
    unused_settl_price_type_5: bytes &size=1;
    unused_settl_price_type_6: bytes &size=1;
    null_value: bytes &size=1;
};

type EventsGroups = unit {
    group_size: GroupSize;
    events_group: EventsGroup[self.group_size.num_in_group];
};

type EventsGroup = unit {
    event_type: uint8 &convert=EventType($$);
    event_time: uint64;
};

type FeedTypesGroups = unit {
    group_size: GroupSize;
    feed_types_group: FeedTypesGroup[self.group_size.num_in_group];
};

type FeedTypesGroup = unit {
    md_feed_type: bytes &size=3;
    market_depth: int8;
};

type InstAttribGroups = unit {
