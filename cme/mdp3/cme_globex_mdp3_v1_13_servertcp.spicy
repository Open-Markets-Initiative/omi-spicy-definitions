module CmeGlobexMdp3SbeV113ServerTcp;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type CmeGlobexMdp3V113 = unit {
    server_technical_header: ServerTechnicalHeader;
    server_tcp_message: ServerTcpMessage[] &eod;
};

type ServerTechnicalHeader = unit {
    encoding_type: uint16;
    message_sequence_number: uint32;
    tcp_sending_time: uint64;
};

type ServerTcpMessage = unit {
    tcp_message_size: uint16;
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::ChannelReset -> channel_reset: ChannelReset;
        TemplateId::AdminLogin -> admin_login: AdminLogin;
        TemplateId::AdminLogout -> admin_logout: AdminLogout;
        TemplateId::SecurityStatus -> security_status: SecurityStatus;
        TemplateId::MdIncrementalRefreshVolume -> md_incremental_refresh_volume: MdIncrementalRefreshVolume;
        TemplateId::QuoteRequest -> quote_request: QuoteRequest;
        TemplateId::MdIncrementalRefreshBook -> md_incremental_refresh_book: MdIncrementalRefreshBook;
        TemplateId::MdIncrementalRefreshOrderBook -> md_incremental_refresh_order_book: MdIncrementalRefreshOrderBook;
        TemplateId::MdIncrementalRefreshTradeSummary -> md_incremental_refresh_trade_summary: MdIncrementalRefreshTradeSummary;
        TemplateId::MdIncrementalRefreshDailyStatistics -> md_incremental_refresh_daily_statistics: MdIncrementalRefreshDailyStatistics;
        TemplateId::MdIncrementalRefreshLimitsBanding -> md_incremental_refresh_limits_banding: MdIncrementalRefreshLimitsBanding;
        TemplateId::MdIncrementalRefreshSessionStatistics -> md_incremental_refresh_session_statistics: MdIncrementalRefreshSessionStatistics;
        TemplateId::SnapshotFullRefresh -> snapshot_full_refresh: SnapshotFullRefresh;
        TemplateId::SnapshotFullRefreshOrderBook -> snapshot_full_refresh_order_book: SnapshotFullRefreshOrderBook;
        TemplateId::MdInstrumentDefinitionFuture -> md_instrument_definition_future: MdInstrumentDefinitionFuture;
        TemplateId::MdInstrumentDefinitionOption -> md_instrument_definition_option: MdInstrumentDefinitionOption;
        TemplateId::MdInstrumentDefinitionSpread -> md_instrument_definition_spread: MdInstrumentDefinitionSpread;
        TemplateId::MdInstrumentDefinitionFixedIncome -> md_instrument_definition_fixed_income: MdInstrumentDefinitionFixedIncome;
        TemplateId::MdInstrumentDefinitionRepo -> md_instrument_definition_repo: MdInstrumentDefinitionRepo;
        TemplateId::SnapshotRefreshTopOrders -> snapshot_refresh_top_orders: SnapshotRefreshTopOrders;
        TemplateId::SecurityStatusWorkup -> security_status_workup: SecurityStatusWorkup;
        TemplateId::SnapshotFullRefreshTcp -> snapshot_full_refresh_tcp: SnapshotFullRefreshTcp;
        TemplateId::CollateralMarketValue -> collateral_market_value: CollateralMarketValue;
        TemplateId::MdInstrumentDefinitionFx -> md_instrument_definition_fx: MdInstrumentDefinitionFx;
        TemplateId::MdIncrementalRefreshBookLongQty -> md_incremental_refresh_book_long_qty: MdIncrementalRefreshBookLongQty;
        TemplateId::MdIncrementalRefreshTradeSummaryLongQty -> md_incremental_refresh_trade_summary_long_qty: MdIncrementalRefreshTradeSummaryLongQty;
        TemplateId::MdIncrementalRefreshVolumeLongQty -> md_incremental_refresh_volume_long_qty: MdIncrementalRefreshVolumeLongQty;
        TemplateId::MdIncrementalRefreshSessionStatisticsLongQty -> md_incremental_refresh_session_statistics_long_qty: MdIncrementalRefreshSessionStatisticsLongQty;
        TemplateId::SnapshotFullRefreshTcpLongQty -> snapshot_full_refresh_tcp_long_qty: SnapshotFullRefreshTcpLongQty;
        TemplateId::SnapshotFullRefreshLongQty -> snapshot_full_refresh_long_qty: SnapshotFullRefreshLongQty;
        TemplateId::NegotiationReject -> negotiation_reject: NegotiationReject;
        TemplateId::NegotiationResponse -> negotiation_response: NegotiationResponse;
        TemplateId::Terminate -> terminate: Terminate;
        TemplateId::RequestAck -> request_ack: RequestAck;
        TemplateId::RequestReject -> request_reject: RequestReject;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type ChannelReset = unit {
    transact_time: uint64;
    match_event_indicator: MatchEventIndicator;
    channel_reset_groups: ChannelResetGroups;
};

type MatchEventIndicator = unit {
    last_trade_msg: bytes &size=1;
    last_volume_msg: bytes &size=1;
    last_quote_msg: bytes &size=1;
    last_stats_msg: bytes &size=1;
    last_implied_msg: bytes &size=1;
    recovery_msg: bytes &size=1;
    reserved: bytes &size=1;
    end_of_event: bytes &size=1;
};

type ChannelResetGroups = unit {
    group_size: GroupSize;
    channel_reset_group: ChannelResetGroup[self.group_size.num_in_group];
};

type GroupSize = unit {
    block_length: uint16;
    num_in_group: uint8;
};

type ChannelResetGroup = unit {
    appl_id: int16;
};

type AdminLogin = unit {
    heart_bt_int: int8;
};

type AdminLogout = unit {
    text: bytes &size=100;
};

type SecurityStatus = unit {
    transact_time: uint64;
    security_group: bytes &size=6;
    asset: bytes &size=6;
    security_id_optional: int32;
    trade_date: uint16;
    match_event_indicator: MatchEventIndicator;
    security_trading_status: uint8 &convert=SecurityTradingStatus($$);
    halt_reason: uint8 &convert=HaltReason($$);
    security_trading_event: uint8 &convert=SecurityTradingEvent($$);
};

type MdIncrementalRefreshVolume = unit {
    transact_time: uint64;
    match_event_indicator: MatchEventIndicator;
    : skip bytes &size=2;   # padding
    incremental_refresh_volume_groups: IncrementalRefreshVolumeGroups;
};

type IncrementalRefreshVolumeGroups = unit {
    group_size: GroupSize;
    incremental_refresh_volume_group: IncrementalRefreshVolumeGroup[self.group_size.num_in_group];
};

type IncrementalRefreshVolumeGroup = unit {
    md_entry_size_short: int32;
    security_id: int32;
    rpt_seq: uint32;
    md_update_action: uint8 &convert=MdUpdateAction($$);
    : skip bytes &size=3;   # padding
};

type QuoteRequest = unit {
    transact_time: uint64;
    quote_req_id: bytes &size=23;
    match_event_indicator: MatchEventIndicator;
    : skip bytes &size=3;   # padding
    related_sym_groups: RelatedSymGroups;
};

type RelatedSymGroups = unit {
    group_size: GroupSize;
    related_sym_group: RelatedSymGroup[self.group_size.num_in_group];
};

type RelatedSymGroup = unit {
    symbol: bytes &size=20;
    security_id: int32;
    order_qty: int32;
    quote_type: int8;
    side_optional: int8;
    : skip bytes &size=2;   # padding
};

type MdIncrementalRefreshBook = unit {
    transact_time: uint64;
    match_event_indicator: MatchEventIndicator;
    : skip bytes &size=2;   # padding
    incremental_refresh_book_groups: IncrementalRefreshBookGroups;
    incremental_refresh_book_order_id_groups: IncrementalRefreshBookOrderIdGroups;
};

type IncrementalRefreshBookGroups = unit {
    group_size: GroupSize;
    incremental_refresh_book_group: IncrementalRefreshBookGroup[self.group_size.num_in_group];
};

type IncrementalRefreshBookGroup = unit {
    md_entry_px_optional_ex: int64;
    md_entry_size_short_optional: int32;
    security_id: int32;
    rpt_seq: uint32;
    number_of_orders_optional: int32;
    md_price_level: uint8;
    md_update_action: uint8 &convert=MdUpdateAction($$);
    md_entry_type_book: uint8 &convert=MdEntryTypeBook($$);
    tradeable_size: int32;
    : skip bytes &size=1;   # padding
};

type IncrementalRefreshBookOrderIdGroups = unit {
    group_size_8_byte: GroupSize8Byte;
    incremental_refresh_book_order_id_group: IncrementalRefreshBookOrderIdGroup[self.group_size_8_byte.num_in_group];
};

type GroupSize8Byte = unit {
    block_length: uint16;
    : skip bytes &size=5;   # padding
    num_in_group: uint8;
};

type IncrementalRefreshBookOrderIdGroup = unit {
    order_id: uint64;
    md_order_priority_optional: uint64;
    md_display_qty_optional: int32;
    reference_id: uint8;
    order_update_action: uint8 &convert=OrderUpdateAction($$);
    : skip bytes &size=2;   # padding
};

type MdIncrementalRefreshOrderBook = unit {
    transact_time: uint64;
    match_event_indicator: MatchEventIndicator;
    : skip bytes &size=2;   # padding
    incremental_refresh_order_book_groups: IncrementalRefreshOrderBookGroups;
};

type IncrementalRefreshOrderBookGroups = unit {
    group_size: GroupSize;
    incremental_refresh_order_book_group: IncrementalRefreshOrderBookGroup[self.group_size.num_in_group];
};

type IncrementalRefreshOrderBookGroup = unit {
    order_id_optional: uint64;
    md_order_priority_optional: uint64;
    md_entry_px_optional_ex: int64;
    md_display_qty_optional: int32;
    security_id: int32;
    md_update_action: uint8 &convert=MdUpdateAction($$);
    md_entry_type_book: uint8 &convert=MdEntryTypeBook($$);
    : skip bytes &size=6;   # padding
};

type MdIncrementalRefreshTradeSummary = unit {
    transact_time: uint64;
    match_event_indicator: MatchEventIndicator;
    : skip bytes &size=2;   # padding
    incremental_refresh_trade_summary_groups: IncrementalRefreshTradeSummaryGroups;
    incremental_refresh_trade_summary_order_id_groups: IncrementalRefreshTradeSummaryOrderIdGroups;
};

type IncrementalRefreshTradeSummaryGroups = unit {
    group_size: GroupSize;
    incremental_refresh_trade_summary_group: IncrementalRefreshTradeSummaryGroup[self.group_size.num_in_group];
};

type IncrementalRefreshTradeSummaryGroup = unit {
    md_entry_px_ex: int64;
    md_entry_size_short: int32;
    security_id: int32;
    rpt_seq: uint32;
    number_of_orders: int32;
    aggressor_side: uint8 &convert=AggressorSide($$);
    md_update_action: uint8 &convert=MdUpdateAction($$);
    md_trade_entry_optional: uint32;
    : skip bytes &size=2;   # padding
};

type IncrementalRefreshTradeSummaryOrderIdGroups = unit {
    group_size_8_byte: GroupSize8Byte;
    incremental_refresh_trade_summary_order_id_group: IncrementalRefreshTradeSummaryOrderIdGroup[self.group_size_8_byte.num_in_group];
};

type IncrementalRefreshTradeSummaryOrderIdGroup = unit {
