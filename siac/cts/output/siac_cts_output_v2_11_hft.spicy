module SiacCtsOutputCtaV211Hft;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type SiacCtsOutputV211Hft = unit {
    block_header: BlockHeader;
    message: Message[self.block_header.messages_in_block];
    block_pad_byte: uint8;
};

type BlockHeader = unit {
    version: uint8;
    block_size: uint16;
    data_feed_indicator: bytes &size=1;
    retransmission_indicator: bytes &size=1;
    block_sequence_number: uint32;
    messages_in_block: uint8;
    sip_block_timestamp: SipBlockTimestamp;
    block_checksum: uint16;
};

type SipBlockTimestamp = unit {
    seconds: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_header: MessageHeader;
    message_payload: FractionalTradeCancelErrorMessage;
};

type MessageHeader = unit {
    message_length: uint16;
    message_category: bytes &size=1;
    message_type: bytes &size=1;
    participant_id: uint8 &convert=ParticipantId($$);
    timestamp_1: Timestamp1;
    message_id: uint8;
    transaction_id: uint32;
    participant_reference_number: int64;
};

type Timestamp1 = unit {
    seconds: uint32;
    nanoseconds: uint32;
};

