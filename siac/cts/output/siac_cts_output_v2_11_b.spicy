        TradeMessageType::FractionalTradeCorrection -> fractional_trade_correction_message: FractionalTradeCorrectionMessage;
        TradeMessageType::FractionalLongTrade -> fractional_long_trade_message: FractionalLongTradeMessage;
        TradeMessageType::TradingStatus -> trading_status_message: TradingStatusMessage;
