    NoBestBidChangeNoBestOffer = 0x45,
    QuoteContainsBestBidNoBestOfferChange = 0x46,
    QuoteContainsBestBidQuoteContainsBestOffer = 0x47,
    QuoteContainsBestBidBestOfferShortAppendage = 0x48,
    QuoteContainsBestBidBestOfferLongAppendage = 0x49,
    QuoteContainsBestBidNoBestOffer = 0x4a,
    NoBestBidNoBestOfferChange = 0x4b,
    NoBestBidQuoteContainsBestOffer = 0x4c,
    NoBestBidBestOfferShortAppendage = 0x4d,
    NoBestBidBestOfferLongAppendage = 0x4e,
    NoBestBidNoBestOffer = 0x4f,
    BestBidShortAppendageNoBestOfferChange = 0x50,
    BestBidLongAppendageNoBestOfferChange = 0x51,
    BestBidShortAppendageQuoteContainsBestOffer = 0x52,
    BestBidLongAppendageQuoteContainsBestOffer = 0x53,
    BestBidShortAppendageBestOfferShortAppendage = 0x54,
    BestBidLongAppendageBestOfferLongAppendage = 0x55,
    BestBidShortAppendageNoBestOffer = 0x56,
    BestBidLongAppendageNoBestOffer = 0x57,
};

