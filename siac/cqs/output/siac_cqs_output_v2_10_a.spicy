    LuldNotApplicable = 0x30,
    LuldTier1Security = 0x31,
    LuldTier2Security = 0x32,
};

type Test = enum {
    NotATestSymbol = 0x30,
    TestSymbol = 0x31,
};

type Ipo = enum {
    NotAnIpoSymbol = 0x30,
    IpoSymbol = 0x31,
};

