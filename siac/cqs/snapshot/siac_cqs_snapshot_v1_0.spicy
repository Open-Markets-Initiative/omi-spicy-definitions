    RetailInterestOnBidQuote = 0x41,
    RetailInterestOnOfferQuote = 0x42,
    RetailInterestOnBothTheBidAndOfferQuotes = 0x43,
};

type SettlementCondition = enum {
    RegularWaySettlement = 0x20,
    CashOnlySettlement = 0x41,
