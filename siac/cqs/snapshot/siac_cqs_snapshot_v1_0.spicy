module SiacCqsSnapshotCtaV10;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type SiacCqsSnapshotV10 = unit {
    block_header: BlockHeader;
    message: Message[self.block_header.messages_in_block];
    block_pad_byte: uint8;
};

type BlockHeader = unit {
    version: uint8;
    block_size: uint16;
    block_sequence_number: uint32;
    messages_in_block: uint8;
    delivery_flag: uint8 &convert=DeliveryFlag($$);
    last_seq_num: bytes &size=1;
    tot_pub_seq_rollover: uint8;
    sip_block_timestamp: SipBlockTimestamp;
    block_checksum: uint16;
};

type SipBlockTimestamp = unit {
    seconds: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_length: uint16;
    message_category: uint8 &convert=MessageCategory($$);
    category_payload: SnapshotMessage;
};

type SnapshotMessage = unit {
    snapshot_message_type: uint8 &convert=SnapshotMessageType($$);
    switch ( self.snapshot_message_type ) {
        SnapshotMessageType::LineIntegrityMessage -> line_integrity_message: LineIntegrityMessage;
        SnapshotMessageType::MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage -> market_wide_circuit_breaker_decline_level_status_snapshot_message: MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage;
        SnapshotMessageType::ConsolidatedSnapshotMessage -> consolidated_snapshot_message: ConsolidatedSnapshotMessage;
        SnapshotMessageType::ParticipantSnapshotMessage -> participant_snapshot_message: ParticipantSnapshotMessage;
        SnapshotMessageType::FinraSnapshotMessage -> finra_snapshot_message: FinraSnapshotMessage;
        * -> unknown: bytes &eod;
    };
};

type LineIntegrityMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
};

type MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    mwcb_level_1: int64;
    mwcb_level_2: int64;
    mwcb_level_3: int64;
    reserved: uint8;
};

type ConsolidatedSnapshotMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    security_symbol: bytes &size=11;
    instrument_type: uint8 &convert=InstrumentType($$);
    lower_limit_price_band: uint64;
    upper_limit_price_band: uint64;
    auction_collar_reference_price: uint64;
    auction_collar_upper_threshold_price: uint64;
    auction_collar_lower_threshold_price: uint64;
    number_of_extensions: uint8;
    national_best_bid_participant_id: uint8 &convert=NationalBestBidParticipantId($$);
    national_best_bid_quote_condition: uint8 &convert=NationalBestBidQuoteCondition($$);
    national_best_bid_price: uint64;
    national_best_bid_size: uint32;
    finra_best_bid_market_maker_id: bytes &size=4;
    national_best_offer_participant_id: uint8 &convert=NationalBestOfferParticipantId($$);
    national_best_offer_quote_condition: uint8 &convert=NationalBestOfferQuoteCondition($$);
    national_best_offer_price: uint64;
    national_best_offer_size: uint32;
    finra_best_offer_market_maker_id: bytes &size=4;
    national_bbo_luld_indicator: uint8 &convert=NationalBboLuldIndicator($$);
    primary_listing_market_participant_id: uint8 &convert=PrimaryListingMarketParticipantId($$);
    financial_status_indicator: uint8 &convert=FinancialStatusIndicator($$);
    short_sale_restriction_indicator: uint8 &convert=ShortSaleRestrictionIndicator($$);
    halt_reason: uint8 &convert=HaltReason($$);
    future: bytes &size=1;
};

type ParticipantSnapshotMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    security_symbol: bytes &size=11;
    quote_condition: uint8 &convert=QuoteCondition($$);
    bid_price: uint64;
    bid_size: uint32;
    offer_price: uint64;
    offer_size: uint32;
    retail_interest_indicator: uint8 &convert=RetailInterestIndicator($$);
    settlement_condition: uint8 &convert=SettlementCondition($$);
    market_condition: uint8 &convert=MarketCondition($$);
    luld_indicator: uint8 &convert=LuldIndicator($$);
    high_indication_price: uint64;
    low_indication_price: uint64;
    halt_reason: uint8 &convert=HaltReason($$);
};

type FinraSnapshotMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    security_symbol: bytes &size=11;
    finra_best_bid_quote_condition: uint8 &convert=FinraBestBidQuoteCondition($$);
    finra_best_bid_price: uint64;
    finra_best_bid_size: uint32;
    finra_best_bid_market_maker_id: bytes &size=4;
    finra_best_offer_quote_condition: uint8 &convert=FinraBestOfferQuoteCondition($$);
    finra_best_offer_price: uint64;
    finra_best_offer_size: uint32;
    finra_best_offer_market_maker_id: bytes &size=4;
    finra_bbo_luld_indicator: uint8 &convert=FinraBboLuldIndicator($$);
    high_indication_price: uint64;
    low_indication_price: uint64;
    halt_reason: uint8 &convert=HaltReason($$);
};

type DeliveryFlag = enum {
    FirstBlock = 1,
    IntermediateBlock = 2,
    LastBlock = 3,
    OnlyOneBlock = 4,
};

type MessageCategory = enum {
    Snapshot = 0x4b,
};

type SnapshotMessageType = enum {
    LineIntegrityMessage = 0x54,
    MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage = 0x4b,
    ConsolidatedSnapshotMessage = 0x43,
    ParticipantSnapshotMessage = 0x50,
    FinraSnapshotMessage = 0x46,
};

type ParticipantId = enum {
    NyseAmerican = 0x41,
    NasdaqBx = 0x42,
    NyseNational = 0x43,
    Adf = 0x44,
    Miax = 0x48,
    Ise = 0x49,
    CboeEdga = 0x4a,
    CboeEdgx = 0x4b,
    Ltse = 0x4c,
    NyseChicago = 0x4d,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Cqs = 0x53,
    Nasdaq = 0x54,
    Memx = 0x55,
    Iex = 0x56,
    Cbsx = 0x57,
    NasdaqPsx = 0x58,
    CboeByx = 0x59,
    CboeBzx = 0x5a,
};

type InstrumentType = enum {
    CtaEligibleEquity = 0x30,
    LocalIssue = 0x31,
    CorporateBond = 0x32,
    GovernmentBond = 0x33,
};

type NationalBestBidParticipantId = enum {
    NyseAmerican = 0x41,
    NasdaqBx = 0x42,
    NyseNational = 0x43,
    Adf = 0x44,
    Miax = 0x48,
    Ise = 0x49,
    CboeEdga = 0x4a,
    CboeEdgx = 0x4b,
    Ltse = 0x4c,
    NyseChicago = 0x4d,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Cqs = 0x53,
    Nasdaq = 0x54,
    Memx = 0x55,
    Iex = 0x56,
    Cbsx = 0x57,
    NasdaqPsx = 0x58,
    CboeByx = 0x59,
    CboeBzx = 0x5a,
};

type NationalBestBidQuoteCondition = enum {
    QuoteConditionNotApplicable = 0x20,
    SlowQuoteOnOfferSide = 0x41,
    SlowQuoteOnBidSide = 0x42,
    Closing = 0x43,
    SlowQuoteDueToLrpOrGapQuoteOnTheBidSide = 0x45,
    SlowQuoteDueToLrpOrGapQuoteOnTheOfferSide = 0x46,
    SlowQuoteOnTheBidAndOfferSides = 0x48,
    ClosedMarketMaker = 0x4c,
    NonFirmQuote = 0x4e,
    OpeningQuote = 0x4f,
    RegularFinraOpen = 0x52,
    SlowQuoteDueToLiquidityReplenishmentPointOrGapQuoteOnBothTheBidAndOfferSides = 0x55,
    SlowQuoteDueToSetSlowListOnBothTheBidAndOfferSides = 0x57,
    OnDemandIntraDayAuction = 0x34,
};

