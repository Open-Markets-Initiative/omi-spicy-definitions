module SiacCqsSnapshotCtaV21;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type SiacCqsSnapshotV21 = unit {
    block_header: BlockHeader;
    message: Message[self.block_header.messages_in_block];
    block_pad_byte: uint8;
};

type BlockHeader = unit {
    version: uint8;
    block_size: uint16;
    block_sequence_number: uint32;
    messages_in_block: uint8;
    deliveryflag: uint8 &convert=Deliveryflag($$);
    lastseqnum: uint32;
    totpubseqrollover: uint8;
    sip_block_timestamp: SipBlockTimestamp;
    block_checksum: uint16;
};

type SipBlockTimestamp = unit {
    seconds: uint32;
    nanoseconds: uint32;
};

type Message = unit {
    message_length: uint16;
    message_category: uint8 &convert=MessageCategory($$);
    category_payload: SnapshotMessage;
};

type SnapshotMessage = unit {
    snapshot_message_type: uint8;
    switch ( self.snapshot_message_type ) {
        0x54 -> line_integrity_message: LineIntegrityMessage;
        0x53 -> symbol_reference_data_message: SymbolReferenceDataMessage;
        0x4b -> market_wide_circuit_breaker_decline_level_status_snapshot_message: MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage;
        0x43 -> consolidated_snapshot_message: ConsolidatedSnapshotMessage;
        0x50 -> participant_snapshot_message: ParticipantSnapshotMessage;
        0x46 -> finra_snapshot_message: FinraSnapshotMessage;
        * -> unknown: bytes &eod;
    };
};

type LineIntegrityMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
};

type SymbolReferenceDataMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    security_symbol: bytes &size=11;
    prior_security_symbol: bytes &size=11;
    primary_listing_market_participant_id: uint8 &convert=PrimaryListingMarketParticipantId($$);
    primary_listing_market_previous_closing_price: uint64;
    consolidated_closing_price: uint64;
    round_lot_size: uint16;
    reserved: bytes &size=1;
    luld_tier: uint8 &convert=LuldTier($$);
    luld_leverage_ratio: uint32;
    test: uint8 &convert=Test($$);
    ipo: uint8 &convert=Ipo($$);
    financial_status_indicator: uint8 &convert=FinancialStatusIndicator($$);
    short_sale_restriction_indicator: uint8 &convert=ShortSaleRestrictionIndicator($$);
    halt_reason: uint8 &convert=HaltReason($$);
    instrument_type: uint8 &convert=InstrumentType($$);
    second_reserved: bytes &size=1;
    third_reserved: bytes &size=1;
    fourth_reserved: bytes &size=1;
};

type MarketWideCircuitBreakerDeclineLevelStatusSnapshotMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    mwcb_level_1: int64;
    mwcb_level_2: int64;
    mwcb_level_3: int64;
    reserved: bytes &size=1;
};

type ConsolidatedSnapshotMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    security_symbol: bytes &size=11;
    instrument_type: uint8 &convert=InstrumentType($$);
    lower_limit_price_band: uint64;
    upper_limit_price_band: uint64;
    auction_collar_reference_price: uint64;
    auction_collar_upper_threshold_price: uint64;
    auction_collar_lower_threshold_price: uint64;
    number_of_extensions: uint8;
    national_best_bid_participant_id: bytes &size=1;
    national_best_bid_quote_condition: bytes &size=1;
    national_best_bid_price: uint64;
    national_best_bid_size: uint32;
    finra_best_bid_market_maker_id: bytes &size=4;
    national_best_offer_participant_id: bytes &size=1;
    national_best_offer_quote_condition: bytes &size=1;
    national_best_offer_price: uint64;
    national_best_offer_size: uint32;
    finra_best_offer_market_maker_id: bytes &size=4;
    national_bbo_luld_indicator: uint8 &convert=NationalBboLuldIndicator($$);
    primary_listing_market_participant_id: uint8 &convert=PrimaryListingMarketParticipantId($$);
    financial_status_indicator: uint8 &convert=FinancialStatusIndicator($$);
    short_sale_restriction_indicator: uint8 &convert=ShortSaleRestrictionIndicator($$);
    halt_reason: uint8 &convert=HaltReason($$);
    reserved: bytes &size=1;
};

type ParticipantSnapshotMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    security_symbol: bytes &size=11;
    quote_condition: uint8 &convert=QuoteCondition($$);
    bid_price: uint64;
    bid_size: uint32;
    offer_price: uint64;
    offer_size: uint32;
    retail_interest_indicator: uint8 &convert=RetailInterestIndicator($$);
    settlement_condition: uint8 &convert=SettlementCondition($$);
    market_condition: uint8 &convert=MarketCondition($$);
    limit_up_limit_down_luld_indicator: uint8 &convert=LimitUpLimitDownLuldIndicator($$);
    high_indication_price: uint64;
    low_indication_price: uint64;
    halt_reason: uint8 &convert=HaltReason($$);
};

type FinraSnapshotMessage = unit {
    participant_id: uint8 &convert=ParticipantId($$);
    security_symbol: bytes &size=11;
    finra_best_bid_quote_condition: bytes &size=1;
    finra_best_bid_price: uint64;
    finra_best_bid_size: uint32;
    finra_best_bid_market_maker_id: bytes &size=4;
    finra_best_offer_quote_condition: bytes &size=1;
    finra_best_offer_price: uint64;
    finra_best_offer_size: uint32;
    finra_best_offer_market_maker_id: bytes &size=4;
    finra_bbo_luld_indicator: uint8 &convert=FinraBboLuldIndicator($$);
    high_indication_price: uint64;
    low_indication_price: uint64;
    halt_reason: uint8 &convert=HaltReason($$);
};

type Deliveryflag = enum {
    FirstBlock = 1,
    IntermediateBlock = 2,
    LastBlock = 3,
    OnlyOneBlock = 4,
};

type MessageCategory = enum {
    Snapshot = 0x52,
};

type ParticipantId = enum {
    NyseAmerican = 0x41,
    NasdaqOmxBx = 0x42,
    NyseNational = 0x43,
    FinraAdf = 0x44,
    N24X = 0x47,
    Miax = 0x48,
    Ise = 0x49,
    CboeEdga = 0x4a,
    CboeEdgx = 0x4b,
    Ltse = 0x4c,
    NyseTexas = 0x4d,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Cqs = 0x53,
    Nasdaq = 0x54,
    Memx = 0x55,
    Iex = 0x56,
    Cbsx = 0x57,
    NasdaqOmxPsx = 0x58,
    CboeByx = 0x59,
    CboeBzx = 0x5a,
};

type PrimaryListingMarketParticipantId = enum {
    PrimaryListingMarketParticipantIdNotApplicable = 0x20,
    NyseAmerican = 0x41,
    NasdaqOmxBx = 0x42,
    NyseNational = 0x43,
    FinraAdf = 0x44,
    N24X = 0x47,
    MiaxPearl = 0x48,
    Ise = 0x49,
    CboeEdga = 0x4a,
    CboeEdgx = 0x4b,
    Ltse = 0x4c,
    NyseTexas = 0x4d,
    Nyse = 0x4e,
    NyseArca = 0x50,
    Nasdaq = 0x54,
    MembersExchange = 0x55,
    Iex = 0x56,
    Cbsx = 0x57,
    NasdaqOmxPsx = 0x58,
    CboeByx = 0x59,
    CboeBzx = 0x5a,
};

type LuldTier = enum {
    LuldNotApplicable = 0x30,
    LuldTier1Security = 0x31,
    LuldTier2Security = 0x32,
};

type Test = enum {
    NotATestSymbol = 0x30,
    TestSymbol = 0x31,
};

type Ipo = enum {
    NotAnIpoSymbol = 0x30,
    IpoSymbol = 0x31,
};

type FinancialStatusIndicator = enum {
    FinancialStatusNotApplicable = 0x30,
    Bankrupt = 0x31,
    BelowContinuingListingStandards = 0x32,
    BankruptAndBelowContinuingListingStandards = 0x33,
    LateFiling = 0x34,
    BankruptAndLateFiling = 0x35,
    BelowContinuingListingStandardsAndLateFiling = 0x36,
    BankruptBelowContinuingListingStandardsAndLateFiling = 0x37,
    CreationsSuspended = 0x38,
    RedemptionsSuspended = 0x39,
    Liquidation = 0x41,
};

type ShortSaleRestrictionIndicator = enum {
    ShortSaleRestrictionNotInEffect = 0x20,
    ShortSaleRestrictionInEffect = 0x45,
};

type HaltReason = enum {
    HaltReasonNotApplicable = 0x20,
    AdditionalInformationRequested = 0x41,
    RegulatoryConcern = 0x43,
    NewsReleased = 0x44,
    MergerEffective = 0x45,
    EtfComponentPricesNotAvailable = 0x46,
    OrderImbalance = 0x49,
    LimitUpLimitDownLuldTradingPause = 0x4d,
    CorporateAction = 0x4e,
    NewSecurityOffering = 0x4f,
    NewsPending = 0x50,
    IntradayIndicativeValueNotAvailable = 0x56,
    Operational = 0x58,
    SubPennyTrading = 0x59,
    MarketWideCircuitBreakerLevel1Breached = 0x31,
    MarketWideCircuitBreakerLevel2Breached = 0x32,
    MarketWideCircuitBreakerLevel3Breached = 0x33,
};

type InstrumentType = enum {
    CtaEligibleEquity = 0x30,
    LocalIssue = 0x31,
    CorporateBond = 0x32,
    GovernmentBond = 0x33,
};

type NationalBboLuldIndicator = enum {
    LimitUpLimitDownNotApplicable = 0x20,
    NationalBestBidAndorNationalBestOfferAreExecutable = 0x41,
    NationalBestBidBelowLowerLimitPriceBand = 0x42,
    NationalBestOfferAboveUpperLimitPriceBand = 0x43,
    NationalBestBidBelowLowerLimitPriceBandAndNationalBestOfferAboveUpperLimitPriceBand = 0x44,
    NationalBestBidEqualsUpperLimitPriceBand = 0x45,
    NationalBestOfferEqualsLowerLimitPriceBand = 0x46,
    NationalBestBidEqualsUpperLimitPriceBandAndNationalBestOfferAboveUpperLimitPriceBand = 0x47,
    NationalBestBidBelowLowerLimitPriceBandAndNationalBestOfferEqualsLowerLimitPriceBand = 0x48,
    NationalBestBidEqualsUpperLimitPriceBandAndNationalBestOfferEqualsLowerLimitPriceBand = 0x49,
};

type QuoteCondition = enum {
    QuoteConditionNotApplicable = 0x20,
    SlowQuoteOnOfferSide = 0x41,
    SlowQuoteOnBidSide = 0x42,
    Closing = 0x43,
    SlowQuoteDueToLrpOrGapQuoteOnTheBidSide = 0x45,
    SlowQuoteDueToLrpOrGapQuoteOnTheOfferSide = 0x46,
    SlowQuoteOnTheBidAndOfferSides = 0x48,
    ClosedMarketMakerFinra = 0x4c,
    NonFirmQuote = 0x4e,
    OpeningQuote = 0x4f,
    RegularFinraOpen = 0x52,
    SlowQuoteDueToLrpOrGapQuoteOnBothTheBidAndOfferSides = 0x55,
    SlowQuoteDueToSetSlowListOnBothTheBidAndOfferSides = 0x57,
    OnDemandIntraDayAuction = 0x34,
};

type RetailInterestIndicator = enum {
    RetailInterestIndicatorNotApplicable = 0x20,
    RetailInterestOnBidQuote = 0x41,
    RetailInterestOnOfferQuote = 0x42,
    RetailInterestOnBothTheBidAndOfferQuotes = 0x43,
};

type SettlementCondition = enum {
    RegularWaySettlement = 0x20,
    CashOnlySettlement = 0x41,
    NextDayOnlySettlement = 0x42,
};

type MarketCondition = enum {
    NormalAuctionMarket = 0x20,
    CrossedMarket = 0x41,
    LockedMarket = 0x42,
};

type LimitUpLimitDownLuldIndicator = enum {
    LimitUpLimitDownNotApplicable = 0x20,
    BidPriceAboveUpperLimitPriceBand = 0x41,
    OfferPriceBelowLowerLimitPriceBand = 0x42,
};

type FinraBboLuldIndicator = enum {
    LimitUpLimitDownNotApplicable = 0x20,
    FinraBestBidAndorFinraBestOfferAreExecutable = 0x41,
    FinraBestBidOutsidePriceBand = 0x42,
    FinraBestOfferOutsidePriceBand = 0x43,
    FinraBestBidAndFinraBestOfferOutsidePriceBand = 0x44,
};

