type ShortEquityAndIndexQuoteMessageType = enum {
    RegularTrading = 0x20,
    NonFirmQuote = 0x46,
    IndicativeValue = 0x49,
    Rotation = 0x52,
    TradingHalted = 0x54,
    EligibleForAutomaticExecution = 0x41,
    BidContainsCustomerTradingInterest = 0x42,
