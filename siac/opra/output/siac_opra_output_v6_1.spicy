type AdministrativeMessageType = enum {
    Administrative = 0x20,
};

type ControlMessageType = enum {
    StartOfDay = 0x43,
    StartOfSummary = 0x45,
    EndOfSummary = 0x46,
    EndOfDay = 0x4a,
    ResetBlockSequenceNumber = 0x4b,
    StartOfOpenInterest = 0x4c,
    EndOfOpenInterest = 0x4d,
    LineIntegrity = 0x4e,
    DisasterRecoveryDataCenterActivation = 0x50,
    StartOfTestCycle = 0x41,
    EndOfTestCycle = 0x42,
    GoodMorning = 0x44,
    EarlyMarketClose = 0x47,
    EndOfTransactionReporting = 0x48,
    GoodNight = 0x49,
};

type UnderlyingValueMessageType = enum {
    UnderlyingValueLastSaleMessage = 0x20,
    UnderlyingValueBidAndOfferMessage = 0x49,
};

type IndexValueDenominatorCode = enum {
    Ten = 0x41,
    Hundred = 0x42,
    Thousand = 0x43,
    TenThousand = 0x44,
    HundredThousand = 0x45,
    Million = 0x46,
    TenMillion = 0x47,
    NoFraction = 0x49,
};

