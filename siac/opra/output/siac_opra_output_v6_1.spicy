};

type BestBidDenominatorCode = enum {
    Ten = 0x41,
    Hundred = 0x42,
    Thousand = 0x43,
    TenThousand = 0x44,
    HundredThousand = 0x45,
    Million = 0x46,
    TenMillion = 0x47,
