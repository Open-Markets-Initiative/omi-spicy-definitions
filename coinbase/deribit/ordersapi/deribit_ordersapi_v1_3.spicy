module CoinbaseDeribitOrdersapiSbeV13;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type DeribitOrdersapiV13 = unit {
    sbe_message: SbeMessage[] &eod;
};

type SbeMessage = unit {
    message_header: MessageHeader;
    switch ( self.message_header.template_id ) {
        TemplateId::LogonMessage -> logon_message: LogonMessage;
        TemplateId::LogonConfMessage -> logon_conf_message: LogonConfMessage;
        TemplateId::LogoutMessage -> logout_message: LogoutMessage;
        TemplateId::LoggedOutMessage -> logged_out_message: LoggedOutMessage;
        TemplateId::HeartbeatMessage -> heartbeat_message: HeartbeatMessage;
        TemplateId::TestRequestMessage -> test_request_message: TestRequestMessage;
        TemplateId::ResendRequestMessage -> resend_request_message: ResendRequestMessage;
        TemplateId::GapFillMessage -> gap_fill_message: GapFillMessage;
        TemplateId::RejectMessage -> reject_message: RejectMessage;
        TemplateId::NewOrderRequestMessage -> new_order_request_message: NewOrderRequestMessage;
        TemplateId::AmendOrderRequestMessage -> amend_order_request_message: AmendOrderRequestMessage;
        TemplateId::CancelOrderRequestMessage -> cancel_order_request_message: CancelOrderRequestMessage;
        TemplateId::CancelOrderByIdRequestMessage -> cancel_order_by_id_request_message: CancelOrderByIdRequestMessage;
        TemplateId::MassQuoteRequestMessage -> mass_quote_request_message: MassQuoteRequestMessage;
        TemplateId::MassCancelRequestMessage -> mass_cancel_request_message: MassCancelRequestMessage;
        TemplateId::MassQuoteCancelRequestMessage -> mass_quote_cancel_request_message: MassQuoteCancelRequestMessage;
        TemplateId::GetMassQuoteMmpStatusRequestMessage -> get_mass_quote_mmp_status_request_message: GetMassQuoteMmpStatusRequestMessage;
        TemplateId::GetOrdersMmpStatusRequestMessage -> get_orders_mmp_status_request_message: GetOrdersMmpStatusRequestMessage;
        TemplateId::NewOrderResponseMessage -> new_order_response_message: NewOrderResponseMessage;
        TemplateId::NewOrderRejectMessage -> new_order_reject_message: NewOrderRejectMessage;
        TemplateId::AmendOrderResponseMessage -> amend_order_response_message: AmendOrderResponseMessage;
        TemplateId::AmendOrderRejectMessage -> amend_order_reject_message: AmendOrderRejectMessage;
        TemplateId::CancelOrderResponseMessage -> cancel_order_response_message: CancelOrderResponseMessage;
        TemplateId::CancelOrderRejectMessage -> cancel_order_reject_message: CancelOrderRejectMessage;
        TemplateId::MassQuoteResponseMessage -> mass_quote_response_message: MassQuoteResponseMessage;
        TemplateId::MassQuoteRejectMessage -> mass_quote_reject_message: MassQuoteRejectMessage;
        TemplateId::MassCancelResponseMessage -> mass_cancel_response_message: MassCancelResponseMessage;
        TemplateId::MassCancelRejectMessage -> mass_cancel_reject_message: MassCancelRejectMessage;
        TemplateId::GetMassQuoteMmpStatusResponseMessage -> get_mass_quote_mmp_status_response_message: GetMassQuoteMmpStatusResponseMessage;
        TemplateId::GetMassQuoteMmpStatusRejectMessage -> get_mass_quote_mmp_status_reject_message: GetMassQuoteMmpStatusRejectMessage;
        TemplateId::GetOrdersMmpStatusResponseMessage -> get_orders_mmp_status_response_message: GetOrdersMmpStatusResponseMessage;
        TemplateId::GetOrdersMmpStatusRejectMessage -> get_orders_mmp_status_reject_message: GetOrdersMmpStatusRejectMessage;
        TemplateId::OrderFilledMessage -> order_filled_message: OrderFilledMessage;
        TemplateId::OrdersCanceledMessage -> orders_canceled_message: OrdersCanceledMessage;
        TemplateId::OrderPlacedMessage -> order_placed_message: OrderPlacedMessage;
        TemplateId::MassQuoteOrdersPlacedMessage -> mass_quote_orders_placed_message: MassQuoteOrdersPlacedMessage;
        TemplateId::MassQuoteMmpTriggeredMessage -> mass_quote_mmp_triggered_message: MassQuoteMmpTriggeredMessage;
        TemplateId::OrdersMmpTriggeredMessage -> orders_mmp_triggered_message: OrdersMmpTriggeredMessage;
        TemplateId::MassQuoteMmpUnfrozenMessage -> mass_quote_mmp_unfrozen_message: MassQuoteMmpUnfrozenMessage;
        TemplateId::OrdersMmpUnfrozenMessage -> orders_mmp_unfrozen_message: OrdersMmpUnfrozenMessage;
        * -> unknown: bytes &eod;
    };
    : skip bytes &size=0;   # padding
};

type MessageHeader = unit {
    protocol_id: uint8;
    session_flags: SessionFlags;
    message_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_version: uint16;
    sequence_number: int64;
    last_processed_seq_no: int64;
    send_time_ns: int64;
};

type SessionFlags = unit {
    is_resend: bytes &size=1;
    : skip bytes &size=1;   # padding
};

type LogonMessage = unit {
    client_id: bytes &size=16;
    secret: bytes &size=48;
    reset_seq_num: int8 &convert=ResetSeqNum($$);
};

type LogonConfMessage = unit {
    heartbeat_interval_seconds: int32;
};

type LogoutMessage = unit {
    reason: Reason;
};

type Reason = unit {
    reason_length: uint8;
    reason_data: bytes &size=self.reason_length;
};

type LoggedOutMessage = unit {
    reason: Reason;
};

type HeartbeatMessage = unit {
    correlation_id: int64;
};

type TestRequestMessage = unit {
    correlation_id: int64;
};

type ResendRequestMessage = unit {
    from_sequence_number: int64;
    to_sequence_number: int64;
};

type GapFillMessage = unit {
    new_sequence_number: int64;
};

type RejectMessage = unit {
    ref_sequence_number: int64;
    reason_reject_reason: int8 &convert=ReasonRejectReason($$);
    details: Details;
};

type Details = unit {
    details_length: uint8;
    details_data: bytes &size=self.details_length;
};

type NewOrderRequestMessage = unit {
    client_order_id: int64;
    correlation_id: int64;
    instrument_id: int64;
    price: int64;
    quantity: Quantity;
    show_qty: ShowQty;
    self_match_prevention_id: int64;
    side: int8 &convert=Side($$);
    time_in_force: int8;
    flags_order_flags: FlagsOrderFlags;
    self_trading_mode: int8 &convert=SelfTradingMode($$);
};

type Quantity = unit {
    mantissa: int64;
    exponent: int8;
};

type ShowQty = unit {
    mantissa: int64;
    exponent: int8;
};

type FlagsOrderFlags = unit {
    cancel_on_disconnect: bytes &size=1;
    post_only: bytes &size=1;
    post_only_reject: bytes &size=1;
    market_limit: bytes &size=1;
    mmp: bytes &size=1;
    reset_mmp: bytes &size=1;
    reserved_10: bytes &size=2;
};

type AmendOrderRequestMessage = unit {
    client_order_id: int64;
    correlation_id: int64;
    instrument_id: int64;
    price: int64;
    quantity: Quantity;
    show_qty: ShowQty;
    flags_replace_order_flags: FlagsReplaceOrderFlags;
};

type FlagsReplaceOrderFlags = unit {
    unused_replace_order_flags_0: bytes &size=1;
    post_only: bytes &size=1;
    post_only_reject: bytes &size=1;
    reserved_13: bytes &size=2;
};

type CancelOrderRequestMessage = unit {
    client_order_id: int64;
    correlation_id: int64;
    instrument_id: int64;
};

type CancelOrderByIdRequestMessage = unit {
    order_id: int64;
    correlation_id: int64;
    instrument_id: int64;
};

type MassQuoteRequestMessage = unit {
    quote_id: int64;
    correlation_id: int64;
    mmp_group_id: int64;
    self_match_prevention_id: int64;
    flags_mass_quote_flags: FlagsMassQuoteFlags;
    mass_quote_request_message_quotes_groups: MassQuoteRequestMessageQuotesGroups;
};

type FlagsMassQuoteFlags = unit {
    reset_mmp: bytes &size=1;
    reserved_7: bytes &size=1;
};

type MassQuoteRequestMessageQuotesGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    mass_quote_request_message_quotes_group: MassQuoteRequestMessageQuotesGroup[self.group_size_encoding.num_in_group];
};

type GroupSizeEncoding = unit {
    block_length: uint16;
    num_in_group: uint16;
};

type MassQuoteRequestMessageQuotesGroup = unit {
    instrument_id: int64;
    bid_price_optional: int64;
    ask_price_optional: int64;
    bid_qty: BidQty;
    ask_qty: AskQty;
    bid_flags: BidFlags;
    ask_flags: AskFlags;
};

type BidQty = unit {
    mantissa: int64;
    exponent: int8;
};

type AskQty = unit {
    mantissa: int64;
    exponent: int8;
};

type BidFlags = unit {
    cancel_on_disconnect: bytes &size=1;
    post_only: bytes &size=1;
    post_only_reject: bytes &size=1;
    market_limit: bytes &size=1;
    mmp: bytes &size=1;
    reset_mmp: bytes &size=1;
    reserved_10: bytes &size=2;
};

type AskFlags = unit {
    cancel_on_disconnect: bytes &size=1;
    post_only: bytes &size=1;
    post_only_reject: bytes &size=1;
    market_limit: bytes &size=1;
    mmp: bytes &size=1;
    reset_mmp: bytes &size=1;
    reserved_10: bytes &size=2;
};

type MassCancelRequestMessage = unit {
    correlation_id: int64;
    currency_pair_id: int64;
    instrument_id_optional: int64;
    product_type: int8 &convert=ProductType($$);
    side: int8 &convert=Side($$);
};

type MassQuoteCancelRequestMessage = unit {
    correlation_id: int64;
    mmp_group_id: int64;
    side: int8 &convert=Side($$);
};

type GetMassQuoteMmpStatusRequestMessage = unit {
    correlation_id: int64;
    mmp_group_id: int64;
};

type GetOrdersMmpStatusRequestMessage = unit {
    correlation_id: int64;
    currency_pair_id: int64;
};

type NewOrderResponseMessage = unit {
    timestamp: int64;
    exec_id: int64;
    client_order_id: int64;
    correlation_id: int64;
    order_id: int64;
    instrument_id: int64;
    price: int64;
    quantity: Quantity;
    total_filled: TotalFilled;
    visible_qty: VisibleQty;
    receive_time: int64;
    side: int8 &convert=Side($$);
    status: int8 &convert=Status($$);
    cancel_reason: int8 &convert=CancelReason($$);
    new_order_response_message_fills_groups: NewOrderResponseMessageFillsGroups;
    new_order_response_message_legs_groups: NewOrderResponseMessageLegsGroups;
};

type TotalFilled = unit {
    mantissa: int64;
    exponent: int8;
};

type VisibleQty = unit {
    mantissa: int64;
    exponent: int8;
};

type NewOrderResponseMessageFillsGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    new_order_response_message_fills_group: NewOrderResponseMessageFillsGroup[self.group_size_encoding.num_in_group];
};

type NewOrderResponseMessageFillsGroup = unit {
    match_id: int64;
    fill_price: int64;
    fill_qty: FillQty;
};

type FillQty = unit {
    mantissa: int64;
    exponent: int8;
};

type NewOrderResponseMessageLegsGroups = unit {
    group_size_encoding: GroupSizeEncoding;
    new_order_response_message_legs_group: NewOrderResponseMessageLegsGroup[self.group_size_encoding.num_in_group];
};

type NewOrderResponseMessageLegsGroup = unit {
    match_id: int64;
    fill_id: int64;
    fill_price: int64;
    fill_qty: FillQty;
    leg_side: int8 &convert=LegSide($$);
};

type NewOrderRejectMessage = unit {
    timestamp: int64;
