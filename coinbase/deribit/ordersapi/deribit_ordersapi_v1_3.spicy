    amend_order_response_message_legs_group: AmendOrderResponseMessageLegsGroup[self.group_size_encoding.num_in_group];
};

type AmendOrderResponseMessageLegsGroup = unit {
    match_id: int64;
    fill_id: int64;
    fill_price: int64;
    fill_qty: FillQty;
