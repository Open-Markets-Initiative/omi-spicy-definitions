module MoexSpectraOrderslogreplaySimbaV430Server;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type SpectraOrderslogreplayV430 = unit {
    server_frame: ServerFrame[] &eod;
};

type ServerFrame = unit {
    market_data_packet_header: MarketDataPacketHeader;
    switch ( self.market_data_packet_header.msg_flags.incremental_packet ) {
        0 -> server_session: ServerSession;
        1 -> server_replay: ServerReplay;
        * -> unknown: bytes &eod;
    };
};

type MarketDataPacketHeader = unit {
    msg_seq_num: uint32;
    msg_size: uint16;
    msg_flags: bitfield(16) {
        last_fragment: 0;
        start_of_snapshot: 1;
        end_of_snapshot: 2;
        incremental_packet: 3;
        poss_dup_flag: 4;
        reserved_bits: 5..15;
    } &byte-order=spicy::ByteOrder::Little;
    sending_time: uint64 &convert=time_ns($$);
};

type ServerSession = unit {
    sbe_header: SbeHeader;
    server_session_payload: LogoutMessage;
};

type SbeHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type LogoutMessage = unit {
    text: bytes &size=256;
};

type ServerReplay = unit {
    incremental_packet_header: IncrementalPacketHeader;
    server_replay_message: ServerReplayMessage[] &eod;
};

type IncrementalPacketHeader = unit {
    transact_time: uint64 &convert=time_ns($$);
    exchange_trading_session_id_optional: uint32;
};

type ServerReplayMessage = unit {
    sbe_header: SbeHeader;
    switch ( self.sbe_header.template_id ) {
        TemplateId::BestPricesMessage -> best_prices_message: BestPricesMessage;
        TemplateId::EmptyBookMessage -> empty_book_message: EmptyBookMessage;
        TemplateId::OrderUpdateMessage -> order_update_message: OrderUpdateMessage;
        TemplateId::OrderExecutionMessage -> order_execution_message: OrderExecutionMessage;
        * -> unknown: bytes &eod;
    };
};

type BestPricesMessage = unit {
    best_prices_message_no_md_entries_groups: BestPricesMessageNoMdEntriesGroups;
};

type BestPricesMessageNoMdEntriesGroups = unit {
    group_size: GroupSize;
    best_prices_message_no_md_entries_group: BestPricesMessageNoMdEntriesGroup[self.group_size.num_in_group_uint_8];
};

type GroupSize = unit {
    block_length: uint16;
    num_in_group_uint_8: uint8;
};

type BestPricesMessageNoMdEntriesGroup = unit {
    mkt_bid_px: int64;
    mkt_offer_px: int64;
    mkt_bid_size: int64;
    mkt_offer_size: int64;
    security_id: int32;
};

type EmptyBookMessage = unit {
    last_msg_seq_num_processed_optional: uint32;
};

type OrderUpdateMessage = unit {
    md_entry_id: int64;
    md_entry_px: int64;
    md_entry_size: int64;
    md_flags: bitfield(64) {
        day: 0;
        ioc: 1;
        non_quote: 2;
        unused_bits_3_to_11: 3..11;
        end_of_transaction: 12;
        due_to_cross_cancel: 13;
        second_leg: 14;
        unused_bits_15_to_18: 15..18;
        fok: 19;
        replace: 20;
        cancel: 21;
        mass_cancel: 22;
        unused_bits_23_to_25: 23..25;
        negotiated: 26;
        multi_leg: 27;
        unused_bit_28: 28;
        cross_trade: 29;
        unused_bit_30: 30;
        negotiated_match_by_ref: 31;
        cod: 32;
        unused_bits_33_to_40: 33..40;
        active_side: 41;
        passive_side: 42;
        unused_bits_43_to_44: 43..44;
        synthetic: 45;
        rfs: 46;
        unused_bits_47_to_56: 47..56;
        synthetic_passive: 57;
        unused_bits_58_to_59: 58..59;
        boc: 60;
        unused_bit_61: 61;
        during_discrete_auction: 62;
        unused_bit_63: 63;
    } &byte-order=spicy::ByteOrder::Little;
    md_flags_2: bitfield(64) {
        zero: 0;
        reserved_63: 1..63;
    } &byte-order=spicy::ByteOrder::Little;
    security_id: int32;
    rpt_seq: uint32;
    md_update_action: uint8 &convert=MdUpdateAction($$);
    md_entry_type: uint8 &convert=MdEntryType($$);
};

type OrderExecutionMessage = unit {
    md_entry_id: int64;
    md_entry_px_optional: int64;
    md_entry_size_optional: int64;
    last_px: int64;
    last_qty: int64;
    trade_id: int64;
    md_flags: bitfield(64) {
        day: 0;
        ioc: 1;
        non_quote: 2;
        unused_bits_3_to_11: 3..11;
        end_of_transaction: 12;
        due_to_cross_cancel: 13;
        second_leg: 14;
        unused_bits_15_to_18: 15..18;
        fok: 19;
        replace: 20;
        cancel: 21;
        mass_cancel: 22;
        unused_bits_23_to_25: 23..25;
        negotiated: 26;
        multi_leg: 27;
        unused_bit_28: 28;
        cross_trade: 29;
        unused_bit_30: 30;
        negotiated_match_by_ref: 31;
        cod: 32;
        unused_bits_33_to_40: 33..40;
        active_side: 41;
        passive_side: 42;
        unused_bits_43_to_44: 43..44;
        synthetic: 45;
        rfs: 46;
        unused_bits_47_to_56: 47..56;
        synthetic_passive: 57;
        unused_bits_58_to_59: 58..59;
        boc: 60;
        unused_bit_61: 61;
        during_discrete_auction: 62;
        unused_bit_63: 63;
    } &byte-order=spicy::ByteOrder::Little;
    md_flags_2: bitfield(64) {
        zero: 0;
        reserved_63: 1..63;
    } &byte-order=spicy::ByteOrder::Little;
    security_id: int32;
    rpt_seq: uint32;
    md_update_action: uint8 &convert=MdUpdateAction($$);
    md_entry_type: uint8 &convert=MdEntryType($$);
};

type LastFragment = enum {
    Fragment = 0,
    LastFragment_1 = 1,
};

type IncrementalPacket = enum {
    SnapshotPacket = 0,
    IncrementalPacket_1 = 1,
};

type PossDupFlag = enum {
    OnlineUpdates = 0,
    FullOrderBooks = 1,
};

type TemplateId = enum {
    HeartbeatMessage = 1,
    SequenceResetMessage = 2,
    BestPricesMessage = 14,
    EmptyBookMessage = 4,
    OrderUpdateMessage = 15,
    OrderExecutionMessage = 16,
    OrderBookSnapshotMessage = 17,
    SecurityDefinitionMessage = 18,
    SecurityStatusMessage = 9,
    SecurityDefinitionUpdateReportMessage = 10,
    TradingSessionStatusMessage = 11,
    DiscreteAuctionMessage = 13,
    SecurityMassStatusMessage = 19,
    LogonMessage = 1000,
    LogoutMessage = 1001,
    MarketDataRequestMessage = 1002,
    MarketDataDummyMessage = 1003,
};

type MdUpdateAction = enum {
    New = 0,
    Change = 1,
    Delete = 2,
};

type MdEntryType = enum {
    Bid = 0x30,
    Offer = 0x31,
    EmptyBook = 0x4a,
};

