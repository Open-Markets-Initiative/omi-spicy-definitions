module MoexSpectraOrderslogsnapshotSimbaV600;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type SpectraOrderslogsnapshotV600 = unit {
    market_data_packet_header: MarketDataPacketHeader;
    message: Message[] &eod;
};

type MarketDataPacketHeader = unit {
    msg_seq_num: uint32;
    msg_size: uint16;
    msg_flags: bitfield(16) {
        last_fragment: 0;
        start_of_snapshot: 1;
        end_of_snapshot: 2;
        incremental_packet: 3;
        poss_dup_flag: 4;
        reserved_bits: 5..15;
    } &byte-order=spicy::ByteOrder::Little;
    sending_time: uint64 &convert=time_ns($$);
};

type Message = unit {
    sbe_header: SbeHeader;
    switch ( self.sbe_header.template_id ) {
        TemplateId::SequenceResetMessage -> sequence_reset_message: SequenceResetMessage;
        TemplateId::OrderBookSnapshotMessage -> order_book_snapshot_message: OrderBookSnapshotMessage;
        * -> unknown: bytes &eod;
    };
};

type SbeHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type SequenceResetMessage = unit {
    new_seq_no: uint32;
};

type OrderBookSnapshotMessage = unit {
    security_id: int32;
    last_msg_seq_num_processed: uint32;
    rpt_seq: uint32;
    exchange_trading_session_id: uint32;
    order_book_snapshot_message_no_md_entries_groups: OrderBookSnapshotMessageNoMdEntriesGroups;
};

type OrderBookSnapshotMessageNoMdEntriesGroups = unit {
    group_size: GroupSize;
    order_book_snapshot_message_no_md_entries_group: OrderBookSnapshotMessageNoMdEntriesGroup[self.group_size.num_in_group_uint_8];
};

type GroupSize = unit {
    block_length: uint16;
    num_in_group_uint_8: uint8;
};

type OrderBookSnapshotMessageNoMdEntriesGroup = unit {
    md_entry_id_optional: int64;
    transact_time: uint64 &convert=time_ns($$);
    md_entry_px_optional: int64;
    md_entry_size_optional: int64;
    trade_id_optional: int64;
    md_flags: bitfield(64) {
        day: 0;
        ioc: 1;
        non_quote: 2;
        unused_bits_3_to_11: 3..11;
        end_of_transaction: 12;
        due_to_cross_cancel: 13;
        second_leg: 14;
        unused_bits_15_to_18: 15..18;
        fok: 19;
        replace: 20;
        cancel: 21;
        mass_cancel: 22;
        unused_bits_23_to_25: 23..25;
        negotiated: 26;
        multi_leg: 27;
        unused_bit_28: 28;
        cross_trade: 29;
        unused_bit_30: 30;
        negotiated_match_by_ref: 31;
        cod: 32;
        unused_bits_33_to_40: 33..40;
        active_side: 41;
        passive_side: 42;
        unused_bits_43_to_44: 43..44;
        synthetic: 45;
        rfs: 46;
        unused_bits_47_to_56: 47..56;
        synthetic_passive: 57;
        unused_bits_58_to_59: 58..59;
        boc: 60;
        unused_bit_61: 61;
        during_discrete_auction: 62;
        unused_bit_63: 63;
    } &byte-order=spicy::ByteOrder::Little;
    md_flags_2: bitfield(64) {
        zero: 0;
        reserved_63: 1..63;
    } &byte-order=spicy::ByteOrder::Little;
    md_entry_type: uint8 &convert=MdEntryType($$);
};

type LastFragment = enum {
    Fragment = 0,
    LastFragment_1 = 1,
};

type IncrementalPacket = enum {
    SnapshotPacket = 0,
    IncrementalPacket_1 = 1,
};

type PossDupFlag = enum {
    OnlineUpdates = 0,
    FullOrderBooks = 1,
};

type TemplateId = enum {
    HeartbeatMessage = 1,
    SequenceResetMessage = 2,
    BestPricesMessage = 14,
    EmptyBookMessage = 4,
    OrderUpdateMessage = 15,
    OrderExecutionMessage = 16,
    OrderBookSnapshotMessage = 17,
    SecurityDefinitionMessage = 21,
    SecurityStatusMessage = 9,
    SecurityDefinitionUpdateReportMessage = 10,
    TradingSessionStatusMessage = 23,
    DiscreteAuctionMessage = 24,
    SecurityMassStatusMessage = 19,
    SecurityGroupStatusMessage = 22,
    LogonMessage = 1000,
    LogoutMessage = 1001,
    MarketDataRequestMessage = 1002,
    MarketDataDummyMessage = 1003,
};

type MdEntryType = enum {
    Bid = 0x30,
    Offer = 0x31,
    EmptyBook = 0x4a,
};

