module MoexSpectraOrderslogsnapshotSimbaV104;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type SpectraOrderslogsnapshotV104 = unit {
    market_data_packet_header: MarketDataPacketHeader;
    message: Message[] &eod;
};

type MarketDataPacketHeader = unit {
    msg_seq_num: uint32;
    msg_size: uint16;
    msg_flags: bitfield(16) {
        last_fragment: 0;
        start_of_snapshot: 1;
        end_of_snapshot: 2;
        incremental_packet: 3;
        poss_dup_flag: 4;
        reserved_6_to_16: 5..15;
    } &byte-order=spicy::ByteOrder::Little;
    sending_time: uint64 &convert=time_ns($$);
};

type Message = unit {
    sbe_header: SbeHeader;
    switch ( self.sbe_header.template_id ) {
        TemplateId::SequenceResetMessage -> sequence_reset_message: SequenceResetMessage;
        TemplateId::OrderBookSnapshotMessage -> order_book_snapshot_message: OrderBookSnapshotMessage;
        * -> unknown: bytes &eod;
    };
};

type SbeHeader = unit {
    block_length: uint16;
    template_id: uint16 &convert=TemplateId($$);
    schema_id: uint16;
    version: uint16;
};

type SequenceResetMessage = unit {
    new_seq_no: uint32;
};

type OrderBookSnapshotMessage = unit {
    security_id: int32;
    last_msg_seq_num_processed: uint32;
    rpt_seq: uint32;
    exchange_trading_session_id: uint32;
    order_book_snapshot_message_no_md_entries_groups: OrderBookSnapshotMessageNoMdEntriesGroups;
};

type OrderBookSnapshotMessageNoMdEntriesGroups = unit {
    group_size: GroupSize;
    order_book_snapshot_message_no_md_entries_group: OrderBookSnapshotMessageNoMdEntriesGroup[self.group_size.num_in_group];
};

type GroupSize = unit {
    block_length: uint16;
    num_in_group: uint8;
};

type OrderBookSnapshotMessageNoMdEntriesGroup = unit {
    md_entry_id_optional: int64;
    transact_time: uint64 &convert=time_ns($$);
    md_entry_px_optional: int64;
    md_entry_size_optional: int64;
    trade_id_optional: int64;
    md_flags: bitfield(64) {
        day: 0;
        ioc: 1;
        non_quote: 2;
        unused_bits_4_to_12: 3..11;
        end_of_transaction: 12;
        unused_bit_14: 13;
        second_leg: 14;
        unused_bits_16_to_19: 15..18;
        fok: 19;
        replace: 20;
        cancel: 21;
        mass_cancel: 22;
        unused_bits_24_to_26: 23..25;
        negotiated: 26;
        multi_leg: 27;
        unused_bit_29: 28;
        cross_trade: 29;
        unused_bits_31_to_32: 30..31;
        cod: 32;
        unused_bits_34_to_41: 33..40;
        active_side: 41;
        passive_side: 42;
        unused_bits_44_to_45: 43..44;
        synthetic: 45;
        rfs: 46;
        reserved_48_to_64: 47..63;
    } &byte-order=spicy::ByteOrder::Little;
    md_entry_type: uint8 &convert=MdEntryType($$);
};

type LastFragment = enum {
    Fragment = 0,
    LastFragment_1 = 1,
};

type IncrementalPacket = enum {
    SnapshotPacket = 0,
    IncrementalPacket_1 = 1,
};

type PossDupFlag = enum {
    OnlineUpdates = 0,
    FullOrderBooks = 1,
};

type TemplateId = enum {
    HeartbeatMessage = 1,
    SequenceResetMessage = 2,
    BestPricesMessage = 3,
    EmptyBookMessage = 4,
    OrderUpdateMessage = 5,
    OrderExecutionMessage = 6,
    OrderBookSnapshotMessage = 7,
    SecurityDefinitionMessage = 8,
    SecurityStatusMessage = 9,
    SecurityDefinitionUpdateReportMessage = 10,
    TradingSessionStatusMessage = 11,
    LogonMessage = 1000,
    LogoutMessage = 1001,
    MarketDataRequestMessage = 1002,
    MarketDataDummyMessage = 1003,
};

type MdEntryType = enum {
    Bid = 0x30,
    Offer = 0x31,
    EmptyBook = 0x4a,
};

