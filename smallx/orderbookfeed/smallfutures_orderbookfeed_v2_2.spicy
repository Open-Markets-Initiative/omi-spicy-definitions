        instrument_begin: 2;
        instrument_end: 3;
        book_begin: 4;
        book_end: 5;
        book_reset: 6;
        reserved_9: 7..15;
    } &byte-order=spicy::ByteOrder::Little;
    instrument_update_action: uint8 &convert=InstrumentUpdateAction($$);
    spread_symbol: bytes &size=120;
    description: bytes &size=120;
    instrument_type: uint8 &convert=InstrumentType($$);
    maturity_date: uint16;
    first_trading_session_date: uint16;
    last_trading_session_date: uint16;
    expiration_date: uint16;
    cfi_code: bytes &size=6;
    currency: bytes &size=3;
    price_increment: int64;
    price_multiplier: int64;
    strategy_type: uint8 &convert=StrategyType($$);
    legs_groups: LegsGroups;
};

type LegsGroups = unit {
    group_dimension: GroupDimension;
    legs_group: LegsGroup[self.group_dimension.num_in_group];
};

type LegsGroup = unit {
    leg_instrument_id: int32;
    leg_symbol: bytes &size=25;
    leg_product: bytes &size=8;
    leg_ratio_quantity: int64;
    leg_side: uint8 &convert=LegSide($$);
};

