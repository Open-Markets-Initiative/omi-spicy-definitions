type TemplateId = enum {
    InstrumentTradingStatusIncrementalMessage = 3,
    TradesIncrementalMessage = 4,
    TradeCorrectMessage = 5,
    TradeBustMessage = 6,
    OrderBookIncrementalMessage = 7,
    MarketSummaryIncrementalMessage = 8,
    OrderBookSnapshotMessage = 11,
    MarketSummarySnapshotMessage = 12,
    IndexValueSnapshotMessage = 13,
    SingleInstrumentDefinitionIncrementalV2Message = 14,
    MultilegDefinitionIncrementalV2Message = 15,
    SingleInstrumentDefinitionSnapshotV2Message = 16,
    MultilegDefinitionSnapshotV2Message = 17,
};

type InstrumentTradingStatus = enum {
    Closed = 0x43,
    PreOpen = 0x50,
    PreOpenNc = 0x4e,
    Open = 0x4f,
    Paused = 0x55,
    Halted = 0x48,
};

type AggressorSide = enum {
    NoAggressor = 0x4e,
    Buy = 0x42,
    Sell = 0x53,
};

type TradeUpdateAction = enum {
    New = 0x4e,
    Delete = 0x44,
};

type OrderUpdateAction = enum {
    New = 0x4e,
    Update = 0x55,
    Delete = 0x44,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type OpenPriceType = enum {
    Indicative = 0x49,
    Traded = 0x54,
    NoPrice = 0x4e,
};

type SettlementPriceType = enum {
    Final = 0x46,
    Preliminary = 0x50,
    NoPrice = 0x4e,
};

type InstrumentUpdateAction = enum {
    Add = 0x41,
    Delete = 0x44,
    Modify = 0x4d,
};

type InstrumentType = enum {
    Futures = 0x46,
    Option = 0x4f,
    Mleg = 0x4d,
};

type PutOrCall = enum {
    Put = 0x50,
    Call = 0x43,
    NotOption = 0x4e,
};

type ExpirationStyle = enum {
    Standard = 0x53,
    Daily = 0x44,
    Weekly = 0x57,
    Quaterly = 0x51,
};

type ExerciseStyle = enum {
    European = 0x45,
    American = 0x41,
    NotOption = 0x4e,
};

type Delivery = enum {
    Cash = 0x43,
    Physical = 0x50,
};

type StrategyType = enum {
    Custom = 0,
    FuturesCalendar = 1,
    FuturesInterCommodity = 2,
    Covered = 3,
    OptionButterfly = 4,
    OptionVertical = 5,
    OptionStrangle = 6,
    OptionStraddle = 7,
    OptionDiagonal = 8,
    OptionCalendar = 9,
    OptionIronCondor = 10,
    ProtectivePut = 11,
};

type LegSide = enum {
    Buy = 0x42,
    Sell = 0x53,
};

