module BmeBmeequitiesTopofbookBmegateV16;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type BmeequitiesTopofbookV16 = unit {
    message: Message[] &eod;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::LogonResponseMessage -> logon_response_message: LogonResponseMessage;
        MessageType::LogoutResponseMessage -> logout_response_message: LogoutResponseMessage;
        MessageType::HeartbeatMessage -> heartbeat_message: HeartbeatMessage;
        MessageType::NetworkStatusMessage -> network_status_message: NetworkStatusMessage;
        MessageType::TradingSessionStatusMessage -> trading_session_status_message: TradingSessionStatusMessage;
        MessageType::NewsMessage -> news_message: NewsMessage;
        MessageType::SecurityListCancellationReportMessage -> security_list_cancellation_report_message: SecurityListCancellationReportMessage;
        MessageType::StatisticsMessage -> statistics_message: StatisticsMessage;
        MessageType::SecurityListMessage -> security_list_message: SecurityListMessage;
        MessageType::SecurityListUpdateReportMessage -> security_list_update_report_message: SecurityListUpdateReportMessage;
        MessageType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MessageType::TradeMarketPostTransparencyInformationTopOfBookMessage -> trade_market_post_transparency_information_top_of_book_message: TradeMarketPostTransparencyInformationTopOfBookMessage;
        MessageType::TradeTradeAmendmentOrCancellationMessage -> trade_trade_amendment_or_cancellation_message: TradeTradeAmendmentOrCancellationMessage;
        MessageType::TopOfBookMessage -> top_of_book_message: TopOfBookMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type LogonResponseMessage = unit {
    sequence_number: uint32;
    heart_bt_int: uint8;
    protocol_version: bytes &size=6;
    test_production_ind: uint8 &convert=TestProductionInd($$);
    environment_code: bytes &size=2;
    session_date: int32;
    expected_sequence_number: uint32;
    sequence_number_to: uint32;
};

type LogoutResponseMessage = unit {
    sequence_number: uint32;
    logout_reason: uint8 &convert=LogoutReason($$);
};

type HeartbeatMessage = unit {
    sequence_number: uint32;
};

type NetworkStatusMessage = unit {
    sequence_number: uint32;
    network_status_value: uint8 &convert=NetworkStatusValue($$);
};

type TradingSessionStatusMessage = unit {
    sequence_number: uint32;
    trading_session_id: uint8 &convert=TradingSessionId($$);
    trading_session_sub_id: uint8 &convert=TradingSessionSubId($$);
    trad_ses_status: uint8 &convert=TradSesStatus($$);
    transaction_date_and_time: int64;
};

type NewsMessage = unit {
    sequence_number: uint32;
    news_text: bytes &size=78;
};

type SecurityListCancellationReportMessage = unit {
    sequence_number: uint32;
    market_id: bytes &size=4;
    market_segment_id: bytes &size=4;
    security_code: uint32;
    symbol: bytes &size=22;
    symbol_isin: bytes &size=12;
};

type StatisticsMessage = unit {
    sequence_number: uint32;
    security_code: uint32;
    transaction_date_and_time: int64;
    data_count: uint8;
    statistics_repeating_group: StatisticsRepeatingGroup[self.data_count];
};

type StatisticsRepeatingGroup = unit {
    data_code: uint8 &convert=DataCode($$);
    data_value: int64;
};

