module BmeBmeequitiesMarketandorderBmegateV16;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type BmeequitiesMarketandorderV16 = unit {
    message: Message[] &eod;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::LogonResponseMessage -> logon_response_message: LogonResponseMessage;
        MessageType::LogoutResponseMessage -> logout_response_message: LogoutResponseMessage;
        MessageType::HeartbeatMessage -> heartbeat_message: HeartbeatMessage;
        MessageType::NetworkStatusMessage -> network_status_message: NetworkStatusMessage;
        MessageType::LogonMessage -> logon_message: LogonMessage;
        MessageType::RejectMessage -> reject_message: RejectMessage;
        MessageType::TradingSessionStatusMessage -> trading_session_status_message: TradingSessionStatusMessage;
        MessageType::NewsMessage -> news_message: NewsMessage;
        MessageType::SecurityListCancellationReportMessage -> security_list_cancellation_report_message: SecurityListCancellationReportMessage;
        MessageType::StatisticsMessage -> statistics_message: StatisticsMessage;
        MessageType::SecurityListMessage -> security_list_message: SecurityListMessage;
        MessageType::SecurityListUpdateReportMessage -> security_list_update_report_message: SecurityListUpdateReportMessage;
        MessageType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MessageType::OrderBookClearMessage -> order_book_clear_message: OrderBookClearMessage;
        MessageType::OrderMarketPreTransparencyInformationMessage -> order_market_pre_transparency_information_message: OrderMarketPreTransparencyInformationMessage;
        MessageType::QuoteMarketPreTransparencyInformationMessage -> quote_market_pre_transparency_information_message: QuoteMarketPreTransparencyInformationMessage;
        MessageType::OrderCancellationMarketMemberMessage -> order_cancellation_market_member_message: OrderCancellationMarketMemberMessage;
        MessageType::QuoteCancellationMarketMemberMessage -> quote_cancellation_market_member_message: QuoteCancellationMarketMemberMessage;
        MessageType::TradeMarketPostTransparencyInformationTopofbookMessage -> trade_market_post_transparency_information_topofbook_message: TradeMarketPostTransparencyInformationTopofbookMessage;
        MessageType::TradeTradeAmendmentOrCancellationMessage -> trade_trade_amendment_or_cancellation_message: TradeTradeAmendmentOrCancellationMessage;
        MessageType::TradeMarketPostTransparencyInformationFullDepthMessage -> trade_market_post_transparency_information_full_depth_message: TradeMarketPostTransparencyInformationFullDepthMessage;
        MessageType::TopofbookMessage -> topofbook_message: TopofbookMessage;
        MessageType::OrderAndQuoteClientDataMessage -> order_and_quote_client_data_message: OrderAndQuoteClientDataMessage;
        MessageType::SimpleNewOrderMessage -> simple_new_order_message: SimpleNewOrderMessage;
        MessageType::SimpleNewOrderWithClientDataMessage -> simple_new_order_with_client_data_message: SimpleNewOrderWithClientDataMessage;
        MessageType::SimpleOrderModificationMessage -> simple_order_modification_message: SimpleOrderModificationMessage;
        MessageType::SimpleOrderModificationWithClientDataMessage -> simple_order_modification_with_client_data_message: SimpleOrderModificationWithClientDataMessage;
        MessageType::OrderCancellationRequestMessage -> order_cancellation_request_message: OrderCancellationRequestMessage;
        MessageType::NewQuoteMessage -> new_quote_message: NewQuoteMessage;
        MessageType::QuoteModificationRequestMessage -> quote_modification_request_message: QuoteModificationRequestMessage;
        MessageType::QuoteCancellationRequestMessage -> quote_cancellation_request_message: QuoteCancellationRequestMessage;
        MessageType::MassOrderquoteCancellationMessage -> mass_orderquote_cancellation_message: MassOrderquoteCancellationMessage;
        MessageType::OrderAndQuoteClientDataParametersAckNackMessage -> order_and_quote_client_data_parameters_ack_nack_message: OrderAndQuoteClientDataParametersAckNackMessage;
        MessageType::SimpleOrderStatusMessage -> simple_order_status_message: SimpleOrderStatusMessage;
        MessageType::QuoteStatusMessage -> quote_status_message: QuoteStatusMessage;
        MessageType::OrderCancelRejectMessage -> order_cancel_reject_message: OrderCancelRejectMessage;
        MessageType::MassOrderquoteCancellationCompletionMessage -> mass_orderquote_cancellation_completion_message: MassOrderquoteCancellationCompletionMessage;
        MessageType::MassOrderquoteCancellationRejectMessage -> mass_orderquote_cancellation_reject_message: MassOrderquoteCancellationRejectMessage;
        MessageType::BusinessMessageRejectMessage -> business_message_reject_message: BusinessMessageRejectMessage;
        MessageType::ExecutionPrivateInformation2LegsMessage -> execution_private_information_2_legs_message: ExecutionPrivateInformation2LegsMessage;
        MessageType::TradeTradeAmendmentOrCancellation1LegBuyPrivateInformationMessage -> trade_trade_amendment_or_cancellation_1_leg_buy_private_information_message: TradeTradeAmendmentOrCancellation1LegBuyPrivateInformationMessage;
        MessageType::TradeTradeAmendmentOrCancellation1LegSellPrivateInformationMessage -> trade_trade_amendment_or_cancellation_1_leg_sell_private_information_message: TradeTradeAmendmentOrCancellation1LegSellPrivateInformationMessage;
        MessageType::TradeTradeAmendmentOrCancellation2LegsPrivateInformationMessage -> trade_trade_amendment_or_cancellation_2_legs_private_information_message: TradeTradeAmendmentOrCancellation2LegsPrivateInformationMessage;
        MessageType::ExecutionPrivateInformation1LegBuyMarketOrderMessage -> execution_private_information_1_leg_buy_market_order_message: ExecutionPrivateInformation1LegBuyMarketOrderMessage;
        MessageType::ExecutionPrivateInformation1LegSellMarketOrderMessage -> execution_private_information_1_leg_sell_market_order_message: ExecutionPrivateInformation1LegSellMarketOrderMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_size: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type LogonResponseMessage = unit {
    sequence_number: uint32;
    heart_bt_int: uint8;
    protocol_version: bytes &size=6;
    test_production_ind: bytes &size=1;
    environment_code: bytes &size=2;
    session_date: int32;
