    last_trading_day: int32;
    number_of_decimals: uint8;
    order_number_of_decimals: uint8;
    adjustments_rule: uint8 &convert=AdjustmentsRule($$);
    maximum_order_size: int64;
    self_match_prevention: uint8 &convert=SelfMatchPrevention($$);
    commodity_derivative_indicator: uint8 &convert=CommodityDerivativeIndicator($$);
    stock_when_underlying_is_dividend: bytes &size=22;
    base_product: bytes &size=4;
    sub_product: bytes &size=4;
    further_sub_product: bytes &size=4;
    base_currency: bytes &size=3;
    quoted_currency: bytes &size=3;
    maturity_month_year_increment_units: uint8 &convert=MaturityMonthYearIncrementUnits($$);
    start_maturity_month_year: bytes &size=8;
    end_maturity_month_year: bytes &size=8;
    maturity_month_year_increment: uint8;
    underlying_symbol: bytes &size=22;
    underlying_isin: bytes &size=12;
    underlying_currency: bytes &size=3;
    underlying_security_issuer_lei: bytes &size=20;
    x_rolling_closing_type: uint8 &convert=XRollingClosingType($$);
    x_rolling_reference_buyer_rate: uint8 &convert=XRollingReferenceBuyerRate($$);
    x_rolling_buyer_markup: int64;
    x_rolling_reference_seller_rate: uint8 &convert=XRollingReferenceSellerRate($$);
    x_rolling_seller_markup: int64;
    x_rolling_dividend_percentage: int64;
    x_rolling_dividend_pay_date_diff: uint16;
    leg_symbol_1: bytes &size=22;
    leg_ratio_qty_1: uint32;
    leg_side_1: uint8 &convert=LegSide1($$);
    leg_price_1: int64;
    leg_symbol_2: bytes &size=22;
    leg_ratio_qty_2: uint32;
    leg_side_2: uint8 &convert=LegSide2($$);
    leg_price_2: int64;
    leg_symbol_3: bytes &size=22;
    leg_ratio_qty_3: uint32;
    leg_side_3: uint8 &convert=LegSide3($$);
    leg_price_3: int64;
    leg_symbol_4: bytes &size=22;
    leg_ratio_qty_4: uint32;
    leg_side_4: uint8 &convert=LegSide4($$);
    leg_price_4: int64;
    leg_symbol_5: bytes &size=22;
    leg_ratio_qty_5: uint32;
    leg_side_5: uint8 &convert=LegSide5($$);
    leg_price_5: int64;
};

