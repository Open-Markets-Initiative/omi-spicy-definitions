    admission_requested_by_issuer: uint8 &convert=AdmissionRequestedByIssuer($$);
    min_trade_vol: uint32;
    round_lot: uint32;
    currency: bytes &size=3;
    modality_mask_b_4: uint32;
    security_description: bytes &size=80;
    trading_obligation: uint8 &convert=TradingObligation($$);
    sec_description: bytes &size=20;
    underlying_asset: bytes &size=22;
