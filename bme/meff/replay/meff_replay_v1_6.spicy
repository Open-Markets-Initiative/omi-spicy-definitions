type MessageType = enum {
    LogonResponseMessage = 0x08,
    LogoutResponseMessage = 0x0b,
    HeartbeatMessage = 0x30,
    NetworkStatusMessage = 0x0a,
    LogonMessage = 0x41,
    LogoutMessage = 0x35,
    RejectMessage = 0x0d,
    ReplayRequestMessage = 0x09,
    ReplayRequestAckNackMessage = 0x0c,
    TradingSessionStatusMessage = 0x68,
    NewsMessage = 0x42,
    SecurityListCancellationReportMessage = 0x78,
    StatisticsMessage = 0x84,
    SecurityListMessage = 0x79,
    SecurityListUpdateReportMessage = 0x80,
    SecurityStatusMessage = 0x66,
    FamilyStatusMessage = 0x89,
    OrderBookClearMessage = 0x81,
    OrderMarketPreTransparencyInformationMessage = 0x03,
    QuoteMarketPreTransparencyInformationMessage = 0x07,
    OrderCancellationMarketMemberMessage = 0x01,
    QuoteCancellationMarketMemberMessage = 0x05,
    TradeMarketPostTransparencyInformationTopofbookMessage = 0x10,
    TradeTradeAmendmentOrCancellationMessage = 0x18,
    TradeMarketPostTransparencyInformationFullDepthMessage = 0x11,
    IndicationOfInterestMessage = 0x36,
    RfqMarketPreTransparencyInformationMessage = 0x85,
    TopofbookMessage = 0x82,
};

type LogoutReason = enum {
    TerminationAfterASolicitedLogoutRequest = 0,
    EndOfSessionTerminationInRecoveryServerEndOfRecoverySnapshot = 1,
    TimeoutConnectionLost = 2,
    LackOfHeartbeat = 3,
    InvalidUsernameOrPassword = 16,
    InvalidExpectedSequenceNumber = 17,
    InvalidProtocolVersion = 18,
    NewConnectionFromUser = 19,
};

type NetworkStatusValue = enum {
    Connected = 1,
    NotConnectedDownExpectedUp = 2,
    NotConnectedDownExpectedDown = 3,
    InProcess = 4,
};

type SessionRejectReason = enum {
    InvalidMsgType = 11,
    WrongMessageSize = 30,
    ThrottleLimitExceeded = 31,
    InvalidClientSessionStatus = 33,
    Other = 99,
};

type Status = enum {
    False_0 = 0,
    True_1 = 1,
    Undefined = 255,
};

type TradingSessionId = enum {
    ContinuousTrading = 100,
    BlockTrades = 102,
    NormalHours = 105,
    DeltaAndBasisTrade = 106,
    BonoHours = 107,
    CrossTradesNormalHours = 108,
    CrossTradesBonoHours = 109,
    RfqIbexFuturesHours = 115,
    RfqNormalHours = 116,
    RfqBonoHours = 117,
    XRollingOnStocks = 118,
};

type TradingSessionSubId = enum {
    PreTradingNotStarted = 1,
    ScheduledOpeningAuction = 2,
    ContinuousTrading = 3,
    ScheduledClosingAuction = 4,
    PostTrading = 5,
    ScheduledIntradayAuction = 6,
    UnscheduledIntradayAuction = 9,
    NotStarted = 202,
    Open = 203,
    Closed = 204,
};

type TradSesStatus = enum {
    Halted = 1,
    Open = 2,
    Closed = 3,
    PreOpenNotStarted = 4,
    PreClose = 5,
    RequestRejected = 6,
};

type SecurityGroup = enum {
    Bono10 = 2,
    IbexMicro = 19,
    MiniIbex = 20,
    Ibex = 21,
    Bbva = 23,
    Endesa = 25,
    Iberdrola = 27,
