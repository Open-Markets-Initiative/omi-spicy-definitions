type MessageType = enum {
    StartOfDay = 0,
    StartOfDayAcknowledgement = 1,
    CircuitAssurance = 2,
    CircuitResponse = 3,
    RestartRequest = 4,
    RestartAccepted = 5,
    EndOfTrading = 8,
    ClientSignon = 9,
    ClientSignonAcknowledgment = 10,
    Trade = 30,
    TradeCancel = 31,
    Allocation = 40,
    AllocationCancel = 41,
    NewAllocation = 42,
    ModifyAllocation = 43,
    DeleteAllocation = 44,
    GiveUp = 50,
    GiveUpCancel = 51,
    NewGiveUp = 52,
    ModifyGiveUp = 53,
    DeleteGiveUp = 54,
    AcknowledgementMessage = 98,
    ErrorMessage = 99,
};

type MessageFlag = enum {
    RetransmittedMessage = 0x52,
    DuplicatedMessage = 0x44,
};

type AccountType = enum {
    PublicCustomer = 0x36,
    BrokerDealer = 0x37,
    MarketMaker = 0x38,
    ProfessionalCustomer = 0x54,
    FloorBrokerCustomer = 0x56,
    BrokerDealerClearedAsCustomer = 0x57,
