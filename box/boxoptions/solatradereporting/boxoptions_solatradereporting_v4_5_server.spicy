    opposite_account_type: uint8 &convert=OppositeAccountType($$);
    participant_session_name: bytes &size=12;
    unique_transaction_id: bytes &size=10;
    parent_transaction_id: bytes &size=10;
    opposite_executing_broker: bytes &size=4;
    additional_client_memo: bytes &size=16;
};

