module BoxBoxoptionsSolatradereportingAtrV45Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type BoxoptionsSolatradereportingV45 = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::ClientSignonAcknowledgment -> client_signon_acknowledgment: ClientSignonAcknowledgment;
        MessageType::Trade -> trade: Trade;
        MessageType::TradeCancel -> trade_cancel: TradeCancel;
        MessageType::Allocation -> allocation: Allocation;
        MessageType::AllocationCancel -> allocation_cancel: AllocationCancel;
        MessageType::GiveUp -> give_up: GiveUp;
        MessageType::GiveUpCancel -> give_up_cancel: GiveUpCancel;
        MessageType::ErrorMessage -> error_message: ErrorMessage;
        * -> unknown: bytes &eod;
    };
    end_of_text: uint8;
};

type MessageHeader = unit {
    source: bytes &size=4;
    destination: bytes &size=4;
    message_type: bytes &size=2;
    message_flag: uint8 &convert=MessageFlag($$);
    control_byte: bytes &size=1;
    sequence_number: bytes &size=8;
    acknowledgement_sequence_number: bytes &size=8;
};

type ClientSignonAcknowledgment = unit {
    last_user_sequence_number: bytes &size=8;
};

type Trade = unit {
    trade_number: bytes &size=15;
    transaction_type: uint8 &convert=TransactionType($$);
    timestamp: bytes &size=6;
    symbol: bytes &size=30;
    expiration_date: bytes &size=6;
    strike_price: bytes &size=8;
    strike_price_fraction_indicator: bytes &size=1;
    option_type: uint8 &convert=OptionType($$);
    volume: bytes &size=8;
    price_x_10000: bytes &size=8;
    cmta_broker: bytes &size=4;
    account_type: uint8 &convert=AccountType($$);
    subtrader_id: bytes &size=3;
    open_close: uint8 &convert=OpenClose($$);
    executing_broker: bytes &size=4;
    client_account_number: bytes &size=12;
    client_order_id: bytes &size=20;
    client_memo: bytes &size=16;
    liquidity_status: uint8 &convert=LiquidityStatus($$);
    trade_type: uint8 &convert=TradeType($$);
    opposite_account_type: uint8 &convert=OppositeAccountType($$);
    participant_session_name: bytes &size=12;
    unique_transaction_id: bytes &size=10;
    parent_transaction_id: bytes &size=10;
    opposite_executing_broker: bytes &size=4;
    additional_client_memo: bytes &size=16;
};

type TradeCancel = unit {
    trade_number: bytes &size=15;
    transaction_type: uint8 &convert=TransactionType($$);
    timestamp: bytes &size=6;
    symbol: bytes &size=30;
    expiration_date: bytes &size=6;
    strike_price: bytes &size=8;
    strike_price_fraction_indicator: bytes &size=1;
    option_type: uint8 &convert=OptionType($$);
