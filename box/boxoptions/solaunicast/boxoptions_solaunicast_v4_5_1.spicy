    Positive = 0x2b,
    Negative = 0x2d,
};

type PriceIndicatorMarker = enum {
    AsOfTrade = 0x41,
    TradesPerformedAtTheEndOfAPipAllocationPhase = 0x43,
    LateTrade = 0x4c,
    TradesPerformedDuringTheOpening = 0x4f,
    ReferencePrice = 0x53,
