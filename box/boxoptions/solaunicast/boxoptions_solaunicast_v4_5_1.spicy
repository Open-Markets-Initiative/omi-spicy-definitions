type MessageType = enum {
    EndOfTransmissionMessage = 0x55,
    CircuitAssuranceMessage = 0x56,
    GapSequenceMessage = 0x57,
    SystemTimestampMessage = 0x5a,
    OptionTradeMessage = 0x43,
    OptionRequestForQuoteMessage = 0x44,
    OptionQuoteMessage = 0x46,
    OptionMarketDepthMessage = 0x48,
    OptionTradeCancellationMessage = 0x49,
    OptionInstrumentKeysMessage = 0x4a,
    OptionSummaryMessage = 0x4e,
    BeginningOfOptionsSummaryMessage = 0x51,
    BulletinsMessage = 0x4c,
    EndOfSalesMessage = 0x53,
    OptionImprovementProcessBeginningMessage = 0x4d,
    MarketSheetInitialAndImprovementOrderMessage = 0x4f,
    InitialAndImprovementOrderMessage = 0x54,
};

type TypeOfMarketData = enum {
    MarketDepthMessagesOnTheTop5BidsasksForTheTypeOfTradingInstrumentsChosen = 0x59,
    Best = 0x4e,
    Trade = 0x54,
    PriceImprovementAndExposedOrderMessages = 0x50,
    MarketDepthMessagesOnTheTop5AndTheCalculatedImpliedBestLimit = 0x49,
    QuoteMessageOnTheFirstLevelAndTheCalculatedImpliedBestLimit = 0x47,
