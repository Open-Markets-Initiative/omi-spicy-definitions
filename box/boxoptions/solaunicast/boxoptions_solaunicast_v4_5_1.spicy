module BoxBoxoptionsSolaunicastHsvfV451;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type BoxoptionsSolaunicastV451 = unit {
    hsvf_stx: uint8;
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::ConnectionMessage -> connection_message: ConnectionMessage;
        MessageType::EndOfTransmissionMessage -> end_of_transmission_message: EndOfTransmissionMessage;
        MessageType::CircuitAssuranceMessage -> circuit_assurance_message: CircuitAssuranceMessage;
        MessageType::GapSequenceMessage -> gap_sequence_message: GapSequenceMessage;
        MessageType::SystemTimestampMessage -> system_timestamp_message: SystemTimestampMessage;
        MessageType::OptionTradeMessage -> option_trade_message: OptionTradeMessage;
        MessageType::ComplexOrderInstrumentTradeMessage -> complex_order_instrument_trade_message: ComplexOrderInstrumentTradeMessage;
        MessageType::OptionRequestForQuoteMessage -> option_request_for_quote_message: OptionRequestForQuoteMessage;
        MessageType::OptionQuoteMessage -> option_quote_message: OptionQuoteMessage;
        MessageType::ComplexOrderQuoteMessage -> complex_order_quote_message: ComplexOrderQuoteMessage;
        MessageType::OptionMarketDepthMessage -> option_market_depth_message: OptionMarketDepthMessage;
        MessageType::ComplexOrderMarketDepthMessage -> complex_order_market_depth_message: ComplexOrderMarketDepthMessage;
        MessageType::OptionTradeCancellationMessage -> option_trade_cancellation_message: OptionTradeCancellationMessage;
        MessageType::ComplexOrderTradeCancellationMessage -> complex_order_trade_cancellation_message: ComplexOrderTradeCancellationMessage;
        MessageType::OptionInstrumentKeysMessage -> option_instrument_keys_message: OptionInstrumentKeysMessage;
        MessageType::ComplexOrderInstrumentKeysMessage -> complex_order_instrument_keys_message: ComplexOrderInstrumentKeysMessage;
        MessageType::OptionSummaryMessage -> option_summary_message: OptionSummaryMessage;
        MessageType::ComplexOrderSummaryMessage -> complex_order_summary_message: ComplexOrderSummaryMessage;
        MessageType::BeginningOfOptionsSummaryMessage -> beginning_of_options_summary_message: BeginningOfOptionsSummaryMessage;
        MessageType::BeginningOfComplexOrderSummaryMessage -> beginning_of_complex_order_summary_message: BeginningOfComplexOrderSummaryMessage;
        MessageType::GroupOpeningTimeMessage -> group_opening_time_message: GroupOpeningTimeMessage;
        MessageType::GroupStatusMessage -> group_status_message: GroupStatusMessage;
        MessageType::ComplexOrderGroupStatusMessage -> complex_order_group_status_message: ComplexOrderGroupStatusMessage;
        MessageType::BulletinsMessage -> bulletins_message: BulletinsMessage;
        MessageType::EndOfSalesMessage -> end_of_sales_message: EndOfSalesMessage;
        MessageType::OptionImprovementProcessBeginningMessage -> option_improvement_process_beginning_message: OptionImprovementProcessBeginningMessage;
        MessageType::ComplexOrderImprovementProcessBeginningMessageMessage -> complex_order_improvement_process_beginning_message_message: ComplexOrderImprovementProcessBeginningMessageMessage;
        MessageType::MarketSheetInitialAndImprovementOrderMessage -> market_sheet_initial_and_improvement_order_message: MarketSheetInitialAndImprovementOrderMessage;
        MessageType::ComplexOrderMarketSheetInitialAndImprovementOrderMessage -> complex_order_market_sheet_initial_and_improvement_order_message: ComplexOrderMarketSheetInitialAndImprovementOrderMessage;
        MessageType::InitialAndImprovementOrderMessage -> initial_and_improvement_order_message: InitialAndImprovementOrderMessage;
        MessageType::ComplexOrderInitialAndImprovementOrderMessage -> complex_order_initial_and_improvement_order_message: ComplexOrderInitialAndImprovementOrderMessage;
        * -> unknown: bytes &eod;
    };
    hsvf_etx: uint8;
};

type MessageHeader = unit {
    sequence_number: bytes &size=9;
    message_type: bytes &size=2;
};

type ConnectionMessage = unit {
    reset_sequence: bytes &size=10;
    system_default: bytes &size=1;
    system_value: bytes &size=1;
    type_of_market_data: uint8 &convert=TypeOfMarketData($$);
    complex_order: bytes &size=1;
    market_summaries: uint8 &convert=MarketSummaries($$);
    gap_control: uint8 &convert=GapControl($$);
    hsvf_protocol: bytes &size=2;
    number_of_option_classes_requested: bytes &size=3;
    option_classes_requested: OptionClassesRequested[self.number_of_option_classes_requested];
};

type OptionClassesRequested = unit {
    root_symbol: bytes &size=6;
};

type EndOfTransmissionMessage = unit {
    exchange_id: bytes &size=1;
    time_field: bytes &size=6;
};

type CircuitAssuranceMessage = unit {
    time_field: bytes &size=6;
};

type GapSequenceMessage = unit {
    sequence_numbers_skipped: bytes &size=9;
};

type SystemTimestampMessage = unit {
    trading_engine_timestamp: bytes &size=9;
};

type OptionTradeMessage = unit {
    exchange_id: bytes &size=1;
    instrument_description: InstrumentDescription;
    volume: bytes &size=8;
    trade_price: bytes &size=6;
    trade_price_fraction_indicator: bytes &size=1;
    net_change_sign: uint8 &convert=NetChangeSign($$);
    net_change: bytes &size=6;
    net_change_fraction_indicator: bytes &size=1;
    : skip bytes &size=6;   # padding
    timestamp: bytes &size=6;
    open_interest: bytes &size=7;
    : skip bytes &size=1;   # padding
    price_indicator_marker: uint8 &convert=PriceIndicatorMarker($$);
};

type InstrumentDescription = unit {
    root_symbol: bytes &size=6;
    expiry_month_code: uint8 &convert=ExpiryMonthCode($$);
    : skip bytes &size=1;   # padding
    strike_price: bytes &size=7;
    strike_price_fraction_indicator: bytes &size=1;
    expiry_year: bytes &size=2;
    expiry_day: bytes &size=2;
};

type ComplexOrderInstrumentTradeMessage = unit {
    exchange_id: bytes &size=1;
    complex_order_instrument_symbol: bytes &size=30;
    volume: bytes &size=8;
    trade_price_sign: bytes &size=1;
    trade_price: bytes &size=6;
    trade_price_fraction_indicator: bytes &size=1;
    net_change_sign: uint8 &convert=NetChangeSign($$);
    net_change: bytes &size=6;
    net_change_fraction_indicator: bytes &size=1;
    : skip bytes &size=6;   # padding
    timestamp: bytes &size=6;
    price_indicator_marker: uint8 &convert=PriceIndicatorMarker($$);
};

type OptionRequestForQuoteMessage = unit {
    exchange_id: bytes &size=1;
    instrument_description: InstrumentDescription;
    requested_size: bytes &size=8;
};

type OptionQuoteMessage = unit {
    exchange_id: bytes &size=1;
    instrument_description: InstrumentDescription;
    bid_price: bytes &size=6;
    bid_price_fraction_indicator: bytes &size=1;
    bid_size: bytes &size=5;
    ask_price: bytes &size=6;
    ask_price_fraction_indicator: bytes &size=1;
    ask_size: bytes &size=5;
    : skip bytes &size=1;   # padding
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
    public_customer_bid_size: bytes &size=5;
    public_customer_ask_size: bytes &size=5;
};

type ComplexOrderQuoteMessage = unit {
    exchange_id: bytes &size=1;
    complex_order_instrument_symbol: bytes &size=30;
    bid_price_sign: bytes &size=1;
    bid_price: bytes &size=6;
    bid_price_fraction_indicator: bytes &size=1;
    bid_size: bytes &size=5;
    ask_price_sign: uint8 &convert=AskPriceSign($$);
