type ComplexOrderInstrumentKeysMessage = unit {
    exchange_id: bytes &size=1;
    complex_order_instrument_symbol: bytes &size=30;
    expiry_year: bytes &size=2;
    delivery_month: uint8 &convert=DeliveryMonth($$);
    expiry_day: bytes &size=2;
    max_number_of_contracts_per_order: bytes &size=6;
    min_number_of_contracts_per_order: bytes &size=6;
    max_threshold_price_sign: uint8 &convert=MaxThresholdPriceSign($$);
