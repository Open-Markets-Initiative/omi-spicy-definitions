    min_threshold_price_fraction_indicator: bytes &size=1;
    tick_increment: bytes &size=6;
    tick_increment_fraction_indicator: bytes &size=1;
    : skip bytes &size=2;   # padding
    group: bytes &size=2;
    instrument: bytes &size=4;
    instrument_external_code: bytes &size=30;
    complex_order_instrument_allow_implied: uint8 &convert=ComplexOrderInstrumentAllowImplied($$);
    number_of_legs: bytes &size=2;
    instrument_leg: InstrumentLeg[self.number_of_legs];
};

