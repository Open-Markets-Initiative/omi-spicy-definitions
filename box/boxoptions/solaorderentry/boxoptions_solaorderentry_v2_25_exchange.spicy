module BoxBoxoptionsSolaorderentrySailV225Exchange;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type BoxoptionsSolaorderentryV225 = unit {
    message_length: uint32;
    outgoing_header: OutgoingHeader;
    switch ( self.outgoing_header.message_type ) {
        0 -> heartbeat_question: HeartbeatQuestion;
        0 -> out_of_sequence: OutOfSequence;
        0 -> technical_error_notice: TechnicalErrorNotice;
        0 -> disconnection_instruction_acknowledgement: DisconnectionInstructionAcknowledgement;
        0 -> connection_acknowledgement: ConnectionAcknowledgement;
        0 -> disconnection_acknowledgement: DisconnectionAcknowledgement;
        0 -> end_of_transmission: EndOfTransmission;
        0 -> error_notice: ErrorNotice;
        0 -> bulk_quote_data_acknowledgement: BulkQuoteDataAcknowledgement;
        0 -> order_acknowledgement: OrderAcknowledgement;
        0 -> global_cancellation_confirmation: GlobalCancellationConfirmation;
        0 -> improvement_order_acknowlegment: ImprovementOrderAcknowlegment;
        0 -> order_modification_acknowledgement: OrderModificationAcknowledgement;
        0 -> new_complex_order_instrument_acknowledgement: NewComplexOrderInstrumentAcknowledgement;
        0 -> standard_acknowledgement: StandardAcknowledgement;
        0 -> complex_order_auction_acknowledgement: ComplexOrderAuctionAcknowledgement;
        0 -> auction_or_improvement_cancellation_acknowledgement: AuctionOrImprovementCancellationAcknowledgement;
        0 -> order_cancellation_acknowledgement: OrderCancellationAcknowledgement;
        0 -> bulk_quote_acknowledgement: BulkQuoteAcknowledgement;
        0 -> trader_status: TraderStatus;
        0 -> directed_order_cancellation_notice: DirectedOrderCancellationNotice;
        0 -> directed_order_notice: DirectedOrderNotice;
        0 -> excluded_instrument_notice: ExcludedInstrumentNotice;
        0 -> group_state_change: GroupStateChange;
        0 -> leg_execution_notice: LegExecutionNotice;
        0 -> cancellation_of_all_quotes_notices: CancellationOfAllQuotesNotices;
        0 -> quality_market_maker_notification: QualityMarketMakerNotification;
        0 -> execution_notice: ExecutionNotice;
        0 -> quote_notice: QuoteNotice;
        0 -> execution_cancellation_notice: ExecutionCancellationNotice;
        0 -> leg_execution_cancellation_notice: LegExecutionCancellationNotice;
        0 -> order_cancellation_notice_by_system: OrderCancellationNoticeBySystem;
        * -> unknown: bytes &eod;
    };
    end_of_text: uint8;
};

type OutgoingHeader = unit {
    message_type: bytes &size=2;
    message_timestamp: bytes &size=6;
    user_sequence_id: bytes &size=8;
    exchange_message_id: bytes &size=6;
    gap_sequence_id: bytes &size=2;
    system_sequence_id: bytes &size=6;
};

type HeartbeatQuestion = unit {
    user_sequence_id_first_user_sequence_id_for_nextcurrent_heartbeat_period: bytes &size=8;
    last_exchange_message_id_sent_to_participant: bytes &size=6;
    time_local: bytes &size=6;
};

type OutOfSequence = unit {
    received_user_sequence_id: bytes &size=8;
    expected_last_user_sequence_id: bytes &size=8;
    message_time_local: bytes &size=6;
};

type TechnicalErrorNotice = unit {
    received_message_type: bytes &size=2;
    preceding_user_sequence_id_received_zeroes_if_none: bytes &size=8;
    error_code: bytes &size=4;
    error_position: bytes &size=4;
    error_message: bytes &size=100;
    start_of_message_in_error: bytes &size=100;
};

type DisconnectionInstructionAcknowledgement = unit {
    current_session_id: bytes &size=4;
    last_user_sequence_id_received: bytes &size=8;
};

type ConnectionAcknowledgement = unit {
    current_session_id: bytes &size=4;
    last_user_sequence_id_received: bytes &size=8;
};

type DisconnectionAcknowledgement = unit {
    current_session_id: bytes &size=4;
    last_user_sequence_id_received: bytes &size=8;
};

type EndOfTransmission = unit {
    ended_session_id: bytes &size=4;
    last_user_sequence_id_received_if_no_business_message_has_been_received_on_this_connection_this_field_is_equal_to_zeroes: bytes &size=8;
    time_field: bytes &size=6;
};

type ErrorNotice = unit {
    error_code: bytes &size=4;
    error_description: bytes &size=100;
    group: bytes &size=2;
    instrument: bytes &size=4;
    order_id_client_order_id_20: bytes &size=20;
    auction_id: bytes &size=6;
    original_message_type: bytes &size=2;
    error_detail: bytes &size=200;
    client_order_id: bytes &size=20;
};

type BulkQuoteDataAcknowledgement = unit {
    group: bytes &size=2;
    trader_id: bytes &size=8;
    quote_id_identifies_traders_quote_on_this_group: bytes &size=8;
};

type OrderAcknowledgement = unit {
    group: bytes &size=2;
    instrument: bytes &size=4;
    trader_id: bytes &size=8;
    order_id_order_id_8: bytes &size=8;
    status: uint8 &convert=Status($$);
    verb_side: uint8 &convert=VerbSide($$);
    quantity: bytes &size=8;
    assigned_price: bytes &size=10;
    clearing_data: ClearingData;
    owner_data: OwnerData;
    original_order_id: bytes &size=8;
    : skip bytes &size=6;   # padding
    additional_client_memo: bytes &size=16;
    : skip bytes &size=4;   # padding
};

type ClearingData = unit {
    clearing_instruction: bytes &size=12;
    account_type: uint8 &convert=AccountType($$);
    open_close: uint8 &convert=OpenClose($$);
    hedge_spec: uint8 &convert=HedgeSpec($$);
    clearing_operation_mode: uint8 &convert=ClearingOperationMode($$);
    clearing_destination: bytes &size=4;
};

type OwnerData = unit {
    client_order_id: bytes &size=20;
    pound_sign: bytes &size=1;
    memo: bytes &size=50;
};

type GlobalCancellationConfirmation = unit {
    group: bytes &size=2;
    trader_id: bytes &size=8;
    type_of_cancellation_only_q_quotes_only_can_be_returned: uint8 &convert=TypeOfCancellationOnlyQQuotesOnlyCanBeReturned($$);
};

