type OptionQuoteMessage = unit {
    exchange_id: bytes &size=1;
    instrument_description: InstrumentDescription;
    switch ( self.bid_price_quote_fraction_pair.bid_price_quote_opening_pair.bid_price_quote_opening ) {
        0 -> bid_price_quote_opening_pair: BidPriceQuoteOpeningPair;
        0x41 -> bid_price_quote_negative_whole_pair: BidPriceQuoteNegativeWholePair;
        0x42 -> bid_price_quote_negative_ten_pair: BidPriceQuoteNegativeTenPair;
        0x43 -> bid_price_quote_negative_hundred_pair: BidPriceQuoteNegativeHundredPair;
        0x44 -> bid_price_quote_negative_thousand_pair: BidPriceQuoteNegativeThousandPair;
        0x45 -> bid_price_quote_negative_ten_thousand_pair: BidPriceQuoteNegativeTenThousandPair;
        0x46 -> bid_price_quote_negative_hundred_thousand_pair: BidPriceQuoteNegativeHundredThousandPair;
        0x47 -> bid_price_quote_negative_million_pair: BidPriceQuoteNegativeMillionPair;
        0x30 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x31 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x32 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x33 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x34 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x35 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x36 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x37 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x38 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        0x39 -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
        * -> bid_price_quote_unknown_fraction_pair: BidPriceQuoteUnknownFractionPair;
    };
    bid_size: bytes &size=5;
    switch ( self.ask_price_quote_fraction_pair.ask_price_quote_opening_pair.ask_price_quote_opening ) {
        0 -> ask_price_quote_opening_pair: AskPriceQuoteOpeningPair;
        0x41 -> ask_price_quote_negative_whole_pair: AskPriceQuoteNegativeWholePair;
        0x42 -> ask_price_quote_negative_ten_pair: AskPriceQuoteNegativeTenPair;
        0x43 -> ask_price_quote_negative_hundred_pair: AskPriceQuoteNegativeHundredPair;
        0x44 -> ask_price_quote_negative_thousand_pair: AskPriceQuoteNegativeThousandPair;
        0x45 -> ask_price_quote_negative_ten_thousand_pair: AskPriceQuoteNegativeTenThousandPair;
        0x46 -> ask_price_quote_negative_hundred_thousand_pair: AskPriceQuoteNegativeHundredThousandPair;
        0x47 -> ask_price_quote_negative_million_pair: AskPriceQuoteNegativeMillionPair;
        0x30 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x31 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x32 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x33 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x34 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x35 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x36 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x37 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x38 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        0x39 -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
        * -> ask_price_quote_unknown_fraction_pair: AskPriceQuoteUnknownFractionPair;
    };
    ask_size: bytes &size=5;
    : skip bytes &size=1;   # padding
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
    public_customer_bid_size: bytes &size=5;
    public_customer_ask_size: bytes &size=5;
};

