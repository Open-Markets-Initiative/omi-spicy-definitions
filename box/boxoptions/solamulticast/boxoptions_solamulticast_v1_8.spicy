        MaxThresholdPriceFractionIndicator::Hundred -> max_threshold_price_numeric_pair: MaxThresholdPriceNumericPair;
        MaxThresholdPriceFractionIndicator::Thousand -> max_threshold_price_numeric_pair: MaxThresholdPriceNumericPair;
        MaxThresholdPriceFractionIndicator::TenThousand -> max_threshold_price_numeric_pair: MaxThresholdPriceNumericPair;
        MaxThresholdPriceFractionIndicator::HundredThousand -> max_threshold_price_numeric_pair: MaxThresholdPriceNumericPair;
        MaxThresholdPriceFractionIndicator::Million -> max_threshold_price_numeric_pair: MaxThresholdPriceNumericPair;
        MaxThresholdPriceFractionIndicator::TenMillion -> max_threshold_price_numeric_pair: MaxThresholdPriceNumericPair;
        MaxThresholdPriceFractionIndicator::HundredMillion -> max_threshold_price_numeric_pair: MaxThresholdPriceNumericPair;
        MaxThresholdPriceFractionIndicator::Billion -> max_threshold_price_numeric_pair: MaxThresholdPriceNumericPair;
        * -> max_threshold_price_unknown_fraction_pair: MaxThresholdPriceUnknownFractionPair;
    };
    min_threshold_price_sign: uint8 &convert=MinThresholdPriceSign($$);
    switch ( self.min_threshold_price_fraction_pair.min_threshold_price_negative_whole_pair.min_threshold_price_fraction_indicator ) {
        MinThresholdPriceFractionIndicator::NegativeWhole -> min_threshold_price_negative_whole_pair: MinThresholdPriceNegativeWholePair;
        MinThresholdPriceFractionIndicator::NegativeTen -> min_threshold_price_negative_ten_pair: MinThresholdPriceNegativeTenPair;
        MinThresholdPriceFractionIndicator::NegativeHundred -> min_threshold_price_negative_hundred_pair: MinThresholdPriceNegativeHundredPair;
        MinThresholdPriceFractionIndicator::NegativeThousand -> min_threshold_price_negative_thousand_pair: MinThresholdPriceNegativeThousandPair;
        MinThresholdPriceFractionIndicator::NegativeTenThousand -> min_threshold_price_negative_ten_thousand_pair: MinThresholdPriceNegativeTenThousandPair;
        MinThresholdPriceFractionIndicator::NegativeHundredThousand -> min_threshold_price_negative_hundred_thousand_pair: MinThresholdPriceNegativeHundredThousandPair;
        MinThresholdPriceFractionIndicator::NegativeMillion -> min_threshold_price_negative_million_pair: MinThresholdPriceNegativeMillionPair;
        MinThresholdPriceFractionIndicator::Whole -> min_threshold_price_numeric_pair: MinThresholdPriceNumericPair;
        MinThresholdPriceFractionIndicator::Ten -> min_threshold_price_numeric_pair: MinThresholdPriceNumericPair;
        MinThresholdPriceFractionIndicator::Hundred -> min_threshold_price_numeric_pair: MinThresholdPriceNumericPair;
        MinThresholdPriceFractionIndicator::Thousand -> min_threshold_price_numeric_pair: MinThresholdPriceNumericPair;
        MinThresholdPriceFractionIndicator::TenThousand -> min_threshold_price_numeric_pair: MinThresholdPriceNumericPair;
        MinThresholdPriceFractionIndicator::HundredThousand -> min_threshold_price_numeric_pair: MinThresholdPriceNumericPair;
