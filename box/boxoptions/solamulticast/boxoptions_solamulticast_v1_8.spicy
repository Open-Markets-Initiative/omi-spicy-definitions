module BoxBoxoptionsSolamulticastHsvfV18;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type BoxoptionsSolamulticastV18 = unit {
    hsvf_stx: uint8;
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::EndOfTransmissionMessage -> end_of_transmission_message: EndOfTransmissionMessage;
        MessageType::CircuitAssuranceMessage -> circuit_assurance_message: CircuitAssuranceMessage;
        MessageType::SystemTimestampMessage -> system_timestamp_message: SystemTimestampMessage;
        MessageType::OptionTradeMessage -> option_trade_message: OptionTradeMessage;
        MessageType::ComplexOrderInstrumentTradeMessage -> complex_order_instrument_trade_message: ComplexOrderInstrumentTradeMessage;
        MessageType::OptionRequestForQuoteMessage -> option_request_for_quote_message: OptionRequestForQuoteMessage;
        MessageType::OptionQuoteMessage -> option_quote_message: OptionQuoteMessage;
        MessageType::ComplexOrderQuoteMessage -> complex_order_quote_message: ComplexOrderQuoteMessage;
        MessageType::GroupOpeningTimeMessage -> group_opening_time_message: GroupOpeningTimeMessage;
        MessageType::GroupStatusMessage -> group_status_message: GroupStatusMessage;
        MessageType::StrategiesGroupStatusMessage -> strategies_group_status_message: StrategiesGroupStatusMessage;
        MessageType::OptionMarketDepthMessage -> option_market_depth_message: OptionMarketDepthMessage;
        MessageType::ComplexOrderMarketDepthMessage -> complex_order_market_depth_message: ComplexOrderMarketDepthMessage;
        MessageType::OptionTradeCancellationMessage -> option_trade_cancellation_message: OptionTradeCancellationMessage;
        MessageType::ComplexOrderTradeCancellationMessage -> complex_order_trade_cancellation_message: ComplexOrderTradeCancellationMessage;
        MessageType::OptionInstrumentKeysMessage -> option_instrument_keys_message: OptionInstrumentKeysMessage;
        MessageType::ComplexOrderInstrumentKeysMessage -> complex_order_instrument_keys_message: ComplexOrderInstrumentKeysMessage;
        MessageType::BulletinsMessage -> bulletins_message: BulletinsMessage;
        MessageType::OptionSummaryMessage -> option_summary_message: OptionSummaryMessage;
        MessageType::ComplexOrderSummaryMessage -> complex_order_summary_message: ComplexOrderSummaryMessage;
        MessageType::BeginningOfOptionsSummaryMessage -> beginning_of_options_summary_message: BeginningOfOptionsSummaryMessage;
        MessageType::BeginningOfComplexOrderSummaryMessage -> beginning_of_complex_order_summary_message: BeginningOfComplexOrderSummaryMessage;
        MessageType::EndOfSalesMessage -> end_of_sales_message: EndOfSalesMessage;
        MessageType::OptionImprovementProcessBeginningMessage -> option_improvement_process_beginning_message: OptionImprovementProcessBeginningMessage;
        MessageType::ComplexOrderImprovementProcessBeginningMessageMessage -> complex_order_improvement_process_beginning_message_message: ComplexOrderImprovementProcessBeginningMessageMessage;
        MessageType::MarketSheetInitialAndImprovementOrderMessage -> market_sheet_initial_and_improvement_order_message: MarketSheetInitialAndImprovementOrderMessage;
        MessageType::ComplexOrderMarketSheetInitialAndImprovementOrderMessage -> complex_order_market_sheet_initial_and_improvement_order_message: ComplexOrderMarketSheetInitialAndImprovementOrderMessage;
        MessageType::InitialAndImprovementOrderMessage -> initial_and_improvement_order_message: InitialAndImprovementOrderMessage;
        MessageType::ComplexOrderInitialAndImprovementOrderMessage -> complex_order_initial_and_improvement_order_message: ComplexOrderInitialAndImprovementOrderMessage;
        * -> unknown: bytes &eod;
    };
    hsvf_etx: uint8;
};

type MessageHeader = unit {
    sequence_number: bytes &size=9;
    message_type: bytes &size=2;
};

type EndOfTransmissionMessage = unit {
    exchange_id: bytes &size=1;
    time_field: bytes &size=6;
};

type CircuitAssuranceMessage = unit {
    time_field: bytes &size=6;
};

type SystemTimestampMessage = unit {
    trading_engine_timestamp: bytes &size=9;
};

type OptionTradeMessage = unit {
    exchange_id: bytes &size=1;
    instrument_description: InstrumentDescription;
    volume: bytes &size=8;
    switch ( self.trade_price_fraction_pair.trade_price_negative_whole_pair.trade_price_fraction_indicator ) {
        TradePriceFractionIndicator::NegativeWhole -> trade_price_negative_whole_pair: TradePriceNegativeWholePair;
        TradePriceFractionIndicator::NegativeTen -> trade_price_negative_ten_pair: TradePriceNegativeTenPair;
        TradePriceFractionIndicator::NegativeHundred -> trade_price_negative_hundred_pair: TradePriceNegativeHundredPair;
        TradePriceFractionIndicator::NegativeThousand -> trade_price_negative_thousand_pair: TradePriceNegativeThousandPair;
        TradePriceFractionIndicator::NegativeTenThousand -> trade_price_negative_ten_thousand_pair: TradePriceNegativeTenThousandPair;
        TradePriceFractionIndicator::NegativeHundredThousand -> trade_price_negative_hundred_thousand_pair: TradePriceNegativeHundredThousandPair;
        TradePriceFractionIndicator::NegativeMillion -> trade_price_negative_million_pair: TradePriceNegativeMillionPair;
        TradePriceFractionIndicator::Whole -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::Ten -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::Hundred -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::Thousand -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::TenThousand -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::HundredThousand -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::Million -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::TenMillion -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::HundredMillion -> trade_price_numeric_pair: TradePriceNumericPair;
        TradePriceFractionIndicator::Billion -> trade_price_numeric_pair: TradePriceNumericPair;
        * -> trade_price_unknown_fraction_pair: TradePriceUnknownFractionPair;
    };
    net_change_sign: uint8 &convert=NetChangeSign($$);
    switch ( self.net_change_fraction_pair.net_change_negative_whole_pair.net_change_fraction_indicator ) {
        NetChangeFractionIndicator::NegativeWhole -> net_change_negative_whole_pair: NetChangeNegativeWholePair;
        NetChangeFractionIndicator::NegativeTen -> net_change_negative_ten_pair: NetChangeNegativeTenPair;
        NetChangeFractionIndicator::NegativeHundred -> net_change_negative_hundred_pair: NetChangeNegativeHundredPair;
        NetChangeFractionIndicator::NegativeThousand -> net_change_negative_thousand_pair: NetChangeNegativeThousandPair;
        NetChangeFractionIndicator::NegativeTenThousand -> net_change_negative_ten_thousand_pair: NetChangeNegativeTenThousandPair;
        NetChangeFractionIndicator::NegativeHundredThousand -> net_change_negative_hundred_thousand_pair: NetChangeNegativeHundredThousandPair;
        NetChangeFractionIndicator::NegativeMillion -> net_change_negative_million_pair: NetChangeNegativeMillionPair;
        NetChangeFractionIndicator::Whole -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::Ten -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::Hundred -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::Thousand -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::TenThousand -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::HundredThousand -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::Million -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::TenMillion -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::HundredMillion -> net_change_numeric_pair: NetChangeNumericPair;
        NetChangeFractionIndicator::Billion -> net_change_numeric_pair: NetChangeNumericPair;
        * -> net_change_unknown_fraction_pair: NetChangeUnknownFractionPair;
    };
    : skip bytes &size=6;   # padding
    timestamp: bytes &size=6;
    open_interest: bytes &size=7;
    : skip bytes &size=1;   # padding
    price_indicator_marker: uint8 &convert=PriceIndicatorMarker($$);
};

type InstrumentDescription = unit {
    root_symbol: bytes &size=6;
    expiry_month_code: uint8 &convert=ExpiryMonthCode($$);
    : skip bytes &size=1;   # padding
    switch ( self.strike_price_fraction_pair.strike_price_negative_whole_pair.strike_price_fraction_indicator ) {
        StrikePriceFractionIndicator::NegativeWhole -> strike_price_negative_whole_pair: StrikePriceNegativeWholePair;
        StrikePriceFractionIndicator::NegativeTen -> strike_price_negative_ten_pair: StrikePriceNegativeTenPair;
        StrikePriceFractionIndicator::NegativeHundred -> strike_price_negative_hundred_pair: StrikePriceNegativeHundredPair;
        StrikePriceFractionIndicator::NegativeThousand -> strike_price_negative_thousand_pair: StrikePriceNegativeThousandPair;
        StrikePriceFractionIndicator::NegativeTenThousand -> strike_price_negative_ten_thousand_pair: StrikePriceNegativeTenThousandPair;
        StrikePriceFractionIndicator::NegativeHundredThousand -> strike_price_negative_hundred_thousand_pair: StrikePriceNegativeHundredThousandPair;
        StrikePriceFractionIndicator::NegativeMillion -> strike_price_negative_million_pair: StrikePriceNegativeMillionPair;
        StrikePriceFractionIndicator::Whole -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::Ten -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::Hundred -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::Thousand -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::TenThousand -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::HundredThousand -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::Million -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::TenMillion -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::HundredMillion -> strike_price_numeric_pair: StrikePriceNumericPair;
        StrikePriceFractionIndicator::Billion -> strike_price_numeric_pair: StrikePriceNumericPair;
        * -> strike_price_unknown_fraction_pair: StrikePriceUnknownFractionPair;
    };
    expiry_year: bytes &size=2;
    expiry_day: bytes &size=2;
};

