        0 -> tick_increment_tick_table_pair: TickIncrementTickTablePair;
        0x41 -> tick_increment_negative_whole_pair: TickIncrementNegativeWholePair;
        0x42 -> tick_increment_negative_ten_pair: TickIncrementNegativeTenPair;
        0x43 -> tick_increment_negative_hundred_pair: TickIncrementNegativeHundredPair;
        0x44 -> tick_increment_negative_thousand_pair: TickIncrementNegativeThousandPair;
