        0x31 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        0x32 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        0x33 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        0x34 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        0x35 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        0x36 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        0x37 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        0x38 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        0x39 -> tick_increment_numeric_pair: TickIncrementNumericPair;
        * -> tick_increment_unknown_fraction_pair: TickIncrementUnknownFractionPair;
    };
    : skip bytes &size=2;   # padding
    group: bytes &size=2;
    instrument: bytes &size=4;
    instrument_external_code: bytes &size=30;
    complex_order_instrument_allow_implied: uint8 &convert=ComplexOrderInstrumentAllowImplied($$);
    number_of_legs: bytes &size=2;
    instrument_leg: InstrumentLeg[self.number_of_legs];
};

