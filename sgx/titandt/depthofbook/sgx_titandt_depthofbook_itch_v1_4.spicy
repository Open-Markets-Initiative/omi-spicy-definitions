module SgxTitandtDepthofbookItchV14;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type SgxTitandtDepthofbookV14 = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SecondsMessage -> seconds_message: SecondsMessage;
        MessageType::OrderBookDirectoryMessage -> order_book_directory_message: OrderBookDirectoryMessage;
        MessageType::CombinationOrderBookDirectoryMessage -> combination_order_book_directory_message: CombinationOrderBookDirectoryMessage;
        MessageType::TickSizeTableEntryMessage -> tick_size_table_entry_message: TickSizeTableEntryMessage;
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::OrderBookStateMessage -> order_book_state_message: OrderBookStateMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        MessageType::OrderExecutedWithPriceMessage -> order_executed_with_price_message: OrderExecutedWithPriceMessage;
        MessageType::OrderReplaceMessage -> order_replace_message: OrderReplaceMessage;
        MessageType::OrderDeleteMessage -> order_delete_message: OrderDeleteMessage;
        MessageType::TradeMessage -> trade_message: TradeMessage;
        MessageType::EquilibriumPriceUpdateMessage -> equilibrium_price_update_message: EquilibriumPriceUpdateMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type SecondsMessage = unit {
    second: uint32;
};

type OrderBookDirectoryMessage = unit {
    nanoseconds: uint32;
    order_book_id: uint32;
    symbol: bytes &size=32;
    long_name: bytes &size=32;
    : skip bytes &size=12;   # padding
    financial_product: uint8 &convert=FinancialProduct($$);
    trading_currency: bytes &size=3;
    number_of_decimals_in_price: uint16;
    number_of_decimals_in_nominal_value: uint16;
    : skip bytes &size=4;   # padding
    : skip bytes &size=4;   # padding
    : skip bytes &size=4;   # padding
    nominal_value: uint64;
};

type CombinationOrderBookDirectoryMessage = unit {
    nanoseconds: uint32;
    order_book_id: uint32;
    symbol: bytes &size=32;
    long_name: bytes &size=32;
    : skip bytes &size=12;   # padding
    financial_product: uint8 &convert=FinancialProduct($$);
    trading_currency: bytes &size=3;
    number_of_decimals_in_price: uint16;
    number_of_decimals_in_nominal_value: uint16;
    : skip bytes &size=4;   # padding
    : skip bytes &size=4;   # padding
    : skip bytes &size=4;   # padding
    nominal_value: uint64;
    leg_1_symbol: bytes &size=32;
    leg_1_side: uint8 &convert=Leg1Side($$);
    leg_1_ratio: uint32;
    leg_2_symbol: bytes &size=32;
    leg_2_side: uint8 &convert=Leg2Side($$);
    leg_2_ratio: uint32;
    leg_3_symbol: bytes &size=32;
    leg_3_side: uint8 &convert=Leg3Side($$);
    leg_3_ratio: uint32;
    leg_4_symbol: bytes &size=32;
    leg_4_side: uint8 &convert=Leg4Side($$);
    leg_4_ratio: uint32;
};

type TickSizeTableEntryMessage = unit {
    nanoseconds: uint32;
    order_book_id: uint32;
    tick_size: uint64;
    price_from: int32;
    price_to: int32;
};

type SystemEventMessage = unit {
    nanoseconds: uint32;
    event_code: uint8 &convert=EventCode($$);
};

type OrderBookStateMessage = unit {
    nanoseconds: uint32;
    order_book_id: uint32;
    state_name: bytes &size=20;
};

type AddOrderMessage = unit {
    nanoseconds: uint32;
    order_id: uint64;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    order_book_position: uint32;
    quantity: uint64;
    price: int32;
    order_attributes: bitfield(16) {
        reserved_bits_1_to_13: 0..12;
        bait_implied_order: 13;
        reserved_bits_15_to_16: 14..15;
    } &byte-order=spicy::ByteOrder::Big;
    lot_type: uint8 &convert=LotType($$);
};

type OrderExecutedMessage = unit {
    nanoseconds: uint32;
    order_id: uint64;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    executed_quantity: uint64;
    match_id: uint64;
    combo_group_id: uint32;
    : skip bytes &size=7;   # padding
    : skip bytes &size=7;   # padding
};

type OrderExecutedWithPriceMessage = unit {
    nanoseconds: uint32;
    order_id: uint64;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    executed_quantity: uint64;
    match_id: uint64;
    combo_group_id: uint32;
    : skip bytes &size=7;   # padding
    : skip bytes &size=7;   # padding
    trade_price: int32;
    occurred_at_cross: uint8 &convert=OccurredAtCross($$);
    printable: uint8 &convert=Printable($$);
};

type OrderReplaceMessage = unit {
    nanoseconds: uint32;
    order_id: uint64;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    new_order_book_position: uint32;
    quantity: uint64;
    price: int32;
    order_attributes: bitfield(16) {
        reserved_bits_1_to_13: 0..12;
        bait_implied_order: 13;
        reserved_bits_15_to_16: 14..15;
    } &byte-order=spicy::ByteOrder::Big;
};

type OrderDeleteMessage = unit {
    nanoseconds: uint32;
    order_id: uint64;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
};

type TradeMessage = unit {
    nanoseconds: uint32;
    match_id: uint64;
    combo_group_id: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint64;
    order_book_id: uint32;
    trade_price: int32;
    : skip bytes &size=7;   # padding
    : skip bytes &size=7;   # padding
    printable: uint8 &convert=Printable($$);
    occurred_at_cross: uint8 &convert=OccurredAtCross($$);
};

type EquilibriumPriceUpdateMessage = unit {
    nanoseconds: uint32;
    order_book_id: uint32;
    available_bid_quantity_at_equilibrium_price: uint64;
    available_ask_quantity_at_equilibrium_price: uint64;
    equilibrium_price: int32;
    best_bid_price: int32;
    best_ask_price: int32;
    best_bid_quantity: uint64;
    best_ask_quantity: uint64;
};

type MessageType = enum {
    SecondsMessage = 0x54,
    OrderBookDirectoryMessage = 0x52,
    CombinationOrderBookDirectoryMessage = 0x4d,
    TickSizeTableEntryMessage = 0x4c,
    SystemEventMessage = 0x53,
    OrderBookStateMessage = 0x4f,
    AddOrderMessage = 0x41,
    OrderExecutedMessage = 0x45,
    OrderExecutedWithPriceMessage = 0x43,
    OrderReplaceMessage = 0x55,
    OrderDeleteMessage = 0x44,
    TradeMessage = 0x50,
    EquilibriumPriceUpdateMessage = 0x5a,
};

type FinancialProduct = enum {
    Option = 1,
    Forward = 2,
    Future = 3,
    Fra = 4,
    Cash = 5,
    Payment = 6,
    ExchangeRate = 7,
    InterestRateSwap = 8,
    Repo = 9,
    SyntheticBoxLegOrReference = 10,
    StandardCombination = 11,
    Guarantee = 12,
    OtcGeneral = 13,
    EquityWarrant = 14,
    SecurityLending = 15,
};

type Leg1Side = enum {
    AsDefined = 0x42,
    Opposite = 0x43,
};

type Leg2Side = enum {
    AsDefined = 0x42,
    Opposite = 0x43,
};

type Leg3Side = enum {
    AsDefined = 0x42,
    Opposite = 0x43,
};

type Leg4Side = enum {
    AsDefined = 0x42,
    Opposite = 0x43,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    EndOfMessages = 0x43,
};

type Side = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

type LotType = enum {
    RoundLot = 2,
};

type OccurredAtCross = enum {
    TradeOccurredAtTheCross = 0x59,
    TradeOccurredAtContinuousMarket = 0x4e,
};

type Printable = enum {
    Printable_x59 = 0x59,
    NonPrintable = 0x4e,
};

