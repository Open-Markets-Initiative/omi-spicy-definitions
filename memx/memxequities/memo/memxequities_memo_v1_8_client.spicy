module MemxMemxequitiesMemoSbeV18Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type MemxequitiesMemoV18 = unit {
    common_header: CommonHeader;
    switch ( self.common_header.message_type ) {
        MessageType::LoginRequest -> login_request_message: LoginRequestMessage;
        MessageType::ReplayRequest -> replay_request_message: ReplayRequestMessage;
        MessageType::ReplayAllRequest -> replay_all_request_message: ReplayAllRequestMessage;
        MessageType::StreamRequest -> stream_request_message: StreamRequestMessage;
        MessageType::UnsequencedMessage -> unsequenced_message: UnsequencedMessage;
        * -> unknown: bytes &eod;
    };
};

type CommonHeader = unit {
    message_type: uint8 &convert=MessageType($$);
    message_length: uint16;
};

type LoginRequestMessage = unit {
    token_type: bytes &size=1;
    token: bytes &size=1;
};

type ReplayRequestMessage = unit {
    session_id: uint64;
    next_sequence_number: uint64;
    count: uint32;
};

type ReplayAllRequestMessage = unit {
    session_id: uint64;
};

type StreamRequestMessage = unit {
    session_id: uint64;
    next_sequence_number: uint64;
};

type UnsequencedMessage = unit {
    client_sbe_message: ClientSbeMessage;
};

type ClientSbeMessage = unit {
    sbe_header: SbeHeader;
    switch ( self.sbe_header.template_id ) {
        TemplateId::NewOrderSingleMessage -> new_order_single_message: NewOrderSingleMessage;
        TemplateId::OrderCancelReplaceRequestMessage -> order_cancel_replace_request_message: OrderCancelReplaceRequestMessage;
        TemplateId::OrderCancelRequestMessage -> order_cancel_request_message: OrderCancelRequestMessage;
        TemplateId::MassCancelRequestMessage -> mass_cancel_request_message: MassCancelRequestMessage;
        * -> unknown: bytes &eod;
    };
};

type SbeHeader = unit {
    block_length: uint16;
    template_id: uint8 &convert=TemplateId($$);
    schema_id: uint8;
    version: uint16;
};

type NewOrderSingleMessage = unit {
    clordid: bytes &size=16;
    mpid_optional: bytes &size=4;
    symbol: bytes &size=6;
    symbol_sfx: bytes &size=6;
    side: uint8 &convert=Side($$);
    order_qty: uint32;
    ord_type: uint8 &convert=OrdType($$);
    price: int64;
    time_in_force: uint8 &convert=TimeInForce($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    cust_order_capacity: uint8 &convert=CustOrderCapacity($$);
    exec_inst: ExecInst;
    peg_offset_value: int64;
    peg_price_type: uint8 &convert=PegPriceType($$);
    expire_time: uint64;
    min_qty: uint32;
    display_qty: uint32;
    display_method: uint8 &convert=DisplayMethod($$);
    reserve_replenish_timing: uint8 &convert=ReserveReplenishTiming($$);
    display_min_incr: uint32;
    locate_reqd: bytes &size=1;
    reprice_frequency: uint8 &convert=RepriceFrequency($$);
    reprice_behavior: uint8 &convert=RepriceBehavior($$);
    cancel_group_id: uint16;
    stp_group_id: uint16;
    self_trade_prevention: uint8 &convert=SelfTradePrevention($$);
    risk_group_id: uint16;
};

type ExecInst = unit {
    participate_do_not_initiate: bytes &size=1;
    intermarket_sweep: bytes &size=1;
    external_routing_not_allowed: bytes &size=1;
    reserved_13: bytes &size=2;
};

type OrderCancelReplaceRequestMessage = unit {
    origclordid: bytes &size=16;
    clordid: bytes &size=16;
    symbol: bytes &size=6;
    symbol_sfx: bytes &size=6;
    side: uint8 &convert=Side($$);
    order_qty: uint32;
    ord_type: uint8 &convert=OrdType($$);
    price: int64;
    display_qty: uint32;
    locate_reqd: bytes &size=1;
};

type OrderCancelRequestMessage = unit {
    origclordid_optional: bytes &size=16;
    order_id_optional: uint64;
    clordid: bytes &size=16;
    symbol: bytes &size=6;
    symbol_sfx: bytes &size=6;
};

type MassCancelRequestMessage = unit {
    clordid: bytes &size=16;
    symbol: bytes &size=6;
    symbol_sfx: bytes &size=6;
    side_optional: uint8 &convert=SideOptional($$);
    lower_than_price: int64;
    higher_than_price: int64;
    cancel_group_id: uint16;
};

type MessageType = enum {
    Heartbeat = 0,
    LoginRequest = 100,
    ReplayRequest = 101,
    ReplayAllRequest = 102,
    StreamRequest = 103,
    UnsequencedMessage = 104,
    LoginAccepted = 1,
    LoginRejected = 2,
    StartOfSession = 3,
    EndOfSession = 4,
    ReplayBegin = 5,
    ReplayRejected = 6,
    ReplayComplete = 7,
    StreamBegin = 8,
    StreamRejected = 9,
    StreamComplete = 10,
    SequencedMessage = 11,
};

type TemplateId = enum {
    NewOrderSingleMessage = 1,
    OrderCancelReplaceRequestMessage = 2,
    OrderCancelRequestMessage = 3,
    MassCancelRequestMessage = 4,
    ExecutionReportPendingNewMessage = 5,
    ExecutionReportNewMessage = 6,
    ExecutionReportRejectedMessage = 7,
    ExecutionReportTradeMessage = 8,
    ExecutionReportPendingCancelMessage = 9,
    PendingMassCancelMessage = 10,
    ExecutionReportCanceledMessage = 11,
    MassCancelDoneMessage = 12,
    ExecutionReportPendingReplaceMessage = 13,
    ExecutionReportReplacedMessage = 14,
    ExecutionReportTradeCorrectionMessage = 15,
    ExecutionReportTradeBreakMessage = 16,
    ExecutionReportRestatementMessage = 17,
    OrderCancelRejectMessage = 18,
    MassCancelRejectMessage = 20,
};

type Side = enum {
    Buy = 1,
    Sell = 2,
    SellShort = 3,
    SellShortExempt = 4,
    NullValue = 255,
};

type OrdType = enum {
    Market = 1,
    Limit = 2,
    Pegged = 3,
    NullValue = 255,
};

type TimeInForce = enum {
    Day = 1,
    ImmediateOrCancel = 2,
    FillOrKill = 3,
    GoodForTime = 4,
    RegularHoursOnly = 5,
    NullValue = 255,
};

type OrderCapacity = enum {
    Agency = 1,
    Principal = 2,
    RisklessPrincipal = 3,
    NullValue = 255,
};

type CustOrderCapacity = enum {
    MemberTradingOnTheirOwnAccount = 1,
    RetailCustomer = 5,
    NullValue = 255,
};

type PegPriceType = enum {
    MidPricePeg = 1,
    PrimaryPeg = 2,
    NullValue = 255,
};

type DisplayMethod = enum {
    Initial = 1,
    Random = 2,
    Undisclosed = 3,
    NullValue = 255,
};

type ReserveReplenishTiming = enum {
    Immediate = 1,
    Random = 2,
    NullValue = 255,
};

type RepriceFrequency = enum {
    SingleReprice = 1,
    ContinuousReprice = 2,
    None_3 = 3,
    NullValue = 255,
};

type RepriceBehavior = enum {
    RepriceLockCancelCross = 1,
    RepriceLockRepriceCross = 2,
    NullValue = 255,
};

type SelfTradePrevention = enum {
    CancelNewest = 1,
    CancelOldest = 2,
    DecrementAndCancel = 3,
    CancelBoth = 4,
    CancelSmallest = 5,
    NullValue = 255,
};

type SideOptional = enum {
    Buy = 1,
    Sell = 2,
    SellShort = 3,
    SellShortExempt = 4,
    NullValue = 255,
};

