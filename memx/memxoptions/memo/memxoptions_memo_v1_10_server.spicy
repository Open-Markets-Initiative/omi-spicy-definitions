type ExecutionReportTradeMessage = unit {
    order_id: uint64;
    clordid: bytes &size=20;
    list_seq_no: uint8;
    trd_match_id: uint64;
    exec_id: uint64;
    ord_status: uint8 &convert=OrdStatus($$);
    security_id: bytes &size=8;
