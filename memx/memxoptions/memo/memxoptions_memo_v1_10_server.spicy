    secondary_alloc_id: bytes &size=20;
    ref_alloc_id_optional: bytes &size=20;
    alloc_status: uint8 &convert=AllocStatus($$);
    alloc_rej_code: uint16 &convert=AllocRejCode($$);
    reported_allocations_groups: ReportedAllocationsGroups;
};

type ReportedAllocationsGroups = unit {
    repeating_group_dimensions: RepeatingGroupDimensions;
    reported_allocations_group: ReportedAllocationsGroup[self.repeating_group_dimensions.num_in_group];
};

type ReportedAllocationsGroup = unit {
    alloc_qty: uint32;
    alloc_position_effect: uint8 &convert=AllocPositionEffect($$);
    trading_capacity_optional: uint8 &convert=TradingCapacityOptional($$);
