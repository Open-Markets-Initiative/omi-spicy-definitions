    sending_time: uint64;
    transact_time: uint64;
};

type ExecutionReportRejectedMessage = unit {
    clordid: bytes &size=20;
    list_seq_no: uint8;
    exec_id: uint64;
    ord_status: uint8 &convert=OrdStatus($$);
    order_reject_reason: uint16 &convert=OrderRejectReason($$);
    security_id: bytes &size=8;
    side: uint8 &convert=Side($$);
    leaves_qty: uint32;
    cum_qty: uint32;
    sending_time: uint64;
