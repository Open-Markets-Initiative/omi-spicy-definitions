module MemxMemxoptionsMemoSbeV110Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type MemxoptionsMemoV110 = unit {
    common_header: CommonHeader;
    switch ( self.common_header.message_type ) {
        MessageType::LoginAccepted -> login_accepted_message: LoginAcceptedMessage;
        MessageType::LoginRejected -> login_rejected_message: LoginRejectedMessage;
        MessageType::StartOfSession -> start_of_session_message: StartOfSessionMessage;
        MessageType::ReplayBegin -> replay_begin_message: ReplayBeginMessage;
        MessageType::ReplayRejected -> replay_rejected_message: ReplayRejectedMessage;
        MessageType::ReplayComplete -> replay_complete_message: ReplayCompleteMessage;
        MessageType::StreamBegin -> stream_begin_message: StreamBeginMessage;
        MessageType::StreamRejected -> stream_rejected_message: StreamRejectedMessage;
        MessageType::StreamComplete -> stream_complete_message: StreamCompleteMessage;
        MessageType::SequencedMessage -> sequenced_message: SequencedMessage;
        * -> unknown: bytes &eod;
    };
};

type CommonHeader = unit {
    message_type: uint8 &convert=MessageType($$);
    message_length: uint16;
};

type LoginAcceptedMessage = unit {
    supported_request_mode: uint8 &convert=SupportedRequestMode($$);
};

type LoginRejectedMessage = unit {
    login_reject_code: uint8 &convert=LoginRejectCode($$);
};

type StartOfSessionMessage = unit {
    session_id: uint64;
};

type ReplayBeginMessage = unit {
    next_sequence_number: uint64;
    pending_message_count: uint32;
};

type ReplayRejectedMessage = unit {
    replay_reject_code: uint8 &convert=ReplayRejectCode($$);
};

type ReplayCompleteMessage = unit {
    message_count: uint64;
};

type StreamBeginMessage = unit {
    next_sequence_number: uint64;
    max_sequence_number: uint64;
};

type StreamRejectedMessage = unit {
    stream_reject_code: uint8 &convert=StreamRejectCode($$);
};

type StreamCompleteMessage = unit {
    total_sequence_count: uint64;
};

type SequencedMessage = unit {
    server_sbe_message: ServerSbeMessage;
};

type ServerSbeMessage = unit {
    sbe_header: SbeHeader;
    switch ( self.sbe_header.template_id ) {
        TemplateId::ExecutionReportNewMessage -> execution_report_new_message: ExecutionReportNewMessage;
        TemplateId::ExecutionReportBulkQuotePendingNewMessage -> execution_report_bulk_quote_pending_new_message: ExecutionReportBulkQuotePendingNewMessage;
        TemplateId::ExecutionReportBulkQuoteComponentNewMessage -> execution_report_bulk_quote_component_new_message: ExecutionReportBulkQuoteComponentNewMessage;
        TemplateId::ExecutionReportRejectedMessage -> execution_report_rejected_message: ExecutionReportRejectedMessage;
        TemplateId::ExecutionReportTradeMessage -> execution_report_trade_message: ExecutionReportTradeMessage;
        TemplateId::ExecutionReportPendingCancelMessage -> execution_report_pending_cancel_message: ExecutionReportPendingCancelMessage;
        TemplateId::ExecutionReportCanceledMessage -> execution_report_canceled_message: ExecutionReportCanceledMessage;
        TemplateId::ExecutionReportPendingReplaceMessage -> execution_report_pending_replace_message: ExecutionReportPendingReplaceMessage;
        TemplateId::ExecutionReportReplacedMessage -> execution_report_replaced_message: ExecutionReportReplacedMessage;
        TemplateId::ExecutionReportTradeCorrectionMessage -> execution_report_trade_correction_message: ExecutionReportTradeCorrectionMessage;
        TemplateId::ExecutionReportTradeBreakMessage -> execution_report_trade_break_message: ExecutionReportTradeBreakMessage;
        TemplateId::ExecutionReportRestatementMessage -> execution_report_restatement_message: ExecutionReportRestatementMessage;
        TemplateId::PendingMassCancelMessage -> pending_mass_cancel_message: PendingMassCancelMessage;
        TemplateId::MassCancelRejectMessage -> mass_cancel_reject_message: MassCancelRejectMessage;
        TemplateId::MassCancelDoneMessage -> mass_cancel_done_message: MassCancelDoneMessage;
        TemplateId::OrderCancelRejectMessage -> order_cancel_reject_message: OrderCancelRejectMessage;
        TemplateId::AllocationInstructionAckMessage -> allocation_instruction_ack_message: AllocationInstructionAckMessage;
        TemplateId::AllocationInstructionAlertMessage -> allocation_instruction_alert_message: AllocationInstructionAlertMessage;
        TemplateId::UserNotificationMessage -> user_notification_message: UserNotificationMessage;
        TemplateId::MassCancelClearLockoutRejectMessage -> mass_cancel_clear_lockout_reject_message: MassCancelClearLockoutRejectMessage;
        TemplateId::MassCancelClearLockoutDoneMessage -> mass_cancel_clear_lockout_done_message: MassCancelClearLockoutDoneMessage;
        TemplateId::MassCancelBulkClearLockoutRejectMessage -> mass_cancel_bulk_clear_lockout_reject_message: MassCancelBulkClearLockoutRejectMessage;
        TemplateId::MassCancelBulkClearLockoutAcceptedMessage -> mass_cancel_bulk_clear_lockout_accepted_message: MassCancelBulkClearLockoutAcceptedMessage;
        * -> unknown: bytes &eod;
    };
};

type SbeHeader = unit {
    block_length: uint16;
    template_id: uint8 &convert=TemplateId($$);
    schema_id: uint8;
    version: uint16;
};

type ExecutionReportNewMessage = unit {
    order_id: uint64;
    clordid: bytes &size=20;
    list_seq_no: uint8;
    exec_id: uint64;
    ord_status: uint8 &convert=OrdStatus($$);
    security_id: bytes &size=8;
    side: uint8 &convert=Side($$);
    order_qty: uint32;
    ord_type: uint8 &convert=OrdType($$);
    price_optional: uint64;
    time_in_force: uint8 &convert=TimeInForce($$);
    position_effect_optional: uint8 &convert=PositionEffectOptional($$);
    exec_inst: ExecInst;
    trading_capacity: uint8 &convert=TradingCapacity($$);
    reprice_frequency: uint8 &convert=RepriceFrequency($$);
    reprice_behavior: uint8 &convert=RepriceBehavior($$);
    leaves_qty: uint32;
    cum_qty: uint32;
    sending_time: uint64;
    transact_time: uint64;
    mtp_group_id: uint16;
    match_trade_prevention: uint8 &convert=MatchTradePrevention($$);
    cancel_group_id: uint16;
    risk_group_id: uint16;
    parties_groups: PartiesGroups;
};

type ExecInst = unit {
    participate_do_not_initiate: bytes &size=1;
    intermarket_sweep: bytes &size=1;
    external_routing_not_allowed: bytes &size=1;
    reserved_13: bytes &size=2;
};

type PartiesGroups = unit {
    repeating_group_dimensions: RepeatingGroupDimensions;
    parties_group: PartiesGroup[self.repeating_group_dimensions.num_in_group];
};

type RepeatingGroupDimensions = unit {
    block_length_short: uint8;
    num_in_group: uint8;
};

type PartiesGroup = unit {
    party_id: bytes &size=16;
    party_id_source: bytes &size=1;
    party_role: uint8 &convert=PartyRole($$);
};

type ExecutionReportBulkQuotePendingNewMessage = unit {
    clordid: bytes &size=20;
    symbol: bytes &size=6;
    time_in_force: uint8 &convert=TimeInForce($$);
    exec_inst: ExecInst;
    trading_capacity: uint8 &convert=TradingCapacity($$);
    sending_time: uint64;
    transact_time: uint64;
    mtp_group_id: uint16;
    match_trade_prevention: uint8 &convert=MatchTradePrevention($$);
    cancel_group_id: uint16;
    risk_group_id: uint16;
    number_of_orders: uint8;
    parties_groups: PartiesGroups;
};

type ExecutionReportBulkQuoteComponentNewMessage = unit {
    order_id: uint64;
    clordid: bytes &size=20;
    list_seq_no: uint8;
    exec_id: uint64;
    ord_status: uint8 &convert=OrdStatus($$);
    security_id: bytes &size=8;
    side: uint8 &convert=Side($$);
    order_qty: uint32;
    price_optional: uint64;
    leaves_qty: uint32;
