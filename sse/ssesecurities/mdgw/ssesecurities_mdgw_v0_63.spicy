module SseSsesecuritiesMdgwIs120V063;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type SsesecuritiesMdgwV063 = unit {
    binary_message: BinaryMessage[] &eod;
};

type BinaryMessage = unit {
    standard_header: StandardHeader;
    switch ( self.standard_header.msgtype.strip() ) {
        b"S001" -> logon_message: LogonMessage;
        b"S002" -> logout_message: LogoutMessage;
        b"P001" -> channel_heartbeat: ChannelHeartbeat;
        b"P002" -> retransmission_message: RetransmissionMessage;
        b"M101" -> market_status_message: MarketStatusMessage;
        b"M102" -> market_data_snapshot_message: MarketDataSnapshotMessage;
        b"M201" -> tickbytick_market_data_message: TickbytickMarketDataMessage;
        * -> unknown: bytes &eod;
    };
    standard_trailer: StandardTrailer;
};

type StandardHeader = unit {
    msgtype: bytes &size=4;
    sendingtime: uint64;
    msgseqnum: uint64;
    bodylength: uint32;
};

type LogonMessage = unit {
    sendercompid: bytes &size=32;
    targetcompid: bytes &size=32;
    heartbtint: uint16;
    applverid: bytes &size=8;
};

type LogoutMessage = unit {
    sessionstatus: uint32 &convert=Sessionstatus($$);
    text: bytes &size=256;
};

type ChannelHeartbeat = unit {
    channel_heartbeat_securitytype: uint8 &convert=ChannelHeartbeatSecuritytype($$);
    channel_heartbeat_channelno: uint16 &convert=ChannelHeartbeatChannelno($$);
    appllastseqnum: uint64;
    endofchannel: uint8 &convert=Endofchannel($$);
};

type RetransmissionMessage = unit {
    retransmission_message_channelno: uint16 &convert=RetransmissionMessageChannelno($$);
    resendtype: uint8 &convert=Resendtype($$);
    applbegseqnum: uint64;
    applendseqnum: uint64;
    resendstatus: uint8 &convert=Resendstatus($$);
    rejecttext: bytes &size=32;
};

type MarketStatusMessage = unit {
    market_status_message_securitytype: uint8 &convert=MarketStatusMessageSecuritytype($$);
    tradsesmode: uint8 &convert=Tradsesmode($$);
    tradingsessionid: bytes &size=8;
    totnorelatedsym: uint32;
};

type MarketDataSnapshotMessage = unit {
    market_data_snapshot_message_securitytype: uint8 &convert=MarketDataSnapshotMessageSecuritytype($$);
    tradsesmode: uint8 &convert=Tradsesmode($$);
    tradedate: uint32;
    lastupdatetime: uint32;
    mdstreamid: bytes &size=5;
    securityid: bytes &size=8;
    symbol: bytes &size=8;
    preclosepx: uint64;
    totalvolumetraded: uint64;
    numtrades: uint64;
    market_data_snapshot_message_totalvaluetraded: uint64;
    tradingphasecode: bytes &size=8;
    switch ( self.mdstreamid.strip() ) {
        b"MD001" -> index_market_data_snapshot_extension_fields: IndexMarketDataSnapshotExtensionFields;
        b"MD002" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        b"MD003" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        b"MD004" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        b"MD101" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        b"MD102" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        b"MD301" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        b"MD201" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        b"MDE01" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        b"MD210" -> market_data_snapshot_extension_fields: MarketDataSnapshotExtensionFields;
        * -> unknown: bytes &eod;
    };
};

type IndexMarketDataSnapshotExtensionFields = unit {
    nomdentries: uint16;
    index_market_data_snapshot_entries: IndexMarketDataSnapshotEntries[self.nomdentries];
};

type IndexMarketDataSnapshotEntries = unit {
    index_market_data_snapshot_entries_mdentrytype: bytes &size=2;
    index_market_data_snapshot_entries_mdentrypx: uint64;
};

type MarketDataSnapshotExtensionFields = unit {
    nomdentries: uint16;
    market_data_snapshot_entries: MarketDataSnapshotEntries[self.nomdentries];
};

type MarketDataSnapshotEntries = unit {
    market_data_snapshot_entries_mdentrytype: bytes &size=2;
    market_data_snapshot_entries_mdentrypx: uint64;
    mdentrysize: uint64;
    mdentrypositionno: uint8;
};

type TickbytickMarketDataMessage = unit {
    tickbytick_market_data_message_securitytype: uint8 &convert=TickbytickMarketDataMessageSecuritytype($$);
    tickbytick_market_data_message_channelno: uint16;
    applseqnum: uint64;
    mdstreamid: bytes &size=5;
    securityid: bytes &size=8;
    transacttime: uint32;
    exectype: uint8 &convert=Exectype($$);
    price: uint64;
    orderqty: uint64;
    switch ( self.mdstreamid.strip() ) {
        b"MD211" -> tickbytick_order_market_data_extension_fields: TickbytickOrderMarketDataExtensionFields;
        b"MD212" -> tickbytick_order_market_data_extension_fields: TickbytickOrderMarketDataExtensionFields;
        b"MD213" -> tickbytick_order_market_data_extension_fields: TickbytickOrderMarketDataExtensionFields;
        b"MD214" -> tickbytick_order_market_data_extension_fields: TickbytickOrderMarketDataExtensionFields;
        b"MD215" -> tickbytick_order_market_data_extension_fields: TickbytickOrderMarketDataExtensionFields;
        b"MD216" -> tickbytick_order_market_data_extension_fields: TickbytickOrderMarketDataExtensionFields;
        b"MD217" -> tickbytick_trade_market_data_extension_fields: TickbytickTradeMarketDataExtensionFields;
        * -> unknown: bytes &eod;
    };
};

type TickbytickOrderMarketDataExtensionFields = unit {
    side: uint8 &convert=Side($$);
    quoteid: bytes &size=18;
    memberid: bytes &size=12;
    tradercode: bytes &size=12;
    fullamounttrade: uint8 &convert=Fullamounttrade($$);
    settltype: uint8 &convert=Settltype($$);
    contractmultiplier: uint32;
    expirationdays: uint16;
    tickbytick_order_market_data_extension_fields_totalvaluetraded: uint64;
    basketid: bytes &size=16;
    investorname: bytes &size=32;
    bidtranstype: uint8 &convert=Bidtranstype($$);
    bidexecinsttype: uint8 &convert=Bidexecinsttype($$);
    expiredate: uint32;
    secondaryorderid: bytes &size=18;
    minqty: uint64;
};

type TickbytickTradeMarketDataExtensionFields = unit {
    bidapplseqnum: bytes &size=18;
    offerapplseqnum: bytes &size=18;
    tickbytick_trade_market_data_extension_fields_totalvaluetraded: uint64;
    trademethod: uint8 &convert=Trademethod($$);
    marginprice: uint64;
};

type StandardTrailer = unit {
    checksum: uint32;
};

