    ask_level_2_volume: bytes &size=12;
    bid_level_2_volume: bytes &size=12;
    lp_ask_level_2_volume: bytes &size=12;
    lp_bid_level_2_volume: bytes &size=12;
    ask_level_3_price: bytes &size=11;
    bid_level_3_price: bytes &size=11;
    ask_level_3_volume: bytes &size=12;
    bid_level_3_volume: bytes &size=12;
