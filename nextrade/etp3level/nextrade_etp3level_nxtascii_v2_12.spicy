module NextradeNextradeEtp3levelNxtasciiV212;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NextradeEtp3levelV212 = unit {
    tr_code: bytes &size=5;
    switch ( self.tr_code ) {
        0 -> polling_data_message: PollingDataMessage;
        0 -> securities_quote_mm_lp_quotes_included_3_level_message: SecuritiesQuoteMmLpQuotesIncluded3LevelMessage;
        0 -> securities_order_filled_plus_quote_mm_lp_quotes_included_3_level_message: SecuritiesOrderFilledPlusQuoteMmLpQuotesIncluded3LevelMessage;
        0 -> market_operation_ts_plus_quote_mm_lp_quotes_included_3_level_message: MarketOperationTsPlusQuoteMmLpQuotesIncluded3LevelMessage;
        0 -> securities_order_filled_message: SecuritiesOrderFilledMessage;
        0 -> market_operation_ts_message: MarketOperationTsMessage;
        0 -> issue_closing_message: IssueClosingMessage;
        0 -> triggering_removing_vi_message: TriggeringRemovingViMessage;
        0 -> closing_price_trading_quote_message: ClosingPriceTradingQuoteMessage;
        * -> unknown: bytes &eod;
    };
};

type PollingDataMessage = unit {
    current_time_1_minute_interval: bytes &size=4;
    end_keyword: bytes &size=1;
};

