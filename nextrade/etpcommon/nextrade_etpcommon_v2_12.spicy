module NextradeNextradeEtpcommonNxtasciiV212;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NextradeEtpcommonV212 = unit {
    tr_code: bytes &size=5;
    switch ( self.tr_code ) {
        0 -> polling_data_message: PollingDataMessage;
        0 -> securities_quote_mm_lp_quotes_included_10_level_message: SecuritiesQuoteMmLpQuotesIncluded10LevelMessage;
        0 -> securities_order_filled_message: SecuritiesOrderFilledMessage;
        0 -> market_operation_ts_message: MarketOperationTsMessage;
        0 -> issue_closing_message: IssueClosingMessage;
        0 -> triggering_removing_vi_message: TriggeringRemovingViMessage;
        0 -> closing_price_trading_quote_message: ClosingPriceTradingQuoteMessage;
        0 -> equities_snapshot_mm_lp_quotes_included_10_level_message: EquitiesSnapshotMmLpQuotesIncluded10LevelMessage;
        0 -> investor_activities_per_commodities_message: InvestorActivitiesPerCommoditiesMessage;
        0 -> etp_constituents_message: EtpConstituentsMessage;
        0 -> etp_constituents_message: EtpConstituentsMessage;
        0 -> mm_lp_information_message: MmLpInformationMessage;
        0 -> mm_lp_information_message: MmLpInformationMessage;
        0 -> market_operation_schedule_message: MarketOperationScheduleMessage;
        0 -> member_firm_imposing_lifting_sanctions_message: MemberFirmImposingLiftingSanctionsMessage;
        0 -> top_five_traders_activities_message: TopFiveTradersActivitiesMessage;
        0 -> equities_batch_data_message: EquitiesBatchDataMessage;
        0 -> equities_batch_data_message: EquitiesBatchDataMessage;
        0 -> member_information_message: MemberInformationMessage;
        0 -> member_information_message: MemberInformationMessage;
        0 -> issue_event_message: IssueEventMessage;
        0 -> issue_event_message: IssueEventMessage;
        0 -> block_basket_trade_data_message: BlockBasketTradeDataMessage;
        0 -> investor_activities_per_an_issue_eod_message: InvestorActivitiesPerAnIssueEodMessage;
        0 -> short_selling_message: ShortSellingMessage;
        0 -> brokers_acitity_information_message: BrokersAcitityInformationMessage;
        0 -> trading_activity_by_session_per_an_issue_message: TradingActivityBySessionPerAnIssueMessage;
        * -> unknown: bytes &eod;
    };
};

