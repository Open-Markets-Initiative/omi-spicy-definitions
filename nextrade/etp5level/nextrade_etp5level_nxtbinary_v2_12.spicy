module NextradeNextradeEtp5levelNxtbinaryV212;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type NextradeEtp5levelV212 = unit {
    tr_code: bytes &size=5;
    switch ( self.tr_code ) {
        0 -> polling_data_message: PollingDataMessage;
        0 -> securities_quote_mm_lp_quotes_included_5_level_message: SecuritiesQuoteMmLpQuotesIncluded5LevelMessage;
        0 -> securities_order_filled_plus_quote_mm_lp_quotes_included_5_level_message: SecuritiesOrderFilledPlusQuoteMmLpQuotesIncluded5LevelMessage;
        0 -> market_operation_ts_plus_quote_mm_lp_quotes_included_5_level_message: MarketOperationTsPlusQuoteMmLpQuotesIncluded5LevelMessage;
        0 -> securities_order_filled_message: SecuritiesOrderFilledMessage;
        0 -> market_operation_ts_message: MarketOperationTsMessage;
        0 -> issue_closing_message: IssueClosingMessage;
        0 -> triggering_removing_vi_message: TriggeringRemovingViMessage;
        0 -> closing_price_trading_quote_message: ClosingPriceTradingQuoteMessage;
        * -> unknown: bytes &eod;
    };
};

type PollingDataMessage = unit {
    current_time_1_minute_interval: bytes &size=4;
    end_keyword: int32;
};

