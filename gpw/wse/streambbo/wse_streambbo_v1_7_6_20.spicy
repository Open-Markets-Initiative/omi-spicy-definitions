import spicy;

%byte-order = spicy::ByteOrder::Little;

public type WseStreambboV17620 = unit {
    message: Message[] &eod;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::WeekPlan -> week_plan: WeekPlan;
        MessageType::CalendarException -> calendar_exception: CalendarException;
        MessageType::TickTableEntry -> tick_table_entry: TickTableEntry;
        MessageType::CollarTableEntry -> collar_table_entry: CollarTableEntry;
        MessageType::TradingPhaseScheduleEntry -> trading_phase_schedule_entry: TradingPhaseScheduleEntry;
        MessageType::MarketStructure -> market_structure: MarketStructure;
        MessageType::CollarGroup -> collar_group: CollarGroup;
        MessageType::ExternalUnderlying -> external_underlying: ExternalUnderlying;
        MessageType::Instrument -> instrument: Instrument;
        MessageType::AccruedInterestTableEntry -> accrued_interest_table_entry: AccruedInterestTableEntry;
        MessageType::IndexationTableEntry -> indexation_table_entry: IndexationTableEntry;
        MessageType::IndexParams -> index_params: IndexParams;
        MessageType::IndexPortfolioEntry -> index_portfolio_entry: IndexPortfolioEntry;
        MessageType::AuctionSummary -> auction_summary: AuctionSummary;
        MessageType::AuctionUpdate -> auction_update: AuctionUpdate;
        MessageType::PriceLevelSnapshot -> price_level_snapshot: PriceLevelSnapshot;
        MessageType::TopPriceLevelUpdate -> top_price_level_update: TopPriceLevelUpdate;
        MessageType::Trade -> trade: Trade;
        MessageType::PositionReport -> position_report: PositionReport;
        MessageType::InstrumentStatusChange -> instrument_status_change: InstrumentStatusChange;
        MessageType::OrderCollars -> order_collars: OrderCollars;
        MessageType::TradeCollars -> trade_collars: TradeCollars;
        MessageType::InstrumentSummary -> instrument_summary: InstrumentSummary;
        MessageType::ProductSummary -> product_summary: ProductSummary;
        MessageType::PriceUpdate -> price_update: PriceUpdate;
        MessageType::News -> news: News;
        MessageType::RealTimeIndex -> real_time_index: RealTimeIndex;
        MessageType::IndexSummary -> index_summary: IndexSummary;
        MessageType::TradingSessionStatus -> trading_session_status: TradingSessionStatus;
        MessageType::TestEvent -> test_event: TestEvent;
        * -> unknown: bytes &eod;
    };
};

