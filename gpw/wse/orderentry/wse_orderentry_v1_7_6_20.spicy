module GpwWseOrderentryWatsV17620;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type WseOrderentryV17620 = unit {
    message: Message[] &eod;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::Login -> login: Login;
        MessageType::LoginResponse -> login_response: LoginResponse;
        MessageType::ConnectionClose -> connection_close: ConnectionClose;
        MessageType::Reject -> reject_field: Reject;
        MessageType::Test -> test: Test;
        MessageType::TestEvent -> test_event: TestEvent;
        MessageType::TradingSessionStatus -> trading_session_status: TradingSessionStatus;
        MessageType::OrderAdd -> order_add: OrderAdd;
        MessageType::OrderAddResponse -> order_add_response: OrderAddResponse;
        MessageType::OrderCancel -> order_cancel: OrderCancel;
        MessageType::OrderCancelResponse -> order_cancel_response: OrderCancelResponse;
        MessageType::OrderModify -> order_modify: OrderModify;
        MessageType::OrderModifyResponse -> order_modify_response: OrderModifyResponse;
        MessageType::OrderMassCancel -> order_mass_cancel: OrderMassCancel;
        MessageType::OrderMassCancelResponse -> order_mass_cancel_response: OrderMassCancelResponse;
        MessageType::OrderExecute -> order_execute: OrderExecute;
        MessageType::MassQuote -> mass_quote: MassQuote;
        MessageType::MassQuoteResponse -> mass_quote_response: MassQuoteResponse;
        MessageType::MarketMakerCommand -> market_maker_command: MarketMakerCommand;
        MessageType::MarketMakerCommandResponse -> market_maker_command_response: MarketMakerCommandResponse;
        MessageType::RequestForExecution -> request_for_execution: RequestForExecution;
        MessageType::BidOfferUpdate -> bid_offer_update: BidOfferUpdate;
        MessageType::TradeCaptureReportSingle -> trade_capture_report_single: TradeCaptureReportSingle;
        MessageType::TradeCaptureReportDual -> trade_capture_report_dual: TradeCaptureReportDual;
        MessageType::TradeCaptureReportResponse -> trade_capture_report_response: TradeCaptureReportResponse;
        MessageType::TradeBust -> trade_bust: TradeBust;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
