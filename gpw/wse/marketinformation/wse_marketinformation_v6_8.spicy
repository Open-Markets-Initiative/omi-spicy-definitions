    system_id: uint32 &convert=SystemId($$);
    source_time_micro_secs: uint16;
    price_scale_code: uint8;
    variation_scale_code: uint8;
    im_volume: uint32;
};

type ShortSaleChangeMessage = unit {
    symbol_index: uint32;
    source_seq_num: uint32;
    source_time: uint32;
    system_id: uint32 &convert=SystemId($$);
    source_time_micro_secs: uint16;
    text_ascii_ch_100: bytes &size=100;
    authority: uint8 &convert=Authority($$);
