    ss_non_market_maker: uint8 &convert=SsNonMarketMaker($$);
    : skip bytes &size=3;   # padding
};

type GenericWseMessage = unit {
    source_seq_num: uint32;
    source_time: uint32;
    system_id: uint32 &convert=SystemId($$);
    source_time_micro_secs: uint16;
    source_data: bytes &size=1;
    internal_msg_type: bytes &size=2;
    event_date: bytes &size=8;
    instrument_id: bytes &size=12;
    instrument_group_code: bytes &size=3;
    msg_type_indicator: uint8 &convert=MsgTypeIndicator($$);
    language_version: uint8 &convert=LanguageVersion($$);
    type_off_recipient: bytes &size=1;
    msg_serial_num: bytes &size=1;
    switch ( self.internal_msg_type ) {
        InternalMsgType::TreasuryBondFuturesData -> treasury_bond_futures_data: TreasuryBondFuturesData;
        InternalMsgType::Kid -> kid: Kid;
        InternalMsgType::StressedMarketConditions -> market_conditions: MarketConditions;
        InternalMsgType::ExceptionalMarketConditions -> market_conditions: MarketConditions;
        * -> unknown: bytes &eod;
    };
};

type TreasuryBondFuturesData = unit {
    isin_code: bytes &size=12;
    date_of_first_quotation: bytes &size=8;
    short_name: bytes &size=16;
    date_ascii_str_8: bytes &size=8;
    underlying_isin_code: bytes &size=12;
    treasury_bond_1_isin_code: bytes &size=12;
    conversion_coefficient_factor_1: bytes &size=9;
    treasury_bond_2_isin_code: bytes &size=12;
    conversion_coefficient_factor_2: bytes &size=9;
    treasury_bond_3_isin_code: bytes &size=12;
    conversion_coefficient_factor_3: bytes &size=9;
    treasury_bond_4_isin_code: bytes &size=12;
    conversion_coefficient_factor_4: bytes &size=9;
    treasury_bond_5_isin_code: bytes &size=12;
    conversion_coefficient_factor_5: bytes &size=9;
    : skip bytes &size=59;   # padding
};

type Kid = unit {
    isin_code: bytes &size=12;
    type_of_instrument_ascii_str_4: bytes &size=4;
    kid_version: bytes &size=10;
