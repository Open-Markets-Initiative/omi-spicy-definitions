    : skip bytes &size=2;   # padding
    start_date_halting: bytes &size=8;
    start_time_halting: bytes &size=6;
    prog_opening_time: bytes &size=6;
    order_entry_rejection: uint8 &convert=OrderEntryRejection($$);
