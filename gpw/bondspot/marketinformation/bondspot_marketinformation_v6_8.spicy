    multiplier_scale_code: uint8;
    accumulated_interest_scale_code: uint8;
    opening_price_scale_code: uint8;
    maximum_price_scale_code: uint8;
    minimum_price_scale_code: uint8;
    closing_price_scale_code: uint8;
    implied_volatility_scale_code: uint8;
    average_weighted_price_scale_code: uint8;
    reference_price_scale_code: uint8;
    pct_change_price_scale_code: uint8;
    dividend_rate_scale_code: uint8;
    settlement_price_scale_code: uint8;
    settlement_value_scale_code: uint8;
    : skip bytes &size=1;   # padding
    trading_value_scale_code: uint8;
    currency_price_scale_code: uint8;
    delta_scale_code: uint8;
    gamma_scale_code: uint8;
    rho_scale_code: uint8;
    theta_scale_code: uint8;
    vega_scale_code: uint8;
    trading_value_currency_scale_code: uint8;
    interest_rate_scale_code: uint8;
    volatility_scale_code: uint8;
    strike_price_scale_code: uint8;
    value_short_selling_trades_scale_code: uint8;
    last_trade_price_scale_code: uint8;
