    vwap_blocktrade_scale_code: uint8;
    maximum_block_price_scale_code: uint8;
    minimum_block_price_scale_code: uint8;
    status_indicator: uint8 &convert=StatusIndicator($$);
    sector: bytes &size=3;
    market: uint8 &convert=Market($$);
    : skip bytes &size=1;   # padding
    short_sale: bytes &size=1;
    marker_pct_change_price: uint8 &convert=MarkerPctChangePrice($$);
    symbol_delta: uint8 &convert=SymbolDelta($$);
    symbol_gamma: uint8 &convert=SymbolGamma($$);
    symbol_rho: uint8 &convert=SymbolRho($$);
    symbol_theta: uint8 &convert=SymbolTheta($$);
    symbol_vega: uint8 &convert=SymbolVega($$);
    : skip bytes &size=1;   # padding
    : skip bytes &size=1;   # padding
    : skip bytes &size=1;   # padding
    : skip bytes &size=1;   # padding
    : skip bytes &size=1;   # padding
    : skip bytes &size=1;   # padding
    segment: bytes &size=2;
