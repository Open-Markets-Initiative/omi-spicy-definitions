module TmxTsxQuantumfeedlevel2recoveryXmtV36Client;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type TsxQuantumfeedlevel2recoveryV36 = unit {
    client_frame: ClientFrame[] &eod;
};

type ClientFrame = unit {
    frame_header: FrameHeader;
    switch ( self.client_body.heartbeat_body.body_header.msg_type ) {
        MsgType::Heartbeat -> heartbeat_body: HeartbeatBody(self.frame_header.num_body);
        MsgType::LoginRequest -> login_request: LoginRequest;
        MsgType::Logout -> logout: Logout;
        MsgType::ReplayRequest -> replay_request: ReplayRequest(self.frame_header.num_body);
        * -> unknown: bytes &eod;
    };
};

type FrameHeader = unit {
    start_of_frame: uint8;
    protocol_name: bytes &size=1;
    protocol_version: bytes &size=1;
    message_length: uint16;
    session_id: uint32;
    ack_required_poss_dup: uint8 &convert=AckRequiredPossDup($$);
    num_body: uint8;
};

type HeartbeatBody = unit(num_body: uint8) {
    body_header: BodyHeader;
    admin_id: uint8;
    hb_interval: uint16;
    admin_body: AdminBody[num_body];
};

type BodyHeader = unit {
    msg_length: uint16;
    msg_type: uint8 &convert=MsgType($$);
};

type AdminBody = unit {
    source_id: uint8 &convert=SourceId($$);
    stream_id: uint16;
    sequence_0: uint8;
    sequence_1: uint32;
};

type LoginRequest = unit {
    body_header: BodyHeader;
    admin_id: uint8;
    hb_interval: uint16;
    replay_win_size: uint16;
    replay_win_num: uint16;
    credits: uint16;
};

type Logout = unit {
    body_header: BodyHeader;
    admin_id: uint8;
};

type ReplayRequest = unit(num_body: uint8) {
    body_header: BodyHeader;
    admin_id: uint8;
    replay_session_id: uint32;
    replay_range: ReplayRange[num_body];
};

type ReplayRange = unit {
    source_id: uint8 &convert=SourceId($$);
    stream_id: uint16;
    sequence_0: uint8;
    sequence_1_start: uint32;
    sequence_1_end: uint32;
};

type AckRequiredPossDup = enum {
    AckRequired = 0x41,
    PossDup = 0x44,
};

type MsgType = enum {
    Heartbeat = 0x30,
    LoginRequest = 0x31,
    LoginResponse = 0x32,
    Logout = 0x33,
    Ack = 0x34,
    ReplayRequest = 0x35,
    SequenceJump = 0x36,
    Reject = 0x39,
    SymbolStatusMessage = 0x4a,
    OrderBookMessage = 0x47,
    OrderBookTermsMessage = 0x6a,
    AssignCopOrdersMessage = 0x41,
    AssignCopNoOrdersMessage = 0x42,
    AssignLimitMessage = 0x43,
    MarketStateUpdateMessage = 0x45,
    MocImbalanceMessage = 0x46,
    OrderBookedMessage = 0x50,
    OrderBookedTermsMessage = 0x6d,
    OrderCancelledMessage = 0x51,
    OrderCancelledTermsMessage = 0x6e,
    OrderPriceTimeAssignedMessage = 0x52,
    OrderPriceTimeAssignedTermsMessage = 0x6f,
    StockStatusMessage = 0x49,
    TradeReportMessage = 0x53,
    TradeReportTermsMessage = 0x70,
    TradeCancelledMessage = 0x54,
    TradeCancelledTermsMessage = 0x71,
    TradeCorrectionMessage = 0x55,
    TradeCorrectionTermsMessage = 0x72,
};

type SourceId = enum {
    NonSourceRelated = 0x30,
    Tsx = 0x51,
    TsxVenture = 0x56,
    Alpha = 0x41,
};

