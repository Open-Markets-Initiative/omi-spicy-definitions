type OptionInstrumentKeysMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    option_symbol: OptionSymbol;
    strike_price_currency: bytes &size=3;
    maximum_number_of_contracts_per_order: bytes &size=6;
    minimum_number_of_contracts_per_order: bytes &size=6;
    maximum_threshold_price: bytes &size=7;
    maximum_threshold_price_fraction_indicator: uint8 &convert=MaximumThresholdPriceFractionIndicator($$);
    minimum_threshold_price: bytes &size=7;
    minimum_threshold_price_fraction_indicator: uint8 &convert=MinimumThresholdPriceFractionIndicator($$);
    switch ( self.tick_increment.tick_increment_numeric_pair.tick_increment_fraction_indicator ) {
        TickIncrementFractionIndicator::Whole -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::Ten -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::Hundred -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::Thousand -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::TenThousand -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::HundredThousand -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::Million -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::TenMillion -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::HundredMillion -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::Billion -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::NegativeWhole -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::NegativeTen -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::NegativeHundred -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::NegativeThousand -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::NegativeTenThousand -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::NegativeHundredThousand -> tick_increment_numeric_pair: TickIncrementNumericPair;
        TickIncrementFractionIndicator::NegativeMillion -> tick_increment_numeric_pair: TickIncrementNumericPair;
        * -> tick_increment_raw_pair: TickIncrementRawPair;
    };
    option_type: uint8 &convert=OptionType($$);
    market_flow_indicator: bytes &size=2;
    group_instrument: bytes &size=2;
    instrument: bytes &size=4;
    instrument_external_code: bytes &size=30;
