type OptionMarketDepthMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    option_symbol: OptionSymbol;
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
    number_of_level: bytes &size=1;
    market_depth_level: MarketDepthLevel[self.number_of_level];
};

type MarketDepthLevel = unit {
    level_of_market_depth: uint8 &convert=LevelOfMarketDepth($$);
    switch ( self.bid_price_quote.bid_price_quote_opening_pair.bid_price_quote_opening ) {
        0 -> bid_price_quote_opening_pair: BidPriceQuoteOpeningPair;
        * -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
    };
    bid_size: bytes &size=5;
    number_of_bid_orders: bytes &size=2;
    switch ( self.ask_price_quote.ask_price_quote_opening_pair.ask_price_quote_opening ) {
        0 -> ask_price_quote_opening_pair: AskPriceQuoteOpeningPair;
        * -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
    };
    ask_size: bytes &size=5;
    number_of_ask_orders: bytes &size=2;
};

type FutureOptionsMarketDepthMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    future_option_symbol: FutureOptionSymbol;
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
    number_of_level: bytes &size=1;
    market_depth_level: MarketDepthLevel[self.number_of_level];
};

type FuturesMarketDepthMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    future_product: FutureProduct;
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
    number_of_level: bytes &size=1;
    futures_market_depth_level: FuturesMarketDepthLevel[self.number_of_level];
};

type FuturesMarketDepthLevel = unit {
    level_of_market_depth: uint8 &convert=LevelOfMarketDepth($$);
    switch ( self.bid_price_quote.bid_price_quote_opening_pair.bid_price_quote_opening ) {
        0 -> bid_price_quote_opening_pair: BidPriceQuoteOpeningPair;
        * -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
    };
    bid_size: bytes &size=5;
    number_of_bid_orders: bytes &size=2;
    switch ( self.ask_price_futures_depth_market_depth_level_hf.ask_price_futures_depth_market_depth_level_hf_opening_pair.ask_price_futures_depth_opening ) {
        0 -> ask_price_futures_depth_market_depth_level_hf_opening_pair: AskPriceFuturesDepthMarketDepthLevelHfOpeningPair;
        * -> ask_price_futures_depth_market_depth_level_hf_numeric_pair: AskPriceFuturesDepthMarketDepthLevelHfNumericPair;
    };
    ask_size: bytes &size=5;
    number_of_ask_orders: bytes &size=2;
};

type AskPriceFuturesDepthMarketDepthLevelHfOpeningPair = unit {
    ask_price_futures_depth_opening: bytes &size=7;
    ask_price_fraction_indicator: uint8 &convert=AskPriceFractionIndicator($$);
};

type AskPriceFuturesDepthMarketDepthLevelHfNumericPair = unit {
    ask_price_futures_depth_numeric: bytes &size=7;
    ask_price_fraction_indicator: uint8 &convert=AskPriceFractionIndicator($$);
};

type StrategyMarketDepthMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    symbol: bytes &size=30;
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
    number_of_level: bytes &size=1;
    strategy_market_depth_level: StrategyMarketDepthLevel[self.number_of_level];
};

type StrategyMarketDepthLevel = unit {
    level_of_market_depth: uint8 &convert=LevelOfMarketDepth($$);
    bid_price_sign: uint8 &convert=BidPriceSign($$);
    switch ( self.bid_price_quote.bid_price_quote_opening_pair.bid_price_quote_opening ) {
        0 -> bid_price_quote_opening_pair: BidPriceQuoteOpeningPair;
        * -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
    };
    bid_size: bytes &size=5;
    number_of_bid_orders: bytes &size=2;
    ask_price_sign: uint8 &convert=AskPriceSign($$);
    switch ( self.ask_price_quote.ask_price_quote_opening_pair.ask_price_quote_opening ) {
        0 -> ask_price_quote_opening_pair: AskPriceQuoteOpeningPair;
        * -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
    };
    ask_size: bytes &size=5;
    number_of_ask_orders: bytes &size=2;
};

type OptionTradeCancellationMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    option_symbol: OptionSymbol;
    volume: bytes &size=8;
    trade_price: bytes &size=7;
    trade_price_fraction_indicator: uint8 &convert=TradePriceFractionIndicator($$);
    : skip bytes &size=6;   # padding
    trade_timestamp: bytes &size=9;
    : skip bytes &size=1;   # padding
    price_indicator_marker: uint8 &convert=PriceIndicatorMarker($$);
    trade_number: bytes &size=8;
};

