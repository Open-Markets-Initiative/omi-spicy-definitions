type OptionQuoteMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    option_symbol: OptionSymbol;
    # Bid Price Quote is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Bid Price Quote Opening says (Bid Price Quote Opening Pair, Bid Price Quote Numeric Negative Whole Pair, Bid Price Quote Numeric Negative Ten Pair, Bid Price Quote Numeric Negative Hundred Pair, Bid Price Quote Numeric Negative Thousand Pair, Bid Price Quote Numeric Negative Ten Thousand Pair, Bid Price Quote Numeric Negative Hundred Thousand Pair, Bid Price Quote Numeric Negative Million Pair, Bid Price Quote Numeric Pair). They are parsed as BidPriceQuoteNumericPair, so which arm applies is left to what is built on the definition.
    bid_price_quote: BidPriceQuoteNumericPair;
    bid_size: bytes &size=5;
    # Ask Price Quote is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Ask Price Quote Opening says (Ask Price Quote Opening Pair, Ask Price Quote Numeric Negative Whole Pair, Ask Price Quote Numeric Negative Ten Pair, Ask Price Quote Numeric Negative Hundred Pair, Ask Price Quote Numeric Negative Thousand Pair, Ask Price Quote Numeric Negative Ten Thousand Pair, Ask Price Quote Numeric Negative Hundred Thousand Pair, Ask Price Quote Numeric Negative Million Pair, Ask Price Quote Numeric Pair). They are parsed as AskPriceQuoteNumericPair, so which arm applies is left to what is built on the definition.
    ask_price_quote: AskPriceQuoteNumericPair;
    ask_size: bytes &size=5;
    : skip bytes &size=1;   # padding
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
};

