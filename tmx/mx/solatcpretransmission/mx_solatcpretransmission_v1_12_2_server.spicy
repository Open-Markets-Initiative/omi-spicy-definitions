type FutureOptionsSummaryMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    future_option_symbol: FutureOptionSymbol;
    # Bid Price Summary Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Bid Price Fraction Indicator says (Bid Price Summary Negative Whole Pair, Bid Price Summary Negative Ten Pair, Bid Price Summary Negative Hundred Pair, Bid Price Summary Negative Thousand Pair, Bid Price Summary Negative Ten Thousand Pair, Bid Price Summary Negative Hundred Thousand Pair, Bid Price Summary Negative Million Pair, Bid Price Summary Numeric Pair). They are parsed as BidPriceSummaryNumericPair, so which arm applies is left to what is built on the definition.
    bid_price_summary_fraction_pair: BidPriceSummaryNumericPair;
    bid_size: bytes &size=5;
    # Ask Price Summary Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Ask Price Fraction Indicator says (Ask Price Summary Negative Whole Pair, Ask Price Summary Negative Ten Pair, Ask Price Summary Negative Hundred Pair, Ask Price Summary Negative Thousand Pair, Ask Price Summary Negative Ten Thousand Pair, Ask Price Summary Negative Hundred Thousand Pair, Ask Price Summary Negative Million Pair, Ask Price Summary Numeric Pair). They are parsed as AskPriceSummaryNumericPair, so which arm applies is left to what is built on the definition.
    ask_price_summary_fraction_pair: AskPriceSummaryNumericPair;
    ask_size: bytes &size=5;
    # Last Price Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Last Price Fraction Indicator says (Last Price Negative Whole Pair, Last Price Negative Ten Pair, Last Price Negative Hundred Pair, Last Price Negative Thousand Pair, Last Price Negative Ten Thousand Pair, Last Price Negative Hundred Thousand Pair, Last Price Negative Million Pair, Last Price Numeric Pair). They are parsed as LastPriceNumericPair, so which arm applies is left to what is built on the definition.
    last_price_fraction_pair: LastPriceNumericPair;
    open_interest: bytes &size=7;
    open_interest_date: bytes &size=6;
    tick: uint8 &convert=Tick($$);
    volume: bytes &size=8;
    net_change_sign: uint8 &convert=NetChangeSign($$);
    # Net Change Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Net Change Fraction Indicator says (Net Change Negative Whole Pair, Net Change Negative Ten Pair, Net Change Negative Hundred Pair, Net Change Negative Thousand Pair, Net Change Negative Ten Thousand Pair, Net Change Negative Hundred Thousand Pair, Net Change Negative Million Pair, Net Change Numeric Pair). They are parsed as NetChangeNumericPair, so which arm applies is left to what is built on the definition.
    net_change_fraction_pair: NetChangeNumericPair;
    # Opening Price Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Opening Price Fraction Indicator says (Opening Price Negative Whole Pair, Opening Price Negative Ten Pair, Opening Price Negative Hundred Pair, Opening Price Negative Thousand Pair, Opening Price Negative Ten Thousand Pair, Opening Price Negative Hundred Thousand Pair, Opening Price Negative Million Pair, Opening Price Numeric Pair). They are parsed as OpeningPriceNumericPair, so which arm applies is left to what is built on the definition.
    opening_price_fraction_pair: OpeningPriceNumericPair;
    # High Price Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which High Price Fraction Indicator says (High Price Negative Whole Pair, High Price Negative Ten Pair, High Price Negative Hundred Pair, High Price Negative Thousand Pair, High Price Negative Ten Thousand Pair, High Price Negative Hundred Thousand Pair, High Price Negative Million Pair, High Price Numeric Pair). They are parsed as HighPriceNumericPair, so which arm applies is left to what is built on the definition.
    high_price_fraction_pair: HighPriceNumericPair;
    # Low Price Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Low Price Fraction Indicator says (Low Price Negative Whole Pair, Low Price Negative Ten Pair, Low Price Negative Hundred Pair, Low Price Negative Thousand Pair, Low Price Negative Ten Thousand Pair, Low Price Negative Hundred Thousand Pair, Low Price Negative Million Pair, Low Price Numeric Pair). They are parsed as LowPriceNumericPair, so which arm applies is left to what is built on the definition.
    low_price_fraction_pair: LowPriceNumericPair;
    : skip bytes &size=2;   # padding
    # Settlement Price Future Options Summary Message Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Settlement Price Fraction Indicator says (Settlement Price Future Options Summary Message Negative Whole Pair, Settlement Price Future Options Summary Message Negative Ten Pair, Settlement Price Future Options Summary Message Negative Hundred Pair, Settlement Price Future Options Summary Message Negative Thousand Pair, Settlement Price Future Options Summary Message Negative Ten Thousand Pair, Settlement Price Future Options Summary Message Negative Hundred Thousand Pair, Settlement Price Future Options Summary Message Negative Million Pair, Settlement Price Future Options Summary Message Numeric Pair). They are parsed as SettlementPriceFutureOptionsSummaryMessageNumericPair, so which arm applies is left to what is built on the definition.
    settlement_price_future_options_summary_message_fraction_pair: SettlementPriceFutureOptionsSummaryMessageNumericPair;
    # Previous Settlement Price Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Previous Settlement Price Fraction Indicator says (Previous Settlement Price Negative Whole Pair, Previous Settlement Price Negative Ten Pair, Previous Settlement Price Negative Hundred Pair, Previous Settlement Price Negative Thousand Pair, Previous Settlement Price Negative Ten Thousand Pair, Previous Settlement Price Negative Hundred Thousand Pair, Previous Settlement Price Negative Million Pair, Previous Settlement Price Numeric Pair). They are parsed as PreviousSettlementPriceNumericPair, so which arm applies is left to what is built on the definition.
    previous_settlement_price_fraction_pair: PreviousSettlementPriceNumericPair;
    reason: uint8 &convert=Reason($$);
};

