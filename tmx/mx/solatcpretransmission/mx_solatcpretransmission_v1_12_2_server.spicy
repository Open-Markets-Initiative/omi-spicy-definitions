module TmxMxSolatcpretransmissionHsvfV1122Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type MxSolatcpretransmissionV1122 = unit {
    server_sola_frame: ServerSolaFrame[] &eod;
};

type ServerSolaFrame = unit {
    sola_message_start: uint8;
    message_header: MessageHeader;
    switch ( self.message_header.message_type.strip() ) {
        b"ER" -> error_message: ErrorMessage;
        * -> retransmitted_message: RetransmittedMessage(self.message_header.message_type);
    };
    sola_message_end: uint8;
};

type MessageHeader = unit {
    sequence_number: bytes &size=9;
    message_type: bytes &size=2;
};

type ErrorMessage = unit {
    error_code: bytes &size=4;
    error_msg: bytes &size=80;
};

type RetransmittedMessage = unit(message_type: bytes) {
    switch ( message_type.strip() ) {
        b"C" -> option_trade_message: OptionTradeMessage;
        b"CB" -> future_options_trade_message: FutureOptionsTradeMessage;
        b"CF" -> futures_trade_message: FuturesTradeMessage;
        b"CS" -> strategy_trade_message: StrategyTradeMessage;
        b"D" -> option_request_for_quote_rfq_message: OptionRequestForQuoteRfqMessage;
        b"DB" -> future_options_request_for_quote_rfq_message: FutureOptionsRequestForQuoteRfqMessage;
        b"DF" -> futures_request_for_quote_rfq_message: FuturesRequestForQuoteRfqMessage;
        b"DS" -> strategy_request_for_quote_rfq_message: StrategyRequestForQuoteRfqMessage;
        b"E" -> instrument_schedule_notice_option_message: InstrumentScheduleNoticeOptionMessage;
        b"EB" -> instrument_schedule_notice_futures_option_message: InstrumentScheduleNoticeFuturesOptionMessage;
        b"EF" -> instrument_schedule_notice_future_message: InstrumentScheduleNoticeFutureMessage;
        b"ES" -> instrument_schedule_notice_strategy_message: InstrumentScheduleNoticeStrategyMessage;
        b"F" -> option_quote_message: OptionQuoteMessage;
        b"FB" -> future_options_quote_message: FutureOptionsQuoteMessage;
        b"FF" -> futures_quote_message: FuturesQuoteMessage;
        b"FS" -> strategy_quote_message: StrategyQuoteMessage;
        b"H" -> option_market_depth_message: OptionMarketDepthMessage;
        b"HB" -> future_options_market_depth_message: FutureOptionsMarketDepthMessage;
        b"HF" -> futures_market_depth_message: FuturesMarketDepthMessage;
        b"HS" -> strategy_market_depth_message: StrategyMarketDepthMessage;
        b"I" -> option_trade_cancellation_message: OptionTradeCancellationMessage;
        b"IB" -> future_options_trade_cancellation_message: FutureOptionsTradeCancellationMessage;
        b"IF" -> futures_trade_cancellation_message: FuturesTradeCancellationMessage;
        b"IS" -> strategy_trade_cancellation_message: StrategyTradeCancellationMessage;
        b"J" -> option_instrument_keys_message: OptionInstrumentKeysMessage;
        b"JB" -> future_options_instrument_keys_message: FutureOptionsInstrumentKeysMessage;
        b"JE" -> underlying_instrument_keys_message: UnderlyingInstrumentKeysMessage;
        b"JF" -> futures_instrument_keys_message: FuturesInstrumentKeysMessage;
        b"JS" -> strategy_instrument_keys_message: StrategyInstrumentKeysMessage;
        b"N" -> option_summary_message: OptionSummaryMessage;
        b"NB" -> future_options_summary_message: FutureOptionsSummaryMessage;
        b"NF" -> futures_summary_message: FuturesSummaryMessage;
        b"NS" -> strategy_summary_message: StrategySummaryMessage;
        b"Q" -> beginning_of_options_summary_message: BeginningOfOptionsSummaryMessage;
        b"QB" -> beginning_of_future_options_summary_message: BeginningOfFutureOptionsSummaryMessage;
        b"QF" -> beginning_of_futures_summary_message: BeginningOfFuturesSummaryMessage;
        b"QS" -> beginning_of_strategy_summary_message: BeginningOfStrategySummaryMessage;
        b"XF" -> futures_trade_correction_message: FuturesTradeCorrectionMessage;
        b"GR" -> group_status_message: GroupStatusMessage;
        b"GS" -> group_status_strategies_message: GroupStatusStrategiesMessage;
        b"L" -> bulletins_message: BulletinsMessage;
        b"S" -> end_of_sales_message: EndOfSalesMessage;
        b"TT" -> tick_table_message: TickTableMessage;
        b"U" -> end_of_transmission_message: EndOfTransmissionMessage;
        b"V" -> circuit_assurance_message: CircuitAssuranceMessage;
        * -> unknown: bytes &eod;
    };
};

type OptionTradeMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    option_symbol: OptionSymbol;
    volume: bytes &size=8;
    # Trade Price Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Trade Price Fraction Indicator says (Trade Price Negative Whole Pair, Trade Price Negative Ten Pair, Trade Price Negative Hundred Pair, Trade Price Negative Thousand Pair, Trade Price Negative Ten Thousand Pair, Trade Price Negative Hundred Thousand Pair, Trade Price Negative Million Pair, Trade Price Numeric Pair). They are parsed as TradePriceNumericPair, so which arm applies is left to what is built on the definition.
    trade_price_fraction_pair: TradePriceNumericPair;
    net_change_sign: uint8 &convert=NetChangeSign($$);
    # Net Change Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Net Change Fraction Indicator says (Net Change Negative Whole Pair, Net Change Negative Ten Pair, Net Change Negative Hundred Pair, Net Change Negative Thousand Pair, Net Change Negative Ten Thousand Pair, Net Change Negative Hundred Thousand Pair, Net Change Negative Million Pair, Net Change Numeric Pair). They are parsed as NetChangeNumericPair, so which arm applies is left to what is built on the definition.
    net_change_fraction_pair: NetChangeNumericPair;
    : skip bytes &size=6;   # padding
    trade_timestamp: bytes &size=9;
    : skip bytes &size=1;   # padding
    price_indicator_marker: uint8 &convert=PriceIndicatorMarker($$);
    trade_number: bytes &size=8;
};

type LongMessageHeader = unit {
    message_timestamp: bytes &size=12;
};

type OptionSymbol = unit {
    root_symbol: bytes &size=6;
    expiry_month: uint8 &convert=ExpiryMonth($$);
    : skip bytes &size=1;   # padding
    # Strike Price Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Strike Price Fraction Indicator says (Strike Price Negative Whole Pair, Strike Price Negative Ten Pair, Strike Price Negative Hundred Pair, Strike Price Negative Thousand Pair, Strike Price Negative Ten Thousand Pair, Strike Price Negative Hundred Thousand Pair, Strike Price Negative Million Pair, Strike Price Numeric Pair). They are parsed as StrikePriceNumericPair, so which arm applies is left to what is built on the definition.
    strike_price_fraction_pair: StrikePriceNumericPair;
    expiry_year: bytes &size=2;
    expiry_day: bytes &size=2;
};

