    exchange_id: uint8 &convert=ExchangeId($$);
    root_symbol_swap_future: bytes &size=6;
    expiry_month_swap_future: uint8 &convert=ExpiryMonthSwapFuture($$);
    expiry_year: bytes &size=2;
