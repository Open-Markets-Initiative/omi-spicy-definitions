type FuturesTradeCorrectionMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    root_symbol: bytes &size=6;
    delivery_month: uint8 &convert=DeliveryMonth($$);
    delivery_year_futures: bytes &size=2;
    delivery_day: bytes &size=2;
    volume: bytes &size=8;
    # Trade Price Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Trade Price Fraction Indicator says (Trade Price Negative Whole Pair, Trade Price Negative Ten Pair, Trade Price Negative Hundred Pair, Trade Price Negative Thousand Pair, Trade Price Negative Ten Thousand Pair, Trade Price Negative Hundred Thousand Pair, Trade Price Negative Million Pair, Trade Price Numeric Pair). They are parsed as TradePriceNumericPair, so which arm applies is left to what is built on the definition.
    trade_price_fraction_pair: TradePriceNumericPair;
    net_change_sign: uint8 &convert=NetChangeSign($$);
    # Net Change Futures Trade Message Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Net Change Fraction Indicator says (Net Change Futures Trade Message Negative Whole Pair, Net Change Futures Trade Message Negative Ten Pair, Net Change Futures Trade Message Negative Hundred Pair, Net Change Futures Trade Message Negative Thousand Pair, Net Change Futures Trade Message Negative Ten Thousand Pair, Net Change Futures Trade Message Negative Hundred Thousand Pair, Net Change Futures Trade Message Negative Million Pair, Net Change Futures Trade Message Numeric Pair). They are parsed as NetChangeFuturesTradeMessageNumericPair, so which arm applies is left to what is built on the definition.
    net_change_futures_trade_message_fraction_pair: NetChangeFuturesTradeMessageNumericPair;
    : skip bytes &size=6;   # padding
    timestamp: bytes &size=9;
    price_indicator_marker: uint8 &convert=PriceIndicatorMarker($$);
    trade_number: bytes &size=8;
};

type StrategyTradeCorrectionMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    symbol: bytes &size=30;
    volume: bytes &size=8;
    trade_price_sign: uint8 &convert=TradePriceSign($$);
