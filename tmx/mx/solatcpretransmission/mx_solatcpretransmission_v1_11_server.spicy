    net_change_sign: uint8 &convert=NetChangeSign($$);
    # Net Change Future Options Trade Message Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Net Change Fraction Indicator says (Net Change Future Options Trade Message Negative Whole Pair, Net Change Future Options Trade Message Negative Ten Pair, Net Change Future Options Trade Message Negative Hundred Pair, Net Change Future Options Trade Message Negative Thousand Pair, Net Change Future Options Trade Message Negative Ten Thousand Pair, Net Change Future Options Trade Message Negative Hundred Thousand Pair, Net Change Future Options Trade Message Negative Million Pair, Net Change Future Options Trade Message Numeric Pair). They are parsed as NetChangeFutureOptionsTradeMessageNumericPair, so which arm applies is left to what is built on the definition.
    net_change_future_options_trade_message_fraction_pair: NetChangeFutureOptionsTradeMessageNumericPair;
    : skip bytes &size=6;   # padding
    timestamp: bytes &size=9;
    open_interest: bytes &size=7;
    : skip bytes &size=2;   # padding
    trade_number: bytes &size=8;
};

