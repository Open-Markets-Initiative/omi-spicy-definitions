module TmxMxSolatcpretransmissionHsvfV1133Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type MxSolatcpretransmissionV1133 = unit {
    client_sola_frame: ClientSolaFrame[] &eod;
};

type ClientSolaFrame = unit {
    sola_message_start: uint8;
    client_message_header: ClientMessageHeader;
    switch ( self.client_message_header.client_message_type ) {
        0 -> login_message: LoginMessage;
        0 -> retransmission_request_message: RetransmissionRequestMessage;
        * -> unknown: bytes &eod;
    };
    sola_message_end: uint8;
};

type ClientMessageHeader = unit {
    sequence_number: bytes &size=10;
    client_message_type: bytes &size=2;
};

type LoginMessage = unit {
    user: bytes &size=16;
    pwd: bytes &size=16;
    login_timestamp: bytes &size=6;
    protocol: bytes &size=2;
};

type RetransmissionRequestMessage = unit {
    line: bytes &size=2;
    start: bytes &size=10;
    end_field: bytes &size=10;
};

