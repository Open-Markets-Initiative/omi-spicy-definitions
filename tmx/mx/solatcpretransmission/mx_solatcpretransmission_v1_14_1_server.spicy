        StrikePriceFractionIndicator::NegativeHundred -> strike_price_schedule_notice_negative_hundred_pair: StrikePriceScheduleNoticeNegativeHundredPair;
        StrikePriceFractionIndicator::NegativeThousand -> strike_price_schedule_notice_negative_thousand_pair: StrikePriceScheduleNoticeNegativeThousandPair;
