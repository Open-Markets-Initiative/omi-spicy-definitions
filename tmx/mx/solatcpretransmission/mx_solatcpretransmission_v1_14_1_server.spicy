    switch ( self.tick_price_fraction_pair.tick_price_negative_whole_pair.tick_price_fraction_indicator ) {
        TickPriceFractionIndicator::NegativeWhole -> tick_price_negative_whole_pair: TickPriceNegativeWholePair;
        TickPriceFractionIndicator::NegativeTen -> tick_price_negative_ten_pair: TickPriceNegativeTenPair;
