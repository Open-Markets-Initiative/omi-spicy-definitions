type FuturesTradeCorrectionMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    future_product: FutureProduct;
    volume: bytes &size=8;
    switch ( self.trade_price_fraction_pair.trade_price_negative_whole_pair.trade_price_fraction_indicator ) {
        TradePriceFractionIndicator::NegativeWhole -> trade_price_negative_whole_pair: TradePriceNegativeWholePair;
        TradePriceFractionIndicator::NegativeTen -> trade_price_negative_ten_pair: TradePriceNegativeTenPair;
        TradePriceFractionIndicator::NegativeHundred -> trade_price_negative_hundred_pair: TradePriceNegativeHundredPair;
        TradePriceFractionIndicator::NegativeThousand -> trade_price_negative_thousand_pair: TradePriceNegativeThousandPair;
        TradePriceFractionIndicator::NegativeTenThousand -> trade_price_negative_ten_thousand_pair: TradePriceNegativeTenThousandPair;
        TradePriceFractionIndicator::NegativeHundredThousand -> trade_price_negative_hundred_thousand_pair: TradePriceNegativeHundredThousandPair;
        TradePriceFractionIndicator::NegativeMillion -> trade_price_negative_million_pair: TradePriceNegativeMillionPair;
        * -> trade_price_numeric_pair: TradePriceNumericPair;
    };
    net_change_sign: uint8 &convert=NetChangeSign($$);
    switch ( self.net_change_futures_trade_correction_message_fraction_pair.net_change_futures_trade_correction_message_negative_whole_pair.net_change_fraction_indicator ) {
        NetChangeFractionIndicator::NegativeWhole -> net_change_futures_trade_correction_message_negative_whole_pair: NetChangeFuturesTradeCorrectionMessageNegativeWholePair;
        NetChangeFractionIndicator::NegativeTen -> net_change_futures_trade_correction_message_negative_ten_pair: NetChangeFuturesTradeCorrectionMessageNegativeTenPair;
        NetChangeFractionIndicator::NegativeHundred -> net_change_futures_trade_correction_message_negative_hundred_pair: NetChangeFuturesTradeCorrectionMessageNegativeHundredPair;
        NetChangeFractionIndicator::NegativeThousand -> net_change_futures_trade_correction_message_negative_thousand_pair: NetChangeFuturesTradeCorrectionMessageNegativeThousandPair;
        NetChangeFractionIndicator::NegativeTenThousand -> net_change_futures_trade_correction_message_negative_ten_thousand_pair: NetChangeFuturesTradeCorrectionMessageNegativeTenThousandPair;
        NetChangeFractionIndicator::NegativeHundredThousand -> net_change_futures_trade_correction_message_negative_hundred_thousand_pair: NetChangeFuturesTradeCorrectionMessageNegativeHundredThousandPair;
        NetChangeFractionIndicator::NegativeMillion -> net_change_futures_trade_correction_message_negative_million_pair: NetChangeFuturesTradeCorrectionMessageNegativeMillionPair;
        * -> net_change_futures_trade_correction_message_numeric_pair: NetChangeFuturesTradeCorrectionMessageNumericPair;
    };
    price_indicator_marker: uint8 &convert=PriceIndicatorMarker($$);
    trade_number: bytes &size=8;
};

