        0x46 -> ask_price_quote_numeric_negative_hundred_thousand_pair: AskPriceQuoteNumericNegativeHundredThousandPair;
        0x47 -> ask_price_quote_numeric_negative_million_pair: AskPriceQuoteNumericNegativeMillionPair;
        * -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
    };
    ask_size: bytes &size=5;
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
};

