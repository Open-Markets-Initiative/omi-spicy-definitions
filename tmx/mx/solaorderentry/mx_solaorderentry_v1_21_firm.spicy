type DisconnectionInstructionNoteCancelQuotesOnlyQQuotesOnly = enum {
    All = 0x41,
    QuotesOnly = 0x51,
    OrdersOnly = 0x4f,
    StopOrdersOnly = 0x53,
    MarketOrdersOnly = 0x4d,
};

type ActiveYOnNOff = enum {
    Yes = 0x59,
    No = 0x4e,
};

type AccountType = enum {
    Customer = 0x31,
    House = 0x32,
    Pro = 0x34,
    NonClient = 0x35,
    NonClientShareholder = 0x44,
    CustomerShareholder = 0x48,
    CustomerInsider = 0x49,
    ProShareholder = 0x4c,
    HouseInsider = 0x4e,
    HouseShareholder = 0x4f,
    NonClientInsider = 0x52,
    ProInsider = 0x53,
};

