module TmxMxSolaorderentrySailV121Firm;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type MxSolaorderentryV121 = unit {
    message_length: uint32;
    message_type: bytes &size=2;
    switch ( self.message_type ) {
        0 -> user_connection: UserConnection;
        0 -> disconnection_instruction: DisconnectionInstruction;
        0 -> heartbeat_response: HeartbeatResponse;
        0 -> user_disconnection: UserDisconnection;
        0 -> order_request: OrderRequest;
        0 -> bulk_quote_data: BulkQuoteData;
        0 -> firm_risk_config: FirmRiskConfig;
        0 -> global_cancellation: GlobalCancellation;
        0 -> user_global_cancellation: UserGlobalCancellation;
        0 -> set_group_risk_limits: SetGroupRiskLimits;
        0 -> set_global_risk_limits: SetGlobalRiskLimits;
        0 -> order_entry: OrderEntry;
        0 -> order_modification: OrderModification;
        0 -> new_strategy_instrument: NewStrategyInstrument;
        0 -> cross_entry: CrossEntry;
        0 -> bulk_quote_price_4_quantity_2: BulkQuotePrice4Quantity2;
        0 -> bulk_quote_price_6_quantity_2: BulkQuotePrice6Quantity2;
        0 -> bulk_quote_price_8_quantity_2: BulkQuotePrice8Quantity2;
        0 -> bulk_quote_price_10_quantity_2: BulkQuotePrice10Quantity2;
        0 -> bulk_quote_price_4_quantity_4: BulkQuotePrice4Quantity4;
        0 -> bulk_quote_price_6_quantity_4: BulkQuotePrice6Quantity4;
        0 -> bulk_quote_price_8_quantity_4: BulkQuotePrice8Quantity4;
        0 -> bulk_quote_price_10_quantity_4: BulkQuotePrice10Quantity4;
        0 -> bulk_quote_price_4_quantity_6: BulkQuotePrice4Quantity6;
        0 -> bulk_quote_price_6_quantity_6: BulkQuotePrice6Quantity6;
        0 -> bulk_quote_price_8_quantity_6: BulkQuotePrice8Quantity6;
        0 -> bulk_quote_price_10_quantity_6: BulkQuotePrice10Quantity6;
        0 -> bulk_quote_price_4_quantity_8: BulkQuotePrice4Quantity8;
        0 -> bulk_quote_price_6_quantity_8: BulkQuotePrice6Quantity8;
        0 -> bulk_quote_price_8_quantity_8: BulkQuotePrice8Quantity8;
        0 -> bulk_quote: BulkQuote;
        0 -> sail_request_for_quote_with_side: SailRequestForQuoteWithSide;
        0 -> bulk_quote_participant_bqp_protection_subscription: BulkQuoteParticipantBqpProtectionSubscription;
        0 -> request_for_quote: RequestForQuote;
        0 -> order_cancellation: OrderCancellation;
        * -> unknown: bytes &eod;
    };
    end_of_text: uint8;
    : skip bytes &size=((4 - self.offset() % 4) % 4);   # padding to a 4 byte boundary
};

type UserConnection = unit {
    protocol_id: bytes &size=2;
    user_id: bytes &size=8;
    password_md_5_encryption: bytes &size=8;
    session_id: bytes &size=4;
    user_message_timestamp_local_hhmmss: bytes &size=6;
    exchange_message_id: bytes &size=6;
    inactivity_interval: bytes &size=2;
    number_of_message_types_to_be_received: bytes &size=2;
    user_connection_occurrence: UserConnectionOccurrence[self.number_of_message_types_to_be_received];
};

type UserConnectionOccurrence = unit {
    message_types_to_be_received: bytes &size=2;
};

type DisconnectionInstruction = unit {
    number_of_instructions_present_in_the_message: bytes &size=2;
    disconnection_instruction_occurrence: DisconnectionInstructionOccurrence[self.number_of_instructions_present_in_the_message];
};

type DisconnectionInstructionOccurrence = unit {
    trader_id: bytes &size=8;
    disconnection_instruction_note_cancel_quotes_only_q_quotes_only: uint8 &convert=DisconnectionInstructionNoteCancelQuotesOnlyQQuotesOnly($$);
    active_y_on_n_off: uint8 &convert=ActiveYOnNOff($$);
};

type HeartbeatResponse = unit {
    user_sequence_id_first_user_sequence_id_for_nextcurrent_heartbeat_period: bytes &size=8;
    last_exchange_message_id_sent_to_participant: bytes &size=6;
    user_message_timestamp_local_hhmmss: bytes &size=6;
};

type UserDisconnection = unit {
    user_id: bytes &size=8;
    session_id: bytes &size=4;
};

type OrderRequest = unit {
    incoming_messages_header: IncomingMessagesHeader;
};

type IncomingMessagesHeader = unit {
    user_timestamp_local_hhmmss: bytes &size=6;
    trader_id: bytes &size=8;
    user_sequence_id: bytes &size=8;
};

type BulkQuoteData = unit {
    incoming_messages_header: IncomingMessagesHeader;
    group: bytes &size=2;
    clearing_data: ClearingData;
    owner_data: OwnerData;
    maximum_number_trades: bytes &size=2;
    minimum_volume: bytes &size=8;
    : skip bytes &size=2;   # padding
    calculation_time_interval: bytes &size=8;
    maximum_total_volume: bytes &size=8;
    maximum_total_value: bytes &size=8;
    delta_maximum_volume: bytes &size=8;
    delta_maximum_value: bytes &size=8;
    anti_wash_id: bytes &size=8;
    : skip bytes &size=20;   # padding
};

type ClearingData = unit {
    clearing_instruction: bytes &size=12;
    account_type: uint8 &convert=AccountType($$);
    open_close: uint8 &convert=OpenClose($$);
    hedge_spec: uint8 &convert=HedgeSpec($$);
    : skip bytes &size=5;   # padding
};

type OwnerData = unit {
    memo: bytes &size=50;
};

type FirmRiskConfig = unit {
    incoming_messages_header: IncomingMessagesHeader;
    firm_level_risk_option: uint8 &convert=FirmLevelRiskOption($$);
    number_of_trader_teams: bytes &size=3;
    firm_risk_config_trader_team: FirmRiskConfigTraderTeam[self.number_of_trader_teams];
};

type FirmRiskConfigTraderTeam = unit {
    team_level_risk_option: uint8 &convert=TeamLevelRiskOption($$);
    number_of_traders_in_team: bytes &size=3;
    firm_risk_config_trader_team_trader: FirmRiskConfigTraderTeamTrader[self.number_of_traders_in_team];
};

type FirmRiskConfigTraderTeamTrader = unit {
    trader: bytes &size=4;
};

type GlobalCancellation = unit {
    incoming_messages_header: IncomingMessagesHeader;
    group: bytes &size=2;
    type_of_cancellation_q_quotes_only: uint8 &convert=TypeOfCancellationQQuotesOnly($$);
};

type UserGlobalCancellation = unit {
    incoming_messages_header: IncomingMessagesHeader;
    group_filter: bytes &size=2;
    instrument_filter: bytes &size=4;
    type_of_cancellation: uint8 &convert=TypeOfCancellation($$);
    account_type_filter: bytes &size=8;
};

type SetGroupRiskLimits = unit {
    incoming_messages_header: IncomingMessagesHeader;
    reset_all_groups: uint8 &convert=ResetAllGroups($$);
    number_of_group_limits: bytes &size=3;
    set_group_risk_limits_occurrence: SetGroupRiskLimitsOccurrence[self.number_of_group_limits];
};

type SetGroupRiskLimitsOccurrence = unit {
    trader: bytes &size=4;
    group: bytes &size=2;
    net_exposure_action: uint8 &convert=NetExposureAction($$);
    long_exposure_action: uint8 &convert=LongExposureAction($$);
    short_exposure_action: uint8 &convert=ShortExposureAction($$);
    net_position_action: uint8 &convert=NetPositionAction($$);
    long_position_action: uint8 &convert=LongPositionAction($$);
    short_position_action: uint8 &convert=ShortPositionAction($$);
    maximum_order_quantity: bytes &size=8;
    net_position_limit: bytes &size=8;
    long_position_limit: bytes &size=8;
    short_position_limit: bytes &size=8;
    net_exposure_limit: bytes &size=10;
    long_exposure_limit: bytes &size=10;
    short_exposure_limit: bytes &size=10;
    : skip bytes &size=2;   # padding
};

type SetGlobalRiskLimits = unit {
    incoming_messages_header: IncomingMessagesHeader;
    global_net_exposure_action: uint8 &convert=GlobalNetExposureAction($$);
    default_net_exposure_action: uint8 &convert=DefaultNetExposureAction($$);
    default_long_exposure_action: uint8 &convert=DefaultLongExposureAction($$);
    default_short_exposure_action: uint8 &convert=DefaultShortExposureAction($$);
    default_net_position_action: uint8 &convert=DefaultNetPositionAction($$);
    default_long_position_action: uint8 &convert=DefaultLongPositionAction($$);
    default_short_position_action: uint8 &convert=DefaultShortPositionAction($$);
    global_net_exposure_limit: bytes &size=10;
    default_maximum_order_quantity: bytes &size=8;
    default_net_exposure_limit: bytes &size=10;
    default_long_exposure_limit: bytes &size=10;
    default_short_exposure_limit: bytes &size=10;
    default_net_position_limit: bytes &size=8;
    default_long_position_limit: bytes &size=8;
    default_short_position_limit: bytes &size=8;
};

type OrderEntry = unit {
    incoming_messages_header: IncomingMessagesHeader;
    group: bytes &size=2;
    instrument: bytes &size=4;
    price_type: uint8 &convert=PriceType($$);
    verb_side: uint8 &convert=VerbSide($$);
    quantity: bytes &size=8;
    price: bytes &size=10;
    special_price_term: uint8 &convert=SpecialPriceTerm($$);
    additional_price: bytes &size=10;
    quantity_term: uint8 &convert=QuantityTerm($$);
    additional_quantity: bytes &size=8;
    duration_type: uint8 &convert=DurationType($$);
    gtd_date: bytes &size=8;
    executing_participant: bytes &size=4;
    : skip bytes &size=1;   # padding
    clearing_data: ClearingData;
    owner_data: OwnerData;
    anti_wash_id: bytes &size=8;
    anti_wash_instruction: uint8 &convert=AntiWashInstruction($$);
    : skip bytes &size=20;   # padding
};

type OrderModification = unit {
    incoming_messages_header: IncomingMessagesHeader;
    group: bytes &size=2;
    instrument: bytes &size=4;
    price_type: uint8 &convert=PriceType($$);
    verb_side: uint8 &convert=VerbSide($$);
    quantity_sign: uint8 &convert=QuantitySign($$);
    quantity: bytes &size=8;
    price: bytes &size=10;
    special_price_term: uint8 &convert=SpecialPriceTerm($$);
    additional_price: bytes &size=10;
    quantity_term: uint8 &convert=QuantityTerm($$);
    additional_quantity: bytes &size=8;
    duration_type: uint8 &convert=DurationType($$);
    gtd_date: bytes &size=8;
    : skip bytes &size=4;   # padding
    : skip bytes &size=1;   # padding
    modified_order_id: bytes &size=8;
    clearing_data: ClearingData;
    owner_data: OwnerData;
    anti_wash_id: bytes &size=8;
    anti_wash_instruction: uint8 &convert=AntiWashInstruction($$);
    : skip bytes &size=20;   # padding
};

type NewStrategyInstrument = unit {
    incoming_messages_header: IncomingMessagesHeader;
    number_of_legs: bytes &size=2;
