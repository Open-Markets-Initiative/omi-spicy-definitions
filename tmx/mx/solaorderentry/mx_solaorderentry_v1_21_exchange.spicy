    PutInTheOrderBookAsStopOrder = 0x53,
    EliminatedDueToTradeLimitExceeded = 0x54,
    EliminatedDueToUnpricedLeg = 0x55,
    CancelPending = 0x57,
    OrderExecutedInFullOrPartiallyAndTheRemainingPartCouldNotBePutInTheOrderBookFak = 0x58,
};

