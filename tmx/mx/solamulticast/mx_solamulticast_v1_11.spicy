type MessageHeader = unit {
    sequence_number: bytes &size=9;
    message_type: bytes &size=2;
};

type OptionTradeMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    root_symbol: bytes &size=6;
    expiry_month: uint8 &convert=ExpiryMonth($$);
    : skip bytes &size=1;   # padding
    switch ( self.strike_price_instrument_fraction_pair.strike_price_instrument_negative_whole_pair.strike_price_fraction_indicator ) {
        StrikePriceFractionIndicator::NegativeWhole -> strike_price_instrument_negative_whole_pair: StrikePriceInstrumentNegativeWholePair;
        StrikePriceFractionIndicator::NegativeTen -> strike_price_instrument_negative_ten_pair: StrikePriceInstrumentNegativeTenPair;
        StrikePriceFractionIndicator::NegativeHundred -> strike_price_instrument_negative_hundred_pair: StrikePriceInstrumentNegativeHundredPair;
        StrikePriceFractionIndicator::NegativeThousand -> strike_price_instrument_negative_thousand_pair: StrikePriceInstrumentNegativeThousandPair;
        StrikePriceFractionIndicator::NegativeTenThousand -> strike_price_instrument_negative_ten_thousand_pair: StrikePriceInstrumentNegativeTenThousandPair;
        StrikePriceFractionIndicator::NegativeHundredThousand -> strike_price_instrument_negative_hundred_thousand_pair: StrikePriceInstrumentNegativeHundredThousandPair;
        StrikePriceFractionIndicator::NegativeMillion -> strike_price_instrument_negative_million_pair: StrikePriceInstrumentNegativeMillionPair;
        * -> strike_price_instrument_numeric_pair: StrikePriceInstrumentNumericPair;
    };
    expiry_year: bytes &size=2;
    expiry_day: bytes &size=2;
    volume: bytes &size=8;
    switch ( self.trade_price_fraction_pair.trade_price_negative_whole_pair.trade_price_fraction_indicator ) {
        TradePriceFractionIndicator::NegativeWhole -> trade_price_negative_whole_pair: TradePriceNegativeWholePair;
        TradePriceFractionIndicator::NegativeTen -> trade_price_negative_ten_pair: TradePriceNegativeTenPair;
        TradePriceFractionIndicator::NegativeHundred -> trade_price_negative_hundred_pair: TradePriceNegativeHundredPair;
        TradePriceFractionIndicator::NegativeThousand -> trade_price_negative_thousand_pair: TradePriceNegativeThousandPair;
        TradePriceFractionIndicator::NegativeTenThousand -> trade_price_negative_ten_thousand_pair: TradePriceNegativeTenThousandPair;
        TradePriceFractionIndicator::NegativeHundredThousand -> trade_price_negative_hundred_thousand_pair: TradePriceNegativeHundredThousandPair;
        TradePriceFractionIndicator::NegativeMillion -> trade_price_negative_million_pair: TradePriceNegativeMillionPair;
        * -> trade_price_numeric_pair: TradePriceNumericPair;
    };
    net_change_sign: uint8 &convert=NetChangeSign($$);
    switch ( self.net_change_fraction_pair.net_change_negative_whole_pair.net_change_fraction_indicator ) {
        NetChangeFractionIndicator::NegativeWhole -> net_change_negative_whole_pair: NetChangeNegativeWholePair;
        NetChangeFractionIndicator::NegativeTen -> net_change_negative_ten_pair: NetChangeNegativeTenPair;
        NetChangeFractionIndicator::NegativeHundred -> net_change_negative_hundred_pair: NetChangeNegativeHundredPair;
        NetChangeFractionIndicator::NegativeThousand -> net_change_negative_thousand_pair: NetChangeNegativeThousandPair;
        NetChangeFractionIndicator::NegativeTenThousand -> net_change_negative_ten_thousand_pair: NetChangeNegativeTenThousandPair;
        NetChangeFractionIndicator::NegativeHundredThousand -> net_change_negative_hundred_thousand_pair: NetChangeNegativeHundredThousandPair;
        NetChangeFractionIndicator::NegativeMillion -> net_change_negative_million_pair: NetChangeNegativeMillionPair;
        * -> net_change_numeric_pair: NetChangeNumericPair;
    };
    : skip bytes &size=6;   # padding
    timestamp: bytes &size=9;
    open_interest: bytes &size=7;
    : skip bytes &size=1;   # padding
    price_indicator_marker: uint8 &convert=PriceIndicatorMarker($$);
    trade_number: bytes &size=8;
};

