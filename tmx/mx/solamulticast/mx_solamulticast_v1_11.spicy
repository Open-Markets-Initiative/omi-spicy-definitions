type BulletinsMessage = unit {
    : skip bytes &size=1;   # padding
    bulletin_type: uint8 &convert=BulletinType($$);
    switch ( self.bulletin_type ) {
        BulletinType::RegularTextBulletin -> regular_text_bulletin: RegularTextBulletin;
        BulletinType::SpecialTextBulletin -> special_text_bulletin: SpecialTextBulletin;
        * -> unknown: bytes &eod;
    };
};

type RegularTextBulletin = unit {
    regular_bulletin_contents: bytes &size=79;
    continue_marker: bytes &size=1;
};

type SpecialTextBulletin = unit {
    symbol_bulletin: bytes &size=30;
    special_bulletin_contents: bytes &size=49;
    continue_marker: bytes &size=1;
};

