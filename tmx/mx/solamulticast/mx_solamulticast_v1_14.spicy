    low_price: bytes &size=7;
    low_price_fraction_indicator: bytes &size=1;
    settlement_price: bytes &size=7;
    settlement_price_fraction_indicator: bytes &size=1;
    previous_settlement_price: bytes &size=7;
    previous_settlement_price_fraction_indicator: bytes &size=1;
    reason: uint8 &convert=Reason($$);
};

