type OptionInitialAndImprovementOrderMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    option_symbol: OptionSymbol;
    auction_id: bytes &size=6;
    order_side: uint8 &convert=OrderSide($$);
    order_quantity: bytes &size=8;
    order_price: bytes &size=7;
    order_price_fraction_indicator: bytes &size=1;
    order_type: uint8 &convert=OrderType($$);
    order_id: bytes &size=8;
    previous_order_id: bytes &size=8;
};

type StrategyInitialAndImprovementOrderMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    strategy_symbol: bytes &size=30;
    auction_id: bytes &size=6;
    order_side: uint8 &convert=OrderSide($$);
    order_quantity: bytes &size=8;
    order_price: bytes &size=7;
    order_price_fraction_indicator: bytes &size=1;
    order_type: uint8 &convert=OrderType($$);
