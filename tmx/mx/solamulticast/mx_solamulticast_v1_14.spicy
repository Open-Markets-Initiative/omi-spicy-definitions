    exchange_id: uint8 &convert=ExchangeId($$);
};

type BeginningOfFuturesSummaryMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
};

type BeginningOfStrategySummaryMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
};

