    volume: bytes &size=8;
    previous_settlement: bytes &size=7;
    previous_settlement_fraction_indicator: bytes &size=1;
    open_interest: bytes &size=7;
    open_interest_date: bytes &size=6;
    reason: uint8 &convert=Reason($$);
    external_price_at_source: bytes &size=7;
    external_price_fraction_indicator: bytes &size=1;
};

type StrategySummaryMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    strategy_symbol: bytes &size=30;
    bid_price_sign: bytes &size=1;
    bid_price_summary: bytes &size=7;
    bid_price_fraction_indicator: bytes &size=1;
    bid_size: bytes &size=5;
    ask_price_sign: bytes &size=1;
    ask_price_summary: bytes &size=7;
    ask_price_fraction_indicator: bytes &size=1;
    ask_size: bytes &size=5;
    last_price_sign: bytes &size=1;
    last_price: bytes &size=7;
    last_price_fraction_indicator: bytes &size=1;
    open_price_sign: bytes &size=1;
    open_price: bytes &size=7;
    open_price_fraction_indicator: bytes &size=1;
    high_price_sign: bytes &size=1;
    high_price: bytes &size=7;
    high_price_fraction_indicator: bytes &size=1;
    low_price_sign: bytes &size=1;
    low_price: bytes &size=7;
    low_price_fraction_indicator: bytes &size=1;
    net_change_sign: bytes &size=1;
    net_change: bytes &size=7;
    net_change_fraction_indicator: bytes &size=1;
    volume: bytes &size=8;
    reason: uint8 &convert=Reason($$);
};

type BeginningOfOptionsSummaryMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
};

type BeginningOfFutureOptionsSummaryMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
};

type BeginningOfFuturesSummaryMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
};

type BeginningOfStrategySummaryMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
};

type FuturesTradeCorrectionMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    future_product: FutureProduct;
    volume: bytes &size=8;
    trade_price: bytes &size=7;
    trade_price_fraction_indicator: bytes &size=1;
    net_change_sign: bytes &size=1;
    net_change: bytes &size=7;
    net_change_fraction_indicator: bytes &size=1;
    price_indicator_marker: bytes &size=1;
    trade_number: bytes &size=8;
};

type GroupStatusMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    root_symbol: bytes &size=6;
    group_status: bytes &size=1;
};

type GroupStatusStrategiesMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    group_instrument: bytes &size=2;
    group_status: bytes &size=1;
};

type FutureDeliverablesMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    future_product: FutureProduct;
    number_of_bonds: bytes &size=2;
    bond_definition: BondDefinition[self.number_of_bonds];
};

type BondDefinition = unit {
    maturity_date: bytes &size=8;
    coupon: bytes &size=7;
    coupon_fraction_indicator: bytes &size=1;
    outstanding_bond_value: bytes &size=8;
    conversion_factor: bytes &size=7;
    conversion_factor_fraction_indicator: bytes &size=1;
};

type BulletinsMessage = unit {
    : skip bytes &size=1;   # padding
    bulletin_type: uint8 &convert=BulletinType($$);
    switch ( self.bulletin_type ) {
        BulletinType::RegularTextBulletin -> regular_text_bulletin: RegularTextBulletin;
        BulletinType::SpecialTextBulletin -> special_text_bulletin: SpecialTextBulletin;
        * -> unknown: bytes &eod;
    };
};

type RegularTextBulletin = unit {
    regular_bulletin_contents: bytes &size=79;
    continue_marker: bytes &size=1;
};

type SpecialTextBulletin = unit {
    symbol_bulletin: bytes &size=30;
    special_bulletin_contents: bytes &size=49;
    continue_marker: bytes &size=1;
};

type EndOfSalesMessage = unit {
    : skip bytes &size=1;   # padding
    time_field: bytes &size=6;
};

type TickTableMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    tick_table_name: bytes &size=50;
    tick_table_short_name: bytes &size=2;
    number_of_entries: bytes &size=2;
    tick_entry: TickEntry[self.number_of_entries];
};

type TickEntry = unit {
    min_price: bytes &size=7;
    min_price_fraction_indicator: bytes &size=1;
    tick_price: bytes &size=7;
    tick_price_fraction_indicator: bytes &size=1;
};

type EndOfTransmissionMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    time_field: bytes &size=6;
};

type CircuitAssuranceMessage = unit {
    time_field: bytes &size=6;
};

type MessageType = enum {
    OptionTradeMessage = 0x43,
    OptionRequestForQuoteMessage = 0x44,
    InstrumentScheduleNoticeOptionMessage = 0x45,
    OptionQuoteMessage = 0x46,
    OptionMarketDepthMessage = 0x48,
    OptionTradeCancellationMessage = 0x49,
    OptionInstrumentKeysMessage = 0x4a,
    OptionSummaryMessage = 0x4e,
    BeginningOfOptionsSummaryMessage = 0x51,
    EndOfSalesMessage = 0x53,
    EndOfTransmissionMessage = 0x55,
    CircuitAssuranceMessage = 0x56,
};

type ExchangeId = enum {
    Montreal = 0x51,
};

type ExpiryMonth = enum {
    January = 0x41,
    February = 0x42,
    March = 0x43,
    April = 0x44,
    May = 0x45,
    June = 0x46,
    July = 0x47,
    August = 0x48,
    September = 0x49,
    October = 0x4a,
    November = 0x4b,
    December = 0x4c,
};

type CallPutCode = enum {
    Call = 0x43,
    Put = 0x50,
};

type RequestedMarketSide = enum {
    Buy = 0x42,
    Sell = 0x53,
    Both = 0x32,
};

type OptionType = enum {
    American = 0x41,
    European = 0x45,
};

type DeliveryType = enum {
    Cash = 0x43,
    Physical = 0x50,
};

type StrategyAllowImplied = enum {
    Yes = 0x59,
    No = 0x4e,
};

type StrategyType = enum {
    Classic = 0x43,
    Strip = 0x53,
    CoveredRegular = 0x56,
    CoveredReferenceFixed = 0x52,
};

type Tick = enum {
    Uptick = 0x2b,
    Downtick = 0x2d,
};

type Reason = enum {
    StartOfDay = 0x53,
    EndOfDay = 0x45,
    InstrumentNewOrUpdate = 0x55,
    TradeCancellation = 0x43,
};

type BulletinType = enum {
    RegularTextBulletin = 0x31,
    SpecialTextBulletin = 0x32,
};

