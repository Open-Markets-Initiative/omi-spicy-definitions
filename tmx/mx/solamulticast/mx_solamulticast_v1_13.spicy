module TmxMxSolamulticastHsvfV113;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type MxSolamulticastV113 = unit {
    hsvf_stx: uint8;
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::OptionTradeMessage -> option_trade_message: OptionTradeMessage;
        MessageType::FutureOptionsTradeMessage -> future_options_trade_message: FutureOptionsTradeMessage;
        MessageType::FuturesTradeMessage -> futures_trade_message: FuturesTradeMessage;
        MessageType::StrategyTradeMessage -> strategy_trade_message: StrategyTradeMessage;
        MessageType::OptionRequestForQuoteMessage -> option_request_for_quote_message: OptionRequestForQuoteMessage;
        MessageType::FutureOptionsRequestForQuoteMessage -> future_options_request_for_quote_message: FutureOptionsRequestForQuoteMessage;
        MessageType::FutureRequestForQuoteMessage -> future_request_for_quote_message: FutureRequestForQuoteMessage;
        MessageType::StrategyRequestForQuoteMessage -> strategy_request_for_quote_message: StrategyRequestForQuoteMessage;
        MessageType::InstrumentScheduleNoticeOptionMessage -> instrument_schedule_notice_option_message: InstrumentScheduleNoticeOptionMessage;
        MessageType::InstrumentScheduleNoticeFuturesOptionMessage -> instrument_schedule_notice_futures_option_message: InstrumentScheduleNoticeFuturesOptionMessage;
        MessageType::InstrumentScheduleNoticeFutureMessage -> instrument_schedule_notice_future_message: InstrumentScheduleNoticeFutureMessage;
        MessageType::InstrumentScheduleNoticeStrategyMessage -> instrument_schedule_notice_strategy_message: InstrumentScheduleNoticeStrategyMessage;
        MessageType::OptionQuoteMessage -> option_quote_message: OptionQuoteMessage;
        MessageType::FutureOptionsQuoteMessage -> future_options_quote_message: FutureOptionsQuoteMessage;
        MessageType::FuturesQuoteMessage -> futures_quote_message: FuturesQuoteMessage;
        MessageType::StrategyQuoteMessage -> strategy_quote_message: StrategyQuoteMessage;
        MessageType::OptionMarketDepthMessage -> option_market_depth_message: OptionMarketDepthMessage;
        MessageType::FutureOptionsMarketDepthMessage -> future_options_market_depth_message: FutureOptionsMarketDepthMessage;
        MessageType::FuturesMarketDepthMessage -> futures_market_depth_message: FuturesMarketDepthMessage;
        MessageType::StrategyMarketDepthMessage -> strategy_market_depth_message: StrategyMarketDepthMessage;
        MessageType::OptionTradeCancellationMessage -> option_trade_cancellation_message: OptionTradeCancellationMessage;
        MessageType::FutureOptionsTradeCancellationMessage -> future_options_trade_cancellation_message: FutureOptionsTradeCancellationMessage;
        MessageType::FutureTradeCancellationMessage -> future_trade_cancellation_message: FutureTradeCancellationMessage;
        MessageType::StrategyTradeCancellationMessage -> strategy_trade_cancellation_message: StrategyTradeCancellationMessage;
        MessageType::OptionInstrumentKeysMessage -> option_instrument_keys_message: OptionInstrumentKeysMessage;
        MessageType::FutureOptionsInstrumentKeysMessage -> future_options_instrument_keys_message: FutureOptionsInstrumentKeysMessage;
        MessageType::UnderlyingInstrumentKeysMessage -> underlying_instrument_keys_message: UnderlyingInstrumentKeysMessage;
        MessageType::FuturesInstrumentKeysMessage -> futures_instrument_keys_message: FuturesInstrumentKeysMessage;
        MessageType::StrategyInstrumentKeysMessage -> strategy_instrument_keys_message: StrategyInstrumentKeysMessage;
        MessageType::OptionSummaryMessage -> option_summary_message: OptionSummaryMessage;
        MessageType::FutureOptionsSummaryMessage -> future_options_summary_message: FutureOptionsSummaryMessage;
        MessageType::FuturesSummaryMessage -> futures_summary_message: FuturesSummaryMessage;
        MessageType::StrategySummaryMessage -> strategy_summary_message: StrategySummaryMessage;
        MessageType::BeginningOfOptionsSummaryMessage -> beginning_of_options_summary_message: BeginningOfOptionsSummaryMessage;
        MessageType::BeginningOfFutureOptionsSummaryMessage -> beginning_of_future_options_summary_message: BeginningOfFutureOptionsSummaryMessage;
        MessageType::BeginningOfFuturesSummaryMessage -> beginning_of_futures_summary_message: BeginningOfFuturesSummaryMessage;
        MessageType::BeginningOfStrategySummaryMessage -> beginning_of_strategy_summary_message: BeginningOfStrategySummaryMessage;
        MessageType::FuturesTradeCorrectionMessage -> futures_trade_correction_message: FuturesTradeCorrectionMessage;
        MessageType::GroupStatusMessage -> group_status_message: GroupStatusMessage;
        MessageType::GroupStatusStrategiesMessage -> group_status_strategies_message: GroupStatusStrategiesMessage;
        MessageType::FutureDeliverablesMessage -> future_deliverables_message: FutureDeliverablesMessage;
        MessageType::BulletinsMessage -> bulletins_message: BulletinsMessage;
        MessageType::EndOfSalesMessage -> end_of_sales_message: EndOfSalesMessage;
        MessageType::TickTableMessage -> tick_table_message: TickTableMessage;
        MessageType::EndOfTransmissionMessage -> end_of_transmission_message: EndOfTransmissionMessage;
        MessageType::CircuitAssuranceMessage -> circuit_assurance_message: CircuitAssuranceMessage;
        * -> unknown: bytes &eod;
    };
    hsvf_etx: uint8;
};

type MessageHeader = unit {
    sequence_number: bytes &size=10;
    message_type: bytes &size=2;
    message_timestamp: bytes &size=20;
};

type OptionTradeMessage = unit {
    exchange_id: uint8 &convert=ExchangeId($$);
    option_symbol: OptionSymbol;
    volume: bytes &size=8;
    trade_price: bytes &size=7;
    trade_price_fraction_indicator: bytes &size=1;
    net_change_sign: bytes &size=1;
    net_change: bytes &size=7;
    net_change_fraction_indicator: bytes &size=1;
    price_indicator_marker: bytes &size=1;
    trade_number: bytes &size=8;
};

type OptionSymbol = unit {
    root: bytes &size=6;
    expiry_month: uint8 &convert=ExpiryMonth($$);
    strike_price: bytes &size=7;
    strike_price_fraction_indicator: bytes &size=1;
    expiry_year: bytes &size=2;
    expiry_day: bytes &size=2;
};

