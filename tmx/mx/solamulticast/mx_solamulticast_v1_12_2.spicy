type OptionQuoteMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: uint8 &convert=ExchangeId($$);
    option_symbol: OptionSymbol;
    switch ( self.bid_price_quote.bid_price_quote_opening_pair.bid_price_quote_opening ) {
        0 -> bid_price_quote_opening_pair: BidPriceQuoteOpeningPair;
        0x41 -> bid_price_quote_numeric_negative_whole_pair: BidPriceQuoteNumericNegativeWholePair;
        0x42 -> bid_price_quote_numeric_negative_ten_pair: BidPriceQuoteNumericNegativeTenPair;
        0x43 -> bid_price_quote_numeric_negative_hundred_pair: BidPriceQuoteNumericNegativeHundredPair;
        0x44 -> bid_price_quote_numeric_negative_thousand_pair: BidPriceQuoteNumericNegativeThousandPair;
        0x45 -> bid_price_quote_numeric_negative_ten_thousand_pair: BidPriceQuoteNumericNegativeTenThousandPair;
        0x46 -> bid_price_quote_numeric_negative_hundred_thousand_pair: BidPriceQuoteNumericNegativeHundredThousandPair;
        0x47 -> bid_price_quote_numeric_negative_million_pair: BidPriceQuoteNumericNegativeMillionPair;
        * -> bid_price_quote_numeric_pair: BidPriceQuoteNumericPair;
    };
    bid_size: bytes &size=5;
    switch ( self.ask_price_quote.ask_price_quote_opening_pair.ask_price_quote_opening ) {
        0 -> ask_price_quote_opening_pair: AskPriceQuoteOpeningPair;
        0x41 -> ask_price_quote_numeric_negative_whole_pair: AskPriceQuoteNumericNegativeWholePair;
        0x42 -> ask_price_quote_numeric_negative_ten_pair: AskPriceQuoteNumericNegativeTenPair;
        0x43 -> ask_price_quote_numeric_negative_hundred_pair: AskPriceQuoteNumericNegativeHundredPair;
        0x44 -> ask_price_quote_numeric_negative_thousand_pair: AskPriceQuoteNumericNegativeThousandPair;
        0x45 -> ask_price_quote_numeric_negative_ten_thousand_pair: AskPriceQuoteNumericNegativeTenThousandPair;
        0x46 -> ask_price_quote_numeric_negative_hundred_thousand_pair: AskPriceQuoteNumericNegativeHundredThousandPair;
        0x47 -> ask_price_quote_numeric_negative_million_pair: AskPriceQuoteNumericNegativeMillionPair;
        * -> ask_price_quote_numeric_pair: AskPriceQuoteNumericPair;
    };
    ask_size: bytes &size=5;
    : skip bytes &size=1;   # padding
    instrument_status_marker: uint8 &convert=InstrumentStatusMarker($$);
};

