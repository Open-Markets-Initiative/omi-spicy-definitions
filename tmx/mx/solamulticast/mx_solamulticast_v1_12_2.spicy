        StrikePriceFractionIndicator::NegativeMillion -> strike_price_negative_million_pair: StrikePriceNegativeMillionPair;
        * -> strike_price_numeric_pair: StrikePriceNumericPair;
    };
    expiry_year: bytes &size=2;
    expiry_day: bytes &size=2;
};

