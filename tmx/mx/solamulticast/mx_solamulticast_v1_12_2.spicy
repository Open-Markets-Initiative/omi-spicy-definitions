module TmxMxSolamulticastHsvfV1122;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type MxSolamulticastV1122 = unit {
    hsvf_stx: uint8;
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::OptionTradeMessage -> option_trade_message: OptionTradeMessage;
        MessageType::FutureOptionsTradeMessage -> future_options_trade_message: FutureOptionsTradeMessage;
