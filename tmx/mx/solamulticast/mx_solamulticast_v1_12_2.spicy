        HighPriceFractionIndicator::NegativeTen -> high_price_negative_ten_pair: HighPriceNegativeTenPair;
        HighPriceFractionIndicator::NegativeHundred -> high_price_negative_hundred_pair: HighPriceNegativeHundredPair;
