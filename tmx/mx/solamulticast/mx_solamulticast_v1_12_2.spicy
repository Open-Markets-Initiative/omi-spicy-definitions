        AskPriceFractionIndicator::NegativeHundredThousand -> ask_price_summary_negative_hundred_thousand_pair: AskPriceSummaryNegativeHundredThousandPair;
        AskPriceFractionIndicator::NegativeMillion -> ask_price_summary_negative_million_pair: AskPriceSummaryNegativeMillionPair;
