    exchange_id: bytes &size=1;
    future_option_symbol: FutureOptionSymbol;
    bid_price_summary: bytes &size=7;
    bid_price_fraction_indicator: uint8 &convert=BidPriceFractionIndicator($$);
    bid_size: bytes &size=5;
    ask_price_summary: bytes &size=7;
    ask_price_fraction_indicator: uint8 &convert=AskPriceFractionIndicator($$);
    ask_size: bytes &size=5;
    last_price: bytes &size=7;
    last_price_fraction_indicator: uint8 &convert=LastPriceFractionIndicator($$);
    open_interest: bytes &size=7;
    open_interest_date: bytes &size=6;
    tick: bytes &size=1;
    volume: bytes &size=8;
    net_change_sign: bytes &size=1;
    net_change: bytes &size=7;
    net_change_fraction_indicator: uint8 &convert=NetChangeFractionIndicator($$);
    opening_price: bytes &size=7;
    opening_price_fraction_indicator: uint8 &convert=OpeningPriceFractionIndicator($$);
    high_price: bytes &size=7;
    high_price_fraction_indicator: uint8 &convert=HighPriceFractionIndicator($$);
    low_price: bytes &size=7;
    low_price_fraction_indicator: uint8 &convert=LowPriceFractionIndicator($$);
    : skip bytes &size=2;   # padding
    settlement_price: bytes &size=7;
    settlement_price_fraction_indicator: uint8 &convert=SettlementPriceFractionIndicator($$);
    previous_settlement_price: bytes &size=7;
    previous_settlement_price_fraction_indicator: uint8 &convert=PreviousSettlementPriceFractionIndicator($$);
    reason: bytes &size=1;
};

type FuturesSummaryMessage = unit {
    long_message_header: LongMessageHeader;
    exchange_id: bytes &size=1;
    future_product: FutureProduct;
    bid_price_summary: bytes &size=7;
    bid_price_fraction_indicator: uint8 &convert=BidPriceFractionIndicator($$);
    bid_size: bytes &size=5;
    ask_price_summary: bytes &size=7;
