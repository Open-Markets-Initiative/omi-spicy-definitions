        MessageType::FuturesMarketDepthMessage -> futures_market_depth_message: FuturesMarketDepthMessage;
        MessageType::StrategyMarketDepthMessage -> strategy_market_depth_message: StrategyMarketDepthMessage;
        MessageType::OptionTradeCancellationMessage -> option_trade_cancellation_message: OptionTradeCancellationMessage;
        MessageType::FutureOptionsTradeCancellationMessage -> future_options_trade_cancellation_message: FutureOptionsTradeCancellationMessage;
        MessageType::FutureTradeCancellationMessage -> future_trade_cancellation_message: FutureTradeCancellationMessage;
        MessageType::StrategyTradeCancellationMessage -> strategy_trade_cancellation_message: StrategyTradeCancellationMessage;
        MessageType::OptionInstrumentKeysMessage -> option_instrument_keys_message: OptionInstrumentKeysMessage;
        MessageType::FutureOptionsInstrumentKeysMessage -> future_options_instrument_keys_message: FutureOptionsInstrumentKeysMessage;
