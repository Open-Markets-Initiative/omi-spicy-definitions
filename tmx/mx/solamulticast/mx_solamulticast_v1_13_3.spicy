    switch ( self.strike_price_schedule_notice_fraction_pair.strike_price_schedule_notice_negative_whole_pair.strike_price_fraction_indicator ) {
        StrikePriceFractionIndicator::NegativeWhole -> strike_price_schedule_notice_negative_whole_pair: StrikePriceScheduleNoticeNegativeWholePair;
        StrikePriceFractionIndicator::NegativeTen -> strike_price_schedule_notice_negative_ten_pair: StrikePriceScheduleNoticeNegativeTenPair;
        StrikePriceFractionIndicator::NegativeHundred -> strike_price_schedule_notice_negative_hundred_pair: StrikePriceScheduleNoticeNegativeHundredPair;
        StrikePriceFractionIndicator::NegativeThousand -> strike_price_schedule_notice_negative_thousand_pair: StrikePriceScheduleNoticeNegativeThousandPair;
        StrikePriceFractionIndicator::NegativeTenThousand -> strike_price_schedule_notice_negative_ten_thousand_pair: StrikePriceScheduleNoticeNegativeTenThousandPair;
        StrikePriceFractionIndicator::NegativeHundredThousand -> strike_price_schedule_notice_negative_hundred_thousand_pair: StrikePriceScheduleNoticeNegativeHundredThousandPair;
        StrikePriceFractionIndicator::NegativeMillion -> strike_price_schedule_notice_negative_million_pair: StrikePriceScheduleNoticeNegativeMillionPair;
        * -> strike_price_schedule_notice_numeric_pair: StrikePriceScheduleNoticeNumericPair;
    };
    expiry_year: bytes &size=2;
    expiry_day: bytes &size=2;
};

