type BondDefinition = unit {
    maturity_date: bytes &size=8;
    # Coupon Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Coupon Fraction Indicator says (Coupon Negative Whole Pair, Coupon Negative Ten Pair, Coupon Negative Hundred Pair, Coupon Negative Thousand Pair, Coupon Negative Ten Thousand Pair, Coupon Negative Hundred Thousand Pair, Coupon Negative Million Pair, Coupon Numeric Pair). They are parsed as CouponNumericPair, so which arm applies is left to what is built on the definition.
    coupon_fraction_pair: CouponNumericPair;
    outstanding_bond_value: bytes &size=8;
    # Conversion Factor Fraction Pair is the same bytes whichever arm the model names: its arms lay them out alike and differ only in what they are called and what they mean, which Conversion Factor Fraction Indicator says (Conversion Factor Negative Whole Pair, Conversion Factor Negative Ten Pair, Conversion Factor Negative Hundred Pair, Conversion Factor Negative Thousand Pair, Conversion Factor Negative Ten Thousand Pair, Conversion Factor Negative Hundred Thousand Pair, Conversion Factor Negative Million Pair, Conversion Factor Numeric Pair). They are parsed as ConversionFactorNumericPair, so which arm applies is left to what is built on the definition.
    conversion_factor_fraction_pair: ConversionFactorNumericPair;
};

