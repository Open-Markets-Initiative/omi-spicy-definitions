module AquisAquisstockexchangeRealtimeAmdV123;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AquisstockexchangeRealtimeV123 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    message_count: uint8;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::OrderAddMessage -> order_add_message: OrderAddMessage;
        MsgType::OrderCancelMessage -> order_cancel_message: OrderCancelMessage;
        MsgType::OrderModifyMessage -> order_modify_message: OrderModifyMessage;
        MsgType::QuoteAddReplaceMessage -> quote_add_replace_message: QuoteAddReplaceMessage;
        MsgType::QuoteCancelMessage -> quote_cancel_message: QuoteCancelMessage;
        MsgType::TradeMessage -> trade_message: TradeMessage;
        MsgType::TradeReportMessage -> trade_report_message: TradeReportMessage;
        MsgType::TradeReportModifyMessage -> trade_report_modify_message: TradeReportModifyMessage;
        MsgType::TradeReportCancelMessage -> trade_report_cancel_message: TradeReportCancelMessage;
        MsgType::TradeBustMessage -> trade_bust_message: TradeBustMessage;
        MsgType::SecurityStatisticsMessage -> security_statistics_message: SecurityStatisticsMessage;
        MsgType::TraderDefinitionMessage -> trader_definition_message: TraderDefinitionMessage;
        MsgType::TickTableDataMessage -> tick_table_data_message: TickTableDataMessage;
        MsgType::SecurityDefinitionMessage -> security_definition_message: SecurityDefinitionMessage;
        MsgType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MsgType::AodUpdateMessage -> aod_update_message: AodUpdateMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_type: uint8 &convert=MsgType($$);
    msg_length: uint8;
    seq_no: uint32;
};

type OrderAddMessage = unit {
    security_id: uint16;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    price: uint64;
    order_ref: uint32;
    timestamp: uint64 &convert=time_ns($$);
};

type OrderCancelMessage = unit {
    security_id: uint16;
    order_ref: uint32;
    timestamp: uint64 &convert=time_ns($$);
};

type OrderModifyMessage = unit {
    security_id: uint16;
    remaining_quantity: uint32;
    price: uint64;
    order_ref: uint32;
    timestamp: uint64 &convert=time_ns($$);
};

type QuoteAddReplaceMessage = unit {
    trader_id: uint16;
    security_id: uint16;
    bid_quantity: uint32;
    bid_price: uint64;
    offer_quantity: uint32;
    offer_price: uint64;
    timestamp: uint64 &convert=time_ns($$);
};

type QuoteCancelMessage = unit {
    trader_id: uint16;
    security_id: uint16;
    timestamp: uint64 &convert=time_ns($$);
};

type TradeMessage = unit {
    security_id: uint16;
    trade_type: uint8 &convert=TradeType($$);
    traded_quantity: uint32;
    execution_price: uint64;
    order_ref: uint32;
    trade_ref: uint32;
    timestamp: uint64 &convert=time_ns($$);
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
};

type TradeReportMessage = unit {
    security_id: uint16;
    trade_type: uint8 &convert=TradeType($$);
    traded_quantity: uint32;
    execution_price: uint64;
    trade_ref: uint32;
    received_timestamp: uint64 &convert=time_ns($$);
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
    transact_time: uint64 &convert=time_ns($$);
};

type TradeReportModifyMessage = unit {
    security_id: uint16;
    trade_type: uint8 &convert=TradeType($$);
    traded_quantity: uint32;
    execution_price: uint64;
    trade_ref: uint32;
    received_timestamp: uint64 &convert=time_ns($$);
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
    transact_time: uint64 &convert=time_ns($$);
    orig_trade_ref: uint32;
    orig_timestamp: uint64 &convert=time_ns($$);
};

type TradeReportCancelMessage = unit {
    orig_security_id: uint16;
    orig_trade_type: uint8;
    orig_quantity: uint32;
    orig_price: uint64;
    trade_ref: uint32;
    received_timestamp: uint64 &convert=time_ns($$);
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
    transact_time: uint64 &convert=time_ns($$);
    orig_trade_ref: uint32;
    orig_timestamp: uint64 &convert=time_ns($$);
    orig_transact_time: uint64 &convert=time_ns($$);
};

type TradeBustMessage = unit {
    security_id: uint16;
    traded_quantity: uint32;
    execution_price: uint64;
    trade_ref: uint32;
    timestamp: uint64 &convert=time_ns($$);
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
};

type SecurityStatisticsMessage = unit {
    security_id: uint16;
    statistics_price: uint64;
    price_type: uint8 &convert=PriceType($$);
    timestamp: uint64 &convert=time_ns($$);
};

type TraderDefinitionMessage = unit {
    trader_id: uint16;
    sender_id: bytes &size=16;
};

type TickTableDataMessage = unit {
    tick_table_id: uint8;
    name: bytes &size=10;
    threshold: uint64;
    tick_size: uint64;
};

type SecurityDefinitionMessage = unit {
    security_id: uint16;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic: bytes &size=4;
    tick_table_id: uint8;
};

type SecurityStatusMessage = unit {
    security_id: uint16;
    trading_status: uint8 &convert=TradingStatus($$);
    market_flags: bitfield(8) {
        trading: 0;
        unused_2: 1..2;
        pre_open_close: 3;
        unused_4: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &convert=time_ns($$);
};

type AodUpdateMessage = unit {
    security_id: uint16;
    indicative_price: uint64;
    match_vol: uint32;
    timestamp: uint64 &convert=time_ns($$);
};

type MsgType = enum {
    HeartbeatMessage = 1,
    OrderAddMessage = 2,
    OrderCancelMessage = 3,
    OrderModifyMessage = 4,
    QuoteAddReplaceMessage = 20,
    QuoteCancelMessage = 21,
    TradeMessage = 5,
    TradeReportMessage = 25,
    TradeReportModifyMessage = 26,
    TradeReportCancelMessage = 27,
    TradeBustMessage = 6,
    SecurityStatisticsMessage = 22,
    TraderDefinitionMessage = 23,
    TickTableDataMessage = 7,
    SecurityDefinitionMessage = 8,
    SecurityStatusMessage = 9,
    AodUpdateMessage = 17,
};

type Side = enum {
    BuyOrder = 1,
    SellOrder = 2,
};

type TradeType = enum {
    Visible = 1,
    HiddenOrReserve = 2,
    AuctionOnDemandTrade = 6,
    TradeCaptureReportTrade = 8,
};

type MarketMechanism = enum {
    CentralLimitOrderBook = 1,
    QuoteDrivenMarket = 2,
    DarkOrderBook = 3,
    OffBook = 4,
    PeriodicAuction = 5,
    Rfq = 6,
    Other = 7,
};

type TradingMode = enum {
    UndefinedAuction = 1,
    OpeningAuction = 2,
    ClosingAuction = 3,
    IntradayAuction = 4,
    UnscheduledAuction = 5,
    ContinuousTrading = 6,
    AtMarketClose = 7,
    OutOfMainSession = 8,
    OnExchangeTradeReporting = 9,
    OffExchangeTradeReporting = 10,
    SystematicInternalizerTradeReporting = 11,
};

type TransactionCategory = enum {
    DarkTrade = 1,
    TradeThatHasReceivedPriceImprovement = 2,
    PackageTrade = 3,
    ExchangeForPhysicals = 4,
    NoneApply = 5,
};

type NegotiationIndicatorOrPreTradeTransparencyWaiver = enum {
    NegotiatedTrade = 0,
    NegotiatedTradeInLiquidInstruments = 1,
    NegotiatedTradeInIlliquidInstruments = 2,
    NegotiatedTradeOtherThanCurrentMarketPrice = 3,
    NoNegotiatedTrade = 4,
    SiIlliquidInstruments = 5,
    SiAboveStandardMarketSize = 6,
    IlqdAndSize = 7,
};

type CrossingTrade = enum {
    No = 0,
    Yes = 1,
};

type ModificationIndicator = enum {
    TradeCancelation = 1,
    TradeAmendment = 2,
    NewTrade = 3,
};

type BenchmarkReferencePriceIndicator = enum {
    BenchmarkTrade = 1,
    ReferencePriceTrade = 2,
    NoBenchmarkOrRefPrice = 3,
};

type Dividend = enum {
    No = 0,
    Yes = 1,
};

type OffBookAutomation = enum {
    Unspecified = 1,
    OffBookNonAutomated = 2,
    OffBookAutomated = 3,
};

type PriceFormationDiscoveryProcess = enum {
    PlainVanilla = 1,
    NonPriceForming = 2,
    TradeNotContributingToPriceDiscovery = 3,
    PriceNotCurrentlyAvailableButPending = 4,
};

type AlgorithmicIndicator = enum {
    No = 0,
    Yes = 1,
};

type PublicationModePostTradeDeferral = enum {
    ImmediatePublication = 1,
    NonImmediatePublication = 2,
    Lrgs = 3,
    Ilqd = 4,
    Size = 5,
    IlqdAndSize = 6,
    IlqdAndLrgs = 7,
};

type DeferralType = enum {
    NoneApply = 0,
};

type DuplicativeIndicator = enum {
    Unique = 0,
    Duplicative = 1,
};

type PriceType = enum {
    OpeningPrice = 2,
    ClosingPrice = 5,
};

type TradingStatus = enum {
    Active = 1,
    Halted = 2,
    Suspended = 3,
};

type Trading = enum {
    ContinuousTradingClosed = 0,
    ContinuousTradingOpen = 1,
};

type PreOpenClose = enum {
    NotAPrePhase = 0,
    PrePhase = 1,
};

