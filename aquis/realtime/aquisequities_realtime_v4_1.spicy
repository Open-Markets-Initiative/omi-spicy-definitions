module AquisAquisequitiesRealtimeAmdV41;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type AquisequitiesRealtimeV41 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    message_count: uint8;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::OrderAddMessage -> order_add_message: OrderAddMessage;
        MsgType::OrderCancelMessage -> order_cancel_message: OrderCancelMessage;
        MsgType::OrderModifyMessage -> order_modify_message: OrderModifyMessage;
        MsgType::TradeMessage -> trade_message: TradeMessage;
        MsgType::TradeBustMessage -> trade_bust_message: TradeBustMessage;
        MsgType::TickTableDataMessage -> tick_table_data_message: TickTableDataMessage;
        MsgType::SecurityDefinitionMessage -> security_definition_message: SecurityDefinitionMessage;
        MsgType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MsgType::AodUpdateMessage -> aod_update_message: AodUpdateMessage;
        MsgType::MacUpdateMessage -> mac_update_message: MacUpdateMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_type: uint8 &convert=MsgType($$);
    msg_length: uint8;
    seq_no: uint32;
};

type OrderAddMessage = unit {
    security_id: uint16;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    price: uint64;
    order_ref: uint32;
    timestamp: uint64;
    md_flags: bitfield(8) {
        unrestricted_liquidity: 0;
        unused_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type OrderCancelMessage = unit {
    security_id: uint16;
    order_ref: uint32;
    timestamp: uint64;
    md_flags: bitfield(8) {
        unrestricted_liquidity: 0;
        unused_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type OrderModifyMessage = unit {
    security_id: uint16;
    quantity: uint32;
    price: uint64;
    order_ref: uint32;
    timestamp: uint64;
    md_flags: bitfield(8) {
        unrestricted_liquidity: 0;
        unused_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type TradeMessage = unit {
    security_id: uint16;
    trade_type: uint8 &convert=TradeType($$);
    quantity: uint32;
    price: uint64;
    order_ref: uint32;
    trade_ref: uint32;
    timestamp: uint64;
    mic_char_44: bytes &size=4;
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
    md_flags: bitfield(8) {
        unrestricted_liquidity: 0;
        unused_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type TradeBustMessage = unit {
    security_id: uint16;
    quantity: uint32;
    price: uint64;
    trade_ref: uint32;
    timestamp: uint64;
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
};

type TickTableDataMessage = unit {
    tick_table_id: uint8;
    name: bytes &size=10;
    threshold: uint64;
    tick_size: uint64;
};

type SecurityDefinitionMessage = unit {
    security_id: uint16;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic_mic_4: bytes &size=4;
    tick_table_id: uint8;
    flags: bitfield(16) {
        mac_enabled: 0;
        test_stock: 1;
        illiquid: 2;
        unused_1: 3;
        aod_enabled: 4;
        unused_2: 5..6;
        avx_enabled: 7;
        unused_8: 8..15;
    } &byte-order=spicy::ByteOrder::Little;
    reserved: bytes &size=20;
    lot_size_composite: LotSizeComposite;
};

type LotSizeComposite = unit {
    lot_size: uint64;
    lot_size_decimal: uint8;
};

type SecurityStatusMessage = unit {
    security_id: uint16;
    trading_status: uint8 &convert=TradingStatus($$);
    market_flags: bitfield(8) {
        trading: 0;
        mac_open: 1;
        mac_run: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64;
    trading_phase: uint8 &convert=TradingPhase($$);
};

type AodUpdateMessage = unit {
    security_id: uint16;
    indicative_price: uint64;
    match_vol: uint32;
    timestamp: uint64;
};

type MacUpdateMessage = unit {
    security_id: uint16;
    indicative_price: uint64;
    closing_buy_qty: uint32;
    closing_sell_qty: uint32;
    timestamp: uint64;
};

type MsgType = enum {
    HeartbeatMessage = 1,
    OrderAddMessage = 2,
    OrderCancelMessage = 3,
    OrderModifyMessage = 4,
    TradeMessage = 5,
    TradeBustMessage = 6,
    TickTableDataMessage = 7,
    SecurityDefinitionMessage = 8,
    SecurityStatusMessage = 9,
    AodUpdateMessage = 17,
    MacUpdateMessage = 16,
};

type Side = enum {
    BuyOrder = 1,
    SellOrder = 2,
};

type UnrestrictedLiquidity = enum {
    RestrictedLiquidityOnly = 0,
    UnrestrictedLiquidityAvailable = 1,
};

type TradeType = enum {
    Visible = 1,
    HiddenOrReserve = 2,
    MarketAtCloseTrade = 3,
    LisCrossTrade = 4,
    BenchmarkCrossTrade = 5,
    AuctionOnDemandTrade = 6,
    AquisVwapMatchTrade = 12,
};

type MarketMechanism = enum {
    CentralLimitOrderBook = 1,
    QuoteDrivenMarket = 2,
    DarkOrderBook = 3,
    OffBook = 4,
    PeriodicAuction = 5,
    Rfq = 6,
    Other = 7,
};

type TradingMode = enum {
    UndefinedAuction = 1,
    OpeningAuction = 2,
    ClosingAuction = 3,
    IntradayAuction = 4,
    UnscheduledAuction = 5,
    ContinuousTrading = 6,
    AtMarketClose = 7,
    OutOfMainSession = 8,
    OnExchangeTradeReporting = 9,
    OffExchangeTradeReporting = 10,
    SystematicInternalizerTradeReporting = 11,
};

type TransactionCategory = enum {
    DarkTrade = 1,
    TradeThatHasReceivedPriceImprovement = 2,
    PackageTrade = 3,
    ExchangeForPhysicals = 4,
    NoneApply = 5,
};

type NegotiationIndicatorOrPreTradeTransparencyWaiver = enum {
    NegotiatedTrade = 0,
    NegotiatedTradeInLiquidInstruments = 1,
    NegotiatedTradeInIlliquidInstruments = 2,
    NegotiatedTradeOtherThanCurrentMarketPrice = 3,
    NoNegotiatedTrade = 4,
    SiIlliquidInstruments = 5,
    SiAboveStandardMarketSize = 6,
    IlqdAndSize = 7,
};

type CrossingTrade = enum {
    No = 0,
    Yes = 1,
};

type ModificationIndicator = enum {
    TradeCancelation = 1,
    TradeAmendment = 2,
    NewTrade = 3,
};

type BenchmarkReferencePriceIndicator = enum {
    BenchmarkTrade = 1,
    ReferencePriceTrade = 2,
    NoBenchmarkOrRefPrice = 3,
};

type Dividend = enum {
    No = 0,
    Yes = 1,
};

type OffBookAutomation = enum {
    Unspecified = 1,
    OffBookNonAutomated = 2,
    OffBookAutomated = 3,
};

type PriceFormationDiscoveryProcess = enum {
    PlainVanilla = 1,
    NonPriceForming = 2,
    TradeNotContributingToPriceDiscovery = 3,
    PriceNotCurrentlyAvailableButPending = 4,
};

type AlgorithmicIndicator = enum {
    No = 0,
    Yes = 1,
};

type PublicationModePostTradeDeferral = enum {
    ImmediatePublication = 1,
    NonImmediatePublication = 2,
    Lrgs = 3,
    Ilqd = 4,
    Size = 5,
    IlqdAndSize = 6,
    IlqdAndLrgs = 7,
};

type DeferralType = enum {
    NoneApply = 0,
};

type DuplicativeIndicator = enum {
    Unique = 0,
    Duplicative = 1,
};

type TradingStatus = enum {
    Active = 1,
    Halted = 2,
    Suspended = 3,
    AodStart = 8,
    AodEnd = 24,
};

type Trading = enum {
    ContinuousTradingClosed = 0,
    ContinuousTradingOpen = 1,
};

type MacOpen = enum {
    MacIsClosed = 0,
    MacIsOpen = 1,
};

type MacRun = enum {
    MacIsNotLockedDown = 0,
    MacIsLockedDown = 1,
};

type TradingPhase = enum {
    Closed = 0,
    Continuous = 1,
};

