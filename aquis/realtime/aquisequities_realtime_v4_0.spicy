module AquisAquisequitiesRealtimeAmdV40;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type AquisequitiesRealtimeV40 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    message_count: uint8;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.msg_type ) {
        MsgType::OrderAdd -> order_add: OrderAdd;
        MsgType::OrderCancel -> order_cancel: OrderCancel;
        MsgType::OrderModify -> order_modify: OrderModify;
        MsgType::Trade -> trade: Trade;
        MsgType::TradeBustMessage -> trade_bust_message: TradeBustMessage;
        MsgType::TickTableDataMessage -> tick_table_data_message: TickTableDataMessage;
        MsgType::SecurityDefinitionMessage -> security_definition_message: SecurityDefinitionMessage;
        MsgType::SecurityStatusMessage -> security_status_message: SecurityStatusMessage;
        MsgType::AoDUpdateMessage -> ao_d_update_message: AoDUpdateMessage;
        MsgType::MaCUpdateMessage -> ma_c_update_message: MaCUpdateMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    msg_type: uint8 &convert=MsgType($$);
    msg_length: uint8;
    seq_no: uint32;
};

type OrderAdd = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    side: uint8 &convert=Side($$);
    quantity: uint32 &byte-order=spicy::ByteOrder::Little;
    price: uint64 &byte-order=spicy::ByteOrder::Little;
    order_ref: uint32 &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
    md_flags: bitfield(8) {
        unrestricted_liquidity_indicator: 0;
        unused_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type OrderCancel = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    order_ref: uint32 &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
    md_flags: bitfield(8) {
        unrestricted_liquidity_indicator: 0;
        unused_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type OrderModify = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    quantity: uint32 &byte-order=spicy::ByteOrder::Little;
    price: uint64 &byte-order=spicy::ByteOrder::Little;
    order_ref: uint32 &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
    md_flags: bitfield(8) {
        unrestricted_liquidity_indicator: 0;
        unused_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type Trade = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    trade_type: uint8 &convert=TradeType($$);
    quantity: uint32 &byte-order=spicy::ByteOrder::Little;
    price: uint64 &byte-order=spicy::ByteOrder::Little;
    order_ref: uint32 &byte-order=spicy::ByteOrder::Little;
    trade_ref: uint32 &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
    md_flags: bitfield(8) {
        unrestricted_liquidity_indicator: 0;
        unused_7: 1..7;
    } &byte-order=spicy::ByteOrder::Little;
};

type TradeBustMessage = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    quantity: uint32 &byte-order=spicy::ByteOrder::Little;
    price: uint64 &byte-order=spicy::ByteOrder::Little;
    trade_ref: uint32 &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
    binary_mmt: bitfield(32) {
        market_mechanism: 0..2;
        trading_mode: 3..6;
        transaction_category: 7..9;
        negotiation_indicator_or_pre_trade_transparency_waiver: 10..12;
        crossing_trade: 13;
        modification_indicator: 14..15;
        benchmark_reference_price_indicator: 16..17;
        dividend: 18;
        off_book_automation: 19..20;
        price_formation_discovery_process: 21..23;
        algorithmic_indicator: 24;
        publication_mode_post_trade_deferral: 25..27;
        deferral_type: 28;
        duplicative_indicator: 29;
        unused_2: 30..31;
    } &byte-order=spicy::ByteOrder::Little;
};

type TickTableDataMessage = unit {
    tick_table_id: uint8;
    name: bytes &size=10;
    threshold: uint64 &byte-order=spicy::ByteOrder::Little;
    tick_size: uint64 &byte-order=spicy::ByteOrder::Little;
};

type SecurityDefinitionMessage = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    umtf: bytes &size=6;
    isin: bytes &size=12;
    currency: bytes &size=3;
    mic: bytes &size=4;
    tick_table_id: uint8;
    security_definition_flags: bitfield(16) {
        mac_enabled: 0;
        test_stock: 1;
        illiquid: 2;
        unused_1: 3;
        aod_enabled: 4;
        unused_2: 5..6;
        avx_enabled: 7;
        unused_8: 8..15;
    } &byte-order=spicy::ByteOrder::Little;
    reserved_20: bytes &size=20;
    lot_size: uint64 &byte-order=spicy::ByteOrder::Little;
    lot_size_decimal: uint8;
};

type SecurityStatusMessage = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    trading_status: uint8 &convert=TradingStatus($$);
    market_flags: bitfield(8) {
        trading: 0;
        mac_open: 1;
        mac_run: 2;
        unused_5: 3..7;
    } &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
    trading_phase: uint8 &convert=TradingPhase($$);
};

type AoDUpdateMessage = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    indicative_price: uint64 &byte-order=spicy::ByteOrder::Little;
    match_vol: uint32 &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
};

type MaCUpdateMessage = unit {
    security_id: uint16 &byte-order=spicy::ByteOrder::Little;
    indicative_price: uint64 &byte-order=spicy::ByteOrder::Little;
    closing_buy_qty: uint32 &byte-order=spicy::ByteOrder::Little;
    closing_sell_qty: uint32 &byte-order=spicy::ByteOrder::Little;
    timestamp: uint64 &byte-order=spicy::ByteOrder::Little;
};

type MsgType = enum {
    OrderAdd = 2,
    OrderCancel = 3,
    OrderModify = 4,
    Trade = 5,
    TradeBustMessage = 6,
    TickTableDataMessage = 7,
    SecurityDefinitionMessage = 8,
    SecurityStatusMessage = 9,
    AoDUpdateMessage = 17,
    MaCUpdateMessage = 16,
};

type Side = enum {
    BuyOrder = 1,
    SellOrder = 2,
};

type TradeType = enum {
    VisibleOrder = 1,
    HiddenOrder = 2,
    MarketAtClose = 3,
    LisCross = 4,
    BenchmarkCross = 5,
    AuctionOnDemand = 6,
    AquisVwapMatch = 12,
};

type MarketMechanism = enum {
    CentralLimitOrderBook = 1,
    QuoteDrivenMarket = 2,
    DarkOrderBook = 3,
    OffBook = 4,
    PeriodicAuction = 5,
    Rfq = 6,
    Other = 7,
};

type TradingMode = enum {
    UndefinedAuction = 1,
    OpeningAuction = 2,
    ClosingAuction = 3,
    IntradayAuction = 4,
    UnscheduledAuction = 5,
    ContinuousTrading = 6,
    AtMarketClose = 7,
    OutOfMainSession = 8,
    OnExchangeTradeReporting = 9,
};

type TransactionCategory = enum {
    DarkTrade = 1,
    TradeThatHasReceivedPriceImprovement = 2,
    PackageTrade = 3,
    ExchangeForPhysicals = 4,
    NoneApply = 5,
};

type NegotiationIndicatorOrPreTradeTransparencyWaiver = enum {
    NegotiatedTrade = 0,
    NegotiatedTradeInLiquidInstruments = 1,
    NegotiatedTradeInIlliquidInstruments = 2,
    NegotiatedTradeOtherThanCurrentMarketPrice = 3,
    NoNegotiatedTrade = 4,
    SiIlliquidInstruments = 5,
    SiAboveStandardMarketSize = 6,
    IlqdAndSize = 7,
};

type CrossingTrade = enum {
    No = 0,
    Yes = 1,
};

type ModificationIndicator = enum {
    TradeCancelation = 1,
    TradeAmendment = 2,
    NewTrade = 3,
};

type BenchmarkReferencePriceIndicator = enum {
    BenchmarkTrade = 1,
    ReferencePriceTrade = 2,
    NoBenchmarkOrReferencePrice = 3,
};

type Dividend = enum {
    No = 0,
    Yes = 1,
};

type OffBookAutomation = enum {
    Unspecified = 1,
    OffBookNonAutomated = 2,
    OffBookAutomated = 3,
};

type PriceFormationDiscoveryProcess = enum {
    PlainVanilla = 1,
    NonPriceForming = 2,
    TradeNotContributingToPriceDiscovery = 3,
    PriceNotCurrentlyAvailableButPending = 4,
};

type AlgorithmicIndicator = enum {
    No = 0,
    Yes = 1,
};

type PublicationModePostTradeDeferral = enum {
    ImmediatePublication = 1,
    NonImmediatePublication = 2,
    Lrgs = 3,
    Ilqd = 4,
    Size = 5,
    IlqdAndSize = 6,
    IlqdAndLrgs = 7,
};

type DuplicativeIndicator = enum {
    Unique = 0,
    Duplicative = 1,
};

type TradingStatus = enum {
    Active = 1,
    Halted = 2,
    Suspended = 3,
    AoDStart = 8,
    AoDEnd = 24,
};

type TradingPhase = enum {
    Closed = 0,
    Continuous = 1,
};

