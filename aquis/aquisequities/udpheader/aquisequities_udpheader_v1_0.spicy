module AquisAquisequitiesUdpheaderAmdV10;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type AquisequitiesUdpheaderV10 = unit {
    packet_header: PacketHeader;
    message: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    message_count: uint8;
};

type Message = unit {
    message_header: MessageHeader;
    payload: bytes &eod;
};

type MessageHeader = unit {
    msg_type: uint8;
    msg_length: uint8;
    seq_no: uint32;
};

