module AquisAquisequitiesTcpheaderAmdV10;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type AquisequitiesTcpheaderV10 = unit {
    message: Message[] &eod;
};

type Message = unit {
    message_header: MessageHeader;
    payload: bytes &eod;
};

type MessageHeader = unit {
    msg_type: uint8;
    msg_length: uint8;
    seq_no: uint32;
};

