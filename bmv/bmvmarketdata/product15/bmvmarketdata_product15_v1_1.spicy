module BmvBmvmarketdataProduct15IntraV11;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type BmvmarketdataProduct15V11 = unit {
    intra_multicast_header: IntraMulticastHeader;
    message_block: MessageBlock[self.intra_multicast_header.total_messages];
};

type IntraMulticastHeader = unit {
    length: int16;
    total_messages: int8;
    market_data_group: int8 &convert=MarketDataGroup($$);
    session: int8;
    sequence_number: int32;
    datetime: int64 &convert=time($$ / 1000.0);
};

type MessageBlock = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::EventsSystemMessage -> events_system_message: EventsSystemMessage;
        MessageType::TradeCancellationMessage -> trade_cancellation_message: TradeCancellationMessage;
        MessageType::StatusChangesMessage -> status_changes_message: StatusChangesMessage;
        MessageType::WeightedAveragePriceSettlementPricesMessage -> weighted_average_price_settlement_prices_message: WeightedAveragePriceSettlementPricesMessage;
        MessageType::CapitalTradesMessage -> capital_trades_message: CapitalTradesMessage;
        MessageType::ProbableAllocationPriceMessage -> probable_allocation_price_message: ProbableAllocationPriceMessage;
        MessageType::ContinuousAuctionsBeginningMessage -> continuous_auctions_beginning_message: ContinuousAuctionsBeginningMessage;
        MessageType::MiddlePriceExistingQuotesMessage -> middle_price_existing_quotes_message: MiddlePriceExistingQuotesMessage;
        MessageType::RegistryOperationsMessage -> registry_operations_message: RegistryOperationsMessage;
        MessageType::MutualFundTradesMessage -> mutual_fund_trades_message: MutualFundTradesMessage;
        MessageType::TradabilityMessage -> tradability_message: TradabilityMessage;
        MessageType::VirtualTradesMessage -> virtual_trades_message: VirtualTradesMessage;
        MessageType::OrderAdditionMessage -> order_addition_message: OrderAdditionMessage;
        MessageType::ExecutionOfOrdersMessage -> execution_of_orders_message: ExecutionOfOrdersMessage;
        MessageType::OrderCancellationMessage -> order_cancellation_message: OrderCancellationMessage;
        MessageType::OrderChangeMessage -> order_change_message: OrderChangeMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: int16;
    message_type: uint8 &convert=MessageType($$);
};

type EventsSystemMessage = unit {
    instrument_number: int32;
    event_code: uint8 &convert=EventCode($$);
    market: uint8 &convert=Market($$);
    sending_time: int64 &convert=time($$ / 1000.0);
    ending_time: int64 &convert=time($$ / 1000.0);
};

type TradeCancellationMessage = unit {
    instrument_number: int32;
    trade_number: int32;
};

type StatusChangesMessage = unit {
    instrument_number: int32;
    instrument_status: uint8 &convert=InstrumentStatus($$);
};

type WeightedAveragePriceSettlementPricesMessage = unit {
    instrument_number: int32;
    weighted_average_price: int64;
    volatility: int64;
};

type CapitalTradesMessage = unit {
    instrument_number: int32;
    trade_time: int64 &convert=time($$ / 1000.0);
    volume_int_324: int32;
    price: int64;
    concertation_type: uint8 &convert=ConcertationType($$);
    trade_number: int32;
    price_setter: bytes &size=1;
    operation_type: uint8 &convert=OperationType($$);
    amount: int64;
    buy: bytes &size=5;
    sell: bytes &size=5;
    settlement: uint8 &convert=Settlement($$);
    auction_indicator: uint8 &convert=AuctionIndicator($$);
};

type ProbableAllocationPriceMessage = unit {
    instrument_number: int32;
    probable_allocation_price: int64;
    volume_int_324: int32;
};

type ContinuousAuctionsBeginningMessage = unit {
    instrument_number: int32;
    beginning_time_of_auction: int64 &convert=time($$ / 1000.0);
    end_auction_time: int64 &convert=time($$ / 1000.0);
};

type MiddlePriceExistingQuotesMessage = unit {
    instrument_number: int32;
    existing_postures: bytes &size=1;
};

type RegistryOperationsMessage = unit {
    instrument_number: int32;
    offer_type: uint8 &convert=OfferType($$);
    income: uint8 &convert=Income($$);
    value_type: bytes &size=4;
    issuer: bytes &size=7;
    series: bytes &size=6;
    maximum_volume: int64;
    registered_volume: int64;
    price_rate: int64;
    settlement_date: int64 &convert=time($$ / 1000.0);
    firm: bytes &size=5;
    movement: uint8 &convert=Movement($$);
};

type MutualFundTradesMessage = unit {
    instrument_number: int32;
    trade_date: int64 &convert=time($$ / 1000.0);
    price: int64;
    book_value: int64;
    number_of_sales_transactions: int32;
    sales_volume: int64;
    number_of_buy_transactions: int32;
    buy_volume: int64;
};

type TradabilityMessage = unit {
    instrument_number: int32;
    number_of_operations: int32;
    volume_int_648: int64;
    amount: int64;
    opening_price: int64;
    maximum: int64;
    minimum: int64;
    average: int64;
    last: int64;
};

type VirtualTradesMessage = unit {
    instrument_number: int32;
    virtual_trades_status: uint8 &convert=VirtualTradesStatus($$);
    operation_type: uint8 &convert=OperationType($$);
    number: int32;
    volume_int_324: int32;
    concertation: uint8 &convert=Concertation($$);
    buy: bytes &size=5;
    sell: bytes &size=5;
};

type OrderAdditionMessage = unit {
    instrument_number: int32;
    date_and_time: int64 &convert=time($$ / 1000.0);
    number: int32;
    direction: uint8 &convert=Direction($$);
    volume_int_324: int32;
    price: int64;
    participant: bytes &size=5;
};

type ExecutionOfOrdersMessage = unit {
    instrument_number: int32;
    date: int64 &convert=time($$ / 1000.0);
    number: int32;
    volume_int_324: int32;
    trade_number: int32;
    execution_price: int64;
};

type OrderCancellationMessage = unit {
    instrument_number: int32;
    date: int64 &convert=time($$ / 1000.0);
    number: int32;
};

type OrderChangeMessage = unit {
    instrument_number: int32;
    original_date: int64 &convert=time($$ / 1000.0);
    original_number: int32;
    new_date: int64 &convert=time($$ / 1000.0);
    new_number: int32;
    direction: uint8 &convert=Direction($$);
    volume_int_324: int32;
    price: int64;
};

type MarketDataGroup = enum {
    IndepthLocalMarket = 1,
    IndepthGlobalMarket = 2,
    TwentyPriceLevelsOfLocalMarket = 3,
    TwentyPriceLevelsOfGlobalMarket = 4,
    BestOffersOfLocalMarket = 5,
    BestOffersOfGlobalMarket = 6,
    TenPriceLevelsOfDerivativeFutures = 7,
    TenPriceLevelsOfDerivativeOptions = 8,
    BestOffersForDerivativeFutures = 9,
    BestOffersForDerivativeOptions = 10,
    MoneyMarket = 11,
    IndicesComponents = 12,
    LevelOfIndices = 13,
    LevelsOfInavs = 14,
    IndepthLocalAndGlobalMarket = 15,
    TwentyPriceLevelsOfLocalAndGlobalMarket = 16,
    BestOffersOfLocalAndGlobalMarketWithMoneyMarket = 17,
    TwentyPriceLevelsOfLocalAndGlobalMarketIndicesComponentsLevelOfIndicesAndLevelsOfInavs = 18,
    TenPriceLevelsOfDerivateFuturesAndDerivativeOptions = 19,
    BestOffersForDerivativeFuturesAndDerivativeOptions = 20,
    AddedValueWithBenchmark = 21,
    AddedValueWithCapitalizationRules = 22,
    IndicesLevelsWithDelay = 23,
    LocalAndGlobalMarketWithMoneyMarketBestPositionsWithDelay = 24,
    EquitiesMarketTradesConsolidatedFeed = 25,
    BestBidOfTheEquitiesMarketConsolidatedFeed = 26,
    FullDepthConsolidatedFeed = 27,
    ClosingPriceOrigin = 28,
    AnalyticsPriceAndMarketDepth = 29,
    AnalyticsMarketQuality = 32,
    AnalyticsSpeadPerformance = 33,
    AnalyticsNegotiation = 34,
    ChannelZeroCatalogs = 40,
};

type MessageType = enum {
    EventsSystemMessage = 0x53,
    TradeCancellationMessage = 0x48,
    StatusChangesMessage = 0x34,
    WeightedAveragePriceSettlementPricesMessage = 0x4d,
    CapitalTradesMessage = 0x50,
    ProbableAllocationPriceMessage = 0x32,
    ContinuousAuctionsBeginningMessage = 0x33,
    MiddlePriceExistingQuotesMessage = 0x35,
    RegistryOperationsMessage = 0x5a,
    MutualFundTradesMessage = 0x59,
    TradabilityMessage = 0x45,
    VirtualTradesMessage = 0x56,
    OrderAdditionMessage = 0x41,
    ExecutionOfOrdersMessage = 0x43,
    OrderCancellationMessage = 0x44,
    OrderChangeMessage = 0x46,
};

type EventCode = enum {
    StartOfSystemHours = 0x41,
    CancelationOfOffers = 0x42,
    StartOfOpeningAuction = 0x43,
    StartOfContinuousMarket = 0x44,
    StartOfWapPeriod = 0x45,
    ContinuousMarketEnds = 0x46,
    StartOfAfterClosingPhase = 0x47,
