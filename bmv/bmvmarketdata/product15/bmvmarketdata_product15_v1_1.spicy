    EndOfDvmaMarkets = 0x50,
    EndOfMxMarkets = 0x51,
    StartOfOpcModality = 0x52,
    EndOfOpcModality = 0x53,
    StartOfSettlementAuction = 0x54,
    EndOfSettlementAuction = 0x55,
    FinalRegisterOfSettlementPrices = 0x56,
    OpenInterest = 0x57,
};

type Market = enum {
    Local = 0x4c,
    Global = 0x47,
    LocalDebt = 0x44,
    GlobalDebt = 0x46,
    Money = 0x45,
    DollarOptionMarket = 0x4d,
    StockMarket = 0x58,
    ForexAndRatesMarket = 0x56,
    FixedIncome = 0x4a,
    VariableIncome = 0x42,
    Metals = 0x54,
    MutualFunds = 0x49,
    Warrants = 0x57,
    AllMarkets = 0x20,
};

