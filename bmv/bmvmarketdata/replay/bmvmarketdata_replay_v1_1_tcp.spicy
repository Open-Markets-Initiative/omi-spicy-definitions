# License: MIT No Attribution

module BmvBmvmarketdataReplayIntraV11Tcp;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type BmvmarketdataReplayV11 = unit {
    tcp_unit: TcpUnit[] &eod;
};

type TcpUnit = unit {
    intra_multicast_header: IntraMulticastHeader;
    message_block: MessageBlock[self.intra_multicast_header.total_messages];
};

type IntraMulticastHeader = unit {
    length: int16;
    total_messages: int8;
    market_data_group: int8 &convert=MarketDataGroup($$);
    session: int8;
    sequence_number: int32;
    datetime: int64 &convert=time($$ / 1000.0);
};

type MessageBlock = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::LoginResponseMessage -> login_response_message: LoginResponseMessage;
        MessageType::ReplayResponseMessage -> replay_response_message: ReplayResponseMessage;
        MessageType::SnapshotResponseMessage -> snapshot_response_message: SnapshotResponseMessage;
        MessageType::SnapshotCompleteMessage -> snapshot_complete_message: SnapshotCompleteMessage;
        MessageType::EventsSystemMessage -> events_system_message: EventsSystemMessage;
        MessageType::TradeCancellationMessage -> trade_cancellation_message: TradeCancellationMessage;
        MessageType::StatusChangesMessage -> status_changes_message: StatusChangesMessage;
        MessageType::WeightedAveragePriceSettlementPricesMessage -> weighted_average_price_settlement_prices_message: WeightedAveragePriceSettlementPricesMessage;
        MessageType::CapitalTradesMessage -> capital_trades_message: CapitalTradesMessage;
        MessageType::ProbableAllocationPriceMessage -> probable_allocation_price_message: ProbableAllocationPriceMessage;
        MessageType::ContinuousAuctionsBeginningMessage -> continuous_auctions_beginning_message: ContinuousAuctionsBeginningMessage;
        MessageType::MiddlePriceExistingQuotesMessage -> middle_price_existing_quotes_message: MiddlePriceExistingQuotesMessage;
        MessageType::RegistryOperationsMessage -> registry_operations_message: RegistryOperationsMessage;
        MessageType::MutualFundTradesMessage -> mutual_fund_trades_message: MutualFundTradesMessage;
        MessageType::TradabilityMessage -> tradability_message: TradabilityMessage;
        MessageType::VirtualTradesMessage -> virtual_trades_message: VirtualTradesMessage;
        MessageType::OrderAdditionMessage -> order_addition_message: OrderAdditionMessage;
        MessageType::ExecutionOfOrdersMessage -> execution_of_orders_message: ExecutionOfOrdersMessage;
        MessageType::OrderCancellationMessage -> order_cancellation_message: OrderCancellationMessage;
        MessageType::OrderChangeMessage -> order_change_message: OrderChangeMessage;
        MessageType::DepthMessage -> depth_message: DepthMessage;
        MessageType::BestOfferMessage -> best_offer_message: BestOfferMessage;
        MessageType::PublicOfferingsMessage -> public_offerings_message: PublicOfferingsMessage;
        MessageType::OpenInterestMessage -> open_interest_message: OpenInterestMessage;
        MessageType::DerivativesMarketTradesMessage -> derivatives_market_trades_message: DerivativesMarketTradesMessage;
        MessageType::StatisticsOfInstrumentsMessage -> statistics_of_instruments_message: StatisticsOfInstrumentsMessage;
        MessageType::GeneralIndicesMessage -> general_indices_message: GeneralIndicesMessage;
        MessageType::IndicesComponentsMessage -> indices_components_message: IndicesComponentsMessage;
        MessageType::InavMessage -> inav_message: InavMessage;
        MessageType::DollarBuySellMessage -> dollar_buy_sell_message: DollarBuySellMessage;
        MessageType::ShortSalesBalancesPerInstrumentMessage -> short_sales_balances_per_instrument_message: ShortSalesBalancesPerInstrumentMessage;
        MessageType::CapitalMarketMultiplesMessage -> capital_market_multiples_message: CapitalMarketMultiplesMessage;
        MessageType::BenchmarkMessage -> benchmark_message: BenchmarkMessage;
        MessageType::CapitalizationRulesMessage -> capitalization_rules_message: CapitalizationRulesMessage;
        MessageType::ClosingPriceOriginMessage -> closing_price_origin_message: ClosingPriceOriginMessage;
        MessageType::MutualFundsTradesMessage -> mutual_funds_trades_message: MutualFundsTradesMessage;
        MessageType::OpeningOfContinuousAuctionsMessage -> opening_of_continuous_auctions_message: OpeningOfContinuousAuctionsMessage;
        MessageType::ExistenceOfBidsAtMidPriceMessage -> existence_of_bids_at_mid_price_message: ExistenceOfBidsAtMidPriceMessage;
        MessageType::CatalogueOfDebtAndMetalsInstrumentsMessage -> catalogue_of_debt_and_metals_instruments_message: CatalogueOfDebtAndMetalsInstrumentsMessage;
        MessageType::CatalogSentForInstrumentsBelongingToMutualFundsMessage -> catalog_sent_for_instruments_belonging_to_mutual_funds_message: CatalogSentForInstrumentsBelongingToMutualFundsMessage;
        MessageType::WeightedAveragePriceMessage -> weighted_average_price_message: WeightedAveragePriceMessage;
        MessageType::SystemEventsMessage -> system_events_message: SystemEventsMessage;
        MessageType::ReferencePriceMessage -> reference_price_message: ReferencePriceMessage;
        MessageType::ChangesInStatusMessage -> changes_in_status_message: ChangesInStatusMessage;
        MessageType::CatalogForInstrumentsBelongingToTheCapitalWarrantsMarketMessage -> catalog_for_instruments_belonging_to_the_capital_warrants_market_message: CatalogForInstrumentsBelongingToTheCapitalWarrantsMarketMessage;
        MessageType::CatalogSentForInstrumentsBelongingToCapitalTracsMessage -> catalog_sent_for_instruments_belonging_to_capital_tracs_message: CatalogSentForInstrumentsBelongingToCapitalTracsMessage;
        MessageType::ConsolidatedInavMessage -> consolidated_inav_message: ConsolidatedInavMessage;
        MessageType::CatalogForInstrumentsBelongingToTheLocalAndGlobalStockMarketMessage -> catalog_for_instruments_belonging_to_the_local_and_global_stock_market_message: CatalogForInstrumentsBelongingToTheLocalAndGlobalStockMarketMessage;
        MessageType::ProbablePriceOfAllocationMessage -> probable_price_of_allocation_message: ProbablePriceOfAllocationMessage;
        MessageType::RelationBetweenBmvbivaInstrumentsMessage -> relation_between_bmvbiva_instruments_message: RelationBetweenBmvbivaInstrumentsMessage;
        MessageType::EquitiesMarketTradesMessage -> equities_market_trades_message: EquitiesMarketTradesMessage;
        MessageType::ConsolidatedTradeCancellationMessage -> consolidated_trade_cancellation_message: ConsolidatedTradeCancellationMessage;
        MessageType::PricevolumeIndicatorMessage -> pricevolume_indicator_message: PricevolumeIndicatorMessage;
        MessageType::ConsolidatedExecutionOfOrdersMessage -> consolidated_execution_of_orders_message: ConsolidatedExecutionOfOrdersMessage;
        MessageType::RegistrationOfOrderMessage -> registration_of_order_message: RegistrationOfOrderMessage;
        MessageType::CancellationsOfOrdersMessage -> cancellations_of_orders_message: CancellationsOfOrdersMessage;
        MessageType::LastQuoteMessage -> last_quote_message: LastQuoteMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: int16;
    message_type: uint8 &convert=MessageType($$);
};

type LoginResponseMessage = unit {
    login_response_status: uint8 &convert=LoginResponseStatus($$);
};

type ReplayResponseMessage = unit {
    market_data_group: int8 &convert=MarketDataGroup($$);
    first_message: int32;
    quantity: int16;
    replay_response_status: uint8 &convert=ReplayResponseStatus($$);
};

type SnapshotResponseMessage = unit {
    quantity_of_messages: int32;
    snapshot_response_status: uint8 &convert=SnapshotResponseStatus($$);
    snapshot_type: int8 &convert=SnapshotType($$);
};

type SnapshotCompleteMessage = unit {
    sequence_number: int32;
    market_data_group: int8 &convert=MarketDataGroup($$);
    snapshot_type: int8 &convert=SnapshotType($$);
};

type EventsSystemMessage = unit {
    instrument_number: int32;
