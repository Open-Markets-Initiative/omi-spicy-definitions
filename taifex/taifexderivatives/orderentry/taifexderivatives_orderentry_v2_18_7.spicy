        MsgTypeExt::SingleLegOrderWithATextualProductSymbol -> symbol_txt_x: SymbolTxtX;
        MsgTypeExt::MultiLegOrderWithANumericProductSerialNumber -> multi_leg_num: MultiLegNum;
        MsgTypeExt::MultiLegOrderWithATextualProductSymbol -> multi_leg_txt: MultiLegTxt;
