    investor_flag: bytes &size=1;
    side: uint8 &convert=Side($$);
    ord_type: uint8 &convert=OrdType($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    position_effect: uint8 &convert=PositionEffect($$);
    last_px: int32;
    last_qty: uint16;
    px_subtotal: int64;
    cum_qty: uint16;
    leaves_qty: uint16;
    before_qty: uint16;
    org_trans_time_msg_time_x: OrgTransTimeMsgTimeX;
    transact_time_msg_time_x: TransactTimeMsgTimeX;
    target_id: uint8 &convert=TargetId($$);
    uniq_id: uint32;
    rpt_seq: uint32;
    rpt_session_id: uint16;
    rpt_session_seq: uint32;
    : skip bytes &size=12;   # padding
};

