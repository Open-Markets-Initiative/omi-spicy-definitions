    applicationtype: uint8 &convert=Applicationtype($$);
    rootsymbol: bytes &size=3;
    expirytype: uint8 &convert=Expirytype($$);
    contractdate: bytes &size=8;
    strikeprice: uint32;
    callputcode: uint8 &convert=Callputcode($$);
    : skip bytes &size=20;   # padding
};

type FlexOrderStatusReportMessage = unit {
    subhdr: Subhdr;
    partid: uint8 &convert=Partid($$);
    no_leg: uint8;
    statuscode_uint_162: uint16 &convert=StatuscodeUint162($$);
    exec_type: uint8 &convert=ExecType($$);
    cmid: uint16;
    fcmid: uint16;
    orderno: bytes &size=5;
    ordid: uint32;
    userdefine: bytes &size=8;
    switch ( self.subhdr.msg_type_ext ) {
        MsgTypeExt::SingleLegOrderWithANumericProductSerialNumber -> symbolnumx: Symbolnumx;
        MsgTypeExt::SingleLegOrderWithATextualProductSymbol -> symboltxtx: Symboltxtx;
        MsgTypeExt::MultiLegOrderWithANumericProductSerialNumber -> multilegnum: Multilegnum;
        MsgTypeExt::MultiLegOrderWithATextualProductSymbol -> multilegtxt: Multilegtxt;
        * -> unknown: bytes &eod;
    };
    price: int32;
    qty: uint16;
    investoracno: uint32;
    investorflag: bytes &size=1;
    side: uint8 &convert=Side($$);
    ord_type: uint8 &convert=OrdType($$);
    time_in_force: uint8 &convert=TimeInForce($$);
    position_effect: uint8 &convert=PositionEffect($$);
    last_px: int32;
    last_qty: uint16;
    pxsubtotal: int64;
    cum_qty: uint16;
    leaves_qty: uint16;
    beforeqty: uint16;
    orgtranstime_msgtimex: OrgtranstimeMsgtimex;
    transact_time_msgtimex: TransactTimeMsgtimex;
    targetid: uint8 &convert=Targetid($$);
    uniqid: uint32;
    rptseq: uint32;
    rptsessionid: uint16;
    rptsessionseq: uint32;
    : skip bytes &size=12;   # padding
};

type OrgtranstimeMsgtimex = unit {
    epochs_uint_324: uint32;
    nanosecond: uint32;
};

type TransactTimeMsgtimex = unit {
    epochs_uint_324: uint32;
    nanosecond: uint32;
};

type FlexErrorReportMessage = unit {
    subhdr: Subhdr;
    partid: uint8 &convert=Partid($$);
    ori_message_type: uint8;
    statuscode_uint_162: uint16 &convert=StatuscodeUint162($$);
    exec_type: uint8 &convert=ExecType($$);
    fcmid: uint16;
    orderno: bytes &size=5;
    ordid: uint32;
    userdefine: bytes &size=8;
    rptseq: uint32;
    side: uint8 &convert=Side($$);
    : skip bytes &size=12;   # padding
};

type FlexPriceInquiryReplyMessage = unit {
    subhdr: Subhdr;
    partid: uint8 &convert=Partid($$);
    statuscode_uint_162: uint16 &convert=StatuscodeUint162($$);
    orderno: bytes &size=5;
    ordid: uint32;
    fcmid: uint16;
    switch ( self.subhdr.msg_type_ext ) {
        MsgTypeExt::SingleLegOrderWithANumericProductSerialNumber -> symbolnumx: Symbolnumx;
        MsgTypeExt::SingleLegOrderWithATextualProductSymbol -> symboltxtx: Symboltxtx;
        MsgTypeExt::MultiLegOrderWithANumericProductSerialNumber -> multilegnum: Multilegnum;
        MsgTypeExt::MultiLegOrderWithATextualProductSymbol -> multilegtxt: Multilegtxt;
        * -> unknown: bytes &eod;
    };
    : skip bytes &size=8;   # padding
};

type SendFlexGroupReportResendMessage = unit(msg_length: uint16) {
    subhdr: Subhdr;
    statuscode_uint_162: uint16 &convert=StatuscodeUint162($$);
    partid: uint8 &convert=Partid($$);
    iseof: uint8 &convert=Iseof($$);
