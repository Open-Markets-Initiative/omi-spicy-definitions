    open_interest: real &type=spicy::RealType::IEEE754_Double;
    low: real &type=spicy::RealType::IEEE754_Double;
    high: real &type=spicy::RealType::IEEE754_Double;
    day_volume: real &type=spicy::RealType::IEEE754_Double;
    vwap: real &type=spicy::RealType::IEEE754_Double;
    trade_type: int32 &convert=TradeType($$);
    trade_date: TradeDate;
};

type OrderContract = unit {
    identifier_prefix_b_4: bytes &size=4;
    expiry_date: ExpiryDate;
    instrument_name_b_5: bytes &size=5;
    strike: real &type=spicy::RealType::IEEE754_Double;
    call_put_b_1: uint8;
    secondary_expiry_date: SecondaryExpiryDate;
    secondary_instrument_name_b_5: bytes &size=5;
    is_delta_option: uint8;
};

type SecondaryExpiryDate = unit {
    year: int32;
    month: int32;
    day: int32;
};

type DisplayUpdateMessage = unit {
    last_chunk: uint8;
    display: Display;
    depth_data: DepthData[self.display.number_of_depth];
};

type Display = unit {
    trading_anonymous: uint8;
    contract: Contract;
    mid_price: real &type=spicy::RealType::IEEE754_Double;
    last_dealt_price: real &type=spicy::RealType::IEEE754_Double;
    last_dealt_time: LastDealtTime;
    deal_volume: int64;
    high_price: real &type=spicy::RealType::IEEE754_Double;
    low_price: real &type=spicy::RealType::IEEE754_Double;
    days_volume_i_8: int64;
    last_order_qty: int32;
    last_order_buy_sell: bytes &size=1;
    last_order_price: real &type=spicy::RealType::IEEE754_Double;
    number_of_depth: uint8;
    open_interest: real &type=spicy::RealType::IEEE754_Double;
    change: real &type=spicy::RealType::IEEE754_Double;
    auction: uint8 &convert=Auction($$);
    contract_status: uint8 &convert=ContractStatus($$);
    odd_lot: uint8;
    last_traded_quantity: int64;
    date_sequence: int32;
    secondary_contract_date_sequence: int32;
    strike_sequence: int32;
    market_shard_global_sequence_number: int32;
    stack_sequence_number: int32;
    : skip bytes &size=21;   # padding
    update_time: UpdateTime;
    vwap: real &type=spicy::RealType::IEEE754_Double;
    closing_price: real &type=spicy::RealType::IEEE754_Double;
    : skip bytes &size=1;   # padding
};

type LastDealtTime = unit {
    hours: uint8;
    minutes: uint8;
    seconds: uint8;
    : skip bytes &size=1;   # padding
};

type DepthData = unit {
    buy_side_phantom: uint8;
    buy_who: BuyWhoMember;
    buy_price: real &type=spicy::RealType::IEEE754_Double;
    buy_quantity: int32;
    sell_quantity: int32;
    sell_price: real &type=spicy::RealType::IEEE754_Double;
    sell_who: SellWhoMember;
    sell_side_phantom: uint8;
    buy_order_id: int32;
    buy_order_type: int32 &convert=BuyOrderType($$);
    sell_order_id: int32;
    sell_order_type: int32 &convert=SellOrderType($$);
};

type BuyWhoMember = unit {
    buy_who_length_byte: uint8;
    buy_who_characters: bytes &size=5;
};

type BuyWhoUniqueMember = unit {
    buy_who_length_byte: uint8;
    unique_member_number: int32;
    : skip bytes &size=1;   # padding
};

type SellWhoMember = unit {
    sell_who_length_byte: uint8;
    sell_who_characters: bytes &size=5;
};

type SellWhoUniqueMember = unit {
    sell_who_length_byte: uint8;
    unique_member_number: int32;
    : skip bytes &size=1;   # padding
};

type IndicesMessage = unit {
    index_sequence_number: IndexSequenceNumber;
    opening_price: real &type=spicy::RealType::IEEE754_Double;
    index_price: real &type=spicy::RealType::IEEE754_Double;
    update_time: UpdateTime;
    update_date: UpdateDate;
    market_capitalisation: real &type=spicy::RealType::IEEE754_Double;
};

type IndexSequenceNumber = unit {
    index_sequence_number_length_byte: uint8;
    index_sequence_number_characters: bytes &size=3;
};

type DailyTrendReplyMessage = unit {
    uncompressed_length: int32;
    daily_trend_data: DailyTrendData;
};

type DailyTrendData = unit {
    contract: Contract;
    history_suffix: HistorySuffix[] &eod;
};

type HistorySuffix = unit {
    price: real &type=spicy::RealType::IEEE754_Double;
    quantity_i_8: int64;
    time_field: Time;
};

type PriceUpdateMessage = unit {
    last_chunk: uint8;
    display_data: DisplayData;
};

type DisplayData = unit {
    uncompressed_length: int32;
    display_records: DisplayRecords;
};

type DisplayRecords = unit {
    display_record: DisplayRecord[] &eod;
};

type DisplayRecord = unit {
    display: Display;
    depth_data: DepthData[self.display.number_of_depth];
};

type DataUpdateMessage = unit {
    data_type: uint8 &convert=DataType($$);
    : skip bytes &size=1;   # padding
    last_piece_of_chunk: uint8;
    another_set_to_come: uint8;
    action: int32 &convert=Action($$);
    specific_record: int32;
    download_date: DownloadDate;
    # repeats  times
    switch ( self.data_type ) {
        DataType::MarketDisplayData -> market_display_data: MarketDisplayData;
        DataType::InstrumentsData -> instruments_data: InstrumentsData;
        DataType::ContractDates -> contract_dates: ContractDates;
        DataType::StrikeData -> strike_data: StrikeData;
        DataType::MemberData -> member_data: MemberData;
        DataType::MtmData -> mtm_data: MtmData;
        DataType::Holiday -> holiday_data: HolidayData;
        DataType::InstrumentTypes -> instrument_types: InstrumentTypes;
        DataType::ClearingMemberData -> clearing_member_data: ClearingMemberData;
        DataType::ExchangeAnnouncements -> exchange_announcements: ExchangeAnnouncements;
        DataType::News -> news_service: NewsService;
        DataType::CouponInformation -> coupon_information: CouponInformation;
        DataType::TradingSessions -> trading_sessions: TradingSessions;
        DataType::IndicesPriceData -> indices_price_data: IndicesPriceData;
        DataType::Indices -> indices_data: IndicesData;
        DataType::SharesInIssueData -> shares_in_issue_data: SharesInIssueData;
        DataType::IndexData -> index_data: IndexData;
        DataType::IndexConstituentsData -> index_constituents_data: IndexConstituentsData;
        * -> unknown: bytes &eod;
    };
};

type ExchangeAnnouncementsMessage = unit {
    market_number_i_4: int32;
    market_shard_number_i_4: int32;
    error_number: int32 &convert=ErrorNumber($$);
    information_or_error_indicator: uint8 &convert=InformationOrErrorIndicator($$);
    message_p_250: MessageP250;
};

type MessageP250 = unit {
    message_p_250_length_byte: uint8;
    message_p_250_characters: bytes &size=249;
};

type NotificationOfFailureMessage = unit {
    failure_notice_identifier: int32 &convert=FailureNoticeIdentifier($$);
    market_number_i_4: int32;
    market_shard_number_i_4: int32;
};

type BusinessMessageRejectMessage = unit {
    reference_sequence_number: int32;
    reference_message_type: ReferenceMessageType;
    text_p_250: TextP250;
};

type ReferenceMessageType = unit {
    reference_message_type_length_byte: uint8;
    reference_message_type_characters: bytes &size=2;
};

type TextP250 = unit {
    text_p_250_length_byte: uint8;
    text_p_250_characters: bytes &size=249;
};

