module NairobiNairobibondsMarketdataMitsV214Server;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type NairobibondsMarketdataV214 = unit {
    server_message: ServerMessage[] &eod;
};

type ServerMessage = unit {
    transport_header: TransportHeader;
    server_message_header: ServerMessageHeader;
    switch ( self.server_message_header.server_message_type ) {
        ServerMessageType::SuccessfulLogInResponseMessage -> successful_log_in_response_message: SuccessfulLogInResponseMessage;
        ServerMessageType::SessionKeyChallengeMessage -> session_key_challenge_message: SessionKeyChallengeMessage;
        ServerMessageType::DownloadDataResponseMessage -> download_data_response_message: DownloadDataResponseMessage;
        ServerMessageType::DownloadDataResponseMessage_37 -> download_data_response_message: DownloadDataResponseMessage;
        ServerMessageType::CompletedTradeMessage -> completed_trade_message: CompletedTradeMessage;
        ServerMessageType::DisplayUpdateMessage -> display_update_message: DisplayUpdateMessage;
        ServerMessageType::IndicesMessage -> indices_message: IndicesMessage;
        ServerMessageType::DailyTrendReplyMessage -> daily_trend_reply_message: DailyTrendReplyMessage;
        ServerMessageType::PriceUpdateMessage -> price_update_message: PriceUpdateMessage;
        ServerMessageType::DataUpdateMessage -> data_update_message: DataUpdateMessage;
        ServerMessageType::ExchangeAnnouncementsMessage -> exchange_announcements_message: ExchangeAnnouncementsMessage;
        ServerMessageType::NotificationOfFailureMessage -> notification_of_failure_message: NotificationOfFailureMessage;
        ServerMessageType::BusinessMessageRejectMessage -> business_message_reject_message: BusinessMessageRejectMessage;
        * -> unknown: bytes &eod;
    };
};

type TransportHeader = unit {
    start_byte: uint8;
    message_length: uint16;
    length_check: uint8;
};

type ServerMessageHeader = unit {
    sequence_number: int32;
    user_name: UserName;
    user_number: int32;
    time_field: Time;
    server_message_type: uint8 &convert=ServerMessageType($$);
};

type UserName = unit {
    user_name_length_byte: uint8;
    user_name_characters: bytes &size=15;
};

type Time = unit {
    hours: uint8;
    minutes: uint8;
    seconds: uint8;
    : skip bytes &size=1;   # padding
};

type SuccessfulLogInResponseMessage = unit {
    : skip bytes &size=12;   # padding
    today_date: TodayDate;
    country_code: CountryCode;
    previous_business_day: PreviousBusinessDay;
    : skip bytes &size=1;   # padding
    number_of_unique_members: int32;
    is_successful: uint8;
    text_p_50: TextP50;
    pair_member_codes_with_unique_number: PairMemberCodesWithUniqueNumber[cast<uint64>(self.number_of_unique_members)];
};

type TodayDate = unit {
    year: int32;
    month: int32;
    day: int32;
};

type CountryCode = unit {
    country_code_length_byte: uint8;
    country_code_characters: bytes &size=3;
};

type PreviousBusinessDay = unit {
    year: int32;
    month: int32;
    day: int32;
};

type TextP50 = unit {
    text_p_50_length_byte: uint8;
    text_p_50_characters: bytes &size=49;
};

type PairMemberCodesWithUniqueNumber = unit {
    member_code_p_6: MemberCodeP6;
    unique_member_number: int32;
};

type MemberCodeP6 = unit {
    member_code_p_6_length_byte: uint8;
    member_code_p_6_characters: bytes &size=5;
};

type SessionKeyChallengeMessage = unit {
    challenge: bytes &size=243;
};

type DownloadDataResponseMessage = unit {
    data_type: uint8 &convert=DataType($$);
    : skip bytes &size=1;   # padding
    last_piece_of_chunk: uint8;
    another_set_to_come: uint8;
    action: int32 &convert=Action($$);
    specific_record: int32;
    download_date: DownloadDate;
    download_data: DownloadData(self.data_type);
};

type DownloadDate = unit {
    year: int32;
    month: int32;
    day: int32;
};

type DownloadData = unit(data_type: DataType) {
    uncompressed_length: int32;
    records: Records(data_type);
};

type Records = unit(data_type: DataType) {
    # repeats  times
    switch ( data_type ) {
        DataType::MarketDisplayData -> market_display_data: MarketDisplayData;
        DataType::InstrumentsData -> instruments_data: InstrumentsData;
        DataType::ContractDates -> contract_dates: ContractDates;
        DataType::StrikeData -> strike_data: StrikeData;
        DataType::MemberData -> member_data: MemberData;
        DataType::MtmData -> mtm_data: MtmData;
        DataType::Holiday -> holiday_data: HolidayData;
        DataType::InstrumentTypes -> instrument_types: InstrumentTypes;
        DataType::ClearingMemberData -> clearing_member_data: ClearingMemberData;
        DataType::ExchangeAnnouncements -> exchange_announcements: ExchangeAnnouncements;
        DataType::News -> news_service: NewsService;
        DataType::CouponInformation -> coupon_information: CouponInformation;
        DataType::TradingSessions -> trading_sessions: TradingSessions;
        DataType::IndicesPriceData -> indices_price_data: IndicesPriceData;
        DataType::Indices -> indices_data: IndicesData;
        DataType::SharesInIssueData -> shares_in_issue_data: SharesInIssueData;
        DataType::IndexData -> index_data: IndexData;
        DataType::IndexConstituentsData -> index_constituents_data: IndexConstituentsData;
        * -> unknown: bytes &eod;
    };
};

