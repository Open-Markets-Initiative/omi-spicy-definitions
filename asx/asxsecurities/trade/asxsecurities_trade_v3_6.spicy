module AsxAsxsecuritiesTradeOuchV36;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type AsxsecuritiesTradeV36 = unit {
    soup_bin_tcp_packet: SoupBinTcpPacket[] &eod;
};

type SoupBinTcpPacket = unit {
    packet_header: PacketHeader;
    switch ( self.packet_header.packet_type ) {
        PacketType::DebugPacket -> debug_packet: DebugPacket;
        PacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        PacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        PacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        PacketType::LoginRequestPacket -> login_request_packet: LoginRequestPacket;
        PacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type PacketHeader = unit {
    packet_length: uint16;
    packet_type: uint8 &convert=PacketType($$);
};

type DebugPacket = unit {
    text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    session: bytes &size=10;
    sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: bytes &size=1;
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::OrderAcceptedMessage -> order_accepted_message: OrderAcceptedMessage;
        SequencedMessageType::OrderRejectedMessage -> order_rejected_message: OrderRejectedMessage;
        SequencedMessageType::OrderReplacedMessage -> order_replaced_message: OrderReplacedMessage;
        SequencedMessageType::OrderCancelledMessage -> order_cancelled_message: OrderCancelledMessage;
        SequencedMessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        * -> unknown: bytes &eod;
    };
};

type OrderAcceptedMessage = unit {
    timestamp_nanoseconds: uint64;
    order_token: bytes &size=14;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    order_id: uint64;
    quantity: uint64;
    price: int32;
    time_in_force: uint8 &convert=TimeInForce($$);
    open_close: uint8;
    client_account: bytes &size=10;
    order_state: uint8 &convert=OrderState($$);
    customer_info: bytes &size=15;
    exchange_info: bytes &size=32;
    clearing_participant: bytes &size=1;
    crossing_key: uint32;
    regulatory_data: RegulatoryData;
    ouch_order_type: uint8 &convert=OuchOrderType($$);
    short_sell_quantity: uint64;
    minimum_acceptable_quantity: uint64;
};

type RegulatoryData = unit {
    capacity_of_participant: uint8 &convert=CapacityOfParticipant($$);
    directed_wholesale: uint8 &convert=DirectedWholesale($$);
    execution_venue: bytes &size=4;
    intermediary_id: bytes &size=10;
    order_origin: bytes &size=20;
    filler: bytes &size=8;
};

type OrderRejectedMessage = unit {
    timestamp_nanoseconds: uint64;
    order_token: bytes &size=14;
    reject_code: uint32;
};

type OrderReplacedMessage = unit {
    timestamp_nanoseconds: uint64;
    replacement_order_token: bytes &size=14;
    previous_order_token: bytes &size=14;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    order_id: uint64;
    quantity: uint64;
    price: int32;
    time_in_force: uint8 &convert=TimeInForce($$);
    open_close: uint8;
    client_account: bytes &size=10;
    order_state: uint8 &convert=OrderState($$);
    customer_info: bytes &size=15;
    exchange_info: bytes &size=32;
    clearing_participant: bytes &size=1;
    crossing_key: uint32;
    regulatory_data: RegulatoryData;
    ouch_order_type: uint8 &convert=OuchOrderType($$);
    short_sell_quantity: uint64;
    minimum_acceptable_quantity: uint64;
};

type OrderCancelledMessage = unit {
    timestamp_nanoseconds: uint64;
    order_token: bytes &size=14;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    order_id: uint64;
    reason: uint8 &convert=Reason($$);
};

type OrderExecutedMessage = unit {
    timestamp_nanoseconds: uint64;
    order_token: bytes &size=14;
    order_book_id: uint32;
    traded_quantity: uint64;
    trade_price: int32;
    match_id: bytes &size=12;
    deal_source: uint16 &convert=DealSource($$);
    match_attributes: MatchAttributes;
};

type MatchAttributes = unit {
    passive_aggressive_indicator: bytes &size=1;
    crossing_dealing_capacity: uint8 &convert=CrossingDealingCapacity($$);
    : skip bytes &size=1;   # padding
};

type LoginRequestPacket = unit {
    username: bytes &size=6;
    password: bytes &size=10;
    requested_session: bytes &size=10;
    requested_sequence_number: bytes &size=20;
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: uint8 &convert=UnsequencedMessageType($$);
    switch ( self.unsequenced_message_type ) {
        UnsequencedMessageType::EnterOrderMessage -> enter_order_message: EnterOrderMessage;
        UnsequencedMessageType::ReplaceOrderMessage -> replace_order_message: ReplaceOrderMessage;
        UnsequencedMessageType::CancelOrderMessage -> cancel_order_message: CancelOrderMessage;
        UnsequencedMessageType::CancelByOrderIdMessage -> cancel_by_order_id_message: CancelByOrderIdMessage;
        * -> unknown: bytes &eod;
    };
};

type EnterOrderMessage = unit {
    order_token: bytes &size=14;
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint64;
    price: int32;
    time_in_force: uint8 &convert=TimeInForce($$);
    open_close: uint8;
    client_account: bytes &size=10;
    customer_info: bytes &size=15;
    exchange_info: bytes &size=32;
    clearing_participant: bytes &size=1;
    crossing_key: uint32;
    regulatory_data: RegulatoryData;
    ouch_order_type: uint8 &convert=OuchOrderType($$);
    short_sell_quantity: uint64;
    minimum_acceptable_quantity: uint64;
};

type ReplaceOrderMessage = unit {
    existing_order_token: bytes &size=14;
    replacement_order_token: bytes &size=14;
    quantity: uint64;
    price: int32;
    open_close: uint8;
    client_account: bytes &size=10;
    customer_info: bytes &size=15;
    exchange_info: bytes &size=32;
    regulatory_data: RegulatoryData;
    short_sell_quantity: uint64;
    minimum_acceptable_quantity: uint64;
};

type CancelOrderMessage = unit {
    order_token: bytes &size=14;
};

type CancelByOrderIdMessage = unit {
    order_book_id: uint32;
    side: uint8 &convert=Side($$);
    order_id: uint64;
};

type PacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
    EndOfSessionPacket = 0x5a,
    LoginRequestPacket = 0x4c,
    UnsequencedDataPacket = 0x55,
    ClientHeartbeatPacket = 0x52,
    LogoutRequestPacket = 0x4f,
};

type SequencedMessageType = enum {
    OrderAcceptedMessage = 0x41,
    OrderRejectedMessage = 0x4a,
    OrderReplacedMessage = 0x55,
    OrderCancelledMessage = 0x43,
    OrderExecutedMessage = 0x45,
};

type Side = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
    ShortSellOrder = 0x54,
    CombinationBuyOrder = 0x43,
};

type TimeInForce = enum {
    Day = 0,
    FillAndKill = 3,
    FillOrKill = 4,
};

type OrderState = enum {
    OnBook = 1,
    NotOnBook = 2,
};

type CapacityOfParticipant = enum {
    Agency = 0x41,
    Principal = 0x50,
    Mixed = 0x4d,
};

type DirectedWholesale = enum {
    True = 0x59,
    False = 0x4e,
};

type OuchOrderType = enum {
    LimitOrder = 0x59,
    CentrePointOrder = 0x4e,
    CentrePointOrder_x44 = 0x44,
    SweepOrder = 0x53,
    DualpostedSweepOrder = 0x50,
    CentrePointBlockOrderWithSingleFillMaq = 0x42,
    CentrePointOrderWithSingleFillMaq = 0x46,
    LimitSweepOrderWithSingleFillMaq = 0x54,
    AnyPriceBlockOrder = 0x43,
    AnyPriceBlockOrderWithSingleFillMaq = 0x45,
};

type Reason = enum {
    CancelledByUser = 1,
    OrderInactivatedDueToConnectionLoss = 4,
    FillAndKillOrderDeletedInAuction = 9,
    OrderDeletedByAsx = 10,
    DeletedDueToSessionChange = 20,
    InactivatedDueToSessionChange = 21,
    InactivatedDayOrder = 24,
};

type DealSource = enum {
    ContinuousAutomatch = 1,
    AuctionAutomatch = 20,
    TailorMadeCombinationMatch = 36,
    DeletedByAsx = 10,
    BookedUcpTransaction = 44,
    BookedUcpAuctionTransaction = 45,
    CentrePointPreferenceMatchedTrade = 46,
    CentrePointTrade = 47,
    CentrePointBookedUcp = 48,
    Reserved = 49,
    BlockTrade = 50,
    PreferenceBlockTrade = 51,
    Reserved_52 = 52,
};

type CrossingDealingCapacity = enum {
    NotCrossed = 0,
    PrincipalOrder = 1,
    AgencyOrder = 3,
    MixedAgencyAndPrincipalOrder = 4,
};

type UnsequencedMessageType = enum {
    EnterOrderMessage = 0x4f,
    ReplaceOrderMessage = 0x55,
    CancelOrderMessage = 0x58,
    CancelByOrderIdMessage = 0x59,
};

