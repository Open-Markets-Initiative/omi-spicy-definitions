module OsiNetworkTransportTcpV1;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type OsiNetworkTransportV1 = unit {
    tcp_source_port: uint16;
    tcp_destination_port: uint16;
    tcp_sequence_number: uint32;
    acknowledgment_number: uint32;
    offset_and_flags: bitfield(16) {
        data_offset: 0..3;
        tcp_reserved: 4..6;
        ns_flag: 7;
        cwr_flag: 8;
        ece_flag: 9;
        urg_flag: 10;
        ack_flag: 11;
        psh_flag: 12;
        rst_flag: 13;
        syn_flag: 14;
        fin_flag: 15;
    } &byte-order=spicy::ByteOrder::Big;
    window_size: uint16;
    tcp_checksum: uint16;
    urgent_pointer: uint16;
    tcp_options: bytes &size=self.offset_and_flags.data_offset * 4 - 20;
    tcp_payload: bytes &eod;
};

