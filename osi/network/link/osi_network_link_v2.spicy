module OsiNetworkLinkEthernetV2;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type OsiNetworkLinkV2 = unit {
    destination_mac: bytes &size=6;
    source_mac: bytes &size=6;
    ether_type: uint16 &convert=EtherType($$);
    vlan_tag: VlanTag;
    ethernet_payload: bytes &eod;
};

type VlanTag = unit {
    tag_control: bitfield(16) {
        vlan_priority: 0..2;
        drop_eligible: 3;
        vlan_id: 4..15;
    } &byte-order=spicy::ByteOrder::Big;
    inner_ether_type: uint16;
};

type EtherType = enum {
    Ipv4 = 2048,
    Arp = 2054,
    Vlan = 33024,
    Ipv6 = 34525,
};

