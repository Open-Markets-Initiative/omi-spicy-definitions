module NasdaqNtxoptionsTopofmarketItchV22ServerTcp;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NtxoptionsTopofmarketV22 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_tcp_packet_header: ServerTcpPacketHeader;
    switch ( self.server_tcp_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket;
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerTcpPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit {
    text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: bytes &size=1;
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        SequencedMessageType::DerivativeDirectoryMessage -> derivative_directory_message: DerivativeDirectoryMessage;
        SequencedMessageType::TradingActionMessage -> trading_action_message: TradingActionMessage;
        SequencedMessageType::BestBidAndAskUpdateShortFormMessage -> best_bid_and_ask_update_short_form_message: BestBidAndAskUpdateShortFormMessage;
        SequencedMessageType::BestBidAndAskUpdateLongFormMessage -> best_bid_and_ask_update_long_form_message: BestBidAndAskUpdateLongFormMessage;
        SequencedMessageType::BestBidOrAskUpdateShortFormMessage -> best_bid_or_ask_update_short_form_message: BestBidOrAskUpdateShortFormMessage;
        SequencedMessageType::BestBidOrAskUpdateLongFormMessage -> best_bid_or_ask_update_long_form_message: BestBidOrAskUpdateLongFormMessage;
        SequencedMessageType::TradeReportMessage -> trade_report_message: TradeReportMessage;
        SequencedMessageType::BrokenTradeReportMessage -> broken_trade_report_message: BrokenTradeReportMessage;
        SequencedMessageType::EndOfReplaySequenceMessage -> end_of_replay_sequence_message: EndOfReplaySequenceMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemEventMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    event_code: uint8 &convert=EventCode($$);
};

type DerivativeDirectoryMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    security_symbol: bytes &size=6;
    expiration_year: uint8;
    expiration_month: uint8;
    expiration_date: uint8;
    explicit_strike_price: uint32;
    option_type: uint8 &convert=OptionType($$);
    underlying_symbol: bytes &size=13;
    closing_type: uint8 &convert=ClosingType($$);
    tradable: uint8 &convert=Tradable($$);
    mpv: uint8 &convert=Mpv($$);
    isin: bytes &size=12;
    tick_size_table_id: uint16;
    price_notation: bytes &size=1;
    volume_notation: bytes &size=1;
    financial_product: uint16;
    market_segment_id: bytes &size=1;
    trading_currency: bytes &size=3;
    mic: bytes &size=4;
    instrument_long_name: bytes &size=16;
};

type TradingActionMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    current_trading_state: uint8 &convert=CurrentTradingState($$);
};

type BestBidAndAskUpdateShortFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    bid_market_order_size_short: uint16;
    bid_price_short: uint16;
    bid_size_short: uint16;
    bid_cust_size_short: uint16;
    bid_procust_size_short: uint16;
    ask_market_order_size_short: uint16;
    ask_price_short: uint16;
    ask_size_short: uint16;
    ask_cust_size_short: uint16;
    ask_procust_size_short: uint16;
};

type BestBidAndAskUpdateLongFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    bid_market_order_size_long: uint32;
    bid_price_long: uint32;
    bid_size_long: uint32;
    bid_cust_size_long: uint32;
    bid_procust_size_long: uint32;
    ask_market_order_size_long: uint32;
    ask_price_long: uint32;
    ask_size_long: uint32;
    ask_cust_size_long: uint32;
    ask_procust_size_long: uint32;
};

type BestBidOrAskUpdateShortFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    market_order_size_short: uint16;
    price_short: uint16;
    size_short: uint16;
    cust_size_short: uint16;
    procust_size_short: uint16;
};

type BestBidOrAskUpdateLongFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    market_order_size_long: uint32;
    price_long: uint32;
    size_long: uint32;
    cust_size_long: uint32;
    procust_size_long: uint32;
};

type TradeReportMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    cross_id: uint32;
    trade_condition: bytes &size=1;
    price_long: uint32;
    volume: uint32;
};

type BrokenTradeReportMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    original_cross_id: uint32;
    original_price: uint32;
    original_volume: uint32;
};

type EndOfReplaySequenceMessage = unit {
    end_of_replay_sequence_number: bytes &size=20;
};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
    EndOfSessionPacket = 0x5a,
};

type SequencedMessageType = enum {
    SystemEventMessage = 0x53,
    DerivativeDirectoryMessage = 0x52,
    TradingActionMessage = 0x48,
    BestBidAndAskUpdateShortFormMessage = 0x71,
    BestBidAndAskUpdateLongFormMessage = 0x51,
    BestBidOrAskUpdateShortFormMessage = 0x62,
    BestBidOrAskUpdateLongFormMessage = 0x42,
    TradeReportMessage = 0x54,
    BrokenTradeReportMessage = 0x58,
    EndOfReplaySequenceMessage = 0x4d,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfOpeningProcess = 0x51,
    EndOfNormalHoursProcessing = 0x4e,
    EndOfLateHoursProcessing = 0x4c,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
};

type OptionType = enum {
    CallOption = 0x43,
    PutOption = 0x50,
    Na = 0x4e,
};

type ClosingType = enum {
    NormalHours = 0x4e,
    LateHours = 0x4c,
};

type Tradable = enum {
    InstrumentIsTradable = 0x59,
    InstrumentIsNotTradable = 0x4e,
};

type Mpv = enum {
    PennyEverywhere = 0x45,
    Scaled = 0x53,
    PennyPilot = 0x50,
};

type CurrentTradingState = enum {
    HaltInEffect = 0x48,
    BuySideTradingSuspended = 0x42,
    SellSideTradingSuspended = 0x53,
    PreOpen = 0x49,
    OpeningAuction = 0x4f,
    ReOpening = 0x52,
    ContinuousTrading = 0x54,
    Closed = 0x58,
};

type QuoteCondition = enum {
    RegularQuoteautoxEligible = 0x20,
    AskSideNotFirmBidSideFirm = 0x58,
    BidSideNotFirmAskSideFirm = 0x59,
};

