    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    timestamp_2: uint64;
    symbol_long: bytes &size=11;
    original_trade_id: uint64;
    original_trade_price: uint64;
    original_volume_short: uint32;
    original_sale_condition: bytes &size=4;
    original_trade_through_exempt_flag: bytes &size=1;
    original_sellers_sale_days: uint16;
    corrected_trade_id: uint64;
    corrected_trade_price: uint64;
    corrected_volume_short: uint32;
    corrected_sale_condition: bytes &size=4;
    corrected_trade_through_exempt_flag: bytes &size=1;
    corrected_sellers_sale_days: uint16;
    consolidated_high_price: uint64;
    consolidated_low_price: uint64;
    consolidated_last_price: uint64;
    consolidated_volume: uint64;
    consolidated_price_change_indicator: uint8 &convert=ConsolidatedPriceChangeIndicator($$);
    consolidated_last_price_originator: bytes &size=1;
    market_participant_high_price: uint64;
    market_participant_low_price: uint64;
    market_participant_last_price: uint64;
    market_participant_volume: uint64;
};

