type MarketCenterOriginator = enum {
    CboeByxExchangeInc = 0x59,
    CboeBzxExchangeInc = 0x5a,
    CboeEdgaExchangeInc = 0x4a,
    CboeEdgxExchangeInc = 0x4b,
    CboeExchangeInc = 0x57,
    NasdaqTexasLlc = 0x42,
    NasdaqPhlxLlc = 0x58,
    NasdaqInc = 0x51,
    NasdaqIseLlc = 0x49,
    NewYorkStockExchangeLlc = 0x4e,
    NyseArcaInc = 0x50,
    NyseAmericanLlc = 0x41,
    NyseNationalInc = 0x43,
    NyseTexas = 0x4d,
    TexasStockExchangeLlc = 0x46,
    N24XNationalExchangeLlc = 0x47,
    FinancialIndustryRegulatoryAuthority = 0x44,
    InvestorsExchangeLlc = 0x56,
    LongTermStockExchange = 0x4c,
    MiaxPearlLlc = 0x48,
    MemxLlc = 0x55,
    MarketIndependentGeneratedBySip = 0x45,
};

type SubMarketCenterId = enum {
    FinraNyseTrf = 0x4e,
    FinraNasdaqTrfCarteret = 0x51,
    FinraNasdaqTrfChicago = 0x42,
    TradeOriginatesFromFinraAlternativeDisplayFacility = 0x20,
};

type SaleCondition = enum {
    RegularSale = 0x40,
    Acquisition = 0x41,
    BunchedTrade = 0x42,
    CashSale = 0x43,
    Distribution = 0x44,
    Placeholder = 0x45,
    IntermarketSweep = 0x46,
    BunchedSoldTrade = 0x47,
    PriceVariationTrade = 0x48,
    OddLotTrade = 0x49,
    Rule155TradeAmex = 0x4b,
    SoldLast = 0x4c,
    MarketCenterOfficialClose = 0x4d,
    Reserved = 0x4e,
    OpeningPrints = 0x4f,
    PriorReferencePrice = 0x50,
    MarketCenterOfficialOpen = 0x51,
    Seller = 0x52,
    SplitTrade = 0x53,
    FormT = 0x54,
    ExtendedTradingHoursSoldOutOfSequence = 0x55,
    ContingentTrade = 0x56,
    AveragePriceTrade = 0x57,
    CrossPeriodicAuctionTrade = 0x58,
    YellowFlagRegularTrade = 0x59,
    SoldOutOfSequence = 0x5a,
    StoppedStockRegularTrade = 0x31,
    DerivativelyPriced = 0x34,
    ReOpeningPrints = 0x35,
    ClosingPrints = 0x36,
    QualifiedContingentTradeQct = 0x37,
    PlaceholderFor611Exempt = 0x38,
    CorrectedConsolidatedClosePerListingMarket = 0x39,
};

type TradeThroughExemptFlag = enum {
    Rule611TradeThroughExempt = 0x58,
    NotRule611TradeThroughExempt = 0x20,
};

type ConsolidatedPriceChangeIndicator = enum {
    NoPricesChanged = 0x30,
    ConsolidatedLastPriceChanged = 0x31,
    ConsolidatedLowPriceChanged = 0x32,
    ConsolidatedLastAndConsolidatedLowPricesChanged = 0x33,
    ConsolidatedHighPriceChanged = 0x34,
    ConsolidatedLastAndConsolidatedHighPricesChanged = 0x35,
    ConsolidatedHighAndConsolidatedLowPricesChanged = 0x36,
    AllConsolidatedPricesChanged = 0x37,
};

type ParticipantPriceChangeIndicator = enum {
    NoPricesChanged = 0x30,
    ParticipantLastPriceChanged = 0x31,
    ParticipantLowPriceChanged = 0x32,
    ParticipantLastAndLowPricesChanged = 0x33,
    ParticipantHighPriceChanged = 0x34,
    ParticipantLastAndHighPricesChanged = 0x35,
    ParticipantHighAndLowPricesChanged = 0x36,
    AllParticipantPricesChanged = 0x37,
};

type TradeCancellationType = enum {
    Cancel = 0x43,
    Error = 0x45,
