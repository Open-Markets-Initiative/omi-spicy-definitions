module NasdaqUtdfOutputUtpV30C;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NasdaqUtdfOutputV30C = unit {
    udp_packet_header: UdpPacketHeader;
    messages: Message[self.udp_packet_header.message_count];
};

type UdpPacketHeader = unit {
    udp_session: bytes &size=10;
    udp_sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_category ) {
        0x54 -> trade_message: TradeMessage;
        0x41 -> administrative_message: AdministrativeMessage;
        0x56 -> total_consolidated_volume_message: TotalConsolidatedVolumeMessage;
        0x43 -> control_message: ControlMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    version: bytes &size=1;
    message_category: uint8;
};

type TradeMessage = unit {
    trade_message_type: uint8;
    switch ( self.trade_message_type ) {
        0x41 -> trade_report_message_shortform_message: TradeReportMessageShortformMessage;
        0x57 -> trade_report_message_longform_message: TradeReportMessageLongformMessage;
        0x5a -> trade_cancel_error_message: TradeCancelErrorMessage;
        0x59 -> trade_correction_message: TradeCorrectionMessage;
        0x48 -> prior_day_as_of_trade_message: PriorDayAsOfTradeMessage;
        0x4d -> fractional_trade_report_message_shortform_message: FractionalTradeReportMessageShortformMessage;
        0x4e -> fractional_trade_report_message_longform_message: FractionalTradeReportMessageLongformMessage;
        0x4f -> fractional_trade_cancel_error_message: FractionalTradeCancelErrorMessage;
        0x50 -> fractional_trade_correction_message: FractionalTradeCorrectionMessage;
        0x51 -> fractional_as_of_trade_message: FractionalAsOfTradeMessage;
        * -> unknown: bytes &eod;
    };
};

type TradeReportMessageShortformMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    timestamp_2: uint64;
    symbol_short: bytes &size=5;
    trade_id: uint64;
    trade_price_short: uint16;
    trade_volume_short: uint16;
    sale_condition: bytes &size=4;
    trade_through_exempt_flag: uint8 &convert=TradeThroughExemptFlag($$);
    consolidated_price_change_indicator: uint8 &convert=ConsolidatedPriceChangeIndicator($$);
    participant_price_change_indicator: uint8 &convert=ParticipantPriceChangeIndicator($$);
};

type TradeReportMessageLongformMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    timestamp_2: uint64;
    symbol_long: bytes &size=11;
    trade_id: uint64;
    trade_price_long: uint64;
    trade_volume_long: uint32;
    sale_condition: bytes &size=4;
    trade_through_exempt_flag: uint8 &convert=TradeThroughExemptFlag($$);
    sellers_sale_days: uint16;
    consolidated_price_change_indicator: uint8 &convert=ConsolidatedPriceChangeIndicator($$);
    participant_price_change_indicator: uint8 &convert=ParticipantPriceChangeIndicator($$);
};

type TradeCancelErrorMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    timestamp_2: uint64;
    symbol_long: bytes &size=11;
    trade_cancellation_type: uint8 &convert=TradeCancellationType($$);
    original_trade_id: uint64;
    original_trade_price: uint64;
    original_volume_short: uint32;
    original_sale_condition: bytes &size=4;
    original_trade_through_exempt_flag: bytes &size=1;
    original_sellers_sale_days: uint16;
    consolidated_high_price: uint64;
    consolidated_low_price: uint64;
    consolidated_last_price: uint64;
    consolidated_volume: uint64;
    consolidated_price_change_indicator: uint8 &convert=ConsolidatedPriceChangeIndicator($$);
    consolidated_last_price_originator: bytes &size=1;
    market_participant_high_price: uint64;
    market_participant_low_price: uint64;
    market_participant_last_price: uint64;
    market_participant_volume: uint64;
};

