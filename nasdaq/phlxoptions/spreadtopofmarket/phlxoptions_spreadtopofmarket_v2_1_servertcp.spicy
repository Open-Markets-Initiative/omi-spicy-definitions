module NasdaqPhlxoptionsSpreadtopofmarketItchV21ServerTcp;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type PhlxoptionsSpreadtopofmarketV21 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_tcp_packet_header: ServerTcpPacketHeader;
    switch ( self.server_tcp_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket;
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerTcpPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit {
    text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: bytes &size=1;
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        SequencedMessageType::ComplexStrategyDirectoryMessage -> complex_strategy_directory_message: ComplexStrategyDirectoryMessage;
        SequencedMessageType::StrategyTradingActionMessage -> strategy_trading_action_message: StrategyTradingActionMessage;
        SequencedMessageType::StrategyBestBidAndAskUpdateMessage -> strategy_best_bid_and_ask_update_message: StrategyBestBidAndAskUpdateMessage;
        SequencedMessageType::StrategyBestBidUpdateMessage -> strategy_best_bid_update_message: StrategyBestBidUpdateMessage;
        SequencedMessageType::StrategyBestAskUpdateMessage -> strategy_best_ask_update_message: StrategyBestAskUpdateMessage;
        SequencedMessageType::EndOfReplaySequenceMessage -> end_of_replay_sequence_message: EndOfReplaySequenceMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemEventMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    event_code: uint8 &convert=EventCode($$);
};

type ComplexStrategyDirectoryMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    strategy_type: uint8 &convert=StrategyType($$);
    underlying_symbol: bytes &size=13;
    reserved_16: bytes &size=16;
    number_of_legs: uint8;
    leg_information: LegInformation[self.number_of_legs];
};

type LegInformation = unit {
    option_id: uint32;
    security_symbol: bytes &size=8;
    expiration_year: uint8;
    expiration_month: uint8;
    expiration_day: uint8;
    explicit_strike_price: uint32;
    option_type: uint8 &convert=OptionType($$);
    side: uint8 &convert=Side($$);
    leg_ratio: uint32;
};

type StrategyTradingActionMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    current_trading_state: uint8 &convert=CurrentTradingState($$);
};

type StrategyBestBidAndAskUpdateMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    quote_condition: bytes &size=1;
    bid_market_size: uint32;
    bid_price: uint32;
    bid_size: uint32;
    bid_cust_size: uint32;
    bid_pro_cust_size: uint32;
    bid_dntt_size: uint32;
    bid_dntt_market_size: uint32;
    ask_market_size: uint32;
    ask_price: uint32;
    ask_size: uint32;
    ask_cust_size: uint32;
    ask_pro_cust_size: uint32;
    ask_dntt_size: uint32;
    ask_dntt_market_size: uint32;
};

type StrategyBestBidUpdateMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    quote_condition: bytes &size=1;
    market_size: uint32;
    price: uint32;
    size: uint32;
    cust_size: uint32;
    pro_cust_size: uint32;
    dntt_size: uint32;
    dntt_market_size: uint32;
};

type StrategyBestAskUpdateMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    quote_condition: bytes &size=1;
    market_size: uint32;
    price: uint32;
    size: uint32;
    cust_size: uint32;
    pro_cust_size: uint32;
    dntt_size: uint32;
    dntt_market_size: uint32;
};

type EndOfReplaySequenceMessage = unit {
    end_of_replay_sequence_number: bytes &size=20;
};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
    EndOfSessionPacket = 0x5a,
};

type SequencedMessageType = enum {
    SystemEventMessage = 0x53,
    ComplexStrategyDirectoryMessage = 0x73,
    StrategyTradingActionMessage = 0x48,
    StrategyBestBidAndAskUpdateMessage = 0x45,
    StrategyBestBidUpdateMessage = 0x63,
    StrategyBestAskUpdateMessage = 0x64,
    EndOfReplaySequenceMessage = 0x4d,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfOpeningProcess = 0x51,
    StartOfNormalHoursClosingProcess = 0x4e,
    StartOfLateHoursClosingProcess = 0x4c,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
    EndOfWcoEarlyClosing = 0x57,
};

type StrategyType = enum {
    VerticalSpread = 0x56,
    TimeSpread = 0x54,
    DiagonalSpread = 0x44,
    Straddle = 0x53,
    Strangle = 0x47,
    Combo = 0x43,
    RiskReversal = 0x52,
    RatioSpread = 0x41,
    BoxSpread = 0x42,
    ButterflySpread = 0x46,
    Custom = 0x55,
};

type OptionType = enum {
    CallOption = 0x43,
    PutOption = 0x50,
    StockLeg = 0x20,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type CurrentTradingState = enum {
    HaltInEffect = 0x48,
    ContinuousTrading = 0x54,
    PreOpen = 0x49,
    OpeningAuction = 0x4f,
    ReOpening = 0x52,
    Closed = 0x58,
};

