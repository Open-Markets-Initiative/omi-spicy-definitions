    reject_code: uint16 &convert=RejectCode($$);
};

type PendingResponseMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    instrument_id: uint32;
    pending_msg_type: bytes &size=1;
    cl_ord_id: bytes &size=16;
    pending_reason: uint8 &convert=PendingReason($$);
};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
    EndOfSessionPacket = 0x5a,
};

type RejectReasonCode = enum {
    NotAuthorized = 0x41,
    SessionNotAvailable = 0x53,
};

type SequencedMessageType = enum {
    SystemEventMessage = 0x7a,
    SimpleInstrumentDirectoryMessage = 0x6f,
    ComplexInstrumentDirectoryMessage = 0x73,
    InstrumentTradingActionMessage = 0x69,
    AuctionNotificationMessage = 0x6e,
    OrderAcceptedLongFormMessage = 0x61,
    OrderAcceptedShortFormMessage = 0x62,
    OrderReplacedMessage = 0x72,
    OrderCanceledMessage = 0x63,
    OrderExecutedMessage = 0x65,
    TradeDetailsMessage = 0x74,
    CrossOrderAcceptedMessage = 0x78,
    MemberKillSwitchNotificationMessage = 0x6b,
    MassCancelResponseMessage = 0x75,
    AddComplexInstrumentResponseMessage = 0x64,
    ModifyTradeResponseMessage = 0x6d,
    SubscriptionResponseMessage = 0x66,
    RejectMessage = 0x6a,
    PendingResponseMessage = 0x70,
};

