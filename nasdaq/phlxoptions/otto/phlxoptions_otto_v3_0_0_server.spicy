module NasdaqPhlxoptionsOttoOuchV300Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type PhlxoptionsOttoV300 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket;
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit {
    debug_text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: uint8 &convert=RejectReasonCode($$);
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        SequencedMessageType::SimpleInstrumentDirectoryMessage -> simple_instrument_directory_message: SimpleInstrumentDirectoryMessage;
        SequencedMessageType::ComplexInstrumentDirectoryMessage -> complex_instrument_directory_message: ComplexInstrumentDirectoryMessage;
        SequencedMessageType::InstrumentTradingActionMessage -> instrument_trading_action_message: InstrumentTradingActionMessage;
        SequencedMessageType::AuctionNotificationMessage -> auction_notification_message: AuctionNotificationMessage;
        SequencedMessageType::OrderAcceptedLongFormMessage -> order_accepted_long_form_message: OrderAcceptedLongFormMessage;
        SequencedMessageType::OrderAcceptedShortFormMessage -> order_accepted_short_form_message: OrderAcceptedShortFormMessage;
        SequencedMessageType::OrderReplacedMessage -> order_replaced_message: OrderReplacedMessage;
        SequencedMessageType::OrderCanceledMessage -> order_canceled_message: OrderCanceledMessage;
        SequencedMessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        SequencedMessageType::TradeDetailsMessage -> trade_details_message: TradeDetailsMessage;
        SequencedMessageType::CrossOrderAcceptedMessage -> cross_order_accepted_message: CrossOrderAcceptedMessage;
        SequencedMessageType::MemberKillSwitchNotificationMessage -> member_kill_switch_notification_message: MemberKillSwitchNotificationMessage;
        SequencedMessageType::MassCancelResponseMessage -> mass_cancel_response_message: MassCancelResponseMessage;
        SequencedMessageType::AddComplexInstrumentResponseMessage -> add_complex_instrument_response_message: AddComplexInstrumentResponseMessage;
        SequencedMessageType::ModifyTradeResponseMessage -> modify_trade_response_message: ModifyTradeResponseMessage;
        SequencedMessageType::SubscriptionResponseMessage -> subscription_response_message: SubscriptionResponseMessage;
        SequencedMessageType::RejectMessage -> reject_message: RejectMessage;
        SequencedMessageType::PendingResponseMessage -> pending_response_message: PendingResponseMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemEventMessage = unit {
    timestamp: uint64;
    event_code: uint8 &convert=EventCode($$);
    version: uint8;
    subversion: uint8;
};

type SimpleInstrumentDirectoryMessage = unit {
    timestamp: uint64;
    product_id: uint16;
    product_name: bytes &size=13;
    instrument_id: uint32;
    expir_year: uint8;
    expir_mon: uint8;
    expir_day: uint8;
    strike_price: int64;
    option_type: uint8 &convert=OptionType($$);
    closing_type: uint8 &convert=ClosingType($$);
    tradable: uint8 &convert=Tradable($$);
    closing_only: uint8 &convert=ClosingOnly($$);
    contract_size: uint16;
    mpv: uint8 &convert=Mpv($$);
    security_symbol: bytes &size=8;
    : skip bytes &size=16;   # padding
};

type ComplexInstrumentDirectoryMessage = unit {
    timestamp: uint64;
    product_id: uint16;
    product_name: bytes &size=13;
    instrument_id: uint32;
    : skip bytes &size=1;   # padding
    num_legs: uint8;
    complex_directory_legs: ComplexDirectoryLegs[self.num_legs];
};

type ComplexDirectoryLegs = unit {
    leg_type: uint8 &convert=LegType($$);
    leg_instrument_id: uint32;
    leg_side: uint8 &convert=LegSide($$);
    leg_ratio: uint16;
    leg_id: uint8;
};

type InstrumentTradingActionMessage = unit {
    timestamp: uint64;
    product_id: uint16;
    instrument_id: uint32;
    trading_state: uint8 &convert=TradingState($$);
};

type AuctionNotificationMessage = unit {
    timestamp: uint64;
    instrument_type: uint8 &convert=InstrumentType($$);
    instrument_id: uint32;
    auction_id: uint32;
    order_type: uint8 &convert=OrderType($$);
    side: uint8 &convert=Side($$);
    price: int64;
    quantity: uint32;
    exec_flag: uint8 &convert=ExecFlag($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    firm_id: bytes &size=4;
    occ_account: uint32;
    cmta: uint32;
    auction_event: uint8 &convert=AuctionEvent($$);
    auction_type: uint8 &convert=AuctionType($$);
    auction_duration: uint32;
    best_response_price: int64;
    best_response_size: uint32;
    : skip bytes &size=9;   # padding
    number_of_flex_dac_legs: uint8;
    flex_dac_legs: FlexDacLegs[self.number_of_flex_dac_legs];
};

type FlexDacLegs = unit {
    : skip bytes &size=8;   # padding
};

type OrderAcceptedLongFormMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    instrument_id: uint32;
    order_id: uint64;
    cl_ord_id: bytes &size=16;
    cmta: uint32;
    clearing_account: bytes &size=4;
    occ_account: uint32;
    cust_acct: bytes &size=10;
    preferred_party: bytes &size=3;
    alo_inst: uint8 &convert=AloInst($$);
    iso: uint8 &convert=Iso($$);
    side: uint8 &convert=Side($$);
    order_type: uint8 &convert=OrderType($$);
    price: int64;
    quantity: uint32;
    min_qty: uint32;
    tif: uint8 &convert=Tif($$);
    capacity: uint8 &convert=Capacity($$);
    auction_type: uint8 &convert=AuctionType($$);
    auction_id: uint32;
    disclosure_mask: uint8;
    price_protection: uint8 &convert=PriceProtection($$);
    display_qty: uint16;
    display_when: uint8 &convert=DisplayWhen($$);
    display_method: uint8 &convert=DisplayMethod($$);
    display_low_qty: uint16;
    display_high_qty: uint16;
    position_effect_mask: uint16;
    stock_leg_short_sale: uint8 &convert=StockLegShortSale($$);
    stock_leg_mpid: bytes &size=4;
    stock_capacity: uint8 &convert=StockCapacity($$);
    : skip bytes &size=9;   # padding
    number_of_flex_legs: uint8;
    flex_legs: FlexLegs[self.number_of_flex_legs];
};

type FlexLegs = unit {
    : skip bytes &size=8;   # padding
};

type OrderAcceptedShortFormMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    instrument_id: uint32;
    order_id: uint64;
    cl_ord_id: bytes &size=16;
    alo_inst: uint8 &convert=AloInst($$);
    iso: uint8 &convert=Iso($$);
    side: uint8 &convert=Side($$);
    order_type: uint8 &convert=OrderType($$);
    price: int64;
    quantity_short: uint16;
    tif: uint8 &convert=Tif($$);
    capacity: uint8 &convert=Capacity($$);
    auction_type: uint8 &convert=AuctionType($$);
    auction_id: uint32;
    price_protection: uint8 &convert=PriceProtection($$);
    position_effect_mask: uint16;
    stock_capacity: uint8 &convert=StockCapacity($$);
};

type OrderReplacedMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    instrument_id: uint32;
    orig_order_id: uint64;
    order_id: uint64;
    orig_cl_ord_id: bytes &size=16;
    cl_ord_id: bytes &size=16;
    alo_inst: uint8 &convert=AloInst($$);
    iso: uint8 &convert=Iso($$);
    side: uint8 &convert=Side($$);
    order_type: uint8 &convert=OrderType($$);
    price: int64;
    quantity: uint32;
    tif: uint8 &convert=Tif($$);
    cust_acct: bytes &size=10;
    capacity: uint8 &convert=Capacity($$);
    auction_type: uint8 &convert=AuctionType($$);
    auction_id: uint32;
    position_effect_mask: uint16;
    price_protection: uint8 &convert=PriceProtection($$);
};

type OrderCanceledMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    instrument_id: uint32;
    order_id: uint64;
    cl_ord_id: bytes &size=16;
    cancel_reason: uint8 &convert=CancelReason($$);
};

type OrderExecutedMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    product_id: uint16;
    ord_exec_type: uint8 &convert=OrdExecType($$);
    instrument_id: uint32;
    leg_instrument_id: uint32;
    leg_id: uint8;
    auction_type: uint8 &convert=AuctionType($$);
    order_id: uint64;
    cl_ord_id: bytes &size=16;
    cross_id: uint32;
    match_id: uint32;
    side: uint8 &convert=Side($$);
    stock_leg_short_sale: uint8 &convert=StockLegShortSale($$);
    price: int64;
    quantity: uint32;
    liquidity_ind: uint8 &convert=LiquidityInd($$);
};

type TradeDetailsMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    product_id: uint16;
    ord_exec_type: uint8 &convert=OrdExecType($$);
    instrument_id: uint32;
    leg_instrument_id: uint32;
    leg_id: uint8;
    trans_type: uint8 &convert=TransType($$);
    event_source: uint8 &convert=EventSource($$);
    auction_type: uint8 &convert=AuctionType($$);
    order_id: uint64;
    cl_ord_id: bytes &size=16;
    cross_id: uint32;
    match_id: uint32;
    ref_match_id: uint32;
    side: uint8 &convert=Side($$);
    stock_leg_short_sale: uint8 &convert=StockLegShortSale($$);
    price: int64;
    quantity: uint32;
    liquidity_ind: uint8 &convert=LiquidityInd($$);
    cmta: uint32;
    clearing_account: bytes &size=4;
    occ_account: uint32;
    cust_acct: bytes &size=10;
    stock_venue: uint8 &convert=StockVenue($$);
    stock_leg_mpid: bytes &size=4;
    capacity: uint8 &convert=Capacity($$);
    open_close: uint8 &convert=OpenClose($$);
};

type CrossOrderAcceptedMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    instrument_id: uint32;
    cross_type: uint8 &convert=CrossType($$);
    auction_type: uint8 &convert=AuctionType($$);
    auction_id: uint32;
    auction_alloc_pct: uint8;
    side: uint8 &convert=Side($$);
    iso: uint8 &convert=Iso($$);
    price_protection: uint8 &convert=PriceProtection($$);
    effective_time: uint64;
    disclosure_mask: uint8;
    primary_order_id: uint64;
    primary_cl_ord_id: bytes &size=16;
    primary_cmta: uint32;
    primary_clearing_account: bytes &size=4;
    primary_occ_account: uint32;
    primary_cust_acct: bytes &size=10;
    primary_price: int64;
    primary_quantity: uint32;
    primary_capacity: uint8 &convert=PrimaryCapacity($$);
    primary_position_effect_mask: uint16;
    primary_stock_leg_short_sale: uint8 &convert=PrimaryStockLegShortSale($$);
    primary_stock_leg_mpid: bytes &size=4;
    contra_order_id: uint64;
    contra_cl_ord_id: bytes &size=16;
    contra_cmta: uint32;
    contra_clearing_account: bytes &size=4;
    contra_occ_account: uint32;
    contra_cust_acct: bytes &size=10;
    contra_order_type: uint8 &convert=ContraOrderType($$);
    contra_price: int64;
    contra_quantity: uint32;
    contra_capacity: uint8 &convert=ContraCapacity($$);
    contra_position_effect_mask: uint16;
    contra_stock_leg_short_sale: uint8 &convert=ContraStockLegShortSale($$);
    contra_stock_leg_mpid: bytes &size=4;
    : skip bytes &size=1;   # padding
};

type MemberKillSwitchNotificationMessage = unit {
    timestamp: uint64;
    firm_id: bytes &size=4;
    cl_request_id: bytes &size=16;
    target_firm_id: bytes &size=4;
