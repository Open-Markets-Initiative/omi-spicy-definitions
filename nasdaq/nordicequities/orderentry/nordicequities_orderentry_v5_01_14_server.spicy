type OrderReplacedMessage = unit {
    timestamp: uint64;
    orig_user_ref_num: uint32;
    new_user_ref_num: uint32;
    price: uint32;
    order_reference_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    order_book: uint32;
    quantity: uint32;
    user: bytes &size=6;
    appendage_length: uint16;
    tagvalue: Tagvalue[] &eod;
};

