    original_order_entry_date_value: uint32;
};

type OriginalOrderReferenceNumber = unit {
    original_order_reference_number_value: uint64;
};

type PegDifference = unit {
    peg_difference_value: int32;
};

type PegType = unit {
    peg_type_value: uint8 &convert=PegTypeValue($$);
};

