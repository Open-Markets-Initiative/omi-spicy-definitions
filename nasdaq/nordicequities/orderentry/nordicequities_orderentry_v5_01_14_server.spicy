module NasdaqNordicequitiesOrderentryOuchV50114Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NordicequitiesOrderentryV50114 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket;
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit {
    debug_text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: uint8 &convert=RejectReasonCode($$);
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        SequencedMessageType::OrderAcceptedMessage -> order_accepted_message: OrderAcceptedMessage;
        SequencedMessageType::OrderReplacedMessage -> order_replaced_message: OrderReplacedMessage;
        SequencedMessageType::CancelledOrderMessage -> cancelled_order_message: CancelledOrderMessage;
        SequencedMessageType::CancelPendingMessage -> cancel_pending_message: CancelPendingMessage;
        SequencedMessageType::ReplacePendingMessage -> replace_pending_message: ReplacePendingMessage;
        SequencedMessageType::ExecutedOrderMessage -> executed_order_message: ExecutedOrderMessage;
        SequencedMessageType::BrokenTradeMessage -> broken_trade_message: BrokenTradeMessage;
        SequencedMessageType::RejectedOrderMessage -> rejected_order_message: RejectedOrderMessage;
        SequencedMessageType::CancelRejectedMessage -> cancel_rejected_message: CancelRejectedMessage;
        SequencedMessageType::OrderRestatedMessage -> order_restated_message: OrderRestatedMessage;
        SequencedMessageType::MmoRefreshRequestMessage -> mmo_refresh_request_message: MmoRefreshRequestMessage;
        SequencedMessageType::AccountQueryResponseMessage -> account_query_response_message: AccountQueryResponseMessage;
        SequencedMessageType::GtcCancelledMessage -> gtc_cancelled_message: GtcCancelledMessage;
        SequencedMessageType::ResponseToMmiNotificationMessage -> response_to_mmi_notification_message: ResponseToMmiNotificationMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemEventMessage = unit {
    timestamp: uint64;
    event_code: uint8 &convert=EventCode($$);
};

type OrderAcceptedMessage = unit {
    timestamp: uint64;
    user_ref_num: uint32;
    price: uint32;
    order_reference_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    order_book: uint32;
    quantity: uint32;
    user: bytes &size=6;
    execution_within_firm: uint32;
    investment_decision_within_firm_short_code: uint32;
    client_identifier: uint32;
    party_role_qualifier: bitfield(8) {
        client_identification: 0..1;
        investment_decision_within_firm: 2..3;
        execution_decision_within_firm: 4..5;
        reserved_78: 6..7;
    } &byte-order=spicy::ByteOrder::Big;
    capacity: uint8 &convert=Capacity($$);
    algo_indicator: uint8 &convert=AlgoIndicator($$);
    appendage_length: uint16;
    tagvalue: Tagvalue[] &eod;
};

type Tagvalue = unit {
    length: uint8;
    tag: uint8;
    switch ( self.tag ) {
        1 -> clearing_account: ClearingAccount;
        2 -> clearing_account_type: ClearingAccountType;
        3 -> clearing_firm: ClearingFirm;
        4 -> client_reference: ClientReference;
        5 -> cross_type: CrossType;
        6 -> dea_indicator: DeaIndicator;
        7 -> display: Display;
        8 -> display_price: DisplayPrice;
        9 -> display_quantity: DisplayQuantity;
        10 -> expire_time: ExpireTime;
        11 -> firm: Firm;
        12 -> liquidity_provision_indicator: LiquidityProvisionIndicator;
        13 -> max_floor: MaxFloor;
        14 -> minimum_quantity: MinimumQuantity;
        15 -> order_reference: OrderReference;
        16 -> original_order_entry_date: OriginalOrderEntryDate;
        17 -> original_order_reference_number: OriginalOrderReferenceNumber;
        18 -> peg_difference: PegDifference;
        19 -> peg_type: PegType;
        20 -> random_reserve: RandomReserve;
        21 -> secondary_order_reference_number: SecondaryOrderReferenceNumber;
        22 -> stp_action: StpAction;
        23 -> stp_level: StpLevel;
        24 -> stp_trader_group: StpTraderGroup;
        25 -> time_in_force: TimeInForce;
        26 -> trading_at_closing_price: TradingAtClosingPrice;
        27 -> order_condition: OrderCondition;
        28 -> cumulative_quantity: CumulativeQuantity;
        29 -> customer_order_capacity: CustomerOrderCapacity;
        * -> unknown: bytes &eod;
    };
};

type ClearingAccount = unit {
    clearing_account_value: bytes &size=12;
};

type ClearingAccountType = unit {
    clearing_account_type_value: uint8 &convert=ClearingAccountTypeValue($$);
};

type ClearingFirm = unit {
    clearing_firm_value: bytes &size=4;
};

type ClientReference = unit {
    client_reference_value: bytes &size=15;
};

