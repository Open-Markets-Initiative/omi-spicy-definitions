};

type ExecutedOrderMessage = unit {
    timestamp: uint64;
    user_ref_num: uint32;
    executed_quantity: uint32;
    execution_price: uint32;
    liquidity_flag: bytes &size=1;
    match_number: uint32;
    contra_firm: bytes &size=4;
    trading_mode: uint8 &convert=TradingMode($$);
    transaction_category: uint8 &convert=TransactionCategory($$);
    transaction_type_algo_indicator: uint8 &convert=TransactionTypeAlgoIndicator($$);
    liquidity_attributes: bitfield(8) {
        reserved_13: 0..2;
        liquidity_indicator: 3..4;
        liquidity_internalized: 5;
        liquidity_top_of_book: 6;
        liquidity_self_trade: 7;
    } &byte-order=spicy::ByteOrder::Big;
    last_market: uint8;
};

type BrokenTradeMessage = unit {
    timestamp: uint64;
    user_ref_num: uint32;
    match_number: uint32;
    broken_trade_reason: uint8 &convert=BrokenTradeReason($$);
    trading_mode: uint8 &convert=TradingMode($$);
    transaction_category: uint8 &convert=TransactionCategory($$);
    transaction_type_algo_indicator: uint8 &convert=TransactionTypeAlgoIndicator($$);
};

type RejectedOrderMessage = unit {
