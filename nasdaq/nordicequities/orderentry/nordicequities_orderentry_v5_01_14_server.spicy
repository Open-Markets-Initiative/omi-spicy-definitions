};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
    EndOfSessionPacket = 0x5a,
};

type RejectReasonCode = enum {
    NotAuthorized = 0x41,
    SessionNotAvailable = 0x53,
};

type SequencedMessageType = enum {
    SystemEventMessage = 0x53,
    OrderAcceptedMessage = 0x41,
    OrderReplacedMessage = 0x55,
    CancelledOrderMessage = 0x43,
    CancelPendingMessage = 0x50,
    ReplacePendingMessage = 0x4e,
    ExecutedOrderMessage = 0x45,
    BrokenTradeMessage = 0x42,
    RejectedOrderMessage = 0x4a,
    CancelRejectedMessage = 0x49,
    OrderRestatedMessage = 0x54,
    MmoRefreshRequestMessage = 0x57,
    AccountQueryResponseMessage = 0x51,
    GtcCancelledMessage = 0x47,
    ResponseToMmiNotificationMessage = 0x52,
};

type EventCode = enum {
    StartOfDay = 0x53,
    EndOfDay = 0x45,
};

type BuySellIndicator = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

type ClientIdentification = enum {
    None_0 = 0,
    LeiFirm = 1,
    NaturalPerson = 3,
};

