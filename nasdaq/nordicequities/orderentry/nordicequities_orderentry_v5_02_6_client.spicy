module NasdaqNordicequitiesOrderentryOuchV5026Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NordicequitiesOrderentryV5026 = unit {
    client_soup_bin_tcp_packet: ClientSoupBinTcpPacket[] &eod;
};

type ClientSoupBinTcpPacket = unit {
    client_packet_header: ClientPacketHeader;
    switch ( self.client_packet_header.client_packet_type ) {
        ClientPacketType::DebugPacket -> debug_packet: DebugPacket;
        ClientPacketType::LoginRequestPacket -> login_request_packet: LoginRequestPacket;
        ClientPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ClientPacketHeader = unit {
    packet_length: uint16;
    client_packet_type: uint8 &convert=ClientPacketType($$);
};

type DebugPacket = unit {
    text: bytes &size=1;
};

type LoginRequestPacket = unit {
    username: bytes &size=6;
    password: bytes &size=10;
    requested_session: bytes &size=10;
    requested_sequence_number: bytes &size=20;
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: uint8 &convert=UnsequencedMessageType($$);
    switch ( self.unsequenced_message_type ) {
        UnsequencedMessageType::EnterOrderMessage -> enter_order_message: EnterOrderMessage;
        UnsequencedMessageType::ReplaceOrderMessage -> replace_order_message: ReplaceOrderMessage;
        UnsequencedMessageType::CancelOrderMessage -> cancel_order_message: CancelOrderMessage;
        UnsequencedMessageType::MmiNotificationRequestMessage -> mmi_notification_request_message: MmiNotificationRequestMessage;
        * -> unknown: bytes &eod;
    };
};

type EnterOrderMessage = unit {
    user_ref_num: uint32;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    quantity: uint32;
    order_book: uint32;
    price: uint32;
    user: bytes &size=6;
    execution_within_firm: uint32;
    investment_decision_within_firm_short_code: uint32;
    client_identifier: uint32;
    party_role_qualifier: PartyRoleQualifier;
    capacity: uint8 &convert=Capacity($$);
    algo_indicator: uint8 &convert=AlgoIndicator($$);
    appendage_length: uint16;
    tagvalue: Tagvalue[] &eod;
};

type PartyRoleQualifier = unit {
    client_identification: uint8 &convert=ClientIdentification($$);
    investment_decision_within_firm: uint8 &convert=InvestmentDecisionWithinFirm($$);
    execution_decision_within_firm: uint8 &convert=ExecutionDecisionWithinFirm($$);
    reserved_78: bytes &size=1;
};

type Tagvalue = unit {
    length: uint8;
    tag: uint8;
    switch ( self.tag ) {
        1 -> clearing_account: ClearingAccount;
        2 -> clearing_account_type: ClearingAccountType;
        3 -> clearing_firm: ClearingFirm;
        4 -> client_reference: ClientReference;
        5 -> cross_type: CrossType;
        6 -> dea_indicator: DeaIndicator;
        7 -> display: Display;
        8 -> display_price: DisplayPrice;
        9 -> display_quantity: DisplayQuantity;
        10 -> expire_time: ExpireTime;
        11 -> firm: Firm;
        12 -> liquidity_provision_indicator: LiquidityProvisionIndicator;
        13 -> max_floor: MaxFloor;
        14 -> minimum_quantity: MinimumQuantity;
        15 -> order_reference: OrderReference;
        16 -> original_order_entry_date: OriginalOrderEntryDate;
        17 -> original_order_reference_number: OriginalOrderReferenceNumber;
        18 -> peg_difference: PegDifference;
        19 -> peg_type: PegType;
        20 -> random_reserve: RandomReserve;
        21 -> secondary_order_reference_number: SecondaryOrderReferenceNumber;
        22 -> stp_action: StpAction;
        23 -> stp_level: StpLevel;
        24 -> stp_trader_group: StpTraderGroup;
        25 -> time_in_force: TimeInForce;
        26 -> trading_at_closing_price: TradingAtClosingPrice;
        27 -> order_condition: OrderCondition;
        28 -> cumulative_quantity: CumulativeQuantity;
        29 -> customer_order_capacity: CustomerOrderCapacity;
        30 -> target_strategy: TargetStrategy;
        31 -> min_rate: MinRate;
        32 -> max_rate: MaxRate;
        33 -> conditional_type: ConditionalType;
        34 -> firm_up_id: FirmUpId;
        * -> unknown: bytes &eod;
    };
};

type ClearingAccount = unit {
    clearing_account_value: bytes &size=12;
};

type ClearingAccountType = unit {
    clearing_account_type_value: uint8 &convert=ClearingAccountTypeValue($$);
};

type ClearingFirm = unit {
    clearing_firm_value: bytes &size=4;
};

type ClientReference = unit {
    client_reference_value: bytes &size=15;
};

type CrossType = unit {
    cross_type_value: uint8 &convert=CrossTypeValue($$);
};

type DeaIndicator = unit {
    dea_indicator_value: uint8 &convert=DeaIndicatorValue($$);
};

type Display = unit {
    display_value: uint8 &convert=DisplayValue($$);
};

type DisplayPrice = unit {
    display_price_value: uint32;
};

type DisplayQuantity = unit {
    display_quantity_value: uint32;
};

type ExpireTime = unit {
    expire_time_value: uint16;
};

type Firm = unit {
    firm_value: bytes &size=4;
};

type LiquidityProvisionIndicator = unit {
    liquidity_provision_indicator_value: uint8 &convert=LiquidityProvisionIndicatorValue($$);
};

type MaxFloor = unit {
    max_floor_value: uint32;
};

type MinimumQuantity = unit {
    minimum_quantity_value: uint32;
};

type OrderReference = unit {
    order_reference_value: bytes &size=10;
};

type OriginalOrderEntryDate = unit {
    original_order_entry_date_value: uint32;
};

type OriginalOrderReferenceNumber = unit {
    original_order_reference_number_value: uint64;
};

type PegDifference = unit {
    peg_difference_value: int32;
};

type PegType = unit {
    peg_type_value: uint8 &convert=PegTypeValue($$);
};

type RandomReserve = unit {
    random_reserve_value: uint32;
};

type SecondaryOrderReferenceNumber = unit {
    secondary_order_reference_number_value: uint64;
};

type StpAction = unit {
    stp_action_value: uint8 &convert=StpActionValue($$);
};

type StpLevel = unit {
    stp_level_value: uint8 &convert=StpLevelValue($$);
};

type StpTraderGroup = unit {
    stp_trader_group_value: bytes &size=2;
};

type TimeInForce = unit {
    time_in_force_value: uint8 &convert=TimeInForceValue($$);
};

type TradingAtClosingPrice = unit {
    trading_at_closing_price_value: uint8 &convert=TradingAtClosingPriceValue($$);
};

type OrderCondition = unit {
    order_condition_value: uint8 &convert=OrderConditionValue($$);
};

type CumulativeQuantity = unit {
    cumulative_quantity_value: uint32;
};

type CustomerOrderCapacity = unit {
    customer_order_capacity_value: uint8 &convert=CustomerOrderCapacityValue($$);
};

type TargetStrategy = unit {
    target_strategy_value: uint8 &convert=TargetStrategyValue($$);
};

type MinRate = unit {
    min_rate_value: uint16;
};

type MaxRate = unit {
    max_rate_value: uint16;
};

type ConditionalType = unit {
    conditional_type_value: uint8 &convert=ConditionalTypeValue($$);
};

type FirmUpId = unit {
    firm_up_id_value: uint32;
};

type ReplaceOrderMessage = unit {
    orig_user_ref_num: uint32;
    new_user_ref_num: uint32;
    quantity: uint32;
    price: uint32;
    user: bytes &size=6;
    appendage_length: uint16;
    tagvalue: Tagvalue[] &eod;
};

type CancelOrderMessage = unit {
    user_ref_num: uint32;
    quantity: uint32;
    user: bytes &size=6;
};

type MmiNotificationRequestMessage = unit {
    user_ref_num: uint32;
    order_book: uint32;
    instruction: bytes &size=1;
    add_or_remove: bytes &size=1;
    firm: Firm;
    user: bytes &size=6;
};

type ClientPacketType = enum {
    DebugPacket = 0x2b,
    LoginRequestPacket = 0x4c,
    UnsequencedDataPacket = 0x55,
    ClientHeartbeatPacket = 0x52,
    LogoutRequestPacket = 0x4f,
};

type UnsequencedMessageType = enum {
    EnterOrderMessage = 0x4f,
    ReplaceOrderMessage = 0x55,
    CancelOrderMessage = 0x58,
    AccountQueryMessage = 0x51,
    MmiNotificationRequestMessage = 0x4d,
};

type BuySellIndicator = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

type ClientIdentification = enum {
    None_0 = 0,
    LeiFirm = 1,
    NaturalPerson = 3,
};

type InvestmentDecisionWithinFirm = enum {
    None_0 = 0,
    Algo = 2,
    NaturalPerson = 3,
};

type ExecutionDecisionWithinFirm = enum {
    None_0 = 0,
    Algo = 2,
    NaturalPerson = 3,
};

type Capacity = enum {
    Client = 0x31,
    OwnAccount = 0x32,
    MarketMaker = 0x33,
    IssuerHolding = 0x34,
    IssuePriceStabilizing = 0x36,
    RisklessPrincipal = 0x37,
    IssuerHoldingDeal = 0x38,
    IssuePriceStabilizingDeal = 0x39,
};

type AlgoIndicator = enum {
    NoAlgo = 0x2d,
    Algo = 0x48,
};

type ClearingAccountTypeValue = enum {
    CustomerClient = 0x31,
    FirmHouse = 0x32,
};

type CrossTypeValue = enum {
    ClosingCross = 0x43,
    OpeningCross = 0x4f,
    ScheduledIntradayCross = 0x49,
    HaltCross = 0x48,
    AuctionOnDemand = 0x41,
};

type DeaIndicatorValue = enum {
    OrderReceivedFromACustomer = 0x31,
    OrderReceivedFromWithinTheFirm = 0x32,
    OrderReceivedFromAnotherBrokerDealer = 0x33,
    OrderReceivedFromACustomerOrOriginatedWithTheFirm = 0x34,
    OrderReceivedFromADirectAccessOrSponsoredAccessCustomer = 0x35,
};

type DisplayValue = enum {
    Display = 0x59,
    NonDisplay = 0x4e,
    AuctionOnDemand = 0x41,
    NordicMid = 0x4d,
    PureStream = 0x53,
};

type LiquidityProvisionIndicatorValue = enum {
    NoLiquidityProvision = 0x4e,
    LiquidityProvision = 0x59,
};

type PegTypeValue = enum {
    Midpoint = 0x4d,
    Market = 0x50,
    Primary = 0x52,
};

type StpActionValue = enum {
    CancelPassiveOrder = 0x31,
    CancelAggressiveOrder = 0x32,
    CancelBothOrders = 0x33,
    CreateATransferTransaction = 0x34,
};

type StpLevelValue = enum {
    MpidAndTrader = 0x31,
    Mpid = 0x32,
    SpecifiedTraderGroup = 0x33,
};

type TimeInForceValue = enum {
    Day = 0x30,
    GtcGoodTillCancelled = 0x31,
    IocImmediateOrCancel = 0x33,
    GttGoodTillTime = 0x36,
    GfaGoodForAuction = 0x42,
};

type TradingAtClosingPriceValue = enum {
    ParticipateInTradingAtClosingPrice = 0x59,
    DoNotParticipateInTradingAtClosingPrice = 0x4e,
};

type OrderConditionValue = enum {
    MarketMakerOrder = 0x57,
    MarketMakerOrderRefresh = 0x55,
    TopofBook = 0x50,
    DarklitSweep = 0x51,
    TradeNow = 0x54,
};

type CustomerOrderCapacityValue = enum {
    RetailCustomer = 0x35,
};

type TargetStrategyValue = enum {
    Rate5To15Percent = 0x30,
    Rate5To30Percent = 0x31,
    Rate10To200Percent = 0x35,
    Custom = 0x43,
};

type ConditionalTypeValue = enum {
    ConditionalOrder = 0x43,
