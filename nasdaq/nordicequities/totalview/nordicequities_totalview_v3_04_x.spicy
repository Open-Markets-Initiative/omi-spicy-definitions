    quantity: uint32;
    hidden_quantity: uint32;
    stp_cancel_quantity: uint32;
    far_price: uint32;
    add_quantity: uint32;
    number_of_lit_executions: uint16;
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    OrderBookTradingActionMessage = 0x48,
    OrderBookDirectoryMessage = 0x52,
    AddOrderMessage = 0x41,
    AddOrderMpidAttributionMessage = 0x46,
    OrderExecutedMessage = 0x45,
    OrderExecutedWithPriceMessage = 0x43,
    OrderCancelMessage = 0x58,
    OrderDeleteMessage = 0x44,
    OrderBookFlushMessage = 0x59,
    OrderReplaceMessage = 0x55,
    TradeMessage = 0x50,
    CrossTradeMessage = 0x51,
    BrokenTradeMessage = 0x42,
    NoiiMessage = 0x49,
    MoiiMessage = 0x4a,
    ExecutionSummaryMessage = 0x4b,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    EndOfMessages = 0x43,
};

type SymbolState = enum {
    Closed = 0x43,
    PreOpen = 0x50,
    OpeningAuction = 0x4f,
    ContinuousTrading = 0x54,
    ScheduledIntradayAuction = 0x49,
    ClosingAuction = 0x4c,
    PostTrade = 0x53,
    Halted = 0x48,
    AuctionPeriod = 0x51,
    TradingAtClosingPrice = 0x41,
};

type Extension = enum {
    CrossExtension = 0x45,
};

type Reason = enum {
    ReasonNotAvailable = 0,
};

type FinancialProduct = enum {
    Stock = 1,
    EquityWarrant = 2,
    EquityRight = 3,
    Bond = 4,
    LotteryBondSeries = 6,
    Convertible = 7,
    Warrant = 8,
    UnitTrustCertificate = 11,
    IndexFundUnit = 12,
};

type PriceNotation = enum {
    MonetaryValue = 0x4d,
};

type BuySellIndicator = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

type Printable = enum {
    NonPrintable = 0x4e,
    Printable_x59 = 0x59,
};

type TradeType = enum {
    MainBook = 0x42,
    NordicMid = 0x53,
};

type CrossType = enum {
    OpeningCross = 0x4f,
    ScheduledIntradayCross = 0x49,
    ClosingCross = 0x43,
    CrossForHaltedSecurities = 0x48,
    AuctionOnDemand = 0x41,
};

type ImbalanceDirection = enum {
    BuyImbalance = 0x42,
    SellImbalance = 0x53,
    NoImbalance = 0x4e,
    InsufficientOrdersToCalculate = 0x4f,
};

type CrossLevel = enum {
    Buy = 0x42,
    Sell = 0x53,
    Mid = 0x4d,
    Limit = 0x4c,
};

type AggressingSide = enum {
    Buy = 0x42,
    Sell = 0x53,
    None_x20 = 0x20,
};

