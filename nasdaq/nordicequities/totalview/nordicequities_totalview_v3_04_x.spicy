module NasdaqNordicequitiesTotalviewItchV304X;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NordicequitiesTotalviewV304X = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::OrderBookTradingActionMessage -> order_book_trading_action_message: OrderBookTradingActionMessage;
        MessageType::OrderBookDirectoryMessage -> order_book_directory_message: OrderBookDirectoryMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::AddOrderMpidAttributionMessage -> add_order_mpid_attribution_message: AddOrderMpidAttributionMessage;
        MessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        MessageType::OrderExecutedWithPriceMessage -> order_executed_with_price_message: OrderExecutedWithPriceMessage;
        MessageType::OrderCancelMessage -> order_cancel_message: OrderCancelMessage;
        MessageType::OrderDeleteMessage -> order_delete_message: OrderDeleteMessage;
        MessageType::OrderBookFlushMessage -> order_book_flush_message: OrderBookFlushMessage;
        MessageType::OrderReplaceMessage -> order_replace_message: OrderReplaceMessage;
        MessageType::TradeMessage -> trade_message: TradeMessage;
        MessageType::CrossTradeMessage -> cross_trade_message: CrossTradeMessage;
        MessageType::BrokenTradeMessage -> broken_trade_message: BrokenTradeMessage;
        MessageType::NoiiMessage -> noii_message: NoiiMessage;
        MessageType::MoiiMessage -> moii_message: MoiiMessage;
        MessageType::ExecutionSummaryMessage -> execution_summary_message: ExecutionSummaryMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type SystemEventMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    event_code: uint8 &convert=EventCode($$);
};

type OrderBookTradingActionMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    order_book: uint32;
    symbol_state: uint8 &convert=SymbolState($$);
    extension: uint8 &convert=Extension($$);
    reason: bytes &size=4;
};

type OrderBookDirectoryMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    order_book: uint32;
    symbol: bytes &size=16;
    isin: bytes &size=12;
    financial_product: uint8 &convert=FinancialProduct($$);
    trading_currency: bytes &size=3;
    mic: bytes &size=4;
    market_segment_id: uint16;
    note_codes_bit_field_1: bitfield(8) {
        nm_new_market_company: 0;
        xr_excluding_participating_in_rights: 1;
        sp_excluding_participating_in_split: 2;
        po_company_subject_to_public_offer: 3;
        ud_under_drawing: 4;
        sr_excluding_comb_split_and_issue_rights: 5;
        ul_un_listed: 6;
        wi_when_issued: 7;
    } &byte-order=spicy::ByteOrder::Little;
    note_codes_bit_field_2: bitfield(8) {
        br_company_bankruptcy: 0;
        su_suspension: 1;
        rl_removal_from_listing_in_process: 2;
        sl_other_surveillance_list_reason: 3;
        to_a_significant_reverse_takeover_pending: 4;
        cs_cent_shares: 5;
        rs_reversed_split: 6;
        bs_excluding_comb_bonus_split: 7;
    } &byte-order=spicy::ByteOrder::Little;
    note_codes_bit_field_3: bitfield(8) {
        ss_excluding_comb_split_redemption_share: 0;
        fn_first_north_company: 1;
        ob_observation_status: 2;
        xd_excluding_dividend: 3;
        fe_foreign_non_eueea_entity: 4;
        so_sold_out_buy_back: 5;
        sk_soft_knock: 6;
        kb_knock_out_buy_back: 7;
    } &byte-order=spicy::ByteOrder::Little;
    note_codes_bit_field_4: bitfield(8) {
        bb_buy_back: 0;
        reserved_23: 1..2;
        ce_capped_by_esma: 3;
        reserved_5: 4;
        pd_price_discrepancy_historical_average_share_classes: 5;
        sm_stressed_market: 6;
        ew_marketwide_exceptional_circumstance: 7;
    } &byte-order=spicy::ByteOrder::Little;
    note_codes_bit_field_5: bitfield(8) {
        em_exceptional_circumstances_related_to_market_maker: 0;
        un_underlying_not_quoted: 1;
        da_digital_asset: 2;
        kn_knockout_buy_back_into_next_trading_day: 3;
        reserved_58: 4..7;
    } &byte-order=spicy::ByteOrder::Little;
    note_codes_bit_field_6: bitfield(8) {
        reserved_18: 0..7;
    } &byte-order=spicy::ByteOrder::Little;
    note_codes_bit_field_7: bitfield(8) {
        reserved_18: 0..7;
    } &byte-order=spicy::ByteOrder::Little;
    note_codes_bit_field_8: bitfield(8) {
        reserved_18: 0..7;
    } &byte-order=spicy::ByteOrder::Little;
    round_lot_size: uint32;
    nordic_mid_mic: bytes &size=4;
    aod_mic: bytes &size=4;
    notation_of_qty: bytes &size=4;
    notional_amount: uint64;
    currency: bytes &size=3;
    price_notation: uint8 &convert=PriceNotation($$);
    multiplier_for_calculating_quantity_in_measurement_unit: uint64;
    pure_stream_mic: bytes &size=4;
};

type AddOrderMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    order_reference_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    quantity: uint32;
    order_book: uint32;
    price: uint32;
};

type AddOrderMpidAttributionMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    order_reference_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    quantity: uint32;
    order_book: uint32;
    price: uint32;
    attribution: bytes &size=4;
};

type OrderExecutedMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    order_reference_number: uint64;
    executed_quantity: uint32;
    match_number: uint32;
    mpid: bytes &size=4;
