    order_book: uint32;
    match_number: uint32;
    trade_price: uint32;
    participant_id_buyer: bytes &size=4;
    participant_id_seller: bytes &size=4;
};

type CrossTradeMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    quantity: uint32;
    order_book: uint32;
    cross_price: uint32;
    match_number: uint32;
    cross_type: uint8 &convert=CrossType($$);
    number_of_trades: uint32;
};

type BrokenTradeMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    match_number: uint32;
};

type NoiiMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    paired_quantity: uint64;
    imbalance_quantity: uint64;
    imbalance_direction: uint8 &convert=ImbalanceDirection($$);
    order_book: uint32;
    equilibrium_price: uint32;
    cross_type: uint8 &convert=CrossType($$);
    best_bid_price: uint32;
    best_bid_quantity: uint64;
    best_ask_price: uint32;
    best_ask_quantity: uint64;
};

type MoiiMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
    paired_quantity: uint64;
    order_book: uint32;
    equilibrium_price: uint32;
    cross_type: uint8 &convert=CrossType($$);
    cross_level: uint8 &convert=CrossLevel($$);
};

type ExecutionSummaryMessage = unit {
    timestamp: uint64;
    tracking_number: uint16;
