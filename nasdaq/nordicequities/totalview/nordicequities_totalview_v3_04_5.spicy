    LotteryBondSeries = 6,
    Convertible = 7,
    Warrant = 8,
    UnitTrustCertificate = 11,
    IndexFundUnit = 12,
};

type PriceNotation = enum {
    MonetaryValue = 0x4d,
};

type BuySellIndicator = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

type Printable = enum {
    NonPrintable = 0x4e,
    Printable = 0x59,
};

type TradeType = enum {
    MainBook = 0x42,
    NordicMid = 0x53,
};

type CrossType = enum {
    OpeningCross = 0x4f,
    ScheduledIntradayCross = 0x49,
    ClosingCross = 0x43,
    CrossForHaltedSecurities = 0x48,
    AuctionOnDemand = 0x41,
};

type ImbalanceDirection = enum {
    BuyImbalance = 0x42,
