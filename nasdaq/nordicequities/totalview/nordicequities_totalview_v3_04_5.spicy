type MessageType = enum {
    SystemEventMessage = 0x53,
    OrderBookTradingActionMessage = 0x48,
    OrderBookDirectoryMessage = 0x52,
    AddOrderMessage = 0x41,
    AddOrderMpidAttributionMessage = 0x46,
    OrderExecutedMessage = 0x45,
    OrderExecutedWithPriceMessage = 0x43,
    OrderCancelMessage = 0x58,
    OrderDeleteMessage = 0x44,
    OrderBookFlushMessage = 0x59,
    OrderReplaceMessage = 0x55,
    TradeMessage = 0x50,
    CrossTradeMessage = 0x51,
    BrokenTradeMessage = 0x42,
    NoiiMessage = 0x49,
    MoiiMessage = 0x4a,
    ExecutionSummaryMessage = 0x4b,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    EndOfMessages = 0x43,
};

type SymbolState = enum {
    Closed = 0x43,
    PreOpen = 0x50,
    OpeningAuction = 0x4f,
    ContinuousTrading = 0x54,
    ScheduledIntradayAuction = 0x49,
    ClosingAuction = 0x4c,
    PostTrade = 0x53,
    Halted = 0x48,
    AuctionPeriod = 0x51,
    TradingAtClosingPrice = 0x41,
};

type Extension = enum {
    CrossExtension = 0x45,
};

type Reason = enum {
    ReasonNotAvailable = 0x20,
};

type FinancialProduct = enum {
    Stock = 1,
    EquityWarrant = 2,
