module NasdaqPsxequitiesMatchviewAsciiitchV11;

import spicy;

%byte-order = spicy::ByteOrder::Little;

public type PsxequitiesMatchviewV11 = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence_number: uint32;
    message_count: uint16;
};

type Message = unit {
    message_length: uint16;
    message_body: MessageData;
};

type MessageData = unit {
    message_header: MessageHeader;
    payload: BestBidAndOfferMessage;
};

type MessageHeader = unit {
    timestamp: bytes &size=8;
    message_type: uint8 &convert=MessageType($$);
};

type BestBidAndOfferMessage = unit {
    symbol: bytes &size=8;
    bid_price: bytes &size=10;
    ask_price: bytes &size=10;
};

type MessageType = enum {
    BestBidAndOfferMessage = 0x55,
};

