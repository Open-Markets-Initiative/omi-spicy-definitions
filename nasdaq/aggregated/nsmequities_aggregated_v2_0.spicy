module NasdaqNsmequitiesAggregatedItchV20;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesAggregatedV20 = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::StockDirectoryMessage -> stock_directory_message: StockDirectoryMessage;
        MessageType::StockTradingActionMessage -> stock_trading_action_message: StockTradingActionMessage;
        MessageType::RegShoShortSalePriceTestRestrictedIndicatorMessage -> reg_sho_short_sale_price_test_restricted_indicator_message: RegShoShortSalePriceTestRestrictedIndicatorMessage;
        MessageType::MarketParticipantPositionMessage -> market_participant_position_message: MarketParticipantPositionMessage;
        MessageType::MwcbDeclineLevelMessage -> mwcb_decline_level_message: MwcbDeclineLevelMessage;
        MessageType::MwcbStatusMessage -> mwcb_status_message: MwcbStatusMessage;
        MessageType::IpoQuotingPeriodUpdateMessage -> ipo_quoting_period_update_message: IpoQuotingPeriodUpdateMessage;
        MessageType::LuldAuctionCollarMessage -> luld_auction_collar_message: LuldAuctionCollarMessage;
        MessageType::OperationalHaltMessage -> operational_halt_message: OperationalHaltMessage;
        MessageType::PriceLevelUpdateMessage -> price_level_update_message: PriceLevelUpdateMessage;
        MessageType::NetOrderImbalanceIndicatorMessage -> net_order_imbalance_indicator_message: NetOrderImbalanceIndicatorMessage;
        MessageType::RetailPriceImprovementIndicatorMessage -> retail_price_improvement_indicator_message: RetailPriceImprovementIndicatorMessage;
        MessageType::DirectListingWithCapitalRaisePriceDiscoveryMessage -> direct_listing_with_capital_raise_price_discovery_message: DirectListingWithCapitalRaisePriceDiscoveryMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type SystemEventMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    event_code: uint8 &convert=EventCode($$);
};

type StockDirectoryMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    market_category: uint8 &convert=MarketCategory($$);
    financial_status_indicator: uint8 &convert=FinancialStatusIndicator($$);
    round_lot_size: uint32;
    round_lots_only: uint8 &convert=RoundLotsOnly($$);
    issue_classification: uint8 &convert=IssueClassification($$);
    issue_sub_type: bytes &size=2;
    authenticity: uint8 &convert=Authenticity($$);
    short_sale_threshold_indicator: uint8 &convert=ShortSaleThresholdIndicator($$);
    ipo_flag: uint8 &convert=IpoFlag($$);
    luld_reference_price_tier: uint8 &convert=LuldReferencePriceTier($$);
    etp_flag: uint8 &convert=EtpFlag($$);
    etp_leverage_factor: uint32;
    inverse_indicator: uint8 &convert=InverseIndicator($$);
};

type StockTradingActionMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    trading_state: uint8 &convert=TradingState($$);
    reason: bytes &size=4;
};

type RegShoShortSalePriceTestRestrictedIndicatorMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    reg_sho_action: uint8 &convert=RegShoAction($$);
};

type MarketParticipantPositionMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    mpid: bytes &size=4;
    stock: bytes &size=8;
    primary_market_maker: uint8 &convert=PrimaryMarketMaker($$);
    market_maker_mode: uint8 &convert=MarketMakerMode($$);
    market_participant_state: uint8 &convert=MarketParticipantState($$);
};

type MwcbDeclineLevelMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    level_1: uint64;
    level_2: uint64;
    level_3: uint64;
};

type MwcbStatusMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    breached_level: uint8 &convert=BreachedLevel($$);
};

type IpoQuotingPeriodUpdateMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    ipo_quotation_release_time: uint32;
    ipo_quotation_release_qualifier: uint8 &convert=IpoQuotationReleaseQualifier($$);
    ipo_price: uint32;
};

type LuldAuctionCollarMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    auction_collar_reference_price: uint32;
    upper_auction_collar_price: uint32;
    lower_auction_collar_price: uint32;
    auction_collar_extension: uint32;
};

type OperationalHaltMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    market_code: uint8 &convert=MarketCode($$);
    operational_halt_action: uint8 &convert=OperationalHaltAction($$);
};

type PriceLevelUpdateMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    market_side: uint8 &convert=MarketSide($$);
    participant_shares: uint32;
    aggregate_shares: uint32;
    stock: bytes &size=8;
    price: uint32;
    mpid: bytes &size=4;
};

type NetOrderImbalanceIndicatorMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    paired_shares: uint64;
    imbalance_shares: uint64;
    imbalance_direction: uint8 &convert=ImbalanceDirection($$);
    stock: bytes &size=8;
    far_price: uint32;
    near_price: uint32;
    current_reference_price: uint32;
    cross_type: uint8 &convert=CrossType($$);
    price_variation_indicator: uint8 &convert=PriceVariationIndicator($$);
};

type RetailPriceImprovementIndicatorMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    interest_flag: uint8 &convert=InterestFlag($$);
};

type DirectListingWithCapitalRaisePriceDiscoveryMessage = unit {
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    open_eligibility_status: uint8 &convert=OpenEligibilityStatus($$);
    minimum_allowable_price: uint32;
    maximum_allowable_price: uint32;
    near_execution_price: uint32;
    near_execution_time: uint64;
    lower_price_range_collar: uint32;
    upper_price_range_collar: uint32;
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    StockDirectoryMessage = 0x52,
    StockTradingActionMessage = 0x48,
    RegShoShortSalePriceTestRestrictedIndicatorMessage = 0x59,
    MarketParticipantPositionMessage = 0x50,
    MwcbDeclineLevelMessage = 0x56,
    MwcbStatusMessage = 0x57,
    IpoQuotingPeriodUpdateMessage = 0x4b,
    LuldAuctionCollarMessage = 0x4a,
    OperationalHaltMessage = 0x68,
    PriceLevelUpdateMessage = 0x55,
    NetOrderImbalanceIndicatorMessage = 0x49,
    RetailPriceImprovementIndicatorMessage = 0x4e,
    DirectListingWithCapitalRaisePriceDiscoveryMessage = 0x4f,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfMarketHours = 0x51,
    ClearNoii = 0x58,
    EndOfMarketHours = 0x4d,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
};

type MarketCategory = enum {
    NasdaqGlobalSelectMarket = 0x51,
    NasdaqGlobalMarket = 0x47,
    NasdaqCapitalMarket = 0x53,
    NewYorkStockExchange = 0x4e,
    NyseAmerican = 0x41,
    NyseArca = 0x50,
    NyseTexas = 0x4d,
    BatsZExchange = 0x5a,
    InvestorsExchangeLlc = 0x56,
    NotAvailable = 0x20,
};

type FinancialStatusIndicator = enum {
    Deficient = 0x44,
    Delinquent = 0x45,
    Bankrupt = 0x51,
    Suspended = 0x53,
    DeficientAndBankrupt = 0x47,
    DeficientAndDelinquent = 0x48,
    DelinquentAndBankrupt = 0x4a,
    DeficientDelinquentAndBankrupt = 0x4b,
    CreationsAndorRedemptionsSuspendedForExchangeTradedProduct = 0x43,
    Normal = 0x4e,
    NotAvailable = 0x20,
};

type RoundLotsOnly = enum {
    RoundLotsOnly = 0x59,
    NoRestriction = 0x4e,
};

type IssueClassification = enum {
    AmericanDepositaryShare = 0x41,
    Bond = 0x42,
    CommonStock = 0x43,
    DepositoryReceipt = 0x46,
    Sec144A = 0x49,
    LimitedPartnership = 0x4c,
    Notes = 0x4e,
    OrdinaryShare = 0x4f,
    PreferredStock = 0x50,
    OtherSecurities = 0x51,
    Right = 0x52,
    SharesOfBeneficialInterest = 0x53,
    ConvertibleDebenture = 0x54,
    Unit = 0x55,
    UnitsBenifInt = 0x56,
    Warrant = 0x57,
};

type IssueSubType = enum {
    PreferredTrustSecurities = 0x41,
    IndexBasedDerivative = 0x42,
    CommonShares = 0x43,
    GlobalDepositaryShares = 0x44,
    EtfPortfolioDepositaryReceipt = 0x45,
    Holdrs = 0x46,
    GlobalShares = 0x47,
    EtfIndexFundShares = 0x49,
    CorporateBackedTrustSecurity = 0x4a,
    ContingentLitigationRight = 0x4c,
    EquityBasedDerivative = 0x4d,
    NyRegistryShares = 0x4e,
    OpenEndedMutualFund = 0x4f,
    PrivatelyHeldSecurity = 0x50,
    ClosedEndFunds = 0x51,
    RegS = 0x52,
    Seed = 0x53,
    TrackingStock = 0x54,
    Portal = 0x55,
    ContingentValueRight = 0x56,
    TrustIssuedReceipts = 0x57,
    Trust = 0x58,
    Other = 0x59,
    NotApplicable = 0x5a,
};

type Authenticity = enum {
    LiveProduction = 0x50,
    Test = 0x54,
};

type ShortSaleThresholdIndicator = enum {
    Restricted = 0x59,
    NotRestricted = 0x4e,
    NotAvailable = 0x20,
};

type IpoFlag = enum {
    IpoSecurity = 0x59,
    NotIpo = 0x4e,
    NonIpoNewListed = 0x5a,
    NotAvailable = 0x20,
};

type LuldReferencePriceTier = enum {
    Tier1 = 0x31,
    Tier2 = 0x32,
    NotAvailable = 0x20,
};

type EtpFlag = enum {
    Etp = 0x59,
    NotEtp = 0x4e,
    NotAvailable = 0x20,
};

type InverseIndicator = enum {
    Inverse = 0x59,
    NotInverse = 0x4e,
};

type TradingState = enum {
    Halted = 0x48,
    Paused = 0x50,
    QuotationOnly = 0x51,
    Trading = 0x54,
};

type Reason = enum {
    ReasonNotAvailable = 0x20,
};

type RegShoAction = enum {
    NoPriceTest = 0x30,
    RestrictionInEffect = 0x31,
    RestrictionRemainsInEffect = 0x32,
};

type PrimaryMarketMaker = enum {
    PrimaryMarketMaker = 0x59,
    NonPrimaryMarketMaker = 0x4e,
};

type MarketMakerMode = enum {
    Normal = 0x4e,
    Passive = 0x50,
    Syndicate = 0x53,
    PreSyndicate = 0x52,
    Penalty = 0x4c,
};

type MarketParticipantState = enum {
    Active = 0x41,
    ExcusedWithdrawn = 0x45,
    Withdrawn = 0x57,
    Suspended = 0x53,
    Deleted = 0x44,
};

type BreachedLevel = enum {
    Level1 = 0x31,
    Level2 = 0x32,
    Level3 = 0x33,
};

type IpoQuotationReleaseQualifier = enum {
    AnticipatedQuotationReleaseTime = 0x41,
    IpoReleaseCanceledPostponed = 0x43,
};

type MarketCode = enum {
    Nasdaq = 0x51,
    NasdaqTexas = 0x42,
    Psx = 0x58,
};

type OperationalHaltAction = enum {
    OperationallyHalted = 0x48,
    TradingResumed = 0x54,
};

type MarketSide = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

type ImbalanceDirection = enum {
    BuyImbalance = 0x42,
    SellImbalance = 0x53,
    NoImbalance = 0x4e,
    InsufficientOrders = 0x4f,
    Paused = 0x50,
};

type CrossType = enum {
    NasdaqOpeningCross = 0x4f,
    NasdaqClosingCross = 0x43,
    CrossForIpoAndHaltedPausedSecurities = 0x48,
    ExtendedTradingClose = 0x41,
};

type PriceVariationIndicator = enum {
    LessThan1 = 0x4c,
    OneToOnePointNineNinePercent = 0x31,
    TwoToTwoPointNineNinePercent = 0x32,
    ThreeToThreePointNineNinePercent = 0x33,
    FourToFourPointNineNinePercent = 0x34,
    FiveToFivePointNineNinePercent = 0x35,
    SixToSixPointNineNinePercent = 0x36,
    SevenToSevenPointNineNinePercent = 0x37,
    EightToEightPointNineNinePercent = 0x38,
    NineToNinePointNineNinePercent = 0x39,
    TenToNineteenPointNineNinePercent = 0x41,
    TwentyToTwentyNinePointNineNinePercent = 0x42,
    ThirtyPercentOrGreater = 0x43,
    CannotBeCalculated = 0x20,
};

type InterestFlag = enum {
    BuySide = 0x42,
    SellSide = 0x53,
    BothSides = 0x41,
    NoRpiOrders = 0x4e,
};

type OpenEligibilityStatus = enum {
    NotEligible = 0x4e,
    Eligible = 0x59,
};

