};

type AccountQueryRequestMessage = unit {
    appendage_length: uint16;
    account_query_request_appendage: AccountQueryRequestAppendage[] &eod;
};

type AccountQueryRequestAppendage = unit {
    optional_field_length: int8;
    account_query_request_optional_field: int8 &convert=AccountQueryRequestOptionalField($$);
    account_query_request_optional_value: bytes &size=1;
};

