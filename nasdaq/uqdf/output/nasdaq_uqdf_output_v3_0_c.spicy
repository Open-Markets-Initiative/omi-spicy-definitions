module NasdaqUqdfOutputUtpV30C;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NasdaqUqdfOutputV30C = unit {
    udp_packet_header: UdpPacketHeader;
    messages: Message[self.udp_packet_header.message_count];
};

type UdpPacketHeader = unit {
    udp_session: bytes &size=10;
    udp_sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_category ) {
        0x51 -> quote_message: QuoteMessage;
        0x41 -> administrative_message: AdministrativeMessage;
        0x43 -> control_message: ControlMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    version: bytes &size=1;
    message_category: bytes &size=1;
};

type QuoteMessage = unit {
    quote_message_type: bytes &size=1;
    switch ( self.quote_message_type ) {
        0x45 -> utp_quote_shortform_message: UtpQuoteShortformMessage;
        0x46 -> utp_quote_longform_message: UtpQuoteLongformMessage;
        0x4d -> finra_adf_market_participant_quotation_message: FinraAdfMarketParticipantQuotationMessage;
        0x43 -> combined_quote_message_short_form_message: CombinedQuoteMessageShortFormMessage;
        0x44 -> combined_quote_message_long_form_message: CombinedQuoteMessageLongFormMessage;
        0x41 -> odd_lot_quote_message_short_form_message: OddLotQuoteMessageShortFormMessage;
        0x42 -> odd_lot_quote_message_long_form_message: OddLotQuoteMessageLongFormMessage;
        * -> unknown: bytes &eod;
    };
};

type UtpQuoteShortformMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    symbol_short: bytes &size=5;
    bid_price_short: uint16;
    bid_size_short: uint16;
    ask_price_short: uint16;
    ask_size_short: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    sip_generated_update_flag: uint8 &convert=SipGeneratedUpdateFlag($$);
    luld_bbo_indicator: uint8 &convert=LuldBboIndicator($$);
    retail_interest_indicator: uint8 &convert=RetailInterestIndicator($$);
    nbbo_appendage_indicator: uint8 &convert=NbboAppendageIndicator($$);
    luld_national_bbo_indicator: uint8 &convert=LuldNationalBboIndicator($$);
    national_bbo_appendage_shortform: NationalBboAppendageShortform;
    national_bbo_appendage_longform: NationalBboAppendageLongform;
};

type NationalBboAppendageShortform = unit {
    nbbo_quote_condition: bytes &size=1;
    national_best_bid_market_center: bytes &size=1;
    national_best_bid_price_short: uint16;
    national_best_bid_size_short: uint16;
    national_best_ask_market_center: bytes &size=1;
    national_best_ask_price_short: uint16;
    national_best_ask_size_short: uint16;
};

type NationalBboAppendageLongform = unit {
    nbbo_quote_condition: bytes &size=1;
    national_best_bid_market_center: bytes &size=1;
    national_best_bid_price_long: uint64;
    national_best_bid_size_long: uint32;
    national_best_ask_market_center: bytes &size=1;
    national_best_ask_price_long: uint64;
    national_best_ask_size_long: uint32;
};

type UtpQuoteLongformMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    timestamp_2: uint64;
    symbol_long: bytes &size=11;
    bid_price_long: uint64;
    bid_size_long: uint32;
    ask_price_long: uint64;
    ask_size_long: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    sip_generated_update_flag: uint8 &convert=SipGeneratedUpdateFlag($$);
    luld_bbo_indicator: uint8 &convert=LuldBboIndicator($$);
    retail_interest_indicator: uint8 &convert=RetailInterestIndicator($$);
    nbbo_appendage_indicator: uint8 &convert=NbboAppendageIndicator($$);
    luld_national_bbo_indicator: uint8 &convert=LuldNationalBboIndicator($$);
    finra_adf_mpid_appendage_indicator: uint8 &convert=FinraAdfMpidAppendageIndicator($$);
    national_bbo_appendage_shortform: NationalBboAppendageShortform;
    national_bbo_appendage_longform: NationalBboAppendageLongform;
};

type FinraAdfMarketParticipantQuotationMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    timestamp_2: uint64;
    symbol_long: bytes &size=11;
    bid_price_long: uint64;
    bid_size_long: uint32;
    ask_price_long: uint64;
    ask_size_long: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    finra_market_participant: bytes &size=4;
};

type CombinedQuoteMessageShortFormMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    symbol_short: bytes &size=5;
    protected_bid_price_short: uint16;
    protected_bid_size_short: uint16;
    protected_ask_price_short: uint16;
    protected_ask_size_short: uint16;
    quote_condition: uint8 &convert=QuoteCondition($$);
    sip_generated_update_flag: uint8 &convert=SipGeneratedUpdateFlag($$);
    luld_bbo_indicator: uint8 &convert=LuldBboIndicator($$);
    retail_interest_indicator: uint8 &convert=RetailInterestIndicator($$);
    nbbo_appendage_indicator: uint8 &convert=NbboAppendageIndicator($$);
    luld_national_bbo_indicator: uint8 &convert=LuldNationalBboIndicator($$);
    bolo_appendage_indicator: uint8 &convert=BoloAppendageIndicator($$);
    odd_lot_attachment_type: uint8 &convert=OddLotAttachmentType($$);
    odd_lot_attachment_count: uint16;
    national_bbo_appendage_shortform: NationalBboAppendageShortform;
    national_bbo_appendage_longform: NationalBboAppendageLongform;
    bolo_appendage_short_form: BoloAppendageShortForm;
    bolo_appendage_long_form: BoloAppendageLongForm;
    bolo_appendage_mpid_form: BoloAppendageMpidForm;
};

type BoloAppendageShortForm = unit {
    bolo_best_bid_market_center: bytes &size=1;
    bolo_bid_price_short: uint16;
    bolo_bid_size: uint16;
    bolo_best_ask_market_center: bytes &size=1;
    bolo_ask_price_short: uint16;
    bolo_ask_size: uint16;
};

type BoloAppendageLongForm = unit {
    bolo_best_bid_market_center: bytes &size=1;
    bolo_bid_price_long: uint64;
    bolo_bid_size: uint16;
    bolo_best_ask_market_center: bytes &size=1;
    bolo_ask_price_long: uint64;
    bolo_ask_size: uint16;
};

type BoloAppendageMpidForm = unit {
    bolo_best_bid_market_center: bytes &size=1;
    bolo_bid_price_long: uint64;
    bolo_bid_size: uint16;
    bolo_best_ask_market_center: bytes &size=1;
    bolo_ask_price_long: uint64;
    bolo_ask_size: uint16;
