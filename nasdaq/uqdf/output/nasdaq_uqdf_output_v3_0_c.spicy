    symbol_long: bytes &size=11;
    sip_generated_update_flag: uint8 &convert=SipGeneratedUpdateFlag($$);
    bolo_appendage_indicator: uint8 &convert=BoloAppendageIndicator($$);
    odd_lot_attachment_type: uint8 &convert=OddLotAttachmentType($$);
