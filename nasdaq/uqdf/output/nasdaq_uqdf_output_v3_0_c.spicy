    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
};

type QuoteWipeOutMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
};

type MarketCenterOriginator = enum {
    CboeByxExchangeInc = 0x59,
    CboeBzxExchangeInc = 0x5a,
    CboeEdgaExchangeInc = 0x4a,
    CboeEdgxExchangeInc = 0x4b,
    CboeExchangeInc = 0x57,
    NasdaqTexasLlc = 0x42,
    NasdaqPhlxLlc = 0x58,
    NasdaqInc = 0x51,
    NasdaqIseLlc = 0x49,
    NewYorkStockExchangeLlc = 0x4e,
    NyseArcaInc = 0x50,
    NyseAmericanLlc = 0x41,
    NyseNationalInc = 0x43,
    NyseTexas = 0x4d,
    TexasStockExchangeLlc = 0x46,
    N24XNationalExchangeLlc = 0x47,
    FinancialIndustryRegulatoryAuthority = 0x44,
    InvestorsExchangeLlc = 0x56,
    LongTermStockExchange = 0x4c,
    MiaxPearlLlc = 0x48,
    MemxLlc = 0x55,
    MarketIndependentGeneratedBySip = 0x45,
};

type SubMarketCenterId = enum {
    FinraNyseTrf = 0x4e,
    FinraNasdaqTrfCarteret = 0x51,
    FinraNasdaqTrfChicago = 0x42,
    TradeOriginatesFromFinraAlternativeDisplayFacility = 0x20,
};

type QuoteCondition = enum {
    ManualAskAutomatedBid = 0x41,
    ManualBidAutomatedAsk = 0x42,
    FastTrading = 0x46,
    ManualBidAndAsk = 0x48,
    OrderImbalance = 0x49,
    ClosedQuote = 0x4c,
    NonfirmQuote = 0x4e,
    OpeningQuoteAutomated = 0x4f,
    RegularTwosidedOpenQuoteAutomated = 0x52,
    ManualBidAndAskNonfirm = 0x55,
    OrderInflux = 0x58,
    AutomatedBidNoOfferOrAutomatedOfferNoBid = 0x59,
    NoOpenNoResume = 0x5a,
    IntradayAuction = 0x34,
};

type SipGeneratedUpdateFlag = enum {
    TransactionOriginatedFromMarketParticipant = 0x20,
    SiPgeneratedTransactionEgPriceBandChange = 0x45,
};

type LuldBboIndicator = enum {
    LimitUpLimitDownNotApplicable = 0x20,
    BidPriceAboveUpperLimitPriceBandBidIsNonExecutable = 0x41,
    AskPriceBelowLowerLimitPriceBandAskIsNonExecutable = 0x42,
    BidAndAskOutsidePriceBandNotExecutable = 0x43,
};

type RetailInterestIndicator = enum {
    RetailInterestNotApplicable = 0x20,
    RetailInterestOnBidQuote = 0x41,
    RetailInterestOnAskQuote = 0x42,
    RetailInterestOnBothBidAndAskQuote = 0x43,
};

type NbboAppendageIndicator = enum {
    NoNationalBboChange = 0x30,
    NoNationalBboCanBeCalculated = 0x31,
    ShortFormNationalBboAppendageAttached = 0x32,
    LongFormNationalBboAppendageAttached = 0x33,
    QuoteContainsAllNationalBboInformation = 0x34,
};

type LuldNationalBboIndicator = enum {
    LimitUpLimitDownNotApplicable = 0x20,
    NationalBestBidAndNationalBestAskAreExecutable = 0x41,
    NationalBestBidBelowLowerLimitPriceBandNonExecutable = 0x42,
    NationalBestAskAboveUpperLimitPriceBandNonExecutable = 0x43,
    NationalBestBidBelowLowerAndNationalBestAskAboveUpperLimitPriceBandsNonExecutable = 0x44,
    NationalBestBidEqualsUpperLimitPriceBandNationalBestBidIsInLimitState = 0x45,
    NationalBestOfferEqualsLowerLimitPriceBandNationalBestAskIsInLimitState = 0x46,
    NationalBestBidEqualsUpperLimitPriceBandInLimitStateAndNationalBestAskAboveUpperLimitPriceBandNonExecutable = 0x47,
    NationalBestAskEqualsLowerLimitPriceBandInLimitStateAndNationalBestBidBelowLowerLimitPriceBandNonExecutable = 0x48,
    NationalBestBidEqualsUpperLimitPriceBandAndNationalBestAskEqualsLowerLimitPriceBandCrossedNotInLimitState = 0x49,
};

type FinraAdfMpidAppendageIndicator = enum {
    NotApplicableQuotationOriginatesFromAUtpParticipantOtherThanFinra = 0x20,
    NoAdfMpidChangesCurrentAdfQuoteDoesNotAffectTheFinraMpid = 0x30,
    NoAdfMpidExistsNoCalculationOfTheFinraMpid = 0x31,
    AdfMpiDsAttachedFinraMpidWasGenerated = 0x32,
};

type BoloAppendageIndicator = enum {
    NoBoloChange = 0x30,
    NoBoloCanBeCalculated = 0x31,
    ShortFormBoloAppendageAttached = 0x32,
    LongFormBoloAppendageAttached = 0x33,
    MpidFormBoloAppendageAttached = 0x35,
};

type OddLotAttachmentType = enum {
    NoOddLotPriceLevelsAttached = 0x30,
    ShortFormOddLotPriceLevelsAttached = 0x32,
    LongFormOddLotPriceLevelsAttached = 0x33,
    MpidFormOddLotPriceLevelsAttached = 0x35,
};

type TradingActionCode = enum {
    TradingHalt = 0x48,
    QuotationResumptionIncludingAfterEma = 0x51,
    TradingResumption = 0x54,
    VolatilityTradingPause = 0x50,
};

type IssueType = enum {
