    collar_extension_indicator: bytes &size=1;
};

type SessionCloseRecapMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    symbol_long: bytes &size=11;
    national_best_bid_market_center: bytes &size=1;
    national_best_bid_price_long: uint64;
    national_best_bid_size: uint64;
    national_best_ask_market_center: bytes &size=1;
    national_best_ask_price_long: uint64;
    national_best_ask_size: uint64;
    special_condition: uint8 &convert=SpecialCondition($$);
    number_of_market_center_attachments: uint16;
    market_center_close_recap: MarketCenterCloseRecap[self.number_of_market_center_attachments];
};

type MarketCenterCloseRecap = unit {
    market_center_identifier: bytes &size=1;
    market_center_bid_price: uint64;
    market_center_bid_size: uint64;
    market_center_ask_price: uint64;
    market_center_ask_size: uint64;
};

type ControlMessage = unit {
    control_message_type: bytes &size=1;
    switch ( self.control_message_type ) {
        0x49 -> start_of_day_message: StartOfDayMessage;
        0x4a -> end_of_day_message: EndOfDayMessage;
        0x4f -> market_session_open_message: MarketSessionOpenMessage;
        0x43 -> market_session_close_message: MarketSessionCloseMessage;
        0x5a -> end_of_transmissions_message: EndOfTransmissionsMessage;
        0x50 -> quote_wipe_out_message: QuoteWipeOutMessage;
        * -> unknown: bytes &eod;
    };
};

type StartOfDayMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
};

type EndOfDayMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
};

