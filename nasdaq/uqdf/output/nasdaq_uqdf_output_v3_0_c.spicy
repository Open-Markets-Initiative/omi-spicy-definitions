    bolo_appendage_long_form: BoloAppendageLongForm;
    bolo_appendage_mpid_form: BoloAppendageMpidForm;
};

type AdministrativeMessage = unit {
    administrative_message_type: bytes &size=1;
    switch ( self.administrative_message_type ) {
        0x41 -> general_administrative_message: GeneralAdministrativeMessage;
        0x48 -> cross_sro_trading_action_message: CrossSroTradingActionMessage;
        0x4b -> market_center_trading_action_message: MarketCenterTradingActionMessage;
        0x42 -> issue_symbol_directory_message: IssueSymbolDirectoryMessage;
        0x56 -> reg_sho_short_sale_price_test_restricted_indicator_message: RegShoShortSalePriceTestRestrictedIndicatorMessage;
        0x50 -> limit_up_limit_down_price_band_message: LimitUpLimitDownPriceBandMessage;
        0x43 -> market_wide_circuit_breaker_decline_level_message: MarketWideCircuitBreakerDeclineLevelMessage;
        0x44 -> market_wide_circuit_breaker_status_message: MarketWideCircuitBreakerStatusMessage;
        0x45 -> auction_collar_message: AuctionCollarMessage;
        0x52 -> session_close_recap_message: SessionCloseRecapMessage;
        * -> unknown: bytes &eod;
    };
};

type GeneralAdministrativeMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    text_length: uint16;
    text: bytes &size=self.text_length;
};

type CrossSroTradingActionMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    symbol_long: bytes &size=11;
    trading_action_code: uint8 &convert=TradingActionCode($$);
    trading_action_sequence_number: uint32;
    action_time: uint64;
    reason_for_the_trading_action: bytes &size=6;
};

type MarketCenterTradingActionMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    symbol_long: bytes &size=11;
    trading_action_code: uint8 &convert=TradingActionCode($$);
    action_time: uint64;
    market_center_identifier: bytes &size=1;
};

type IssueSymbolDirectoryMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
    sub_market_center_id: uint8 &convert=SubMarketCenterId($$);
    sip_timestamp: uint64;
    timestamp_1: uint64;
    participant_token: uint64;
    symbol_long: bytes &size=11;
    old_symbol: bytes &size=11;
    issue_name: bytes &size=30;
    issue_type: uint8 &convert=IssueType($$);
    issue_subtype: bytes &size=2;
    market_tier: uint8 &convert=MarketTier($$);
    authenticity: uint8 &convert=Authenticity($$);
    short_sale_threshold_indicator: uint8 &convert=ShortSaleThresholdIndicator($$);
    round_lot_size: uint16;
    financial_status_indicator: uint8 &convert=FinancialStatusIndicator($$);
};

type RegShoShortSalePriceTestRestrictedIndicatorMessage = unit {
    market_center_originator: uint8 &convert=MarketCenterOriginator($$);
