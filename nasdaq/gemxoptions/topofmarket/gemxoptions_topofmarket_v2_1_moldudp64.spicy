module NasdaqGemxoptionsTopofmarketItchV21MoldUdp64;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type GemxoptionsTopofmarketV21 = unit {
    udp_packet_header: UdpPacketHeader;
    messages: Message[self.udp_packet_header.message_count];
};

type UdpPacketHeader = unit {
    udp_session: bytes &size=10;
    udp_sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::DerivativeDirectoryMessage -> derivative_directory_message: DerivativeDirectoryMessage;
        MessageType::TradingActionMessage -> trading_action_message: TradingActionMessage;
        MessageType::BestBidAndAskUpdateShortFormMessage -> best_bid_and_ask_update_short_form_message: BestBidAndAskUpdateShortFormMessage;
        MessageType::BestBidAndAskUpdateLongFormMessage -> best_bid_and_ask_update_long_form_message: BestBidAndAskUpdateLongFormMessage;
        MessageType::BestBidUpdateShortFormMessage -> best_bid_update_short_form_message: BestBidUpdateShortFormMessage;
        MessageType::BestAskUpdateShortFormMessage -> best_ask_update_short_form_message: BestAskUpdateShortFormMessage;
        MessageType::BestBidUpdateLongFormMessage -> best_bid_update_long_form_message: BestBidUpdateLongFormMessage;
        MessageType::BestAskUpdateLongFormMessage -> best_ask_update_long_form_message: BestAskUpdateLongFormMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type SystemEventMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    event_code: uint8 &convert=EventCode($$);
};

type DerivativeDirectoryMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    security_symbol: bytes &size=8;
    expiration_year: uint8;
    expiration_month: uint8;
    expiration_day: uint8;
    explicit_strike_price: uint32;
    option_type: uint8 &convert=OptionType($$);
    underlying_symbol: bytes &size=13;
    closing_type: uint8 &convert=ClosingType($$);
    tradable: uint8 &convert=Tradable($$);
    mpv: uint8 &convert=Mpv($$);
    reserved_16: bytes &size=16;
};

type TradingActionMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    current_trading_state: uint8 &convert=CurrentTradingState($$);
};

type BestBidAndAskUpdateShortFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    bid_market_order_size_short: uint16;
    bid_price_short: uint16;
    bid_size_short: uint16;
    bid_cust_size_short: uint16;
    bid_procust_size_short: uint16;
    ask_market_order_size_short: uint16;
    ask_price_short: uint16;
    ask_size_short: uint16;
    ask_cust_size_short: uint16;
    ask_procust_size_short: uint16;
};

type BestBidAndAskUpdateLongFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    bid_market_order_size_long: uint32;
    bid_price_long: uint32;
    bid_size_long: uint32;
    bid_cust_size_long: uint32;
    bid_procust_size_long: uint32;
    ask_market_order_size_long: uint32;
    ask_price_long: uint32;
    ask_size_long: uint32;
    ask_cust_size_long: uint32;
    ask_procust_size_long: uint32;
};

type BestBidUpdateShortFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    market_order_size_short: uint16;
    price_short: uint16;
    size_short: uint16;
    cust_size_short: uint16;
    procust_size_short: uint16;
};

type BestAskUpdateShortFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    market_order_size_short: uint16;
    price_short: uint16;
    size_short: uint16;
    cust_size_short: uint16;
    procust_size_short: uint16;
};

type BestBidUpdateLongFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    market_order_size_long: uint32;
    price_long: uint32;
    size_long: uint32;
    cust_size_long: uint32;
    procust_size_long: uint32;
};

type BestAskUpdateLongFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    instrument_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    market_order_size_long: uint32;
    price_long: uint32;
    size_long: uint32;
    cust_size_long: uint32;
    procust_size_long: uint32;
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    DerivativeDirectoryMessage = 0x6d,
    TradingActionMessage = 0x48,
    BestBidAndAskUpdateShortFormMessage = 0x71,
    BestBidAndAskUpdateLongFormMessage = 0x51,
    BestBidUpdateShortFormMessage = 0x62,
    BestAskUpdateShortFormMessage = 0x61,
    BestBidUpdateLongFormMessage = 0x42,
    BestAskUpdateLongFormMessage = 0x41,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfOpeningProcess = 0x51,
    StartOfNormalHoursClosingProcess = 0x4e,
    StartOfLateHoursClosingProcess = 0x4c,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
    EndOfWcoEarlyClosing = 0x57,
};

type OptionType = enum {
    Call = 0x43,
    Put = 0x50,
    NotApplicable = 0x4e,
};

type ClosingType = enum {
    NormalHours = 0x4e,
    LateHours = 0x4c,
    WcoEarlyClosing = 0x57,
};

type Tradable = enum {
    Tradable = 0x59,
    NotTradable = 0x4e,
};

type Mpv = enum {
    PennyEverywhere = 0x45,
    Scaled = 0x53,
    PennyPilot = 0x50,
};

type CurrentTradingState = enum {
    BuySideSuspended = 0x42,
    SellSideSuspended = 0x53,
    HaltInEffect = 0x48,
    ContinuousTrading = 0x54,
    PreOpen = 0x49,
    OpeningAuction = 0x4f,
    ReOpening = 0x52,
    Closed = 0x58,
};

type QuoteCondition = enum {
    RegularQuoteAutoxEligible = 0x20,
    AskSideNotFirmBidSideFirm = 0x58,
    BidSideNotFirmAskSideFirm = 0x59,
};

