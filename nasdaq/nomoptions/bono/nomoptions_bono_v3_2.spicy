module NasdaqNomoptionsBonoItchV32;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NomoptionsBonoV32 = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::TimestampMessage -> timestamp_message: TimestampMessage;
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::OptionsDirectoryMessage -> options_directory_message: OptionsDirectoryMessage;
        MessageType::TradingActionMessage -> trading_action_message: TradingActionMessage;
        MessageType::SecurityOpenClosedMessage -> security_open_closed_message: SecurityOpenClosedMessage;
        MessageType::ShortBestBidAndAskUpdateMessage -> short_best_bid_and_ask_update_message: ShortBestBidAndAskUpdateMessage;
        MessageType::LongBestBidAndAskUpdateMessage -> long_best_bid_and_ask_update_message: LongBestBidAndAskUpdateMessage;
        MessageType::ShortBestAskUpdateMessage -> short_best_ask_update_message: ShortBestAskUpdateMessage;
        MessageType::ShortBestBidUpdateMessage -> short_best_bid_update_message: ShortBestBidUpdateMessage;
        MessageType::LongBestAskUpdateMessage -> long_best_ask_update_message: LongBestAskUpdateMessage;
        MessageType::LongBestBidUpdateMessage -> long_best_bid_update_message: LongBestBidUpdateMessage;
        MessageType::TradeReportMessage -> trade_report_message: TradeReportMessage;
        MessageType::BrokenTradeReportMessage -> broken_trade_report_message: BrokenTradeReportMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type TimestampMessage = unit {
    second: uint32;
};

type SystemEventMessage = unit {
    nanoseconds: uint32;
    event_code: uint8 &convert=EventCode($$);
    version: uint8;
    subversion: uint8;
};

type OptionsDirectoryMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    security_symbol: bytes &size=6;
    expiration_year: uint8;
    expiration_month: uint8;
    expiration_day: uint8;
    strike_price: int32;
    option_type: uint8 &convert=OptionType($$);
    source: uint8;
    underlying_symbol: bytes &size=13;
    option_closing_type: uint8 &convert=OptionClosingType($$);
    tradable: uint8 &convert=Tradable($$);
    mpv: uint8 &convert=Mpv($$);
};

type TradingActionMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    current_trading_state: uint8 &convert=CurrentTradingState($$);
};

type SecurityOpenClosedMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    open_state: uint8 &convert=OpenState($$);
};

type ShortBestBidAndAskUpdateMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    bid_price_2: int16;
    bid_size_2: uint16;
    ask_price_2: int16;
    ask_size_2: uint16;
};

type LongBestBidAndAskUpdateMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    bid_price_4: int32;
    bid_size_4: uint32;
    ask_price_4: int32;
    ask_size_4: uint32;
};

type ShortBestAskUpdateMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    price_2: int16;
    size_2: uint16;
};

type ShortBestBidUpdateMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    price_2: int16;
    size_2: uint16;
};

type LongBestAskUpdateMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    price_4: int32;
    size_4: uint32;
};

type LongBestBidUpdateMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    quote_condition: uint8 &convert=QuoteCondition($$);
    price_4: int32;
    size_4: uint32;
};

type TradeReportMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    cross_id: uint32;
    trade_condition: bytes &size=1;
    price_4: int32;
    volume: uint32;
};

type BrokenTradeReportMessage = unit {
    nanoseconds: uint32;
    option_id: uint32;
    original_cross_id: uint32;
    original_price: int32;
    original_volume: uint32;
};

type MessageType = enum {
    TimestampMessage = 0x54,
    SystemEventMessage = 0x53,
    OptionsDirectoryMessage = 0x44,
    TradingActionMessage = 0x48,
    SecurityOpenClosedMessage = 0x4f,
    ShortBestBidAndAskUpdateMessage = 0x71,
    LongBestBidAndAskUpdateMessage = 0x51,
    ShortBestAskUpdateMessage = 0x61,
    ShortBestBidUpdateMessage = 0x62,
    LongBestAskUpdateMessage = 0x41,
    LongBestBidUpdateMessage = 0x42,
    TradeReportMessage = 0x52,
    BrokenTradeReportMessage = 0x58,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfOpeningProcess = 0x51,
    StartOfNormalHoursClosingProcess = 0x4e,
    StartOfLateHoursClosingProcess = 0x4c,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
};

type OptionType = enum {
    Call = 0x43,
    Put = 0x50,
};

type OptionClosingType = enum {
    Normal = 0x4e,
    Late = 0x4c,
};

type Tradable = enum {
    Tradable = 0x59,
    NotTradable = 0x4e,
};

type Mpv = enum {
    PennyEverywhere = 0x45,
    Scaled = 0x53,
    PennyPilot = 0x50,
};

type CurrentTradingState = enum {
    HaltInEffect = 0x48,
    Trading = 0x54,
};

type OpenState = enum {
    OpenForAutoExecution = 0x59,
    ClosedForAutoExecution = 0x4e,
};

type QuoteCondition = enum {
    RegularQuoteautoxEligible = 0x20,
    RotationalQuote = 0x52,
    BidSideFirm = 0x58,
    AskSideFirm = 0x59,
};

