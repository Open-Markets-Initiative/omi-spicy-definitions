module NasdaqNomoptionsIttoItchV32Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NomoptionsIttoV32 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket(self.server_packet_header.packet_length);
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit(packet_length: uint16) {
    debug_text: bytes &size=packet_length - 1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: uint8 &convert=RejectReasonCode($$);
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::SecondsMessage -> seconds_message: SecondsMessage;
        SequencedMessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        SequencedMessageType::BaseReferenceMessage -> base_reference_message: BaseReferenceMessage;
        SequencedMessageType::OptionsDirectoryMessage -> options_directory_message: OptionsDirectoryMessage;
        SequencedMessageType::OptionsTradingActionMessage -> options_trading_action_message: OptionsTradingActionMessage;
        SequencedMessageType::OptionOpenMessage -> option_open_message: OptionOpenMessage;
        SequencedMessageType::AddOrderMessageShortForm -> add_order_message_short_form: AddOrderMessageShortForm;
        SequencedMessageType::AddOrderMessageLongForm -> add_order_message_long_form: AddOrderMessageLongForm;
        SequencedMessageType::AddQuoteMessageShortForm -> add_quote_message_short_form: AddQuoteMessageShortForm;
        SequencedMessageType::AddQuoteMessageLongForm -> add_quote_message_long_form: AddQuoteMessageLongForm;
        SequencedMessageType::SingleSideExecutedMessage -> single_side_executed_message: SingleSideExecutedMessage;
        SequencedMessageType::SingleSideExecutedWithPriceMessage -> single_side_executed_with_price_message: SingleSideExecutedWithPriceMessage;
        SequencedMessageType::OrderCancelMessage -> order_cancel_message: OrderCancelMessage;
        SequencedMessageType::SingleSideReplaceMessageShortForm -> single_side_replace_message_short_form: SingleSideReplaceMessageShortForm;
        SequencedMessageType::SingleSideReplaceMessageLongForm -> single_side_replace_message_long_form: SingleSideReplaceMessageLongForm;
        SequencedMessageType::SingleSideDeleteMessage -> single_side_delete_message: SingleSideDeleteMessage;
        SequencedMessageType::SingleSideUpdateMessage -> single_side_update_message: SingleSideUpdateMessage;
        SequencedMessageType::QuoteReplaceMessageShortForm -> quote_replace_message_short_form: QuoteReplaceMessageShortForm;
        SequencedMessageType::QuoteReplaceMessageLongForm -> quote_replace_message_long_form: QuoteReplaceMessageLongForm;
        SequencedMessageType::QuoteDeleteMessage -> quote_delete_message: QuoteDeleteMessage;
        SequencedMessageType::BlockSingleSideDeleteMessage -> block_single_side_delete_message: BlockSingleSideDeleteMessage;
        SequencedMessageType::OptionsTradeNonAuctionMessage -> options_trade_non_auction_message: OptionsTradeNonAuctionMessage;
        SequencedMessageType::OptionsCrossTradeMessage -> options_cross_trade_message: OptionsCrossTradeMessage;
        SequencedMessageType::BrokenTradeOrOrderExecutionMessage -> broken_trade_or_order_execution_message: BrokenTradeOrOrderExecutionMessage;
        SequencedMessageType::NetOrderImbalanceIndicatorMessage -> net_order_imbalance_indicator_message: NetOrderImbalanceIndicatorMessage;
        * -> unknown: bytes &eod;
    };
};

type SecondsMessage = unit {
    second: uint32 &convert=interval($$);
};

type SystemEventMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    event_code: uint8 &convert=EventCode($$);
};

type BaseReferenceMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    base_reference_number: uint64;
};

type OptionsDirectoryMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    option_id: uint32;
    security_symbol: bytes &size=6;
    expiration_year: uint8;
    expiration_month: uint8;
    expiration_date: uint8;
    explicit_strike_price: uint32;
    option_type: uint8 &convert=OptionType($$);
    source: uint8;
    underlying_symbol: bytes &size=13;
    options_closing_type: uint8 &convert=OptionsClosingType($$);
    tradable: uint8 &convert=Tradable($$);
    mpv: uint8 &convert=Mpv($$);
};

type OptionsTradingActionMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    option_id: uint32;
    current_trading_state: uint8 &convert=CurrentTradingState($$);
};

type OptionOpenMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    option_id: uint32;
    open_state: uint8 &convert=OpenState($$);
};

type AddOrderMessageShortForm = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    order_reference_number_delta: uint32;
    market_side: uint8 &convert=MarketSide($$);
    option_id: uint32;
    price: uint16;
    volume: uint16;
};

type AddOrderMessageLongForm = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    order_reference_number_delta: uint32;
    market_side: uint8 &convert=MarketSide($$);
    option_id: uint32;
    price_long: uint32;
    volume_long: uint32;
};

type AddQuoteMessageShortForm = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    bid_reference_number_delta: uint32;
    ask_reference_number_delta: uint32;
    option_id: uint32;
    bid_price: uint16;
    bid_size: uint16;
    ask_price: uint16;
    ask_size: uint16;
};

type AddQuoteMessageLongForm = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    bid_reference_number_delta: uint32;
    ask_reference_number_delta: uint32;
    option_id: uint32;
    bid: uint32;
    bid_size_long: uint32;
    ask: uint32;
    ask_size_long: uint32;
};

type SingleSideExecutedMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    reference_number_delta: uint32;
    executed_contracts: uint32;
    cross_number: uint32;
    match_number: uint32;
};

type SingleSideExecutedWithPriceMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    reference_number_delta: uint32;
    cross_number: uint32;
    match_number: uint32;
    printable: uint8 &convert=Printable($$);
    price_long: uint32;
    volume_long: uint32;
};

type OrderCancelMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    order_reference_number_delta: uint32;
    cancelled_contracts: uint32;
};

type SingleSideReplaceMessageShortForm = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    original_reference_number_delta: uint32;
    new_reference_number_delta: uint32;
    price: uint16;
    volume: uint16;
};

type SingleSideReplaceMessageLongForm = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    original_reference_number_delta: uint32;
    new_reference_number_delta: uint32;
    price_long: uint32;
    volume_long: uint32;
};

type SingleSideDeleteMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    reference_number_delta: uint32;
};

type SingleSideUpdateMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    reference_number_delta: uint32;
    change_reason: uint8 &convert=ChangeReason($$);
    price_long: uint32;
    volume_long: uint32;
};

type QuoteReplaceMessageShortForm = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    original_bid_reference_number_delta: uint32;
    bid_reference_number_delta: uint32;
    original_ask_reference_number_delta: uint32;
    ask_reference_delta_number: uint32;
    bid_price: uint16;
    bid_size: uint16;
    ask_price: uint16;
    ask_size: uint16;
};

type QuoteReplaceMessageLongForm = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    original_bid_reference_number_delta: uint32;
    bid_reference_number_delta: uint32;
    original_ask_reference_number_delta: uint32;
    ask_reference_delta_number: uint32;
    bid_price_long: uint32;
    bid_size_long: uint32;
    ask_price_long: uint32;
    ask_size_long: uint32;
};

type QuoteDeleteMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    bid_reference_number_delta: uint32;
    ask_reference_number_delta: uint32;
};

type BlockSingleSideDeleteMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    total_number_of_reference_number_deltas: uint16;
    reference_number_deltas: ReferenceNumberDeltas[self.total_number_of_reference_number_deltas];
};

type ReferenceNumberDeltas = unit {
    reference_number_delta: uint32;
};

type OptionsTradeNonAuctionMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    option_id: uint32;
    cross_number: uint32;
    match_number: uint32;
    price_long: uint32;
    volume_long: uint32;
};

type OptionsCrossTradeMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    option_id: uint32;
    cross_number: uint32;
    match_number: uint32;
    cross_type: uint8 &convert=CrossType($$);
    price_long: uint32;
    volume_long: uint32;
};

type BrokenTradeOrOrderExecutionMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    cross_number: uint32;
    match_number: uint32;
};

type NetOrderImbalanceIndicatorMessage = unit {
    nanoseconds: uint32 &convert=interval_ns($$);
    auction_id: uint32;
    auction_type: uint8 &convert=AuctionType($$);
    paired_contracts: uint32;
    imbalance_direction: uint8 &convert=ImbalanceDirection($$);
    option_id: uint32;
    imbalance_price: uint32;
    imbalance_volume: uint32;
    customer_firm_indicator: uint8 &convert=CustomerFirmIndicator($$);
    reserved_3: bytes &size=3;
};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
    EndOfSessionPacket = 0x5a,
};

type RejectReasonCode = enum {
    NotAuthorized = 0x41,
    SessionNotAvailable = 0x53,
};

type SequencedMessageType = enum {
    SecondsMessage = 0x54,
    SystemEventMessage = 0x53,
    BaseReferenceMessage = 0x4c,
    OptionsDirectoryMessage = 0x52,
    OptionsTradingActionMessage = 0x48,
    OptionOpenMessage = 0x4f,
    AddOrderMessageShortForm = 0x61,
    AddOrderMessageLongForm = 0x41,
    AddQuoteMessageShortForm = 0x6a,
    AddQuoteMessageLongForm = 0x4a,
    SingleSideExecutedMessage = 0x45,
    SingleSideExecutedWithPriceMessage = 0x43,
    OrderCancelMessage = 0x58,
    SingleSideReplaceMessageShortForm = 0x75,
    SingleSideReplaceMessageLongForm = 0x55,
    SingleSideDeleteMessage = 0x44,
    SingleSideUpdateMessage = 0x47,
    QuoteReplaceMessageShortForm = 0x6b,
    QuoteReplaceMessageLongForm = 0x4b,
    QuoteDeleteMessage = 0x59,
    BlockSingleSideDeleteMessage = 0x5a,
    OptionsTradeNonAuctionMessage = 0x50,
    OptionsCrossTradeMessage = 0x51,
    BrokenTradeOrOrderExecutionMessage = 0x42,
    NetOrderImbalanceIndicatorMessage = 0x49,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfOpeningProcess = 0x51,
    EndOfNormalHoursProcessing = 0x4e,
    EndOfLateHoursProcessing = 0x4c,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
};

type OptionType = enum {
    CallOption = 0x43,
    PutOption = 0x50,
};

type OptionsClosingType = enum {
    NormalHours = 0x4e,
    LateHours = 0x4c,
};

type Tradable = enum {
    OptionIsTradable = 0x59,
    OptionIsNotTradable = 0x4e,
};

type Mpv = enum {
    PennyEverywhere = 0x45,
    Scaled = 0x53,
    PennyPilot = 0x50,
};

type CurrentTradingState = enum {
    HaltInEffect = 0x48,
    TradingOnNasdaq = 0x54,
    BuySideTradingSuspended = 0x42,
    SellSideTradingSuspended = 0x53,
};

type OpenState = enum {
    OpenForAutoExecution = 0x59,
    ClosedForAutoExecution = 0x4e,
};

type MarketSide = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type Printable = enum {
    NonPrintable = 0x4e,
    Printable_x59 = 0x59,
};

type ChangeReason = enum {
    User = 0x55,
    Reprice = 0x52,
    Suspend = 0x53,
};

type BuySellIndicator = enum {
    BuyOrder = 0x42,
    SellOrder = 0x53,
};

type CrossType = enum {
    NasdaqOpeningReopeningAuction = 0x4f,
    PriceImprovementAuction = 0x50,
};

type AuctionType = enum {
    Opening = 0x4f,
    Reopening = 0x52,
    PriceImprovementAuction = 0x50,
    OrderExposure = 0x49,
};

type ImbalanceDirection = enum {
    BuyImbalance = 0x42,
    SellImbalance = 0x53,
};

type CustomerFirmIndicator = enum {
    Customer = 0x43,
    FirmJointBackOffice = 0x46,
    OnFloorMarketMaker = 0x4d,
    ProfessionalCustomer = 0x50,
    BrokerDealer = 0x42,
};

