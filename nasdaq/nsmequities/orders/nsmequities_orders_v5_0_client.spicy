module NasdaqNsmequitiesOrdersOuchV50Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesOrdersV50 = unit {
    client_soup_bin_tcp_packet: ClientSoupBinTcpPacket[] &eod;
};

type ClientSoupBinTcpPacket = unit {
    client_packet_header: ClientPacketHeader;
    switch ( self.client_packet_header.client_packet_type ) {
        ClientPacketType::DebugPacket -> debug_packet: DebugPacket;
        ClientPacketType::LoginRequestPacket -> login_request_packet: LoginRequestPacket;
        ClientPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ClientPacketHeader = unit {
    packet_length: uint16;
    client_packet_type: uint8 &convert=ClientPacketType($$);
};

type DebugPacket = unit {
    text: bytes &size=1;
};

type LoginRequestPacket = unit {
    username: bytes &size=6;
    password: bytes &size=10;
    requested_session: bytes &size=10;
    requested_sequence_number: bytes &size=20;
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: uint8 &convert=UnsequencedMessageType($$);
    switch ( self.unsequenced_message_type ) {
        UnsequencedMessageType::EnterOrderMessage -> enter_order_message: EnterOrderMessage;
        UnsequencedMessageType::ReplaceOrderMessage -> replace_order_message: ReplaceOrderMessage;
        UnsequencedMessageType::CancelOrderMessage -> cancel_order_message: CancelOrderMessage;
        UnsequencedMessageType::ModifyOrderMessage -> modify_order_message: ModifyOrderMessage;
        * -> unknown: bytes &eod;
    };
};

type EnterOrderMessage = unit {
    user_ref_num: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    symbol: bytes &size=8;
    price: uint64;
    time_in_force: uint8 &convert=TimeInForce($$);
    display: uint8 &convert=Display($$);
    capacity: uint8 &convert=Capacity($$);
    inter_market_sweep_eligibility: uint8 &convert=InterMarketSweepEligibility($$);
    cross_type: uint8 &convert=CrossType($$);
    clordid: bytes &size=14;
    appendage_length: uint16;
    enter_order_appendage: EnterOrderAppendage[] &eod;
};

type EnterOrderAppendage = unit {
    optional_field_length: int8;
    enter_order_optional_field: int8 &convert=EnterOrderOptionalField($$);
    enter_order_optional_value: bytes &size=13;
};

type ReplaceOrderMessage = unit {
    orig_user_ref_num: uint32;
    user_ref_num: uint32;
    quantity: uint32;
    price: uint64;
    time_in_force: uint8 &convert=TimeInForce($$);
    display: uint8 &convert=Display($$);
    inter_market_sweep_eligibility: uint8 &convert=InterMarketSweepEligibility($$);
    clordid: bytes &size=14;
    appendage_length: uint16;
    replace_order_appendage: ReplaceOrderAppendage[] &eod;
};

type ReplaceOrderAppendage = unit {
    optional_field_length: int8;
    replace_order_optional_field: int8 &convert=ReplaceOrderOptionalField($$);
    replace_order_optional_value: bytes &size=16;
};

type CancelOrderMessage = unit {
    user_ref_num: uint32;
    quantity: uint32;
};

type ModifyOrderMessage = unit {
    user_ref_num: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint32;
};

type ClientPacketType = enum {
    DebugPacket = 0x2b,
    LoginRequestPacket = 0x4c,
    UnsequencedDataPacket = 0x55,
    ClientHeartbeatPacket = 0x52,
    LogoutRequestPacket = 0x4f,
};

type UnsequencedMessageType = enum {
    EnterOrderMessage = 0x4f,
    ReplaceOrderMessage = 0x55,
    CancelOrderMessage = 0x58,
    ModifyOrderMessage = 0x4d,
    AccountQueryMessage = 0x51,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
    SellShort = 0x54,
    SellShortExempt = 0x45,
};

type TimeInForce = enum {
    Day = 0x30,
    Ioc = 0x33,
    GtxExtendedHours = 0x35,
    Gtt = 0x36,
    AfterHours = 0x45,
};

type Display = enum {
    Attributable = 0x41,
    Visible = 0x59,
    Hidden = 0x4e,
    PostOnly = 0x50,
    ImbalanceOnly = 0x49,
    MidPointPeg = 0x4d,
    MidPointPegPostOnly = 0x57,
    PostOnlyAndAttributable = 0x4c,
    RetailOrderType1 = 0x4f,
    RetailOrderType2 = 0x54,
    RetailPriceImprovementOrder = 0x51,
    Conformant = 0x5a,
    MidPointPegAndMidPointTradeNow = 0x6d,
    NonDisplayAndMidPoint = 0x6e,
};

type Capacity = enum {
    Other = 0x4f,
    Agency = 0x41,
    Principal = 0x50,
    Riskless = 0x52,
};

type InterMarketSweepEligibility = enum {
    Eligible = 0x59,
    NotEligible = 0x4e,
};

type CrossType = enum {
    ContinuousMarket = 0x4e,
    OpeningCross = 0x4f,
    Closing = 0x43,
    HaltIpo = 0x48,
    Supplemental = 0x53,
    Retail = 0x52,
    Extended = 0x45,
    AfterHoursClose = 0x41,
};

type EnterOrderOptionalField = enum {
    Firm = 2,
    Minqty = 3,
    Customertype = 4,
    Maxfloor = 5,
};

type ReplaceOrderOptionalField = enum {
    Minqty = 3,
    Maxfloor = 5,
    Pricetype = 6,
    Postonly = 12,
    Expiretime = 15,
    Tradenow = 16,
    Handleinst = 17,
};

