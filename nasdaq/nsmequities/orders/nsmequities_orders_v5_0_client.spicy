module NasdaqNsmequitiesOrdersOuchV50Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesOrdersV50 = unit {
    client_soup_bin_tcp_packet: ClientSoupBinTcpPacket[] &eod;
};

type ClientSoupBinTcpPacket = unit {
    client_packet_header: ClientPacketHeader;
    switch ( self.client_packet_header.client_packet_type ) {
        ClientPacketType::DebugPacket -> debug_packet: DebugPacket(self.client_packet_header.packet_length);
        ClientPacketType::LoginRequestPacket -> login_request_packet: LoginRequestPacket;
        ClientPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ClientPacketHeader = unit {
    packet_length: uint16;
    client_packet_type: uint8 &convert=ClientPacketType($$);
};

type DebugPacket = unit(packet_length: uint16) {
    debug_text: bytes &size=packet_length - 1;
};

type LoginRequestPacket = unit {
    username: bytes &size=6;
    password: bytes &size=10;
    requested_session: bytes &size=10;
    requested_sequence_number: bytes &size=20;
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: uint8 &convert=UnsequencedMessageType($$);
    switch ( self.unsequenced_message_type ) {
        UnsequencedMessageType::EnterOrderMessage -> enter_order_message: EnterOrderMessage;
        UnsequencedMessageType::ReplaceOrderMessage -> replace_order_message: ReplaceOrderMessage;
        UnsequencedMessageType::CancelOrderMessage -> cancel_order_message: CancelOrderMessage;
        UnsequencedMessageType::ModifyOrderMessage -> modify_order_message: ModifyOrderMessage;
        UnsequencedMessageType::AccountQueryMessage -> account_query_message: AccountQueryMessage;
        UnsequencedMessageType::MassCancelRequestMessage -> mass_cancel_request_message: MassCancelRequestMessage;
        UnsequencedMessageType::DisableOrderEntryRequestMessage -> disable_order_entry_request_message: DisableOrderEntryRequestMessage;
        UnsequencedMessageType::EnableOrderEntryRequestMessage -> enable_order_entry_request_message: EnableOrderEntryRequestMessage;
        * -> unknown: bytes &eod;
    };
};

type EnterOrderMessage = unit {
    user_ref_num: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    symbol: bytes &size=8;
    price: uint64;
    time_in_force: uint8 &convert=TimeInForce($$);
    display: uint8 &convert=Display($$);
    capacity: uint8 &convert=Capacity($$);
    inter_market_sweep_eligibility: uint8 &convert=InterMarketSweepEligibility($$);
    cross_type: uint8 &convert=CrossType($$);
    clordid: bytes &size=14;
    appendage_length: uint16;
    enter_order_appendage: EnterOrderAppendage[self.appendage_length];
};

type EnterOrderAppendage = unit {
    optional_field_length: uint8;
    enter_order_optional_field: uint8 &convert=EnterOrderOptionalField($$);
    enter_order_optional_value: bytes &size=53;
};

type ReplaceOrderMessage = unit {
    orig_user_ref_num: uint32;
    user_ref_num: uint32;
    quantity: uint32;
    price: uint64;
    time_in_force: uint8 &convert=TimeInForce($$);
    display: uint8 &convert=Display($$);
    inter_market_sweep_eligibility: uint8 &convert=InterMarketSweepEligibility($$);
    clordid: bytes &size=14;
    appendage_length: uint16;
    replace_order_appendage: ReplaceOrderAppendage[self.appendage_length];
};

type ReplaceOrderAppendage = unit {
    optional_field_length: uint8;
    replace_order_optional_field: uint8 &convert=ReplaceOrderOptionalField($$);
    replace_order_optional_value: bytes &size=47;
};

type CancelOrderMessage = unit {
    user_ref_num: uint32;
    quantity: uint32;
    appendage_length: uint16;
    cancel_order_appendage: CancelOrderAppendage[self.appendage_length];
};

type CancelOrderAppendage = unit {
    optional_field_length: uint8;
    cancel_order_optional_field: uint8 &convert=CancelOrderOptionalField($$);
    cancel_order_optional_value: bytes &size=1;
};

type ModifyOrderMessage = unit {
    user_ref_num: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    appendage_length: uint16;
    modify_order_appendage: ModifyOrderAppendage[self.appendage_length];
};

type ModifyOrderAppendage = unit {
    optional_field_length: uint8;
    modify_order_optional_field: uint8 &convert=ModifyOrderOptionalField($$);
    modify_order_optional_value: bytes &size=6;
};

type AccountQueryMessage = unit {
    appendage_length: uint16;
    account_query_appendage: AccountQueryAppendage[self.appendage_length];
};

type AccountQueryAppendage = unit {
    optional_field_length: uint8;
    account_query_optional_field: uint8 &convert=AccountQueryOptionalField($$);
    account_query_optional_value: bytes &size=1;
};

type MassCancelRequestMessage = unit {
    user_ref_num: uint32;
    firm: bytes &size=4;
    symbol: bytes &size=8;
    appendage_length: uint16;
    mass_cancel_request_appendage: MassCancelRequestAppendage[self.appendage_length];
};

type MassCancelRequestAppendage = unit {
    optional_field_length: uint8;
    mass_cancel_request_optional_field: uint8 &convert=MassCancelRequestOptionalField($$);
    mass_cancel_request_optional_value: bytes &size=4;
};

type DisableOrderEntryRequestMessage = unit {
    user_ref_num: uint32;
    firm: bytes &size=4;
    appendage_length: uint16;
    disable_order_entry_request_appendage: DisableOrderEntryRequestAppendage[self.appendage_length];
};

type DisableOrderEntryRequestAppendage = unit {
    optional_field_length: uint8;
    disable_order_entry_request_optional_field: uint8 &convert=DisableOrderEntryRequestOptionalField($$);
    disable_order_entry_request_optional_value: bytes &size=1;
};

type EnableOrderEntryRequestMessage = unit {
    user_ref_num: uint32;
    firm: bytes &size=4;
    appendage_length: uint16;
    enable_order_entry_request_appendage: EnableOrderEntryRequestAppendage[self.appendage_length];
};

type EnableOrderEntryRequestAppendage = unit {
    optional_field_length: uint8;
    enable_order_entry_request_optional_field: uint8 &convert=EnableOrderEntryRequestOptionalField($$);
    enable_order_entry_request_optional_value: bytes &size=1;
};

type ClientPacketType = enum {
    DebugPacket = 0x2b,
    LoginRequestPacket = 0x4c,
    UnsequencedDataPacket = 0x55,
    ClientHeartbeatPacket = 0x52,
    LogoutRequestPacket = 0x4f,
};

type UnsequencedMessageType = enum {
    EnterOrderMessage = 0x4f,
    ReplaceOrderMessage = 0x55,
    CancelOrderMessage = 0x58,
    ModifyOrderMessage = 0x4d,
    AccountQueryMessage = 0x51,
    MassCancelRequestMessage = 0x43,
    DisableOrderEntryRequestMessage = 0x44,
    EnableOrderEntryRequestMessage = 0x45,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
    SellShort = 0x54,
    SellShortExempt = 0x45,
};

type TimeInForce = enum {
    Day = 0x30,
    Ioc = 0x33,
    GtxExtendedHours = 0x35,
    Gtt = 0x36,
    AfterHours = 0x45,
};

type Display = enum {
    Attributable = 0x41,
    Visible = 0x59,
    Hidden = 0x4e,
    Conformant = 0x5a,
};

type Capacity = enum {
    Other = 0x4f,
    Agency = 0x41,
    Principal = 0x50,
    Riskless = 0x52,
};

type InterMarketSweepEligibility = enum {
    Eligible = 0x59,
    NotEligible = 0x4e,
};

type CrossType = enum {
    ContinuousMarket = 0x4e,
    OpeningCross = 0x4f,
    ClosingCross = 0x43,
    HaltIpo = 0x48,
    Supplemental = 0x53,
    Retail = 0x52,
    ExtendedLife = 0x45,
    AfterHoursClose = 0x41,
};

type EnterOrderOptionalField = enum {
    Firm = 2,
    Minqty = 3,
    Customertype = 4,
    Maxfloor = 5,
    Pricetype = 6,
    Pegoffset = 7,
    Discretionprice = 9,
    Discretionpricetype = 10,
    Discretionpegoffset = 11,
    Postonly = 12,
    Randomreserves = 13,
    Expiretime = 15,
    Tradenow = 16,
    Handleinst = 17,
    GroupId = 24,
    SharesLocated = 25,
    LocateBroker = 26,
    Userrefidx = 28,
    AiqStrategy = 29,
    AiqGroupId = 30,
};

type CustomerType = enum {
    RetailDesignatedOrder = 0x52,
    NotRetailDesignated = 0x4e,
};

type PriceType = enum {
    Limit = 0x4c,
    MarketPeg = 0x50,
    MidpointPeg = 0x4d,
    PrimaryPeg = 0x52,
    MarketMakerPeg = 0x51,
    Midpoint = 0x6d,
};

type DiscretionPriceType = enum {
    Limit = 0x4c,
    MarketPeg = 0x50,
    MidpointPeg = 0x4d,
    PrimaryPeg = 0x52,
};

type PostOnly = enum {
    PostOnly_x50 = 0x50,
    No = 0x4e,
};

type TradeNow = enum {
    Yes = 0x59,
    No = 0x4e,
};

type HandleInst = enum {
    ImbalanceOnly = 0x49,
    RetailOrderType1 = 0x4f,
    RetailOrderType2 = 0x54,
    RetailPriceImprovement = 0x51,
    ExtendedLifeContinuous = 0x42,
    DirectListingCapitalRaise = 0x44,
};

type SharesLocated = enum {
    Yes = 0x59,
    No = 0x4e,
};

type AiqStrategy = enum {
    UsePortDefault = 0x2a,
    Disabled = 0x4e,
    FirmLevelDecrementBothNoDetails = 0x59,
    FirmLevelDecrementBoth = 0x44,
    FirmLevelCancelOldest = 0x4f,
    FirmLevelCancelNewest = 0x57,
    FirmLevelUseRemover = 0x52,
    OrganizationLevelDecrementBothNoDetails = 0x79,
    OrganizationLevelDecrementBoth = 0x64,
    OrganizationLevelCancelOldest = 0x6f,
    OrganizationLevelCancelNewest = 0x77,
    OrganizationLevelUseRemover = 0x72,
    AffiliateLevelDecrementBothNoDetails = 0x5a,
    AffiliateLevelDecrementBoth = 0x45,
    AffiliateLevelCancelOldest = 0x50,
    AffiliateLevelCancelNewest = 0x58,
    AffiliateLevelUseRemover = 0x53,
    MatchAnyLevelDecrementBothNoDetails = 0x30,
    MatchAnyLevelDecrementBoth = 0x31,
    MatchAnyLevelCancelOldest = 0x32,
    MatchAnyLevelCancelNewest = 0x34,
    MatchAnyLevelUseRemover = 0x35,
};

type ReplaceOrderOptionalField = enum {
    Minqty = 3,
    Maxfloor = 5,
    Pricetype = 6,
    Postonly = 12,
    Expiretime = 15,
    Tradenow = 16,
    Handleinst = 17,
    Randomreserves = 13,
