module NasdaqNsmequitiesOrdersOuchV50Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesOrdersV50 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket(self.server_packet_header.packet_length);
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit(packet_length: uint16) {
    debug_text: bytes &size=packet_length - 1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: uint8 &convert=RejectReasonCode($$);
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        SequencedMessageType::OrderAcceptedMessage -> order_accepted_message: OrderAcceptedMessage;
        SequencedMessageType::ReplacedMessage -> replaced_message: ReplacedMessage;
        SequencedMessageType::CanceledMessage -> canceled_message: CanceledMessage;
        SequencedMessageType::AiqCanceledMessage -> aiq_canceled_message: AiqCanceledMessage;
        SequencedMessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        SequencedMessageType::BrokenTradeMessage -> broken_trade_message: BrokenTradeMessage;
        SequencedMessageType::RejectedOrderMessage -> rejected_order_message: RejectedOrderMessage;
        SequencedMessageType::CancelPendingMessage -> cancel_pending_message: CancelPendingMessage;
        SequencedMessageType::CancelRejectMessage -> cancel_reject_message: CancelRejectMessage;
        SequencedMessageType::OrderPriorityUpdateMessage -> order_priority_update_message: OrderPriorityUpdateMessage;
        SequencedMessageType::OrderModifiedMessage -> order_modified_message: OrderModifiedMessage;
        SequencedMessageType::OrderRestatedMessage -> order_restated_message: OrderRestatedMessage;
        SequencedMessageType::AccountQueryResponseMessage -> account_query_response_message: AccountQueryResponseMessage;
        SequencedMessageType::MassCancelResponseMessage -> mass_cancel_response_message: MassCancelResponseMessage;
        SequencedMessageType::DisableOrderEntryResponseMessage -> disable_order_entry_response_message: DisableOrderEntryResponseMessage;
        SequencedMessageType::EnableOrderEntryResponseMessage -> enable_order_entry_response_message: EnableOrderEntryResponseMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemEventMessage = unit {
    timestamp: uint64;
    event_code: uint8 &convert=EventCode($$);
};

type OrderAcceptedMessage = unit {
    timestamp: uint64;
    user_ref_num: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    symbol: bytes &size=8;
    price: uint64;
    time_in_force: uint8 &convert=TimeInForce($$);
    display: uint8 &convert=Display($$);
    order_reference_number: uint64;
    capacity: uint8 &convert=Capacity($$);
    inter_market_sweep_eligibility: uint8 &convert=InterMarketSweepEligibility($$);
    cross_type: uint8 &convert=CrossType($$);
    order_state: uint8 &convert=OrderState($$);
    clordid: bytes &size=14;
    appendage_length: uint16;
    order_accepted_appendage: OrderAcceptedAppendage[self.appendage_length];
};

type OrderAcceptedAppendage = unit {
    optional_field_length: uint8;
    order_accepted_optional_field: uint8 &convert=OrderAcceptedOptionalField($$);
    order_accepted_optional_value: bytes &size=54;
};

type ReplacedMessage = unit {
    timestamp: uint64;
    orig_user_ref_num: uint32;
    user_ref_num: uint32;
    side: uint8 &convert=Side($$);
    quantity: uint32;
    symbol: bytes &size=8;
    price: uint64;
    time_in_force: uint8 &convert=TimeInForce($$);
    display: uint8 &convert=Display($$);
    order_reference_number: uint64;
    capacity: uint8 &convert=Capacity($$);
    inter_market_sweep_eligibility: uint8 &convert=InterMarketSweepEligibility($$);
    cross_type: uint8 &convert=CrossType($$);
    order_state: uint8 &convert=OrderState($$);
    clordid: bytes &size=14;
    appendage_length: uint16;
    replaced_message_appendage: ReplacedMessageAppendage[self.appendage_length];
};

type ReplacedMessageAppendage = unit {
    optional_field_length: uint8;
    replaced_message_optional_field: uint8 &convert=ReplacedMessageOptionalField($$);
    replaced_message_optional_value: bytes &size=25;
};

type CanceledMessage = unit {
    timestamp: uint64;
    user_ref_num: uint32;
    quantity: uint32;
    cancel_order_reason: uint8 &convert=CancelOrderReason($$);
    appendage_length: uint16;
    canceled_message_appendage: CanceledMessageAppendage[self.appendage_length];
};

type CanceledMessageAppendage = unit {
    optional_field_length: uint8;
