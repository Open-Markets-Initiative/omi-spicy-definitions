    execution_price: uint64;
    liquidity_flag: uint8 &convert=LiquidityFlag($$);
    aiq_strategy: uint8 &convert=AiqStrategy($$);
    appendage_length: uint16;
    aiq_canceled_appendage: AiqCanceledAppendage[self.appendage_length];
};

type AiqCanceledAppendage = unit {
    optional_field_length: uint8;
    aiq_canceled_optional_field: uint8 &convert=AiqCanceledOptionalField($$);
    aiq_canceled_optional_value: bytes &size=1;
};

