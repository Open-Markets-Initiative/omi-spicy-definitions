module NasdaqNsmequitiesNoiviewItchV2120111101;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesNoiviewV2120111101 = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence: uint32;
    count: uint16 &byte-order=spicy::ByteOrder::Little;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::StockDirectoryMessage -> stock_directory_message: StockDirectoryMessage;
        MessageType::StockTradingActionMessage -> stock_trading_action_message: StockTradingActionMessage;
        MessageType::RegShoRestrictionMessage -> reg_sho_restriction_message: RegShoRestrictionMessage;
        MessageType::NoiiMessage -> noii_message: NoiiMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    length: uint16;
    timestamp: bytes &size=8;
    message_type: uint8 &convert=MessageType($$);
};

type SystemEventMessage = unit {
    event_code: uint8 &convert=EventCode($$);
};

type StockDirectoryMessage = unit {
    stock: bytes &size=8;
    market_category: uint8 &convert=MarketCategory($$);
    financial_status_indicator: uint8 &convert=FinancialStatusIndicator($$);
    round_lot_size: bytes &size=6;
    round_lots_only: uint8 &convert=RoundLotsOnly($$);
};

type StockTradingActionMessage = unit {
    stock: bytes &size=8;
    current_trading_state: uint8 &convert=CurrentTradingState($$);
    reason: bytes &size=4;
};

type RegShoRestrictionMessage = unit {
    stock: bytes &size=8;
    reg_sho_action: uint8 &convert=RegShoAction($$);
};

type NoiiMessage = unit {
    paired_shares: bytes &size=9;
    imbalance_shares: bytes &size=9;
    imbalance_direction: uint8 &convert=ImbalanceDirection($$);
    stock: bytes &size=8;
    far_price: bytes &size=10;
    near_price: bytes &size=10;
    current_reference_price: bytes &size=10;
    cross_type: uint8 &convert=CrossType($$);
    price_variation_indicator: uint8 &convert=PriceVariationIndicator($$);
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    StockDirectoryMessage = 0x52,
    StockTradingActionMessage = 0x48,
    RegShoRestrictionMessage = 0x59,
    NoiiMessage = 0x49,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfMarketHours = 0x51,
    ClearNoiiOpeningCrossData = 0x58,
    EndOfMarketHours = 0x4d,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
};

type MarketCategory = enum {
    NewYorkStockExchangeNyse = 0x4e,
    NyseAmex = 0x41,
