module NasdaqNsmequitiesNlsplusItchV30;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesNlsplusV30 = unit {
    packet_header: PacketHeader;
    messages: Message[self.packet_header.message_count];
};

type PacketHeader = unit {
    session: bytes &size=10;
    sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::TradeReportMessage -> trade_report_message: TradeReportMessage;
        MessageType::LongFormTradeReportMessage -> long_form_trade_report_message: LongFormTradeReportMessage;
        MessageType::NextSharesTradeReportMessage -> next_shares_trade_report_message: NextSharesTradeReportMessage;
        MessageType::TradeCancelErrorMessage -> trade_cancel_error_message: TradeCancelErrorMessage;
        MessageType::LongFormTradeCancelErrorMessage -> long_form_trade_cancel_error_message: LongFormTradeCancelErrorMessage;
        MessageType::NextSharesTradeCancelErrorMessage -> next_shares_trade_cancel_error_message: NextSharesTradeCancelErrorMessage;
        MessageType::TradeCorrectionMessage -> trade_correction_message: TradeCorrectionMessage;
        MessageType::LongFormTradeCorrectionMessage -> long_form_trade_correction_message: LongFormTradeCorrectionMessage;
        MessageType::NextSharesTradeCorrectionMessage -> next_shares_trade_correction_message: NextSharesTradeCorrectionMessage;
        MessageType::StockTradingActionMessage -> stock_trading_action_message: StockTradingActionMessage;
        MessageType::StockDirectoryMessage -> stock_directory_message: StockDirectoryMessage;
        MessageType::RegShoShortSalePriceTestRestrictedIndicatorMessage -> reg_sho_short_sale_price_test_restricted_indicator_message: RegShoShortSalePriceTestRestrictedIndicatorMessage;
        MessageType::AdjustedClosingPriceMessage -> adjusted_closing_price_message: AdjustedClosingPriceMessage;
        MessageType::LongFormAdjustedClosingPriceMessage -> long_form_adjusted_closing_price_message: LongFormAdjustedClosingPriceMessage;
        MessageType::EndOfDayTradeSummaryMessage -> end_of_day_trade_summary_message: EndOfDayTradeSummaryMessage;
        MessageType::LongFormEndOfDayTradeSummaryMessage -> long_form_end_of_day_trade_summary_message: LongFormEndOfDayTradeSummaryMessage;
        MessageType::NextSharesEndOfDayTradeSummaryMessage -> next_shares_end_of_day_trade_summary_message: NextSharesEndOfDayTradeSummaryMessage;
        MessageType::IpoInformationMessage -> ipo_information_message: IpoInformationMessage;
        MessageType::MwcbDeclineLevelMessage -> mwcb_decline_level_message: MwcbDeclineLevelMessage;
        MessageType::MwcbStatusMessage -> mwcb_status_message: MwcbStatusMessage;
        MessageType::IpoQuotingPeriodUpdateMessage -> ipo_quoting_period_update_message: IpoQuotingPeriodUpdateMessage;
        MessageType::OperationalHaltMessage -> operational_halt_message: OperationalHaltMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    message_type: uint8 &convert=MessageType($$);
};

type SystemEventMessage = unit {
    event_code: uint8 &convert=EventCode($$);
};

type TradeReportMessage = unit {
    originating_market_center_identifier: uint8 &convert=OriginatingMarketCenterIdentifier($$);
    issue_symbol: bytes &size=8;
    security_class: uint8 &convert=SecurityClass($$);
    trade_control_number: bytes &size=10;
    trade_price: uint32;
    trade_size: uint32;
    sale_condition_modifier: SaleConditionModifier;
    consolidated_volume: uint64;
};

type SaleConditionModifier = unit {
    settlement_type: uint8 &convert=SettlementType($$);
    trade_through_exemption: uint8 &convert=TradeThroughExemption($$);
    extended_hours_or_sold_code: uint8 &convert=ExtendedHoursOrSoldCode($$);
    special_sale_condition: uint8 &convert=SpecialSaleCondition($$);
};

type LongFormTradeReportMessage = unit {
    originating_market_center_identifier: uint8 &convert=OriginatingMarketCenterIdentifier($$);
    issue_symbol: bytes &size=8;
    security_class: uint8 &convert=SecurityClass($$);
    trade_control_number: bytes &size=10;
    trade_price_long: uint64;
    trade_size: uint32;
    sale_condition_modifier: SaleConditionModifier;
    consolidated_volume: uint64;
};

type NextSharesTradeReportMessage = unit {
    originating_market_center_identifier: uint8 &convert=OriginatingMarketCenterIdentifier($$);
    next_shares_symbol: bytes &size=8;
    security_class: uint8 &convert=SecurityClass($$);
    trade_control_number: bytes &size=10;
    proxy_price: uint32;
    trade_size: uint32;
    nav_offset_amount: uint32;
    sale_condition_modifier: SaleConditionModifier;
    consolidated_volume: uint64;
};

type TradeCancelErrorMessage = unit {
    originating_market_center_identifier: uint8 &convert=OriginatingMarketCenterIdentifier($$);
    issue_symbol: bytes &size=8;
    security_class: uint8 &convert=SecurityClass($$);
    original_trade_control_number: bytes &size=10;
    original_trade_price: uint32;
    original_trade_size: uint32;
    original_sale_condition_modifier: OriginalSaleConditionModifier;
    consolidated_volume: uint64;
};

