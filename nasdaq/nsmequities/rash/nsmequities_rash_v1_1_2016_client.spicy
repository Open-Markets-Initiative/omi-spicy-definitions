    NotARetailDesignatedOrder = 0x4e,
};

type IntermarketSweepEligibility = enum {
    Eligible = 0x59,
    NotEligible = 0x4e,
};

type CrossType = enum {
    OpeningCross = 0x4f,
    ClosingCross = 0x43,
    IntradayCross = 0x49,
    ImmediatelyLive = 0x4e,
    RetailCross = 0x52,
};

