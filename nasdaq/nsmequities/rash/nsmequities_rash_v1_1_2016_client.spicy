module NasdaqNsmequitiesRashAsciirashV112016Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesRashV112016 = unit {
    client_soup_bin_tcp_packet: ClientSoupBinTcpPacket[] &eod;
};

type ClientSoupBinTcpPacket = unit {
    client_packet_header: ClientPacketHeader;
    switch ( self.client_packet_header.client_packet_type ) {
        ClientPacketType::DebugPacket -> debug_packet: DebugPacket;
        ClientPacketType::LoginRequestPacket -> login_request_packet: LoginRequestPacket;
        ClientPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ClientPacketHeader = unit {
    packet_length: uint16;
    client_packet_type: uint8 &convert=ClientPacketType($$);
};

type DebugPacket = unit {
    debug_text: bytes &size=1;
};

type LoginRequestPacket = unit {
    username: bytes &size=6;
    password: bytes &size=10;
    requested_session: bytes &size=10;
    requested_sequence_number: bytes &size=20;
};

type UnsequencedDataPacket = unit {
    unsequenced_message_type: uint8 &convert=UnsequencedMessageType($$);
    switch ( self.unsequenced_message_type ) {
        UnsequencedMessageType::EnterOrderMessage -> enter_order_message: EnterOrderMessage;
        UnsequencedMessageType::EnterOrderMessageWithCrossFunctionality -> enter_order_message_with_cross_functionality: EnterOrderMessageWithCrossFunctionality;
        UnsequencedMessageType::CancelOrderMessage -> cancel_order_message: CancelOrderMessage;
        * -> unknown: bytes &eod;
    };
};

type EnterOrderMessage = unit {
    order_token_client_order_id: bytes &size=14;
    side: uint8 &convert=Side($$);
    shares_order_qty: bytes &size=6;
    stock_symbol: bytes &size=8;
    price: bytes &size=10;
    time_in_force: bytes &size=5;
    firm_client_id: bytes &size=4;
    display: uint8 &convert=Display($$);
    min_qty: bytes &size=6;
    max_floor: bytes &size=6;
    peg_type: uint8 &convert=PegType($$);
    peg_difference_sign: uint8 &convert=PegDifferenceSign($$);
    peg_difference: bytes &size=10;
    discretion_price: bytes &size=10;
    discretion_peg_type: uint8 &convert=DiscretionPegType($$);
    discretion_peg_difference_sign: uint8 &convert=DiscretionPegDifferenceSign($$);
    discretion_peg_difference: bytes &size=10;
    capacity_rule_80_a_indicator: bytes &size=1;
    random_reserve: bytes &size=6;
    route_dest_exec_broker: bytes &size=4;
    cust_terminal_id_sender_sub_id: bytes &size=32;
    customer_type: uint8 &convert=CustomerType($$);
};

type EnterOrderMessageWithCrossFunctionality = unit {
    order_token_client_order_id: bytes &size=14;
    side: uint8 &convert=Side($$);
    shares_order_qty: bytes &size=6;
    stock_symbol: bytes &size=8;
    price: bytes &size=10;
    time_in_force: bytes &size=5;
    firm_client_id: bytes &size=4;
    display: uint8 &convert=Display($$);
    min_qty: bytes &size=6;
    max_floor: bytes &size=6;
    peg_type: uint8 &convert=PegType($$);
    peg_difference_sign: uint8 &convert=PegDifferenceSign($$);
    peg_difference: bytes &size=10;
    discretion_price: bytes &size=10;
    discretion_peg_type: uint8 &convert=DiscretionPegType($$);
    discretion_peg_difference_sign: uint8 &convert=DiscretionPegDifferenceSign($$);
    discretion_peg_difference: bytes &size=10;
    capacity_rule_80_a_indicator: bytes &size=1;
    random_reserve: bytes &size=6;
    route_dest_exec_broker: bytes &size=4;
    cust_terminal_id_sender_sub_id: bytes &size=32;
    intermarket_sweep_eligibility: uint8 &convert=IntermarketSweepEligibility($$);
    cross_type: uint8 &convert=CrossType($$);
    customer_type: uint8 &convert=CustomerType($$);
};

type CancelOrderMessage = unit {
    order_token_client_order_id: bytes &size=14;
    shares: bytes &size=6;
};

type ClientPacketType = enum {
    DebugPacket = 0x2b,
    LoginRequestPacket = 0x4c,
    UnsequencedDataPacket = 0x55,
    ClientHeartbeatPacket = 0x52,
    LogoutRequestPacket = 0x4f,
};

type UnsequencedMessageType = enum {
    EnterOrderMessage = 0x4f,
    EnterOrderMessageWithCrossFunctionality = 0x51,
    CancelOrderMessage = 0x58,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
    Short = 0x54,
    ShortExempt = 0x45,
};

type Display = enum {
    AnonymousPriceToComply = 0x59,
    NonDisplayed = 0x4e,
    AttributablePriceToDisplay = 0x41,
    ImbalanceOnly = 0x49,
    PostOnly = 0x50,
    MidPointPegPostOnly = 0x57,
    PostOnlyAndAttributablePriceToDisplay = 0x4c,
    RetailOrderType1 = 0x4f,
    RetailOrderType2 = 0x54,
    RetailPriceImprovementOrder = 0x51,
    MidPointPeg = 0x4d,
};

type PegType = enum {
    Midpoint = 0x4d,
    NoPeg = 0x4e,
    Market = 0x50,
    Primary = 0x52,
    MarketMakerPeg = 0x51,
    InavPeg = 0x49,
};

type PegDifferenceSign = enum {
    Plus = 0x2b,
    Minus = 0x2d,
};

type DiscretionPegType = enum {
    Midpoint = 0x4d,
    NoPeg = 0x4e,
