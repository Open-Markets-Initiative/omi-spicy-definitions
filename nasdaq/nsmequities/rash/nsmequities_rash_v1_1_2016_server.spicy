module NasdaqNsmequitiesRashAsciirashV112016Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesRashV112016 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket;
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit {
    debug_text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: uint8 &convert=RejectReasonCode($$);
};

type SequencedDataPacket = unit {
    sequenced_message_header: SequencedMessageHeader;
    switch ( self.sequenced_message_header.sequenced_message_type ) {
        SequencedMessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        SequencedMessageType::AcceptedOrderMessage -> accepted_order_message: AcceptedOrderMessage;
        SequencedMessageType::AcceptedOrderMessageWithCrossFunctionality -> accepted_order_message_with_cross_functionality: AcceptedOrderMessageWithCrossFunctionality;
        SequencedMessageType::CanceledOrderMessage -> canceled_order_message: CanceledOrderMessage;
        SequencedMessageType::RejectedOrderMessage -> rejected_order_message: RejectedOrderMessage;
        SequencedMessageType::ExecutedOrderMessage -> executed_order_message: ExecutedOrderMessage;
        SequencedMessageType::BrokenTradeMessage -> broken_trade_message: BrokenTradeMessage;
        SequencedMessageType::ExecutedWithReferencePriceMessage -> executed_with_reference_price_message: ExecutedWithReferencePriceMessage;
        SequencedMessageType::TradeCorrectionMessage -> trade_correction_message: TradeCorrectionMessage;
        * -> unknown: bytes &eod;
    };
};

type SequencedMessageHeader = unit {
    timestamp: bytes &size=8;
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
};

type SystemEventMessage = unit {
    event_code: uint8 &convert=EventCode($$);
};

type AcceptedOrderMessage = unit {
    order_token_client_order_id: bytes &size=14;
    side: uint8 &convert=Side($$);
    shares_order_qty: bytes &size=6;
    stock_symbol: bytes &size=8;
    price: bytes &size=10;
    time_in_force: bytes &size=5;
    firm_client_id: bytes &size=4;
    display: uint8 &convert=Display($$);
    order_reference_number: bytes &size=9;
    min_qty: bytes &size=6;
    max_floor: bytes &size=6;
    peg_type: uint8 &convert=PegType($$);
    peg_difference_sign: uint8 &convert=PegDifferenceSign($$);
    peg_difference: bytes &size=10;
    discretion_price: bytes &size=10;
    discretion_peg_type: uint8 &convert=DiscretionPegType($$);
    discretion_peg_difference_sign: uint8 &convert=DiscretionPegDifferenceSign($$);
    discretion_peg_difference: bytes &size=10;
    capacity_rule_80_a_indicator: bytes &size=1;
    random_reserve: bytes &size=6;
    route_dest_exec_broker: bytes &size=4;
    cust_terminal_id_sender_sub_id: bytes &size=32;
};

