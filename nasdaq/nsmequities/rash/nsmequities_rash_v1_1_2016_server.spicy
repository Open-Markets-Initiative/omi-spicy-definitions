    peg_type: uint8 &convert=PegType($$);
    peg_difference_sign: uint8 &convert=PegDifferenceSign($$);
    peg_difference: bytes &size=10;
    discretion_price: bytes &size=10;
    discretion_peg_type: uint8 &convert=DiscretionPegType($$);
    discretion_peg_difference_sign: uint8 &convert=DiscretionPegDifferenceSign($$);
    discretion_peg_difference: bytes &size=10;
    capacity_rule_80_a_indicator: bytes &size=1;
    random_reserve: bytes &size=6;
    route_dest_exec_broker: bytes &size=4;
    cust_terminal_id_sender_sub_id: bytes &size=32;
    intermarket_sweep_eligibility: uint8 &convert=IntermarketSweepEligibility($$);
    cross_type: uint8 &convert=CrossType($$);
};

type CanceledOrderMessage = unit {
    order_token_client_order_id: bytes &size=14;
    shares: bytes &size=6;
    cancel_reason: uint8 &convert=CancelReason($$);
};

type RejectedOrderMessage = unit {
    order_token_client_order_id: bytes &size=14;
