module NasdaqNsmequitiesTotalviewItchV502018Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesTotalviewV502018 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket;
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit {
    debug_text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: uint8 &convert=RejectReasonCode($$);
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8;
    switch ( self.sequenced_message_type ) {
        0x53 -> system_event_message: SystemEventMessage;
        0x52 -> stock_directory_message: StockDirectoryMessage;
        0x48 -> stock_trading_action_message: StockTradingActionMessage;
        0x59 -> reg_sho_short_sale_price_test_restricted_indicator_message: RegShoShortSalePriceTestRestrictedIndicatorMessage;
        0x4c -> market_participant_position_message: MarketParticipantPositionMessage;
        0x56 -> mwcb_decline_level_message: MwcbDeclineLevelMessage;
        0x57 -> mwcb_status_level_message: MwcbStatusLevelMessage;
        0x4b -> ipo_quoting_period_update: IpoQuotingPeriodUpdate;
        0x4a -> luld_auction_collar_message: LuldAuctionCollarMessage;
        0x68 -> operational_halt_message: OperationalHaltMessage;
        0x41 -> add_order_no_mpid_attribution_message: AddOrderNoMpidAttributionMessage;
        0x46 -> add_order_with_mpid_attribution_message: AddOrderWithMpidAttributionMessage;
        0x45 -> order_executed_message: OrderExecutedMessage;
        0x43 -> order_executed_with_price_message: OrderExecutedWithPriceMessage;
        0x58 -> order_cancel_message: OrderCancelMessage;
        0x44 -> order_delete_message: OrderDeleteMessage;
        0x55 -> order_replace_message: OrderReplaceMessage;
        0x50 -> non_cross_trade_message: NonCrossTradeMessage;
        0x51 -> cross_trade_message: CrossTradeMessage;
        0x42 -> broken_trade_message: BrokenTradeMessage;
        0x49 -> net_order_imbalance_indicator_message: NetOrderImbalanceIndicatorMessage;
        0x4e -> retail_price_improvement_indicator_message: RetailPriceImprovementIndicatorMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemEventMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    event_code: uint8 &convert=EventCode($$);
};

type StockDirectoryMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    market_category: uint8 &convert=MarketCategory($$);
    financial_status_indicator: uint8 &convert=FinancialStatusIndicator($$);
    round_lot_size: uint32;
    round_lots_only: uint8 &convert=RoundLotsOnly($$);
    issue_classification: uint8 &convert=IssueClassification($$);
    issue_sub_type: bytes &size=2;
    authenticity: uint8 &convert=Authenticity($$);
    short_sale_threshold_indicator: uint8 &convert=ShortSaleThresholdIndicator($$);
    ipo_flag: uint8 &convert=IpoFlag($$);
    luld_reference_price_tier: uint8 &convert=LuldReferencePriceTier($$);
    etp_flag: uint8 &convert=EtpFlag($$);
    etp_leverage_factor: uint32;
    inverse_indicator: uint8 &convert=InverseIndicator($$);
};

type StockTradingActionMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    trading_state: uint8 &convert=TradingState($$);
    reserved: bytes &size=1;
    reason_code: bytes &size=4;
};

type RegShoShortSalePriceTestRestrictedIndicatorMessage = unit {
    locate_code: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    reg_sho_action: uint8 &convert=RegShoAction($$);
};

type MarketParticipantPositionMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    mpid: bytes &size=4;
    stock: bytes &size=8;
    primary_market_maker: uint8 &convert=PrimaryMarketMaker($$);
    market_maker_mode: uint8 &convert=MarketMakerMode($$);
    market_participant_state: uint8 &convert=MarketParticipantState($$);
};

type MwcbDeclineLevelMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    level_1: uint64;
    level_2: uint64;
    level_3: uint64;
};

type MwcbStatusLevelMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    breached_level: uint8 &convert=BreachedLevel($$);
};

type IpoQuotingPeriodUpdate = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    ipo_quotation_release_time: uint32;
    ipo_quotation_release_qualifier: uint8 &convert=IpoQuotationReleaseQualifier($$);
    ipo_price: uint32;
};

type LuldAuctionCollarMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    auction_collar_reference_price: uint32;
    upper_auction_collar_price: uint32;
    lower_auction_collar_price: uint32;
    auction_collar_extension: uint32;
};

type OperationalHaltMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    market_code: uint8 &convert=MarketCode($$);
    operational_halt_action: uint8 &convert=OperationalHaltAction($$);
};

type AddOrderNoMpidAttributionMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    order_reference_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    shares: uint32;
    stock: bytes &size=8;
    price: uint32;
};

type AddOrderWithMpidAttributionMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    order_reference_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    shares: uint32;
    stock: bytes &size=8;
    price: uint32;
    attribution: bytes &size=4;
};

type OrderExecutedMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    order_reference_number: uint64;
    executed_shares: uint32;
    match_number: uint64;
};

type OrderExecutedWithPriceMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    order_reference_number: uint64;
    executed_shares: uint32;
    match_number: uint64;
    printable: uint8 &convert=Printable($$);
    execution_price: uint32;
};

type OrderCancelMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    order_reference_number: uint64;
    canceled_shares: uint32;
};

type OrderDeleteMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    order_reference_number: uint64;
};

type OrderReplaceMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    original_order_reference_number: uint64;
    new_order_reference_number: uint64;
    shares: uint32;
    price: uint32;
};

type NonCrossTradeMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    order_reference_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    shares: uint32;
    stock: bytes &size=8;
    price: uint32;
    match_number: uint64;
};

type CrossTradeMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    cross_shares: uint64;
    stock: bytes &size=8;
    cross_price: uint32;
    match_number: uint64;
    cross_type: uint8 &convert=CrossType($$);
};

type BrokenTradeMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    match_number: uint64;
};

type NetOrderImbalanceIndicatorMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    paired_shares: uint64;
    imbalance_shares: uint64;
    imbalance_direction: uint8 &convert=ImbalanceDirection($$);
    stock: bytes &size=8;
    far_price: uint32;
    near_price: uint32;
    current_reference_price: uint32;
    cross_type: uint8 &convert=CrossType($$);
    price_variation_indicator: uint8 &convert=PriceVariationIndicator($$);
};

type RetailPriceImprovementIndicatorMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    interest_flag: uint8 &convert=InterestFlag($$);
};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
    EndOfSessionPacket = 0x5a,
};

type RejectReasonCode = enum {
    NotAuthorized = 0x41,
    SessionNotAvailable = 0x53,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfMarketHours = 0x51,
    EndOfMarketHours = 0x4d,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
};

type MarketCategory = enum {
    NasdaqGlobalSelectMarket = 0x51,
    NasdaqGlobalMarket = 0x47,
    NasdaqCapitalMarket = 0x53,
    Nyse = 0x4e,
    NyseMkt = 0x41,
    NyseArca = 0x50,
    BatsZ = 0x5a,
    InvestorsExchange = 0x56,
    NotAvailable = 0x20,
};

