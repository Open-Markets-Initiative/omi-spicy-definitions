module NasdaqNsmequitiesTotalviewItchV31FServer;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NsmequitiesTotalviewV31F = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket;
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
    soup_lf: uint8;
};

type ServerPacketHeader = unit {
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit {
    text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    session: bytes &size=10;
    sequence_number: uint64;
};

type LoginRejectedPacket = unit {
    reject_reason_code: bytes &size=1;
};

type SequencedDataPacket = unit {
    sequenced_message_header: SequencedMessageHeader;
    switch ( self.sequenced_message_header.message_type ) {
        MessageType::SecondsMessage -> seconds_message: SecondsMessage;
        MessageType::MillisecondsMessage -> milliseconds_message: MillisecondsMessage;
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::StockDirectoryMessage -> stock_directory_message: StockDirectoryMessage;
        MessageType::StockTradingActionMessage -> stock_trading_action_message: StockTradingActionMessage;
        MessageType::MarketParticipantPositionMessage -> market_participant_position_message: MarketParticipantPositionMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::AddOrderWithMpidMessage -> add_order_with_mpid_message: AddOrderWithMpidMessage;
        MessageType::OrderExecutedMessage -> order_executed_message: OrderExecutedMessage;
        MessageType::OrderExecutedWithPriceMessage -> order_executed_with_price_message: OrderExecutedWithPriceMessage;
        MessageType::OrderCancelMessage -> order_cancel_message: OrderCancelMessage;
        MessageType::OrderDeleteMessage -> order_delete_message: OrderDeleteMessage;
        MessageType::OrderReplaceMessage -> order_replace_message: OrderReplaceMessage;
        MessageType::OrderDisplayMessage -> order_display_message: OrderDisplayMessage;
        MessageType::TradeMessage -> trade_message: TradeMessage;
        MessageType::CrossTradeMessage -> cross_trade_message: CrossTradeMessage;
        MessageType::BrokenTradeMessage -> broken_trade_message: BrokenTradeMessage;
        MessageType::NetOrderImbalanceIndicatorMessage -> net_order_imbalance_indicator_message: NetOrderImbalanceIndicatorMessage;
        * -> unknown: bytes &eod;
    };
};

type SequencedMessageHeader = unit {
    message_type: uint8 &convert=MessageType($$);
};

type SecondsMessage = unit {
    second: bytes &size=5;
};

type MillisecondsMessage = unit {
    millisecond: bytes &size=3;
};

type SystemEventMessage = unit {
    event_code: uint8 &convert=EventCode($$);
};

type StockDirectoryMessage = unit {
    stock_alpha_6: bytes &size=6;
    market_category: uint8 &convert=MarketCategory($$);
    financial_status_indicator: uint8 &convert=FinancialStatusIndicator($$);
    round_lot_size: bytes &size=6;
    round_lots_only: uint8 &convert=RoundLotsOnly($$);
};

type StockTradingActionMessage = unit {
    stock_alpha_6: bytes &size=6;
    trading_state: uint8 &convert=TradingState($$);
    reserved: bytes &size=1;
    reason: bytes &size=4;
};

type MarketParticipantPositionMessage = unit {
    mpid: bytes &size=4;
    stock_alphanumeric_6: bytes &size=6;
    primary_market_maker: uint8 &convert=PrimaryMarketMaker($$);
    market_maker_mode: uint8 &convert=MarketMakerMode($$);
    market_participant_state: uint8 &convert=MarketParticipantState($$);
};

type AddOrderMessage = unit {
    order_reference_number: bytes &size=12;
    side: uint8 &convert=Side($$);
    shares_numeric_6: bytes &size=6;
    stock_alpha_6: bytes &size=6;
    price: bytes &size=10;
    display: uint8 &convert=Display($$);
};

type AddOrderWithMpidMessage = unit {
    order_reference_number: bytes &size=12;
    side: uint8 &convert=Side($$);
    shares_numeric_6: bytes &size=6;
    stock_alpha_6: bytes &size=6;
    price: bytes &size=10;
    attribution: bytes &size=4;
};

type OrderExecutedMessage = unit {
    order_reference_number: bytes &size=12;
    executed_shares: bytes &size=6;
    match_number: bytes &size=12;
};

type OrderExecutedWithPriceMessage = unit {
    order_reference_number: bytes &size=12;
    executed_shares: bytes &size=6;
    match_number: bytes &size=12;
    printable: uint8 &convert=Printable($$);
    execution_price: bytes &size=10;
};

type OrderCancelMessage = unit {
    order_reference_number: bytes &size=12;
    canceled_shares: bytes &size=6;
};

type OrderDeleteMessage = unit {
    order_reference_number: bytes &size=12;
};

type OrderReplaceMessage = unit {
    original_order_reference_number: bytes &size=12;
    new_order_reference_number: bytes &size=12;
    shares_numeric_6: bytes &size=6;
    price: bytes &size=10;
    display: uint8 &convert=Display($$);
};

type OrderDisplayMessage = unit {
    order_reference_number: bytes &size=12;
};

type TradeMessage = unit {
    order_reference_number: bytes &size=12;
    side: uint8 &convert=Side($$);
    shares_numeric_6: bytes &size=6;
    stock_alpha_6: bytes &size=6;
    price: bytes &size=10;
    match_number: bytes &size=12;
};

type CrossTradeMessage = unit {
    shares_numeric_9: bytes &size=9;
    stock_alpha_6: bytes &size=6;
    cross_price: bytes &size=10;
    match_number: bytes &size=12;
    cross_type: uint8 &convert=CrossType($$);
};

type BrokenTradeMessage = unit {
    match_number: bytes &size=12;
};

type NetOrderImbalanceIndicatorMessage = unit {
    paired_shares: bytes &size=9;
    imbalance_shares: bytes &size=9;
    imbalance_direction: uint8 &convert=ImbalanceDirection($$);
    stock_alpha_6: bytes &size=6;
    far_price: bytes &size=10;
    near_price: bytes &size=10;
    current_reference_price: bytes &size=10;
    cross_type: uint8 &convert=CrossType($$);
    price_variation_indicator: uint8 &convert=PriceVariationIndicator($$);
};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
};

type MessageType = enum {
    SecondsMessage = 0x54,
    MillisecondsMessage = 0x4d,
    SystemEventMessage = 0x53,
    StockDirectoryMessage = 0x52,
    StockTradingActionMessage = 0x48,
    MarketParticipantPositionMessage = 0x4c,
    AddOrderMessage = 0x41,
    AddOrderWithMpidMessage = 0x46,
    OrderExecutedMessage = 0x45,
    OrderExecutedWithPriceMessage = 0x43,
    OrderCancelMessage = 0x58,
    OrderDeleteMessage = 0x44,
    OrderReplaceMessage = 0x55,
    OrderDisplayMessage = 0x56,
    TradeMessage = 0x50,
    CrossTradeMessage = 0x51,
    BrokenTradeMessage = 0x42,
    NetOrderImbalanceIndicatorMessage = 0x49,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfMarketHours = 0x51,
    EndOfMarketHours = 0x4d,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
    EmergencyMarketConditionHalt = 0x41,
    EmergencyMarketConditionQuoteOnlyPeriod = 0x52,
    EmergencyMarketConditionResumption = 0x42,
};

type MarketCategory = enum {
    Cqs = 0x54,
    NasdaqGlobalSelectMarket = 0x51,
    NasdaqGlobalMarket = 0x47,
    NasdaqCapitalMarket = 0x53,
};

type FinancialStatusIndicator = enum {
    Deficient = 0x44,
    Delinquent = 0x45,
    Bankrupt = 0x51,
    Suspended = 0x53,
    DeficientAndBankrupt = 0x47,
    DeficientAndDelinquent = 0x48,
    DelinquentAndBankrupt = 0x4a,
    DeficientDelinquentAndBankrupt = 0x4b,
    InCompliance = 0x20,
};

type RoundLotsOnly = enum {
    RoundLotsOnly_x59 = 0x59,
    OddAndMixedLotsAllowed = 0x4e,
};

type TradingState = enum {
    Halted = 0x48,
    QuotationOnlyPeriod = 0x51,
    Trading = 0x54,
};

type Reason = enum {
    ReasonNotAvailable = 0,
};

type PrimaryMarketMaker = enum {
    Primary = 0x59,
    NonPrimary = 0x4e,
};

type MarketMakerMode = enum {
    Normal = 0x4e,
    Passive = 0x50,
    Syndicate = 0x53,
    PreSyndicate = 0x52,
    Penalty = 0x4c,
};

type MarketParticipantState = enum {
    Active = 0x41,
    Excused = 0x45,
    Withdrawn = 0x57,
    Suspended = 0x53,
    Deleted = 0x44,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type Display = enum {
    Displayable = 0x59,
    FlashOrder = 0x53,
};

type Printable = enum {
    NonPrintable = 0x4e,
    Printable_x59 = 0x59,
};

type CrossType = enum {
    OpeningCross = 0x4f,
    ClosingCross = 0x43,
    IpoAndHaltedCross = 0x48,
    CrossNetwork = 0x49,
};

type ImbalanceDirection = enum {
    BuyImbalance = 0x42,
    SellImbalance = 0x53,
    NoImbalance = 0x4e,
    InsufficientOrders = 0x4f,
};

type PriceVariationIndicator = enum {
    LessThanOnePercent = 0x4c,
    OneToOnePointNineNinePercent = 0x31,
    TwoToTwoPointNineNinePercent = 0x32,
    ThreeToThreePointNineNinePercent = 0x33,
    FourToFourPointNineNinePercent = 0x34,
    FiveToFivePointNineNinePercent = 0x35,
    SixToSixPointNineNinePercent = 0x36,
    SevenToSevenPointNineNinePercent = 0x37,
    EightToEightPointNineNinePercent = 0x38,
    NineToNinePointNineNinePercent = 0x39,
    TenToNineteenPointNineNinePercent = 0x41,
    TwentyToTwentyNinePointNineNinePercent = 0x42,
    ThirtyPercentOrGreater = 0x43,
    CannotBeCalculated = 0x20,
};

