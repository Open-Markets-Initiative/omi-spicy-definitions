module NasdaqMrxoptionsSpreadordersItchV21MoldUdp64;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type MrxoptionsSpreadordersV21 = unit {
    udp_packet_header: UdpPacketHeader;
    messages: Message[self.udp_packet_header.message_count];
};

type UdpPacketHeader = unit {
    udp_session: bytes &size=10;
    udp_sequence_number: uint64;
    message_count: uint16;
};

type Message = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::ComplexStrategyDirectoryMessage -> complex_strategy_directory_message: ComplexStrategyDirectoryMessage;
        MessageType::StrategyTradingActionMessage -> strategy_trading_action_message: StrategyTradingActionMessage;
        MessageType::ComplexAddOrderMessage -> complex_add_order_message: ComplexAddOrderMessage;
        MessageType::ComplexStrategyAuctionMessage -> complex_strategy_auction_message: ComplexStrategyAuctionMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    message_length: uint16;
    message_type: uint8 &convert=MessageType($$);
};

type SystemEventMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    event_code: uint8 &convert=EventCode($$);
};

type ComplexStrategyDirectoryMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    strategy_type: uint8 &convert=StrategyType($$);
    underlying_symbol: bytes &size=13;
    reserved_16: bytes &size=16;
    number_of_legs: uint8;
    leg_information: LegInformation[self.number_of_legs];
};

type LegInformation = unit {
    option_id: uint32;
    security_symbol: bytes &size=8;
    expiration_year: uint8;
    expiration_month: uint8;
    expiration_day: uint8;
    explicit_strike_price: uint32;
    option_type: uint8 &convert=OptionType($$);
    side: uint8 &convert=Side($$);
    leg_ratio: uint32;
};

type StrategyTradingActionMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    current_trading_state: uint8 &convert=CurrentTradingState($$);
};

type ComplexAddOrderMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    order_reference_number: uint64;
    side: uint8 &convert=Side($$);
    original_order_volume: uint32;
    executable_order_volume: uint32;
    order_status: uint8 &convert=OrderStatus($$);
    order_type: uint8 &convert=OrderType($$);
    limit_price: uint32;
    time_in_force: uint8 &convert=TimeInForce($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    scope: uint8 &convert=Scope($$);
    owner_id: bytes &size=6;
    giveup: bytes &size=6;
    cmta: bytes &size=6;
};

type ComplexStrategyAuctionMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    auction_id: uint32;
    auction_type: uint8 &convert=AuctionType($$);
    auction_duration: uint32;
    auction_event: uint8 &convert=AuctionEvent($$);
    order_type: uint8 &convert=OrderType($$);
    side: uint8 &convert=Side($$);
    price: uint32;
    size: uint32;
    exec_flag: uint8 &convert=ExecFlag($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    scope: uint8 &convert=Scope($$);
    owner_id: bytes &size=6;
    giveup: bytes &size=6;
    cmta: bytes &size=6;
    response_price: uint32;
    response_size: uint32;
    reserved_4: bytes &size=4;
    number_of_flex_dac_legs: uint8;
    flex_dac_leg_information: FlexDacLegInformation[self.number_of_flex_dac_legs];
};

type FlexDacLegInformation = unit {
    reserved_8: bytes &size=8;
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    ComplexStrategyDirectoryMessage = 0x73,
    StrategyTradingActionMessage = 0x48,
    ComplexAddOrderMessage = 0x43,
    ComplexStrategyAuctionMessage = 0x61,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfOpeningProcess = 0x51,
    StartOfNormalHoursClosingProcess = 0x4e,
    StartOfLateHoursClosingProcess = 0x4c,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
    EndOfWcoEarlyClosing = 0x57,
};

type StrategyType = enum {
    VerticalSpread = 0x56,
    TimeSpread = 0x54,
    DiagonalSpread = 0x44,
    Straddle = 0x53,
    Strangle = 0x47,
    Combo = 0x43,
    RiskReversal = 0x52,
    RatioSpread = 0x41,
    BoxSpread = 0x42,
    ButterflySpread = 0x46,
    Custom = 0x55,
};

type OptionType = enum {
    CallOption = 0x43,
    PutOption = 0x50,
    StockLeg = 0x20,
};

type Side = enum {
    Buy = 0x42,
    Sell = 0x53,
};

type CurrentTradingState = enum {
    HaltInEffect = 0x48,
    ContinuousTrading = 0x54,
    PreOpen = 0x49,
    OpeningAuction = 0x4f,
    ReOpening = 0x52,
    Closed = 0x58,
};

type OrderStatus = enum {
    Open = 0x4f,
    Filled = 0x46,
    Cancelled = 0x43,
};

type OrderType = enum {
    Market = 0x4d,
    Limit = 0x4c,
};

type TimeInForce = enum {
    DayOrder = 0x44,
    GoodTillCancelled = 0x47,
};

type OrderCapacity = enum {
    CustomerOrder = 0x43,
    FirmOrder = 0x46,
    NasdaqRegisteredMarketMaker = 0x4d,
    BrokerDealerOder = 0x42,
    ProfessionalOrder = 0x50,
    OtherExchangeRegisteredMarketMaker = 0x4f,
    JboJointBackOfficeOnlyPhlx = 0x4a,
};

type Scope = enum {
    Local = 0x4c,
    National = 0x4e,
};

type AuctionType = enum {
    ComplexExposure = 0x45,
    PriceImprovementPimAuction = 0x50,
    Facilitation = 0x43,
    Solicitation = 0x53,
    FlexAuction = 0x58,
};

type AuctionEvent = enum {
    Start = 0x53,
    AuctionUpdate = 0x55,
    EndOfAuction = 0x45,
};

type ExecFlag = enum {
    None = 0x4e,
    Aon = 0x41,
};

