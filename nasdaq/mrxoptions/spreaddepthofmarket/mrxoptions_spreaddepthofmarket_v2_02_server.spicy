module NasdaqMrxoptionsSpreaddepthofmarketGlimpseV202Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type MrxoptionsSpreaddepthofmarketV202 = unit {
    server_soup_bin_tcp_packet: ServerSoupBinTcpPacket[] &eod;
};

type ServerSoupBinTcpPacket = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket(self.server_packet_header.packet_length);
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
};

type ServerPacketHeader = unit {
    packet_length: uint16;
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit(packet_length: uint16) {
    debug_text: bytes &size=packet_length - 1;
};

type LoginAcceptedPacket = unit {
    accepted_session: bytes &size=10;
    accepted_sequence_number: bytes &size=20;
};

type LoginRejectedPacket = unit {
    reject_reason_code: uint8 &convert=RejectReasonCode($$);
};

type SequencedDataPacket = unit {
    sequenced_message_type: uint8 &convert=SequencedMessageType($$);
    switch ( self.sequenced_message_type ) {
        SequencedMessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        SequencedMessageType::ComplexStrategyDirectoryMessage -> complex_strategy_directory_message: ComplexStrategyDirectoryMessage;
        SequencedMessageType::StrategyTradingActionMessage -> strategy_trading_action_message: StrategyTradingActionMessage;
        SequencedMessageType::AddOrderShortFormMessage -> add_order_short_form_message: AddOrderShortFormMessage;
        SequencedMessageType::AddOrderLongFormMessage -> add_order_long_form_message: AddOrderLongFormMessage;
        SequencedMessageType::SnapshotMessage -> snapshot_message: SnapshotMessage;
        * -> unknown: bytes &eod;
    };
};

type SystemEventMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    event_code: uint8 &convert=EventCode($$);
};

type ComplexStrategyDirectoryMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    strategy_type: uint8 &convert=StrategyType($$);
    underlying_symbol: bytes &size=13;
    number_of_legs: uint8;
    leg_information: LegInformation[self.number_of_legs];
};

type LegInformation = unit {
    option_id: uint32;
    security_symbol: bytes &size=6;
    expiration_year: uint8;
    expiration_month: uint8;
    expiration_day: uint8;
    explicit_strike_price: int32;
    option_type: uint8 &convert=OptionType($$);
    side: uint8 &convert=Side($$);
    leg_ratio: uint32;
};

type StrategyTradingActionMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    current_trading_state: uint8 &convert=CurrentTradingState($$);
};

type AddOrderShortFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    order_reference_number: uint64;
    depth_side: uint8 &convert=DepthSide($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    price_short: uint16;
    volume_short: uint16;
};

type AddOrderLongFormMessage = unit {
    tracking_number: uint16;
    timestamp: uint64;
    strategy_id: uint32;
    order_reference_number: uint64;
    depth_side: uint8 &convert=DepthSide($$);
    order_capacity: uint8 &convert=OrderCapacity($$);
    price_long: int32;
    volume_long: uint32;
};

type SnapshotMessage = unit {
    sequence_number: bytes &size=20;
};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
    EndOfSessionPacket = 0x5a,
};

type RejectReasonCode = enum {
    NotAuthorized = 0x41,
    SessionNotAvailable = 0x53,
};

type SequencedMessageType = enum {
    SystemEventMessage = 0x53,
    ComplexStrategyDirectoryMessage = 0x4e,
    StrategyTradingActionMessage = 0x48,
    AddOrderShortFormMessage = 0x66,
    AddOrderLongFormMessage = 0x46,
    SnapshotMessage = 0x4d,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfSystemHours = 0x53,
    StartOfOpeningProcess = 0x51,
    StartOfNormalHoursClosingProcess = 0x4e,
    StartOfLateHoursClosingProcess = 0x4c,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
    EndOfWcoEarlyClosing = 0x57,
};

type StrategyType = enum {
    VerticalSpread = 0x56,
    TimeSpread = 0x54,
    DiagonalSpread = 0x44,
    Straddle = 0x53,
    Strangle = 0x47,
    Combo = 0x43,
    RiskReversal = 0x52,
    RatioSpread = 0x41,
    BoxSpread = 0x42,
    ButterflySpread = 0x46,
    Custom = 0x55,
};

type OptionType = enum {
    CallOption = 0x43,
    PutOption = 0x50,
    StockLeg = 0x20,
};

type Side = enum {
    LegIsOnBuySide = 0x42,
    LegIsOnSellSide = 0x53,
};

type CurrentTradingState = enum {
    HaltInEffect = 0x48,
    ContinuousTrading = 0x54,
    PreOpen = 0x49,
    OpeningAuction = 0x4f,
    ReOpening = 0x52,
    Closed = 0x58,
};

type DepthSide = enum {
    Buy = 0x42,
    Sell = 0x53,
    BuyMarket = 0x4f,
    SellMarket = 0x50,
};

type OrderCapacity = enum {
    CustomerOrder = 0x43,
    FirmOrder = 0x46,
    NasdaqRegisteredMarketMaker = 0x4d,
    BrokerDealerOrder = 0x42,
    ProfessionalOrder = 0x50,
    OtherExchangeRegisteredMarketMaker = 0x4f,
};

