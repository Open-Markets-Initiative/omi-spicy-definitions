module NasdaqCanadaequitiesChixmmdGlimpseV10Server;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type CanadaequitiesChixmmdV10 = unit {
    server_packet_header: ServerPacketHeader;
    switch ( self.server_packet_header.server_packet_type ) {
        ServerPacketType::DebugPacket -> debug_packet: DebugPacket;
        ServerPacketType::LoginAcceptedPacket -> login_accepted_packet: LoginAcceptedPacket;
        ServerPacketType::LoginRejectedPacket -> login_rejected_packet: LoginRejectedPacket;
        ServerPacketType::SequencedDataPacket -> sequenced_data_packet: SequencedDataPacket;
        * -> unknown: bytes &eod;
    };
    soup_lf: uint8;
};

type ServerPacketHeader = unit {
    server_packet_type: uint8 &convert=ServerPacketType($$);
};

type DebugPacket = unit {
    text: bytes &size=1;
};

type LoginAcceptedPacket = unit {
    session: bytes &size=10;
    sequence_number: bytes &size=10;
};

type LoginRejectedPacket = unit {
    reject_reason_code: bytes &size=1;
};

type SequencedDataPacket = unit {
    sequenced_message_header: SequencedMessageHeader;
    switch ( self.sequenced_message_header.message_type ) {
        MessageType::SystemEventMessage -> system_event_message: SystemEventMessage;
        MessageType::StockStatusMessage -> stock_status_message: StockStatusMessage;
        MessageType::AddOrderMessage -> add_order_message: AddOrderMessage;
        MessageType::LongFormAddOrderMessage -> long_form_add_order_message: LongFormAddOrderMessage;
        * -> unknown: bytes &eod;
    };
};

type SequencedMessageHeader = unit {
    timestamp: bytes &size=8;
    message_type: uint8 &convert=MessageType($$);
};

type SystemEventMessage = unit {
    event_code: uint8 &convert=EventCode($$);
};

type StockStatusMessage = unit {
    stock: bytes &size=10;
    trading_state: uint8 &convert=TradingState($$);
    reserved_1: bytes &size=1;
    listing_market: uint8 &convert=ListingMarket($$);
    board_lot_size: bytes &size=4;
    currency: bytes &size=3;
    gef_eligible: uint8 &convert=GefEligible($$);
};

type AddOrderMessage = unit {
    order_reference: bytes &size=9;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    shares: bytes &size=6;
    stock: bytes &size=10;
    price: bytes &size=10;
    broker: bytes &size=3;
};

type LongFormAddOrderMessage = unit {
    order_reference: bytes &size=9;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    long_shares: bytes &size=10;
    stock: bytes &size=10;
    long_price: bytes &size=19;
    broker: bytes &size=3;
};

type ServerPacketType = enum {
    DebugPacket = 0x2b,
    LoginAcceptedPacket = 0x41,
    LoginRejectedPacket = 0x4a,
    SequencedDataPacket = 0x53,
    ServerHeartbeatPacket = 0x48,
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    StockStatusMessage = 0x48,
    AddOrderMessage = 0x41,
    LongFormAddOrderMessage = 0x61,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
    StartOfNasdaqCanadaTradingSession = 0x53,
    StartOfPrimaryMarketTradingSession = 0x51,
    EndOfPrimaryMarketTradingSession = 0x4d,
    EndOfSystemHours = 0x45,
    EndOfMessages = 0x43,
    MarketWideCircuitBreakerHalt = 0x57,
    MarketWideCircuitBreakerResumption = 0x52,
};

type TradingState = enum {
    Halted = 0x48,
    Trading = 0x54,
};

type ListingMarket = enum {
    Tsx = 0x54,
    TsxVenture = 0x56,
    Cse = 0x43,
    Neo = 0x4e,
};

type GefEligible = enum {
    GefEligible_x59 = 0x59,
    NotGefEligible = 0x4e,
};

type BuySellIndicator = enum {
    Buy = 0x42,
    Sell = 0x53,
};

