};

type NonCrossTradeMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    order_reference_number: uint64;
    buy_sell_indicator: uint8 &convert=BuySellIndicator($$);
    shares: uint32;
    stock: bytes &size=8;
    price: uint32;
    match_number: uint64;
};

type CrossTradeMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    cross_shares: uint64;
    stock: bytes &size=8;
    cross_price: uint32;
    match_number: uint64;
    cross_type: uint8 &convert=CrossType($$);
};

type BrokenTradeMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    match_number: uint64;
};

type NetOrderImbalanceIndicatorMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    paired_shares: uint64;
    imbalance_shares: uint64;
    imbalance_direction: uint8 &convert=ImbalanceDirection($$);
    stock: bytes &size=8;
    far_price: uint32;
    near_price: uint32;
    current_reference_price: uint32;
    cross_type: uint8 &convert=CrossType($$);
    price_variation_indicator: uint8 &convert=PriceVariationIndicator($$);
};

type RetailInterestMessage = unit {
    stock_locate: uint16;
    tracking_number: uint16;
    timestamp: bytes &size=6;
    stock: bytes &size=8;
    interest_flag: uint8 &convert=InterestFlag($$);
};

type MessageType = enum {
    SystemEventMessage = 0x53,
    StockDirectoryMessage = 0x52,
    StockTradingActionMessage = 0x48,
    RegShoShortSalePriceTestRestrictedIndicatorMessage = 0x59,
    MarketParticipantPositionMessage = 0x4c,
    MwcbDeclineLevelMessage = 0x56,
    MwcbStatusLevelMessage = 0x57,
    IpoQuotingPeriodUpdate = 0x4b,
    AddOrderNoMpidAttributionMessage = 0x41,
    LuldAuctionCollarMessage = 0x4a,
    AddOrderWithMpidAttributionMessage = 0x46,
    OrderExecutedMessage = 0x45,
    OrderExecutedWithPriceMessage = 0x43,
    OrderCancelMessage = 0x58,
    OrderDeleteMessage = 0x44,
    OrderReplaceMessage = 0x55,
    NonCrossTradeMessage = 0x50,
    CrossTradeMessage = 0x51,
    BrokenTradeMessage = 0x42,
    NetOrderImbalanceIndicatorMessage = 0x49,
    RetailInterestMessage = 0x4e,
};

type EventCode = enum {
    StartOfMessages = 0x4f,
