    Other = 0x59,
    Na = 0x5a,
};

type MarketTier = enum {
    NasdaqGlobalSelectMarket = 0x51,
    NasdaqGlobalMarket = 0x47,
    NasdaqCapitalMarket = 0x53,
};

type Authenticity = enum {
    LiveProduction = 0x50,
    Test = 0x54,
    Demo = 0x44,
    Deleted = 0x58,
};

type ShortSaleThresholdIndicator = enum {
    IssueIsRestrictedUnderSecRule203B3 = 0x59,
    IssueIsNotRestricted = 0x4e,
    ThresholdIndicatorNotAvailable = 0x20,
};

type FinancialStatusIndicator = enum {
    CreationsAndorRedemptionsSuspendedForExchangeTradedProduct = 0x43,
    DeficientIssuerFailedToMeetNasdaqContinuedListingRequirements = 0x44,
    DelinquentIssuerMissedRegulatoryFilingDeadline = 0x45,
    BankruptIssuerHasFiledForBankruptcy = 0x51,
    NormalDefaultIssuerIsNotDeficientDelinquentOrBankrupt = 0x4e,
    DeficientAndBankrupt = 0x47,
    DeficientAndDelinquent = 0x48,
    DelinquentAndBankrupt = 0x4a,
    DeficientDelinquentAndBankrupt = 0x4b,
};

type MpiTick = enum {
    PennyMpi = 0x50,
    HalfPennyMpiEffectiveNov2026PerSecMandate = 0x48,
};

type TradingState = enum {
    Halted = 0x48,
    Trading = 0x54,
};

type RegShoAction = enum {
    NoPriceTestInEffect = 0x30,
    RegShoInEffectDueToAnIntraDayPriceDropInSecurity = 0x31,
    RegShoRestrictionRemainsInEffect = 0x32,
};

type TradingActionCode = enum {
    TradingHalt = 0x48,
    QuotationResumptionIncludingAfterEma = 0x51,
    TradingResumption = 0x54,
    VolatilityTradingPause = 0x50,
};

