    ask_size_int_4: uint32;
    cond: uint8 &convert=Cond($$);
    mpid: bytes &size=4;
    bbo_indicator: uint8 &convert=BboIndicator($$);
};

type FinraAdfOddLotQuotationMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    timestamp_2: uint64;
    symbol_byte_11: bytes &size=11;
    ol_bid_level_count: uint16;
    ol_ask_level_count: uint16;
    odd_lot_bid_adf_form_attachment: OddLotBidAdfFormAttachment[self.ol_bid_level_count];
    odd_lot_ask_adf_form_attachment: OddLotAskAdfFormAttachment[self.ol_ask_level_count];
};

type OddLotBidAdfFormAttachment = unit {
    ol_price_long_8: uint64;
    ol_size: uint16;
    mpid: bytes &size=4;
};

type OddLotAskAdfFormAttachment = unit {
