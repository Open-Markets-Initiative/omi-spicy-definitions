    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
};

type MarketClosedMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
};

type AuctionCollarMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_11: bytes &size=11;
    action_sequence: uint32;
    collar_reference_price: uint64;
    collar_up_price: uint64;
    collar_down_price: uint64;
    collar_extension: bytes &size=1;
};

type InboundControlMessagesMessage = unit {
    inbound_control_messages_message_type: bytes &size=1;
    switch ( self.inbound_control_messages_message_type ) {
        0x43 -> sequence_inquiry_message: SequenceInquiryMessage;
        0x53 -> symbol_state_inquiry_message: SymbolStateInquiryMessage;
        0x47 -> end_of_participant_reporting_message: EndOfParticipantReportingMessage;
        * -> unknown: bytes &eod;
    };
};

type SequenceInquiryMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
};

type SymbolStateInquiryMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_11: bytes &size=11;
};

type EndOfParticipantReportingMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
};

type ReturnAdministrativeMessagesMessage = unit {
    return_administrative_messages_message_type: bytes &size=1;
    switch ( self.return_administrative_messages_message_type ) {
        0x41 -> return_general_administrative_message: ReturnGeneralAdministrativeMessage;
        0x4a -> return_market_center_trading_action_acknowledgement_message: ReturnMarketCenterTradingActionAcknowledgementMessage;
        0x58 -> return_market_open_message: ReturnMarketOpenMessage;
        0x59 -> return_market_closed_message: ReturnMarketClosedMessage;
        0x52 -> reject_message: RejectMessage;
        0x4b -> sequence_acknowledgement_message: SequenceAcknowledgementMessage;
        0x57 -> participant_input_warning_message: ParticipantInputWarningMessage;
        * -> unknown: bytes &eod;
    };
};

type ReturnGeneralAdministrativeMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
    text_len: uint16;
    text: bytes &eod;
};

type ReturnMarketCenterTradingActionAcknowledgementMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
    symbol_byte_11: bytes &size=11;
    action: uint8 &convert=Action($$);
    action_time: uint64;
};

type ReturnMarketOpenMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
};

type ReturnMarketClosedMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
};

type RejectMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    reject_code: uint16 &convert=RejectCode($$);
    syntax_violation: uint8 &convert=SyntaxViolation($$);
};

type SequenceAcknowledgementMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
    feed_sequence: uint64;
    part_token: uint64;
};

type ParticipantInputWarningMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    warning_code: uint16;
    symbol_byte_11: bytes &size=11;
    ol_attachmen_type: bytes &size=1;
    ol_attachment_count: uint16;
};

type ReturnControlMessagesMessage = unit {
    return_control_messages_message_type: bytes &size=1;
    switch ( self.return_control_messages_message_type ) {
        0x45 -> start_of_day_message: StartOfDayMessage;
        0x46 -> end_of_day_message: EndOfDayMessage;
        0x43 -> sequence_inquiry_response_message: SequenceInquiryResponseMessage;
        0x53 -> symbol_state_inquiry_response_message: SymbolStateInquiryResponseMessage;
        * -> unknown: bytes &eod;
    };
};

type StartOfDayMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
};

type EndOfDayMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
};

type SequenceInquiryResponseMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    sip_state: uint8 &convert=SipState($$);
};

type SymbolStateInquiryResponseMessage = unit {
    orig: bytes &size=2;
    sip_time: uint64;
    symbol_byte_11: bytes &size=11;
    next_trade_id: uint32;
    next_action_sequence: uint32;
    symbol_state: uint8 &convert=SymbolState($$);
};

type DebugPacket = unit {
    text: bytes &eod;
};

type LoginRequestPacket = unit {
    username: bytes &size=6;
    password: bytes &size=10;
    requested_session: bytes &size=10;
    requested_sequence_number: bytes &size=20;
};

type ClientPacketType = enum {
    UnsequencedDataPacket = 0x55,
    DebugPacket = 0x2b,
    LoginRequestPacket = 0x4c,
    ClientHeartbeatPacket = 0x52,
    LogoutRequestPacket = 0x4f,
};

type Cond = enum {
    ManualAskAutomatedBid = 0x41,
    ManualBidAutomatedAsk = 0x42,
    FastTrading = 0x46,
    ManualBidAndAsk = 0x48,
    OrderImbalance = 0x49,
    ClosedQuote = 0x4c,
    NonfirmQuote = 0x4e,
    OpeningQuoteAutomated = 0x4f,
    RegularTwosidedOpenQuoteAutomated = 0x52,
    ManualBidAndAskNonfirm = 0x55,
    OrderInflux = 0x58,
    AutomatedBidNoOfferOrAutomatedOfferNoBid = 0x59,
    NoOpennoResume = 0x5a,
    IntradayAuction = 0x34,
};

type Rii = enum {
    RetailInterestNotApplicable = 0x20,
    RetailInterestOnBidQuote = 0x41,
    RetailInterestOnAskQuote = 0x42,
    RetailInterestOnBothBidAndAskQuote = 0x43,
};

type BboCond = enum {
    ManualAskAutomatedBid = 0x41,
