};

type InboundAdministrativeMessagesMessage = unit {
    inbound_administrative_messages_message_type: bytes &size=1;
    switch ( self.inbound_administrative_messages_message_type ) {
        0x41 -> general_administrative_message: GeneralAdministrativeMessage;
        0x4f -> trading_action_message: TradingActionMessage;
        0x4a -> market_center_trading_action_message: MarketCenterTradingActionMessage;
        0x55 -> market_center_mass_trading_action_message: MarketCenterMassTradingActionMessage;
        0x56 -> reg_sho_short_sale_price_test_restricted_indicator_message: RegShoShortSalePriceTestRestrictedIndicatorMessage;
        0x4d -> opening_reference_midpoint_price_message: OpeningReferenceMidpointPriceMessage;
        0x4e -> t_1_adjusted_closing_price_message: T1AdjustedClosingPriceMessage;
        0x58 -> market_open_message: MarketOpenMessage;
        0x59 -> market_closed_message: MarketClosedMessage;
        0x45 -> auction_collar_message: AuctionCollarMessage;
        * -> unknown: bytes &eod;
    };
};

type GeneralAdministrativeMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    text_len: uint16;
    text: bytes &eod;
};

type TradingActionMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_11: bytes &size=11;
    action: uint8 &convert=Action($$);
    action_sequence: uint32;
    action_time: uint64;
    reason: bytes &size=6;
};

type MarketCenterTradingActionMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_11: bytes &size=11;
    action: uint8 &convert=Action($$);
