    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    timestamp_2: uint64;
    symbol_byte_11: bytes &size=11;
    bid_long_8: uint64;
    bid_size_int_4: uint32;
