    odd_lot_bid_adf_form_attachment: OddLotBidAdfFormAttachment[self.ol_bid_level_count];
    odd_lot_ask_adf_form_attachment: OddLotAskAdfFormAttachment[self.ol_ask_level_count];
};

type InboundTradeMessagesMessage = unit {
    inbound_trade_messages_message_type: bytes &size=1;
    switch ( self.inbound_trade_messages_message_type ) {
        0x45 -> regular_trade_report_message: RegularTradeReportMessage;
        0x49 -> trade_cancel_error_message: TradeCancelErrorMessage;
        0x4a -> trade_correction_message: TradeCorrectionMessage;
        0x48 -> as_of_trade_report_message: AsOfTradeReportMessage;
        0x4b -> fractional_regular_trade_report_message: FractionalRegularTradeReportMessage;
        0x4f -> fractional_trade_cancel_error_message: FractionalTradeCancelErrorMessage;
        0x50 -> fractional_trade_correction_message: FractionalTradeCorrectionMessage;
        0x51 -> fractional_as_of_trade_report_message: FractionalAsOfTradeReportMessage;
        * -> unknown: bytes &eod;
    };
};

type RegularTradeReportMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    timestamp_2: uint64;
    symbol_byte_11: bytes &size=11;
    trade_id: uint32;
    tt_exempt: uint8 &convert=TtExempt($$);
    trcond: bytes &size=4;
    ssday: uint16;
    side: uint8 &convert=Side($$);
    price: uint64;
    volume_int_4: uint32;
};

type TradeCancelErrorMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    timestamp_2: uint64;
    symbol_byte_11: bytes &size=11;
    cancel_type: uint8 &convert=CancelType($$);
    orig_trade_id: uint32;
    orig_tt_exempt: bytes &size=1;
    orig_trcond: bytes &size=4;
    orig_ssday: uint16;
    orig_side: bytes &size=1;
    orig_price: uint64;
    orig_volume_int_4: uint32;
};

type TradeCorrectionMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    timestamp_2: uint64;
    symbol_byte_11: bytes &size=11;
    trade_id: uint32;
    orig_trade_id: uint32;
    orig_tt_exempt: bytes &size=1;
    orig_trcond: bytes &size=4;
    orig_ssday: uint16;
    side: uint8 &convert=Side($$);
    orig_price: uint64;
    orig_volume_int_4: uint32;
    new_tt_exempt: bytes &size=1;
    new_trcond: bytes &size=4;
    new_ssday: uint16;
    new_price: uint64;
    new_volume_int_4: uint32;
};

type AsOfTradeReportMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_11: bytes &size=11;
    trade_id: uint32;
    tt_exempt: uint8 &convert=TtExempt($$);
