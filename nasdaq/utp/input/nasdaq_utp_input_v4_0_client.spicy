    bbo_bid_price: uint64;
    bbo_bid_size: uint32;
    bbo_bid_mpid: bytes &size=4;
    bbo_ask_price: uint64;
    bbo_ask_size: uint32;
    bbo_ask_mpid: bytes &size=4;
    bbo_cond: uint8 &convert=BboCond($$);
    ol_bid_level_count: uint16;
