module NasdaqUtpInputUtpV40Client;

import spicy;

%byte-order = spicy::ByteOrder::Big;

public type NasdaqUtpInputV40 = unit {
    client_tcp_packet_header: ClientTcpPacketHeader;
    switch ( self.client_tcp_packet_header.client_packet_type ) {
        ClientPacketType::UnsequencedDataPacket -> unsequenced_data_packet: UnsequencedDataPacket;
        ClientPacketType::DebugPacket -> debug_packet: DebugPacket;
        ClientPacketType::LoginRequestPacket -> login_request_packet: LoginRequestPacket;
        * -> unknown: bytes &eod;
    };
};

type ClientTcpPacketHeader = unit {
    packet_length: uint16;
    client_packet_type: uint8 &convert=ClientPacketType($$);
};

type UnsequencedDataPacket = unit {
    message_header: MessageHeader;
    switch ( self.message_header.message_category ) {
        0x51 -> inbound_quote_messages_message: InboundQuoteMessagesMessage;
        0x54 -> inbound_trade_messages_message: InboundTradeMessagesMessage;
        0x41 -> inbound_administrative_messages_message: InboundAdministrativeMessagesMessage;
        0x43 -> inbound_control_messages_message: InboundControlMessagesMessage;
        0x61 -> return_administrative_messages_message: ReturnAdministrativeMessagesMessage;
        0x63 -> return_control_messages_message: ReturnControlMessagesMessage;
        * -> unknown: bytes &eod;
    };
};

type MessageHeader = unit {
    version: uint8;
    message_category: bytes &size=1;
};

type InboundQuoteMessagesMessage = unit {
    inbound_quote_messages_message_type: bytes &size=1;
    switch ( self.inbound_quote_messages_message_type ) {
        0x51 -> protected_exchange_quote_message_shortform_message: ProtectedExchangeQuoteMessageShortformMessage;
        0x4c -> protected_exchange_quote_message_longform_message: ProtectedExchangeQuoteMessageLongformMessage;
        0x4f -> exchange_odd_lot_quote_message_short_form_message: ExchangeOddLotQuoteMessageShortFormMessage;
        0x4a -> exchange_odd_lot_quote_message_long_form_message: ExchangeOddLotQuoteMessageLongFormMessage;
        0x50 -> exchange_combined_quote_message_short_form_message: ExchangeCombinedQuoteMessageShortFormMessage;
        0x4b -> exchange_combined_quote_message_long_form_message: ExchangeCombinedQuoteMessageLongFormMessage;
        0x47 -> finra_protected_quote_message_with_bbo_info_message: FinraProtectedQuoteMessageWithBboInfoMessage;
        0x46 -> finra_protected_quote_message_without_bbo_info_message: FinraProtectedQuoteMessageWithoutBboInfoMessage;
        0x48 -> finra_adf_odd_lot_quotation_message: FinraAdfOddLotQuotationMessage;
        0x52 -> finra_adf_combined_quote_message_with_bbo: FinraAdfCombinedQuoteMessageWithBbo;
        * -> unknown: bytes &eod;
    };
};

type ProtectedExchangeQuoteMessageShortformMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_5: bytes &size=5;
    bid_short_2: uint16;
    bid_size_short_2: uint16;
    ask_short_2: uint16;
    ask_size_short_2: uint16;
    cond: uint8 &convert=Cond($$);
    rii: uint8 &convert=Rii($$);
};

type ProtectedExchangeQuoteMessageLongformMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_11: bytes &size=11;
    bid_long_8: uint64;
    bid_size_int_4: uint32;
    ask_long_8: uint64;
    ask_size_int_4: uint32;
    cond: uint8 &convert=Cond($$);
    rii: uint8 &convert=Rii($$);
};

type ExchangeOddLotQuoteMessageShortFormMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_5: bytes &size=5;
    ol_bid_level_count: uint16;
    ol_ask_level_count: uint16;
    odd_lot_bid_short_form_attachment: OddLotBidShortFormAttachment[self.ol_bid_level_count];
    odd_lot_ask_short_form_attachment: OddLotAskShortFormAttachment[self.ol_ask_level_count];
};

type OddLotBidShortFormAttachment = unit {
    ol_price_short_2: uint16;
    ol_size: uint16;
};

type OddLotAskShortFormAttachment = unit {
    ol_price_short_2: uint16;
    ol_size: uint16;
};

type ExchangeOddLotQuoteMessageLongFormMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_11: bytes &size=11;
    ol_bid_level_count: uint16;
    ol_ask_level_count: uint16;
    odd_lot_bid_long_form_attachment: OddLotBidLongFormAttachment[self.ol_bid_level_count];
    odd_lot_ask_long_form_attachment: OddLotAskLongFormAttachment[self.ol_ask_level_count];
};

type OddLotBidLongFormAttachment = unit {
    ol_price_long_8: uint64;
    ol_size: uint16;
};

type OddLotAskLongFormAttachment = unit {
    ol_price_long_8: uint64;
    ol_size: uint16;
};

type ExchangeCombinedQuoteMessageShortFormMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_5: bytes &size=5;
    bid_short_2: uint16;
    bid_size_short_2: uint16;
    ask_short_2: uint16;
    ask_size_short_2: uint16;
    cond: uint8 &convert=Cond($$);
    rii: uint8 &convert=Rii($$);
    ol_bid_level_count: uint16;
    ol_ask_level_count: uint16;
    odd_lot_bid_short_form_attachment: OddLotBidShortFormAttachment[self.ol_bid_level_count];
    odd_lot_ask_short_form_attachment: OddLotAskShortFormAttachment[self.ol_ask_level_count];
};

type ExchangeCombinedQuoteMessageLongFormMessage = unit {
    orig: bytes &size=2;
    timestamp_1: uint64;
    feed_sequence: uint64;
    part_token: uint64;
    symbol_byte_11: bytes &size=11;
    bid_long_8: uint64;
    bid_size_int_4: uint32;
    ask_long_8: uint64;
    ask_size_int_4: uint32;
    cond: uint8 &convert=Cond($$);
    rii: uint8 &convert=Rii($$);
    ol_bid_level_count: uint16;
    ol_ask_level_count: uint16;
    odd_lot_bid_long_form_attachment: OddLotBidLongFormAttachment[self.ol_bid_level_count];
    odd_lot_ask_long_form_attachment: OddLotAskLongFormAttachment[self.ol_ask_level_count];
};

